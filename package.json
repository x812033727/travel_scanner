{
  "name": "travel-scanner",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @travel-scanner/web",
    "build:web": "npm run build --workspace @travel-scanner/web",
    "lint:web": "npm run lint --workspace @travel-scanner/web",
    "typecheck:web": "npm run typecheck --workspace @travel-scanner/web",
    "test:web": "npm run test --workspace @travel-scanner/web",
    "test:tools": "node --test tools/*.test.mjs \"tools/video/**/*.test.mjs\"",
    "check:i18n": "node tools/check-i18n.mjs",
    "check:tasks": "node tools/tasks.mjs check",
    "tasks": "node tools/tasks.mjs",
    "tasks:board": "node tools/tasks.mjs board",
    "crawl:airlines:chrome": "node tools/airline-chrome-crawler.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "jsdom": "^30.1.0",
    "pinyin-pro": "^3.29.4"
  }
}
