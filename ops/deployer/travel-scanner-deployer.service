[Unit]
Description=Mokaair restricted deployment agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=travel-deployer
Group=travel-deployer
SupplementaryGroups=docker travel-api
WorkingDirectory=/opt/travel-scanner-deployer
EnvironmentFile=/etc/travel-scanner/deployer.env
# /run is tmpfs: recreate the socket directory with the group the API container joins.
ExecStartPre=+/bin/sh -c 'install -d /run/travel-scanner-deployer && chown travel-deployer:travel-api /run/travel-scanner-deployer && chmod 0750 /run/travel-scanner-deployer'
ExecStart=/usr/bin/python3 -m deployment_agent
# The agent binds the socket during startup, after ExecStart returns; wait for it
# instead of racing it. Runs as travel-deployer, whose supplementary travel-api group
# makes the chgrp legal without root.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/travel-scanner-deployer/deployer.sock ] && exec chgrp travel-api /run/travel-scanner-deployer/deployer.sock; sleep 0.1; done; echo "deployer.sock never appeared" >&2; exit 1'
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/travel-scanner-deployer /var/lib/travel-scanner-deployer /srv/travel-scanner /var/backups/travel-scanner
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
