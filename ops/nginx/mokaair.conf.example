# mokaair site configuration -- a MERGE SOURCE, not a drop-in.
#
# On a fresh host, install.sh seeds this file as sites-available/mokaair.conf; fill in
# server_name and the certificate paths (the EDIT markers), which belong to the host and not to
# this repository. Everything else is meant to be applied as it stands.
#
# On a host that already serves the site, the enabled file is the host's own (production:
# sites-enabled/mokaair.com -> sites-available/mokaair.com), install.sh seeds nothing, and this
# file is what you merge INTO that one, block by block. Never copy it over the host's file: the
# live file carries things this example deliberately leaves out, and losing any of them is an
# outage now or one at the next certificate renewal.
#   - The ACME webroot on port 80 for certbot: a `location ^~ /.well-known/acme-challenge/`
#     serving from a directory, placed ahead of the 301 to https. The port-80 server below
#     redirects everything, and the /.well-known/ location below proxies to Next.js; copied over
#     the host's, they break the next renewal.
#   - The extra domains (mocair.io, www.mocair.io), each with its own certificate and its own
#     301 to the canonical origin.
#   - Inline ssl_protocols / ssl_ciphers. This example inherits whatever nginx.conf sets.
#   - default_server on the listen lines, so an unknown Host name lands here and not on a stray
#     virtual host.
# What to take from here: the upstream block with its keepalive include, the header-hygiene
# include in EVERY proxying location, the limit_req / limit_conn lines and which locations are
# exempt from them, the two error_log lines, and the HSTS add_header. Diff the result against
# the host file you started from, then nginx -t, then reload.
#
# The browser talks only to the Next.js BFF (see architecture.md). The FastAPI service listens
# on 127.0.0.1:8090 and MUST NOT be proxied here: reaching it directly skips the BFF's
# same-origin check, its header allowlist, and the cookie handling that goes with them.

upstream mokaair_web {
    server 127.0.0.1:8091;
    # Pool size and idle timeout. The timeout has to stay below the Next.js server's own, or
    # POSTs fail with a 502 now and then; the snippet says why.
    include /etc/nginx/snippets/mokaair-upstream-keepalive.conf;
}

# --- Canonical origin -------------------------------------------------------------------
#
# This redirect already exists in production and is load-bearing, not cosmetic. The OAuth
# flow cookie is host-only, so if the site answers on a second hostname a sign-in started
# there leaves its cookie behind and every attempt fails with oauth_state_invalid, forever.
# Path-preserving, and it must cover /api/* too. See docs/social-login.md.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.example.com;          # EDIT

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # EDIT
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # EDIT

    return 301 https://example.com$request_uri;                            # EDIT
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;                               # EDIT
    return 301 https://example.com$request_uri;                            # EDIT
}

# --- The site ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # Standalone directive since nginx 1.25.1; production runs 1.28.3. On anything older use
    # the deprecated `listen 443 ssl http2;` form instead.
    http2 on;
    server_name example.com;                                               # EDIT

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # EDIT
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # EDIT

    # If a CDN is ever put in front of this nginx, uncomment and fill in its ranges. Until
    # then it must stay off: enabling it without a correct set_real_ip_from list means
    # believing a CF-Connecting-IP header that anyone can send. With a CDN and this block
    # *missing*, the opposite breaks -- $remote_addr becomes the CDN's egress address, every
    # visitor lands in a handful of buckets, and both the limits below and the application's
    # own per-source counting stop meaning anything.
    # Check which world you are in:  curl -sI https://example.com | grep -i '^server:'
    # set_real_ip_from   <CDN range>;
    # real_ip_header     CF-Connecting-IP;
    # real_ip_recursive  on;

    # The application sends HSTS on its own responses (apps/web/next.config.ts). This covers
    # the ones nginx generates itself: redirects, 429s from the limits below, 502s when the
    # upstream is down. "always" because add_header otherwise skips exactly those statuses.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Where the rate-limit events go. 10-rate-limit.conf logs them at warn, but the stock
    # Debian/Ubuntu nginx.conf logs at error, so without a warn-level destination every
    # "limiting requests" line is dropped and the README's Googlebot check reads an empty file.
    # Both lines: a server-level error_log replaces the inherited one instead of adding to it,
    # so the first keeps this server's real errors in error.log and the second adds the warn log.
    error_log /var/log/nginx/error.log error;
    error_log /var/log/nginx/mokaair-limit.log warn;

    # And who is being refused, which mokaair-limit.log cannot say: its lines name the zone,
    # the client address, the request and the host, but not the user agent, so answering "was
    # that Googlebot?" meant joining it to access.log by address and timestamp. One grep now.
    access_log /var/log/nginx/mokaair-limited.log mokaair_limited if=$mokaair_is_limited;

    client_max_body_size 6m;    # just above the app's own 5 MiB cap, so the app answers
    limit_conn mokaair_conns 20;

    # Immutable build output: deliberately NOT rate limited. One page load pulls dozens of
    # these, so any rate low enough to matter would break the first visit of every session.
    location /_next/static/ {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    location /brand/ {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    # LINE delivers webhooks in bursts and retries what it cannot deliver, and the request is
    # authenticated by its X-Line-Signature rather than by anything nginx can see. Rate
    # limiting it would drop real events, so it is exempt. The signature header passes through
    # untouched: proxy_set_header only overrides the names it lists.
    location = /api/line/webhook {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    # Served by Next out of apps/web/public/.well-known/. Do not intercept or rewrite this
    # prefix: Apple fetches the domain-association file from it and sign-in breaks if it 404s.
    location /.well-known/ {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    location /api/ {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        limit_req zone=mokaair_api burst=20 nodelay;
        proxy_pass http://mokaair_web;
        # Search results stream as server-sent events; buffering them defeats the point.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Crawl control. Tiny files, and refusing one costs far more than serving it: a 429 on
    # /robots.txt or /sitemap.xml is a crawler losing its instructions for the whole site.
    # Exempt from the page budget for the same reason /_next/static/ is.
    location = /robots.txt {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    location = /sitemap.xml {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    location = /llms.txt {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    # The eleven children the sitemap index points at. ^~ so it wins over the catch-all.
    location ^~ /sitemaps/ {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        proxy_pass http://mokaair_web;
    }

    location / {
        include /etc/nginx/snippets/mokaair-proxy-headers.conf;
        limit_req zone=mokaair_content_pages burst=20 nodelay;
        # A verified search engine is keyed into mokaair_crawlers instead and has an empty
        # key in the zone above, so the two never both count one request. Ranges come from
        # conf.d/05-mokaair-crawler-ranges.conf; never from the User-Agent, which is a claim
        # anyone can make.
        limit_req zone=mokaair_crawlers burst=60 nodelay;
        proxy_pass http://mokaair_web;
    }
}
