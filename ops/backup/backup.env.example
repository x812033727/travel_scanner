# /etc/travel-scanner/backup.env (root:root, mode 0600). Read by travel-scanner-backup.service.
# Keep this many complete nightly runs under /var/backups/travel-scanner/nightly (older ones are
# removed only after a successful run).
BACKUP_LOCAL_RETENTION=7
# age public key (age1...) the config bundle is encrypted to. The matching identity file stays in
# the owner's password manager, never on this host. Empty: the config bundle is not kept at all.
BACKUP_AGE_RECIPIENT=
# Also copy Redis' dump.rdb (redis-cli SAVE). Off by default: the queue is rebuilt, not restored.
BACKUP_INCLUDE_REDIS=false
# Offsite copy (offsite.py, travel-scanner-offsite.timer). Owner decision 2026-11-11: the runs go
# to Drive unencrypted, through the video backup remote rooted at AI/備份. Empty disables it.
OFFSITE_REMOTE=videobackup:主機/資料庫/nightly
# Keep this many runs on Drive; older run folders are purged (Drive trash keeps them 30 days).
OFFSITE_RETENTION=14
# rclone runs from this image with this config directory (the host has no rclone of its own).
OFFSITE_DOCKER_IMAGE=travel-scanner-video-worker:local
OFFSITE_RCLONE_CONF_DIR=/etc/travel-scanner/rclone-videos
