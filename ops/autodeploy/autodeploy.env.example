# /etc/travel-scanner/autodeploy.env (root:root, mode 0600). Read by travel-scanner-autodeploy.service.
# false: every tick walks the gates and prints what it would do, deploys nothing (the dry-run week).
AUTODEPLOY_ENABLED=false
# Fine-grained personal access token for x812033727/travel_scanner with only Actions: Read.
AUTODEPLOY_GITHUB_TOKEN=
# Minutes the newest main commit must be old before it deploys; merges inside it become one rebuild.
AUTODEPLOY_QUIET_MINUTES=20
# Wait while a paid video stage job is running (its worker restarts on every deploy).
AUTODEPLOY_WAIT_FOR_PAID_WORK=true
# Say so once when paid work has held a deploy back this long. 0 disables.
AUTODEPLOY_PAID_WORK_NOTIFY_HOURS=2
# Daily windows in Asia/Taipei during which no deploy starts, HH:MM-HH:MM, comma separated. Empty: none.
AUTODEPLOY_BLOCKED_WINDOWS=
# Optional webhook: one JSON POST {"text": ..., "content": ...} per deploy, failure and long paid-work wait
# (Slack and Discord webhooks, or Telegram's sendMessage URL with chat_id in the query string).
AUTODEPLOY_NOTIFY_URL=
