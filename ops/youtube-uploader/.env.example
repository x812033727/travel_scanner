UPLOADER_CHANNEL_ID=UC_REPLACE_WITH_CHANNEL_ID
UPLOADER_SECRET_PATH=/etc/mokaair-uploader/service-secret
UPLOADER_VNC_PASSWORD_PATH=/etc/mokaair-uploader/vnc-password
# Bind only to loopback, or to an explicitly firewalled private VPN interface.
UPLOADER_PRIVATE_BIND_IP=127.0.0.1
# Same-host overlay: network owned by the site's production Compose.
UPLOADER_API_NETWORK=travel_scanner_uploader_rpc
