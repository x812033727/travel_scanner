    "thumbnail": "2d3a0a0fbc43"
  },
  "lines": {
    "p001": {
      "source_hash": "359dcc989d68",
      "text": "Bu! Siang tadi di atap,"
    },
    "p002": {
      "source_hash": "93903113d3c2",
      "text": "langitnya biru banget!"
    },
    "p003": {
      "source_hash": "399fe677e849",
      "text": "Tapi sore naik lagi,"
    },
    "p004": {
      "source_hash": "f422e39aefdb",
      "text": "mataharinya jadi bola merah!"
    },
    "p005": {
      "source_hash": "2588d80d4900",
      "text": "Matahari sama, sinarnya juga sama."
    },
    "p006": {
      "source_hash": "c460be6aca94",
      "text": "Kamu lihat tiap hari. Siapa yang ganti warnanya?"
    },
    "p007": {
      "source_hash": "c40e35ee1293",
      "text": "Pasti ada yang ganti!"
    },
    "p008": {
      "source_hash": "6bb012daf243",
      "text": "Memang ada yang usil. Selalu dekatmu, tapi tak terlihat."
    },
    "p009": {
      "source_hash": "4c5e7994f937",
      "text": "Jadi biru langit"
    },
    "p010": {
      "source_hash": "e438a3a039f5",
      "text": "dari mana asalnya?"
    },
    "p011": {
      "source_hash": "667197ef2057",
      "text": "Tebak dulu: segelas air diberi tetes susu, disenter,"
    },
    "p012": {
      "source_hash": "5e158249342f",
      "text": "dari samping, warnanya apa?"
    },
    "p013": {
      "source_hash": "a280f0cc0dac",
      "text": "Air campur susu?"
    },
    "p014": {
      "source_hash": "8192526ab386",
      "text": "Putih, kan?"
    },
    "p015": {
      "source_hash": "ef1344210186",
      "text": "Lalu, kalau berdiri di Bulan siang hari,"
    },
    "p016": {
      "source_hash": "3a05296e14e4",
      "text": "langitnya warna apa?"
    },
    "p017": {
      "source_hash": "c5d998c9f208",
      "text": "Di Bulan? Aku tak tahu."
    },
    "p018": {
      "source_hash": "a2c0ad3b631b",
      "text": "Terus ada awan!"
    },
    "p019": {
      "source_hash": "0507d20deeec",
      "text": "Langit biru, kok awan putih?"
    },
    "p020": {
      "source_hash": "c52f77a460df",
      "text": "Sinarnya,"
    },
    "p021": {
      "source_hash": "aeaff2e9259a",
      "text": "kok kadang biru, kadang merah?"
    },
    "p022": {
      "source_hash": "1c5086ac1e1e",
      "text": "Langit memang biru, kan?"
    },
    "p023": {
      "source_hash": "a433325e939a",
      "text": "Kalau memang biru,"
    },
    "p024": {
      "source_hash": "b1632b6b567d",
      "text": "kok gelap usai matahari terbenam?"
    },
    "p025": {
      "source_hash": "980e8c0e98a0",
      "text": "Karena... mataharinya pulang kerja?"
    },
    "p026": {
      "source_hash": "158431070b07",
      "text": "Ya, matahari pergi, biru ikut."
    },
    "p027": {
      "source_hash": "b1adeffda7c6",
      "text": "Jadi biru dibawa sinar surya."
    },
    "p028": {
      "source_hash": "a67375b88157",
      "text": "Tapi sinarnya putih,"
    },
    "p029": {
      "source_hash": "34349b2e58b1",
      "text": "birunya mana?"
    },
    "p030": {
      "source_hash": "9aee72e854a7",
      "text": "Putih: campuran banyak warna."
    },
    "p031": {
      "source_hash": "20b1c6614d12",
      "text": "Semua masuk ke mata, otak melihatnya putih."
    },
    "p032": {
      "source_hash": "cc1f2d274a66",
      "text": "Saat menyiram tanaman, kadang ada pelangi di semburan air."
    },
    "p033": {
      "source_hash": "35de29603d90",
      "text": "Warna itu ada di sinar matahari."
    },
    "p034": {
      "source_hash": "d67462368831",
      "text": "Pakai kaca segitiga, namanya prisma,"
    },
    "p035": {
      "source_hash": "29d14a50e868",
      "text": "di dinding muncul deretan warna."
    },
    "p036": {
      "source_hash": "3e66aee63d3b",
      "text": "Dulu, ilmuwan Inggris Newton memecah sinar surya pakai prisma."
    },
    "p037": {
      "source_hash": "f20aa8c149e6",
      "text": "Merah, jingga, kuning, hijau, biru, ungu!"
    },
    "p038": {
      "source_hash": "a8c680ab58bb",
      "text": "Semua di cahaya putih?"
    },
    "p039": {
      "source_hash": "5de5b9ccf96e",
      "text": "Ya, lengkap."
    },
    "p040": {
      "source_hash": "5385ef130b9b",
      "text": "Sesak banget!"
    },
    "p041": {
      "source_hash": "1dc2c3d5a291",
      "text": "Warnanya"
    },
    "p042": {
      "source_hash": "6305cadc906a",
      "text": "bedanya apa?"
    },
    "p043": {
      "source_hash": "c792faecfffc",
      "text": "Pernah main tali? Tali bergelombang."
    },
    "p044": {
      "source_hash": "01d174a85182",
      "text": "Cahaya juga begitu, maju bergelombang."
    },
    "p045": {
      "source_hash": "769969e838e4",
      "text": "Gelombang merah panjang, ombak besar;"
    },
    "p046": {
      "source_hash": "cf969f73f282",
      "text": "biru dan ungu pendek, seperti ombak kecil."
    },
    "p047": {
      "source_hash": "cca756e1d1c0",
      "text": "Puncak ke puncak: panjang gelombang."
    },
    "p048": {
      "source_hash": "37865381b807",
      "text": "Panjang gelombang beda, warnanya beda."
    },
    "p049": {
      "source_hash": "96e7dd27d797",
      "text": "Kuayun cepat, pendek!"
    },
    "p050": {
      "source_hash": "c1f9ddf1b223",
      "text": "Biru itu ombak pendek?"
    },
    "p051": {
      "source_hash": "d6fc6a4d5916",
      "text": "Ya. Ingat ini, nanti muncul lagi."
    },
    "p052": {
      "source_hash": "07340dbe30d4",
      "text": "Jadi langit biru"
    },
    "p053": {
      "source_hash": "1a2dec7eb0fc",
      "text": "karena udaranya biru?"
    },
    "p054": {
      "source_hash": "39fb18fff83a",
      "text": "Coba toples kosong isi udara,"
    },
    "p055": {
      "source_hash": "f1d6d4578412",
      "text": "tampak biru?"
    },
    "p056": {
      "source_hash": "9736f68480b4",
      "text": "Tidak,"
    },
    "p057": {
      "source_hash": "4bf8d74b0f68",
      "text": "bening."
    },
    "p058": {
      "source_hash": "28bfe66a3e65",
      "text": "Sedikit, bening."
    },
    "p059": {
      "source_hash": "f65a22afe062",
      "text": "Tapi udara di atas kepalamu tebal sekali."
    },
    "p060": {
      "source_hash": "d6e7748d70ea",
      "text": "Dari atas jelas: AU Amerika memotret dari 20 km,"
    },
    "p061": {
      "source_hash": "83b2aa86cba9",
      "text": "tepi Bumi berupa garis biru tipis."
    },
    "p062": {
      "source_hash": "3debe8696307",
      "text": "Udara ini terdiri dari molekul kecil."
    },
    "p063": {
      "source_hash": "40d0bd86afb8",
      "text": "Molekul? Apa itu?"
    },
    "p064": {
      "source_hash": "55f78335fd4e",
      "text": "Bayangkan bola-bola di udara,"
    },
    "p065": {
      "source_hash": "3587fa4a9fcb",
      "text": "terlalu kecil untuk dilihat."
    },
    "p066": {
      "source_hash": "d223bfdc678f",
      "text": "Aku menghirup bola-bola juga?"
    },
    "p067": {
      "source_hash": "f72ee31c72ae",
      "text": "Ya, tiap tarikan napas, banyak sekali."
    },
    "p068": {
      "source_hash": "fe5196ab94e3",
      "text": "Molekul kira-kira seribu kali lebih kecil dari ombaknya."
    },
    "p069": {
      "source_hash": "f3ebe7dd8e38",
      "text": "Seribu?"
    },
    "p070": {
      "source_hash": "39e0ac976cbe",
      "text": "Jadi cahayanya tembus saja?"
    },
    "p071": {
      "source_hash": "2da2072169da",
      "text": "Sebagian iya."
    },
    "p072": {
      "source_hash": "de6a74a94fcc",
      "text": "Tapi sebagian menabrak bola, terpental"
    },
    "p073": {
      "source_hash": "3e36511f1a75",
      "text": "ke segala arah."
    },
    "p074": {
      "source_hash": "00f9c47d0fe2",
      "text": "Ini hamburan: yang mental menabrak bola lain, lalu mental lagi."
    },
    "p075": {
      "source_hash": "f483723e9c37",
      "text": "Main gundu!"
    },
    "p076": {
      "source_hash": "b1763f23689e",
      "text": "Mirip, tapi mentalnya ke segala arah."
    },
    "p077": {
      "source_hash": "dc662e6d4567",
      "text": "Semuanya"
    },
    "p078": {
      "source_hash": "6f3510a04842",
      "text": "ikut terpental?"
    },
    "p079": {
      "source_hash": "272f6fc1edc9",
      "text": "Ya. Tapi ingat ombak pendek tadi?"
    },
    "p080": {
      "source_hash": "e86a4e375852",
      "text": "Mereka paling sering."
    },
    "p081": {
      "source_hash": "de5606fb786f",
      "text": "Biru terpental berkali lipat dari merah."
    },
    "p082": {
      "source_hash": "6f293f74f385",
      "text": "Berkali lipat? Biru sibuk!"
    },
    "p083": {
      "source_hash": "8c3f2d5b0f70",
      "text": "Merahnya?"
    },
    "p084": {
      "source_hash": "48d738a1182e",
      "text": "Merah jarang mental,"
    },
    "p085": {
      "source_hash": "75b4bbcc434d",
      "text": "kebanyakan lurus ke depan."
    },
    "p086": {
      "source_hash": "e356deacc5e2",
      "text": "Merah fokus banget!"
    },
    "p087": {
      "source_hash": "c919df334551",
      "text": "Abad ke-19, ilmuwan Inggris Rayleigh menghitung"
    },
    "p088": {
      "source_hash": "d68bc88eb47b",
      "text": "Maka disebut hamburan Rayleigh."
    },
    "p089": {
      "source_hash": "ccec91a85569",
      "text": "Lucunya, dulu orang mengira,"
    },
    "p090": {
      "source_hash": "f4ea1ff5fb19",
      "text": "yang memantulkan biru itu debu dan titik air."
    },
    "p091": {
      "source_hash": "8404530f6ba4",
      "text": "Lalu ketahuan: kalau debu,"
    },
    "p092": {
      "source_hash": "bd2b0d306bfe",
      "text": "biru berubah ikut cuaca,"
    },
    "p093": {
      "source_hash": "d6d68f6bb66f",
      "text": "nyatanya tidak."
    },
    "p094": {
      "source_hash": "c8b27c10949e",
      "text": "Lalu pada 1910, Einstein menghitung:"
    },
    "p095": {
      "source_hash": "885313c7f4eb",
      "text": "molekul udara saja cukup buat biru."
    },
    "p096": {
      "source_hash": "b482a5344430",
      "text": "Einstein"
    },
    "p097": {
      "source_hash": "0a18c4918660",
      "text": "menghitung langit!"
    },
    "p098": {
      "source_hash": "22690e648c02",
      "text": "Ke mana pun kamu lihat,"
    },
    "p099": {
      "source_hash": "de3eceb6963a",
      "text": "ada biru terpental masuk ke matamu."
    },
    "p100": {
      "source_hash": "1067b470b681",
      "text": "Udara,"
    },
    "p101": {
      "source_hash": "7a6482c5624e",
      "text": "tak biru; ia mementalkan biru."
    },
    "p102": {
      "source_hash": "a47640d9638f",
      "text": "Yang diam-diam ganti"
    },
    "p103": {
      "source_hash": "87a77138a0f0",
      "text": "itu udara!"
    },
    "p104": {
      "source_hash": "db3693e8e436",
      "text": "Kata orang,"
    },
    "p105": {
      "source_hash": "92278e65d14b",
      "text": "langit itu pantulan laut."
    },
    "p106": {
      "source_hash": "10b0c536b9fc",
      "text": "Kata orang."
    },
    "p107": {
      "source_hash": "4a663be28048",
      "text": "Tapi di gunung, jauh dari laut, langit tetap biru."
    },
    "p108": {
      "source_hash": "796a2eb5fa61",
      "text": "Sering terbalik: dari pantai,"
    },
    "p109": {
      "source_hash": "5af502f85d60",
      "text": "laut biru sebagian karena pantul langit."
    },
    "p110": {
      "source_hash": "534eed7b8bb0",
      "text": "Tunggu, ungu lebih pendek,"
    },
    "p111": {
      "source_hash": "42fbb03c2924",
      "text": "kok langit tidak ungu?"
    },
    "p112": {
      "source_hash": "01d2f49f95cf",
      "text": "Bagus. Sinar surya memang sedikit ungunya."
    },
    "p113": {
      "source_hash": "d72db7f19f36",
      "text": "Sebagian diserap udara di atas,"
    },
    "p114": {
      "source_hash": "049bd393b768",
      "text": "diserap itu ditelan, tak sampai."
    },
    "p115": {
      "source_hash": "b3e1599ecf98",
      "text": "Udara ikut ngemil!"
    },
    "p116": {
      "source_hash": "76e55647b584",
      "text": "Lagi pula, mata kurang peka ungu."
    },
    "p117": {
      "source_hash": "2973e626ccdc",
      "text": "Ungu ada, tapi bercampur,"
    },
    "p118": {
      "source_hash": "9cfdf825de3c",
      "text": "jadi tampak biru muda."
    },
    "p119": {
      "source_hash": "66a1dacd43cc",
      "text": "Mataku"
    },
    "p120": {
      "source_hash": "e1fcf87d15eb",
      "text": "pilih warna juga?"
    },
    "p121": {
      "source_hash": "9bce10fd5342",
      "text": "Ini paling seru:"
    },
    "p122": {
      "source_hash": "a67f42ee92d4",
      "text": "warnamu, mata ikut memilih."
    },
    "p123": {
      "source_hash": "85839d2a19ad",
      "text": "Mataku palet warna!"
    },
    "p124": {
      "source_hash": "a9cd9b4e876e",
      "text": "Biru banyak terpental,"
    },
    "p125": {
      "source_hash": "3d690fc04bcc",
      "text": "lalu matahari sendiri warna apa?"
    },
    "p126": {
      "source_hash": "a9763055424e",
      "text": "Aku"
    },
    "p127": {
      "source_hash": "3974109d62f3",
      "text": "cat kuning."
    },
    "p128": {
      "source_hash": "d74f155f0cb4",
      "text": "Banyak yang begitu. Tapi untuk tahu aslinya, pergi dari Bumi."
    },
    "p129": {
      "source_hash": "64573df225d4",
      "text": "Di luar angkasa, putih."
    },
    "p130": {
      "source_hash": "a5d102f98438",
      "text": "Di sana sudah di luar sebagian besar udara."
    },
    "p131": {
      "source_hash": "50ecc6ebff1d",
      "text": "Dari tanah kuning,"
    },
    "p132": {
      "source_hash": "25bb727d99c5",
      "text": "karena sebagian biru terpental di jalan."
    },
    "p133": {
      "source_hash": "9d65d752aed5",
      "text": "Biru kurang,"
    },
    "p134": {
      "source_hash": "4a86c923c0aa",
      "text": "kok masih terang?"
    },
    "p135": {
      "source_hash": "5e0418faf7a3",
      "text": "Yang hilang tak banyak."
    },
    "p136": {
      "source_hash": "cbf984c59dd4",
      "text": "Saat cerah, separuh lebih sinar lurus ke tanah."
    },
    "p137": {
      "source_hash": "e6fba31ac6aa",
      "text": "Pantas"
    },
    "p138": {
      "source_hash": "81ad0a9226d1",
      "text": "siang tetap terang!"
    },
    "p139": {
      "source_hash": "3f8d8cf04f0a",
      "text": "Matahari sore merah,"
    },
    "p140": {
      "source_hash": "2f5373350ab7",
      "text": "karena lebih panas?"
    },
    "p141": {
      "source_hash": "37904b26bfe2",
      "text": "Matahari siang dan sore sama, bukan ia."
    },
    "p142": {
      "source_hash": "fff02cb31264",
      "text": "Yang berubah jalan cahaya ke matamu."
    },
    "p143": {
      "source_hash": "184faf155632",
      "text": "Jalan berubah?"
    },
    "p144": {
      "source_hash": "95799511bd9a",
      "text": "Matahari tak menjauh."
    },
    "p145": {
      "source_hash": "6a24c055fbf3",
      "text": "Ya, sama,"
    },
    "p146": {
      "source_hash": "a07d954ca271",
      "text": "yang berubah: udara yang ditembus jadi jauh lebih tebal."
    },
    "p147": {
      "source_hash": "c3d0f1a1eb7f",
      "text": "Di atas kepala,"
    },
    "p148": {
      "source_hash": "53b51b509166",
      "text": "cahaya turun lurus, udara sedikit."
    },
    "p149": {
      "source_hash": "af7cd98c3cf6",
      "text": "Hampir terbenam, miring,"
    },
    "p150": {
      "source_hash": "041f1151e600",
      "text": "menyusuri tanah."
    },
    "p151": {
      "source_hash": "3cca765a0d37",
      "text": "Di cakrawala, udara yang ditembus"
    },
    "p152": {
      "source_hash": "9c524ce14986",
      "text": "kira-kira tiga puluhan kali lipat."
    },
    "p153": {
      "source_hash": "f2ffe8814fe2",
      "text": "Tiga puluh?"
    },
    "p154": {
      "source_hash": "ab1e7b5e3427",
      "text": "Tebal!"
    },
    "p155": {
      "source_hash": "93ae7eca92e6",
      "text": "Jalannya panjang sekali!"
    },
    "p156": {
      "source_hash": "1da4347dfd22",
      "text": "Jalan sepanjang itu, biru terpental, terpental lagi."
    },
    "p157": {
      "source_hash": "297d3a3a20e6",
      "text": "Sampai di mata, sisanya merah dan jingga."
    },
    "p158": {
      "source_hash": "900ba4f0f891",
      "text": "Makin rendah, biasanya makin merah."
    },
    "p159": {
      "source_hash": "cacd1fb532f7",
      "text": "Tapi jangan terus tatap matahari, mata bisa rusak."
    },
    "p160": {
      "source_hash": "14a10be94a7c",
      "text": "Saat terbit,"
    },
    "p161": {
      "source_hash": "3276b56fc9df",
      "text": "sama juga?"
    },
    "p162": {
      "source_hash": "a6c99c81082d",
      "text": "Sama. Saat terbit, cahaya juga miring,"
    },
    "p163": {
      "source_hash": "a51dbc3bdf92",
      "text": "hanya di sebelah timur."
    },
    "p164": {
      "source_hash": "34c948294e43",
      "text": "Biru yang terpental,"
    },
    "p165": {
      "source_hash": "5e7da7bedc4d",
      "text": "pergi ke mana?"
    },
    "p166": {
      "source_hash": "ba356b11452b",
      "text": "Ke langit lain."
    },
    "p167": {
      "source_hash": "cd29b3d0192c",
      "text": "Saat kamu melihat matahari merah,"
    },
    "p168": {
      "source_hash": "5707c62a2095",
      "text": "birunya terpental"
    },
    "p169": {
      "source_hash": "bdf381a41b9c",
      "text": "jadi langit biru di tempat jauh."
    },
    "p170": {
      "source_hash": "5b4ee32e76aa",
      "text": "Ahli cuaca AS, Corfidi, berkata:"
    },
    "p171": {
      "source_hash": "d30e7c473200",
      "text": "Senja merah karena siang langit biru."
    },
    "p172": {
      "source_hash": "e48a2cb6e138",
      "text": "Senjaku"
    },
    "p173": {
      "source_hash": "e325bd82795a",
      "text": "langit biru orang!"
    },
    "p174": {
      "source_hash": "9b089e737afd",
      "text": "Air campur susu, ini jawabannya."
    },
    "p175": {
      "source_hash": "f4c0fb031bf8",
      "text": "Senter dari samping, lihat samping,"
    },
    "p176": {
      "source_hash": "2ae7817807ee",
      "text": "airnya agak biru muda."
    },
    "p177": {
      "source_hash": "8b18b42df368",
      "text": "Dari depan senter,"
    },
    "p178": {
      "source_hash": "5b0c9a5a071c",
      "text": "cahaya tembusnya malah jingga kemerahan."
    },
    "p179": {
      "source_hash": "0d8c010f37b8",
      "text": "Gelas"
    },
    "p180": {
      "source_hash": "a71250a807b3",
      "text": "langit, senja!"
    },
    "p181": {
      "source_hash": "a488a925f5e5",
      "text": "Susunya berbuat apa?"
    },
    "p182": {
      "source_hash": "f1011bb37e67",
      "text": "Butir susu memantulkan cahaya."
    },
    "p183": {
      "source_hash": "0e4c7c555e8b",
      "text": "Makin jauh di air, makin banyak biru lepas."
    },
    "p184": {
      "source_hash": "04235f8407e3",
      "text": "Coba di rumah: air, tetes susu, senter."
    },
    "p185": {
      "source_hash": "cb60fb907f7f",
      "text": "Tak berwarna? Tambah 2 tetes."
    },
    "p186": {
      "source_hash": "202f90caa7ee",
      "text": "Pinjam senter Ayah!"
    },
    "p187": {
      "source_hash": "331f7b8203d6",
      "text": "Lalu, lihat awan di jendela."
    },
    "p188": {
      "source_hash": "fadc654fc221",
      "text": "Awan pun disinari,"
    },
    "p189": {
      "source_hash": "42717f4c62ce",
      "text": "kok tak biru atau merah?"
    },
    "p190": {
      "source_hash": "bdca4fe24f6a",
      "text": "Awan itu titik air,"
    },
    "p191": {
      "source_hash": "209ea7dc2a83",
      "text": "satu titik air jauh lebih besar dari molekul."
    },
    "p192": {
      "source_hash": "2de7489656cb",
      "text": "Titik besar memantulkan semua."
    },
    "p193": {
      "source_hash": "e9b032c58c60",
      "text": "Semua warna terpental bersama, bercampur jadi putih."
    },
    "p194": {
      "source_hash": "3ea4c9a87eb2",
      "text": "Berkabut"
    },
    "p195": {
      "source_hash": "87ab3fca9638",
      "text": "juga putih!"
    },
    "p196": {
      "source_hash": "0d8705337bb9",
      "text": "Ya, kabut juga titik air."
    },
    "p197": {
      "source_hash": "28cc1291880d",
      "text": "Kabut pagi disinari matahari, putih semua."
    },
    "p198": {
      "source_hash": "096cf100ff60",
      "text": "Kalau mau hujan,"
    },
    "p199": {
      "source_hash": "a49ca342221f",
      "text": "kok awan jadi abu-abu?"
    },
    "p200": {
      "source_hash": "debd39058546",
      "text": "Awan tebal, sinar tertahan,"
    },
    "p201": {
      "source_hash": "f4c4c4f11a4c",
      "text": "bawahnya kurang cahaya, jadi kelabu."
    },
    "p202": {
      "source_hash": "a09fa90612ab",
      "text": "Kadang langit sekitarnya terang,"
    },
    "p203": {
      "source_hash": "854eb314ec0d",
      "text": "dibanding, mata lihat abu-abu."
    },
    "p204": {
      "source_hash": "b99766fe85ca",
      "text": "Mata pilih warna lagi!"
    },
    "p205": {
      "source_hash": "88f8aebe71a3",
      "text": "Tapi awan sore"
    },
    "p206": {
      "source_hash": "149c59706ff3",
      "text": "jingga dan merah muda!"
    },
    "p207": {
      "source_hash": "f167840b08db",
      "text": "Sinarnya sudah merah di jalan."
    },
    "p208": {
      "source_hash": "76dda1609829",
      "text": "Awan seperti layar besar, memantulkan warna."
    },
    "p209": {
      "source_hash": "78e9be674495",
      "text": "Langit lagi main film!"
    },
    "p210": {
      "source_hash": "ad76bbb00ac6",
      "text": "Titik air mengubah warna langit, debu juga."
    },
    "p211": {
      "source_hash": "18eb01506344",
      "text": "Debu banyak,"
    },
    "p212": {
      "source_hash": "39aeaed5ad50",
      "text": "langit makin biru?"
    },
    "p213": {
      "source_hash": "c0f53b37b4e3",
      "text": "Ingat tebakan dulu?"
    },
    "p214": {
      "source_hash": "e179d912c45d",
      "text": "Kamu sama dengan mereka, tapi jawabnya terbalik."
    },
    "p215": {
      "source_hash": "ab61cb8a3ab8",
      "text": "Debu asap besar,"
    },
    "p216": {
      "source_hash": "b1c5f1096b01",
      "text": "biru siang pudar, seperti kain kasa putih."
    },
    "p217": {
      "source_hash": "0406544ca89a",
      "text": "Ini disebut kabut asap."
    },
    "p218": {
      "source_hash": "c6965cc45d0f",
      "text": "Kalau tebal, siang pun langit putih."
    },
    "p219": {
      "source_hash": "d796cdaee5e0",
      "text": "Langit paling biru,"
    },
    "p220": {
      "source_hash": "2f913d9d8aef",
      "text": "sering udara bersih."
    },
    "p221": {
      "source_hash": "395741146707",
      "text": "Pantas ada hari langitnya biru sekali!"
    },
    "p222": {
      "source_hash": "010f31caab6b",
      "text": "Debu banyak,"
    },
    "p223": {
      "source_hash": "6d63d07ef812",
      "text": "senjanya bagaimana?"
    },
    "p224": {
      "source_hash": "745fb293b0f4",
      "text": "Tak tentu: kadang lebih merah,"
    },
    "p225": {
      "source_hash": "a9222d32492f",
      "text": "kadang malah kelabu."
    },
    "p226": {
      "source_hash": "581d68aa9503",
      "text": "Naik pesawat sore berkabut: senja di bawah pucat;"
    },
    "p227": {
      "source_hash": "d7de34c5bc13",
      "text": "lewat kabut asap, warna di langit jadi cerah."
    },
    "p228": {
      "source_hash": "73c202ab3394",
      "text": "Kabutnya menutupi warna!"
    },
    "p229": {
      "source_hash": "a4d1898bcf93",
      "text": "Kabut di bawah, awan tinggi paling merah:"
    },
    "p230": {
      "source_hash": "03d0933e1ad7",
      "text": "sinarnya tak lewat kabut."
    },
    "p231": {
      "source_hash": "865835294385",
      "text": "Awan tinggi paling cantik!"
    },
    "p232": {
      "source_hash": "f8776d5d2f46",
      "text": "Ada senja istimewa dari gunung api."
    },
    "p233": {
      "source_hash": "e334a7a3fd9d",
      "text": "Pada 1991, Gunung Pinatubo di Filipina meletus."
    },
    "p234": {
      "source_hash": "a8ab2f84aab4",
      "text": "Gasnya jadi tetesan halus di langit tinggi,"
    },
    "p235": {
      "source_hash": "b86f6b8d020a",
      "text": "melayang di ketinggian sekitar 20–30 km."
    },
    "p236": {
      "source_hash": "d5f1b0bc253c",
      "text": "Tinggi?"
    },
    "p237": {
      "source_hash": "c72b7d68f826",
      "text": "Terlihat dari tanah?"
    },
    "p238": {
      "source_hash": "420b70b89c51",
      "text": "15 menit usai terbenam,"
    },
    "p239": {
      "source_hash": "4044f0094e16",
      "text": "tanah gelap, lapisan tinggi masih kena matahari, jadi ungu muda dan jingga."
    },
    "p240": {
      "source_hash": "944895994a1a",
      "text": "Senja ini muncul sekitar 1,5 tahun."
    },
    "p241": {
      "source_hash": "7a41c7d038a2",
      "text": "Sampai AS di sisi lain Bumi pun melihatnya."
    },
    "p242": {
      "source_hash": "52ec278e3e90",
      "text": "Gunung api"
    },
    "p243": {
      "source_hash": "2925a0c7ad27",
      "text": "ubah warna!"
    },
    "p244": {
      "source_hash": "d3f62d5f7685",
      "text": "Lihat senja aneh? Pikirkan:"
    },
    "p245": {
      "source_hash": "5c2de61e8b3a",
      "text": "udara hari ini ada apa?"
    },
    "p246": {
      "source_hash": "2d2658267269",
      "text": "Udara tambah, warna berubah; tanpa udara?"
    },
    "p247": {
      "source_hash": "a876a7f387c3",
      "text": "Ingat soal awal? Berdiri di Bulan, siang, lihat atas."
    },
    "p248": {
      "source_hash": "6f35edeb1a17",
      "text": "Di Bulan..."
    },
    "p249": {
      "source_hash": "81814b978776",
      "text": "ada udara?"
    },
    "p250": {
      "source_hash": "6be203fcda20",
      "text": "Hampir tidak, cuma sedikit dan tipis."
    },
    "p251": {
      "source_hash": "ff7d85152b80",
      "text": "Tanpa udara, tanpa bola"
    },
    "p252": {
      "source_hash": "83f42106a8dc",
      "text": "yang memantulkan biru…"
    },
    "p253": {
      "source_hash": "9b0fab01141b",
      "text": "Langitnya hitam!"
    },
    "p254": {
      "source_hash": "8d10051d754a",
      "text": "Ya. Matahari terang, tapi langit siang Bulan hitam."
    },
    "p255": {
      "source_hash": "016312066e83",
      "text": "Tanah terang, langit hitam pekat."
    },
    "p256": {
      "source_hash": "13692b95dc05",
      "text": "Oh!"
    },
    "p257": {
      "source_hash": "fe4f29613937",
      "text": "Ingat biru dan merah di atap?"
    },
    "p258": {
      "source_hash": "85dfb2550853",
      "text": "Sinarnya"
    },
    "p259": {
      "source_hash": "4b7ec82c8b10",
      "text": "jalan pendek dan panjang!"
    },
    "p260": {
      "source_hash": "728f29b2d2b8",
      "text": "Lihat langit, pikirkan:"
    },
    "p261": {
      "source_hash": "28af7ff0a8ae",
      "text": "seberapa jauh cahaya ini berjalan padamu."
    },
    "p262": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p263": {
      "source_hash": "bf70b61e7d63",
      "text": "Senja terunikmu?"
    },
    "p264": {
      "source_hash": "0e4e1b6625fb",
      "text": "Warna apa, di mana? Komen!"
    },
    "p265": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
