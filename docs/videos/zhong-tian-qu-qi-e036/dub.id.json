{
  "zq36a01": {
    "text": "Yang masuk, dapat makan.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "Tapi harus kerja.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "Xu Yan, kau gila!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "Mereka habiskan beras,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "kalian yang kelaparan!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "Beras cuma cukup dua bulan.",
    "emotion": "精明，快",
    "say": "Beras cukup dua bulan."
  },
  "zq36a07": {
    "text": "Dua bulan, gali satu saluran.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "Satu cangkul, satu mangkuk.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "Lebih dalam lagi!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "Sepuluh kaki, semangkuk.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "Nama, sebut ke dia.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "Berikutnya!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "Sepatunya baru.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "Tangannya kapalan.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "Mereka bertanya—",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "di mana perempuan pendiam itu tinggal.",
    "say": "Perempuan pendiam itu, tinggal di mana.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "Awasi mereka.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "Diam-diam saja.",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "Sekarung pun nggak laku?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "Semalam,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "anjlok setengah!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "Xu Yan—!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "Daftar namanya?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "Buat jatah beras besok.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "Tulisan ini…",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "Rapi kayak surat istana.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "Cuma tulisan.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "Tulisan bagus.",
    "say": "Bagus.",
    "emotion": "微笑，輕快"
  },
  "zq36a29": {
    "text": "Nggak tanya.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "Padat karya: berhasil.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "Tiga.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "Genderang?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "Di gunung.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "Perampok.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "Laki-laki,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "cuma puluhan.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "Ratusan obor…",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "Tutup gerbang.",
    "say": "Tutup!",
    "emotion": "開場開的門，現在他自己關"
  }
}
