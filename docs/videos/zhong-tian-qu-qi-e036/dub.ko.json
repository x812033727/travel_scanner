{
  "zq36a01": {
    "text": "들어오면, 다 먹여 준다.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "대신 일해야 해.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "쉬옌, 미쳤느냐!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "곡식 다 먹어 치우면,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "굶어 죽는 건 너희다!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "곡식은 두 달 치뿐이에요.",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "두 달 동안, 수로 하나.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "괭이 한 번, 밥 한 그릇.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "한 자 더!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "열 자 파면, 한 그릇.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "이름은, 저분한테.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "다음!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "신발이 새거야.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "손에 굳은살투성이.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "다들 묻고 있어——",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "말 없는 그 여자, 어디 사냐고.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "지켜봐.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "조용히.",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "한 말도 안 팔렸다고?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "하룻밤에,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "반값이라니!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "쉬옌——!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "명부는요?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "아침 배급에 필요해요.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "이 글씨……",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "궁궐 문서처럼 반듯해.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "그냥 글씨야.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "좋은 글씨네.",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "안 물을게.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "근로 구휼, 달성.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "셋.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "북소리?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "산 위.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "도적 떼다.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "장정은,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "수십 명.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "횃불이 수백 개……",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "문 닫아.",
    "emotion": "開場開的門，現在他自己關"
  }
}
