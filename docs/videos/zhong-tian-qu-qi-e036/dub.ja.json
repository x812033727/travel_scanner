{
  "zq36a01": {
    "text": "来た者には、飯を出す。",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "ただし、働け。",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "シュー・イェン、正気か！",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "米を食い尽くされ、",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "飢え死ぬのはお前らじゃ！",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "米は二月しかもたない。",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "二月で、水路を一本。",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "鍬一振り、飯一杯。",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "あと一尺！",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "一丈掘って、一杯ね。",
    "emotion": "精明，快",
    "say": "一丈で一杯ね。"
  },
  "zq36a11": {
    "text": "名前は、彼女に。",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "次！",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "靴が新しい。",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "手はタコだらけ。",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "聞いて回ってる——",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "あの無口な女は、どこに住むか。",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "見張れ。",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "騒ぐな。",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "一斗も売れんだと？",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "一晩で、",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "半値じゃ！",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "シュー・イェン——！",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "名簿は？",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "明日の配給に要るの。",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "この字……",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "宮中の書状みたいに端正。",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "ただの字。",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "いい字だ。",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "聞かない。",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "以工代賑、達成。",
    "say": "いこうだいしん、達成。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "三人。",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "太鼓？",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "山だ。",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "流賊だ。",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "男手は、",
    "emotion": "冷靜，短促"
  },
  "zq36a36": {
    "text": "数十人。",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "松明が何百も……",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "門を閉めろ。",
    "emotion": "開場開的門，現在他自己關"
  }
}
