{
  "zq36a01": {
    "text": "Whoever comes in eats.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "But you work.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "Xu Yan, you're mad!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "They'll eat all the grain,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "and you're the ones who starve!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "The grain lasts two months.",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "Two months, one canal.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "One hoe, one bowl.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "A foot deeper!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "Ten feet dug, one bowl.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "Names, tell her.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "Next!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "New shoes.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "Calloused hands.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "They're asking—",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "where the silent woman lives.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "Watch them.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "Keep it quiet.",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "Not one peck sold?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "One night,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "and it's down by half!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "Xu Yan—!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "The register?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "It's for tomorrow's rations.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "This writing…",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "Neat as a palace document.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "Just writing.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "Nice hand.",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "No questions.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "Work for food: done.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "Three.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "Drums?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "The hill.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "Bandits.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "Men,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "a few dozen.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "Hundreds of torches…",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "Shut the gate.",
    "emotion": "開場開的門，現在他自己關"
  }
}
