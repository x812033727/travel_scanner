{
  "zq36a01": {
    "text": "Ai vào, đều có cơm.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "Nhưng phải làm việc.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "Hứa Nghiên, ngươi điên rồi!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "Chúng ăn hết lương,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "kẻ chết đói là các ngươi!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "Lương chỉ đủ hai tháng.",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "Hai tháng, đào một con kênh.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "Một nhát cuốc, một bát cơm.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "Sâu thêm một thước!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "Đào một trượng, ghi một bát.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "Họ tên, báo cho cô ấy.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "Người tiếp theo!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "Giày còn mới.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "Hổ khẩu toàn vết chai.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "Chúng đang hỏi——",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "người đàn bà không nói kia, ở đâu.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "Trông chừng chúng.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "Đừng lộ ra.",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "Một đấu cũng không ai mua?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "Một đêm,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "rớt mất một nửa!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "Hứa Nghiên——!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "Danh sách đâu?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "Sáng mai phát lương cần dùng.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "Chữ này…",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "Ngay ngắn như thiếp trong cung.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "Chỉ là chữ.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "Chữ đẹp.",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "Không hỏi.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "Làm công đổi cơm: đạt.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "Ba người.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "Tiếng trống?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "Trên núi.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "Giặc cỏ.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "Trai tráng,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "vài chục người.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "Mấy trăm ngọn đuốc…",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "Đóng cổng.",
    "emotion": "開場開的門，現在他自己關"
  }
}
