{
  "zq36a01": {
    "text": "Quien entre, come.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "Pero trabaja.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "¡Xu Yan, estás loco!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "Se comerán el grano,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "¡y ustedes mueren de hambre!",
    "say": "¡y ustedes mueren!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "El grano dura dos meses.",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "Dos meses: un canal.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "Un azadón, un tazón.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "¡Un pie más!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "Diez pies, un tazón.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "Nombres, a ella.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "¡Siguiente!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "Zapatos nuevos.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "Manos con callos.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "Están preguntando—",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "dónde vive la mujer callada.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "Vigílalos.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "Sin alarmas.",
    "emotion": "眼睛看著遠處的桌子"
  },
  "zq36a19": {
    "text": "¿Ni un saco vendido?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "En una noche,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "¡bajó a la mitad!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "¡Xu Yan—!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "¿Y el registro?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "Mañana hay raciones.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "Esta letra…",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "Pulcra como de palacio.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "Solo es letra.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "Buena letra.",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "No pregunto.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "Trabajo por pan: logrado.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "Tres.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "¿Tambores?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "En el monte.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "Bandidos.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "Hombres,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "unas decenas.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "Cientos de antorchas…",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "Cierren la puerta.",
    "say": "¡Cierren!",
    "emotion": "開場開的門，現在他自己關"
  }
}
