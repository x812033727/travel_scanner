{
  "zq36a01": {
    "text": "Quem entrar, come.",
    "emotion": "手按在門閂上，很穩"
  },
  "zq36a02": {
    "text": "Mas trabalha.",
    "emotion": "對著整個門口說"
  },
  "zq36a03": {
    "text": "Xu Yan, ficou louco!",
    "emotion": "在門樓上尖叫"
  },
  "zq36a04": {
    "text": "Eles vão comer o grão,",
    "emotion": "指著流民，煽動"
  },
  "zq36a05": {
    "text": "e vocês morrem de fome!",
    "emotion": "對著村民吼"
  },
  "zq36a06": {
    "text": "O grão só dura dois meses.",
    "emotion": "算盤打完，小聲"
  },
  "zq36a07": {
    "text": "Dois meses, um canal.",
    "emotion": "對著流民，聲音放大"
  },
  "zq36a08": {
    "text": "Uma enxada, uma tigela.",
    "emotion": "畫外，一字一字"
  },
  "zq36a09": {
    "text": "Mais um palmo!",
    "emotion": "在渠裡吼，喘"
  },
  "zq36a10": {
    "text": "Dez palmos, uma tigela.",
    "emotion": "算盤一撥，精明"
  },
  "zq36a11": {
    "text": "Nome, diga pra ela.",
    "emotion": "畫外，快"
  },
  "zq36a12": {
    "text": "Próximo!",
    "emotion": "畫外，清脆"
  },
  "zq36a13": {
    "text": "Sapatos novos.",
    "emotion": "畫外，壓低聲音"
  },
  "zq36a14": {
    "text": "Mãos cheias de calo.",
    "emotion": "畫外，冷"
  },
  "zq36a15": {
    "text": "Estão perguntando—",
    "emotion": "靠近許硯，壓低聲音"
  },
  "zq36a16": {
    "text": "onde mora a mulher calada.",
    "emotion": "畫外，一字一字"
  },
  "zq36a17": {
    "text": "Vigie eles.",
    "emotion": "低聲"
  },
  "zq36a18": {
    "text": "Sem alarde.",
    "emotion": "淡淡，短促"
  },
  "zq36a19": {
    "text": "Nem um saco vendido?",
    "emotion": "拍著帳本，不信"
  },
  "zq36a20": {
    "text": "Numa noite,",
    "emotion": "聲音發抖"
  },
  "zq36a21": {
    "text": "caiu pela metade!",
    "emotion": "吼，臉漲紅"
  },
  "zq36a22": {
    "text": "Xu Yan—!",
    "emotion": "畫外，咬牙切齒"
  },
  "zq36a23": {
    "text": "E o registro?",
    "emotion": "帳算完，抬頭"
  },
  "zq36a24": {
    "text": "É pra ração de amanhã.",
    "emotion": "催"
  },
  "zq36a25": {
    "text": "Essa letra…",
    "emotion": "畫外，看呆了"
  },
  "zq36a26": {
    "text": "Caprichada como do palácio.",
    "emotion": "小聲，眼睛睜大"
  },
  "zq36a27": {
    "text": "É só letra.",
    "emotion": "淡淡的，不抬頭"
  },
  "zq36a28": {
    "text": "Bela letra.",
    "emotion": "提著油燈走來，笑"
  },
  "zq36a29": {
    "text": "Não pergunto.",
    "say": "Prometi.",
    "emotion": "很輕，守第 31 集的約"
  },
  "zq36a30": {
    "text": "Trabalho por comida: feito.",
    "say": "Trabalho por pão: feito.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq36a31": {
    "text": "Três.",
    "emotion": "低聲，眼睛睜開"
  },
  "zq36a32": {
    "text": "Tambores?",
    "emotion": "在牆頭，頭猛地轉向山"
  },
  "zq36a33": {
    "text": "No morro.",
    "emotion": "指著遠處，短"
  },
  "zq36a34": {
    "text": "Bandidos.",
    "emotion": "兩個字，臉被燈照著"
  },
  "zq36a35": {
    "text": "Homens,",
    "emotion": "數著，冷靜"
  },
  "zq36a36": {
    "text": "umas dezenas.",
    "emotion": "聲音壓著"
  },
  "zq36a37": {
    "text": "Centenas de tochas…",
    "emotion": "抓著袖子，聲音發抖"
  },
  "zq36a38": {
    "text": "Fechem o portão.",
    "say": "Fechem!",
    "emotion": "開場開的門，現在他自己關"
  }
}
