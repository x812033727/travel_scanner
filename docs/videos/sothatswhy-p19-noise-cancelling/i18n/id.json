  },
  "lines": {
    "p001": {
      "source_hash": "8dc53cf51749",
      "text": "Kepala Biro! Hebat sekali!"
    },
    "p002": {
      "source_hash": "2e1e4f9630b2",
      "text": "Bising MRT langsung hilang,"
    },
    "p003": {
      "source_hash": "4ef72bdb656a",
      "text": "Anda bicara di sini,"
    },
    "p004": {
      "source_hash": "e10436d54049",
      "text": "kenapa masih jelas terdengar?"
    },
    "p005": {
      "source_hash": "0c47b343a6ef",
      "text": "Orang kira headphone itu perisai,"
    },
    "p006": {
      "source_hash": "adb89cd35b66",
      "text": "menyerap suara layaknya spons."
    },
    "p007": {
      "source_hash": "44c680018ab9",
      "text": "Spons tak tahan?"
    },
    "p008": {
      "source_hash": "89977c7ec83d",
      "text": "Spons cuma tahan nada tinggi,"
    },
    "p009": {
      "source_hash": "833cf722adc7",
      "text": "gelombang nada rendah lolos terus!"
    },
    "p010": {
      "source_hash": "5f7af684150c",
      "text": "Dengung rel MRT dan AC,"
    },
    "p011": {
      "source_hash": "aab38d96e12f",
      "text": "getarannya tembus sela busa ke telinga."
    },
    "p012": {
      "source_hash": "233087b6c34d",
      "text": "Nada tinggi terserap gesekan spons,"
    },
    "p013": {
      "source_hash": "ec304867907f",
      "text": "tapi nada rendah langsung tembus!"
    },
    "p014": {
      "source_hash": "ee50531509ba",
      "text": "Pantas pakai spons,"
    },
    "p015": {
      "source_hash": "d645cefd1223",
      "text": "mesin berbunyi!"
    },
    "p016": {
      "source_hash": "46d1aa6225c3",
      "text": "Kuncinya bukan menyerap suara,"
    },
    "p017": {
      "source_hash": "7c2b366911fc",
      "text": "tapi memutar suara kedua di telinga!"
    },
    "p018": {
      "source_hash": "9ba420486887",
      "text": "2 suara?"
    },
    "p019": {
      "source_hash": "9c5e53fb199a",
      "text": "Makin bising dong?"
    },
    "p020": {
      "source_hash": "cbf978222b89",
      "text": "Inilah pesona akustik:"
    },
    "p021": {
      "source_hash": "9648578a26d1",
      "text": "suara bunuh suara, tanpa bising!"
    },
    "p022": {
      "source_hash": "896c2fd788ac",
      "text": "Beri tahu!"
    },
    "p023": {
      "source_hash": "f31d68edd998",
      "text": "Cara redam suara?"
    },
    "p024": {
      "source_hash": "81e08484b506",
      "text": "Fisika suara: interferensi destruktif!"
    },
    "p025": {
      "source_hash": "9ca06e3e157c",
      "text": "Suara adalah gelombang tekan udara."
    },
    "p026": {
      "source_hash": "2c3c2921dedb",
      "text": "Udara rapat itu puncak, bertekanan tinggi;"
    },
    "p027": {
      "source_hash": "57b4f9438a3f",
      "text": "yang renggang itu lembah, bertekanan rendah."
    },
    "p028": {
      "source_hash": "6dd1f9329810",
      "text": "Gendang telinga ditarik!"
    },
    "p029": {
      "source_hash": "b61c9b1178f5",
      "text": "Lalu cara ratakannya?"
    },
    "p030": {
      "source_hash": "ab535880693c",
      "text": "Mikrofon lacak bentuk gelombang bising,"
    },
    "p031": {
      "source_hash": "b16113c399f0",
      "text": "chip langsung bikin gelombang antifase!"
    },
    "p032": {
      "source_hash": "f0056a81738e",
      "text": "Puncak dorong, headphone tarik lembah;"
    },
    "p033": {
      "source_hash": "33a140623ac9",
      "text": "tekanan tinggi plus rendah zong di gendang!"
    },
    "p034": {
      "source_hash": "9bdef7b30e86",
      "text": "Plus minus jadi nol!"
    },
    "p035": {
      "source_hash": "0b4a6bfe78e8",
      "text": "Suara hapus suara!"
    },
    "p036": {
      "source_hash": "b310bd279c5a",
      "text": "Di saluran telinga, dua tekanan saling hapus,"
    },
    "p037": {
      "source_hash": "c16cf6a7c39b",
      "text": "gendang tenang, dunia pun sunyi."
    },
    "p038": {
      "source_hash": "a4f1fba75c98",
      "text": "Dua suara tabrakan,"
    },
    "p039": {
      "source_hash": "d075e281766a",
      "text": "energi suara ke mana?"
    },
    "p040": {
      "source_hash": "6703eff1433d",
      "text": "Pintar! Energi tak hilang begitu saja,"
    },
    "p041": {
      "source_hash": "6ce2e78cdfa0",
      "text": "gelombang antifase ubah impedansi akustik!"
    },
    "p042": {
      "source_hash": "b2435851fe62",
      "text": "Dorongan balik bikin sumber luar tak berdaya,"
    },
    "p043": {
      "source_hash": "18ff39618e46",
      "text": "di telinga, energi suara ditekan di sumbernya!"
    },
    "p044": {
      "source_hash": "579b037980bc",
      "text": "Peredam ajaib,"
    },
    "p045": {
      "source_hash": "c415e11502e4",
      "text": "baru ada karena chip canggih?"
    },
    "p046": {
      "source_hash": "adc255467379",
      "text": "90 tahun lalu insinyur Jerman sudah tahu,"
    },
    "p047": {
      "source_hash": "3798dbf7a3cc",
      "text": "tapi tanpa komputer tak bisa dihitung!"
    },
    "p048": {
      "source_hash": "605293651fb0",
      "text": "1936, Lueg uji paten pipa suara,"
    },
    "p049": {
      "source_hash": "24768e044ae5",
      "text": "tabung vakum lambat, bisingnya malah naik."
    },
    "p050": {
      "source_hash": "b09b06388c88",
      "text": "Setelah chip digital mikro hadir,"
    },
    "p051": {
      "source_hash": "30a320c6704b",
      "text": "ANC baru muat di headphone kecil."
    },
    "p052": {
      "source_hash": "fdc7a4ebd4d3",
      "text": "Kalau bisa hitung antifase,"
    },
    "p053": {
      "source_hash": "2c611a4b4f6d",
      "text": "kenapa cuma hapus MRT, bukan suara Anda?"
    },
    "p054": {
      "source_hash": "eaca33cb13dd",
      "text": "Kuncinya panjang gelombang suara!"
    },
    "p055": {
      "source_hash": "4a0371a55290",
      "text": "Panjang nada rendah dan tinggi beda jauh."
    },
    "p056": {
      "source_hash": "83d7abf933c9",
      "text": "Frekuensi 100 Hz MRT panjangnya 3,4 meter!"
    },
    "p057": {
      "source_hash": "846bbd0af309",
      "text": "Suara orang 2.000 Hz cuma 17 sentimeter."
    },
    "p058": {
      "source_hash": "dc8025d67cb1",
      "text": "3 meter lebih dari kasur!"
    },
    "p059": {
      "source_hash": "fba96ceb6086",
      "text": "Lalu apa kaitannya soal redam?"
    },
    "p060": {
      "source_hash": "4f474cd6cb76",
      "text": "Saluran telingamu cuma 2-3 cm!"
    },
    "p061": {
      "source_hash": "ea8ce16d73fa",
      "text": "Gelombang 3 meter masuk, tekanan rata di telinga."
    },
    "p062": {
      "source_hash": "f5c6ff0c8898",
      "text": "Gelombang antifase mudah selimuti telinga,"
    },
    "p063": {
      "source_hash": "fdf3f4a9cde9",
      "text": "dalam akustik: \"zona senyap lokal\"."
    },
    "p064": {
      "source_hash": "02a44fee8901",
      "text": "Seperti sembunyi di kubah damai!"
    },
    "p065": {
      "source_hash": "e030b76738a9",
      "text": "Lalu gelombang suara orang?"
    },
    "p066": {
      "source_hash": "c402c6b3657e",
      "text": "Gelombang bicara pendek dan rapat!"
    },
    "p067": {
      "source_hash": "bf6849278bdf",
      "text": "Headphone geser 1 cm atau telat mikrodetik,"
    },
    "p068": {
      "source_hash": "8c9f56aec7e9",
      "text": "antifase meleset, puncak ketemu puncak,"
    },
    "p069": {
      "source_hash": "4dc8bac162d5",
      "text": "suara malah membesar jadi jeritan tajam!"
    },
    "p070": {
      "source_hash": "5af515f484d6",
      "text": "Salah hitung, headphone jerit!"
    },
    "p071": {
      "source_hash": "ef572b030ff6",
      "text": "Takut redam nada tinggi ya?"
    },
    "p072": {
      "source_hash": "2fad35ec350a",
      "text": "Tepat! Di atas 1.000 Hz itu ranjau destruktif,"
    },
    "p073": {
      "source_hash": "3ad89e48a5d0",
      "text": "dipaksa cuma bikin headphone memekik."
    },
    "p074": {
      "source_hash": "e11818efee56",
      "text": "Kalau kepala nengok gimana?"
    },
    "p075": {
      "source_hash": "f0221c949094",
      "text": "Meleset 0,5 cm, antifase nada tinggi buyar!"
    },
    "p076": {
      "source_hash": "7e0a6a570dad",
      "text": "Puncak peredam malah tumpuk puncak lain!"
    },
    "p077": {
      "source_hash": "9a1630c87538",
      "text": "Pantas! Tapi saat baru nyala,"
    },
    "p078": {
      "source_hash": "e3db50ccc245",
      "text": "kenapa ada rasa tekan di telinga?"
    },
    "p079": {
      "source_hash": "a5adbc4ac745",
      "text": "Tekanan udara telinga tak berubah sama sekali"
    },
    "p080": {
      "source_hash": "91d9c5a6c5f7",
      "text": "Otak kaget dengung rendah hilang mendadak!"
    },
    "p081": {
      "source_hash": "c0f845d98a74",
      "text": "Otak kira turun di lift kencang,"
    },
    "p082": {
      "source_hash": "bd8935f4dd54",
      "text": "tarik napas dua menit, rasa itu pun hilang."
    },
    "p083": {
      "source_hash": "3d0a4031a3b5",
      "text": "Cara tahu luar,"
    },
    "p084": {
      "source_hash": "d7bd60193903",
      "text": "dan cek telinga senyap?"
    },
    "p085": {
      "source_hash": "2b5b6204ebd0",
      "text": "Andalkan mikrofon ganda kerja sama!"
    },
    "p086": {
      "source_hash": "076d3536c0ba",
      "text": "Satu dengar luar, satu cek gendang di dalam."
    },
    "p087": {
      "source_hash": "ed4d1ff32f3e",
      "text": "Mic luar beri sinyal awal,"
    },
    "p088": {
      "source_hash": "3925c0571b0e",
      "text": "mic dalam tambal bocoran suara."
    },
    "p089": {
      "source_hash": "ff1cb5dab945",
      "text": "Mic dalam kan dekat,"
    },
    "p090": {
      "source_hash": "9af0b9441032",
      "text": "kenapa tak urus semuanya sendiri?"
    },
    "p091": {
      "source_hash": "afe328765d55",
      "text": "Mikrofon dalam punya jeda fatal!"
    },
    "p092": {
      "source_hash": "d9c3386eabad",
      "text": "Suara masuk dulu; kalau respons telat, speaker melolong!"
    },
    "p093": {
      "source_hash": "d07b8466091f",
      "text": "Mirip mic hadap speaker,"
    },
    "p094": {
      "source_hash": "33d1e23b0bf6",
      "text": "cuma tangani di bawah 500 Hz."
    },
    "p095": {
      "source_hash": "12c43cc668ea",
      "text": "Mic luar gimana?"
    },
    "p096": {
      "source_hash": "da3e224c9e70",
      "text": "Kalah cepat dari suara?"
    },
    "p097": {
      "source_hash": "4650a59c25af",
      "text": "Suara 343 meter/detik!"
    },
    "p098": {
      "source_hash": "e81fec1a2264",
      "text": "Jarak ke telinga 2 cm; udara cuma beri 60 mikrodetik!"
    },
    "p099": {
      "source_hash": "def9b3fb8241",
      "text": "Rekam mic, olah chip, getar speaker,"
    },
    "p100": {
      "source_hash": "7b642ad0ff28",
      "text": "hardware tercepat pun butuh 20 mikrodetik!"
    },
    "p101": {
      "source_hash": "418a67e73a77",
      "text": "Waktu sisa tipis!"
    },
    "p102": {
      "source_hash": "21125427b857",
      "text": "MRT kok keburu?"
    },
    "p103": {
      "source_hash": "93a8e9c07946",
      "text": "MRT dan AC itu \"gelombang teratur\"!"
    },
    "p104": {
      "source_hash": "becbdd4e8514",
      "text": "Pola berulang, chip tebak gelombang esok!"
    },
    "p105": {
      "source_hash": "084cce3cebc1",
      "text": "Chip paham ritme, siapkan antifase duluan;"
    },
    "p106": {
      "source_hash": "0d3a4d0afcab",
      "text": "tapi bicara orang serba acak!"
    },
    "p107": {
      "source_hash": "7a897bdbc91e",
      "text": "Tak ada yang tahu detik depan kamu bunyi \"p\" atau \"t\","
    },
    "p108": {
      "source_hash": "7774e85b6d48",
      "text": "chip tak bisa tebak, suara keburu masuk telinga!"
    },
    "p109": {
      "source_hash": "56a3fddcdf92",
      "text": "Roda MRT berputar ritmis teratur,"
    },
    "p110": {
      "source_hash": "091675563fc2",
      "text": "orang ngobrol serba acak!"
    },
    "p111": {
      "source_hash": "a6c6509909f0",
      "text": "Yang teratur tertebak; yang acak bikin pasrah."
    },
    "p112": {
      "source_hash": "f339c6e9988c",
      "text": "Itu logika matematika ciamik headphone ANC."
    },
    "p113": {
      "source_hash": "c8f7af2c8b5b",
      "text": "Lalu mode transparansi,"
    },
    "p114": {
      "source_hash": "c0e5477de250",
      "text": "bisa dengar orang sebelah gimana?"
    },
    "p115": {
      "source_hash": "c63d962ad561",
      "text": "Mode transparansi sebaliknya! Mic luar serap suara,"
    },
    "p116": {
      "source_hash": "2a327eb2f406",
      "text": "atur waktu pas dan putar ke gendang, seolah headphone bening!"
    },
    "p117": {
      "source_hash": "de0f39270377",
      "text": "Rahasia headphone,"
    },
    "p118": {
      "source_hash": "00872e90f957",
      "text": "paduan fisika matematika?"
    },
    "p119": {
      "source_hash": "1aad7509c64d",
      "text": "Saya paham!"
    },
    "p120": {
      "source_hash": "7f85a7103730",
      "text": "Nada rendah panjang: toleransi besar!"
    },
    "p121": {
      "source_hash": "7a0d474d853f",
      "text": "Mesin berpola: headphone tebak duluan!"
    },
    "p122": {
      "source_hash": "27b7582e4f25",
      "text": "Suara orang acak: chip tak sempat!"
    },
    "p123": {
      "source_hash": "78bc2bb5e6a5",
      "text": "Tepat! Nilai seratus buat Tanya hari ini!"
    },
    "p124": {
      "source_hash": "c464fdac5efc",
      "text": "Suara tinggi orang diredam bantalan tebal headphone."
    },
    "p125": {
      "source_hash": "1b677bb9dcdf",
      "text": "Busa dan bodi pakai hukum massa,"
    },
    "p126": {
      "source_hash": "09a6b84e2904",
      "text": "redam suara orang di atas 2.000 Hz hingga belasan dB."
    },
    "p127": {
      "source_hash": "ee3a7414573a",
      "text": "Saat nyalakan ANC di kantor,"
    },
    "p128": {
      "source_hash": "864df00d3320",
      "text": "dengung AC lenyap, tapi orang panggil namamu terdengar!"
    },
    "p129": {
      "source_hash": "827e6e823b78",
      "text": "Waktu bicara pakai headphone,"
    },
    "p130": {
      "source_hash": "e90e6783e2be",
      "text": "suara sendiri jelas banget?"
    },
    "p131": {
      "source_hash": "c8d8fcd65f73",
      "text": "Konduksi tulang! Pita suara getarkan tengkorak,"
    },
    "p132": {
      "source_hash": "bc7116ab6f9a",
      "text": "suara tembus telinga dalam tanpa lewat udara!"
    },
    "p133": {
      "source_hash": "8f8ecc143615",
      "text": "Meski saluran telinga hampa udara,"
    },
    "p134": {
      "source_hash": "cca6bd0db6ed",
      "text": "suara tulang tetap getarkan kokleamu!"
    },
    "p135": {
      "source_hash": "059d6484089d",
      "text": "Tutup kuping sambil senandung,"
    },
    "p136": {
      "source_hash": "eb1b9257f1a0",
      "text": "suara dengung makin keras!"
    },
    "p137": {
      "source_hash": "554a09818efe",
      "text": "Nama medis: \"efek oklusi\"!"
    },
    "p138": {
      "source_hash": "b68ba4400e78",
      "text": "Telinga tertutup jebak getaran tulang rendah, suara pun berat."
    },
    "p139": {
      "source_hash": "a34405607fff",
      "text": "Di rumah,"
    },
    "p140": {
      "source_hash": "e2c73f6bc62a",
      "text": "cara tes batas ANC gimana?"
    },
    "p141": {
      "source_hash": "7ff46be65575",
      "text": "Pakai headphone, nyalakan ANC, jentikkan jari atau ketik!"
    },
    "p142": {
      "source_hash": "e1b6ed0fb953",
      "text": "Klik renyah tetap ada, tapi dengung kipas angin hilang total."
    },
    "p143": {
      "source_hash": "4835cea2336f",
      "text": "Tes kecil ini buktikan cepat"
    },
    "p144": {
      "source_hash": "7ec634c8f2e5",
      "text": "paduan isolasi fisik dan peredam aktif!"
    },
    "p145": {
      "source_hash": "5816e29ed9fa",
      "text": "Tak redam habis suara orang itu demi aman."
    },
    "p146": {
      "source_hash": "1e34b257f54b",
      "text": "Di jalan tak dengar klakson mobil sangat berbahaya!"
    },
    "p147": {
      "source_hash": "565f1d6cd189",
      "text": "Sisakan suara luar,"
    },
    "p148": {
      "source_hash": "c045e7665da0",
      "text": "agar aman di jalan dan tak kaget!"
    },
    "p149": {
      "source_hash": "4b582930e232",
      "text": "Saat pakai headphone ANC, suara apa yang paling sulit hilang?"
    },
    "p150": {
      "source_hash": "ffceb5fe972b",
      "text": "Komen dan diskusi bareng kami!"
    }
  }
}
