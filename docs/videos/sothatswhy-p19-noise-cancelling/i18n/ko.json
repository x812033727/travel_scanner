    "thumbnail": "5bd37a3a00fd"
  },
  "lines": {
    "p001": {
      "source_hash": "8dc53cf51749",
      "text": "소장님! 헤드폰 대박!"
    },
    "p002": {
      "source_hash": "2e1e4f9630b2",
      "text": "지하철 소음 싹 사라졌어요!"
    },
    "p003": {
      "source_hash": "4ef72bdb656a",
      "text": "근데 옆 소장님 말씀은,"
    },
    "p004": {
      "source_hash": "e10436d54049",
      "text": "왜 잘 들리죠?"
    },
    "p005": {
      "source_hash": "0c47b343a6ef",
      "text": "다들 노캔을 투명 방패로 생각하죠."
    },
    "p006": {
      "source_hash": "adb89cd35b66",
      "text": "소리를 스펀지처럼 흡수한다고 여겨요."
    },
    "p007": {
      "source_hash": "44c680018ab9",
      "text": "스펀지가 안 막아요?"
    },
    "p008": {
      "source_hash": "89977c7ec83d",
      "text": "스펀지는 고음만 막고,"
    },
    "p009": {
      "source_hash": "833cf722adc7",
      "text": "거대 저음 파도는 못 막죠!"
    },
    "p010": {
      "source_hash": "5f7af684150c",
      "text": "지하철이나 에어컨의 저음 진동은,"
    },
    "p011": {
      "source_hash": "aab38d96e12f",
      "text": "틈새를 뚫고 귀로 바로 들어오죠."
    },
    "p012": {
      "source_hash": "233087b6c34d",
      "text": "고음은 마찰로 흡수되지만,"
    },
    "p013": {
      "source_hash": "ec304867907f",
      "text": "긴 저음은 그냥 통과!"
    },
    "p014": {
      "source_hash": "ee50531509ba",
      "text": "귀마개 껴도,"
    },
    "p015": {
      "source_hash": "d645cefd1223",
      "text": "엔진 진동은 울리던데요!"
    },
    "p016": {
      "source_hash": "46d1aa6225c3",
      "text": "비밀은 흡수가 아니라,"
    },
    "p017": {
      "source_hash": "7c2b366911fc",
      "text": "귀에 두 번째 소리를 트는 거예요!"
    },
    "p018": {
      "source_hash": "9ba420486887",
      "text": "또 틀어요?"
    },
    "p019": {
      "source_hash": "9c5e53fb199a",
      "text": "더 시끄럽잖아요?"
    },
    "p020": {
      "source_hash": "cbf978222b89",
      "text": "그게 음향학의 매력!"
    },
    "p021": {
      "source_hash": "9648578a26d1",
      "text": "소리로 소릴 없애니까요!"
    },
    "p022": {
      "source_hash": "896c2fd788ac",
      "text": "알려줘요!"
    },
    "p023": {
      "source_hash": "f31d68edd998",
      "text": "소리로 소릴 어떻게 없애요?"
    },
    "p024": {
      "source_hash": "81e08484b506",
      "text": "신기한 물리, 상쇄 간섭이죠!"
    },
    "p025": {
      "source_hash": "9ca06e3e157c",
      "text": "소리는 공기가 미는 압력 파동!"
    },
    "p026": {
      "source_hash": "2c3c2921dedb",
      "text": "공기가 뭉치면 마루, 기압 높고,"
    },
    "p027": {
      "source_hash": "57b4f9438a3f",
      "text": "공기가 퍼지면 골, 기압 낮죠."
    },
    "p028": {
      "source_hash": "6dd1f9329810",
      "text": "밀고 당겨야 들리는군요!"
    },
    "p029": {
      "source_hash": "b61c9b1178f5",
      "text": "그걸 어떻게 펴요?"
    },
    "p030": {
      "source_hash": "ab535880693c",
      "text": "마이크가 소음 파형을 잡고,"
    },
    "p031": {
      "source_hash": "b16113c399f0",
      "text": "칩이 역위상 음파를 계산해요!"
    },
    "p032": {
      "source_hash": "f0056a81738e",
      "text": "마루가 오면 골로 당겨 주어,"
    },
    "p033": {
      "source_hash": "33a140623ac9",
      "text": "고막 앞 공기압이 0이 돼요!"
    },
    "p034": {
      "source_hash": "9bdef7b30e86",
      "text": "더해서 0이 된다!"
    },
    "p035": {
      "source_hash": "0b4a6bfe78e8",
      "text": "소리가 소릴 지웠네요"
    },
    "p036": {
      "source_hash": "b310bd279c5a",
      "text": "귓속에서 두 압력이 상쇄되니,"
    },
    "p037": {
      "source_hash": "c16cf6a7c39b",
      "text": "고막이 안 흔들려 조용해져요."
    },
    "p038": {
      "source_hash": "a4f1fba75c98",
      "text": "소리가 부딪치면,"
    },
    "p039": {
      "source_hash": "d075e281766a",
      "text": "소리 에너지는 어디 가요?"
    },
    "p040": {
      "source_hash": "6703eff1433d",
      "text": "좋은 질문! 에너지는 안 사라져요."
    },
    "p041": {
      "source_hash": "6ce2e78cdfa0",
      "text": "역위상이 음향 임피던스를 바꿔요!"
    },
    "p042": {
      "source_hash": "b2435851fe62",
      "text": "반대로 밀어 외부 소음이 일 못 하게 막아,"
    },
    "p043": {
      "source_hash": "18ff39618e46",
      "text": "소리 에너지가 원천 봉쇄되죠!"
    },
    "p044": {
      "source_hash": "579b037980bc",
      "text": "이런 마법 기술이,"
    },
    "p045": {
      "source_hash": "c415e11502e4",
      "text": "최근에야 발명된 건가요?"
    },
    "p046": {
      "source_hash": "adc255467379",
      "text": "90년 전 독일에서 구상했죠."
    },
    "p047": {
      "source_hash": "3798dbf7a3cc",
      "text": "그땐 컴퓨터가 없어 느렸어요!"
    },
    "p048": {
      "source_hash": "605293651fb0",
      "text": "1936년 루크가 특허를 냈지만,"
    },
    "p049": {
      "source_hash": "24768e044ae5",
      "text": "진공관이 느려 잡음만 커졌죠."
    },
    "p050": {
      "source_hash": "b09b06388c88",
      "text": "현대 디지털 칩 덕분에,"
    },
    "p051": {
      "source_hash": "30a320c6704b",
      "text": "헤드폰에 노캔이 쏙 들어갔답니다."
    },
    "p052": {
      "source_hash": "fdc7a4ebd4d3",
      "text": "근데 제 목소린 안 없애고,"
    },
    "p053": {
      "source_hash": "2c611a4b4f6d",
      "text": "지하철 소리만 없애나요?"
    },
    "p054": {
      "source_hash": "eaca33cb13dd",
      "text": "핵심은 파장의 길이예요!"
    },
    "p055": {
      "source_hash": "4a0371a55290",
      "text": "저음과 고음은 파장이 수십 배 차!"
    },
    "p056": {
      "source_hash": "83d7abf933c9",
      "text": "지하철 100Hz 파장은 3.4m!"
    },
    "p057": {
      "source_hash": "846bbd0af309",
      "text": "사람 목소리 2,000Hz는 17cm죠."
    },
    "p058": {
      "source_hash": "dc8025d67cb1",
      "text": "3미터면 침대보다 길잖아요!"
    },
    "p059": {
      "source_hash": "fba96ceb6086",
      "text": "파장이 왜 중요한가요?"
    },
    "p060": {
      "source_hash": "4f474cd6cb76",
      "text": "귓구멍은 2cm뿐이죠?"
    },
    "p061": {
      "source_hash": "ea8ce16d73fa",
      "text": "3m 저음에 귓속 기압은 균일해요."
    },
    "p062": {
      "source_hash": "f5c6ff0c8898",
      "text": "스피커의 역위상이 귓속을 쉽게 덮어,"
    },
    "p063": {
      "source_hash": "fdf3f4a9cde9",
      "text": "국소 정숙 영역을 만들죠."
    },
    "p064": {
      "source_hash": "02a44fee8901",
      "text": "조용한 보호 거품 같네요!"
    },
    "p065": {
      "source_hash": "e030b76738a9",
      "text": "목소리 같은 짧은 파는요?"
    },
    "p066": {
      "source_hash": "c402c6b3657e",
      "text": "목소린 파장이 너무 짧아요!"
    },
    "p067": {
      "source_hash": "bf6849278bdf",
      "text": "1cm나 몇 μs만 늦어도,"
    },
    "p068": {
      "source_hash": "8c9f56aec7e9",
      "text": "역위상 마루끼리 부딪쳐 버려요."
    },
    "p069": {
      "source_hash": "4dc8bac162d5",
      "text": "줄기는커녕 증폭돼 찢어지죠!"
    },
    "p070": {
      "source_hash": "5af515f484d6",
      "text": "삑 우는 닭 인형처럼요!"
    },
    "p071": {
      "source_hash": "ef572b030ff6",
      "text": "고음은 손 안 대나요?"
    },
    "p072": {
      "source_hash": "2fad35ec350a",
      "text": "맞아요! 1,000Hz 이상은 지뢰밭,"
    },
    "p073": {
      "source_hash": "3ad89e48a5d0",
      "text": "억지로 지우면 찢어지는 소리만 나요."
    },
    "p074": {
      "source_hash": "e11818efee56",
      "text": "고개 돌려 헤드폰이 틀어지면요?"
    },
    "p075": {
      "source_hash": "f0221c949094",
      "text": "0.5cm만 틀어져도 고주파 역위상은 빗나가요!"
    },
    "p076": {
      "source_hash": "7e0a6a570dad",
      "text": "상쇄될 마루가 마루 위에 얹히죠!"
    },
    "p077": {
      "source_hash": "9a1630c87538",
      "text": "노캔 켜면 왜 귀가 먹먹하죠?"
    },
    "p078": {
      "source_hash": "e3db50ccc245",
      "text": "귀 압박감은 왜 느껴져요?"
    },
    "p079": {
      "source_hash": "a5adbc4ac745",
      "text": "귓속 기압은 그대로예요!"
    },
    "p080": {
      "source_hash": "91d9c5a6c5f7",
      "text": "저음이 사라지자 뇌가 착각한 거죠."
    },
    "p081": {
      "source_hash": "c0f845d98a74",
      "text": "급하강 엘리베이터로 오해해요."
    },
    "p082": {
      "source_hash": "bd8935f4dd54",
      "text": "2분 숨쉬면 금방 사라져요."
    },
    "p083": {
      "source_hash": "3d0a4031a3b5",
      "text": "바깥소린 어찌 알고"
    },
    "p084": {
      "source_hash": "d7bd60193903",
      "text": "귓속 상태는 어찌 보죠?"
    },
    "p085": {
      "source_hash": "2b5b6204ebd0",
      "text": "듀얼 마이크가 손발을 맞추죠!"
    },
    "p086": {
      "source_hash": "076d3536c0ba",
      "text": "하나는 바깥, 하나는 고막 옆을 봐요."
    },
    "p087": {
      "source_hash": "ed4d1ff32f3e",
      "text": "바깥 마이크가 미리 알리고,"
    },
    "p088": {
      "source_hash": "3925c0571b0e",
      "text": "안쪽 마이크가 샌 소릴 조정하죠."
    },
    "p089": {
      "source_hash": "ff1cb5dab945",
      "text": "안쪽 마이크가 귀 옆이면,"
    },
    "p090": {
      "source_hash": "9af0b9441032",
      "text": "혼자 다 처리하면 안 돼요?"
    },
    "p091": {
      "source_hash": "afe328765d55",
      "text": "시간 지연이 치명적이거든요!"
    },
    "p092": {
      "source_hash": "d9c3386eabad",
      "text": "소리 들어온 뒤 알면 늦어 울려대요!"
    },
    "p093": {
      "source_hash": "d07b8466091f",
      "text": "마이크를 스피커에 대는 꼴이죠."
    },
    "p094": {
      "source_hash": "33d1e23b0bf6",
      "text": "그래서 500Hz 이하만 조심조심 다뤄요."
    },
    "p095": {
      "source_hash": "12c43cc668ea",
      "text": "바깥쪽은요?"
    },
    "p096": {
      "source_hash": "da3e224c9e70",
      "text": "소리 속도를 못 이기나요?"
    },
    "p097": {
      "source_hash": "4650a59c25af",
      "text": "소린 초속 343m!"
    },
    "p098": {
      "source_hash": "e81fec1a2264",
      "text": "귀까지 2cm라 시간은 60μs뿐이죠!"
    },
    "p099": {
      "source_hash": "def9b3fb8241",
      "text": "마이크 수음, 칩 계산, 스피커 출력에,"
    },
    "p100": {
      "source_hash": "7b642ad0ff28",
      "text": "최소 20μs는 걸리거든요!"
    },
    "p101": {
      "source_hash": "418a67e73a77",
      "text": "남은 건 수십 μs뿐!"
    },
    "p102": {
      "source_hash": "21125427b857",
      "text": "지하철 소린 어찌 잡죠?"
    },
    "p103": {
      "source_hash": "93a8e9c07946",
      "text": "지하철 소음은 규칙적인 주기파!"
    },
    "p104": {
      "source_hash": "becbdd4e8514",
      "text": "반복되니 다음 파동을 미리 예측하죠!"
    },
    "p105": {
      "source_hash": "084cce3cebc1",
      "text": "리듬을 알면 역위상을 미리 준비해요."
    },
    "p106": {
      "source_hash": "0d3a4d0afcab",
      "text": "사람 말소린 불규칙하잖아요!"
    },
    "p107": {
      "source_hash": "7a897bdbc91e",
      "text": "다음에 무슨 발음이 나올지 모르죠."
    },
    "p108": {
      "source_hash": "7774e85b6d48",
      "text": "예측 불가라 계산 끝났을 땐 이미 늦어요!"
    },
    "p109": {
      "source_hash": "56a3fddcdf92",
      "text": "선로는 규칙적으로 덜컹거리지만,"
    },
    "p110": {
      "source_hash": "091675563fc2",
      "text": "사람 말은 불쑥 끼어들죠!"
    },
    "p111": {
      "source_hash": "a6c6509909f0",
      "text": "맞아요! 규칙파만 예측 가능하죠."
    },
    "p112": {
      "source_hash": "f339c6e9988c",
      "text": "이게 노캔의 신기한 수학 원리예요."
    },
    "p113": {
      "source_hash": "c8f7af2c8b5b",
      "text": "주변음 허용 모드는요?"
    },
    "p114": {
      "source_hash": "c0e5477de250",
      "text": "목소린 어찌 들려줘요?"
    },
    "p115": {
      "source_hash": "c63d962ad561",
      "text": "반대예요! 바깥 마이크가 목소리를 잡아,"
    },
    "p116": {
      "source_hash": "2a327eb2f406",
      "text": "타이밍 맞춰 들려주니 헤드폰이 투명해진 느낌!"
    },
    "p117": {
      "source_hash": "de0f39270377",
      "text": "헤드폰의 진짜 비밀은,"
    },
    "p118": {
      "source_hash": "00872e90f957",
      "text": "물리와 수학의 정밀한 조화였네요?"
    },
    "p119": {
      "source_hash": "1aad7509c64d",
      "text": "다 이해돼요!"
    },
    "p120": {
      "source_hash": "7f85a7103730",
      "text": "첫째, 긴 저음은 여유 있다!"
    },
    "p121": {
      "source_hash": "7a0d474d853f",
      "text": "둘째, 엔진 소린 예측된다!"
    },
    "p122": {
      "source_hash": "27b7582e4f25",
      "text": "셋째, 말소린 예측 불가!"
    },
    "p123": {
      "source_hash": "78bc2bb5e6a5",
      "text": "정답! 오늘 큐 추리력 백점이에요!"
    },
    "p124": {
      "source_hash": "c464fdac5efc",
      "text": "말소리는 이어컵으로 물리 차단하죠."
    },
    "p125": {
      "source_hash": "1b677bb9dcdf",
      "text": "패드와 껍질이 질량 법칙 따라,"
    },
    "p126": {
      "source_hash": "09a6b84e2904",
      "text": "2,000Hz 말소릴 10dB 넘게 깎아요."
    },
    "p127": {
      "source_hash": "ee3a7414573a",
      "text": "사무실에서 노캔 켜면,"
    },
    "p128": {
      "source_hash": "864df00d3320",
      "text": "에어컨 소린 꺼져도 이름 부르면 들리죠!"
    },
    "p129": {
      "source_hash": "827e6e823b78",
      "text": "헤드폰 껴도 제 목소린,"
    },
    "p130": {
      "source_hash": "e90e6783e2be",
      "text": "왜 잘 들리나요?"
    },
    "p131": {
      "source_hash": "c8d8fcd65f73",
      "text": "골전도 때문! 성대가 뼈를 울려,"
    },
    "p132": {
      "source_hash": "bc7116ab6f9a",
      "text": "소리가 내이로 바로 들어가거든요!"
    },
    "p133": {
      "source_hash": "8f8ecc143615",
      "text": "귓속 공길 다 빼내도,"
    },
    "p134": {
      "source_hash": "cca6bd0db6ed",
      "text": "뼈 타고 달팽이관을 흔든답니다!"
    },
    "p135": {
      "source_hash": "059d6484089d",
      "text": "귀 막고 콧노래 흥얼거리면,"
    },
    "p136": {
      "source_hash": "eb1b9257f1a0",
      "text": "머릿속 소린 더 크게 울려요!"
    },
    "p137": {
      "source_hash": "554a09818efe",
      "text": "이를 폐쇄 효과라 해요."
    },
    "p138": {
      "source_hash": "b68ba4400e78",
      "text": "닫힌 귀에 저음 골전도가 갇혀 더 묵직하죠."
    },
    "p139": {
      "source_hash": "a34405607fff",
      "text": "노캔 한계는,"
    },
    "p140": {
      "source_hash": "e2c73f6bc62a",
      "text": "시험해 보려면 어떡해요?"
    },
    "p141": {
      "source_hash": "7ff46be65575",
      "text": "노캔 켜고 손가락 튕기거나 자판 쳐봐요!"
    },
    "p142": {
      "source_hash": "e1b6ed0fb953",
      "text": "날카로운 찰칵 소린 남아도 선풍기 소린 싹 사라져요."
    },
    "p143": {
      "source_hash": "4835cea2336f",
      "text": "단 1초 만에,"
    },
    "p144": {
      "source_hash": "7ec634c8f2e5",
      "text": "물리 차음과 노캔 분업을 체감하죠!"
    },
    "p145": {
      "source_hash": "5816e29ed9fa",
      "text": "목소릴 남겨둔 건 안전 때문이기도 해요."
    },
    "p146": {
      "source_hash": "1e34b257f54b",
      "text": "경적 소릴 못 들으면 정말 위험하잖아요!"
    },
    "p147": {
      "source_hash": "565f1d6cd189",
      "text": "바깥소릴 남겨야,"
    },
    "p148": {
      "source_hash": "c045e7665da0",
      "text": "길이나 회사에서 안 놀라죠!"
    },
    "p149": {
      "source_hash": "4b582930e232",
      "text": "여러분은 헤드폰 쓸 때 어떤 소리가 제일 안 지워지나요?"
    },
    "p150": {
      "source_hash": "ffceb5fe972b",
      "text": "댓글로 알려주세요!"
    }
  }
}
