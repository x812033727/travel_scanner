  "chapters": {
    "kid-wear-headphones": "ヘッドホンを着けた瞬間、なぜ世界は静かになるの？",
    "chief-explain-wave": "音で音を消す？波の山と谷の衝突",
    "kid-voice-puzzle": "低音の轟音は消えるのに、なぜ人の声は残るのか？",
    "chief-dual-mic-intro": "デュアルマイクの限界：チップは音速に追いつけるか？",
    "kid-break-case": "ハテナの謎解きと日常の観察"
  },
