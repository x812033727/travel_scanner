        "a": "R31001",
        "b": "R31004",
        "reason": "高地年表帶皮根和晚材判季節，與已知放射碳跳變鎖伐木年不同。"
      },
      {
        "a": "R31001",
        "b": "R31007",
        "reason": "火場日誌驗證漏疤，不是藉樹身標誌定年。"
      },
      {
        "a": "R31001",
        "b": "R31006",
        "reason": "寄主與非寄主密度差找蟲害，不能取代大氣碳異常。"
      },
      {
        "a": "R31001",
        "b": "B2278",
        "reason": "河狸門牙持續生長只用木作食物背景。"
      },
      {
        "a": "R31002",
        "b": "R31006",
        "reason": "蟲害使某年晚材異常，橄欖題測同一活枝多個方向最外木的形成時間。"
      },
      {
        "a": "R31002",
        "b": "L120",
        "reason": "不定根生長和外木區域年代不同。"
      },
      {
        "a": "R31002",
        "b": "L080",
        "reason": "器官持續/有限生長並不能推得同一圓周有數十年差異。"
      },
      {
        "a": "R31003",
        "b": "R28003",
        "reason": "畫稿針孔與粉點是轉印傳遞的實體對應，羅馬木材靠多板年表與區域共同變化。"
      },
      {
        "a": "R31003",
        "b": "N058",
        "reason": "隕石的軌道/成分定位沒有樹木生長區域年表的機制。"
      },
      {
        "a": "R31003",
        "b": "P29004",
        "reason": "菊石溝紋是單個殼運動痕的空間吻合，非同時各林地的生長年表。"
      },
      {
        "a": "R31003",
        "b": "D2106",
        "reason": "木材縱橫向乾縮不產生可供原產地匹配的輪寬序列。"
      },
      {
        "a": "R31004",
        "b": "L078",
        "reason": "周皮生理功能不能辨最後一個留存的生長季。"
      },
      {
        "a": "R31004",
        "b": "R31006",
        "reason": "晚材密度異常找蟲害，末端有皮與已成晚材則縮小死亡時間窗。"
      },
      {
        "a": "R31004",
        "b": "R6018",
        "reason": "傷口隔離及新木包覆談活樹受傷後反應，不能補回風化掉的末輪或定死亡季節。"
      },
      {
        "a": "R31004",
        "b": "L120",
        "reason": "從枝生出不定根與取保存良好的舊根來定年不同。"
      },
      {
        "a": "R31005",
        "b": "R6006",
        "reason": "低溫後染色質沉默影響開花，藍輪取決於組織木質化及雙染。"
      },
      {
        "a": "R31005",
        "b": "B2205",
        "reason": "林冠封閉前的開花時機非寒夏組織變化。"
      },
      {
        "a": "R31005",
        "b": "N179",
        "reason": "迎風面的霧滴結冰不同於內部木材的染色結果。"
      },
      {
        "a": "R31005",
        "b": "L101",
        "reason": "遮蔭光譜是活植物線索，不能解釋木質化不足在雙染下顯藍。"
      },
      {
        "a": "R31006",
        "b": "B2205",
        "reason": "搶春光開花不需重建食葉後晚材密度。"
      },
      {
        "a": "R31006",
        "b": "B2206",
        "reason": "附生與寄生是現在如何取得資源，非遇蟲害後落葉松的密度缺口。"
      },
      {
        "a": "R31006",
        "b": "L120",
        "reason": "不定根發生不同於葉量損失及木材密度特徵。"
      },
      {
        "a": "R31006",
        "b": "L080",
        "reason": "器官生長類型不足以解釋為何特定寄主與歷史爆發吻合。"
      },
      {
        "a": "R31007",
        "b": "E9014",
        "reason": "松果受熱解封是種子散布，火疤題驗證紀錄的漏檢與誤判。"
      },
      {
        "a": "R31007",
        "b": "B2079",
        "reason": "生態演替起點不是形成層受熱留下傷疤的條件。"
      },
      {
        "a": "R31007",
        "b": "B2208",
        "reason": "草原地下活組織再生不解釋受控火場的火疤漏記。"
      },
      {
        "a": "R31007",
        "b": "R31002",
        "reason": "圓周各部位停長不同於前一年燃燒降低再次致疤的機會。"
      }
    ]
  },
