      "author_judgment": "乾顆粒出口的自支撐拱失穩，非水穿咖啡粉床的不均勻滲流與萃取。"
    },
    {
      "a": "F10005",
      "b": "F8001",
      "author_judgment": "出口幾何失去拱端支撐，非懸浮體摩擦接觸/固含卡住門檻；二維障礙模型另記同題不拆。"
    },
    {
      "a": "F10006",
      "b": "W5027",
      "author_judgment": "同密度振動填隙，非流動濾床不同密度粗細料配置。"
    },
    {
      "a": "F10006",
      "b": "F10007",
      "author_judgment": "填隙的局部位置交換，對照整體壁面循環的回程尺寸瓶頸。"
    },
    {
      "a": "F10007",
      "b": "D2048",
      "author_judgment": "壁面摩擦驅動循環與粒徑回程篩選，非向上氣流托住顆粒。"
    },
    {
      "a": "F10008",
      "b": "F10006",
      "author_judgment": "強振動稀疏層的隨機動能梯度，非弱搖填隙更快速重播；是否太專門由非作者裁。"
    },
    {
      "a": "F10009",
      "b": "P072",
      "author_judgment": "低Re運動學可逆，非亂流混合。"
    },
    {
      "a": "F10009",
      "b": "F10010",
      "author_judgment": "精確倒帶的條件，對照非互易邊界循環；不是把同一動作反方向再問一次。"
    },
    {
      "a": "F10011",
      "b": "E7017",
      "author_judgment": "牛頓液絲受壓彎曲，非冷卻表殼的變形/破裂。"
    },
    {
      "a": "F10011",
      "b": "H3090",
      "author_judgment": "不需聚合物鬆弛或固體彈性；黏性流的軸向壓縮失穩。"
    },
    {
      "a": "F10011",
      "b": "F10012",
      "author_judgment": "靜止面盤繞起因，對照移動邊界的長度/速度配合；花紋全收同核。"
    },
    {
      "a": "F10013",
      "b": "P305",
      "author_judgment": "確定性速度差配合跨流線擴散，非單粒隨機撞擊起因。"
    },
    {
      "a": "F10013",
      "b": "Q9008",
      "author_judgment": "示蹤脈衝沿程展寬，非噴嘴選擇蒸發與補給的穩態濃度梯度。"
    },
    {
      "a": "F10014",
      "b": "D2169",
      "author_judgment": "高風險近似：舊題減低循環區水齡，新題側區交換返回主流的長尾；若增量不足宜併舊核。"
    },
    {
      "a": "F10014",
      "b": "F10013",
      "author_judgment": "暫存與再釋放使尾形偏斜，非連續剪切速度分布的展寬。"
    },
    {
      "a": "F10015",
      "b": "W5018",
      "author_judgment": "斜壁形成較輕清液上升循環，非只比較沉速與表面溢流率。"
    },
    {
      "a": "F10015",
      "b": "W5019",
      "author_judgment": "稀系統斜壁回流與澄清，非高濃度顆粒互相阻礙。"
    },
    {
      "a": "F10016",
      "b": "R8006",
      "author_judgment": "有耗散的固定流態跳躍，非波進淺水改變傳播速度與波長。"
    }
