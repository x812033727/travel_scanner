  "theme_review": [
    {
      "id": "W49P-T01",
      "title": "拉緞帶越用力，怎麼反而不那麼捲？",
      "decision": "accept",
      "reason": "載荷反轉→厚度屈服模型→另設固定載荷速度比較，各有新控制；三章映樣稿，不靠重述尾拍。",
      "drop_if_read": "若無法分清卸載曲率/刀上彎度或實測/模型，撤70秒；不靠近鏡剪刀操作補畫面。"
    },
    {
      "id": "W49P-T02",
      "title": "夾板已經不動，揉皺薄膜怎麼越頂越用力？",
      "decision": "accept",
      "reason": "先畫夾板間距固定再看力時間曲線，才用兩群模態解釋；最後同曲線等力時點是新增判別，不只是再播上升下降。",
      "drop_if_read": "刪等候/部分卸載便失去新控制，撤75秒；若不能清楚畫出快慢模型與實測不同層級，先留P49-003段落不做獨立片。"
    },
    {
      "id": "W49P-T03",
      "title": "布黏得更牢，怎麼可能更擋不住一直撕？",
      "decision": "accept",
      "reason": "裂口停/不停與界面強弱的兩閾值互相回答；每個不同載荷試件分框，避免把對照串成同件歷程。",
      "drop_if_read": "若兩閾值或兩種製程無法在圖上分開，撤85秒；不能簡化成所有強膠都容易壞。"
    }
  ],
