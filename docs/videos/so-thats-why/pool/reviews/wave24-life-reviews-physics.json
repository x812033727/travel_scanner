  "candidate_review": [
    {
      "id": "P24001",
      "decision": "retain",
      "reason": "自由滴高矮與溫度比較，另夾片才見前緣；末期熱經冰到冷板支持近垂直接面及彎曲前緣。131度模型/139±8度實測不混用，題目未採精確角。",
      "scope_read": "限冷板上向上凍結的小水滴；前緣形狀來自另做的夾玻片實驗與熱傳模型，不以雪晶六角形解釋宏觀尖帽。",
      "editorial_cap": 110,
      "editorial_decision": "theme_seed"
    },
    {
      "id": "P24002",
      "decision": "retain",
      "reason": "裂口/空穴/癒合與最終爆裂為影像；壓力曲線和能量閾值為模型。50µm不是本次掃描尺寸實測，兩研究邊界分框適當。",
      "scope_read": "限毫米滴從外向內凍結的原研究；壓力和能量為模型解釋，裂癒/空穴/碎裂有高速影像。微滴不爆的估計不能當實測通用尺寸。",
      "editorial_cap": 125,
      "editorial_decision": "theme_seed"
    },
    {
      "id": "P24003",
      "decision": "retain",
      "reason": "法向增幅表面偏移、切向沿傳播方向恢復作用；正常場裝置非理想均勻，微梯度修正有保留。只核定性/指定式意義，未重算46頁。",
      "scope_read": "限磁流體表面小波及指定方向；法向實驗需計入弱梯度修正。比較兩套裝置結果，不宣稱一塊磁鐵轉向即有完全相同場強。",
      "editorial_cap": 75,
      "editorial_decision": "segment_only"
    },
    {
      "id": "P24004",
      "decision": "retain",
      "reason": "Darcy穩定式與表面張力短波限制支持因果圖；plate2不同實驗照片不可串為逐幀。水平窄槽與垂直寬槽分清，逆黏度為模型對照。未逐式推導。",
      "scope_read": "限Hele-Shaw窄縫置換；以低黏度推高黏度的原始實驗及Darcy穩定模型為據，黏度次序反轉的示意屬理論對照，重力另標。",
      "editorial_cap": 115,
      "editorial_decision": "theme_seed"
    },
    {
      "id": "P24005",
      "decision": "retain",
      "reason": "成核附泡成長、液面轉動排泡及下沉有正文支持；初期液面停留與晚期停止有時間軌跡。Fig5均值偏差不可藏，未核SI影片或原始追蹤資料。",
      "scope_read": "直接證據限原研究的去殼烤花生/lager；初期可能停留液面，氣少後循環終止。不同類飲料/果乾未作同場對照，不把每次氣泡數視作精確臨界常數。",
      "editorial_cap": 120,
      "editorial_decision": "theme_seed"
    }
  ],
