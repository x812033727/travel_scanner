  "source_review": [
    {
      "source_id": "R28-S001",
      "title": "Do Weave Matches Imply Canvas Roll Matches?",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "原作者2010 AIC公開本，核SHA後讀PDF pp1–6的引言、兩種圖、配對法、固定/上底工法、結論與Figs1–3。p7僅讀有關布卷與其他工法的說明。目讀PDF5、6頁的原圖。",
      "locator": "PDF頁1摘要、頁2–5 Weave Matching Procedure、Interpreting Weave Matches、商業上底流程、Conclusions；目讀頁5–6 Figs 1–3。",
      "cache": {
        "file": ".cache/wave28-museum-weavepaper.pdf",
        "sha256": "582ff08d653f7b30df06ac27aa2431709e84b9d8ecc30cfd02b770d4f9e709ac",
        "text_file": ".cache/wave28-museum-weavepaper.txt",
        "text_sha256": "5cd3a494d680bbd480ea800b06f95664cc6846550e1c64e6cf0255efc9ea2900"
      },
      "result": "同均值只作預篩，還需沿線方向取密度剖面、旋轉/翻轉候選對位，查全圖帶紋。44幅組超過13m且底層不同支持同長匹不必同市售卷。原始扇形加折邊膠底位置可定位邊側，不能推經向間距。",
      "limitations": "經向吻合不能單獨推出同一市售卷或同時畫成。圖2五幅圖僅按經向對齊，縱向排列不代表真正相鄰。所述上底流程有時代與業者範圍。"
    },
    {
      "source_id": "R28-S002",
      "title": "Saint Catherine of Alexandria",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "館藏2022目錄有效HTML抽文P060–068，另P135與P138，含Figs2–4圖說。未開原始紅外影像。",
      "locator": "館藏正文 P060–068，Underdrawing，Figs 2–4 圖說；對照P135、138。",
      "cache": {
        "file": ".cache/wave28-museum-pounce.html",
        "sha256": "8fca3120efc8adc5589ea1cc9d93500adf6bb1e52432bef84e885d36dab0da9a",
        "text_file": ".cache/wave28-museum-pounce.txt",
        "text_sha256": "4c2966bd21d4184161a78e4bd25c12e740450341842cb60f79baf94b3d93b4ec"
      },
      "result": "肩袖僅部分處能把粉點逐點對上。紙上打孔的線在板上底稿仍可見，另有徒手改線；下緣超出現紙稿但裁紙與後延畫法無法分辨。",
      "limitations": "紅外圖上的點很難辨認，只在部分輪廓找得到，底部無法斷言草圖被裁還是後來延畫。未檢視可放大之原畫紅外影像。"
    },
    {
      "source_id": "R28-S003",
      "title": "Studying Raphael: drawings and cartoons",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "同館案例補充頁有效HTML P010–017，讀Using cartoons與The Saint Catherine cartoon。",
      "locator": "Using cartoons 及 The Saint Catherine cartoon，P010–017。",
      "cache": {
        "file": ".cache/wave28-museum-cartoon.html",
        "sha256": "5677b45124f94c92329fc95a4dbc207c6ec7b8b4f61353c025acc921c1d0b4ab",
        "text_file": ".cache/wave28-museum-cartoon.txt",
        "text_sha256": "58b37baf0d2c51381f07b13d68cb6b391ded4f0a9d19d3cfa401fdc43d7623c4"
      },
      "result": "粉末穿孔和有色中介紙描線是兩條轉印路徑。肩結在紙稿打孔、入板上底稿、成畫省略，三物證層級可辨改動階段。",
      "limitations": "與同館NG 168目錄為同一作品的補充說明，不計兩個獨立實驗。"
    },
    {
      "source_id": "R28-S004",
      "title": "Insights into the Materials and Technique of a Roman Egyptian Funerary Portrait Obtained from Elemental Mapping and Luminescence Imaging",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "館藏37-40／Getty Volume 2第14章。有效HTML P003–011與P014–020、P028–030，另核SHA目讀Fig14.1、14.2。銅圖14.3A只讀圖說及正文，未目讀銅圖。",
      "locator": "HTML P003–011 方法及器材、P014–020 Egyptian Blue、Fig14.1/14.2目讀，Fig14.3A與14.4圖說。另讀P028–030判斷未收方向。",
      "cache": {
        "file": ".cache/wave28-museum-blue.html",
        "sha256": "2919271bc332f27c140741c17a826e5d882735842db607f9a36d22973d1aceb3",
        "text_file": ".cache/wave28-museum-blue.txt",
        "text_sha256": "1cbb10179e93bc5aa79ff85e43dd7bca37629ef7ec47b3378ad60df73f4d322c"
      },
      "result": "本畫眉眼、鼻旁的近紅外發光與銅分布共同支持埃及藍。項鍊珠雖富銅卻採另一未定名顏料；放大表面可見少量藍粒，肉眼圖表示通常觀看條件。",
      "limitations": "只限這幅蠟畫，發亮與銅圖需合看。項鍊含銅色料在該研究未定名。未從單張圖宣稱判明每粒顏料深度。"
    },
    {
      "source_id": "R28-S005",
      "title": "Ultra-Violet: New Light on Van Gogh’s Irises",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "2024展覽解說，核SHA後讀PDF pp3、5–10英文說明，目讀p8截面。",
      "locator": "PDF頁3書信、頁6元素分布、頁7–8花瓣截面（頁8目讀）、頁9重建及頁10版本。",
      "cache": {
        "file": ".cache/wave28-museum-iris.pdf",
        "sha256": "7be5c1f5a9c7e5390b7a128c40cf91e5f5d4a8bd1ef25bc2b134bb7bf6dc73a8",
        "text_file": ".cache/wave28-museum-iris.txt",
        "text_sha256": "8fad73b3e2ba6e08ce724a6050c768121e964ac62604b39664ecbb6ea79792f2"
      },
      "result": "信件記紫、花瓣現顯藍，單一截面表藍內紫與多處鈷/溴分布共同支持紅色成分褪去。用溴圖限定復色區，數位圖只近似，不能對所有花瓣給精確色值。",
      "limitations": "截面只取自一處，數位重建的色相為估計值；溴作特定材料脈絡的線索，不能由元素圖直接讀取原本RGB。"
    },
    {
      "source_id": "R28-S006",
      "title": "For the first time in 300 years The Night Watch is complete again",
      "decision": "supports_bounded_topic",
      "read_via": "非作者實讀並核SHA的作者當日有效副本，無本reviewer新HTTP。",
      "reading_scope": "2021-06-23館方計畫公告，核SHA後讀P003–020及P023–029尺寸段。未看館方影片或原作／摹本高解析圖。",
      "locator": "館方 P003、P009–020，Differences、Art historical research、Trimmed、Artificial intelligence。",
      "cache": {
        "file": ".cache/wave28-museum-edge.html",
        "sha256": "2e5ace4810c977135cbbd0ec53fc3adfff6b3a6babe32d9b9787ab246459e070",
        "text_file": ".cache/wave28-museum-edge.txt",
        "text_sha256": "9cb416d502b3e0ff0afb04cd56749f3acbe798ec3628d00a543c370af3ae14e2"
      },
      "result": "1715四邊裁切、左失最多；重建依歸屬Lundens的早期摹本，在原作周邊另加印板後人物再顯偏右。構圖位置可約束，畫家失落筆觸沒有尋回。",
      "limitations": "所指2021年臨時展示。摹本作者是歸屬判斷；重建非尋回的原片，也沒證明遺失區的逐筆畫法。"
    }
