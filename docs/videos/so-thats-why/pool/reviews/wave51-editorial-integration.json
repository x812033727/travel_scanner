  "pairs": [
   {
    "a": "H51-001",
    "b": "D2053",
    "reason": "D2053為巴氏殺菌板式熱交換讓熱奶預熱冷奶的能源回收；H51-001是起司與水加熱時蛋白聚團、以糊化澱粉提高結團溫度並縮小團塊，機制與答案不同。"
   },
   {
    "a": "H51-001",
    "b": "D2050",
    "reason": "D2050比較奶粉製程先濃縮再噴乾的水負荷分工；H51-001問起司醬加熱聚團與澱粉濃度的相界，非乾燥製程。"
   },
   {
    "a": "H51-002",
    "b": "D2270",
    "reason": "D2270是洗去澱粉後麵筋網絡更連續；H51-002以沸水/30°C交替讓蛋白與蛋黃處在不同溫區、蛋黃趨近平均溫度，熱傳時間尺度與食材均不同。"
   },
   {
    "a": "H51-003",
    "b": "LEG-S38",
    "reason": "LEG-S38是薄荷醇開啟TRPM8冷受體造成涼感；H51-003是沒有濕度受器時，由水量、熱流與摩擦組合判斷濕，涼只讓同量水更像濕，不涉化學騙過受體。"
   },
   {
    "a": "H51-004",
    "b": "A5011",
    "reason": "A5011是交叉伸展反射讓對側腿接手支撐；H51-004以綁手、夾手與同手同腳對照比較步行耗能與地面扭矩，答案是手臂反擺抵消扭轉。"
   },
   {
    "a": "H51-004",
    "b": "K18001",
    "reason": "K18001是步行衝擊與自由端慣性讓鞋帶結突然鬆開；H51-004研究擺臂對耗能與身體扭轉，僅同屬走路情境。"
   },
   {
    "a": "L51-001",
    "b": "B2323",
    "reason": "B2323是切葉蟻搭便車小工蟻防寄生蠅；L51-001是弓背蟻依傷口在股節或脛節決定截肢或舔舐，及截肢時機對存活的影響。"
   },
   {
    "a": "P51-001",
    "b": "X42-009",
    "reason": "X42-009為坐在底板上的蒸發液滴，導熱與接觸角決定內部馬蘭哥尼循環方向；P51-001是萊頓弗羅斯特懸浮液滴，雜質成殼使蒸氣層變薄而觸板爆炸或縮小後被托起飛離。"
   },
   {
    "a": "P51-001",
    "b": "I12009",
    "reason": "I12009為液滴併入液面後頸縮留下子滴的部分合併；P51-001是熱板上懸浮液滴最終爆炸或起飛的分歧，控制量為雜質成殼與尺寸。"
   },
   {
    "a": "P51-002",
    "b": "P51-001",
    "reason": "兩題同為熱板懸浮液滴但不同研究：P51-002問對稱細脊上長水滴自發選向推進的蒸氣膜傾斜力，P51-001問液滴終局爆炸或起飛；控制量與答案不同，獨立覆核亦判兩核。"
   }
  ]
 },
