{
  "zq32a01": {
    "text": "치면,",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "첸 가한테 핑계만 줄 뿐이야.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "물을 다 막았잖아!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "친솽 말이 맞아.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "물은,",
    "emotion": "咬牙"
  },
  "zq32a06": {
    "text": "우리가 찾는다.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "깊은 못에 물 있어!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": "물은 낮은 데,",
  "zq32a09": "논은 높은 데,",
  "zq32a10": {
    "text": "져 날라선 못 살려.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "알아듣게 말해.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "우물을 판다.",
    "emotion": "兩個字"
  },
  "zq32a13": "논 옆에 파서,",
  "zq32a14": {
    "text": "물 나올 때까지.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "사흘째인데,",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "우물 하나 물이 안 나와.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "한 어르신, 가서 쉬세요.",
    "emotion": "溫和，邊綁繩子"
  },
  "zq32a18": {
    "text": "쉬 형, 내가 내려갈게!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "얼뉴, 내가 할게.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "내려간 지 얼마나 됐어?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "하루 종일이야.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "끌어올려.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "물… 물 없어.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "다 비켜.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "책상물림 주제에,",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "뭘 잘났다고,",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "우물은 무슨.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "친솽 호감, 41.",
    "say": "친솽 호감, 사십일.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "보상 상자 개봉:",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": {
    "text": "수차 도면.",
    "emotion": "平板電子音"
  },
  "zq32a31": {
    "text": "스 목수님, 이거 만들 수 있어요?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "도면은 좋아.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "좋은 나무 삼백 근,",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "이 마을 어디서 구해?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "큰 나무는 작년에 다 베었어.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "그만한 재목은,",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "마을에 하나밖에 없지.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "사당 대들보.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "조상님이 보고 계십니다.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "사당 대들보를 뜯어,",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "아이들에게 물 한 모금 주려 합니다.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "쉬 수재, 자네가 말하게.",
    "emotion": "畫外，慢，篤定"
  }
}
