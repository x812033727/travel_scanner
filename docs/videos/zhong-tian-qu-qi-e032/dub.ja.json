{
  "zq32a01": {
    "text": "手を出せば、",
    "emotion": "冷，不回頭",
    "say": "手を出せば"
  },
  "zq32a02": {
    "text": "チエン家に口実をやるだけ。",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "水が止められた！",
    "emotion": "急，大嗓門",
    "say": "水が止まった！"
  },
  "zq32a04": {
    "text": "チン・シュアンの言う通り。",
    "say": "シュアンの言う通り。",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "水は、",
    "emotion": "咬牙",
    "say": "水"
  },
  "zq32a06": {
    "text": "自分で探す。",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "深い淵にまだ水がある！",
    "emotion": "大嗓門，高興",
    "say": "淵にまだ水がある！"
  },
  "zq32a08": {
    "text": "水は低い所、",
    "say": "水は下、"
  },
  "zq32a09": {
    "text": "田は高い所、",
    "say": "田は上、"
  },
  "zq32a10": {
    "text": "運びきれない。",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "分かる言葉で。",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "井戸だ。",
    "emotion": "兩個字"
  },
  "zq32a13": {
    "text": "田のそばを掘る、",
    "say": "田のそばに"
  },
  "zq32a14": {
    "text": "水が出るまで。",
    "emotion": "咬牙",
    "say": "出るまで。"
  },
  "zq32a15": {
    "text": "三日目じゃ、",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "どの井戸も水が出ん。",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "ハン爺、帰って休んで。",
    "emotion": "溫和，邊綁繩子",
    "say": "爺、休んで。"
  },
  "zq32a18": {
    "text": "兄貴、俺が下りる！",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "アーニウ、交代だ。",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "下りてどれくらい？",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "丸一日だ。",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "引き上げて。",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "み……水、ない。",
    "emotion": "昏，笑",
    "say": "水、ない。"
  },
  "zq32a24": {
    "text": "どいて。",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "ひ弱な書生が、",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "何を粋がって、",
    "emotion": "小聲",
    "say": "粋がって、"
  },
  "zq32a27": {
    "text": "井戸なんか掘って。",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "チン・シュアン、好感度四十一。",
    "emotion": "平板電子音，叮一聲",
    "say": "シュアン、好感度四十一。"
  },
  "zq32a29": {
    "text": "報酬箱、開封：",
    "emotion": "平板電子音，咔一聲",
    "say": "報酬箱開封"
  },
  "zq32a30": {
    "text": "水車の図面。",
    "emotion": "平板電子音"
  },
  "zq32a31": {
    "text": "シー親方、これ作れる？",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "図はいい。",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "いい木が三百斤、",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "この村のどこにある？",
    "emotion": "不耐煩",
    "say": "村のどこにある？"
  },
  "zq32a35": {
    "text": "大木は去年切り尽くした。",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "これほどの材は、",
    "emotion": "粗啞",
    "say": "こんな材は、"
  },
  "zq32a37": {
    "text": "村に一本だけ。",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "祠堂の梁。",
    "emotion": "想到了，站起來",
    "say": "祠堂の梁"
  },
  "zq32a39": {
    "text": "ご先祖様、お聞きくだされ。",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "祠堂の梁を外し、",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "子らに一口の水を。",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "シュー秀才、お前が決めろ。",
    "emotion": "畫外，慢，篤定",
    "say": "秀才、お前が決めろ。"
  }
}
