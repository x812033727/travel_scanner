{
  "zq32a01": {
    "text": "Kalau ribut,",
    "say": "Ribut",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "Qian dapat alasan.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "Airnya dibendung semua!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "Qin Shuang benar.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "Air,",
    "say": "Air",
    "emotion": "咬牙"
  },
  "zq32a06": {
    "text": "kita cari sendiri.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "Kolam dalamnya masih ada air!",
    "say": "Kolam dalamnya ada air!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": {
    "text": "Airnya di bawah,",
    "emotion": "看著水"
  },
  "zq32a09": {
    "text": "sawahnya di atas,",
    "say": "di atas",
    "emotion": "抬頭看岸上"
  },
  "zq32a10": {
    "text": "nggak terangkut.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "Ngomong yang jelas.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "Gali sumur.",
    "say": "Sumur.",
    "emotion": "兩個字"
  },
  "zq32a13": {
    "text": "Gali di sawah,",
    "say": "Di sawah",
    "emotion": "很穩"
  },
  "zq32a14": {
    "text": "sampai ketemu air.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "Hari ketiga,",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "nggak satu sumur pun berair.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "Kakek Han, istirahat saja.",
    "say": "Istirahat saja.",
    "emotion": "溫和，邊綁繩子"
  },
  "zq32a18": {
    "text": "Kak Xu, biar aku!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "Erniu, giliranku.",
    "say": "Giliranku.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "Sudah berapa lama dia di bawah?",
    "say": "Berapa lama dia di bawah?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "Seharian penuh.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "Tarik.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "Nggak… nggak ada air.",
    "say": "Nggak ada air.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "Minggir semua.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "Pelajar ringkih,",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "sok kuat,",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "sok gali sumur.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "Qin Shuang, poin suka empat puluh satu.",
    "say": "Poin suka: empat puluh satu.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "Peti hadiah terbuka:",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": "gambar kincir air.",
  "zq32a31": {
    "text": "Pak Shi, kincir ini bisa dibuat?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "Gambarnya bagus.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "Seratus lima puluh kilo kayu bagus,",
    "say": "Seratus lima puluh kilo kayu,",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "di desa ini cari di mana?",
    "say": "cari di mana?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "Pohon besar habis ditebang tahun lalu.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "Kayu sebesar itu,",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "di desa cuma sisa satu.",
    "say": "di desa sisa satu.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "Balok rumah leluhur.",
    "say": "Balok leluhur.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "Leluhur, saksikanlah.",
    "say": "Leluhur, saksikan.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "Lepas balok rumah leluhur,",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "demi seteguk air buat anak-anak.",
    "say": "demi air buat anak-anak.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "Sarjana Xu, kau putuskan.",
    "say": "Kau putuskan.",
    "emotion": "畫外，慢，篤定"
  }
}
