{
  "zq32a01": {
    "text": "Se brigar,",
    "say": "Brigar",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "é dar desculpa aos Qian.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "Roubaram a água toda!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "Qin Shuang tem razão.",
    "say": "Ela tem razão.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "Água,",
    "say": "Água",
    "emotion": "咬牙"
  },
  "zq32a06": {
    "text": "a gente mesmo acha.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "O poço fundo ainda tem água!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": {
    "text": "A água fica embaixo,",
    "say": "Água embaixo,",
    "emotion": "看著水"
  },
  "zq32a09": {
    "text": "a roça lá em cima,",
    "say": "a roça em cima,",
    "emotion": "抬頭看岸上"
  },
  "zq32a10": {
    "text": "carregar não dá.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "Fala direito.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "Cavar poço.",
    "say": "Um poço.",
    "emotion": "兩個字"
  },
  "zq32a13": {
    "text": "Cavar na roça,",
    "say": "Na roça",
    "emotion": "很穩"
  },
  "zq32a14": {
    "text": "até achar água.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "Terceiro dia,",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "e nenhum poço deu água.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "Ancião Han, vá descansar.",
    "say": "Ancião, vá descansar.",
    "emotion": "溫和，邊綁繩子"
  },
  "zq32a18": {
    "text": "Irmão Xu, eu desço!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "Erniu, minha vez.",
    "say": "Minha vez.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "Há quanto tempo ele tá lá?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "O dia inteiro.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "Puxem.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "Não… não tem água.",
    "say": "Não tem água.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "Saiam da frente.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "Estudante fracote,",
    "say": "Estudante fracote",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "bancando o forte,",
    "say": "banca o forte",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "cavando poço.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "Qin Shuang: afeição, quarenta e um.",
    "say": "Afeição: quarenta e um.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "Baú de recompensa aberto:",
    "say": "Baú aberto:",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": "projeto da roda d'água.",
  "zq32a31": {
    "text": "Mestre Shi, dá pra fazer essa roda?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "O projeto é bom.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "Cento e cinquenta quilos de madeira boa,",
    "say": "Cento e cinquenta quilos,",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "onde acha nesta vila?",
    "say": "onde acha aqui?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "Cortaram as árvores todas ano passado.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "Madeira desse tamanho,",
    "say": "Um tronco desses",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "só sobrou um na vila.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "A viga do santuário.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "Ancestrais, ouçam.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "Tirar a viga do santuário,",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "pra dar água às crianças.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "Letrado Xu, você decide.",
    "emotion": "畫外，慢，篤定"
  }
}
