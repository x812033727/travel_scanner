{
  "zq32a01": {
    "text": "Swing that,",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "and the Qians have their excuse.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "They cut off our water!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "Qin Shuang's right.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "Water,",
    "emotion": "咬牙",
    "say": "Water"
  },
  "zq32a06": {
    "text": "we'll find our own.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "The deep pool's still got water!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": "Water's down here,",
  "zq32a09": "fields are up there,",
  "zq32a10": {
    "text": "can't carry it up.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "Say it plain.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "Dig wells.",
    "emotion": "兩個字",
    "say": "Wells."
  },
  "zq32a13": "By the fields,",
  "zq32a14": {
    "text": "till we hit water.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "Three days now,",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "not one well's hit water.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "Elder Han, go rest.",
    "emotion": "溫和，邊綁繩子",
    "say": "Go rest, Elder."
  },
  "zq32a18": {
    "text": "Brother Xu, I'll go!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "Erniu, my turn.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "How long's he been down?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "All day.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "Pull him up.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "No… no water.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "Out of the way.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "Soft little scholar,",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "showing off,",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "digging wells.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "Qin Shuang: affection forty-one.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "Reward chest opened:",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": {
    "text": "waterwheel blueprint.",
    "emotion": "平板電子音"
  },
  "zq32a31": {
    "text": "Old Shi, can you build this?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "Fine drawing.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "Three hundred pounds of good wood,",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "where in this village?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "We cut the big trees last year.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "Timber that size,",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "only one left in the village.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "The ancestral hall beam.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "Ancestors above.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "Take down the hall's beam,",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "to give the children water.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "Scholar Xu, you decide.",
    "emotion": "畫外，慢，篤定",
    "say": "You decide, Scholar."
  }
}
