{
  "zq32a01": {
    "text": "Si peleas,",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "le das la excusa a don Qian.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "¡Nos cortaron el agua!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "Qin Shuang tiene razón.",
    "say": "Tiene razón.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "El agua,",
    "emotion": "咬牙"
  },
  "zq32a06": {
    "text": "la buscamos nosotros.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "¡La poza honda tiene agua!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": "El agua está abajo,",
  "zq32a09": "el campo, arriba,",
  "zq32a10": {
    "text": "a cubos no alcanza.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "Habla claro.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "Un pozo.",
    "emotion": "兩個字"
  },
  "zq32a13": "Junto al campo,",
  "zq32a14": {
    "text": "hasta dar con agua.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "Tercer día,",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "y ningún pozo da agua.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "Anciano Han, descanse.",
    "emotion": "溫和，邊綁繩子"
  },
  "zq32a18": {
    "text": "¡Hermano Xu, bajo yo!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "Erniu, me toca.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "¿Cuánto lleva ahí abajo?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "Todo el día.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "Súbanlo.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "No… no hay agua.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "Apártense.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "Letrado debilucho,",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "haciéndose el fuerte,",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "cavando pozos.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "Qin Shuang: afecto, cuarenta y uno.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "Caja de recompensa abierta:",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": {
    "text": "planos de la noria.",
    "emotion": "平板電子音"
  },
  "zq32a31": {
    "text": "Viejo Shi, ¿puede hacer esto?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "Buenos planos.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "Ciento cincuenta kilos de madera,",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "¿de dónde, en este pueblo?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "Talamos los grandes el año pasado.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "Un tronco así,",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "solo queda uno en el pueblo.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "La viga del santuario.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "Ancestros, sean testigos.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "Quitamos la viga del santuario,",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "para darles un trago de agua a los niños.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "Letrado Xu, usted dirá.",
    "emotion": "畫外，慢，篤定"
  }
}
