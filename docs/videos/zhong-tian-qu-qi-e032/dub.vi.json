{
  "zq32a01": {
    "text": "Đánh,",
    "say": "Đánh",
    "emotion": "冷，不回頭"
  },
  "zq32a02": {
    "text": "là cho nhà Tiền cái cớ.",
    "emotion": "一字一字"
  },
  "zq32a03": {
    "text": "Nước bị chặn hết rồi!",
    "emotion": "急，大嗓門"
  },
  "zq32a04": {
    "text": "Tần Sương nói đúng.",
    "emotion": "喘，很穩"
  },
  "zq32a05": {
    "text": "Nước,",
    "say": "Nước",
    "emotion": "咬牙"
  },
  "zq32a06": {
    "text": "bọn ta tự tìm.",
    "emotion": "很穩"
  },
  "zq32a07": {
    "text": "Đầm sâu còn nước!",
    "emotion": "大嗓門，高興"
  },
  "zq32a08": {
    "text": "Nước ở chỗ thấp,",
    "say": "Nước ở chỗ thấp"
  },
  "zq32a09": {
    "text": "ruộng ở chỗ cao,",
    "say": "ruộng ở chỗ cao"
  },
  "zq32a10": {
    "text": "gánh không nổi.",
    "emotion": "搖頭"
  },
  "zq32a11": {
    "text": "Nói tiếng người đi.",
    "emotion": "不耐煩"
  },
  "zq32a12": {
    "text": "Đào giếng.",
    "emotion": "兩個字"
  },
  "zq32a13": {
    "text": "Đào cạnh ruộng,",
    "say": "Đào cạnh ruộng"
  },
  "zq32a14": {
    "text": "đến khi thấy nước.",
    "emotion": "咬牙"
  },
  "zq32a15": {
    "text": "Ngày thứ ba rồi,",
    "say": "Ngày thứ ba rồi",
    "emotion": "蒼老，慢"
  },
  "zq32a16": {
    "text": "chưa giếng nào thấy nước.",
    "emotion": "沉"
  },
  "zq32a17": {
    "text": "Hàn bá, về nghỉ đi.",
    "say": "Hàn bá về nghỉ đi.",
    "emotion": "溫和，邊綁繩子"
  },
  "zq32a18": {
    "text": "Hứa đại ca, để ta xuống!",
    "say": "Hứa đại ca để ta xuống!",
    "emotion": "急"
  },
  "zq32a19": {
    "text": "Nhị Ngưu, để ta.",
    "say": "Nhị Ngưu để ta.",
    "emotion": "笑，累"
  },
  "zq32a20": {
    "text": "Hắn xuống bao lâu rồi?",
    "emotion": "皺眉"
  },
  "zq32a21": {
    "text": "Cả ngày rồi.",
    "emotion": "喘，擔心"
  },
  "zq32a22": {
    "text": "Kéo lên.",
    "emotion": "畫外，命令"
  },
  "zq32a23": {
    "text": "Không… không có nước.",
    "say": "Không… không nước.",
    "emotion": "昏，笑"
  },
  "zq32a24": {
    "text": "Tránh ra hết.",
    "emotion": "低聲，不耐煩"
  },
  "zq32a25": {
    "text": "Thư sinh yếu ớt,",
    "say": "Thư sinh yếu ớt",
    "emotion": "罵，嫌棄"
  },
  "zq32a26": {
    "text": "ra vẻ gì chứ,",
    "say": "ra vẻ gì chứ",
    "emotion": "小聲"
  },
  "zq32a27": {
    "text": "đào giếng gì.",
    "emotion": "耳根紅"
  },
  "zq32a28": {
    "text": "Tần Sương, hảo cảm, bốn mươi mốt.",
    "say": "Tần Sương hảo cảm bốn mươi mốt.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq32a29": {
    "text": "Mở rương thưởng:",
    "say": "Mở rương thưởng",
    "emotion": "平板電子音，咔一聲"
  },
  "zq32a30": {
    "text": "bản vẽ guồng nước.",
    "emotion": "平板電子音"
  },
  "zq32a31": {
    "text": "Thợ mộc Thạch, guồng này làm được không?",
    "say": "Thợ mộc Thạch guồng này làm được không?",
    "emotion": "啞，急"
  },
  "zq32a32": {
    "text": "Bản vẽ thì tốt.",
    "emotion": "粗啞，短"
  },
  "zq32a33": {
    "text": "Ba trăm cân gỗ tốt,",
    "say": "Ba trăm cân gỗ tốt",
    "emotion": "硬"
  },
  "zq32a34": {
    "text": "làng này tìm đâu ra?",
    "emotion": "不耐煩"
  },
  "zq32a35": {
    "text": "Cây to năm ngoái chặt sạch rồi.",
    "emotion": "悶"
  },
  "zq32a36": {
    "text": "Gỗ lớn cỡ này,",
    "say": "Gỗ lớn cỡ này",
    "emotion": "粗啞"
  },
  "zq32a37": {
    "text": "cả làng chỉ còn một thanh.",
    "emotion": "壓低"
  },
  "zq32a38": {
    "text": "Cây xà từ đường.",
    "emotion": "想到了，站起來"
  },
  "zq32a39": {
    "text": "Tổ tiên chứng giám.",
    "emotion": "蒼老，篤定"
  },
  "zq32a40": {
    "text": "Dỡ xà từ đường,",
    "say": "Dỡ xà từ đường",
    "emotion": "一字一字"
  },
  "zq32a41": {
    "text": "cho lũ trẻ một ngụm nước.",
    "emotion": "畫外，沉"
  },
  "zq32a42": {
    "text": "Hứa tú tài, ngươi nói đi.",
    "say": "Hứa tú tài ngươi nói đi.",
    "emotion": "畫外，慢，篤定"
  }
}
