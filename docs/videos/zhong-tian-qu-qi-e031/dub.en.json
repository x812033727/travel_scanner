{
  "zq31a01": {
    "text": "Wrong person.",
    "emotion": "面巾拉回臉上，聲音冷得像井水"
  },
  "zq31a02": {
    "text": "But you're…",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "Please leave, sir.",
    "emotion": "背過身，不再看他"
  },
  "zq31a04": {
    "text": "He knows A-Ling?",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": "No idea.",
  "zq31a06": "She'll talk when she's ready.",
  "zq31a07": {
    "text": "Still up?",
    "emotion": "輕聲"
  },
  "zq31a08": {
    "text": "You want to ask.",
    "emotion": "看著月亮，不看他"
  },
  "zq31a09": "I do.",
  "zq31a10": "But you don't want to say.",
  "zq31a11": {
    "text": "He saw me behind very high walls.",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "Don't ask.",
    "emotion": "說完就別過臉，耳尖有點紅"
  },
  "zq31a13": {
    "text": "Okay. I won't.",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "A-Ling: affection plus four.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a15": "Three months,",
  "zq31a16": {
    "text": "not one drop of rain.",
    "emotion": "聲音悶"
  },
  "zq31a17": {
    "text": "Seeds won't wait.",
    "emotion": "畫外，低聲"
  },
  "zq31a18": "First, wake them up.",
  "zq31a19": {
    "text": "They sprouted!",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "Xu Yan, sprouts in three days!",
    "emotion": "得意"
  },
  "zq31a21": {
    "text": "Xu!",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "The— the stream's dry!",
    "emotion": "畫外，嚇壞了"
  },
  "zq31a23": "No water upstream,",
  "zq31a24": {
    "text": "the fields'll all die!",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "And the Qians' fields?",
    "say": "And Qian's?",
    "emotion": "冷靜"
  },
  "zq31a26": {
    "text": "The Qians…",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "Theirs are still green.",
    "emotion": "想到了，變臉"
  },
  "zq31a28": {
    "text": "Grain prices,",
    "say": "Prices,"
  },
  "zq31a29": {
    "text": "up another thirty percent.",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "No rain from heaven,",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "so heaven counts my money.",
    "emotion": "得意，拖長音"
  },
  "zq31a32": {
    "text": "Drought mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a33": {
    "text": "water Liuxi's fields within ten days.",
    "emotion": "平板電子音"
  },
  "zq31a34": {
    "text": "Failure: the seedlings die.",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "Upstream.",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "Xu, look!",
    "emotion": "指著上游，大吼"
  },
  "zq31a37": {
    "text": "They're sending it to the Qians' fields!",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "Give us back our water!",
    "say": "Our water!",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "Erniu!",
    "emotion": "畫外，大喊"
  }
}
