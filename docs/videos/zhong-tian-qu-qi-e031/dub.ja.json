{
  "zq31a01": {
    "text": "人違いです。",
    "emotion": "面巾拉回臉上，聲音冷得像井水"
  },
  "zq31a02": {
    "text": "お前は確かに……",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "お引き取りを。",
    "emotion": "背過身，不再看他"
  },
  "zq31a04": {
    "text": "アーリン姉さんを知ってるの？",
    "say": "姉さんを知ってるの？",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": {
    "text": "知らない。",
    "say": "さあ。"
  },
  "zq31a06": "話したくなれば、話すさ。",
  "zq31a07": {
    "text": "寝ないの？",
    "emotion": "輕聲"
  },
  "zq31a08": {
    "text": "聞きたいの。",
    "emotion": "看著月亮，不看他"
  },
  "zq31a09": {
    "text": "ああ。",
    "say": "ん。"
  },
  "zq31a10": {
    "text": "でも、言いたくないだろ。",
    "say": "言いたくない。"
  },
  "zq31a11": {
    "text": "高い塀の中で、私を見た人。",
    "say": "高い塀の中で見た。",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "聞かないで。",
    "emotion": "說完就別過臉，耳尖有點紅"
  },
  "zq31a13": {
    "text": "ああ、聞かない。",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "アーリン、好感プラス四。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a15": "三か月、",
  "zq31a16": {
    "text": "一滴も降らない。",
    "emotion": "聲音悶"
  },
  "zq31a17": {
    "text": "種は雨を待たない。",
    "say": "種は待たない。",
    "emotion": "畫外，低聲"
  },
  "zq31a18": {
    "text": "まず目を覚まさせる。",
    "say": "まず起こす。"
  },
  "zq31a19": {
    "text": "芽が出た！",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "シュー・イェン、三日で芽が出た！",
    "say": "三日で芽が出た！",
    "emotion": "得意"
  },
  "zq31a21": {
    "text": "兄貴！",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "か、川が干上がった！",
    "emotion": "畫外，嚇壞了"
  },
  "zq31a23": {
    "text": "上流に水がない、",
    "say": "水なし、"
  },
  "zq31a24": {
    "text": "田んぼが全部枯れる！",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "チエン家の田は？",
    "emotion": "冷靜"
  },
  "zq31a26": {
    "text": "チエン家……",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "まだ青い。",
    "emotion": "想到了，變臉"
  },
  "zq31a28": "米の値は、",
  "zq31a29": {
    "text": "さらに三割上げだ。",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "雨が降らねば、",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "天が俺の金を数えてくれる。",
    "say": "天が金を数える。",
    "emotion": "得意，拖長音"
  },
  "zq31a32": {
    "text": "干ばつ任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a33": {
    "text": "十日以内に柳渓の田に水を。",
    "emotion": "平板電子音"
  },
  "zq31a34": {
    "text": "失敗：稲の種、枯死。",
    "say": "失敗：種、枯死。",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "上流へ。",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "兄貴、見ろ！",
    "emotion": "指著上游，大吼"
  },
  "zq31a37": {
    "text": "水をチエン家の田に引いてる！",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "水を返せ！",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "アーニウ！",
    "emotion": "畫外，大喊"
  }
}
