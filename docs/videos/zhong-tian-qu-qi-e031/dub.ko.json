{
  "zq31a01": {"text":"잘못 보셨어요.","emotion":"面巾拉回臉上，聲音冷得像井水"},
  "zq31a02": {"text":"넌 분명히…","say":"넌 분명히","emotion":"整個人僵著，話說不完"},
  "zq31a03": {"text":"공자, 돌아가세요.","emotion":"背過身，冷，不看他"},
  "zq31a04": {"text":"아링 언니를 알아?","emotion":"小聲，眼睛睜大"},
  "zq31a05": {"text":"몰라.","say":"글쎄."},
  "zq31a06": {"text":"말하고 싶으면 말하겠지.","emotion":"平靜"},
  "zq31a07": {"text":"안 자?","emotion":"輕聲"},
  "zq31a08": {"text":"묻고 싶지.","emotion":"看著月亮，冷淡"},
  "zq31a09": {"text":"응.","emotion":"坦白，短促"},
  "zq31a10": "넌 말하기 싫고.",
  "zq31a11": {"text":"그 사람, 높은 담 안에서 날 봤어.","say":"높은 담 안에서 날 봤어.","emotion":"聲音很輕，一字一字"},
  "zq31a12": {"text":"더 묻지 마.","emotion":"別過臉，短促"},
  "zq31a13": {"text":"그래, 안 물어.","emotion":"點頭，很穩"},
  "zq31a14": {"text":"아링 호감, +4.","say":"아링 호감, 플러스 사.","emotion":"平板電子音"},
  "zq31a15": {"text":"석 달째,","say":"석 달째","emotion":"聲音悶"},
  "zq31a16": "비 한 방울 안 왔어.",
  "zq31a17": {"text":"씨는 비 안 기다려.","say":"씨는 안 기다려.","emotion":"畫外，低聲"},
  "zq31a18": "먼저 깨워야지.",
  "zq31a19": {"text":"싹 났어!","emotion":"畫外，尖叫"},
  "zq31a20": {"text":"쉬옌, 사흘 만에 싹 났어!","emotion":"得意"},
  "zq31a21": {"text":"쉬 형!","say":"형!","emotion":"畫外，大嗓門，喘"},
  "zq31a22": {"text":"개, 개울이 끊겼어!","emotion":"嚇壞了，大嗓門"},
  "zq31a23": {"text":"상류에 물이 없어,","say":"물이 없어,"},
  "zq31a24": {"text":"논이 다 말라 죽어!","emotion":"大嗓門，急"},
  "zq31a25": {"text":"첸 가 논은?","emotion":"冷靜"},
  "zq31a26": {"text":"첸 가는…","say":"첸 가…","emotion":"愣住"},
  "zq31a27": {"text":"논이 아직 파래.","emotion":"想到了，變臉"},
  "zq31a28": {"text":"쌀값,","say":"쌀값","emotion":"油滑，拍著糧袋"},
  "zq31a29": {"text":"삼 할 더 올려.","emotion":"油滑，拖長音"},
  "zq31a30": {"text":"하늘이 비를 안 주니,","say":"하늘이 비를 안 주니","emotion":"冷笑"},
  "zq31a31": {"text":"하늘이 내 돈을 세 주는군.","emotion":"得意，拖長音"},
  "zq31a32": {"text":"가뭄 미션:","emotion":"平板電子音"},
  "zq31a33": "열흘 안에 류시의 논에 물을 대라.",
  "zq31a34": {"text":"실패 시: 볍씨가 말라 죽는다.","say":"실패: 볍씨 말라 죽음.","emotion":"平板電子音，冷"},
  "zq31a35": {"text":"상류로 간다.","emotion":"咬牙，一句話"},
  "zq31a36": {"text":"쉬 형, 저것 봐!","emotion":"大吼"},
  "zq31a37": {"text":"물을 첸 가 논으로 돌렸어!","emotion":"氣得跺腳"},
  "zq31a38": {"text":"우리 물 내놔!","emotion":"吼，豁出去"},
  "zq31a39": {"text":"얼뉴!","emotion":"畫外，大喊"}
}
