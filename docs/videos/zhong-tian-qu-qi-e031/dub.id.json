{
  "zq31a01": {
    "text": "Salah orang.",
    "say": "Kau salah.",
    "emotion": "面巾拉回臉上，聲音冷得像井水，短促"
  },
  "zq31a02": {
    "text": "Tapi kau jelas…",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "Tuan, silakan pulang.",
    "emotion": "背過身，冷淡，不看他"
  },
  "zq31a04": {
    "text": "Dia kenal Kak A-Ling?",
    "say": "Kenal Kak A-Ling?",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": {
    "text": "Entah.",
    "emotion": "看著她的背影，短促"
  },
  "zq31a06": {
    "text": "Kalau mau, dia cerita.",
    "emotion": "平靜"
  },
  "zq31a07": {
    "text": "Belum tidur?",
    "say": "Melek, ya?",
    "emotion": "輕聲，短促"
  },
  "zq31a08": {
    "text": "Kau mau tanya.",
    "emotion": "看著月亮，不看他，冷淡"
  },
  "zq31a09": {
    "text": "Mau.",
    "emotion": "坦白，短促"
  },
  "zq31a10": {
    "text": "Tapi kau enggan.",
    "emotion": "不逼她，平靜"
  },
  "zq31a11": {
    "text": "Dia melihatku di balik tembok tinggi.",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "Jangan tanya lagi.",
    "say": "Cukup.",
    "emotion": "說完就別過臉，耳尖有點紅，短促"
  },
  "zq31a13": {
    "text": "Baik, nggak tanya.",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "A-Ling, poin suka plus empat.",
    "say": "A-Ling, plus empat."
  },
  "zq31a15": {
    "text": "Tiga bulan,",
    "say": "Tiga bulan"
  },
  "zq31a16": {
    "text": "setetes pun nggak turun.",
    "emotion": "聲音悶"
  },
  "zq31a17": {
    "text": "Benih nggak nunggu hujan.",
    "say": "Nggak nunggu.",
    "emotion": "畫外，低聲"
  },
  "zq31a18": {
    "text": "Bangunkan dulu.",
    "emotion": "低聲，平靜"
  },
  "zq31a19": {
    "text": "Bertunas!",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "Xu Yan, tiga hari sudah bertunas!",
    "emotion": "得意，梨渦很深，語速快"
  },
  "zq31a21": {
    "text": "Kak Xu!",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "Su… sungainya putus!",
    "emotion": "畫外，嚇壞了"
  },
  "zq31a23": {
    "text": "Di hulu nggak ada air,",
    "say": "Di hulu nggak ada air",
    "emotion": "捏碎乾泥，急"
  },
  "zq31a24": {
    "text": "sawah bakal mati semua!",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "Sawahnya Qian?",
    "emotion": "冷靜"
  },
  "zq31a26": {
    "text": "Keluarga Qian…",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "Sawahnya masih hijau.",
    "emotion": "想到了，變臉"
  },
  "zq31a28": {
    "text": "Harga beras,",
    "say": "Harga beras",
    "emotion": "拍著糧袋，油滑"
  },
  "zq31a29": {
    "text": "naik tiga puluh persen lagi.",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "Langit nggak kasih hujan,",
    "say": "Langit nggak kasih hujan",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "langit yang hitung uangku.",
    "emotion": "得意，拖長音"
  },
  "zq31a32": "Misi kekeringan:",
  "zq31a33": "dalam sepuluh hari, sawah Liuxi harus berair.",
  "zq31a34": {
    "text": "Gagal: benih padi mati.",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "Ke hulu.",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "Kak Xu, lihat!",
    "emotion": "指著上游，大吼"
  },
  "zq31a37": {
    "text": "Airnya dialirkan ke Qian!",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "Balikin air kami!",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "Erniu!",
    "emotion": "畫外，大喊"
  }
}
