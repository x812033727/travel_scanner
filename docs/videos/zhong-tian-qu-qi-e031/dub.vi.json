{
  "zq31a01": {
    "text": "Nhầm người.",
    "emotion": "面巾拉回臉上，聲音冷得像井水"
  },
  "zq31a02": {
    "text": "Ngươi rõ ràng là…",
    "say": "Ngươi rõ ràng là",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "Công tử, mời về.",
    "say": "Công tử mời về.",
    "emotion": "背過身，不再看他"
  },
  "zq31a04": {
    "text": "Hắn biết A Lệnh tỷ?",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": {
    "text": "Không biết.",
    "emotion": "看著她的背影"
  },
  "zq31a06": {
    "text": "Nàng ấy muốn nói, khắc sẽ nói.",
    "emotion": "平靜"
  },
  "zq31a07": {
    "text": "Chưa ngủ?",
    "emotion": "輕聲"
  },
  "zq31a08": {
    "text": "Ngươi muốn hỏi.",
    "emotion": "看著月亮，不看他"
  },
  "zq31a09": {
    "text": "Muốn.",
    "emotion": "坦白"
  },
  "zq31a10": {
    "text": "Nàng không muốn nói.",
    "emotion": "不逼她"
  },
  "zq31a11": {
    "text": "Hắn từng gặp ta trong bức tường rất cao.",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "Đừng hỏi.",
    "emotion": "說完就別過臉，耳尖有點紅"
  },
  "zq31a13": {
    "text": "Được, không hỏi.",
    "say": "Được không hỏi.",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "A Lệnh, hảo cảm, cộng bốn.",
    "say": "A Lệnh hảo cảm cộng bốn.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a15": {
    "text": "Ba tháng rồi,",
    "say": "Ba tháng rồi"
  },
  "zq31a16": {
    "text": "không một giọt mưa.",
    "emotion": "聲音悶"
  },
  "zq31a17": {
    "text": "Hạt không chờ mưa.",
    "emotion": "畫外，低聲"
  },
  "zq31a18": {
    "text": "Để chúng tỉnh đã.",
    "emotion": "平靜"
  },
  "zq31a19": {
    "text": "Nảy mầm rồi!",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "Hứa Nghiên, ba ngày đã nảy mầm!",
    "say": "Hứa Nghiên ba ngày đã nảy mầm!",
    "emotion": "得意，語速快"
  },
  "zq31a21": {
    "text": "Hứa đại ca!",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "Suối, suối cạn rồi!",
    "say": "Suối suối cạn rồi!",
    "emotion": "畫外，嚇壞了"
  },
  "zq31a23": {
    "text": "Thượng nguồn hết nước,",
    "say": "Thượng nguồn hết nước"
  },
  "zq31a24": {
    "text": "ruộng khô chết hết rồi!",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "Còn ruộng nhà Tiền?",
    "emotion": "冷靜，看向上游"
  },
  "zq31a26": {
    "text": "Nhà Tiền…",
    "say": "Nhà Tiền",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "Ruộng vẫn còn xanh.",
    "emotion": "想到了，變臉"
  },
  "zq31a28": {
    "text": "Giá gạo,",
    "say": "Giá gạo",
    "emotion": "拍著糧袋"
  },
  "zq31a29": {
    "text": "tăng thêm ba phần.",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "Trời không mưa,",
    "say": "Trời không mưa",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "ông trời đếm bạc giúp ta.",
    "emotion": "得意，拖長音"
  },
  "zq31a32": {
    "text": "Nhiệm vụ hạn hán:",
    "say": "Nhiệm vụ hạn hán",
    "emotion": "平板電子音，叮一聲"
  },
  "zq31a33": {
    "text": "trong mười ngày, ruộng Liễu Khê phải có nước.",
    "say": "trong mười ngày ruộng Liễu Khê phải có nước.",
    "emotion": "平板電子音"
  },
  "zq31a34": {
    "text": "Thất bại: giống lúa chết khô.",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "Lên thượng nguồn.",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "Hứa đại ca, nhìn kìa!",
    "say": "Hứa đại ca nhìn kìa!",
    "emotion": "指著上游，大吼"
  },
  "zq31a37": {
    "text": "Chúng dẫn nước vào ruộng nhà Tiền!",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "Trả nước cho bọn ta!",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "Nhị Ngưu!",
    "emotion": "畫外，大喊"
  }
}
