{
  "zq31a01": {
    "text": "Enganou-se.",
    "say": "Não sou eu.",
    "emotion": "面巾拉回臉上，聲音冷得像井水，短促"
  },
  "zq31a02": {
    "text": "Mas você é…",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "Senhor, vá embora.",
    "emotion": "背過身，冷淡，不看他"
  },
  "zq31a04": {
    "text": "Ele conhece a A-Ling?",
    "say": "Conhece a A-Ling?",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": "Não sei.",
  "zq31a06": {
    "text": "Se quiser, ela conta.",
    "emotion": "平靜"
  },
  "zq31a07": {
    "text": "Ainda acordada?",
    "say": "E o sono?",
    "emotion": "輕聲，短促"
  },
  "zq31a08": {
    "text": "Quer saber.",
    "emotion": "看著月亮，不看他，冷淡"
  },
  "zq31a09": {
    "text": "Sim.",
    "emotion": "坦白，短促"
  },
  "zq31a10": {
    "text": "Mas você não quer contar.",
    "say": "Mas não conta.",
    "emotion": "不逼她，平靜"
  },
  "zq31a11": {
    "text": "Ele me viu entre muros bem altos.",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "Chega de perguntas.",
    "say": "Chega.",
    "emotion": "說完就別過臉，耳尖有點紅，短促"
  },
  "zq31a13": {
    "text": "Tá, não pergunto.",
    "say": "Tá. Não insisto.",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "A-Ling: afeição, mais quatro.",
    "say": "A-Ling: mais quatro."
  },
  "zq31a15": {
    "text": "Três meses,",
    "say": "Três meses"
  },
  "zq31a16": {
    "text": "e nem uma gota de chuva.",
    "emotion": "聲音悶"
  },
  "zq31a17": {
    "text": "Semente não espera chuva.",
    "say": "Não esperam.",
    "emotion": "畫外，低聲"
  },
  "zq31a18": {
    "text": "Deixa elas acordarem.",
    "say": "Vão acordar.",
    "emotion": "低聲，平靜"
  },
  "zq31a19": {
    "text": "Brotou!",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "Xu Yan, brotou em três dias!",
    "emotion": "得意，梨渦很深，語速快"
  },
  "zq31a21": {
    "text": "Irmão Xu!",
    "say": "Xu!",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "O ria… o riacho secou!",
    "emotion": "畫外，嚇壞了"
  },
  "zq31a23": {
    "text": "Rio acima, sem água,",
    "say": "Não tem água,",
    "emotion": "捏碎乾泥，急"
  },
  "zq31a24": {
    "text": "a roça vai secar toda!",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "E a roça dos Qian?",
    "say": "E a dos Qian?",
    "emotion": "冷靜"
  },
  "zq31a26": {
    "text": "Os Qian…",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "A roça deles tá verde.",
    "emotion": "想到了，變臉"
  },
  "zq31a28": {
    "text": "O preço do grão,",
    "say": "O grão,",
    "emotion": "拍著糧袋，油滑"
  },
  "zq31a29": {
    "text": "sobe mais trinta por cento.",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "O céu não manda chuva,",
    "say": "O céu não manda chuva",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "o Céu conta dinheiro pra mim.",
    "emotion": "得意，拖長音"
  },
  "zq31a32": {
    "text": "Missão da seca:",
    "say": "Missão:"
  },
  "zq31a33": "em dez dias, água nas roças de Liuxi.",
  "zq31a34": {
    "text": "Falha: as sementes morrem.",
    "say": "Falha: seca.",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "Vamos rio acima.",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "Irmão Xu, olha!",
    "emotion": "指著上游，大吼"
  },
  "zq31a37": {
    "text": "A água vai pros Qian!",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "Devolvam a água!",
    "say": "Devolvam!",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "Erniu!",
    "emotion": "畫外，大喊"
  }
}
