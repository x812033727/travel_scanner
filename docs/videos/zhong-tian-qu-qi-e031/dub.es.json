{
  "zq31a01": {
    "text": "No soy ella.",
    "emotion": "面巾拉回臉上，聲音冷得像井水"
  },
  "zq31a02": {
    "text": "Pero tú eres…",
    "emotion": "整個人僵著，話說不完"
  },
  "zq31a03": {
    "text": "Señorito, váyase.",
    "emotion": "背過身，冷，不看他"
  },
  "zq31a04": {
    "text": "¿Conoce a A-Ling?",
    "emotion": "小聲，眼睛睜大"
  },
  "zq31a05": {
    "text": "No sé.",
    "say": "Sepa."
  },
  "zq31a06": {
    "text": "Si quiere, hablará.",
    "emotion": "平靜"
  },
  "zq31a07": {
    "text": "¿En vela?",
    "say": "¿En pie?",
    "emotion": "輕聲"
  },
  "zq31a08": {
    "text": "Tienes dudas.",
    "emotion": "看著月亮，冷淡"
  },
  "zq31a09": {
    "text": "Sí.",
    "emotion": "坦白，短促"
  },
  "zq31a10": "Pero no quieres.",
  "zq31a11": {
    "text": "Él me vio tras muros muy altos.",
    "emotion": "聲音很輕，一字一字"
  },
  "zq31a12": {
    "text": "Ya no más.",
    "emotion": "別過臉，短促"
  },
  "zq31a13": {
    "text": "Bien, no pregunto.",
    "emotion": "點頭，很穩"
  },
  "zq31a14": {
    "text": "A-Ling: afecto más cuatro.",
    "say": "A-Ling, más cuatro.",
    "emotion": "平板電子音"
  },
  "zq31a15": {
    "text": "Tres meses,",
    "emotion": "聲音悶"
  },
  "zq31a16": "ni una gota de lluvia.",
  "zq31a17": {
    "text": "Lluvia o no,",
    "emotion": "畫外，低聲"
  },
  "zq31a18": "que despierten.",
  "zq31a19": {
    "text": "¡Brotaron!",
    "emotion": "畫外，尖叫"
  },
  "zq31a20": {
    "text": "¡Xu Yan, brotaron en tres días!",
    "emotion": "得意"
  },
  "zq31a21": {
    "text": "¡Hermano!",
    "say": "¡Xu!",
    "emotion": "畫外，大嗓門，喘"
  },
  "zq31a22": {
    "text": "¡El a… el arroyo se cortó!",
    "emotion": "嚇壞了，大嗓門"
  },
  "zq31a23": {
    "text": "Arriba no hay agua,",
    "say": "Sin agua,"
  },
  "zq31a24": {
    "text": "¡los campos se mueren!",
    "emotion": "大嗓門，急"
  },
  "zq31a25": {
    "text": "¿Y don Qian?",
    "emotion": "冷靜"
  },
  "zq31a26": {
    "text": "Don Qian…",
    "emotion": "愣住"
  },
  "zq31a27": {
    "text": "Los suyos siguen verdes.",
    "emotion": "想到了，變臉"
  },
  "zq31a28": {
    "text": "El grano,",
    "say": "Grano,",
    "emotion": "油滑，拍著糧袋"
  },
  "zq31a29": {
    "text": "sube un treinta por ciento.",
    "say": "sube otro treinta.",
    "emotion": "油滑，拖長音"
  },
  "zq31a30": {
    "text": "El cielo no llueve,",
    "emotion": "冷笑"
  },
  "zq31a31": {
    "text": "el cielo me cuenta el dinero.",
    "emotion": "得意，拖長音"
  },
  "zq31a32": {
    "text": "Misión de sequía:",
    "say": "Misión:",
    "emotion": "平板電子音"
  },
  "zq31a33": "en diez días, agua en los campos de Liuxi.",
  "zq31a34": {
    "text": "Fallo: las semillas mueren.",
    "say": "Fallo: semilla seca.",
    "emotion": "平板電子音，冷"
  },
  "zq31a35": {
    "text": "Río arriba.",
    "emotion": "咬牙，一句話"
  },
  "zq31a36": {
    "text": "¡Hermano Xu, mira!",
    "emotion": "大吼"
  },
  "zq31a37": {
    "text": "¡Desvían el agua a don Qian!",
    "emotion": "氣得跺腳"
  },
  "zq31a38": {
    "text": "¡Devuelvan el agua!",
    "emotion": "吼，豁出去"
  },
  "zq31a39": {
    "text": "¡Erniu!",
    "emotion": "畫外，大喊"
  }
}
