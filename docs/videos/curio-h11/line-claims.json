  "lines": [
    {
      "line_id": "va7e787b",
      "scene_id": "book-purchase",
      "text": "一九一二年，義大利。一名書商買下一本書，翻開來，是植物和陌生的文字。",
      "claims": [
        "H11-C01"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v3962cb5",
      "scene_id": "strange-writing",
      "text": "那些圖像似乎想說明什麼，可是旁邊一行行的句子，還沒有確定的讀法。",
      "claims": [
        "H11-C03"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v1687a61",
      "scene_id": "tease-sample",
      "text": "後來，研究人員會從羊皮紙取下一點樣本，想先問出它的年紀。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v766e7f7",
      "scene_id": "tease-release",
      "text": "一所大學也會發布解讀研究的消息，學者隨即提出疑慮。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v960e564",
      "scene_id": "tease-light",
      "text": "再後來，研究者重新處理不同光下拍到的影像，試著看清頁邊淡去的字。",
      "claims": [
        "H11-C09",
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v98729cd",
      "scene_id": "opening-question",
      "text": "這些方法，能讓我們讀懂內容，還是先讓別的問題有了答案？",
      "claims": [
        "H11-E01"
      ],
      "sources": [],
      "kind": "editorial"
    },
    {
      "line_id": "vc14d268",
      "scene_id": "book-name",
      "text": "買書的人叫伏尼契。這本書後來以他的姓氏命名，就叫伏尼契手稿。",
      "claims": [
        "H11-C01"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vde0982c",
      "scene_id": "not-first-reader",
      "text": "他的購藏把手稿帶進近代研究，但書頁上，早就留著更早的人碰過的痕跡。",
      "claims": [
        "H11-C01",
        "H11-C10",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S06"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v8949601",
      "scene_id": "leaf-count",
      "text": "今天的館藏目錄，記錄它共有一百零二葉羊皮紙，裡面還有折頁。",
      "claims": [
        "H11-C02"
      ],
      "sources": [
        "H11-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v2405e28",
      "scene_id": "leaf-page",
      "text": "一葉有正反兩面。所以看到葉數時，不能直接把它當成頁數。",
      "claims": [
        "H11-C02",
        "H11-E01"
      ],
      "sources": [
        "H11-S02"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "vd5e8190",
      "scene_id": "plant-page",
      "text": "你先看到的可能是一株植物，旁邊排著幾行字，像在解釋這株植物。",
      "claims": [
        "H11-C03"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v179b9a8",
      "scene_id": "image-purpose",
      "text": "但沒有讀懂那些句子，就還不能確定，它真的在寫植物的用途。",
      "claims": [
        "H11-C03",
        "H11-E01"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v61e210f",
      "scene_id": "foldout-page",
      "text": "翻到別處，圖像又換了。書裡有星形的圖案，也有連成一片的圓形構圖。",
      "claims": [
        "H11-C03"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v339ff28",
      "scene_id": "pictures-divide",
      "text": "圖畫讓研究者分出不同部分，文字卻沒有因此變成一本可以直接查的字典。",
      "claims": [
        "H11-C03",
        "H11-E01"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v44daffa",
      "scene_id": "unknown-author",
      "text": "圖畫旁的字，究竟是誰寫下的，又用了什麼文字系統？",
      "claims": [
        "H11-C03"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v5ce4aae",
      "scene_id": "bacon-attribution",
      "text": "作者還沒有定案。曾有說法指向培根，館方卻把這項歸屬列為推測。",
      "claims": [
        "H11-C15"
      ],
      "sources": [
        "H11-S01",
        "H11-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v33ad727",
      "scene_id": "yale-arrival",
      "text": "一九六九年，書商克勞斯把它捐給耶魯。它有了固定館藏編號。",
      "claims": [
        "H11-C01"
      ],
      "sources": [
        "H11-S01"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vcf7d1a6",
      "scene_id": "shelf-identity",
      "text": "那個編號是四百零八。至少研究者可以確定，彼此研究的是同一件物品。",
      "claims": [
        "H11-C15",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S02"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v524a452",
      "scene_id": "where-to-start",
      "text": "如果暫時讀不出一句話，能不能先從承載文字的材料開始問？",
      "claims": [
        "H11-E01"
      ],
      "sources": [],
      "kind": "editorial"
    },
    {
      "line_id": "v57b521e",
      "scene_id": "sample-recall",
      "text": "還記得開場那份極小的樣本嗎？要知道它的年代，研究者把目光轉向羊皮紙。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v5f9aa2e",
      "scene_id": "conservation-choice",
      "text": "取樣時，保存人員先找出沒有修補過的地方，才讓實驗室取得材料。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v0e564e3",
      "scene_id": "four-samples",
      "text": "研究人員從四頁取下四份樣本，每份都只有細細一小條。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v771b973",
      "scene_id": "clean-samples",
      "text": "樣本還得先清理，因為手指留下的油脂，或裝訂用的黏著物，都可能干擾定年。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vd7a16ea",
      "scene_id": "animal-material",
      "text": "羊皮紙來自動物皮。動物活著時吸收的碳，能留下估算年代的線索。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v611e63e",
      "scene_id": "carbon-question",
      "text": "實驗室要回答的，是這份材料有多老，跟它上面的字是不是能翻譯，是兩個問題。",
      "claims": [
        "H11-C04",
        "H11-E01"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v9b3074b",
      "scene_id": "dating-work",
      "text": "二〇〇九年的定年工作，給出了一段範圍：十五世紀前半。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v69591a8",
      "scene_id": "range-card",
      "text": "更精確地說，是一四〇四年到一四三八年。",
      "claims": [
        "H11-C04"
      ],
      "sources": [
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vcbef25e",
      "scene_id": "what-was-measured",
      "text": "這個結果測的是羊皮紙，沒有直接替每一筆墨水標上書寫日期。",
      "claims": [
        "H11-C05"
      ],
      "sources": [
        "H11-S01",
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v4a9a901",
      "scene_id": "ink-constraint",
      "text": "墨水本身要取到足夠、又能分開的材料來測定，並不容易。",
      "claims": [
        "H11-C04",
        "H11-C05"
      ],
      "sources": [
        "H11-S01",
        "H11-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v3be0bcb",
      "scene_id": "return-to-text",
      "text": "研究者還是得把書打開，把那些重複出現的字形，一個個記下來。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v652f3b2",
      "scene_id": "counts-question",
      "text": "即使暫時不知道字的意思，字在書裡出現的位置，會不會先透露線索？",
      "claims": [
        "H11-C06",
        "H11-E01"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "va099beb",
      "scene_id": "distribution-study",
      "text": "有人開始比較：哪些字形常常一起出現，哪些集中在書的某些部分。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v2fc22c8",
      "scene_id": "not-single-sign",
      "text": "這樣看，問題就從單一符號像哪個字，變成整本書的文字怎麼分布。",
      "claims": [
        "H11-C06",
        "H11-E01"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v4394559",
      "scene_id": "time-study",
      "text": "二〇一三年的一項研究，用資訊理論去分析這種分布。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "va919cc7",
      "scene_id": "local-groups",
      "text": "有些詞在一部分特別集中，換到另一部分，又換成其他詞比較常見。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vfc824ec",
      "scene_id": "compared-books",
      "text": "研究裡拿來比較的，有中文的史記，也有英文的物種起源，和拉丁文文本。",
      "claims": [
        "H11-C16"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vd262f61",
      "scene_id": "sections-connect",
      "text": "他們也只靠文字分布，連起兩個常見植物圖的部分，得到與圖像相呼應的關係。",
      "claims": [
        "H11-C16"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "va085d00",
      "scene_id": "compare-language",
      "text": "研究者把這種組織性，和已知語言的文字比較，認為它帶著語言資訊的特徵。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v404103f",
      "scene_id": "pattern-result",
      "text": "有些常一起出現的詞，連開頭或結尾的形狀都相近，讓研究者更想追它們的關係。",
      "claims": [
        "H11-C06"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v98e1b79",
      "scene_id": "meaning-gap",
      "text": "可是知道哪些詞會聚在一起，還不能說出那一段是在談哪株植物。",
      "claims": [
        "H11-C06",
        "H11-E01"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v4265790",
      "scene_id": "unknown-dictionary",
      "text": "它沒有交出一份可以從頭讀下去的譯文，也沒有確定原稿用了哪一種語言。",
      "claims": [
        "H11-C06",
        "H11-E01"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v361508d",
      "scene_id": "research-progress",
      "text": "對這本書來說，這仍是新問題：如果有結構，能不能找到能重複使用的讀法？",
      "claims": [
        "H11-C06",
        "H11-E01"
      ],
      "sources": [
        "H11-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "vc48d02d",
      "scene_id": "translation-test",
      "text": "你說某個符號是某個意思，換到另一頁，它還能照同一種方式讀嗎？",
      "claims": [
        "H11-E01"
      ],
      "sources": [],
      "kind": "editorial"
    },
    {
      "line_id": "ve29b3a9",
      "scene_id": "new-claim-arrives",
      "text": "幾年後，一項解讀研究成了大學新聞。這一次，消息跑得比紙頁更快。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v14ba199",
      "scene_id": "release-recall",
      "text": "開場那則被提出疑慮的消息，來自二〇一九年的布里斯托大學。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v2e3d91b",
      "scene_id": "release-context",
      "text": "大學發布了一項手稿研究的新聞，介紹一位名譽研究人員的工作。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vec5b307",
      "scene_id": "independent-work",
      "text": "校方後來說明，這項研究是他自行完成的，並不是大學參與的計畫。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v7639780",
      "scene_id": "paper-published",
      "text": "那篇論文已刊在羅曼語研究期刊，也通過雙盲審查。消息發布後，質疑才陸續出現。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "va5b5d45",
      "scene_id": "experts-question",
      "text": "消息發布後，語言學和中世紀研究領域，都有人提出疑慮。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vd9827f1",
      "scene_id": "statement-date",
      "text": "到了五月十六日，也就是隔天，校方發出聲明。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v470a2c5",
      "scene_id": "story-removed",
      "text": "原來的新聞稿被撤下，校方要等研究得到進一步驗證，再作處理。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vc25d396",
      "scene_id": "paper-distinction",
      "text": "撤下的是新聞稿。那篇研究論文，不能因此就被說成已經撤稿。",
      "claims": [
        "H11-C07"
      ],
      "sources": [
        "H11-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v438a4b9",
      "scene_id": "book-remains",
      "text": "這本書繼續留在館藏裡。報導熱鬧過後，頁邊那些淡去的痕跡，也還在。",
      "claims": [
        "H11-C03",
        "H11-C07",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S05"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v07a5163",
      "scene_id": "margin-question",
      "text": "如果先看清那些痕跡，會不會碰到另一位讀者留下的線索？",
      "claims": [
        "H11-C09",
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v2b32364",
      "scene_id": "images-return",
      "text": "二〇二四年，一組過去拍下的影像，讓研究者重新查看這本書。",
      "claims": [
        "H11-C09"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v3763f90",
      "scene_id": "captured-earlier",
      "text": "它們早在十年前拍攝，挑的是書裡十頁，用不同波段的光來觀察。",
      "claims": [
        "H11-C09"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vd854ca2",
      "scene_id": "different-light",
      "text": "同一頁在不同光下，材料和墨水的反應可能不同，淡去的筆畫就有機會更清楚。",
      "claims": [
        "H11-C09"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v7cc1054",
      "scene_id": "full-release",
      "text": "部分細節以前就發表過，這次公開的，是整組影像，還有重新處理的結果。",
      "claims": [
        "H11-C09"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vaee9829",
      "scene_id": "ghost-writing",
      "text": "但影像變清楚，也可能更容易看錯。有一頁冒出淡藍色的字，它真是藏起來的文字嗎？",
      "claims": [
        "H11-C17"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v1df5834",
      "scene_id": "reverse-match",
      "text": "戴維斯把影像反轉，再拿同一葉的背面來比，才把那些字認成從背面透過來的影子。",
      "claims": [
        "H11-C17"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v965353b",
      "scene_id": "tease-payoff",
      "text": "開場那個想看清頁邊的動作，現在指向首頁右側的幾欄痕跡。",
      "claims": [
        "H11-C09",
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v81627c3",
      "scene_id": "three-columns",
      "text": "研究者戴維斯辨認出三欄：一欄拉丁字母，一欄手稿符號，旁邊又是一欄拉丁字母。",
      "claims": [
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v0931109",
      "scene_id": "offset-alphabet",
      "text": "兩欄拉丁字母，位置還錯開一個。看起來很像有人試著把符號排在一起。",
      "claims": [
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vc34e31d",
      "scene_id": "decoding-question",
      "text": "這會不會是一位早期讀者，想拿來解讀正文的嘗試？",
      "claims": [
        "H11-C10",
        "H11-E01"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v439465f",
      "scene_id": "handwriting-comparison",
      "text": "戴維斯又比較相關人物留下的筆跡，認為馬爾奇的字，有一些相符的特徵。",
      "claims": [
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v4353a57",
      "scene_id": "not-key",
      "text": "她也沒有把它當成能讀出全書的密鑰。頁邊的筆跡，可能屬於後來讀書的人。",
      "claims": [
        "H11-C10"
      ],
      "sources": [
        "H11-S06"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v7cfdf05",
      "scene_id": "pattern-question",
      "text": "那麼，之前找到的文字規律呢？如果有人能造出相似的文字，又能說明多少？",
      "claims": [
        "H11-C06",
        "H11-C12",
        "H11-E01"
      ],
      "sources": [
        "H11-S04",
        "H11-S09"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v2ebbd0d",
      "scene_id": "model-new",
      "text": "二〇二五年，研究者格雷什科提出一個叫奈貝的模型，換了一個方向試。",
      "claims": [
        "H11-C12"
      ],
      "sources": [
        "H11-S09"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v37a7ba4",
      "scene_id": "known-input",
      "text": "他的起點是已知的拉丁文或義大利文，再依設計的步驟，把它變成另一種文本。",
      "claims": [
        "H11-C12"
      ],
      "sources": [
        "H11-S09"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "v2a16849",
      "scene_id": "similar-output",
      "text": "作者說，這樣做出的文本，會呈現手稿裡好幾種相似的統計特徵。",
      "claims": [
        "H11-C12"
      ],
      "sources": [
        "H11-S09"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vb393dd6",
      "scene_id": "model-payoff",
      "text": "這就讓一種可能的製作方式，可以被拿出來研究；但他沒有翻譯原稿。",
      "claims": [
        "H11-C12",
        "H11-C13"
      ],
      "sources": [
        "H11-S01",
        "H11-S09"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "vd56bdd7",
      "scene_id": "known-versus-original",
      "text": "模型有已知輸入，可以檢查轉換後怎麼讀回去。原稿當初寫了什麼，仍待找到讀法。",
      "claims": [
        "H11-C13",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S09"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v6911d5a",
      "scene_id": "outro",
      "text": "還記得開場那本書嗎？它的紙和頁邊，已經能帶我們往前走；正文仍在等可檢驗的讀法。",
      "claims": [
        "H11-C14",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S03",
        "H11-S04",
        "H11-S06",
        "H11-S09"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v75e1ebb",
      "scene_id": "outro",
      "text": "如果先查一樣，你會選圖、字，還是紙？",
      "claims": [
        "H11-C14",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S03",
        "H11-S04",
        "H11-S06",
        "H11-S09"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "v9e503a3",
      "scene_id": "outro",
      "text": "訂閱奇聞檔案局，陪我們沿著能核對的紀錄，把怪事查清楚。",
      "claims": [
        "H11-C14",
        "H11-E01"
      ],
      "sources": [
        "H11-S01",
        "H11-S03",
        "H11-S04",
        "H11-S06",
        "H11-S09"
      ],
      "kind": "sourced_with_editorial_bridge"
    }
  ]
}
