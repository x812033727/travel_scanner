    "chapters": {
      "two-stands-open": "effebff87072",
      "kid-book-guess": "fe8aeb6c3962",
      "chief-modules-intro": "73b040322617",
      "chief-stain-hits-both": "bff6d984de96",
      "chief-whole-box-rule": "4ddfef8e5ced",
