{
  "zq22a01": "Eu pago por mim.",
  "zq22a02": "Quero você.",
  "zq22a03": "Se não voltar pros Wei,",
  "zq22a04": "a família Xu nunca vai ter paz.",
  "zq22a05": "Entendi.",
  "zq22a06": "Então,",
  "zq22a07": "três dias. Te espero.",
  "zq22a08": "Xiaohe, come mais.",
  "zq22a09": "Xiaotang,",
  "zq22a10": "é Ano-Novo?",
  "zq22a11": "Bateu a cabeça?",
  "zq22a12": "Querido,",
  "zq22a13": "você é quem mais rala.",
  "zq22a14": "Hoje…",
  "zq22a15": "é algum dia especial?",
  "zq22a16": "Ela vai embora hoje.",
  "zq22a17": "Xiaotang?",
  "zq22a18": {
    "text": "Por esta carta de divórcio:",
    "say": "Divórcio:"
