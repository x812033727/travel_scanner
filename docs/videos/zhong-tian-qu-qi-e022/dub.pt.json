  "zq22a19": "contas quites,",
  "zq22a20": "nada a dever.",
  "zq22a21": {
    "text": "Ela escreveu um divórcio?",
    "say": "Um divórcio?"
  },
  "zq22a22": "De quem, hein?",
  "zq22a23": "Esposa dá divórcio?",
  "zq22a24": "Pela lei, não vale.",
  "zq22a25": "Aviso:",
  "zq22a26": {
    "text": "Tang Xiaotang está se afastando.",
    "say": "Tang Xiaotang se afastando."
  },
  "zq22a27": "O cais,",
  "zq22a28": {
    "text": "tem barco à meia-noite.",
    "say": "barco à meia-noite."
  },
  "zq22a29": "Vai ficar aí?",
  "zq22a30": "Vai atrás!",
  "zq22a31": {
    "text": "Não olha pra trás,",
    "say": "Não olha,"
  },
  "zq22a32": "Tang Xiaotang.",
  "zq22a33": "Xiaotang—!",
  "zq22a34": "Rasguei o divórcio!"
