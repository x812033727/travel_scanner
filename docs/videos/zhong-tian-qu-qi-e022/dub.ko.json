{
  "zq22a01": "나를 살게.",
  "zq22a02": "사람을 원해.",
  "zq22a03": "웨이 가로 안 오면,",
  "zq22a04": "쉬가는 편할 날 없을 거야.",
  "zq22a05": "알았어.",
  "zq22a06": "흠,",
  "zq22a07": "사흘이야.",
  "zq22a08": "샤오허, 더 먹어.",
  "zq22a09": "탕 언니,",
  "zq22a10": "오늘 설날이야?",
  "zq22a11": "약 잘못 먹었어?",
  "zq22a12": "서방님,",
  "zq22a13": "제일 고생했어.",
  "zq22a14": "오늘…",
  "zq22a15": "무슨 날이야?",
  "zq22a16": "오늘 밤 떠나.",
  "zq22a17": "샤오탕?",
  "zq22a18": "이혼장,",
  "zq22a19": "장부 정산,",
  "zq22a20": "빚은 없음.",
  "zq22a21": "쟤가 이혼장을?",
  "zq22a22": "누굴 버려?",
  "zq22a23": "아내가 쓴 이혼장은,",
  "zq22a24": "법적 무효야.",
  "zq22a25": "경고,",
  "zq22a26": "탕샤오탕, 멀어지는 중.",
  "zq22a27": "나루터,",
  "zq22a28": "자시에 배 있어.",
  "zq22a29": "멍하니 뭐 해?",
  "zq22a30": "쫓아가!",
  "zq22a31": "돌아보지 마,",
  "zq22a32": "탕샤오탕.",
  "zq22a33": "샤오탕—!",
  "zq22a34": "이혼장 찢었어!"
}
