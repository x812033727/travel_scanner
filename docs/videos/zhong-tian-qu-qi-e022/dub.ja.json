{
  "zq22a01": "自分を買う。",
  "zq22a02": "君が欲しい。",
  "zq22a03": "戻らないなら、",
  "zq22a04": "シュー家に平穏はない。",
  "zq22a05": "わかった。",
  "zq22a06": "三日。",
  "zq22a07": "待っている。",
  "zq22a08": "いっぱい食べて。",
  "zq22a09": "お姉ちゃん、",
  "zq22a10": "今日お正月？",
  "zq22a11": "熱でもある？",
  "zq22a12": "ねえ",
  "zq22a13": "お疲れ様。",
  "zq22a14": "今日は……",
  "zq22a15": "何の日だ？",
  "zq22a16": "今夜、行く気。",
  "zq22a17": "シャオタン？",
  "zq22a18": "離縁を記す",
  "zq22a19": "清算。",
  "zq22a20": "貸し借りなし。",
  "zq22a21": "離縁？",
  "zq22a22": "誰を離縁よ？",
  "zq22a23": "妻の離縁状は",
  "zq22a24": "律じゃ無効だ。",
  "zq22a25": "警告、",
  "zq22a26": "タン・シャオタン、離脱中。",
  "zq22a27": "渡し場、",
  "zq22a28": "子の刻に船。",
  "zq22a29": "ぼさっとしない！",
  "zq22a30": "追って！",
  "zq22a31": "振り向くな、",
  "zq22a32": "タン・シャオタン。",
  "zq22a33": "シャオタン！",
  "zq22a34": "離縁状は破いた！"
