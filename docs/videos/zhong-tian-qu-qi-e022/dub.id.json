{
  "zq22a01": {
    "text": "Aku tebus diriku sendiri.",
    "say": "Aku tebus diriku."
  },
  "zq22a02": {
    "text": "Aku maunya kau.",
    "say": "Aku mau kau."
  },
  "zq22a03": {
    "text": "Kalau kau tak kembali ke keluarga Wei,",
    "say": "Tak kembali,"
  },
  "zq22a04": "keluarga Xu jangan harap tenang.",
  "zq22a05": "Aku mengerti.",
  "zq22a06": {
    "text": "Tiga hari,",
    "say": "Tiga…"
  },
  "zq22a07": {
    "text": "kutunggu kau.",
    "say": "hari. Kutunggu."
  },
  "zq22a08": "Xiaohe, makan yang banyak.",
  "zq22a09": "Kak Xiaotang,",
  "zq22a10": {
    "text": "hari ini Tahun Baru, ya?",
    "say": "Tahun Baru, ya?"
  },
  "zq22a11": "Kesambet apa kamu?",
  "zq22a12": {
    "text": "Suamiku,",
    "say": "Mas,"
  },
  "zq22a13": "kamu yang paling capek.",
  "zq22a14": "Hari ini…",
  "zq22a15": "ada acara apa?",
  "zq22a16": "Dia mau pergi malam ini.",
  "zq22a17": "Xiaotang?",
  "zq22a18": {
    "text": "Dengan ini kutulis surat cerai,",
    "say": "Cerai."
  },
  "zq22a19": "utang-piutang lunas,",
  "zq22a20": {
    "text": "tak saling berutang.",
    "say": "tak ada utang."
  },
  "zq22a21": {
    "text": "Dia yang nulis surat cerai?",
    "say": "Surat cerai?"
  },
  "zq22a22": "Ceraikan siapa?",
  "zq22a23": "Istri nulis surat cerai,",
  "zq22a24": "menurut hukum nggak sah.",
  "zq22a25": {
    "text": "Peringatan:",
    "say": "Awas:"
  },
  "zq22a26": {
    "text": "Tang Xiaotang sedang menjauh.",
    "say": "Tang Xiaotang menjauh."
  },
  "zq22a27": "Dermaga,",
  "zq22a28": "tengah malam ada kapal.",
  "zq22a29": "Ngapain bengong?",
  "zq22a30": "Kejar!",
  "zq22a31": "Jangan menoleh,",
  "zq22a32": "Tang Xiaotang.",
  "zq22a33": "Xiaotang—!",
  "zq22a34": "Surat cerainya kusobek!"
}
