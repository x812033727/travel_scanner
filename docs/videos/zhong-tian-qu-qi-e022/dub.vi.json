{
  "zq22a01": "Ta tự chuộc mình.",
  "zq22a02": "Ta muốn người.",
  "zq22a03": {
    "text": "Nàng không về Ngụy gia,",
    "say": "Không về Ngụy gia,"
  },
  "zq22a04": "nhà họ Hứa đừng mong yên ổn.",
  "zq22a05": "Ta hiểu rồi.",
  "zq22a06": "Ba ngày.",
  "zq22a07": "ta chờ nàng.",
  "zq22a08": "Tiểu Hòa, ăn nhiều vào.",
  "zq22a09": "Đường tỷ tỷ,",
  "zq22a10": "Hôm nay Tết à?",
  "zq22a11": {
    "text": "Ngươi uống nhầm thuốc à?",
    "say": "Uống nhầm thuốc à?"
  },
  "zq22a12": "Tướng công,",
  "zq22a13": "huynh vất vả nhất.",
  "zq22a14": "Hôm nay…",
  "zq22a15": "là ngày gì vậy?",
  "zq22a16": "Đêm nay nàng ấy sẽ đi.",
  "zq22a17": "Tiểu Đường?",
  "zq22a18": "Lập hưu thư,",
  "zq22a19": "sổ sách sòng phẳng,",
  "zq22a20": "không ai nợ ai.",
  "zq22a21": {
    "text": "Nàng ta viết hưu thư?",
    "say": "Viết hưu thư?"
  },
  "zq22a22": "Bỏ ai cơ chứ?",
  "zq22a23": "Vợ mà viết hưu thư,",
  "zq22a24": "luật không công nhận.",
  "zq22a25": "Cảnh báo,",
  "zq22a26": {
    "text": "Đường Tiểu Đường đang rời xa.",
    "say": "Tiểu Đường đang rời xa."
  },
  "zq22a27": "Bến đò,",
  "zq22a28": "giờ Tý có chuyến đò.",
  "zq22a29": "Còn ngây ra đấy?",
  "zq22a30": "Đuổi theo đi!",
  "zq22a31": "Đừng quay đầu,",
  "zq22a32": "Đường Tiểu Đường.",
  "zq22a33": "Tiểu Đường—!",
  "zq22a34": "Hưu thư ta xé rồi!"
}
