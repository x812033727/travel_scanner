{
  "zq22a01": "Me compro yo misma.",
  "zq22a02": "Quiero a la novia.",
  "zq22a03": {
    "text": "Si no vuelves con los Wei,",
    "say": "Si no vuelves,"
  },
  "zq22a04": "la familia Xu no volverá a tener paz.",
  "zq22a05": "Entiendo.",
  "zq22a06": {
    "text": "Tres días,",
    "say": "Tres,"
  },
  "zq22a07": {
    "text": "te espero.",
    "say": "días, te espero."
  },
  "zq22a08": "Xiaohe, come más.",
  "zq22a09": "Hermana Tang,",
  "zq22a10": "¿hoy es Año Nuevo?",
  "zq22a11": "¿Qué mosca te picó?",
  "zq22a12": {
    "text": "Amor,",
    "say": "Amor"
  },
  "zq22a13": "tú eres quien más trabaja.",
  "zq22a14": "Hoy…",
  "zq22a15": "¿qué celebramos?",
  "zq22a16": "Se va esta noche.",
  "zq22a17": "¿Xiaotang?",
  "zq22a18": {
    "text": "Hoy firmo esta carta de divorcio:",
    "say": "Me divorcio:"
  },
  "zq22a19": "cuentas claras,",
  "zq22a20": "sin deudas.",
  "zq22a21": "¿Se divorcia?",
  "zq22a22": "¿Y de quién?",
  "zq22a23": "Si la escribe la esposa,",
  "zq22a24": "no vale ante la ley.",
  "zq22a25": "Alerta:",
  "zq22a26": "Tang Xiaotang se está alejando.",
  "zq22a27": {
    "text": "El embarcadero.",
    "say": "Muelle."
  },
  "zq22a28": "Barco a medianoche.",
  "zq22a29": "¿Qué esperas?",
  "zq22a30": "¡Alcánzala!",
  "zq22a31": "No voltees,",
  "zq22a32": "Tang Xiaotang.",
  "zq22a33": "¡Xiaotang…!",
  "zq22a34": {
    "text": "¡Rompí la carta de divorcio!",
    "say": "¡Rompí la carta!"
  }
}
