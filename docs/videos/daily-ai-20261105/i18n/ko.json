  "lines": {
    "5032": {
      "source_hash": "9666ad496b13",
      "text": "넷."
    },
    "9965": {
      "source_hash": "93263fe303a6",
      "text": "새 주지사가 유예를 주 규정으로 만들지예요."
    },
    "k8gk": {
      "source_hash": "91e2205aa027",
      "text": "11월 5일 목요일이에요."
    },
    "qu5h": {
      "source_hash": "70acdd04953e",
      "text": "여기는 Tech Signal, 잡음 속에서 오늘 진짜 중요한 신호를 골라요."
    },
    "l2e4": {
      "source_hash": "97e2115b9cf9",
      "text": "Sola예요."
    },
    "olyi": {
      "source_hash": "cf9f8841a94f",
      "text": "Kai예요."
    },
    "32a2": {
      "source_hash": "1a220dc146f2",
      "text": "오늘 주제는 미국 중간선거의 뜻밖의 큰 이슈, AI 데이터센터예요."
    },
    "qwhy": {
      "source_hash": "8ee8f94c06f7",
      "text": "잠깐, 데이터센터는 컴퓨터 넣는 건물이잖아요? 왜 투표로 막아요?"
    },
    "cvea": {
      "source_hash": "5ee762b26d74",
      "text": "그건 주제 코너에서 다뤄요. 먼저 어제 11월 4일 뉴스예요."
    },
    "jd2t": {
      "source_hash": "1198c873ee0c",
      "text": "재밌는 것부터요?"
    },
    "czez": {
      "source_hash": "0dbc573f964e",
      "text": "The Verge는 ChatGPT가 GIF도 바로 만든대요."
    },
    "7iv8": {
      "source_hash": "f78857b9c2a9",
      "text": "반복되는 짧은 영상이요?"
    },
    "p33d": {
      "source_hash": "f124081cb5fa",
      "text": "네. 문장 하나나 사진 한 장이면 돼요."
    },
    "3rol": {
      "source_hash": "c2635719acbf",
      "text": "수정도 돼요?"
    },
    "2cd0": {
      "source_hash": "ed68642c40f9",
      "text": "속도 바꾸고,"
    },
    "y8lz": {
      "source_hash": "157399959ff7",
      "text": "프레임별로 고쳐서 공유도 돼요."
    },
    "i5im": {
      "source_hash": "f6c5941418d5",
      "text": "대만도 돼요?"
    },
    "wg8u": {
      "source_hash": "7eb9de5dfa9c",
      "text": "새 이미지 모델과 나왔고, ChatGPT·Codex 전원에게 열린대요."
    },
    "tww7": {
      "source_hash": "8fe6801437c8",
      "text": "OpenAI는 이미지를 주당 40억 장 넘게 만든대요. 9월엔 30억 장이었어요."
    },
    "snzc": {
      "source_hash": "e2cd17b03fc0",
      "text": "제한 있어요?"
    },
    "hobm": {
      "source_hash": "527ebf1256cd",
      "text": "길이, 해상도, 용량은 보도에 다 없어요. OpenAI 안내를 보세요."
    },
    "8edi": {
      "source_hash": "da9652f7fd8e",
      "text": "만드는 화면에서, 기록되는 소리로 가요."
    },
    "7spw": {
      "source_hash": "36c2fbadb427",
      "text": "TechCrunch는 Apple이 화요일 개발자 베타로 Watch 오디오 AI를 시험한대요."
    },
    "4lqw": {
      "source_hash": "1c2d7ae131c8",
      "text": "뭘 시험해요?"
    },
    "uv3k": {
      "source_hash": "d3c4b8f6b9d0",
      "text": "네 가지예요. 초인종·경보 같은 중요한 소리 감지와 노래 인식이에요."
    },
    "ydfk": {
      "source_hash": "60067be71ac2",
      "text": "둘은 녹음해요. Live Rewind는 지난 15초를 되짚어 주고,"
    },
    "6lr8": {
      "source_hash": "8b3d5a9ba546",
      "text": "Siri Recaps는 하루 소리를 요약해 메모로 저장해요."
    },
    "qaji": {
      "source_hash": "4af3e33d9618",
      "text": "쓸 만해요?"
    },
    "sa4f": {
      "source_hash": "0b46ad6fced0",
      "text": "TechCrunch 기자가 하루 써 보니, 정비소 직원 말이 빨라도 자기부담금과 일정을 적었대요."
    },
    "nwlu": {
      "source_hash": "e4eb0e054191",
      "text": "그런데 쓸데없는 잡담도 적었어요. 기자는 더 사적인 대화면 침해당한 느낌일 거래요."
    },
    "siriq": {
      "source_hash": "ab5a1d1e0dc1",
      "text": "늘 듣죠?"
    },
    "siria": {
      "source_hash": "180c53d6f275",
      "text": "켜면 네. TechCrunch는 Apple이 최대한 기기에서 처리한대요,"
    },
    "h8e0": {
      "source_hash": "e6ca012c72db",
      "text": "화자 구분도, 원본 녹음 저장도 안 해요."
    },
    "z62g": {
      "source_hash": "5684bd437d0f",
      "text": "그럼 뭐가 걱정이에요?"
    },
    "ra54": {
      "source_hash": "5f2e15885dd7",
      "text": "기술이 늘 듣는 게 당연해지는 걸 꺼리는 사람도 있어요."
    },
    "p6v0": {
      "source_hash": "4d35275895b4",
      "text": "일반인도 지금 쓸 수 있어요?"
    },
    "hh4z": {
      "source_hash": "f1794456423d",
      "text": "아직요. 개발자 베타에서 Apple Watch Series 12만 대상이고, 정식 출시는 보도에 없어요."
    },
    "sr4v": {
      "source_hash": "63e882e44cf1",
      "text": "손목의 AI에서 코딩 AI로 가요."
    },
    "56da": {
      "source_hash": "0badfae31dd4",
      "text": "Meta가 AI 코딩 스타트업 Conductor를 인수했대요."
    },
    "d9r8": {
      "source_hash": "52e9e2a03b1e",
      "text": "Conductor는 뭘 해요?"
    },
    "ajeb": {
      "source_hash": "2f69154fd587",
      "text": "AI 에이전트 여럿이 동시에, 각자 독립 공간에서 한 프로젝트를 나눠 하게 해요."
    },
    "7ynj": {
      "source_hash": "06bb93b0739f",
      "text": "에이전트도 직접 만든 거예요?"
    },
    "1qd0": {
      "source_hash": "f5d7095023f5",
      "text": "아뇨. Anthropic, OpenAI 같은 대형 연구소 것이래요."
    },
    "fsj9": {
      "source_hash": "be34fe35b95b",
      "text": "기존 사용자는요?"
    },
    "4jol": {
      "source_hash": "b461daed531c",
      "text": "창업자는 클라우드를 이달 20일에 닫고, 그 뒤 클라우드 데이터를 지운대요."
    },
    "f3o4": {
      "source_hash": "523070b3d6a4",
      "text": "다른 핵심 기능은 내년 초까지 그대로 돼요."
    },
    "93b8": {
      "source_hash": "09cdbf687f03",
      "text": "인수 금액은요?"
    },
    "ccjq": {
      "source_hash": "fabcb24852a8",
      "text": "Meta는 TechCrunch에 인수만 확인하고 금액·조건은 안 밝혔어요."
    },
    "boit": {
      "source_hash": "f564d3afd055",
      "text": "코딩 AI 다음은 교실 속 AI예요."
    },
    "9s0f": {
      "source_hash": "9b022d2226d8",
      "text": "화요일 Google은 학교 Gemini는 꺼도 돼요."
    },
    "wxj7": {
      "source_hash": "c8bfd5a1b118",
      "text": "나머지 AI를 끄면 검색까지 잃고요."
    },
    "im2v": {
      "source_hash": "a6cc00531dd8",
      "text": "검색도 AI예요?"
    },
    "z66e": {
      "source_hash": "e22cd5198c91",
      "text": "Google 검색엔 AI 요약, 대화형 AI Mode가 있어 떼기 어려워요."
    },
    "zn26": {
      "source_hash": "01184281832c",
      "text": "Google 답은요?"
    },
    "pt89": {
      "source_hash": "8227f2c2d080",
      "text": "비판 후 Google은 Gemini와 검색 기능이 기본 꺼짐이라 학교가 골라 켠대요."
    },
    "o5fg": {
      "source_hash": "f89c14ed89ce",
      "text": "이럴 땐 경쟁사가 나서죠."
    },
    "14z5": {
      "source_hash": "a34ed010778e",
      "text": "네. DuckDuckGo CEO가 기본 검색을 자기로 바꾸는 법을 올렸어요."
    },
    "5u57": {
      "source_hash": "347d7647f5c9",
      "text": "자사 AI도 끌 수 있대요. 그쪽 주장이에요."
    },
    "a35h": {
      "source_hash": "1c68b3e46897",
      "text": "기회를 틈탄 영업이네요."
    },
    "zz6h": {
      "source_hash": "185674bee2fc",
      "text": "규모는요?"
    },
    "vt5z": {
      "source_hash": "c586508d67f6",
      "text": "Google 옛 수치로 학교 Chromebook은 약 5천만 대,"
    },
    "eid1": {
      "source_hash": "9c646c44663f",
      "text": "Google Classroom 사용자는 1억 5천만 넘어요. 이번 영향 인원과는 달라요."
    },
    "460x": {
      "source_hash": "986933c63e19",
      "text": "대만 학교도요?"
    },
    "kzgt": {
      "source_hash": "1866252ae5c5",
      "text": "보도는 지역을 안 나눴어요. 설정은 각 학교와 관리자가 정해요."
    },
    "5jfg": {
      "source_hash": "94e7e557ca18",
      "text": "학교 정책에서 국가 정책으로 가요."
    },
    "4fhs": {
      "source_hash": "b4af23709cf9",
      "text": "TechCrunch는 OpenAI 글로벌 업무 책임자가 2028년 미국 대선이 AI의 결정적 순간일 수 있다고 썼대요."
    },
    "dwjh": {
      "source_hash": "d60bdaf3b4ac",
      "text": "2년 남았는데 벌써요?"
    },
    "uvh3": {
      "source_hash": "4ff29cf2fab6",
      "text": "타이밍이 묘해요. TechCrunch는 이 글이 민주당 중간선거 압승 직후에 나왔대요."
    },
    "w6mf": {
      "source_hash": "b9ce7b11b816",
      "text": "Lehane은 AI 경제 영향을 1930년대 뉴딜에 빗대 다섯 방향을 냈어요,"
    },
    "3o19": {
      "source_hash": "5d7520f7e94e",
      "text": "노동자 보호, 교육부터 AI 안전, 데이터센터까지요."
    },
    "x6dr": {
      "source_hash": "0c182b887854",
      "text": "데이터센터도요?"
    },
    "0i9h": {
      "source_hash": "1de99f562f6f",
      "text": "네. 보도로는, 데이터센터 건설 중단을 지지하는 정치인이 미국의 대중국 우위를 해칠 수 있다고 경고했어요."
    },
    "v9p7": {
      "source_hash": "c05f425f63e0",
      "text": "OpenAI는 추가 문의에 무응답이에요."
    },
    "j9ct": {
      "source_hash": "336aaa7443cb",
      "text": "데이터센터란 말, 오늘 계속 나오겠네요."
    },
    "99uy": {
      "source_hash": "192e000ee7da",
      "text": "에이전트 뉴스는 많은데 정말 쓸까요? 오늘의 신호 숫자예요."
    },
    "numq": {
      "source_hash": "655ad5dad568",
      "text": "넷 뭐요? 400만이요?"
    },
    "numa": {
      "source_hash": "bc4699d0f240",
      "text": "차 네 번이에요. Uber는 어제 실적 발표에서, 3분기 내내 외부 AI 에이전트 호출이 이것뿐이래요."
    },
    "x4cc": {
      "source_hash": "34f551f60c47",
      "text": "한 분기 내내요?"
    },
    "cbj0": {
      "source_hash": "a637845d21bf",
      "text": "네, 한 분기요. 배달은 좀 많아 핼러윈 주에 약 500건이에요. 다만 기간이 달라 바로 비교는 못 해요."
    },
    "7oy2": {
      "source_hash": "77f5b2e340ca",
      "text": "왜 중요해요?"
    },
    "csbh": {
      "source_hash": "3406e96e2c07",
      "text": "전문가들은 AI 에이전트로 차나 음식을 부르면 Uber 앱을 안 열까 걱정해요."
    },
    "q4fg": {
      "source_hash": "fed49b6d824a",
      "text": "The Verge는 숫자상 위험이 아직 작대요."
    },
    "yvbf": {
      "source_hash": "125288e6291b",
      "text": "그럼 AI 에이전트로 차 부르는 건 아직 멀었네요."
    },
    "fhyn": {
      "source_hash": "f4fcd394fda6",
      "text": "AI 에이전트는 아직 잘 안 쓰지만, AI를 받치는 건물은 벌써 표로 막혀요."
    },
    "h2nb": {
      "source_hash": "34ba1cdb9011",
      "text": "투표용지 한 장에서 시작해요."
    },
    "i2a5": {
      "source_hash": "d5b4a60dc66e",
      "text": "위스콘신 Janesville에 산다 쳐요. 화요일, 투표용지가 와요."
    },
    "votq": {
      "source_hash": "90c0ec5709e0",
      "text": "뭐라고 쓰여 있어요?"
    },
    "vota": {
      "source_hash": "632a6f7ec8c5",
      "text": "한 문항은 이래요. 옛 GM 공장 부지를 대규모 개발하기 전에 주민 투표를 다시 할까요?"
    },
    "x4e0": {
      "source_hash": "c788ed8608d7",
      "text": "데이터센터랑 상관있어요?"
    },
    "4dqz": {
      "source_hash": "2eba015f312d",
      "text": "Decrypt에 따르면 그 부지는 추진 중인 데이터센터와 관련 있어요. 결과는 60% 넘게 찬성이었어요."
    },
    "terq": {
      "source_hash": "9a3c8b5dcce7",
      "text": "쉽게 말해 데이터센터가 뭐예요?"
    },
    "w24t": {
      "source_hash": "c9afbbad50ce",
      "text": "칩과 서버로 꽉 찬 건물이에요. AI에게 묻는 질문 하나하나가 이런 곳에서 계산돼요."
    },
    "vptb": {
      "source_hash": "e89df7e3446c",
      "text": "여기만이 아니에요."
    },
    "gslf": {
      "source_hash": "9eb80425b666",
      "text": "Decrypt 인용 워싱턴포스트로 화요일 미국 29곳 이상이 데이터센터 금지·제한을 택했어요."
    },
    "qckq": {
      "source_hash": "2ceec6f3259d",
      "text": "정말 많네요."
    },
    "9gmv": {
      "source_hash": "928a1d9fb455",
      "text": "왜요? AI는 다 쓰잖아요."
    },
    "wggb": {
      "source_hash": "36ce32f80f16",
      "text": "전기예요. Decrypt는 데이터센터가 전기를 많이 써서 주민이 요금 인상과 전력망 부담을 걱정한대요."
    },
    "6syb": {
      "source_hash": "7eee039a1c4e",
      "text": "전기만요?"
    },
    "v4fe": {
      "source_hash": "e79fbcddb283",
      "text": "물 사용,"
    },
    "g6az": {
      "source_hash": "84eb6df516bc",
      "text": "소음,"
    },
    "4qk5": {
      "source_hash": "098de276b403",
      "text": "개발 협약에 공공 감시가 없는 것도요."
    },
    "j8kn": {
      "source_hash": "1632d83184c8",
      "text": "AI는 멀리 클라우드에 있는 것 같죠. 그런데 클라우드는 누군가의 집 근처 건물이에요."
    },
    "12ah": {
      "source_hash": "a156488141dd",
      "text": "그리고 그 사람들 손엔 표가 있죠."
    },
    "hkoq": {
      "source_hash": "f3785a2f10c3",
      "text": "The Verge가 인용한 NBC News 선거일 조사에서, 응답 유권자 76%가 동네 데이터센터에 반대했어요."
    },
    "21i7": {
      "source_hash": "ade96b725286",
      "text": "총 몇 건이에요?"
    },
    "nfom": {
      "source_hash": "9deaa036eec8",
      "text": "집계마다 달라요. Decrypt 인용 선거 사이트 Ballotpedia로는, 10개 주 41건 중 28건은 찬성이 제한이에요."
    },
    "olgz": {
      "source_hash": "c58bc8be5b36",
      "text": "The Verge가 인용한 다른 집계로는, 지역 주민투표 45건 중 수요일 아침까지 33건이 개발 제한 결과예요."
    },
    "xbgb": {
      "source_hash": "76cd5361554f",
      "text": "어떤 사례가 있어요?"
    },
    "atya": {
      "source_hash": "36c1a4117dfb",
      "text": "오하이오 Hubbard는 4분의 3 넘게 데이터센터 금지에 찬성했어요."
    },
    "oq86": {
      "source_hash": "ec48314ba617",
      "text": "메인주 Wells는 대형 데이터센터를 180일간 유예해요."
    },
    "9snz": {
      "source_hash": "21a07860c7ee",
      "text": "캔자스주 한 도시는 10년간 10메가와트 넘는 데이터센터를 막아요."
    },
    "tbsc": {
      "source_hash": "2638536e57b8",
      "text": "반대로 지지를 묻는 것도 있어요?"
    },
    "dov8": {
      "source_hash": "c03cd7ea6dc8",
      "text": "있어요. Ballotpedia 41건 중 다른 13건은 데이터센터 허용·지지안이에요."
    },
    "0xoa": {
      "source_hash": "f7a7475aacab",
      "text": "일리노이 Joliet은 80% 가까이 AI 데이터센터 지지안을 부결했어요."
    },
    "b8ht": {
      "source_hash": "8fe61225e0cb",
      "text": "지지하냐는 질문도 부결이네요."
    },
    "advq": {
      "source_hash": "e5a7b0b48c61",
      "text": "그럼 거기선 이제 못 지어요?"
    },
    "adva": {
      "source_hash": "79527c75acc6",
      "text": "꼭 그렇진 않아요. Decrypt는 일부는 자문 투표라 통과돼도 공사가 자동으로 안 멈춘대요."
    },
    "mrdo": {
      "source_hash": "a86795d97085",
      "text": "주 단위도 있어요. 텍사스 민주당 후보가 현직 주지사를 이겼어요."
    },
    "y4hj": {
      "source_hash": "c1fe483e0632",
      "text": "그 후보는 새 데이터센터 유예를 내걸었어요."
    },
    "g3mm": {
      "source_hash": "bff60a674f80",
      "text": "주지사 권한이 커요?"
    },
    "rd7c": {
      "source_hash": "3ec03ce542dc",
      "text": "Decrypt는 이런 승리로 주 규제가 더 엄격해질 수 있대요."
    },
    "xnxr": {
      "source_hash": "a70c93158cf6",
      "text": "그럼 데이터센터가 선거를 결정했어요?"
    },
    "5zz0": {
      "source_hash": "a9d70c3061bd",
      "text": "The Verge는 누구의 당선을 이 이슈 덕으로 돌리긴 어렵대요. 온건한 제한을 주장한 사람도 이겼어요."
    },
    "monq": {
      "source_hash": "88002e5338d4",
      "text": "누가 이기고 졌어요? 돈 쪽은요?"
    },
    "8mfi": {
      "source_hash": "f08a411dfb29",
      "text": "직접 영향은 개발사예요. The Verge는 앞으로 짓기 더 어렵대요."
    },
    "su43": {
      "source_hash": "a0f0f2711c4e",
      "text": "유예를 안 내건 당선자도 조건을 냈어요."
    },
    "e351": {
      "source_hash": "24484bf3a913",
      "text": "플로리다 공화당 당선자는 개발사가 에너지와 물을 부담하자고 했고,"
    },
    "8ra8": {
      "source_hash": "533f1c9f0a48",
      "text": "또요?"
    },
    "fcxn": {
      "source_hash": "d3a0b9c433fa",
      "text": "아이오와 당선자도 상대처럼 감면을 끊자 했고,"
    },
    "m1tz": {
      "source_hash": "ebc1356bd96b",
      "text": "펜실베이니아 주지사는 데이터센터 개발에 비밀유지계약을 금지하는 행정명령에 서명했어요."
    },
    "26e8": {
      "source_hash": "6b8f5d3f29f1",
      "text": "AI 회사는 싫어하겠죠?"
    },
    "ifrg": {
      "source_hash": "1a5fdc62fdcc",
      "text": "Decrypt는 로비 강화나 홍보에 나선대요. OpenAI는 데이터센터를 컴퓨팅 파크로 부르려 해요."
    },
    "c25g": {
      "source_hash": "255bd2264e94",
      "text": "한편 어제 칩 회사 Qualcomm은 성장을 AI 데이터센터에 걸었어요."
    },
    "kffj": {
      "source_hash": "0f6ae8b51ab6",
      "text": "Qualcomm은 폰 칩 아니에요?"
    },
    "24fy": {
      "source_hash": "0173c2448bbd",
      "text": "폰 때문이에요. The Verge는 스마트폰 판매가 2025년보다 약 20% 줄었대요."
    },
    "k5se": {
      "source_hash": "35eca4cb8be7",
      "text": "Qualcomm은 2029년 데이터센터로 150억 달러를 벌고,"
    },
    "ncun": {
      "source_hash": "60f333a45e9b",
      "text": "결국 사업의 약 30%가 된대요. 모두 회사 자체 예측이에요."
    },
    "q2gi": {
      "source_hash": "6f72c2d5b00c",
      "text": "막히면 Qualcomm도 타격이에요?"
    },
    "mona": {
      "source_hash": "71c36692d7e0",
      "text": "보도엔 없어 추론 안 해요. 다만 칩이 노리는 데이터센터도 어딘가엔 지어야죠."
    },
    "twnq": {
      "source_hash": "c99432ca3446",
      "text": "칩, 데이터센터면 대만이랑 가깝잖아요. 대만 얘기도 나왔어요?"
    },
    "twna": {
      "source_hash": "e5cccafd5b38",
      "text": "솔직히 오늘 기사엔 대만이 없어서 안 끼워요."
    },
    "vgq2": {
      "source_hash": "9d3f8214297a",
      "text": "보이는 연결 고리는 메모리예요."
    },
    "o8a8": {
      "source_hash": "90fd73198628",
      "text": "The Verge는 AI 데이터센터가 세계 메모리를 사들여 품귀가 나고, 기기값도 오른대요."
    },
    "upfl": {
      "source_hash": "bb683a4632c0",
      "text": "컴퓨터 살 때도요?"
    },
    "28yk": {
      "source_hash": "0d885d5afe6f",
      "text": "The Verge는 품귀로 PC에 메모리를 많이 달기 어려워졌대요."
    },
    "bbfv": {
      "source_hash": "1d832626f4ec",
      "text": "얼마나 갈까요? 인텔은 최소 내년까지,"
    },
    "yb2l": {
      "source_hash": "9eebf6686cd4",
      "text": "메모리사 SK하이닉스는 2030년까지 본대요."
    },
    "rq0j": {
      "source_hash": "260a541738d2",
      "text": "미국이 덜 지으면 메모리가 싸져요?"
    },
    "omt0": {
      "source_hash": "3f49328cc98e",
      "text": "출처에 없어서 추측 안 해요. 아시아 공급망 영향도 오늘은 답이 없어요."
    },
    "awwt": {
      "source_hash": "29e744072d82",
      "text": "볼 건 세 가지예요."
    },
    "9dal": {
      "source_hash": "3dc97f852a34",
      "text": "첫째, 구속력 있는 투표와 의사 표시를 가려요."
    },
    "zm5l": {
      "source_hash": "cbe3b51cec7e",
      "text": "둘째는요?"
    },
    "v8ir": {
      "source_hash": "5dc8bb00be3c",
      "text": "셋째, 전기요금, 물, 세제 혜택을 누가 대는지요."
    },
    "1os9": {
      "source_hash": "342c898fc9d9",
      "text": "언제쯤요?"
    },
    "2a7u": {
      "source_hash": "94f681f43dbe",
      "text": "정책은 입법·집행에 달렸고, The Verge는 일정을 안 냈어요."
    },
    "kspt": {
      "source_hash": "c572841e834e",
      "text": "다음은 2028년 대선이에요."
    },
    "7m2b": {
      "source_hash": "c85e8f1551e8",
      "text": "아까 OpenAI 글 얘기요?"
    },
    "yqj3": {
      "source_hash": "9a5ba7544622",
      "text": "네. TechCrunch는 유권자가 전기요금과 일자리 대체를 걱정하면 AI가 더 큰 쟁점이 된대요."
    },
    "bbtv": {
      "source_hash": "9290e5761fee",
      "text": "다시 Janesville 투표용지예요. 땅과 건물 하나를 물었죠."
    },
    "z2uw": {
      "source_hash": "7e6ac2215348",
      "text": "그런 투표용지가 한 장이 아니죠."
    },
    "dum4": {
      "source_hash": "dfd04ce2949c",
      "text": "네. 아까 그 29곳을 합치면, AI 인프라가 투표용지 위 문제가 된 거예요."
    },
    "tlgt": {
      "source_hash": "4998f950e2d6",
      "text": "유권자는 표로 말했어요. 업계와 비판자는요?"
    },
    "mg2t": {
      "source_hash": "47a3c1a44dd9",
      "text": "원문 기사 속 실제 발언 셋을 골랐어요."
    },
    "lbw1": {
      "source_hash": "f3a8878e57d9",
      "text": "지난달 블랙록 CEO 말부터요."
    },
    "k97z": {
      "source_hash": "90cda5277af3",
      "text": "이 나라가 유예령 같은 걸 시행하면 우리는 경기 침체에 빠질 거라고 했어요."
    },
    "n22p": {
      "source_hash": "212026c651b4",
      "text": "세네요. 둘째는요?"
    },
    "wvgr": {
      "source_hash": "12ad4b11f01c",
      "text": "AI Now Brennan은 OpenAI 글을,"
    },
    "sy2z": {
      "source_hash": "f119b897175d",
      "text": "좋게 말해 역사를 무시했고, 나쁘게 말해 해롭다고 했어요."
    },
    "fx7i": {
      "source_hash": "c0769ed80cd5",
      "text": "왜요?"
    },
    "ymgf": {
      "source_hash": "e90e4cc99c1f",
      "text": "사기업이 자기 이익을 위해 정책을 주장한다고 봤어요."
    },
    "atwo": {
      "source_hash": "5521bebd357b",
      "text": "셋째요?"
    },
    "syf4": {
      "source_hash": "85a70dc98bf0",
      "text": "신호 숫자 얘기예요. Uber CEO는 아직 아주, 아주 초기래요."
    },
    "8tfq": {
      "source_hash": "5be67558a89c",
      "text": "Uber가 어느 한 업체에도 의존하지 않게 하겠대요."
    },
    "sqnb": {
      "source_hash": "45183799c363",
      "text": "Uber는 이르대지만, 에이전트가 돈에 닿자 은행은 벌써 긴장했죠."
    },
    "s9lu": {
      "source_hash": "1339a2b3dc5c",
      "text": "감독 기관까지 나섰어요?"
    },
    "jg1n": {
      "source_hash": "72e23d2ff444",
      "text": "네. Decrypt에 따르면 미국 통화감독청 OCC가 어제 첫 은행권 AI 감독 틀을 냈어요."
    },
    "8icx": {
      "source_hash": "0919ae6048e1",
      "text": "통화감독청은 뭘 감독해요?"
    },
    "zrmc": {
      "source_hash": "97125717a740",
      "text": "은행이요. 22쪽짜리 이 틀은 검사관, 곧 은행의 AI 활용을 평가하는 사람을 위한 거예요."
    },
    "qev6": {
      "source_hash": "9b7be0e1e204",
      "text": "뭘 봐요?"
    },
    "o5cu": {
      "source_hash": "01bc0b2bf172",
      "text": "AI 성능이 아니라 세 가지예요. 잘못됐을 때의 결과,"
    },
    "w7us": {
      "source_hash": "b967e67894c8",
      "text": "되돌릴 수 있나,"
    },
    "oqrx": {
      "source_hash": "b162583efe6e",
      "text": "사람이 통제권을 얼마나 쥐는지요."
    },
    "mt7a": {
      "source_hash": "ad39ec45bb5b",
      "text": "최고 위험은 완전 자율 결제 에이전트와 실시간 신용 결정 시스템이에요."
    },
    "vory": {
      "source_hash": "a207d9e8e749",
      "text": "아주 센 모델보다 더 위험해요?"
    },
    "ofxn": {
      "source_hash": "72c72252ed6b",
      "text": "네. OCC는 거래를 시작하는 단순한 에이전트가 내부 문서만 쓰는 고급 모델보다 위험할 수 있대요."
    },
    "8o1z": {
      "source_hash": "fb38555833da",
      "text": "대책은요?"
    },
    "x0l1": {
      "source_hash": "bb5f86a0a196",
      "text": "보호책은 문제가 나면 멈추는 차단기가 있고,"
    },
    "3wb1": {
      "source_hash": "3e1b0cea15e9",
      "text": "두꺼비집이요?"
    },
    "61wf": {
      "source_hash": "78680a8ea672",
      "text": "네. 일정 시간 내 동작 횟수 제한,"
    },
    "8vru": {
      "source_hash": "3d3b93397959",
      "text": "권한 축소, 그리고 긴급 정지예요."
    },
    "yqdl": {
      "source_hash": "757cdac20bb3",
      "text": "배경은 Decrypt 인용 Axios로, 은행들이 고객 계좌에서 무단 외부 AI 에이전트를 찾았대요."
    },
    "9dp7": {
      "source_hash": "8ca04b4a6ae1",
      "text": "진짜 무섭네요."
    },
    "tvdn": {
      "source_hash": "4ac5f27193e5",
      "text": "모건스탠리는 외부 에이전트를 막고, JP모건·뱅크오브아메리카·씨티는 제한해요."
    },
    "5l7f": {
      "source_hash": "969392ad6b01",
      "text": "다만 OCC는 이 틀을 그 사건들과 직접 잇진 않았어요."
    },
    "iref": {
      "source_hash": "364f6c82a0f5",
      "text": "당장 따라야 해요?"
    },
    "c2tl": {
      "source_hash": "48b49216ecfd",
      "text": "아니요. OCC는 새 규정이 아니고, 기존 위험 범주로 AI를 보게 한대요."
    },
    "7m5u": {
      "source_hash": "2e52d7cf597c",
      "text": "그럼 지침이네요."
    },
    "xk39": {
      "source_hash": "fabef50f10de",
      "text": "표에서 월가로. Decrypt는 모건스탠리가 화요일,"
    },
    "suq6": {
      "source_hash": "65efb78ca909",
      "text": "DTCC 새 서비스로 미국 주식과 국채를 블록체인 토큰으로 바꿨대요."
    },
    "gyam": {
      "source_hash": "28c0f6f1cefb",
      "text": "DTCC는요?"
    },
    "ftzx": {
      "source_hash": "08bf5dd00421",
      "text": "미국 예탁결제 회사예요. 자회사 DTC는 체결 후 보관과 결제를 맡고, 114조 달러 넘게 보관해요."
    },
    "2s5d": {
      "source_hash": "f17adde2cc8a",
      "text": "토큰이면 권리가 바뀌어요?"
    },
    "jk7p": {
      "source_hash": "3cc38bd12cc2",
      "text": "DTCC는 아니래요. 토큰도 원래 증권과 소유권·투자자 보호가 같고 되돌릴 수 있대요."
    },
    "q4cl": {
      "source_hash": "27e3f63f387c",
      "text": "일반인도 돼요?"
    },
    "lwdi": {
      "source_hash": "b044a98009a7",
      "text": "아직요. 자격 있는 금융기관 대상이고, 뱅크오브아메리카, 씨티, JP모건 등 20곳이 신청했어요."
    },
    "r6no": {
      "source_hash": "f2389a517645",
      "text": "Decrypt는 은행 주도 방식이라, 코인 업체의 토큰화 주식과 다르대요."
    },
    "pdn6": {
      "source_hash": "e641c2063a51",
      "text": "월가가 직접 나선 거네요."
    },
    "7zu7": {
      "source_hash": "2344d42fe2e7",
      "text": "돈은 토큰으로 가고, 감원도 있죠."
    },
    "t7ie": {
      "source_hash": "597e98dca161",
      "text": "Decrypt에 따르면 USDC 발행사 Circle이 3분기 실적에서 직원 약 5% 감원을 밝혔어요."
    },
    "drw6": {
      "source_hash": "180aac2a1614",
      "text": "적자예요?"
    },
    "to9e": {
      "source_hash": "22c71eb93210",
      "text": "흑자고, 순익이 작년보다 5% 늘었어요."
    },
    "oaq5": {
      "source_hash": "a581a2b4417a",
      "text": "하지만 최대 수입원인 USDC 준비자산 이자가 금리 하락으로 8% 줄었어요."
    },
    "d2yl": {
      "source_hash": "135b6d34ec4e",
      "text": "돈 벌면서도 감원하네요."
    },
    "elrc": {
      "source_hash": "687ea61db22c",
      "text": "Circle은 조직을 운영 모델과 전략 중점에 맞추려 했다지만, 몇 명, 어느 팀인지는 안 밝혔어요."
    },
    "5sy1": {
      "source_hash": "d6b14bafd716",
      "text": "혼자만 감원해요?"
    },
    "7kus": {
      "source_hash": "4773960d3617",
      "text": "아니요. Decrypt는 올해 Coinbase, 이더리움 재단 등 코인 기업도 감원했대요. 이유는 시장 약세, AI, 또는 둘 다예요."
    },
    "8i38": {
      "source_hash": "68c37725a2f7",
      "text": "보안 얘기 하나 더요."
    },
    "952e": {
      "source_hash": "ee18d9d06e22",
      "text": "Coinbase는 어제, 지난주 Binance 해킹 피해가 없대요."
    },
    "5zbr": {
      "source_hash": "68b6c72a1100",
      "text": "왜 더 안전하대요?"
    },
    "4dbk": {
      "source_hash": "54b6c11e8a5d",
      "text": "고객 자산 99% 넘게 인터넷과 끊긴 콜드 스토리지에 둔대요."
    },
    "8w63": {
      "source_hash": "96e965d4f31f",
      "text": "개인 키는 쪼개서, 서명 때도 다 합치지 않고,"
    },
    "0eaj": {
      "source_hash": "bd6166bbfeec",
      "text": "출금이 갑자기 몰리면 먼저 보류하고 사람이 심사해요."
    },
    "2bi8": {
      "source_hash": "ed26515795b3",
      "text": "Coinbase는 완벽해요?"
    },
    "dp9t": {
      "source_hash": "291edff86a95",
      "text": "단정 못 해요. Coinbase 주장을 Decrypt가 전한 거지, 외부 평가가 아니에요."
    },
    "jhpv": {
      "source_hash": "3c3fa671d4d1",
      "text": "일반인에겐요?"
    },
    "7duu": {
      "source_hash": "e3457f173ace",
      "text": "AI 에이전트가 돈을 다루는 규칙이 생기고, 일자리도 재편 중이에요. 참고로 이 코너는 가격을 안 다뤄요."
    },
    "5eze": {
      "source_hash": "4732fb9fd606",
      "text": "실용적으로 가요. 오늘 뭘 할 수 있어요?"
    },
    "bcyl": {
      "source_hash": "f3f4bd107069",
      "text": "셋 다 저희 제안이지, Apple·Conductor·은행 지시가 아니에요."
    },
    "8ijm": {
      "source_hash": "cb0636364237",
      "text": "첫째, 저희 조언은, 녹음하고 요약하는 AI 기능은 언제 듣는지부터 확인하라는 거예요."
    },
    "bxwm": {
      "source_hash": "d907c32899db",
      "text": "TechCrunch 기자처럼 밤엔 꺼 두라고요?"
    },
    "12sb": {
      "source_hash": "a0dde22849b6",
      "text": "네. 집에서 사적인 얘기를 할 땐 꺼 두길 권해요. 주변 사람에게도 미리 말하세요."
    },
    "e3d0": {
      "source_hash": "3d3c664307a9",
      "text": "둘째, Conductor 클라우드 사용자라면, 종료일 기억나요?"
    },
    "9nmu": {
      "source_hash": "11381dfcc8be",
      "text": "그 전에 남길 걸 저장하길 권해요."
    },
    "dll5": {
      "source_hash": "202b2cba22a7",
      "text": "그 뒤엔 지워져서요?"
    },
    "sope": {
      "source_hash": "3bd891963196",
      "text": "네, 그러니 20일 전에 남길 걸 저장하세요."
    },
    "2grf": {
      "source_hash": "75942d624a64",
      "text": "셋째, 저희 조언은, AI 도구가 계좌에 닿기 전에 한도와 권한 회수가 되는지 보라는 거예요."
    },
    "g105": {
      "source_hash": "f8bee33a6ecd",
      "text": "OCC 생각이랑 같네요."
    },
    "b3nx": {
      "source_hash": "1832a81bf3b7",
      "text": "돈 얘기 끝, 황당한 오늘의 잡음이에요. 다들 개표 볼 때 Sam Altman은 뭐 했을까요?"
    },
    "rjvu": {
      "source_hash": "31c66180fcbf",
      "text": "X에서 메모리로 다퉜어요."
    },
    "6r21": {
      "source_hash": "d31a5227e002",
      "text": "컴퓨터 메모리 발언을 변호했대요."
    },
    "dtpn": {
      "source_hash": "aba4c81838f4",
      "text": "뭐라 했는데요?"
    },
    "5ivw": {
      "source_hash": "f30eb607563e",
      "text": "한 인터뷰 프로그램에서, 한정된 메모리를 각자 컴퓨터에 두고 5% 시간만 쓰는 건 꽤 나쁘다고 했어요."
    },
    "efw5": {
      "source_hash": "f92888ae009a",
      "text": "그래서요?"
    },
    "ynxd": {
      "source_hash": "11d595ea82c0",
      "text": "그 뒤 맥락이 잘렸다며 한 네티즌에게 답했어요. 메모리 많이 갖길, 더 지을게요."
    },
    "u1h0": {
      "source_hash": "c2526c508feb",
      "text": "메모리는 데이터센터가 쓸어 간다면서요?"
    },
    "ec2i": {
      "source_hash": "d7081c014009",
      "text": "맞아요. 다툼은 잡음이지만, 그 뒤 품귀는 진짜예요."
    },
    "hpwf": {
      "source_hash": "c47f33c972db",
      "text": "네, 이 잡음은 듣고 넘겨요."
    },
    "1bip": {
      "source_hash": "c552267040d8",
      "text": "제 생각엔 오늘 가장 중요한 건 이번 선거 속 데이터센터예요."
    },
    "5nzz": {
      "source_hash": "9bd165d2f3dc",
      "text": "왜 데이터센터예요?"
    },
    "ctww": {
      "source_hash": "9952e41135b4",
      "text": "AI는 앱만이 아니라 건물이 있고 전기를 써요. 그 옆 사람들이 표로 말하기 시작했어요."
    },
    "me8s": {
      "source_hash": "e90795197d22",
      "text": "업계와 OpenAI도 대응 중이죠."
    },
    "gzox": {
      "source_hash": "c83d65fdafcd",
      "text": "데이터센터가 정말 더디게 지어질까요?"
    },
    "txb8": {
      "source_hash": "d54a6301a7bb",
      "text": "솔직히 모르겠어요. 많은 투표가 의사 표시고 인과도 따지기 어려워요. 다음 입법을 봐야죠."
    },
    "qftg": {
      "source_hash": "905b97d09a53",
      "text": "주제 정리는 Mokaair에, 링크는 설명란에요."
    },
    "qans": {
      "source_hash": "d3d30674ac29",
      "text": "답은, 전기요금, 물, 소음이 클라우드 AI를 집 앞까지 끌어왔다는 거예요."
    },
    "0vcg": {
      "source_hash": "45f44e810fda",
      "text": "집 근처면 찬성해요? 댓글 주세요."
    },
    "xdv3": {
      "source_hash": "9c804c0c9860",
      "text": "Tech Signal 구독! 신호 수신."
    }
  }
}
