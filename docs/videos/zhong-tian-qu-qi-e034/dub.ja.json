{
  "zq34a01": {
    "text": "ははははは！",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "これがお前の水車か？",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "お兄ちゃん、逆に回ってる。",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "逆……",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "羽根板の角度が、",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "流れと逆なんだ。",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "裏返せば、回る。",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "十二枚、",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "日没までに終わるか？",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "干ばつ任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "本日日没で期限。",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "チン・シュアン、",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "三班で、二時間。",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "一班、水へ！",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "二班、板を担げ！",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "四枚目！",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "八枚目。",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "十二枚、",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "終わった！",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "ハン爺さん、水門を。",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "回って……",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "回った！",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "水……",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "水が来た！",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "シュー先生。",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "みんな立って、",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "跪くな！",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "わしの……堰が……",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "旦那、",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "その堰で足でも洗いな。",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "干ばつ任務、完了。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "稲の種、確保。",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "お水だよ。",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "お兄ちゃん、ちゃんと回った！",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "笑った。",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "笑ってない。",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "お兄ちゃん……",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "北。",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "風が冷たい。",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "イナ……",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "イナゴだ！",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "シャオホー、つかまれ。",
    "emotion": "壓低聲音"
  }
}
