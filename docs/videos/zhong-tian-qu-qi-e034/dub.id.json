{
  "zq34a01": {
    "text": "Hahahaha!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "Ini kincir airmu?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "Kak, muternya kebalik.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "Kebalik…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "Sudut bilahnya,",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "lawan arus.",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "Dibalik, pasti muter.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "Dua belas bilah,",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "beres sebelum senja?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "Misi kekeringan:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "jatuh tempo senja ini.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "Qin Shuang,",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "tiga regu, dua jam.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "Regu satu, turun!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "Regu dua, papan!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "Empat!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "Delapan.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "Dua belas,",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "beres!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "Kakek Han, buka.",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "Muter…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "Muter!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "Air…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "Airnya naik!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "Tuan Xu.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "Bangun semua,",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "jangan berlutut!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "Bendungan… ku…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "Tuan Qian,",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "bendunganmu buat cuci kaki aja.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "Misi kekeringan selesai.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "Benih padi aman.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "Minum.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "Kak, muternya bener!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "Kamu senyum.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "Nggak.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "Kak…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "Utara.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "Anginnya dingin.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "Be…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "Belalang!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "Xiaohe, pegangan erat.",
    "emotion": "壓低聲音"
  }
}
