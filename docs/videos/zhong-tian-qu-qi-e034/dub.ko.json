{
  "zq34a01": {
    "text": "하하하하!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "이게 네 수차냐?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "오빠, 거꾸로 돌아.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "거꾸로…",
    "say": "반대…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "날개판 각도가,",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "물살이랑 반대야.",
    "say": "물과 반대.",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "뒤집으면, 돌아.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "열두 장,",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "해 지기 전에 되겠나?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "가뭄 임무:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "오늘 일몰 만료.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "친솽,",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "세 조, 한 시진.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "1조, 입수!",
    "say": "일 조, 입수!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "2조, 판 날라!",
    "say": "이 조, 판 날라!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "네 장!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "여덟 장.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "열두 장,",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "다 뒤집었어!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "한 어르신, 수문을.",
    "say": "어르신, 수문!",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "돌아라…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "돈다!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "물…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "물이 올라온다!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "쉬 선생.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "다들 일어나,",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "꿇지 마!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "내… 둑…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "나리,",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "그 둑은 발이나 씻으시지.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "가뭄 임무 완료.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "볍씨 확보.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "물 마셔.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "오빠, 이제 제대로 돌아!",
    "say": "오빠, 제대로 돌아!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "웃었네.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "아니.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "오빠…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "북쪽.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "바람이 차.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "메…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "메뚜기다!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "샤오허, 꽉 잡아.",
    "emotion": "壓低聲音"
  }
}
