{
  "zq34a01": {
    "text": "¡Ja, ja, ja, ja!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "¿Esta es tu noria?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "Hermano, gira al revés.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "Al revés…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "El ángulo de las paletas,",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "va contra el agua.",
    "say": "contra el agua.",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "Si las volteo, gira.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "Doce paletas,",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "¿antes del atardecer?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "Misión sequía:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "vence hoy al atardecer.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "Qin Shuang,",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "tres turnos, dos horas.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "¡Turno uno, al agua!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "¡Turno dos, tablas!",
    "say": "¡Dos, tablas!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "¡Cuatro!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "Ocho.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "Doce,",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "¡listo!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "Anciano Han, abra.",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "Gira…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "¡Gira!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "Agua…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "¡Llegó el agua!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "Señor Xu.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "Levántense,",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "¡no se hinquen!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "Mi… presa…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "Don Qian,",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "usa tu presa para lavarte los pies.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "Misión sequía: cumplida.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "Semillas a salvo.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "Toma agua.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "¡Hermano, ya gira bien!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "Sonreíste.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "No.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "Hermano…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "Al norte.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "El viento está frío.",
    "say": "Viento frío.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "Lan…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "¡Langostas!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "Xiaohe, agárrate.",
    "emotion": "壓低聲音"
  }
}
