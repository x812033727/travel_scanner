{
  "zq34a01": {
    "text": "Ha ha ha ha!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "Đây là guồng nước của ngươi à?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "Ca, nó quay ngược rồi.",
    "say": "Ca nó quay ngược rồi.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "Quay ngược…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "Góc cánh guồng,",
    "say": "Góc cánh guồng",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "ngược dòng nước.",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "Lật lại, nó sẽ quay.",
    "say": "Lật lại là quay.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "Mười hai cánh,",
    "say": "Mười hai cánh",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "kịp trước khi trời lặn?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "Nhiệm vụ hạn hán:",
    "say": "Nhiệm vụ hạn hán",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "hết hạn lúc mặt trời lặn.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "Tần Sương,",
    "say": "Tần Sương",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "ba ca, một canh giờ.",
    "say": "ba ca một canh giờ.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "Ca một xuống nước!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "Ca hai khiêng ván!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "Bốn!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "Tám.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "Mười hai,",
    "say": "Mười hai",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "xong rồi!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "Hàn bá, mở cống.",
    "say": "Hàn bá mở cống.",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "Quay đi…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "Quay rồi!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "Nước…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "Nước lên rồi!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "Hứa tiên sinh.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "Đứng dậy cả đi,",
    "say": "Đứng dậy cả đi",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "đừng quỳ!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "Đập… của ta…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "Viên ngoại,",
    "say": "Viên ngoại",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "đập của ông giữ lại rửa chân đi.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "Nhiệm vụ hạn hán hoàn thành.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "Giống lúa giữ được.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "Uống nước nè.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "Ca, nó quay đúng rồi!",
    "say": "Ca nó quay đúng rồi!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "Ngươi cười kìa.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "Không có.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "Ca…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "Phía bắc.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "Gió lạnh.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "Châu…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "Châu chấu!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "Tiểu Hòa, bám chặt.",
    "say": "Tiểu Hòa bám chặt.",
    "emotion": "壓低聲音"
  }
}
