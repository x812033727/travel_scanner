{
  "zq34a01": {
    "text": "Hahahaha!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "Essa é a sua roda d'água?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "Mano, gira ao contrário.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "Ao contrário…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "O ângulo das pás,",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "tá contra a água.",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "Vira elas, que gira.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "Doze pás,",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "até o pôr do sol?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "Missão da seca:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "vence hoje ao pôr do sol.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "Qin Shuang,",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "três turnos, duas horas.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "Turno um, pra água!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "Turno dois, tábuas!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "Quatro!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "Oito.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "Doze,",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "pronto!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "Ancião Han, abra.",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "Gira…",
    "say": "Gira…",
    "emotion": "小小聲"
  },
  "zq34a22": {
    "text": "Girou!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "Água…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "A água chegou!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "Mestre Xu.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "Levantem,",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "sem ajoelhar!",
    "say": "não ajoelha!",
    "emotion": "喊"
  },
  "zq34a28": {
    "text": "Minha… represa…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "Senhor Qian,",
    "say": "Seu Qian,",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "guarda a represa pra lavar o pé.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "Missão da seca: concluída.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "Sementes salvas.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "Bebe água.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "Mano, agora gira certo!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "Você sorriu.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "Não.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "Mano…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "O norte.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "O vento tá frio.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "Ga…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "Gafanhotos!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "Xiaohe, segura firme.",
    "emotion": "壓低聲音"
  }
}
