{
  "zq34a01": {
    "text": "ฮ่าฮ่าฮ่าฮ่า!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "นี่หรือกังหันน้ำของเจ้า?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "พี่ มันหมุนกลับด้าน",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "กลับด้าน…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "มุมของใบพัด",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "สวนทางกับน้ำ",
    "emotion": "一拍葉板"
  },
  "zq34a07": {
    "text": "พลิกกลับ มันก็หมุน",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "สิบสองใบ",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "ทันก่อนตะวันตกดินหรือ?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "ภารกิจภัยแล้ง:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "ครบกำหนดตะวันตกดิน",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "ฉินซวง",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "สามกะ หนึ่งชั่วยาม",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "กะหนึ่ง ลงน้ำ!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "กะสอง แบกแผ่น!",
    "emotion": "俐落"
  },
  "zq34a16": {
    "text": "สี่!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "แปด",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "สิบสองใบ",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "เสร็จแล้ว!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "ลุงหาน เปิดประตูน้ำ",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "หมุนสิ…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "หมุนแล้ว!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "น้ำ…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "น้ำมาแล้ว!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "ท่านสวี่",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "ลุกขึ้นทุกคน",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "อย่าคุกเข่า!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "เขื่อน…ของข้า…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "เศรษฐี",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "เขื่อนเจ้า เก็บไว้ล้างเท้าเถอะ",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "ภารกิจภัยแล้งสำเร็จ",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "พันธุ์ข้าวรอดแล้ว",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "ดื่มน้ำนะ",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "พี่ มันหมุนถูกแล้ว!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "เจ้ายิ้ม",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "เปล่า",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "พี่…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "ทางเหนือ",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "ลมมันเย็น",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "ตั๊ก…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "ตั๊กแตน!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "เสี่ยวเหอ จับแน่นๆ",
    "emotion": "壓低聲音"
  }
}
