{
  "zq34a01": {
    "text": "Hahahaha!",
    "emotion": "放聲大笑，笑聲還沒停"
  },
  "zq34a02": {
    "text": "This is your waterwheel?",
    "emotion": "油滑，拖長音"
  },
  "zq34a03": {
    "text": "Brother, it's turning backward.",
    "emotion": "鼓起臉，奶聲奶氣"
  },
  "zq34a04": {
    "text": "Backward…",
    "emotion": "畫外，愣住"
  },
  "zq34a05": {
    "text": "The blade angle,",
    "emotion": "想通了"
  },
  "zq34a06": {
    "text": "is against the current.",
    "emotion": "一拍葉板",
    "say": "against the flow."
  },
  "zq34a07": {
    "text": "Flip them, and it'll turn.",
    "emotion": "畫外，很篤定"
  },
  "zq34a08": {
    "text": "Twelve blades,",
    "emotion": "慢，句句篤定"
  },
  "zq34a09": {
    "text": "all done by sunset?",
    "emotion": "擔心"
  },
  "zq34a10": {
    "text": "Drought mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a11": {
    "text": "expires at sunset today.",
    "emotion": "平板電子音，冷"
  },
  "zq34a12": {
    "text": "Qin Shuang,",
    "emotion": "轉身"
  },
  "zq34a13": {
    "text": "three shifts, two hours.",
    "emotion": "下令"
  },
  "zq34a14": {
    "text": "Shift one, into the water!",
    "emotion": "颯爽，嗓門大"
  },
  "zq34a15": {
    "text": "Shift two, grab the boards!",
    "emotion": "俐落",
    "say": "Shift two, boards!"
  },
  "zq34a16": {
    "text": "Four!",
    "emotion": "畫外，數著"
  },
  "zq34a17": {
    "text": "Eight.",
    "emotion": "冷冷地數"
  },
  "zq34a18": {
    "text": "Twelve,",
    "emotion": "喘著"
  },
  "zq34a19": {
    "text": "all flipped!",
    "emotion": "爽快"
  },
  "zq34a20": {
    "text": "Elder Han, open the gate.",
    "emotion": "把手讓給他"
  },
  "zq34a21": {
    "text": "Turn…",
    "emotion": "屏住呼吸，小小聲"
  },
  "zq34a22": {
    "text": "It's turning!",
    "emotion": "大吼，爽"
  },
  "zq34a23": {
    "text": "Water…",
    "emotion": "跪下，聲音發抖"
  },
  "zq34a24": {
    "text": "The water's coming!",
    "emotion": "哭出來"
  },
  "zq34a25": {
    "text": "Mr. Xu.",
    "emotion": "第一次這麼叫他，很重"
  },
  "zq34a26": {
    "text": "Up, everyone,",
    "emotion": "受不起，急"
  },
  "zq34a27": {
    "text": "don't kneel!",
    "emotion": "笑著喊"
  },
  "zq34a28": {
    "text": "My… dam…",
    "emotion": "笑凍住，擠出來的"
  },
  "zq34a29": {
    "text": "Squire,",
    "emotion": "笑著"
  },
  "zq34a30": {
    "text": "keep your dam for washing your feet.",
    "emotion": "不屑"
  },
  "zq34a31": {
    "text": "Drought mission complete.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq34a32": {
    "text": "Rice seed saved.",
    "emotion": "平板電子音"
  },
  "zq34a33": {
    "text": "Drink up.",
    "emotion": "畫外，奶聲奶氣"
  },
  "zq34a34": {
    "text": "Brother, now it turns right!",
    "emotion": "得意，缺牙的笑"
  },
  "zq34a35": {
    "text": "You smiled.",
    "emotion": "側頭，笑著戳她"
  },
  "zq34a36": {
    "text": "Did not.",
    "emotion": "冷冷的，嘴角卻動了"
  },
  "zq34a37": {
    "text": "Brother…",
    "emotion": "笑容沒了"
  },
  "zq34a38": {
    "text": "North.",
    "emotion": "小小聲"
  },
  "zq34a39": {
    "text": "The wind's cold.",
    "emotion": "很輕，警覺"
  },
  "zq34a40": {
    "text": "Lo…",
    "emotion": "聲音發抖"
  },
  "zq34a41": {
    "text": "Locusts!",
    "emotion": "大喊"
  },
  "zq34a42": {
    "text": "Xiaohe, hold on tight.",
    "emotion": "壓低聲音"
  }
}
