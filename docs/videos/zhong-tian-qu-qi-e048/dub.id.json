{
  "zq48a01": {
    "text": "Cukup Penguji Feng saja.",
    "emotion": "平靜，做了決定",
    "say": "Feng saja."
  },
  "zq48a02": {
    "text": "Yang ini,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ini,"
  },
  "zq48a03": {
    "text": "saya simpan.",
    "emotion": "嘴角一勾"
  },
  "zq48a04": {
    "text": "Anak muda,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq48a05": {
    "text": "kau tenang sekali.",
    "emotion": "難得一笑",
    "say": "kau tenang."
  },
  "zq48a06": {
    "text": "Tuan,",
    "emotion": "笑"
  },
  "zq48a07": {
    "text": "juga begitu.",
    "emotion": "拱手"
  },
  "zq48a08": {
    "text": "Daftarnya,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Daftar,"
  },
  "zq48a09": {
    "text": "sudah dikirim.",
    "emotion": "背過身"
  },
  "zq48a10": {
    "text": "Bisa diubah kembali atau tidak,",
    "emotion": "畫外，慢",
    "say": "Kembali atau tidak,"
  },
  "zq48a11": {
    "text": "besok kita tahu.",
    "emotion": "畫外",
    "say": "besok ketahuan."
  },
  "zq48a12": {
    "text": "Kau tidak menuntut keluarga Wei?",
    "emotion": "壓低聲音，急",
    "say": "Wei tak kau tuntut?"
  },
  "zq48a13": {
    "text": "Kalau menuntut sekarang,",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "Sekarang,"
  },
  "zq48a14": {
    "text": "kita yang mati terseret.",
    "emotion": "冷靜，快，說完就停",
    "say": "kita yang terseret."
  },
  "zq48a15": {
    "text": "Kertas ini,",
    "emotion": "快，說完就停"
  },
  "zq48a16": {
    "text": "disimpan sampai paling berharga.",
    "emotion": "笑了",
    "say": "tunggu harga tertinggi."
  },
  "zq48a17": {
    "text": "Tanpa keluar modal,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "Tanpa modal,"
  },
  "zq48a18": {
    "text": "bunga berbunga.",
    "emotion": "甜，快，說完就停"
  },
  "zq48a19": {
    "text": "Tapi,",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "bunganya tiga puluh persen buatku.",
    "emotion": "伸出三根手指",
    "say": "tiga puluh persen buatku."
  },
  "zq48a21": {
    "text": "Poin suka Tang Xiaotang,",
    "emotion": "平板電子音，叮一聲",
    "say": "Tang Xiaotang,"
  },
  "zq48a22": {
    "text": "lima puluh dua.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "Jenderal Muda,",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "ada kabar.",
    "emotion": "粗啞，快，說完就停"
  },
  "zq48a25": {
    "text": "Katakan.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "Jenderal masih hidup,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "di tambang garam perbatasan utara.",
    "emotion": "一字一字",
    "say": "di tambang garam utara."
  },
  "zq48a28": {
    "text": "Siapa…?",
    "emotion": "發抖，極短促，不拖音",
    "say": "Siapa?"
  },
  "zq48a29": {
    "text": "siapa yang lihat?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "Kepala reguku dulu,",
    "emotion": "粗啞，極短促，說完就停",
    "say": "Kepala reguku,"
  },
  "zq48a31": {
    "text": "melihat dengan mata sendiri.",
    "emotion": "篤定，快，說完就停",
    "say": "lihat sendiri."
  },
  "zq48a32": {
    "text": "Tuan Muda Xu yang menyuruhku",
    "emotion": "粗啞，快，說完就停",
    "say": "Tuan Xu menyuruhku"
  },
  "zq48a33": {
    "text": "menanyakannya.",
    "emotion": "粗啞",
    "say": "bertanya."
  },
  "zq48a34": {
    "text": "Tiga tahun,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "kukira dia…",
    "emotion": "哽住，極短促，說完就停",
    "say": "kukira…"
  },
  "zq48a36": {
    "text": "Kau tak bisa",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "bilang sesuatu?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "…Manis.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "Poin suka Qin Shuang,",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang,"
  },
  "zq48a40": {
    "text": "lima puluh lima.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "Si marga Qin itu,",
    "emotion": "壓低聲音，討好",
    "say": "Si Qin itu,"
  },
  "zq48a42": {
    "text": "putri Qin Lieshan.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "Kabarnya pasti?",
    "emotion": "慢條斯理",
    "say": "Pasti?"
  },
  "zq48a44": {
    "text": "Saya dengar sendiri.",
    "emotion": "眼睛不看人"
  },
  "zq48a45": {
    "text": "Keluarga Wei",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Wei"
  },
  "zq48a46": {
    "text": "mencatat jasamu.",
    "emotion": "居高臨下",
    "say": "ingat jasamu."
  },
  "zq48a47": {
    "text": "Gadis keluarga Qin itu,",
    "emotion": "低聲，快，說完就停",
    "say": "Gadis Qin itu,"
  },
  "zq48a48": {
    "text": "Tuan Muda pasti senang.",
    "emotion": "低聲，快，說完就停",
    "say": "Tuan Muda senang."
  }
}
