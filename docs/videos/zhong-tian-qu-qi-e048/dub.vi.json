{
  "zq48a01": {
    "text": "Chỉ xử Phùng học chính.",
    "emotion": "平靜，做了決定",
    "say": "Chỉ xử họ Phùng."
  },
  "zq48a02": {
    "text": "Tờ này,",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "tôi giữ lại.",
    "emotion": "嘴角一勾"
  },
  "zq48a04": {
    "text": "Hậu sinh,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq48a05": {
    "text": "giữ được bình tĩnh.",
    "emotion": "難得一笑",
    "say": "trầm tĩnh lắm."
  },
  "zq48a06": {
    "text": "Đại nhân,",
    "emotion": "笑"
  },
  "zq48a07": {
    "text": "cũng vậy.",
    "emotion": "拱手"
  },
  "zq48a08": {
    "text": "Bảng,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq48a09": {
    "text": "đã gửi đi rồi.",
    "emotion": "背過身"
  },
  "zq48a10": {
    "text": "Sửa lại được hay không,",
    "emotion": "畫外，慢",
    "say": "Sửa được không,"
  },
  "zq48a11": {
    "text": "mai sẽ biết.",
    "emotion": "畫外"
  },
  "zq48a12": {
    "text": "Chàng không kiện nhà họ Ngụy?",
    "emotion": "壓低聲音，急",
    "say": "Không kiện nhà Ngụy?"
  },
  "zq48a13": {
    "text": "Kiện bây giờ,",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "Giờ kiện,"
  },
  "zq48a14": {
    "text": "người bị kéo chết là chúng ta.",
    "emotion": "冷靜，快，說完就停",
    "say": "chết là chúng ta."
  },
  "zq48a15": {
    "text": "Tờ giấy này,",
    "emotion": "快，說完就停"
  },
  "zq48a16": {
    "text": "giữ đến lúc đáng giá nhất.",
    "emotion": "笑了",
    "say": "đợi lúc đắt nhất."
  },
  "zq48a17": {
    "text": "Không bỏ vốn,",
    "emotion": "眼睛一亮，快，說完就停"
  },
  "zq48a18": {
    "text": "lãi mẹ đẻ lãi con.",
    "emotion": "甜，快，說完就停",
    "say": "lãi chồng lãi."
  },
  "zq48a19": {
    "text": "Nhưng mà,",
    "emotion": "眼珠一轉",
    "say": "Nhưng,"
  },
  "zq48a20": {
    "text": "tiền lãi chia ta ba phần.",
    "emotion": "伸出三根手指",
    "say": "chia ta ba phần."
  },
  "zq48a21": {
    "text": "Đường Tiểu Đường hảo cảm,",
    "emotion": "平板電子音，叮一聲",
    "say": "Đường Tiểu Đường,"
  },
  "zq48a22": {
    "text": "năm mươi hai.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "Tiểu tướng quân,",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "có tin rồi.",
    "emotion": "粗啞，快，說完就停"
  },
  "zq48a25": {
    "text": "Nói đi.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "Tướng quân còn sống,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "ở mỏ muối Bắc Cương.",
    "emotion": "一字一字"
  },
  "zq48a28": {
    "text": "Ai…?",
    "emotion": "發抖，極短促，不拖音",
    "say": "Ai?"
  },
  "zq48a29": {
    "text": "ai đã thấy?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "Ngũ trưởng năm xưa của ta,",
    "emotion": "粗啞，極短促，說完就停",
    "say": "Ngũ trưởng cũ,"
  },
  "zq48a31": {
    "text": "tận mắt nhìn thấy.",
    "emotion": "篤定，快，說完就停",
    "say": "tận mắt thấy."
  },
  "zq48a32": {
    "text": "Là Hứa công tử nhờ ta",
    "emotion": "粗啞，快，說完就停",
    "say": "Hứa công tử nhờ ta"
  },
  "zq48a33": {
    "text": "đi hỏi.",
    "emotion": "粗啞"
  },
  "zq48a34": {
    "text": "Ba năm rồi,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "ta tưởng cha đã…",
    "emotion": "哽住，極短促，說完就停",
    "say": "ta tưởng…"
  },
  "zq48a36": {
    "text": "Ngươi không biết",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "nói một câu sao?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "…Ngọt.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "Tần Sương hảo cảm,",
    "emotion": "平板電子音，叮一聲",
    "say": "Tần Sương,"
  },
  "zq48a40": {
    "text": "năm mươi lăm.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "Con bé họ Tần đó,",
    "emotion": "壓低聲音，討好",
    "say": "Đứa họ Tần,"
  },
  "zq48a42": {
    "text": "là con gái Tần Liệt Sơn.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "Tin chắc chứ?",
    "emotion": "慢條斯理",
    "say": "Chắc chứ?"
  },
  "zq48a44": {
    "text": "Tiểu nhân tận tai nghe thấy.",
    "emotion": "眼睛不看人",
    "say": "Tận tai nghe thấy."
  },
  "zq48a45": {
    "text": "Ngụy phủ,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq48a46": {
    "text": "ghi cho ngươi một công.",
    "emotion": "居高臨下，快，說完就停",
    "say": "ghi công ngươi."
  },
  "zq48a47": {
    "text": "Con nha đầu nhà họ Tần,",
    "emotion": "低聲，快，說完就停",
    "say": "Nha đầu họ Tần,"
  },
  "zq48a48": {
    "text": "công tử sẽ vui lắm.",
    "emotion": "笑"
  }
}
