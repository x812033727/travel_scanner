{
  "zq48a01": {
    "text": "Solo al examinador Feng.",
    "emotion": "平靜，做了決定",
    "say": "Solo a Feng."
  },
  "zq48a02": {
    "text": "Este,",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "me lo quedo.",
    "emotion": "嘴角一勾"
  },
  "zq48a04": {
    "text": "Joven,",
    "emotion": "挑眉，快，說完就停"
  },
  "zq48a05": {
    "text": "tienes temple.",
    "emotion": "難得一笑"
  },
  "zq48a06": {
    "text": "Señoría,",
    "emotion": "笑",
    "say": "Señor,"
  },
  "zq48a07": {
    "text": "usted también.",
    "emotion": "拱手",
    "say": "y usted."
  },
  "zq48a08": {
    "text": "La lista,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lista,"
  },
  "zq48a09": {
    "text": "ya salió.",
    "emotion": "背過身"
  },
  "zq48a10": {
    "text": "Si se puede corregir,",
    "emotion": "畫外，慢",
    "say": "Si se corrige,"
  },
  "zq48a11": {
    "text": "lo sabremos mañana.",
    "emotion": "畫外",
    "say": "mañana se sabrá."
  },
  "zq48a12": {
    "text": "¿No acusaste a los Wei?",
    "emotion": "壓低聲音，急",
    "say": "¿No los acusaste?"
  },
  "zq48a13": {
    "text": "Si acuso ahora,",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "Ahora,"
  },
  "zq48a14": {
    "text": "los que se hunden somos nosotros.",
    "emotion": "冷靜",
    "say": "nos hundimos nosotros."
  },
  "zq48a15": {
    "text": "Este papel,",
    "emotion": "快，說完就停"
  },
  "zq48a16": {
    "text": "se guarda hasta que valga más.",
    "emotion": "笑了",
    "say": "espera su mejor precio."
  },
  "zq48a17": {
    "text": "Sin gastar capital,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "Sin gastar,"
  },
  "zq48a18": {
    "text": "interés sobre interés.",
    "emotion": "甜，快，說完就停",
    "say": "y rinde."
  },
  "zq48a19": {
    "text": "Pero,",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "el treinta por ciento de los intereses es mío.",
    "emotion": "伸出三根手指",
    "say": "el treinta es mío."
  },
  "zq48a21": {
    "text": "Tang Xiaotang, afecto:",
    "emotion": "平板電子音，叮一聲",
    "say": "Tang Xiaotang:"
  },
  "zq48a22": {
    "text": "cincuenta y dos.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "Joven general,",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "hay noticias.",
    "emotion": "粗啞，快，說完就停",
    "say": "noticias."
  },
  "zq48a25": {
    "text": "Habla.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "El general está vivo,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "en las minas de sal de la frontera norte.",
    "emotion": "一字一字",
    "say": "en minas de sal del norte."
  },
  "zq48a28": {
    "text": "¿Quién…?",
    "emotion": "發抖，極短促，不拖音",
    "say": "¿Quién?"
  },
  "zq48a29": {
    "text": "¿quién lo vio?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "Mi antiguo cabo,",
    "emotion": "粗啞，極短促，說完就停",
    "say": "Mi viejo cabo,"
  },
  "zq48a31": {
    "text": "lo vio con sus propios ojos.",
    "emotion": "篤定",
    "say": "lo vio él mismo."
  },
  "zq48a32": {
    "text": "El joven Xu me pidió",
    "emotion": "粗啞，快，說完就停",
    "say": "Xu me pidió"
  },
  "zq48a33": {
    "text": "que preguntara.",
    "emotion": "粗啞",
    "say": "preguntar."
  },
  "zq48a34": {
    "text": "Tres años,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "creí que él…",
    "emotion": "哽住，極短促，說完就停",
    "say": "creí…"
  },
  "zq48a36": {
    "text": "¿No podías",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "decir algo?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "…Está dulce.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "Qin Shuang, afecto:",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang:"
  },
  "zq48a40": {
    "text": "cincuenta y cinco.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "La de apellido Qin,",
    "emotion": "壓低聲音，討好",
    "say": "La Qin,"
  },
  "zq48a42": {
    "text": "es hija de Qin Lieshan.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "¿Es fiable?",
    "emotion": "慢條斯理",
    "say": "¿Seguro?"
  },
  "zq48a44": {
    "text": "Lo oí con mis propios oídos.",
    "emotion": "眼睛不看人",
    "say": "Lo oí yo mismo."
  },
  "zq48a45": {
    "text": "La casa Wei",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Los Wei"
  },
  "zq48a46": {
    "text": "te lo tendrá en cuenta.",
    "emotion": "居高臨下",
    "say": "te lo debe."
  },
  "zq48a47": {
    "text": "La muchacha Qin,",
    "emotion": "低聲，快，說完就停",
    "say": "La chica Qin,"
  },
  "zq48a48": {
    "text": "alegrará al señorito.",
    "emotion": "笑"
  }
}
