{
  "zq48a01": {
    "text": "펑 학정만 처벌하겠습니다.",
    "emotion": "平靜，做了決定",
    "say": "펑 학정만요."
  },
  "zq48a02": {
    "text": "이건,",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "제가 갖겠습니다.",
    "emotion": "嘴角一勾",
    "say": "제가 갖죠."
  },
  "zq48a04": {
    "text": "젊은이,",
    "emotion": "挑眉，快，說完就停"
  },
  "zq48a05": {
    "text": "침착하군.",
    "emotion": "難得一笑"
  },
  "zq48a06": {
    "text": "나리도,",
    "emotion": "笑"
  },
  "zq48a07": {
    "text": "마찬가지죠.",
    "emotion": "拱手"
  },
  "zq48a08": {
    "text": "방은,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "방은"
  },
  "zq48a09": {
    "text": "이미 내보냈네.",
    "emotion": "背過身"
  },
  "zq48a10": {
    "text": "되돌릴 수 있을지는,",
    "emotion": "畫外，慢",
    "say": "되돌릴지는,"
  },
  "zq48a11": {
    "text": "내일 알게 되네.",
    "emotion": "畫外",
    "say": "내일 알겠지."
  },
  "zq48a12": {
    "text": "웨이 가를 고발 안 했어?",
    "emotion": "壓低聲音，急",
    "say": "고발 안 했어?"
  },
  "zq48a13": {
    "text": "지금 고발하면,",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "지금 하면,"
  },
  "zq48a14": {
    "text": "질질 끌려 죽는 건 우리야.",
    "emotion": "冷靜",
    "say": "죽는 건 우리야."
  },
  "zq48a15": {
    "text": "이 종이는,",
    "emotion": "慢"
  },
  "zq48a16": {
    "text": "제일 비쌀 때까지 둔다.",
    "emotion": "笑了",
    "say": "제일 비쌀 때 쓴다."
  },
  "zq48a17": {
    "text": "밑천 안 들이고,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "공짜로,"
  },
  "zq48a18": {
    "text": "이자에 이자.",
    "emotion": "甜，快，說完就停",
    "say": "복리야."
  },
  "zq48a19": {
    "text": "근데,",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "이자의 삼 할은 내 거야.",
    "emotion": "伸出三根手指",
    "say": "삼 할은 내 거."
  },
  "zq48a21": {
    "text": "탕샤오탕 호감도,",
    "emotion": "平板電子音，叮一聲",
    "say": "탕샤오탕 호감,"
  },
  "zq48a22": {
    "text": "오십이.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "소장군,",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "소식이 왔습니다.",
    "emotion": "粗啞",
    "say": "소식입니다."
  },
  "zq48a25": {
    "text": "말해.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "장군께서 살아 계십니다,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "북방 변경 소금광에.",
    "emotion": "一字一字",
    "say": "북방 소금광에."
  },
  "zq48a28": {
    "text": "누가……",
    "emotion": "發抖，極短促，不拖音",
    "say": "누가"
  },
  "zq48a29": {
    "text": "누가 봤어?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "제 옛 오장이,",
    "emotion": "粗啞，極短促，說完就停",
    "say": "옛 오장이"
  },
  "zq48a31": {
    "text": "제 눈으로 봤답니다.",
    "emotion": "篤定",
    "say": "직접 봤답니다."
  },
  "zq48a32": {
    "text": "쉬 공자가 부탁해서",
    "emotion": "粗啞，快，說完就停",
    "say": "쉬 공자 부탁에"
  },
  "zq48a33": {
    "text": "알아본 겁니다.",
    "emotion": "粗啞",
    "say": "알아봤죠."
  },
  "zq48a34": {
    "text": "삼 년이야,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "난 아버지가……",
    "emotion": "哽住，極短促，說完就停",
    "say": "아버진,"
  },
  "zq48a36": {
    "text": "넌",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "말 한마디 못 해?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "……달아.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "친솽 호감도,",
    "emotion": "平板電子音，叮一聲",
    "say": "친솽 호감,"
  },
  "zq48a40": {
    "text": "오십오.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "그 친씨 성의 여자,",
    "emotion": "壓低聲音，討好",
    "say": "그 친씨 여자,"
  },
  "zq48a42": {
    "text": "친례산의 딸입니다.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "확실한가?",
    "emotion": "慢條斯理"
  },
  "zq48a44": {
    "text": "제 귀로 들었습니다.",
    "emotion": "眼睛不看人"
  },
  "zq48a45": {
    "text": "웨이 가는,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "웨이 가"
  },
  "zq48a46": {
    "text": "자네 공을 기억하지.",
    "emotion": "居高臨下",
    "say": "기억하지."
  },
  "zq48a47": {
    "text": "친가 계집은,",
    "emotion": "低聲，快，說完就停",
    "say": "친가 딸은,"
  },
  "zq48a48": {
    "text": "도련님이 기뻐하실 거야.",
    "emotion": "笑",
    "say": "도련님이 기뻐하겠군."
  }
}
