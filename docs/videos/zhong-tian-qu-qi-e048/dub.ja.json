{
  "zq48a01": {
    "text": "フォン学正だけを裁く。",
    "emotion": "平靜，做了決定",
    "say": "フォンだけ裁く。"
  },
  "zq48a02": {
    "text": "これは、",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "取っておく。",
    "emotion": "嘴角一勾",
    "say": "預かる。"
  },
  "zq48a04": {
    "text": "若いの、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "若いの"
  },
  "zq48a05": {
    "text": "肝が据わっておるな。",
    "emotion": "難得一笑",
    "say": "動じぬな。"
  },
  "zq48a06": {
    "text": "閣下こそ、",
    "emotion": "笑"
  },
  "zq48a07": {
    "text": "同じでしょう。",
    "emotion": "拱手"
  },
  "zq48a08": {
    "text": "合格者名簿は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "名簿は"
  },
  "zq48a09": {
    "text": "もう送り出した。",
    "emotion": "背過身"
  },
  "zq48a10": {
    "text": "戻せるかどうかは、",
    "emotion": "畫外，慢",
    "say": "戻せるかは、"
  },
  "zq48a11": {
    "text": "明日わかる。",
    "emotion": "畫外"
  },
  "zq48a12": {
    "text": "ウェイ家を訴えなかったの？",
    "emotion": "壓低聲音，急",
    "say": "訴えないの？"
  },
  "zq48a13": {
    "text": "今訴えたら、",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "今は、"
  },
  "zq48a14": {
    "text": "引きずられて潰れるのはこっちだ。",
    "emotion": "冷靜",
    "say": "こっちが潰れる。"
  },
  "zq48a15": {
    "text": "この紙は、",
    "emotion": "慢"
  },
  "zq48a16": {
    "text": "一番高く売れる時まで取っておく。",
    "emotion": "笑了",
    "say": "高値まで待つ。"
  },
  "zq48a17": {
    "text": "元手いらずで、",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "元手ゼロ、"
  },
  "zq48a18": {
    "text": "利が利を生む。",
    "emotion": "笑得很甜"
  },
  "zq48a19": {
    "text": "でも、",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "利息の三割はわたしのね。",
    "emotion": "伸出三根手指",
    "say": "三割はわたしの。"
  },
  "zq48a21": {
    "text": "タン・シャオタン、好感度、",
    "emotion": "平板電子音，叮一聲",
    "say": "タン・シャオタン、"
  },
  "zq48a22": {
    "text": "五十二。",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "若将軍、",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "知らせが来ました。",
    "emotion": "粗啞",
    "say": "知らせです。"
  },
  "zq48a25": {
    "text": "話して。",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "将軍はご存命です、",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "北の辺境の塩鉱に。",
    "emotion": "一字一字",
    "say": "北の塩鉱に。"
  },
  "zq48a28": {
    "text": "誰が……",
    "emotion": "發抖，極短促，不拖音",
    "say": "誰"
  },
  "zq48a29": {
    "text": "誰が見たの？",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "昔の伍長が、",
    "emotion": "粗啞，極短促，說完就停",
    "say": "元伍長が"
  },
  "zq48a31": {
    "text": "自分の目で見たと。",
    "emotion": "篤定",
    "say": "見たんです。"
  },
  "zq48a32": {
    "text": "シュー殿に頼まれて",
    "emotion": "轉頭看許硯",
    "say": "シュー殿の頼みで"
  },
  "zq48a33": {
    "text": "聞きに行きました。",
    "emotion": "粗啞",
    "say": "調べました。"
  },
  "zq48a34": {
    "text": "三年よ、",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "てっきり父は……",
    "emotion": "哽住，極短促，說完就停",
    "say": "父は、"
  },
  "zq48a36": {
    "text": "あんたは",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "何も言えないの？",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "……甘い。",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "チン・シュアン、好感度、",
    "emotion": "平板電子音，叮一聲",
    "say": "チン・シュアン、"
  },
  "zq48a40": {
    "text": "五十五。",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "あのチンという女は、",
    "emotion": "壓低聲音，討好",
    "say": "あのチンって女、"
  },
  "zq48a42": {
    "text": "チン・リエシャンの娘です。",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "確かか？",
    "emotion": "慢條斯理"
  },
  "zq48a44": {
    "text": "この耳で聞きました。",
    "emotion": "眼睛不看人"
  },
  "zq48a45": {
    "text": "ウェイ家は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ウェイ家"
  },
  "zq48a46": {
    "text": "お前の功を覚えておく。",
    "emotion": "居高臨下",
    "say": "覚えておく。"
  },
  "zq48a47": {
    "text": "チン家の娘は、",
    "emotion": "眯眼"
  },
  "zq48a48": {
    "text": "若様がお喜びになる。",
    "emotion": "笑",
    "say": "若様が喜ぶ。"
  }
}
