{
  "zq48a01": {
    "text": "Só o Examinador Feng.",
    "emotion": "平靜，做了決定",
    "say": "Só o Feng."
  },
  "zq48a02": {
    "text": "Esta,",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "eu guardo.",
    "emotion": "嘴角一勾"
  },
  "zq48a04": {
    "text": "Rapaz,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq48a05": {
    "text": "você tem sangue-frio.",
    "emotion": "難得一笑",
    "say": "tem sangue-frio."
  },
  "zq48a06": {
    "text": "Excelência,",
    "emotion": "笑",
    "say": "Senhor,"
  },
  "zq48a07": {
    "text": "o senhor também.",
    "emotion": "拱手",
    "say": "e o senhor."
  },
  "zq48a08": {
    "text": "A lista,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lista,"
  },
  "zq48a09": {
    "text": "já foi enviada.",
    "emotion": "背過身",
    "say": "já saiu."
  },
  "zq48a10": {
    "text": "Se dá para corrigir,",
    "emotion": "畫外，慢",
    "say": "Se tem conserto,"
  },
  "zq48a11": {
    "text": "amanhã a gente sabe.",
    "emotion": "畫外",
    "say": "amanhã se sabe."
  },
  "zq48a12": {
    "text": "Você não acusou os Wei?",
    "emotion": "壓低聲音，急",
    "say": "Não acusou os Wei?"
  },
  "zq48a13": {
    "text": "Acusar agora,",
    "emotion": "壓低聲音，極短促，說完就停",
    "say": "Agora,"
  },
  "zq48a14": {
    "text": "e quem afunda somos nós.",
    "emotion": "冷靜，快，說完就停",
    "say": "nós afundamos."
  },
  "zq48a15": {
    "text": "Este papel,",
    "emotion": "快，說完就停"
  },
  "zq48a16": {
    "text": "fica guardado até valer mais.",
    "emotion": "笑了",
    "say": "espera valer mais."
  },
  "zq48a17": {
    "text": "Sem gastar capital,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "Sem gastar,"
  },
  "zq48a18": {
    "text": "juros sobre juros.",
    "emotion": "甜，快，說完就停",
    "say": "e rende."
  },
  "zq48a19": {
    "text": "Mas,",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "trinta por cento dos juros são meus.",
    "emotion": "伸出三根手指",
    "say": "fico com trinta."
  },
  "zq48a21": {
    "text": "Tang Xiaotang, afeição:",
    "emotion": "平板電子音，叮一聲",
    "say": "Tang Xiaotang:"
  },
  "zq48a22": {
    "text": "cinquenta e dois.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "Jovem general,",
    "emotion": "壓低嗓子，快，說完就停"
  },
  "zq48a24": {
    "text": "chegou notícia.",
    "emotion": "粗啞，快，說完就停",
    "say": "notícias."
  },
  "zq48a25": {
    "text": "Fala.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "O general está vivo,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "nas minas de sal da fronteira norte.",
    "emotion": "一字一字",
    "say": "nas minas de sal do norte."
  },
  "zq48a28": {
    "text": "Quem…?",
    "emotion": "發抖，極短促，不拖音",
    "say": "Quem?"
  },
  "zq48a29": {
    "text": "quem viu?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "Meu antigo cabo,",
    "emotion": "粗啞，極短促，說完就停",
    "say": "Meu velho cabo,"
  },
  "zq48a31": {
    "text": "viu com os próprios olhos.",
    "emotion": "篤定，快，說完就停",
    "say": "viu mesmo."
  },
  "zq48a32": {
    "text": "Foi o jovem Xu que me pediu",
    "emotion": "粗啞，快，說完就停",
    "say": "O Xu me pediu"
  },
  "zq48a33": {
    "text": "para perguntar.",
    "emotion": "粗啞",
    "say": "pra perguntar."
  },
  "zq48a34": {
    "text": "Três anos,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "eu achei que ele…",
    "emotion": "哽住，極短促，說完就停",
    "say": "achei…"
  },
  "zq48a36": {
    "text": "Você não consegue",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "dizer nada?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "…É doce.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "Qin Shuang, afeição:",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang:"
  },
  "zq48a40": {
    "text": "cinquenta e cinco.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "Aquela de sobrenome Qin,",
    "emotion": "壓低聲音，討好",
    "say": "Aquela Qin,"
  },
  "zq48a42": {
    "text": "é filha de Qin Lieshan.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "É certo?",
    "emotion": "慢條斯理",
    "say": "Certeza?"
  },
  "zq48a44": {
    "text": "Ouvi com meus próprios ouvidos.",
    "emotion": "眼睛不看人",
    "say": "Ouvi eu mesmo."
  },
  "zq48a45": {
    "text": "A casa Wei",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Os Wei"
  },
  "zq48a46": {
    "text": "vai lembrar do seu serviço.",
    "emotion": "居高臨下",
    "say": "te devem uma."
  },
  "zq48a47": {
    "text": "A moça dos Qin,",
    "emotion": "低聲，快，說完就停",
    "say": "A moça Qin,"
  },
  "zq48a48": {
    "text": "vai agradar ao senhorzinho.",
    "emotion": "笑"
  }
}
