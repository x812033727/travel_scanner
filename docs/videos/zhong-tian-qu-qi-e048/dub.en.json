{
  "zq48a01": {
    "text": "Only Examiner Feng.",
    "emotion": "平靜，做了決定",
    "say": "Just Examiner Feng."
  },
  "zq48a02": {
    "text": "This one,",
    "emotion": "收進袖子"
  },
  "zq48a03": {
    "text": "I'll keep.",
    "emotion": "嘴角一勾"
  },
  "zq48a04": {
    "text": "Young man,",
    "emotion": "挑眉"
  },
  "zq48a05": {
    "text": "you keep a cool head.",
    "emotion": "難得一笑"
  },
  "zq48a06": {
    "text": "My lord,",
    "emotion": "笑"
  },
  "zq48a07": {
    "text": "so do you.",
    "emotion": "拱手"
  },
  "zq48a08": {
    "text": "The list,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "List,"
  },
  "zq48a09": {
    "text": "has already gone out.",
    "emotion": "背過身",
    "say": "is already out."
  },
  "zq48a10": {
    "text": "Whether it can be changed back,",
    "emotion": "畫外，慢",
    "say": "Changed back or not,"
  },
  "zq48a11": {
    "text": "we'll know tomorrow.",
    "emotion": "畫外"
  },
  "zq48a12": {
    "text": "You didn't accuse the Wei family?",
    "emotion": "壓低聲音，急",
    "say": "You didn't sue the Weis?"
  },
  "zq48a13": {
    "text": "Sue now,",
    "emotion": "壓低聲音"
  },
  "zq48a14": {
    "text": "and it's us who get dragged down.",
    "emotion": "冷靜",
    "say": "and it drags us down."
  },
  "zq48a15": {
    "text": "This paper,",
    "emotion": "慢"
  },
  "zq48a16": {
    "text": "waits until it's worth the most.",
    "emotion": "笑了",
    "say": "waits till it's worth most."
  },
  "zq48a17": {
    "text": "No capital spent,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "No cost,"
  },
  "zq48a18": {
    "text": "interest on interest.",
    "emotion": "笑得很甜",
    "say": "compound interest."
  },
  "zq48a19": {
    "text": "But,",
    "emotion": "眼珠一轉"
  },
  "zq48a20": {
    "text": "I get thirty percent of the interest.",
    "emotion": "伸出三根手指",
    "say": "I get thirty percent."
  },
  "zq48a21": {
    "text": "Tang Xiaotang, affection:",
    "emotion": "平板電子音，叮一聲",
    "say": "Tang Xiaotang:"
  },
  "zq48a22": {
    "text": "fifty-two.",
    "emotion": "平板電子音"
  },
  "zq48a23": {
    "text": "Young General,",
    "emotion": "壓低嗓子，喘"
  },
  "zq48a24": {
    "text": "the news is in.",
    "emotion": "粗啞"
  },
  "zq48a25": {
    "text": "Tell me.",
    "emotion": "聲音發緊"
  },
  "zq48a26": {
    "text": "The General is alive,",
    "emotion": "聲音發顫"
  },
  "zq48a27": {
    "text": "in the salt mines of the northern frontier.",
    "emotion": "一字一字",
    "say": "in the frontier salt mines."
  },
  "zq48a28": {
    "text": "Who…",
    "emotion": "發抖"
  },
  "zq48a29": {
    "text": "who saw him?",
    "emotion": "抓住他"
  },
  "zq48a30": {
    "text": "My old squad leader,",
    "emotion": "粗啞"
  },
  "zq48a31": {
    "text": "saw him with his own eyes.",
    "emotion": "篤定",
    "say": "saw him himself."
  },
  "zq48a32": {
    "text": "It was Master Xu who asked me",
    "emotion": "粗啞，快，說完就停",
    "say": "Xu sent me"
  },
  "zq48a33": {
    "text": "to go and ask.",
    "emotion": "粗啞",
    "say": "to ask."
  },
  "zq48a34": {
    "text": "Three years,",
    "emotion": "哽住"
  },
  "zq48a35": {
    "text": "I thought he was…",
    "emotion": "哽住，快，說完就停",
    "say": "I thought…"
  },
  "zq48a36": {
    "text": "Can't you",
    "emotion": "哽咽，瞪他"
  },
  "zq48a37": {
    "text": "say something?",
    "emotion": "又氣又哭"
  },
  "zq48a38": {
    "text": "…It's sweet.",
    "emotion": "哭著笑出來"
  },
  "zq48a39": {
    "text": "Qin Shuang, affection:",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang:"
  },
  "zq48a40": {
    "text": "fifty-five.",
    "emotion": "平板電子音"
  },
  "zq48a41": {
    "text": "That Qin girl,",
    "emotion": "壓低聲音，討好"
  },
  "zq48a42": {
    "text": "is Qin Lieshan's daughter.",
    "emotion": "笑著"
  },
  "zq48a43": {
    "text": "Is that reliable?",
    "emotion": "慢條斯理",
    "say": "Reliable?"
  },
  "zq48a44": {
    "text": "I heard it with my own ears.",
    "emotion": "眼睛不看人",
    "say": "Heard it myself."
  },
  "zq48a45": {
    "text": "The Wei house",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "The Weis"
  },
  "zq48a46": {
    "text": "will credit you for this.",
    "emotion": "居高臨下",
    "say": "owes you one."
  },
  "zq48a47": {
    "text": "The Qin girl,",
    "emotion": "眯眼"
  },
  "zq48a48": {
    "text": "will please the young master.",
    "emotion": "笑"
  }
}
