  },
  "lines": {
    "5yxg": {
      "source_hash": "54d62b612b23",
      "text": "11월 4일 수요일이에요."
    },
    "ftct": {
      "source_hash": "70acdd04953e",
      "text": "Tech Signal이에요. 잡음 속 오늘의 진짜 신호를 골라요."
    },
    "i4g3": {
      "source_hash": "97e2115b9cf9",
      "text": "Sola예요."
    },
    "f6vx": {
      "source_hash": "cf9f8841a94f",
      "text": "Kai예요."
    },
    "ao43": {
      "source_hash": "eed765dcdc20",
      "text": "오늘 주제는 Anthropic이 상장 전 고친 서류 속 컴퓨팅 청구서예요."
    },
    "qmon": {
      "source_hash": "354fe72b7d41",
      "text": "잠깐, 매출은 느는데 적자는 커졌다고요? 그럼 번 돈은 어디로 갔죠?"
    },
    "g9s8": {
      "source_hash": "86a859bb2e59",
      "text": "먼저 어제 11월 3일 뉴스예요."
    },
    "8vau": {
      "source_hash": "47b9fb2c6d62",
      "text": "매일 쓰는 검색부터 볼까요?"
    },
    "iz00": {
      "source_hash": "a76e12ff300b",
      "text": "The Verge에 따르면 OpenAI는 월요일, ChatGPT 검색이 Google의 5분의 1이래요."
    },
    "srcq": {
      "source_hash": "524e0dcf12ef",
      "text": "5분의 1이요? 그렇게 많아요?"
    },
    "rzxg": {
      "source_hash": "9ac90673b558",
      "text": "계산법부터 봐요. 질문이 웹 검색을 부를 때만 한 번이에요."
    },
    "a5i8": {
      "source_hash": "8cdb2ca3e494",
      "text": "단어 뜻 질문도 세나요?"
    },
    "cqwh": {
      "source_hash": "4331aa6fdab7",
      "text": "안 세요. 단어 설명이나 간단한 사용법은 빠져요."
    },
    "g62g": {
      "source_hash": "569dc3192dae",
      "text": "OpenAI는 Google 수치 출처도 안 밝혔어요."
    },
    "2p4c": {
      "source_hash": "045ffff63ac5",
      "text": "자기 주장이니 물음표네요."
    },
    "srca": {
      "source_hash": "485fb35e51df",
      "text": "The Verge 비교로, 2023년 Microsoft CEO가 법정에서, Bing 점유율은 10여 년에 약 3%였대요."
    },
    "f46p": {
      "source_hash": "d6e8a2820fce",
      "text": "검색이 커지면 다음은 광고겠죠?"
    },
    "we58": {
      "source_hash": "ee9092bb7493",
      "text": "네. OpenAI는 지난달 ChatGPT 광고에 협찬 상품 사진을 넣는대요."
    },
    "ahuo": {
      "source_hash": "a855d853dd69",
      "text": "저희 조언은, ChatGPT로 찾을 때 답변과 광고를 잘 구분하라는 거예요."
    },
    "kcmm": {
      "source_hash": "9aeec3dd8399",
      "text": "찾는 AI에서 사칭하는 AI로 가요."
    },
    "2tqk": {
      "source_hash": "7e2689193179",
      "text": "Google이 어제 낸 아태 사기 방지책엔, Android 사칭 전화 탐지가 있어요."
    },
    "k70z": {
      "source_hash": "0a5a11f0e545",
      "text": "사칭 전화요? 그게 뭔데요?"
    },
    "a9go": {
      "source_hash": "a45ea08333ad",
      "text": "AI로 남인 척 전화하는 거예요. 이 기능이 그걸 알아내요."
    },
    "j1c6": {
      "source_hash": "ae706c9735d2",
      "text": "Pixel 폰의 사기 탐지는, 메신저 앱 속 수상한 내용에도 경고를 띄워요."
    },
    "3myb": {
      "source_hash": "e6e052bd0097",
      "text": "Google 자선 부문은 아태 사기 교육에 600만 달러를 써요."
    },
    "f8zx": {
      "source_hash": "431710f61d7b",
      "text": "Pixel 말고 다른 폰은요?"
    },
    "b0xe": {
      "source_hash": "26b301a809ea",
      "text": "Google은 연내 더 많은 Android 폰에 넓힌대요."
    },
    "scmq": {
      "source_hash": "b58b85a1f7d5",
      "text": "대만도 돼요?"
    },
    "wul6": {
      "source_hash": "b48044a4d60e",
      "text": "어떤 기종, 어떤 지역인지는 Google 글에 없어요."
    },
    "z2ua": {
      "source_hash": "934f16c9c170",
      "text": "TechCrunch에 따르면, Apple이 월요일 개발자에게 알렸어요. 데이팅·연애 기능 앱은 모두 18+래요."
    },
    "r9kk": {
      "source_hash": "31a88f1a635c",
      "text": "데이팅 앱은 원래 성인용 아닌가요?"
    },
    "90kq": {
      "source_hash": "06362a4a832f",
      "text": "TechCrunch도 그래요. 핵심은 AI 동반자예요."
    },
    "ycjs": {
      "source_hash": "70a8c8bea900",
      "text": "AI 친구나 연인까지 만드는 앱인데, 젊은 층을 노리곤 해요."
    },
    "2kld": {
      "source_hash": "e4fd56eb0617",
      "text": "언제부터요?"
    },
    "0klx": {
      "source_hash": "8067df145b5c",
      "text": "이번 달 16일부터 개발자는 기능에 맞는 새 콘텐츠 설명을 넣어야 해요."
    },
    "slzh": {
      "source_hash": "048479b51390",
      "text": "많이들 써요?"
    },
    "4foc": {
      "source_hash": "9caa40baf999",
      "text": "TechCrunch에 따르면 인기 AI 동반자 앱은 작년 여름까지 세계에서 2억 2천만 번 받았어요."
    },
    "69ke": {
      "source_hash": "5bc53ebd8ea2",
      "text": "아이 iPhone은 안심이죠?"
    },
    "zt5n": {
      "source_hash": "ed5774c3cebd",
      "text": "아직요. 시행 방법은 보도에 없어요."
    },
    "koo0": {
      "source_hash": "bf0917d80dff",
      "text": "더 근본 질문이 있어요. 상대가 어느 AI인지 어떻게 알죠?"
    },
    "vrac": {
      "source_hash": "18d43a7dcde8",
      "text": "말한 그 AI 아니에요?"
    },
    "nnfb": {
      "source_hash": "d012372bcd1a",
      "text": "아뇨. Anthropic은 중간 업체가 싼 모델로 바꾸거나 출력을 조작할 수 있대요."
    },
    "2ff8": {
      "source_hash": "d712b1ff990a",
      "text": "증명은요?"
    },
    "9aan": {
      "source_hash": "5f284cb4a198",
      "text": "그래서 오픈소스 시제품 FlashProve로, 답이 그 모델 것임을 암호학으로 증명해요. 내부 값은 숨겨요."
    },
    "prvq": {
      "source_hash": "6ed8dc7fe41e",
      "text": "무거워 보이는데 돌아가긴 해요?"
    },
    "lux8": {
      "source_hash": "121d43d89cc3",
      "text": "GPU 하나로 초당 약 110 토큰을 증명해요."
    },
    "t9dy": {
      "source_hash": "ccaa5b6759b9",
      "text": "천여 토큰 답이면 증명은 약 19 MB예요."
    },
    "e5pc": {
      "source_hash": "4a14e33ee231",
      "text": "바로 쓸 수 있어요?"
    },
    "prva": {
      "source_hash": "0aab65898bd0",
      "text": "아직이에요. 연구 시제품이고, TechCrunch는 배포할 연구소가 없대요."
    },
    "mktx": {
      "source_hash": "6c2b995148d4",
      "text": "워터마크도 있어요. Anthropic은 어제 Claude 세 모델 글에 워터마크가 있대요."
    },
    "86yq": {
      "source_hash": "cd071724b996",
      "text": "그럼 선생님이 AI 숙제를 잡을 수 있어요?"
    },
    "m7jx": {
      "source_hash": "40ee1d996251",
      "text": "잠깐요. 명시한 플랫폼만이고, Sonnet 4.6은 개발자가 일부 생성 설정을 바꾸면 빠질 수 있어요."
    },
    "zmrr": {
      "source_hash": "a23dfcdf2add",
      "text": "워터마크가 없다고 사람이 쓴 건 아니에요."
    },
    "68un": {
      "source_hash": "1d4627e29f00",
      "text": "증명에서 방어로 가요."
    },
    "52k2": {
      "source_hash": "f6e5dc59e3b3",
      "text": "코인 프로젝트 문서 플랫폼 GitBook은, 월요일 밤 AI 에이전트 공격으로"
    },
    "e7fb": {
      "source_hash": "8bb8f43ae5f8",
      "text": "일부 시스템 자격 증명이 털렸대요."
    },
    "escy": {
      "source_hash": "cebe1cd08c8d",
      "text": "AI 에이전트는 챗봇이랑 뭐가 달라요?"
    },
    "1klv": {
      "source_hash": "7d4728461f40",
      "text": "챗봇은 답만 하고, 에이전트는 사람 손 덜 타고 스스로 소프트웨어를 다뤄요."
    },
    "7bcz": {
      "source_hash": "be776b305e6d",
      "text": "유출은요?"
    },
    "d67c": {
      "source_hash": "289ebe2cb37c",
      "text": "API 토큰, 즉 프로그램이 자동 접속하는 열쇠일 수 있고,"
    },
    "etvc": {
      "source_hash": "dcb08caa4f71",
      "text": "연동 키,"
    },
    "5g0v": {
      "source_hash": "115c32e3abd8",
      "text": "GitBook AI 비서 질문도요."
    },
    "pngi": {
      "source_hash": "a18ae5684947",
      "text": "GitBook은 API 토큰을 무효화하고, 키 교체도 요청했어요."
    },
    "14fs": {
      "source_hash": "628bdd8424c7",
      "text": "내용이 바뀐 증거는 없다고 했어요."
    },
    "got4": {
      "source_hash": "81f9f8bf3d5f",
      "text": "방식은 밝혔어요?"
    },
    "54rb": {
      "source_hash": "4460156bbf30",
      "text": "아직이에요. 팀에서 GitBook을 쓰면 안내대로 토큰을 바꾸세요."
    },
    "s4je": {
      "source_hash": "a5ddef81c515",
      "text": "가벼운 얘기요. 밤에 Netflix 켜면 뭘 볼지 고민되잖아요."
    },
    "ypdj": {
      "source_hash": "bd0227d0f933",
      "text": "Netflix TV 앱에 AI Discover 탭이 생기는데, 첫 실험은 주제별 추천이에요."
    },
    "h2mc": {
      "source_hash": "f9b99294ff13",
      "text": "가벼운 거, 가족 영화, 짧은 거요."
    },
    "mqia": {
      "source_hash": "d931ef767fd7",
      "text": "별로면요?"
    },
    "jv1a": {
      "source_hash": "9034adbb0731",
      "text": "말하면 기억해요."
    },
    "jfmp": {
      "source_hash": "cba539ba9c6b",
      "text": "다만 지금은 미국에서, 영어로 쓰고 TV가 지원되는 회원부터 열어요."
    },
    "65r7": {
      "source_hash": "5e3854709a77",
      "text": "대만은 없죠?"
    },
    "ix3p": {
      "source_hash": "29e74e842060",
      "text": "당분간은 몰라요. 실험 기능이라 확대 시점은 안 나왔어요."
    },
    "rvcj": {
      "source_hash": "55fbcb3e6582",
      "text": "오늘의 신호 숫자예요."
    },
    "os5p": {
      "source_hash": "4347085720d2",
      "text": "58%예요."
    },
    "m2ua": {
      "source_hash": "ad9569a5374d",
      "text": "뭐가 그렇게 많아요?"
    },
    "4fv9": {
      "source_hash": "a014af6f74bc",
      "text": "Anthropic은 100달러당 이만큼을 컴퓨팅에 써요."
    },
    "rtif": {
      "source_hash": "da0a5ba15e93",
      "text": "절반 넘게요? 그럼 남는 건요?"
    },
    "jxon": {
      "source_hash": "48c189f55c07",
      "text": "그게 오늘 주제예요. 남은 걸로는 모자라 적자예요."
    },
    "exb7": {
      "source_hash": "fd880c0f0cc8",
      "text": "번 돈은 누가 가져갈까요? 한 사람 얘기로 시작해요."
    },
    "zgw5": {
      "source_hash": "ecb9aaf45321",
      "text": "공모주 보는 분석가라고 상상해 봐요."
    },
    "n1w1": {
      "source_hash": "8642e5577bc3",
      "text": "월요일 알림이 떠요. Anthropic이 S-1 갱신본을 냈어요."
    },
    "oqtk": {
      "source_hash": "186bb9c4967a",
      "text": "S-1이 뭐죠?"
    },
    "otil": {
      "source_hash": "e7e25f4512aa",
      "text": "회사가 처음 주식을 상장하는 IPO 전에 내는 서류로, 재무 숫자가 들어 있어요."
    },
    "0lxp": {
      "source_hash": "c148a3f0ba16",
      "text": "막 내지 않았어요?"
    },
    "026w": {
      "source_hash": "e589d82fdfe3",
      "text": "네, 한 주 전에요. 옛 버전은 6월 말까지였고, 새 버전은 한 분기 늘어 9월 30일까지예요."
    },
    "xpmb": {
      "source_hash": "d06015894171",
      "text": "TechCrunch는 상장이 가까워지자, Anthropic이 매출 중 컴퓨팅 몫을 조금 더 밝혔대요."
    },
    "ig49": {
      "source_hash": "8ee9a5c68eba",
      "text": "쉽게 말해 컴퓨팅은 AI 돌리는 컴퓨터예요?"
    },
    "jry6": {
      "source_hash": "4a919dea6ed0",
      "text": "비슷해요. 모델 훈련도, Claude에게 질문할 때 쓰는 연산 능력도 다 들어가요."
    },
    "bo1b": {
      "source_hash": "71b93ea0e60a",
      "text": "좋아요, 서류 첫 숫자는 뭐예요?"
    },
    "aqr1": {
      "source_hash": "41a101af73be",
      "text": "매출이에요. 전 분기 115억 달러."
    },
    "t181": {
      "source_hash": "b76071a889c4",
      "text": "이번 분기는 170억 달러예요."
    },
    "gnzv": {
      "source_hash": "32bfdecdf571",
      "text": "한 분기에 거의 절반이 늘었네요. 잘 버네요."
    },
    "6y9t": {
      "source_hash": "b3c71eb007c5",
      "text": "그런데 더 보면 영업손실도 커졌어요."
    },
    "96it": {
      "source_hash": "1921bfa1e89e",
      "text": "제 질문이죠. 돈은 어디 갔어요?"
    },
    "c6qv": {
      "source_hash": "1db0b9a62b1f",
      "text": "TechCrunch는 손실액은 안 썼고, 주원인 하나는 컴퓨팅 비용 상승이래요."
    },
    "7nny": {
      "source_hash": "6a999ff94c50",
      "text": "신호 숫자 기억나세요? 전 분기엔 컴퓨팅이 매출의 48%를 먹었어요."
    },
    "4w2e": {
      "source_hash": "a19f2e960194",
      "text": "이번엔 그 숫자예요."
    },
    "y11g": {
      "source_hash": "d7609c665ce4",
      "text": "10%포인트나 뛰었네요."
    },
    "tt6k": {
      "source_hash": "cf830e6823b3",
      "text": "금액으로는 이번 분기 컴퓨팅 청구서가 100억 달러예요."
    },
    "ra2g": {
      "source_hash": "e0936ff6e5f6",
      "text": "그걸 다 같은 방식으로 샀어요?"
    },
    "bmua": {
      "source_hash": "bad2e161e2b4",
      "text": "아니요. 절반은 단기 계약이에요."
    },
    "eu8k": {
      "source_hash": "d1f982849b1b",
      "text": "다년 계약보다 훨씬 비싸다고 서류에 나와요."
    },
    "h0ih": {
      "source_hash": "56fa71e65c37",
      "text": "장기 계약하면 안 돼요?"
    },
    "bs8p": {
      "source_hash": "17801e66b322",
      "text": "TechCrunch 해석은, 수요가 너무 빨라 급히 사느라 비싸게 냈대요."
    },
    "61em": {
      "source_hash": "7b6ab52fe119",
      "text": "태풍 전 라면 사재기 같네요."
    },
    "pcca": {
      "source_hash": "8000ce766806",
      "text": "서류엔 그래프도 있어요. 컴퓨팅에 1달러 쓰면 매출이 얼마 오는지요."
    },
    "mex6": {
      "source_hash": "c2ef235a64e7",
      "text": "2025년 초부터 고점 2배 남짓, 지금 1.72배."
    },
    "mnyq": {
      "source_hash": "99bf8084c7ee",
      "text": "컴퓨팅 1달러로 버는 게 줄었네요. 그럼 이 돈은 누구한테 갔어요?"
    },
    "1bt9": {
      "source_hash": "0393378f998b",
      "text": "그게 다음 얘기예요. 돈이 어디로 가는지요."
    },
    "kv8c": {
      "source_hash": "d9a0364bb4cc",
      "text": "TechCrunch로는 매달 SpaceX에 12억 5천만 달러예요."
    },
    "c9nn": {
      "source_hash": "20145f95dc6d",
      "text": "SpaceX? 로켓 회사요?"
    },
    "wq4l": {
      "source_hash": "3aafc783e58e",
      "text": "네, 거기예요."
    },
    "bthn": {
      "source_hash": "a1a0fbde09f5",
      "text": "Nscale, Akamai, Volta와도 수십억 달러 계약."
    },
    "wgd0": {
      "source_hash": "35100cbdc45a",
      "text": "셋 다 처음 들어 봐요."
    },
    "a2ft": {
      "source_hash": "d7f5c4459ddc",
      "text": "TechCrunch는 neocloud, 비대형 신흥 클라우드래요."
    },
    "xa1v": {
      "source_hash": "265de46392aa",
      "text": "계약은 유연해도 요금이 비싸요."
    },
    "7g2c": {
      "source_hash": "b0b31f745f55",
      "text": "직접 지으면요?"
    },
    "qojx": {
      "source_hash": "3113dbf7ff0d",
      "text": "Anthropic Direct로 직접 지어요."
    },
    "d0x8": {
      "source_hash": "ad5063e0c74f",
      "text": "하지만 TechCrunch는 수요를 못 따라간대요."
    },
    "ewlu": {
      "source_hash": "71efc4e92f3f",
      "text": "그 돈은 결국 누구한테 가요?"
    },
    "bpnk": {
      "source_hash": "6d2fc2c455e9",
      "text": "어제 예가 있었어요. 칩 회사 AMD의 3분기 실적이에요."
    },
    "bh69": {
      "source_hash": "34217dfad498",
      "text": "서버 프로세서와 AI 칩을 파는 데이터센터 부문 매출이 85억 달러로,"
    },
    "ybob": {
      "source_hash": "dadea7785b0f",
      "text": "작년보다 거의 두 배예요."
    },
    "06zs": {
      "source_hash": "ddd1a2f29b6c",
      "text": "게임 쪽은요?"
    },
    "y4j8": {
      "source_hash": "b71e8b2304de",
      "text": "오히려 40% 줄었어요."
    },
    "lvm1": {
      "source_hash": "1707524cd011",
      "text": "AMD는 Anthropic, Meta, Microsoft, OpenAI, Oracle이 첫 Helios 랙 쓴대요."
    },
    "uczh": {
      "source_hash": "a0ab9c138360",
      "text": "그럼 Anthropic이 낸 돈 일부가 AMD로 갔어요?"
    },
    "71n3": {
      "source_hash": "e3a18abbd528",
      "text": "AMD는 쓴다고만 했고 금액은 없어요. 회사 측 말이에요."
    },
    "tnh6": {
      "source_hash": "1c6725f78c61",
      "text": "한편엔 모델 실행을 해 주는 회사가 있어요."
    },
    "irzo": {
      "source_hash": "7fa9c5aa7189",
      "text": "이미지·음성 호스팅 Fal이 13억 달러를 모았고, Bloomberg에 따르면 가치는 4월의 두 배예요."
    },
    "h60q": {
      "source_hash": "829e6d1860c6",
      "text": "이런 회사도 컴퓨팅 비용을 내죠?"
    },
    "993g": {
      "source_hash": "efbd10ed0a83",
      "text": "네. TechCrunch 인용 소식통은, 컴퓨팅이 비싸 마진이 여전히 얇대요."
    },
    "mpeg": {
      "source_hash": "9de962b7dddb",
      "text": "Anthropic과 같네요."
    },
    "ple4": {
      "source_hash": "220e73a7d5b5",
      "text": "칩 말고 더 밑바닥 문제가 있어요. 전기예요."
    },
    "7yb2": {
      "source_hash": "ca91397ae7f1",
      "text": "TechCrunch가 전한 뉴욕타임스로는, 전력망을 못 기다린 데이터센터가 퇴역 제트엔진으로 발전해요."
    },
    "1pzu": {
      "source_hash": "b0218c459f05",
      "text": "제트엔진으로 발전요? 꽤 절박하네요."
    },
    "zujv": {
      "source_hash": "c790b87390e2",
      "text": "북버지니아에서 100메가와트 연결은 국제에너지기구 추산 약 7년이에요."
    },
    "egf8": {
      "source_hash": "b03b6cf7ed16",
      "text": "분석가는 개조 엔진이면 24개월에 데이터센터를 돌린대요. 다만 효율이 낮고 오염이 많아요."
    },
    "qe0u": {
      "source_hash": "1d362fa2bc06",
      "text": "Nscale 기억나세요?"
    },
    "ap1q": {
      "source_hash": "d75bace68b68",
      "text": "신흥 클라우드요?"
    },
    "41ju": {
      "source_hash": "c2b3aeb94938",
      "text": "네. 지난달 Microsoft가 영국 데이터센터 주요 고객에서 빠졌어요."
    },
    "vhse": {
      "source_hash": "95f1aea13109",
      "text": "현지 전력회사가, 2030년대 초중반에야 전기가 충분하대서요."
    },
    "531m": {
      "source_hash": "ba3ae1d5a6b1",
      "text": "돈이 있어도 컴퓨팅을 못 사네요."
    },
    "a6ab": {
      "source_hash": "12b4be85fe82",
      "text": "돈 흐름 정리요."
    },
    "x6k8": {
      "source_hash": "06c10a376884",
      "text": "칩 회사는 주문을 받아요. AMD처럼요."
    },
    "auur": {
      "source_hash": "5b55f59b36ad",
      "text": "클라우드는요?"
    },
    "0xed": {
      "source_hash": "2ca0411416d9",
      "text": "급할수록 비싼 임대료를 받아요."
    },
    "5d9c": {
      "source_hash": "b55c9c77ca78",
      "text": "그리고 다들 막히는 건 전기예요."
    },
    "et6b": {
      "source_hash": "f2cbeba47bdb",
      "text": "누가 제일 손해예요?"
    },
    "mnya": {
      "source_hash": "d6fabc676f49",
      "text": "급하게 사는 쪽, Anthropic이에요. 매출은 늘고 컴퓨팅 지출은 더 커졌어요."
    },
    "jfi1": {
      "source_hash": "94817938de17",
      "text": "우리가 내는 AI 구독료랑도 관련 있어요?"
    },
    "c83x": {
      "source_hash": "a954d89c5ff0",
      "text": "인상은 추측 안 해요."
    },
    "jie6": {
      "source_hash": "c77f6765656d",
      "text": "다만 AI 질문 하나하나가 이 청구서의 한 칸이에요."
    },
    "twnq": {
      "source_hash": "f08bc52220f2",
      "text": "칩, 컴퓨팅이면 대만이랑 관련 깊은데, 대만 얘기도 있어요?"
    },
    "twna": {
      "source_hash": "361eafd442f3",
      "text": "솔직히 대만 업체는 안 나와서, 억지로 끼우지 않을게요."
    },
    "2oz0": {
      "source_hash": "f4d87f4e5511",
      "text": "말할 수 있는 건, AMD가 실적 위험 요인에 적은 거예요."
    },
    "e0hq": {
      "source_hash": "17ed5182c46e",
      "text": "수출 통제, 관세,"
    },
    "ylzh": {
      "source_hash": "8bc7f16d603c",
      "text": "요즘 자주 나와요."
    },
    "vqdu": {
      "source_hash": "a107d81027ac",
      "text": "메모리 공급, 외부 제조 의존이에요."
    },
    "gxrv": {
      "source_hash": "e068068b7f84",
      "text": "외부 제조는 누구예요?"
    },
    "d3b7": {
      "source_hash": "8daa0803395f",
      "text": "AMD가 안 밝혀 저희도 안 채워요. 아시아 공급망 영향은 출처에 없어요."
    },
    "lr60": {
      "source_hash": "29e744072d82",
      "text": "세 가지를 봐요."
    },
    "z6e4": {
      "source_hash": "45b8ec583805",
      "text": "첫째, 서류에 따르면 컴퓨팅과 인프라 지출은 더 늘어, 최대 영업비용이 될 거래요."
    },
    "l1r5": {
      "source_hash": "f7176226baf1",
      "text": "더 늘어요?"
    },
    "f2xh": {
      "source_hash": "15f7e80323fd",
      "text": "둘째, 일시적이냐 장기냐예요. TechCrunch는 일시적 변동 쪽이래요."
    },
    "8qns": {
      "source_hash": "2c03970aef61",
      "text": "셋째, 채권시장이 불안하거나 지역 반대가 크면 데이터센터 건설이 늦어질 수 있어요."
    },
    "qevc": {
      "source_hash": "cbbd65ea0840",
      "text": "왜 변동이라고 봐요?"
    },
    "9reg": {
      "source_hash": "15ec27f1c5c0",
      "text": "TechCrunch는 매출이 빨리 크면 투자자가 비용 걱정을 덜 한대요."
    },
    "qket": {
      "source_hash": "26f676e2640e",
      "text": "상장은 언제요?"
    },
    "zcc6": {
      "source_hash": "733dffc62d18",
      "text": "날짜는 없고 가까워졌대요."
    },
    "wv61": {
      "source_hash": "2ad1d9fbe95b",
      "text": "그 분석가로 돌아가면, 월요일 서류는 매출이 급증했지만 1달러당 컴퓨팅 몫이 커진 회사를 보여 줘요."
    },
    "9g8f": {
      "source_hash": "a6038c745463",
      "text": "그 돈은 칩, 클라우드, 아직 못 받은 전기로 가요."
    },
    "9u8h": {
      "source_hash": "ad97724ae703",
      "text": "다른 사람들은 뭐래요?"
    },
    "u63w": {
      "source_hash": "fd130910f546",
      "text": "보도 속 실제 발언 넷을 골랐어요."
    },
    "u7lu": {
      "source_hash": "d72d81c463ba",
      "text": "첫째는 TechCrunch Russell Brandom 기자예요."
    },
    "368b": {
      "source_hash": "bb748145aead",
      "text": "마진 개선으로 상장 투자자를 설득할 때, 마진이 나빠지고 있대요."
    },
    "3s3k": {
      "source_hash": "75719d69d971",
      "text": "타이밍이 곤란하네요. 두 번째는요?"
    },
    "gcwr": {
      "source_hash": "bdd9f9350797",
      "text": "Rystad Energy 분석가는 뉴욕타임스에, 핵심은 빠른 전기 확보래요."
    },
    "39tw": {
      "source_hash": "a1063788fae8",
      "text": "그래서 효율 낮아도 엔진이군요."
    },
    "dnrp": {
      "source_hash": "a1790185e776",
      "text": "셋째는 이름이에요. The Verge에 따르면 OpenAI가 데이터센터를 컴퓨팅 캠퍼스로 바꿔 불러요."
    },
    "6kp4": {
      "source_hash": "40614a100481",
      "text": "이름 바꾸면 반대가 없어요?"
    },
    "darw": {
      "source_hash": "667415cc958d",
      "text": "NAACP Abre' Conner는 개명론 안 된대요."
    },
    "xft7": {
      "source_hash": "7af0cf3fda92",
      "text": "OpenAI는 The Verge에 무응답."
    },
    "r7th": {
      "source_hash": "5521bebd357b",
      "text": "마지막은요?"
    },
    "9fxy": {
      "source_hash": "aa0b07b2b7e3",
      "text": "ChatGPT 소비자 제품 책임자 Adam Fry는, 대부분 광고를 개의치 않는 듯하대요."
    },
    "svzk": {
      "source_hash": "8881feae2cb2",
      "text": "그 말은 각자 판단해 보세요."
    },
    "ud6a": {
      "source_hash": "dd0de020842d",
      "text": "컴퓨팅은 회사 돈이고, 이제 여러분 돈이에요."
    },
    "ihg8": {
      "source_hash": "e4aa643e07dc",
      "text": "연합뉴스엔 북한이 Binance 해킹 연루 부인해요."
    },
    "xoeo": {
      "source_hash": "8f1b49a83a52",
      "text": "Binance는 얼마나 털렸어요?"
    },
    "hxx2": {
      "source_hash": "fb8718ae8692",
      "text": "FBI는 토요일 북한 TraderTraitor가 Binance서 60억 달러 넘게 털었대요."
    },
    "oclb": {
      "source_hash": "eb7147c7fbc5",
      "text": "Decrypt는 앞서 약 28억 5천만 달러가 동결·압수됐대요."
    },
    "08cu": {
      "source_hash": "60f219291e3f",
      "text": "북한은 뭐래요?"
    },
    "wllv": {
      "source_hash": "e0fa97a4d4d2",
      "text": "김정은의 여동생 김여정은 미국 판단이 심각한 정치 도발이래요."
    },
    "hhp6": {
      "source_hash": "568883bbfa66",
      "text": "서로 말이 다르네요. 사용자는요?"
    },
    "7wne": {
      "source_hash": "ff557d1e101b",
      "text": "사용자에겐 Binance의 두 가지 말이 중요해요. 도난 자산 약 95%를 채웠대요."
    },
    "hd6a": {
      "source_hash": "5a900e34cf3e",
      "text": "어떻게 확인해요?"
    },
    "7nw3": {
      "source_hash": "ea0b3ac81d41",
      "text": "상위 10개 토큰 보유자는, 10월 31일 준비금 스냅숏의 영지식 증명으로"
    },
    "x68d": {
      "source_hash": "314aefa4d56a",
      "text": "잔액이 뒷받침되는지 볼 수 있대요."
    },
    "6y1o": {
      "source_hash": "39ffc83d702b",
      "text": "영지식 증명은 FlashProve 때도요."
    },
    "xzi2": {
      "source_hash": "1f92744a16cb",
      "text": "네, 같은 암호학이에요. 사실을 증명하되 세부는 숨겨요."
    },
    "plgd": {
      "source_hash": "d29bee3871bb",
      "text": "저희 조언: 거래소에 사고가 나면 직접 확인할 증명을 주는지 보세요."
    },
    "2jfc": {
      "source_hash": "5bc1306c6c7f",
      "text": "안심하란 말만 하지 않고요."
    },
    "xk2j": {
      "source_hash": "89eb2e6b5f13",
      "text": "두 번째도 거절 얘기예요."
    },
    "4eoy": {
      "source_hash": "be741d4a9c1f",
      "text": "OKX와 뉴욕증권거래소 모회사 ICE의 토큰화 주식 플랫폼에, 반대한 회사가 56곳으로 늘었어요."
    },
    "36ly": {
      "source_hash": "251cf65c946e",
      "text": "토큰화 주식이 뭐예요?"
    },
    "jntm": {
      "source_hash": "bce7937e79ab",
      "text": "주식을 토큰으로 만들어 블록체인 플랫폼에서 거래하는 거예요."
    },
    "r5as": {
      "source_hash": "23dd50c034a0",
      "text": "Tesla·SpaceX·Amazon·Netflix 등 6곳 추가."
    },
    "y2pk": {
      "source_hash": "41a0372e9079",
      "text": "거부할 수 있어요?"
    },
    "9uwp": {
      "source_hash": "434fb3910c85",
      "text": "네. 미국 SEC의 9월 혁신 면제로, 먼저 회사에 알려야 해요."
    },
    "fehm": {
      "source_hash": "342dd8b698fc",
      "text": "30일 안에 서면 반대하면 남이 만든 토큰판을 못 올려요."
    },
    "rtwy": {
      "source_hash": "4df9f5979664",
      "text": "이 플랫폼만요."
    },
    "tfql": {
      "source_hash": "194f797e772b",
      "text": "전면 금지는 아니네요."
    },
    "z8ye": {
      "source_hash": "91a831abe5f6",
      "text": "네. Decrypt에 따르면 아직 계획 단계예요."
    },
    "htqd": {
      "source_hash": "168845d7409c",
      "text": "마지막은 오늘 유일한 대만 뉴스예요."
    },
    "fp84": {
      "source_hash": "a4b471a47486",
      "text": "대만 금융감독위원회가 곧 스테이블코인 발행 규정 초안을 예고한대요."
    },
    "jyw2": {
      "source_hash": "72c1a534711d",
      "text": "스테이블코인요?"
    },
    "yfww": {
      "source_hash": "9d49ffaab84d",
      "text": "가치를 법정화폐 하나에 묶도록 설계한 암호자산이에요."
    },
    "7g7b": {
      "source_hash": "5b9ac4f150a4",
      "text": "누가요?"
    },
    "lgku": {
      "source_hash": "7c1e51be47b7",
      "text": "은행, 금융지주, 은행 자회사, 금융감독위원회 지정 기관이에요."
    },
    "cg1t": {
      "source_hash": "48121d0cc265",
      "text": "은행이 아니면 자본금 3억 대만달러 이상이어야 해요."
    },
    "edyq": {
      "source_hash": "ace2840d7d31",
      "text": "대만달러나 외국 통화 하나에 1대1로 연동된 스테이블코인이에요."
    },
    "lk0k": {
      "source_hash": "e570abb5d55f",
      "text": "준비 자산은 유통액 이상이어야 해요."
    },
    "25ge": {
      "source_hash": "f48090704aa3",
      "text": "사는 사람도 확인해요?"
    },
    "bgww": {
      "source_hash": "42f3e07e92a9",
      "text": "네. 발행사는 매수·환매자를 확인하고, 정기 회계 감사도 받아야 해요."
    },
    "omwg": {
      "source_hash": "34ac58505e17",
      "text": "시행은요?"
    },
    "28m1": {
      "source_hash": "4f888b22bfc6",
      "text": "아직요. 공고 다음 날부터 40일간 의견을 받고, 시행은 가상자산서비스법 시행일인데 행정원이 미정이에요."
    },
    "2nje": {
      "source_hash": "9f1e96562181",
      "text": "할 건 없네요."
    },
    "251t": {
      "source_hash": "bfb6943be85b",
      "text": "네, 아직 초안이에요. 이 코너는 코인 가격을 다루지 않아요."
    },
    "vwey": {
      "source_hash": "b9946b610151",
      "text": "실용적으로 가요. AI 사칭 전화, 오늘 뭘 할 수 있어요?"
    },
    "1a87": {
      "source_hash": "197c70aa0e17",
      "text": "저희 제안이고 Google 지시는 아니에요."
    },
    "scma": {
      "source_hash": "09208b30573f",
      "text": "첫째, 익숙한 목소리가 송금을 요구하면 끊고, 저장된 번호로 거세요."
    },
    "rjzq": {
      "source_hash": "aede75db90be",
      "text": "목소리가 똑같아도요?"
    },
    "gfdq": {
      "source_hash": "1bc62aeee555",
      "text": "네, 비슷해도 본인이 아닐 수 있어요."
    },
    "9hi7": {
      "source_hash": "4754af41cfdc",
      "text": "둘째, Android면 설정에서 '사기'를 검색해 보호를 켜세요."
    },
    "wv40": {
      "source_hash": "b418bc9affac",
      "text": "없으면요?"
    },
    "pvi0": {
      "source_hash": "876fcd3c3bad",
      "text": "기능이 아직 없는 폰이에요."
    },
    "9qnc": {
      "source_hash": "17101420e8ac",
      "text": "셋째, Google 사기 게임 Be Scam Ready가 대만에 있대요."
    },
    "fe8z": {
      "source_hash": "7250bdd0b38b",
      "text": "어르신도 같이 해요."
    },
    "ot6y": {
      "source_hash": "c1daff842cf2",
      "text": "Apple 건 부모는요?"
    },
    "khjh": {
      "source_hash": "a98840272431",
      "text": "새 등급은 개발자용이에요. 저희 조언: iPhone 자녀 보호를 직접 켜세요."
    },
    "q7od": {
      "source_hash": "510614d0aa29",
      "text": "진짜 돈에서 좀 황당한 얘기로 가요. 오늘의 잡음이에요."
    },
    "zokc": {
      "source_hash": "3d061e546fe1",
      "text": "The Verge에 따르면 인디 개발자 여럿이, Steam 심사가 길어 출시일을 놓쳤대요."
    },
    "d4n5": {
      "source_hash": "ee57ed753db0",
      "text": "Valve는 상점 심사가 보통 영업일 3일에서 5일이래요."
    },
    "9sru": {
      "source_hash": "7e0bc72df861",
      "text": "그런데 Food Devils는 10월 12일 심사를 넣고 어제 출시 예정이었는데 아직 기다려요."
    },
    "rzbd": {
      "source_hash": "02f0472278c0",
      "text": "3주째예요?"
    },
    "5l7t": {
      "source_hash": "5c81744bb5ea",
      "text": "다른 한 편은 2주 가까이 밀렸어요."
    },
    "zfdp": {
      "source_hash": "8b138f373f2b",
      "text": "왜 밀려요?"
    },
    "05ct": {
      "source_hash": "a4bd72500bdb",
      "text": "개발자들은 대충 만든 AI 게임이 심사 줄을 막았다고 봐요."
    },
    "5y7k": {
      "source_hash": "59b720f91439",
      "text": "숫자는 있어요. 10월 Steam Next Fest엔 게임이 7,240개로, 6월보다 65% 많았어요."
    },
    "nxdo": {
      "source_hash": "198ea0efb18a",
      "text": "네티즌 계산으론, Valve가 표시를 요구한 뒤 게임 절반 가까이 AI 사용 표시예요."
    },
    "pqyu": {
      "source_hash": "d534de45e05e",
      "text": "Valve는요?"
    },
    "4nba": {
      "source_hash": "c95c6b37c2dc",
      "text": "Valve는 나중에 지연을 인정했고, 최대 영업일 12일이래요. AI 탓은 개발자 추측이에요."
    },
    "4pwl": {
      "source_hash": "8ac8f4d84779",
      "text": "이 잡음은 대기열에 둬요."
    },
    "7qsr": {
      "source_hash": "368573b94367",
      "text": "오늘 제일 중요한 건 Anthropic 서류예요."
    },
    "d9ls": {
      "source_hash": "fee0dc560439",
      "text": "AI 돌리는 비용을 펼쳐 보였거든요."
    },
    "npwp": {
      "source_hash": "a3a4b2d0de12",
      "text": "칩, 클라우드, 제트엔진과 다 이어져 있죠."
    },
    "so1l": {
      "source_hash": "b91edcf39527",
      "text": "이 청구서 지불 방식이 여러분 AI를 바꿔요."
    },
    "a5hc": {
      "source_hash": "eb9b7eb4296a",
      "text": "광고처럼요?"
    },
    "kzi0": {
      "source_hash": "2e44e59f9463",
      "text": "그건 OpenAI 일이고 관련은 보도에 없지만, 같이 볼 만해요."
    },
    "y79h": {
      "source_hash": "87387715f4ed",
      "text": "계속 이렇게 비쌀까요?"
    },
    "z02r": {
      "source_hash": "4bca0526919e",
      "text": "솔직히 모르겠어요. TechCrunch는 일시적이래요. 다음 분기를 봐야죠."
    },
    "k0ch": {
      "source_hash": "91877580f70e",
      "text": "자세한 건 Mokaair 기사에 있고, 링크는 설명란에 있어요."
    },
    "qans": {
      "source_hash": "7e79161a2761",
      "text": "오늘 주제로 돌아가면, 돈은 대부분 컴퓨팅에 급하게 썼어요."
    },
    "lvsq": {
      "source_hash": "3c57ec3a207f",
      "text": "돈이냐 광고냐, 댓글 주세요."
    },
    "lkby": {
      "source_hash": "503230268ccf",
      "text": "Tech Signal 구독하고 매일 핵심을 들으세요. 신호 수신."
    }
  }
}
