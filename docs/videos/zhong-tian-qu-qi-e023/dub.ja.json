{
  "zq23a01": "戻ってくれ！",
  "zq23a02": "正気？",
  "zq23a03": "水冷たいのに！",
  "zq23a04": "寒っ。",
  "zq23a05": "だから引き上げて。",
  "zq23a06": "なぜ逃げた？",
  "zq23a07": "正直に。",
  "zq23a08": "戻れば",
  "zq23a09": "皆は無事。",
  "zq23a10": "君は戦利品じゃない、",
  "zq23a11": "借金のカタでもない。",
  "zq23a12": "シャオタン、好感プラス六。",
  "zq23a13": "宰相がタン家の、",
  "zq23a14": {
    "text": "塩船八隻を。",
    "say": "船を"
  },
  "zq23a15": "婚を迫った。",
  "zq23a16": "アーヤーは……",
  "zq23a17": "仲人は病死と",
  "zq23a18": "枠が空いてた。",
  "zq23a19": {
    "text": "私が金で買ったの。",
    "say": "金で。"
  },
  "zq23a20": "つまり君は、",
  "zq23a21": "金で嫁いだ？",
  "zq23a22": "うるさい！",
  "zq23a23": "自分に賭ける。",
  "zq23a24": "何を？",
  "zq23a25": "三十日で、",
  "zq23a26": "売上勝負。",
  "zq23a27": "シュー記勝てば",
  "zq23a28": "訴えも婚書も撤回。",
  "zq23a29": "負けたら？",
  "zq23a30": "賭け？",
  "zq23a31": "自分を賭けるのか？",
  "zq23a32": "三十日で、",
  "zq23a33": "シュー記が勝つ。",
  "zq23a34": "負けたら？",
  "zq23a35": "都へ行く。",
  "zq23a36": "シャオタン——",
  "zq23a37": "計算済み。",
  "zq23a38": "よし。",
  "zq23a39": "商会に証人を。",
  "zq23a40": "三十日後、",
  "zq23a41": "花嫁を迎えに来る。",
  "zq23a42": "強制任務。",
  "zq23a43": {
    "text": "商戦三十日、",
    "say": "商戦"
  },
  "zq23a44": "勝利せよ。",
  "zq23a45": "失敗：",
  "zq23a46": "シャオタン、好感度ゼロ。"
}
