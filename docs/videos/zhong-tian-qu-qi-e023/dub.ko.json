{
  "zq23a01": "사공, 돌려요!",
  "zq23a02": "미쳤어?",
  "zq23a03": "물 차갑잖아!",
  "zq23a04": "춥지.",
  "zq23a05": "그러니 끌어올려 줘.",
  "zq23a06": "왜 갔어?",
  "zq23a07": "솔직히 말해.",
  "zq23a08": "돌아가면,",
  "zq23a09": "다들 안전해.",
  "zq23a10": "전리품도,",
  "zq23a11": "누구 빚도 아냐.",
  "zq23a12": {"text": "탕샤오탕, 호감 +6.", "say": "탕샤오탕, 호감 플러스 육."},
  "zq23a13": "재상이 탕가의",
  "zq23a14": "소금배 여덟 척,",
  "zq23a15": "혼인 강요.",
  "zq23a16": "린얼야는…",
  "zq23a17": "병사했다길래,",
  "zq23a18": "자리가 비었어.",
  "zq23a19": "내가 샀어.",
  "zq23a20": "그러니까 넌",
  "zq23a21": "돈 내고 시집왔어?",
  "zq23a22": "상관 마!",
  "zq23a23": "나한테 걸게.",
  "zq23a24": "뭘?",
  "zq23a25": "삼십 일,",
  "zq23a26": "매출 승부.",
  "zq23a27": "쉬기가 이기면,",
  "zq23a28": "고소, 혼서 다 철회.",
  "zq23a29": "지면?",
  "zq23a30": "흥,",
  "zq23a31": "너 자신을 걸고?",
  "zq23a32": "삼십 일,",
  "zq23a33": "쉬기 매출이 이겨.",
  "zq23a34": "지면?",
  "zq23a35": "따라갈게.",
  "zq23a36": "샤오탕—",
  "zq23a37": "계산 끝났어.",
  "zq23a38": "흠.",
  "zq23a39": "상회를 증인으로.",
  "zq23a40": "삼십 일 뒤,",
  "zq23a41": "신부 데리러 오지.",
  "zq23a42": "강제 미션.",
  "zq23a43": "매출전 삼십 일,",
  "zq23a44": "승리.",
  "zq23a45": "실패:",
  "zq23a46": "탕샤오탕 호감 초기화."
}
