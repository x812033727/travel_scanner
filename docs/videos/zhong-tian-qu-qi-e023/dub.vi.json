{
  "zq23a01": "Nhà đò, quay lại!",
  "zq23a02": "Huynh điên à?",
  "zq23a03": "Nước lạnh thế này!",
  "zq23a04": "Lạnh.",
  "zq23a05": "Nên nàng kéo ta lên trước đi.",
  "zq23a06": {
    "text": "Sao lại đào hôn?",
    "say": "Sao trốn?"
  },
  "zq23a07": "Lần này nói thật.",
  "zq23a08": "Ta về Ngụy gia,",
  "zq23a09": "mọi người sẽ an toàn.",
  "zq23a10": "Nàng đâu phải ta thắng,",
  "zq23a11": "cũng đâu phải nợ của ai.",
  "zq23a12": {
    "text": "Hảo cảm Đường Tiểu Đường: cộng sáu.",
    "say": "Tiểu Đường, hảo cảm cộng sáu."
  },
  "zq23a13": "Tể tướng giữ của nhà ta",
  "zq23a14": "tám thuyền muối.",
  "zq23a15": "ép cha ta chỉ hôn.",
  "zq23a16": "Còn Lâm Nhị Nha…",
  "zq23a17": "Bà mối bảo nàng ta ốm chết,",
  "zq23a18": "suất đó bỏ trống.",
  "zq23a19": "Ta mua đấy.",
  "zq23a20": "Vậy ra nàng",
  "zq23a21": "bỏ tiền gả cho ta à?",
  "zq23a22": "Ai khiến huynh lo!",
  "zq23a23": "Ta cược chính mình.",
  "zq23a24": "Cược gì?",
  "zq23a25": "Ba mươi ngày,",
  "zq23a26": "so doanh thu.",
  "zq23a27": "Hứa Ký thắng,",
  "zq23a28": "hắn rút đơn, trả hôn thư.",
  "zq23a29": "Còn thua thì sao?",
  "zq23a30": "Cược?",
  "zq23a31": "Lấy chính nàng ra cược?",
  "zq23a32": "Ba mươi ngày,",
  "zq23a33": "doanh thu Hứa Ký hơn ngươi.",
  "zq23a34": "Thua thì sao?",
  "zq23a35": {
    "text": "Ta theo ngươi về kinh.",
    "say": "Ta theo về kinh."
  },
  "zq23a36": "Tiểu Đường—",
  "zq23a37": "Ta tính rồi.",
  "zq23a38": "Được.",
  "zq23a39": {
    "text": "Mời thương hội làm chứng.",
    "say": "Thương hội làm chứng."
  },
  "zq23a40": "Ba mươi ngày sau,",
  "zq23a41": "ta đến rước dâu.",
  "zq23a42": {
    "text": "Nhiệm vụ bắt buộc.",
    "say": "Nhiệm vụ:"
  },
  "zq23a43": {
    "text": "Ba mươi ngày đấu thương:",
    "say": "Ba mươi ngày:"
  },
  "zq23a44": {
    "text": "thắng.",
    "say": "phải thắng."
  },
  "zq23a45": {
    "text": "Thất bại:",
    "say": "Thua:"
  },
  "zq23a46": {
    "text": "Hảo cảm Đường Tiểu Đường về không.",
    "say": "Tiểu Đường, hảo cảm về không."
  }
}
