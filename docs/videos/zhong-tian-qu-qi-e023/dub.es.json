{
  "zq23a01": "¡Barquero, pare!",
  "zq23a02": "¿Estás loco?",
  "zq23a03": "¡El agua está helada!",
  "zq23a04": {
    "text": "Helada.",
    "say": "Helada"
  },
  "zq23a05": "Así que primero súbeme.",
  "zq23a06": {
    "text": "¿Por qué huiste?",
    "say": "¿Por qué?"
  },
  "zq23a07": "Dime la verdad.",
  "zq23a08": "Si regreso,",
  "zq23a09": "ustedes quedan a salvo.",
  "zq23a10": "No eres un premio,",
  "zq23a11": "ni la deuda de nadie.",
  "zq23a12": "Tang Xiaotang: más seis.",
  "zq23a13": "El primer ministro tomó",
  "zq23a14": "ocho barcos de sal,",
  "zq23a15": "y forzó la boda.",
  "zq23a16": "¿Y Lin Erya…?",
  "zq23a17": {
    "text": "La casamentera dijo que murió,",
    "say": "Dicen que murió,"
  },
  "zq23a18": "su lugar quedó libre.",
  "zq23a19": "Lo compré.",
  "zq23a20": "¿O sea que pagaste",
  "zq23a21": "por casarte conmigo?",
  "zq23a22": "¡A ti qué te importa!",
  "zq23a23": "Me apuesto a mí misma.",
  "zq23a24": "¿A qué?",
  "zq23a25": "Treinta días,",
  "zq23a26": "duelo de ventas.",
  "zq23a27": "Si gana Casa Xu,",
  "zq23a28": {
    "text": "retira la demanda y el contrato.",
    "say": "lo retira todo."
  },
  "zq23a29": "¿Y si pierdes?",
  "zq23a30": {
    "text": "¿Apostar?",
    "say": "¿Eh?"
  },
  "zq23a31": "¿Apostándote a ti misma?",
  "zq23a32": "Treinta días,",
  "zq23a33": "Casa Xu te gana en ventas.",
  "zq23a34": "¿Si pierdes?",
  "zq23a35": {
    "text": "Vuelvo contigo a la capital.",
    "say": "Me voy contigo."
  },
  "zq23a36": "¡Xiaotang…!",
  "zq23a37": "Ya lo calculé.",
  "zq23a38": "Hecho.",
  "zq23a39": "Ante el gremio.",
  "zq23a40": "Treinta días,",
  "zq23a41": "y vengo por mi novia.",
  "zq23a42": {
    "text": "Misión obligatoria:",
    "say": "Obligatoria:"
  },
  "zq23a43": {
    "text": "Guerra comercial de treinta días:",
    "say": "Guerra comercial:"
  },
  "zq23a44": "ganar.",
  "zq23a45": "Fallo:",
  "zq23a46": "Tang Xiaotang: afecto a cero."
}
