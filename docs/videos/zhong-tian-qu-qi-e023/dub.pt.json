{
  "zq23a01": "Volta o barco!",
  "zq23a02": "Tá louco?",
  "zq23a03": "A água tá gelada!",
  "zq23a04": "Gelada.",
  "zq23a05": "Então me puxa pra cima.",
  "zq23a06": {
    "text": "Por que fugiu do casamento?",
    "say": "Por quê?"
  },
  "zq23a07": {
    "text": "Desta vez, a verdade.",
    "say": "A verdade."
  },
  "zq23a08": {
    "text": "Se eu voltar pros Wei,",
    "say": "Se eu for,"
  },
  "zq23a09": "vocês ficam bem.",
  "zq23a10": "Você não é prêmio,",
  "zq23a11": "nem dívida de ninguém.",
  "zq23a12": {
    "text": "Tang Xiaotang: afeição, mais seis.",
    "say": "Tang Xiaotang: mais seis."
  },
  "zq23a13": "O chanceler tomou",
  "zq23a14": "oito barcos de sal",
  "zq23a15": "pra forçar meu pai.",
  "zq23a16": "E a Lin Erya…",
  "zq23a17": {
    "text": "A casamenteira disse que ela morreu,",
    "say": "Disseram que ela morreu,"
  },
  "zq23a18": "a vaga tava livre.",
  "zq23a19": "Eu comprei.",
  "zq23a20": "Então você",
  "zq23a21": "pagou pra casar comigo?",
  "zq23a22": "Não é da sua conta!",
  "zq23a23": "Eu aposto em mim.",
  "zq23a24": "Que aposta?",
  "zq23a25": "Trinta dias,",
  "zq23a26": "quem vende mais.",
  "zq23a27": "Se a loja ganhar,",
  "zq23a28": {
    "text": "ele retira a queixa e devolve o contrato.",
    "say": "ele retira tudo."
  },
  "zq23a29": "E se perder?",
  "zq23a30": "Aposta?",
  "zq23a31": "Apostando você mesma?",
  "zq23a32": "Trinta dias,",
  "zq23a33": "a Loja do Xu fatura mais.",
  "zq23a34": "E se perder?",
  "zq23a35": {
    "text": "Volto com você pra capital.",
    "say": "Vou junto."
  },
  "zq23a36": "Xiaotang—",
  "zq23a37": "Já calculei.",
  "zq23a38": "Fechado.",
  "zq23a39": "A guilda é testemunha.",
  "zq23a40": "Em trinta dias,",
  "zq23a41": "busco minha noiva.",
  "zq23a42": "Missão obrigatória.",
  "zq23a43": {
    "text": "Guerra comercial de trinta dias:",
    "say": "Trinta dias:"
  },
  "zq23a44": "vencer.",
  "zq23a45": "Falha:",
  "zq23a46": {
    "text": "Afeição de Tang Xiaotang: zero.",
    "say": "Tang Xiaotang: zero."
  }
}
