{
  "zq23a01": "Boatman, turn back!",
  "zq23a02": "You crazy?",
  "zq23a03": "The water's freezing!",
  "zq23a04": "Freezing.",
  "zq23a05": "So pull me up first.",
  "zq23a06": "Why run?",
  "zq23a07": "Truth now.",
  "zq23a08": "If I go back,",
  "zq23a09": "you'll all be safe.",
  "zq23a10": "You're not a prize I won,",
  "zq23a11": "or anyone's debt.",
  "zq23a12": "Tang Xiaotang: affection plus six.",
  "zq23a13": "The chancellor seized",
  "zq23a14": "eight Tang salt ships",
  "zq23a15": "to force Dad's hand.",
  "zq23a16": "Lin Erya?",
  "zq23a17": "The matchmaker said she'd died,",
  "zq23a18": "her place was open.",
  "zq23a19": "I bought it.",
  "zq23a20": "So you",
  "zq23a21": "paid to marry me?",
  "zq23a22": "None of your business!",
  "zq23a23": "I'm betting on myself.",
  "zq23a24": "What?",
  "zq23a25": "Thirty days,",
  "zq23a26": "sales duel.",
  "zq23a27": "If Xu's wins,",
  "zq23a28": "he drops both claims.",
  "zq23a29": "And if you lose?",
  "zq23a30": "Bet?",
  "zq23a31": "With yourself as the stake?",
  "zq23a32": "Thirty days,",
  "zq23a33": "Xu's outsells you.",
  "zq23a34": "And if you lose?",
  "zq23a35": "I go with you.",
  "zq23a36": "Xiaotang—",
  "zq23a37": "I've done the math.",
  "zq23a38": "Fine.",
  "zq23a39": "The guild will witness.",
  "zq23a40": "In thirty days,",
  "zq23a41": "I'll come for my bride.",
  "zq23a42": "Mandatory task.",
  "zq23a43": "Thirty-day trade war:",
  "zq23a44": "win.",
  "zq23a45": "Failure:",
  "zq23a46": "Tang Xiaotang affection: zero."
}
