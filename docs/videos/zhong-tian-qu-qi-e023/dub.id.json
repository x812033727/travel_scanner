{
  "zq23a01": {
    "text": "Pak tukang perahu, putar balik!",
    "say": "Pak, putar balik!"
  },
  "zq23a02": "Kamu gila?",
  "zq23a03": "Airnya dingin banget!",
  "zq23a04": "Dingin.",
  "zq23a05": "Makanya, tarik aku naik dulu.",
  "zq23a06": {
    "text": "Kenapa kabur dari pernikahan?",
    "say": "Kok kabur?"
  },
  "zq23a07": "Kali ini jujur.",
  "zq23a08": "Kalau aku balik,",
  "zq23a09": "kalian semua aman.",
  "zq23a10": "Kamu bukan hadiah buatku,",
  "zq23a11": "juga bukan utang siapa pun.",
  "zq23a12": {
    "text": "Tang Xiaotang, poin suka plus enam.",
    "say": "Tang Xiaotang, plus enam."
  },
  "zq23a13": "Perdana Menteri menyita",
  "zq23a14": {
    "text": "delapan kapal garam keluarga Tang,",
    "say": "delapan kapal garam kami,"
  },
  "zq23a15": {
    "text": "memaksa ayahku menjodohkanku.",
    "say": "maksa Ayah jodohin."
  },
  "zq23a16": "Terus Lin Erya…",
  "zq23a17": {
    "text": "Mak comblang bilang dia sudah meninggal,",
    "say": "Kata comblang, dia meninggal,"
  },
  "zq23a18": "jatahnya kosong.",
  "zq23a19": "Aku yang beli.",
  "zq23a20": "Jadi kamu",
  "zq23a21": {
    "text": "bayar buat nikah sama aku?",
    "say": "bayar buat nikahin aku?"
  },
  "zq23a22": "Bukan urusanmu!",
  "zq23a23": "Aku pertaruhkan diriku.",
  "zq23a24": "Taruhan apa?",
  "zq23a25": "Tiga puluh hari,",
  "zq23a26": "adu omzet.",
  "zq23a27": "Toko Xu menang,",
  "zq23a28": {
    "text": "dia cabut tuntutan, batalkan surat nikahnya.",
    "say": "tuntutan dan nikah batal."
  },
  "zq23a29": "Kalau kalah?",
  "zq23a30": {
    "text": "Taruhan?",
    "say": "Oh?"
  },
  "zq23a31": {
    "text": "Pakai dirimu sendiri sebagai taruhan?",
    "say": "Kau jadi taruhannya?"
  },
  "zq23a32": "Tiga puluh hari,",
  "zq23a33": "omzet Toko Xu kalahkan kamu.",
  "zq23a34": {
    "text": "Kalau kalah?",
    "say": "Kalah?"
  },
  "zq23a35": {
    "text": "Aku ikut kamu ke ibu kota.",
    "say": "Aku ikut kamu."
  },
  "zq23a36": "Xiaotang—",
  "zq23a37": "Aku sudah hitung.",
  "zq23a38": "Baik.",
  "zq23a39": {
    "text": "Serikat dagang jadi saksinya.",
    "say": "Pakai saksi."
  },
  "zq23a40": {
    "text": "Tiga puluh hari lagi,",
    "say": "Sebulan lagi,"
  },
  "zq23a41": {
    "text": "aku jemput pengantinku.",
    "say": "kujemput dia."
  },
  "zq23a42": "Misi wajib.",
  "zq23a43": {
    "text": "Perang dagang tiga puluh hari:",
    "say": "Perang dagang,"
  },
  "zq23a44": "menang.",
  "zq23a45": "Gagal:",
  "zq23a46": {
    "text": "poin suka Tang Xiaotang jadi nol.",
    "say": "Tang Xiaotang, poin suka nol."
  }
}
