    "title": "2f416178056a",
    "description": "c476f996a9b7",
    "tags": "6c41ba6d0feb",
    "thumbnail": "fa5014cfc5e3"
  },
  "lines": {
    "p001": {
      "source_hash": "2c1833cb3d98",
      "text": "所長！枠を四角に"
    },
    "p002": {
      "source_hash": "5f1349115dfb",
      "text": "なのに、出てきた泡は丸いの！"
    },
    "p003": {
      "source_hash": "644f486cab65",
      "text": "色もぐるぐる回って、"
    },
    "p004": {
      "source_hash": "c423c578423b",
      "text": "てっぺん黒くなって割れた！"
    },
    "p005": {
      "source_hash": "6a3f2d4c5507",
      "text": "この枠とこのボトル！"
    },
    "p006": {
      "source_hash": "1e0fb382ab20",
      "text": "見せて。ふつうの枠とシャボン液ね。"
    },
    "p007": {
      "source_hash": "c8460e9a53a5",
      "text": "でも、今の話はどれもふしぎ。"
    },
    "p008": {
      "source_hash": "ca67d5c4d86c",
      "text": "どこが？"
    },
    "p009": {
      "source_hash": "7b2aa479a061",
      "text": "四角い枠で丸い泡。"
    },
    "p010": {
      "source_hash": "ea0aa44d9262",
      "text": "液は無色なのに、泡は色つき。"
    },
    "p011": {
      "source_hash": "e80a82ffee37",
      "text": "ほんと、これ透明なのに！"
    },
    "p012": {
      "source_hash": "3935948ffbe8",
      "text": "まだあるの。泡が二つくっつくと、"
    },
    "p013": {
      "source_hash": "f4ac02459138",
      "text": "かべはどっちに曲がる？あとでね。"
    },
    "p014": {
      "source_hash": "220a249cfe63",
      "text": "てっぺんが黒くなるのも、何かを知らせてるの。"
    },
    "p015": {
      "source_hash": "eba3ca20f144",
      "text": "泡を吹くたびに、目の前で起きてるの。"
    },
    "p016": {
      "source_hash": "5de1d1c11a1d",
      "text": "今日はその枠とボトルで、ぜんぶ見つけよう。"
    },
    "p018": {
      "source_hash": "e3bcc73dfda4",
      "text": "枠一つでいいの？"
    },
    "p019": {
      "source_hash": "4179f4eed892",
      "text": "ええ、吹いてみて。"
    },
    "p021": {
      "source_hash": "158870be05fb",
      "text": "枠にうすい膜ができる！"
    },
    "p022": {
      "source_hash": "8ce25c3ae586",
      "text": "そう、枠の膜は平らね。"
    },
    "p023": {
      "source_hash": "302d6d83d306",
      "text": "吹くと膜がふくらんで、空気を包むの。"
    },
    "p024": {
      "source_hash": "27f416329aef",
      "text": "この膜は何でできてるの？"
    },
    "p025": {
      "source_hash": "9cb864a8c11f",
      "text": "その液よ。水がたくさんと、せっけん少し。"
    },
    "p026": {
      "source_hash": "5fae3f0b5774",
      "text": "せっけんが両側、水が真ん中。うすいサンドイッチね。"
    },
    "p028": {
      "source_hash": "61b3d3b41cf1",
      "text": "なんで四角くならないの？"
    },
    "p029": {
      "source_hash": "edcf9a3de3a9",
      "text": "考えはね、膜は縮みたがってるの。"
    },
    "p030": {
      "source_hash": "bcb0a96f43e9",
      "text": "膜が縮むの？"
    },
    "p031": {
      "source_hash": "597b09a86e30",
      "text": "風船をふくらませたことある？皮がのびてるでしょ。"
    },
    "p032": {
      "source_hash": "6c0bcd25d6e5",
      "text": "手をはなすと、空気をおし出すの。"
    },
    "p033": {
      "source_hash": "0628cf8a2803",
      "text": "うん、ビューンって飛んでく！"
    },
    "p034": {
      "source_hash": "1d06e943bd33",
      "text": "じゃあ、吹くのを途中で止めたら、"
    },
    "p035": {
      "source_hash": "643890298b1c",
      "text": "どうなる？"
    },
    "p036": {
      "source_hash": "812859016d72",
      "text": "残ると思う！"
    },
    "p037": {
      "source_hash": "0346f7c8d0a5",
      "text": "試して。ゆっくり縮んで、"
    },
    "p038": {
      "source_hash": "b02ae5cbd1d3",
      "text": "最後は枠の中で平らな膜にもどるの。"
    },
    "p039": {
      "source_hash": "2f3a7b57117a",
      "text": "縮んだ！"
    },
    "p041": {
      "source_hash": "ba1195711b45",
      "text": "そう。この内側に引っぱって縮む力を、"
    },
    "p042": {
      "source_hash": "56bdfd4f6533",
      "text": "表面張力っていうの。"
    },
    "p187": {
      "source_hash": "2860d6fa2fcc",
      "text": "せっけんで膜がもっと引っぱるの？"
    },
    "p188": {
      "source_hash": "63db3a942336",
      "text": "逆よ。せっけんで表面張力は、水だけの三分の一くらいになるの。"
    },
    "p189": {
      "source_hash": "64409e73bb0b",
      "text": "ただの水は引っぱりすぎるし、すぐ乾いて割れちゃう。"
    },
    "p190": {
      "source_hash": "362bf5e7e32c",
      "text": "せっけんはふたみたいに、膜の水を乾きにくくするの。"
    },
    "p191": {
      "source_hash": "c5c75254bb94",
      "text": "特別な液の泡をびんに入れたら、三か月もったの！"
    },
    "p043": {
      "source_hash": "c23deffb731b",
      "text": "じゃあ、なんで丸く縮むの？"
    },
    "p044": {
      "source_hash": "60e7bf3f87d6",
      "text": "泡が枠をはなれると、空気がとじこめられる。"
    },
    "p045": {
      "source_hash": "610736d03053",
      "text": "空気の量は同じで、膜はいちばん小さい面積で包みたいの。"
    },
    "p046": {
      "source_hash": "5931782d7eed",
      "text": "四角い箱で"
    },
    "p047": {
      "source_hash": "a0fe18fae5b5",
      "text": "だめなの？"
    },
    "p048": {
      "source_hash": "2a39e536f221",
      "text": "損なのよ。同じ空気を包むのに、箱に必要な膜は、"
    },
    "p049": {
      "source_hash": "c00a8eba4558",
      "text": "丸より二割以上多いの。"
    },
    "p050": {
      "source_hash": "3debda93bdf6",
      "text": "どんな形より、膜が少なくてすむのが丸なの。"
    },
    "p052": {
      "source_hash": "064d8321895c",
      "text": "泡もケチるの？"
    },
    "p053": {
      "source_hash": "2c4c7293378f",
      "text": "泡の膜は、縮めるだけ縮んで、少しもゆずらないの。"
    },
    "p054": {
      "source_hash": "e8d2bf424bc4",
      "text": "四角い枠が決めるのは、中の膜だけ。"
    },
    "p055": {
      "source_hash": "73615d9aec09",
      "text": "風船はただのたとえ。しぼむと皮はゆるむけど、"
    },
    "p056": {
      "source_hash": "2e2398a19fc5",
      "text": "泡の膜はどんなに縮んでも引っぱる。"
    },
    "p058": {
      "source_hash": "31aa6f9f8759",
      "text": "いつも丸いの？"
    },
    "p059": {
      "source_hash": "b637c9355166",
      "text": "そうとは限らない。空中にうかぶ、一つだけの泡の話よ。"
    },
    "p060": {
      "source_hash": "07edd2d4a7f1",
      "text": "ぬれたお皿にのると、半分のドームになるの。"
    },
    "p061": {
      "source_hash": "98d1630acc49",
      "text": "二つくっつくと？"
    },
    "p063": {
      "source_hash": "14927abbb594",
      "text": "それが考えのテスト。"
    },
    "p064": {
      "source_hash": "879547f7092f",
      "text": "同じボトルで同じ大きさの泡を二つ吹いて、くっつけてみて。"
    },
    "p065": {
      "source_hash": "b8f95d603f1c",
      "text": "くっついたら割れる！"
    },
    "p066": {
      "source_hash": "cfa31d590623",
      "text": "割れないことが多いの。"
    },
    "p067": {
      "source_hash": "a830dd72d888",
      "text": "二つがくっついて、真ん中に二つで使う平らなかべができるの。"
    },
    "p068": {
      "source_hash": "1a2081289d03",
      "text": "てっきり"
    },
    "p069": {
      "source_hash": "c2b73c10e605",
      "text": "点でさわるだけかと！"
    },
    "p070": {
      "source_hash": "48c5732904ac",
      "text": "それだと膜が多くいるの。"
    },
    "p071": {
      "source_hash": "38ffa95d93b8",
      "text": "やっぱり膜をケチって、かべを一枚共有するほうが得なの。"
    },
    "p072": {
      "source_hash": "46c763f91f2d",
      "text": "なんで平らなの？"
    },
    "p073": {
      "source_hash": "2d69a8e2a4dc",
      "text": "同じ大きさなら、どっちもおせないから平らなの。"
    },
    "p075": {
      "source_hash": "6f5493e7f5b4",
      "text": "大きいのがつぶすよ！"
    },
    "p076": {
      "source_hash": "068a0b78bdae",
      "text": "かべがどっちに曲がるか、聞いたの覚えてる？"
    },
    "p077": {
      "source_hash": "01e84768b312",
      "text": "見て、真ん中のかべは大きい泡のほうにふくらんでる。"
    },
    "p078": {
      "source_hash": "e4f49217efa6",
      "text": "小さいほうが強いの？"
    },
    "p079": {
      "source_hash": "648379a1a936",
      "text": "同じ液なら引っぱる力はほぼ同じ。"
    },
    "p080": {
      "source_hash": "3e3e61878f9f",
      "text": "小さい泡は強く曲がるから"
    },
    "p081": {
      "source_hash": "96be7ceb5d60",
      "text": "小さい泡の膜は、中の空気を強くおしてるの。"
    },
    "p082": {
      "source_hash": "963d74e9876a",
      "text": "だから小さいほうが大きいほうをおすの。"
    },
    "p083": {
      "source_hash": "dde2d641b4a5",
      "text": "小さいの勝ち！"
    },
    "p086": {
      "source_hash": "550203c13a36",
      "text": "色はどこから？"
    },
    "p087": {
      "source_hash": "892549d8bc36",
      "text": "いい質問。絵の具はないわね。じゃあ、泡には膜のほかに何がある？"
    },
    "p089": {
      "source_hash": "1f67125d2214",
      "text": "膜がきつくて"
    },
    "p090": {
      "source_hash": "cf9a57e8b2f4",
      "text": "色つく？"
    },
    "p091": {
      "source_hash": "fe4aed8c3a57",
      "text": "よくある考えね。でもこの力は形の担当。"
    },
    "p092": {
      "source_hash": "1913e022fc27",
      "text": "色は光の担当よ。"
    },
    "p093": {
      "source_hash": "61ff10e2728b",
      "text": "光って白じゃないの？"
    },
    "p094": {
      "source_hash": "695e052be148",
      "text": "白い光は、いろんな色のまざりなの。"
    },
    "p095": {
      "source_hash": "2b516b233f25",
      "text": "そこから一つの色をぬくと、残りは色がついて見えるの。"
    },
    "p096": {
      "source_hash": "c5e7e67ca9d5",
      "text": "一つぬく？"
    },
    "p097": {
      "source_hash": "486d05ac6e12",
      "text": "たとえば白い光から青をぬくと、残りは黄色っぽく見えるの。"
    },
    "p098": {
      "source_hash": "68dcef633180",
      "text": "だれが色をぬくの？"
    },
    "p099": {
      "source_hash": "6535b7ca8d54",
      "text": "膜には表と裏の二つの面がある。"
    },
    "p100": {
      "source_hash": "8a313cd8af16",
      "text": "光が来ると、両方の面が少しずつ光を目にはね返すの。"
    },
    "p102": {
      "source_hash": "adca1d34905a",
      "text": "光が二本も？"
    },
    "p103": {
      "source_hash": "4001a1f77c6c",
      "text": "裏の光は膜を一往復して、"
    },
    "p104": {
      "source_hash": "9794fc311c35",
      "text": "表の光より少し遠回り。"
    },
    "p106": {
      "source_hash": "2588f4a0f6b8",
      "text": "それで？"
    },
    "p107": {
      "source_hash": "bc275bc53317",
      "text": "水の波で考えよう。池に小石を二つ、同時に投げてみて。"
    },
    "p108": {
      "source_hash": "51c1e3d6a438",
      "text": "波が重なると、高い同士はもっと高く、"
    },
    "p109": {
      "source_hash": "bdef59677f6e",
      "text": "高いと低いは打ち消して、平らになるの。"
    },
    "p111": {
      "source_hash": "1081b69c48ba",
      "text": "平らなところあった！"
    },
    "p112": {
      "source_hash": "486604335217",
      "text": "そう、そこが二つの波が打ち消しあったところ。"
    },
    "p113": {
      "source_hash": "856a97d24f32",
      "text": "光も波と考えられるの。二本がぶつかると、"
    },
    "p114": {
      "source_hash": "d73f0180fa66",
      "text": "強まる色と、打ち消される色があるの。"
    },
    "p115": {
      "source_hash": "a4101291db89",
      "text": "どの色が消えるの？"
    },
    "p116": {
      "source_hash": "9fd7d529aad2",
      "text": "わたしの考えは、膜の厚さしだい。"
    },
    "p117": {
      "source_hash": "e1092e30b143",
      "text": "厚さが変わると、裏の光の遠回りも変わって、"
    },
    "p118": {
      "source_hash": "68298f53fe38",
      "text": "消える色が変わり、見える色も変わるの。"
    },
    "p119": {
      "source_hash": "f2a7bbcc1708",
      "text": "たとえば赤が消えると、残りは青緑っぽくなるの。"
    },
    "p121": {
      "source_hash": "f473323a7cef",
      "text": "どう確かめる？"
    },
    "p122": {
      "source_hash": "627c61edc3ca",
      "text": "その液で、枠に泡を吹いて飛ばさずに、"
    },
    "p123": {
      "source_hash": "9a2153a25f20",
      "text": "頭を止めて見て。"
    },
    "p125": {
      "source_hash": "0a5e3534c9cf",
      "text": "横のしまだ！"
    },
    "p126": {
      "source_hash": "52c951bc7073",
      "text": "そう。液は地球に下へ引っぱられて、ゆっくり流れ落ちるの。"
    },
    "p127": {
      "source_hash": "f99654c031f8",
      "text": "下は厚く、上はどんどんうすくなって、色がしまにならぶの。"
    },
    "p128": {
      "source_hash": "ec4ec3b1642d",
      "text": "しかもずっと下に動いてる！"
    },
    "p129": {
      "source_hash": "217894617fd8",
      "text": "時間がたつと膜はうすくなり、しまが下へ移っていくの。"
    },
    "p130": {
      "source_hash": "4e519c48bb74",
      "text": "考え、覚えてる？合格よ。"
    },
    "p132": {
      "source_hash": "378d4f739be1",
      "text": "なんで色がうずまくの？"
    },
    "p133": {
      "source_hash": "a643f976292c",
      "text": "風が吹くと、液が膜の中を流れて、"
    },
    "p134": {
      "source_hash": "133faca30ff0",
      "text": "厚い所とうすい所が入れかわり、色がうずまくの。"
    },
    "p135": {
      "source_hash": "9360acdf6ae0",
      "text": "黒いてっぺんは何かを知らせてる、って言ったよね？"
    },
    "p136": {
      "source_hash": "80a3b28355ca",
      "text": "うん！なんで黒くなるの？"
    },
    "p137": {
      "source_hash": "dde0eac074ea",
      "text": "てっぺんの膜は光の波よりずっとうすくて、どんな色の光も"
    },
    "p138": {
      "source_hash": "7162ac10f422",
      "text": "消しあうの。"
    },
    "p139": {
      "source_hash": "fd9f34257055",
      "text": "光が目に返らないから、黒く見えるの。"
    },
    "p141": {
      "source_hash": "595e4995d281",
      "text": "割れる合図？"
    },
    "p142": {
      "source_hash": "35ae0a330632",
      "text": "うすすぎて、もう限界って。"
    },
    "p143": {
      "source_hash": "54be2996f2fb",
      "text": "アメリカ・サンフランシスコの科学館によると、その膜は"
    },
    "p144": {
      "source_hash": "d0cf5c00f2e2",
      "text": "1ミリの4万分の1くらいしかないの。"
    },
    "p145": {
      "source_hash": "5a5d1cc37e9c",
      "text": "でも黒くなってすぐじゃなく、少しもつことが多いの。"
    },
    "p146": {
      "source_hash": "324ff8a549e4",
      "text": "早く見なきゃ！"
    },
    "p148": {
      "source_hash": "aafadd39069c",
      "text": "首かしげたら"
    },
    "p149": {
      "source_hash": "85fbde35f2e2",
      "text": "色も変わった！"
    },
    "p150": {
      "source_hash": "07360e16a9ab",
      "text": "いい観察。首をかしげた瞬間に膜がうすくなった？"
    },
    "p152": {
      "source_hash": "2db7d27b6eca",
      "text": "そんな偶然ないよね？"
    },
    "p153": {
      "source_hash": "456aa14ad5e7",
      "text": "そう。膜の厚さは同じ。"
    },
    "p154": {
      "source_hash": "b490ad14f903",
      "text": "変わったのは光が目にはね返る向き。"
    },
    "p155": {
      "source_hash": "33a5abe4a208",
      "text": "ななめだと、裏の光の遠回りが、"
    },
    "p156": {
      "source_hash": "fe73cc3aeb89",
      "text": "まっすぐの時と変わるの。"
    },
    "p157": {
      "source_hash": "71809dcaa059",
      "text": "また遠回りだ！"
    },
    "p158": {
      "source_hash": "8d28923ff507",
      "text": "そう、また手がかり。厚さだけ見てたけど"
    },
    "p159": {
      "source_hash": "62a5c9f12ffe",
      "text": "首をかしげて、補ってくれたね。"
    },
    "p161": {
      "source_hash": "88fd70dc7ec4",
      "text": "どっちか見分けるの？"
    },
    "p162": {
      "source_hash": "3cafdbe544b1",
      "text": "下へ流れる色は、膜がうすくなってるの。"
    },
    "p163": {
      "source_hash": "98706a7504e5",
      "text": "泡は動かず、首をかしげて色がとぶなら、向きの変化よ。"
    },
    "p164": {
      "source_hash": "fe6b16328f0c",
      "text": "正直に言うと、"
    },
    "p165": {
      "source_hash": "e8ec3ce2a077",
      "text": "色だけで、膜の厚さをぴったり測ることはできないの。"
    },
    "p166": {
      "source_hash": "059491d288fc",
      "text": "なんでできないの？"
    },
    "p167": {
      "source_hash": "e28ded057821",
      "text": "うすくなるとき、同じ色が何回も出るから、"
    },
    "p168": {
      "source_hash": "397b29e23ed5",
      "text": "色じゃ何回目かわからない。"
    },
    "p169": {
      "source_hash": "dd8beab12f27",
      "text": "ぐるぐるだ！"
    },
    "p170": {
      "source_hash": "67f2ccac9d2e",
      "text": "そう、だから色は手がかりで、ものさしにはならないの。"
    },
    "p171": {
      "source_hash": "e67c929653e2",
      "text": "形と色って、"
    },
    "p172": {
      "source_hash": "d8fe60bf2796",
      "text": "関係あるの？"
    },
    "p173": {
      "source_hash": "816dae1fc838",
      "text": "あるわ。自分でさがしてみて。四角い枠と黒くなるの、どこが同じ？"
    },
    "p174": {
      "source_hash": "36d742bcb996",
      "text": "なるほど！"
    },
    "p175": {
      "source_hash": "9a20c71b8fd0",
      "text": "ぜんぶ同じ膜！"
    },
    "p177": {
      "source_hash": "d302454aa426",
      "text": "縮んで丸く、うすくなって色が変わる！"
    },
    "p178": {
      "source_hash": "f28f44704e26",
      "text": "いいわね。形と色を、ハテナがつなげたね。"
    },
    "p179": {
      "source_hash": "e1e4953a583d",
      "text": "いちばんおもしろいのは、毎日吹く泡に、こんなにひみつがあること。"
    },
    "p180": {
      "source_hash": "aca8d6f3219d",
      "text": "もう一個吹く！"
    },
    "p181": {
      "source_hash": "10fc62dabf90",
      "text": "いいわよ。今度は泡を枠に残して、うしろに暗いかべを置いて、"
    },
    "p182": {
      "source_hash": "66fe5a4216d0",
      "text": "てっぺんが黒くなる前、最後の色を見てね。"
    },
    "p183": {
      "source_hash": "bf01f5591e16",
      "text": "吹いてくる！"
    },
    "p184": {
      "source_hash": "71b7a2e672cd",
      "text": "黒くなる前、最後は何色だった？"
    },
    "p185": {
      "source_hash": "fe508e80b52e",
      "text": "コメントしてね"
    },
    "p186": {
      "source_hash": "88de677d4daa",
      "text": "暮らしの「なぜ」を一緒に探すなら、なるほど事務所をチャンネル登録！"
    }
  }
}
