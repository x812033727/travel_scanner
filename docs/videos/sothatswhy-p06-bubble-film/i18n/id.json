  },
  "lines": {
    "p001": {
      "source_hash": "2c1833cb3d98",
      "text": "Bu! Aku bikin tongkat kotak,"
    },
    "p002": {
      "source_hash": "5f1349115dfb",
      "text": "gelembungnya tetap bulat!"
    },
    "p003": {
      "source_hash": "644f486cab65",
      "text": "Warnanya juga berputar,"
    },
    "p004": {
      "source_hash": "c423c578423b",
      "text": "lalu atasnya hitam, dan pecah!"
    },
    "p005": {
      "source_hash": "6a3f2d4c5507",
      "text": "Pakai ini dan ini!"
    },
    "p006": {
      "source_hash": "1e0fb382ab20",
      "text": "Coba lihat. Tongkat dan air sabun biasa."
    },
    "p007": {
      "source_hash": "c8460e9a53a5",
      "text": "Tapi semua ceritamu aneh sekali."
    },
    "p008": {
      "source_hash": "ca67d5c4d86c",
      "text": "Aneh di mana?"
    },
    "p009": {
      "source_hash": "7b2aa479a061",
      "text": "Bingkai kotak, tapi bulat."
    },
    "p010": {
      "source_hash": "ea0aa44d9262",
      "text": "Airnya bening, tapi ada warna."
    },
    "p011": {
      "source_hash": "e80a82ffee37",
      "text": "Iya, botol ini kan bening!"
    },
    "p012": {
      "source_hash": "3935948ffbe8",
      "text": "Lagi: dua gelembung menempel,"
    },
    "p013": {
      "source_hash": "f4ac02459138",
      "text": "dindingnya condong ke mana? Nanti tahu."
    },
    "p014": {
      "source_hash": "220a249cfe63",
      "text": "Puncak hitam itu juga ada artinya."
    },
    "p015": {
      "source_hash": "eba3ca20f144",
      "text": "Ini terjadi tiap kamu tiup,"
    },
    "p016": {
      "source_hash": "5de1d1c11a1d",
      "text": "hari ini kita cari semua pakai tongkatmu."
    },
    "p017": {
      "source_hash": "a1f280298881",
      "text": "Masa?"
    },
    "p018": {
      "source_hash": "e3bcc73dfda4",
      "text": "Cukup satu tongkat?"
    },
    "p019": {
      "source_hash": "4179f4eed892",
      "text": "Cukup. Ayo, coba tiup di sini."
    },
    "p020": {
      "source_hash": "7bd217a00b6f",
      "text": "Celup,"
    },
    "p021": {
      "source_hash": "158870be05fb",
      "text": "ada lapisan tipis di bingkai!"
    },
    "p022": {
      "source_hash": "8ce25c3ae586",
      "text": "Ya, lapisannya datar."
    },
    "p023": {
      "source_hash": "302d6d83d306",
      "text": "Kalau ditiup, ia membungkus udara."
    },
    "p024": {
      "source_hash": "27f416329aef",
      "text": "Lapisan itu dari apa?"
    },
    "p025": {
      "source_hash": "9cb864a8c11f",
      "text": "Banyak air, ditambah sedikit sabun."
    },
    "p026": {
      "source_hash": "5fae3f0b5774",
      "text": "Sabun di kedua sisi, air di tengah, seperti roti isi."
    },
    "p027": {
      "source_hash": "8b6459de6b32",
      "text": "Tapi bentuknya kotak,"
    },
    "p028": {
      "source_hash": "61b3d3b41cf1",
      "text": "kok hasilnya bulat?"
    },
    "p029": {
      "source_hash": "edcf9a3de3a9",
      "text": "Dugaanku: lapisan ini mau terus mengecil."
    },
    "p030": {
      "source_hash": "bcb0a96f43e9",
      "text": "Bisa mengecil?"
    },
    "p031": {
      "source_hash": "597b09a86e30",
      "text": "Pernah tiup balon? Karetnya teregang."
    },
    "p032": {
      "source_hash": "6c0bcd25d6e5",
      "text": "Dilepas, udaranya diperas."
    },
    "p033": {
      "source_hash": "0628cf8a2803",
      "text": "Iya, terbangnya ke mana-mana!"
    },
    "p034": {
      "source_hash": "1d06e943bd33",
      "text": "Coba: tiup sedikit, lalu stop,"
    },
    "p035": {
      "source_hash": "643890298b1c",
      "text": "Jadinya apa?"
    },
    "p036": {
      "source_hash": "812859016d72",
      "text": "Kurasa tetap di situ!"
    },
    "p037": {
      "source_hash": "0346f7c8d0a5",
      "text": "Coba. Pelan-pelan mengecil,"
    },
    "p038": {
      "source_hash": "b02ae5cbd1d3",
      "text": "akhirnya kembali jadi lapisan datar."
    },
    "p039": {
      "source_hash": "2f3a7b57117a",
      "text": "Betul!"
    },
    "p040": {
      "source_hash": "8df76ba30f1a",
      "text": "Memeras seperti balon!"
    },
    "p041": {
      "source_hash": "ba1195711b45",
      "text": "Ya. Tarikan ke dalam ini namanya"
    },
    "p042": {
      "source_hash": "56bdfd4f6533",
      "text": "tegangan permukaan."
    },
    "p043": {
      "source_hash": "c23deffb731b",
      "text": "Kenapa jadinya bulat?"
    },
    "p044": {
      "source_hash": "60e7bf3f87d6",
      "text": "Begitu lepas, udaranya terkurung."
    },
    "p045": {
      "source_hash": "610736d03053",
      "text": "Udara sama, lapisan mau luas sekecil mungkin."
    },
    "p046": {
      "source_hash": "5931782d7eed",
      "text": "Jadi kotak,"
    },
    "p047": {
      "source_hash": "a0fe18fae5b5",
      "text": "tidak bisa?"
    },
    "p048": {
      "source_hash": "2a39e536f221",
      "text": "Rugi. Untuk udara sama, kotak butuh"
    },
    "p049": {
      "source_hash": "c00a8eba4558",
      "text": "lapisan 20% lebih banyak."
    },
    "p050": {
      "source_hash": "3debda93bdf6",
      "text": "Dari semua bentuk, bola paling sedikit."
    },
    "p051": {
      "source_hash": "7e951f4e065e",
      "text": "Segitu,"
    },
    "p052": {
      "source_hash": "064d8321895c",
      "text": "juga mau hemat?"
    },
    "p053": {
      "source_hash": "2c4c7293378f",
      "text": "Bisa mengecil, ya mengecil. Tak mau lebih."
    },
    "p054": {
      "source_hash": "e8d2bf424bc4",
      "text": "Tongkatmu cuma atur lapisan di dalam."
    },
    "p055": {
      "source_hash": "73615d9aec09",
      "text": "Balon cuma perumpamaan. Kempes, karetnya kendur;"
    },
    "p056": {
      "source_hash": "2e2398a19fc5",
      "text": "lapisan sabun tetap menarik terus."
    },
    "p057": {
      "source_hash": "e02cb6685a38",
      "text": "Jadi,"
    },
    "p058": {
      "source_hash": "31aa6f9f8759",
      "text": "selalu bulat?"
    },
    "p059": {
      "source_hash": "b637c9355166",
      "text": "Tak selalu. Itu yang sendirian di udara."
    },
    "p060": {
      "source_hash": "07edd2d4a7f1",
      "text": "Di piring basah, jadi kubah."
    },
    "p061": {
      "source_hash": "98d1630acc49",
      "text": "Dua nempel?"
    },
    "p062": {
      "source_hash": "c407547accd1",
      "text": "Masih bulat?"
    },
    "p063": {
      "source_hash": "14927abbb594",
      "text": "Itu ujiannya."
    },
    "p064": {
      "source_hash": "879547f7092f",
      "text": "Tiup dua yang sama besar, lalu tempelkan."
    },
    "p065": {
      "source_hash": "b8f95d603f1c",
      "text": "Pasti langsung pecah!"
    },
    "p066": {
      "source_hash": "cfa31d590623",
      "text": "Seringnya menempel."
    },
    "p067": {
      "source_hash": "a830dd72d888",
      "text": "Di tengah ada dinding bersama, dan dindingnya datar."
    },
    "p068": {
      "source_hash": "1a2081289d03",
      "text": "Kukira,"
    },
    "p069": {
      "source_hash": "c2b73c10e605",
      "text": "cuma satu titik!"
    },
    "p070": {
      "source_hash": "48c5732904ac",
      "text": "Itu boros lapisan."
    },
    "p071": {
      "source_hash": "38ffa95d93b8",
      "text": "Hemat: berbagi satu dinding lebih irit."
    },
    "p072": {
      "source_hash": "46c763f91f2d",
      "text": "Kenapa dindingnya datar?"
    },
    "p073": {
      "source_hash": "2d69a8e2a4dc",
      "text": "Sama besar, saling imbang, jadi datar."
    },
    "p074": {
      "source_hash": "f90196f9c607",
      "text": "Beda besar?"
    },
    "p075": {
      "source_hash": "6f5493e7f5b4",
      "text": "Yang besar menang!"
    },
    "p076": {
      "source_hash": "068a0b78bdae",
      "text": "Ingat, dindingnya condong ke mana?"
    },
    "p077": {
      "source_hash": "01e84768b312",
      "text": "Lihat, dinding menonjol ke yang besar."
    },
    "p078": {
      "source_hash": "e4f49217efa6",
      "text": "Si kecil lebih kuat?"
    },
    "p079": {
      "source_hash": "648379a1a936",
      "text": "Begini: sabunnya sama, tarikannya mirip,"
    },
    "p080": {
      "source_hash": "3e3e61878f9f",
      "text": "tapi lengkung si kecil tajam,"
    },
    "p081": {
      "source_hash": "96be7ceb5d60",
      "text": "jadi udara di dalamnya ditekan lebih kuat,"
    },
    "p082": {
      "source_hash": "963d74e9876a",
      "text": "makanya si kecil mendorong."
    },
    "p083": {
      "source_hash": "dde2d641b4a5",
      "text": "Si kecil menang!"
    },
    "p084": {
      "source_hash": "f567ad5159a1",
      "text": "Oke, paham."
    },
    "p085": {
      "source_hash": "c575dd10d566",
      "text": "Tapi airnya bening,"
    },
    "p086": {
      "source_hash": "550203c13a36",
      "text": "warna dari mana?"
    },
    "p087": {
      "source_hash": "892549d8bc36",
      "text": "Pertanyaan bagus. Tak ada cat, jadi selain lapisan, ada apa lagi?"
    },
    "p088": {
      "source_hash": "38d74b8ed569",
      "text": "Tidak!"
    },
    "p089": {
      "source_hash": "1f67125d2214",
      "text": "Tarikan kuat"
    },
    "p090": {
      "source_hash": "cf9a57e8b2f4",
      "text": "bikin berwarna?"
    },
    "p091": {
      "source_hash": "fe4aed8c3a57",
      "text": "Banyak yang kira. Tarikan itu urus bentuk,"
    },
    "p092": {
      "source_hash": "1913e022fc27",
      "text": "warna urusan cahaya."
    },
    "p093": {
      "source_hash": "61ff10e2728b",
      "text": "Cahaya kan putih?"
    },
    "p094": {
      "source_hash": "695e052be148",
      "text": "Putih itu gabungan warna."
    },
    "p095": {
      "source_hash": "2b516b233f25",
      "text": "Kalau satu dibuang, sisanya jadi berwarna."
    },
    "p096": {
      "source_hash": "c5e7e67ca9d5",
      "text": "Dibuang satu?"
    },
    "p097": {
      "source_hash": "486d05ac6e12",
      "text": "Misalnya, biru dibuang dari putih, sisanya kekuningan."
    },
    "p098": {
      "source_hash": "68dcef633180",
      "text": "Siapa yang buang?"
    },
    "p099": {
      "source_hash": "6535b7ca8d54",
      "text": "Sisi luar dan dalam."
    },
    "p100": {
      "source_hash": "8a313cd8af16",
      "text": "Keduanya memantulkan cahaya ke matamu."
    },
    "p101": {
      "source_hash": "0babc9e1d817",
      "text": "Satu,"
    },
    "p102": {
      "source_hash": "adca1d34905a",
      "text": "pantulannya dua?"
    },
    "p103": {
      "source_hash": "4001a1f77c6c",
      "text": "Ya. Yang dalam pulang-pergi,"
    },
    "p104": {
      "source_hash": "9794fc311c35",
      "text": "jalannya sedikit lebih panjang."
    },
    "p105": {
      "source_hash": "3c1a574d9111",
      "text": "Sedikit,"
    },
    "p106": {
      "source_hash": "2588f4a0f6b8",
      "text": "terus?"
    },
    "p107": {
      "source_hash": "bc275bc53317",
      "text": "Bayangkan riak air. Lempar dua batu kecil ke kolam bersamaan."
    },
    "p108": {
      "source_hash": "51c1e3d6a438",
      "text": "Tinggi ketemu tinggi, jadi makin tinggi;"
    },
    "p109": {
      "source_hash": "bdef59677f6e",
      "text": "tinggi ketemu rendah, hilang, airnya datar."
    },
    "p110": {
      "source_hash": "c2adc2ca7cf0",
      "text": "Pernah!"
    },
    "p111": {
      "source_hash": "1081b69c48ba",
      "text": "Ada bagian datar!"
    },
    "p112": {
      "source_hash": "486604335217",
      "text": "Ya, di situ dua riak saling menghapus."
    },
    "p113": {
      "source_hash": "856a97d24f32",
      "text": "Cahaya juga gelombang. Bertemu,"
    },
    "p114": {
      "source_hash": "d73f0180fa66",
      "text": "ada warna kuat, ada yang hilang."
    },
    "p115": {
      "source_hash": "a4101291db89",
      "text": "Warna mana hilang?"
    },
    "p116": {
      "source_hash": "9fd7d529aad2",
      "text": "Tergantung tebal lapisan."
    },
    "p117": {
      "source_hash": "e1092e30b143",
      "text": "Tebalnya berubah, jalan tambahan cahaya dalam berubah,"
    },
    "p118": {
      "source_hash": "68298f53fe38",
      "text": "warnanya pun ikut berganti."
    },
    "p119": {
      "source_hash": "f2a7bbcc1708",
      "text": "Misalnya merah hilang, sisanya biru kehijauan."
    },
    "p120": {
      "source_hash": "55997cc62cee",
      "text": "Gimana"
    },
    "p121": {
      "source_hash": "f473323a7cef",
      "text": "buktikannya?"
    },
    "p122": {
      "source_hash": "627c61edc3ca",
      "text": "Tiup gelembung di tongkat, jangan dilepas,"
    },
    "p123": {
      "source_hash": "9a2153a25f20",
      "text": "diam, lalu amati."
    },
    "p124": {
      "source_hash": "2d65de73ab6d",
      "text": "Warnanya jadi garis,"
    },
    "p125": {
      "source_hash": "0a5e3534c9cf",
      "text": "garis mendatar!"
    },
    "p126": {
      "source_hash": "52c951bc7073",
      "text": "Ya. Bumi menarik air sabun ke bawah pelan-pelan,"
    },
    "p127": {
      "source_hash": "f99654c031f8",
      "text": "bawah lebih tebal, atas makin tipis, warnanya berjajar garis."
    },
    "p128": {
      "source_hash": "ec4ec3b1642d",
      "text": "Dan garisnya terus turun!"
    },
    "p129": {
      "source_hash": "217894617fd8",
      "text": "Lama-lama lapisan menipis, warna bergeser turun."
    },
    "p130": {
      "source_hash": "4e519c48bb74",
      "text": "Ingat dugaanku? Lulus!"
    },
    "p131": {
      "source_hash": "b10c85724706",
      "text": "Awalnya,"
    },
    "p132": {
      "source_hash": "378d4f739be1",
      "text": "kenapa warna berputar?"
    },
    "p133": {
      "source_hash": "a643f976292c",
      "text": "Kena angin, airnya mengalir,"
    },
    "p134": {
      "source_hash": "133faca30ff0",
      "text": "tebal-tipis bertukar, warna berputar."
    },
    "p135": {
      "source_hash": "9360acdf6ae0",
      "text": "Ingat, puncak hitam itu memberi tanda?"
    },
    "p136": {
      "source_hash": "80a3b28355ca",
      "text": "Ingat! Kenapa jadi hitam?"
    },
    "p137": {
      "source_hash": "dde0eac074ea",
      "text": "Puncak jauh lebih tipis dari gelombang cahaya; semua warna"
    },
    "p138": {
      "source_hash": "7162ac10f422",
      "text": "saling menghapus."
    },
    "p139": {
      "source_hash": "fd9f34257055",
      "text": "Tak ada pantulan, jadi hitam."
    },
    "p140": {
      "source_hash": "8e634451b1a8",
      "text": "Hitam itu"
    },
    "p141": {
      "source_hash": "595e4995d281",
      "text": "tanda mau pecah?"
    },
    "p142": {
      "source_hash": "35ae0a330632",
      "text": "Artinya: aku hampir robek."
    },
    "p143": {
      "source_hash": "54be2996f2fb",
      "text": "Kata museum sains di San Francisco, puncaknya"
    },
    "p144": {
      "source_hash": "d0cf5c00f2e2",
      "text": "kira-kira 1/40.000 milimeter."
    },
    "p145": {
      "source_hash": "5a5d1cc37e9c",
      "text": "Tapi sering masih bertahan sebentar."
    },
    "p146": {
      "source_hash": "324ff8a549e4",
      "text": "Mau lihat!"
    },
    "p147": {
      "source_hash": "7878e2cdfd38",
      "text": "Bu,"
    },
    "p148": {
      "source_hash": "aafadd39069c",
      "text": "miring,"
    },
    "p149": {
      "source_hash": "85fbde35f2e2",
      "text": "warnanya berubah!"
    },
    "p150": {
      "source_hash": "07360e16a9ab",
      "text": "Bagus. Apa lapisannya menipis tepat saat kamu miring?"
    },
    "p151": {
      "source_hash": "a68242ecc516",
      "text": "Rasanya…"
    },
    "p152": {
      "source_hash": "2db7d27b6eca",
      "text": "tidak sekebetulan itu?"
    },
    "p153": {
      "source_hash": "456aa14ad5e7",
      "text": "Betul. Tebalnya tetap,"
    },
    "p154": {
      "source_hash": "b490ad14f903",
      "text": "yang berubah arah cahaya ke matamu."
    },
    "p155": {
      "source_hash": "33a5abe4a208",
      "text": "Kalau miring, jalan tambahannya"
    },
    "p156": {
      "source_hash": "fe73cc3aeb89",
      "text": "beda panjang dengan saat lurus."
    },
    "p157": {
      "source_hash": "71809dcaa059",
      "text": "Jalan tambahan lagi!"
    },
    "p158": {
      "source_hash": "8d28923ff507",
      "text": "Petunjuk baru. Aku cuma menebak tebal,"
    },
    "p159": {
      "source_hash": "62a5c9f12ffe",
      "text": "kamu melengkapinya dengan miring."
    },
    "p160": {
      "source_hash": "102d28ad46db",
      "text": "Cara bedainnya,"
    },
    "p161": {
      "source_hash": "88fd70dc7ec4",
      "text": "mana yang berubah?"
    },
    "p162": {
      "source_hash": "3cafdbe544b1",
      "text": "Warna turun? Itu lapisan menipis;"
    },
    "p163": {
      "source_hash": "98706a7504e5",
      "text": "gelembung diam, warna lompat saat miring: itu arah."
    },
    "p164": {
      "source_hash": "fe6b16328f0c",
      "text": "Jujur saja:"
    },
    "p165": {
      "source_hash": "e8ec3ce2a077",
      "text": "dari warna, tebal tak bisa diukur tepat."
    },
    "p166": {
      "source_hash": "059491d288fc",
      "text": "Kenapa tidak?"
    },
    "p167": {
      "source_hash": "e28ded057821",
      "text": "Saat menipis, satu warna muncul lagi,"
    },
    "p168": {
      "source_hash": "397b29e23ed5",
      "text": "warna tak bilang yang mana."
    },
    "p169": {
      "source_hash": "dd8beab12f27",
      "text": "Muter-muter!"
    },
    "p170": {
      "source_hash": "67f2ccac9d2e",
      "text": "Ya, warna cuma petunjuk, bukan penggaris."
    },
    "p171": {
      "source_hash": "e67c929653e2",
      "text": "Bentuk dan warna,"
    },
    "p172": {
      "source_hash": "d8fe60bf2796",
      "text": "ada hubungannya?"
    },
    "p173": {
      "source_hash": "816dae1fc838",
      "text": "Ada. Cari sendiri: tongkat kotak dan hitam, apa samanya?"
    },
    "p174": {
      "source_hash": "36d742bcb996",
      "text": "Begitu!"
    },
    "p175": {
      "source_hash": "9a20c71b8fd0",
      "text": "Satu lapisan:"
    },
    "p176": {
      "source_hash": "907a9b8c2bf7",
      "text": "katamu,"
    },
    "p177": {
      "source_hash": "d302454aa426",
      "text": "mengecil: bulat; menipis: warna!"
    },
    "p178": {
      "source_hash": "f28f44704e26",
      "text": "Bagus, kamu sambungkan keduanya."
    },
    "p179": {
      "source_hash": "e1e4953a583d",
      "text": "Serunya: gelembung sehari-hari menyimpan banyak hal."
    },
    "p180": {
      "source_hash": "aca8d6f3219d",
      "text": "Aku tiup lagi!"
    },
    "p181": {
      "source_hash": "10fc62dabf90",
      "text": "Oke. Biarkan di tongkat, latarnya dinding gelap,"
    },
    "p182": {
      "source_hash": "66fe5a4216d0",
      "text": "lihat warna terakhir sebelum hitam."
    },
    "p183": {
      "source_hash": "bf01f5591e16",
      "text": "Oke, aku tiup!"
    },
    "p184": {
      "source_hash": "71b7a2e672cd",
      "text": "Warna apa sebelum hitam?"
    },
    "p185": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar ya!"
    },
    "p186": {
      "source_hash": "88de677d4daa",
      "text": "Cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
