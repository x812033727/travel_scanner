{
  "zq11a01": "Tuan,",
  "zq11a02": "Bawa daftar resmi?",
  "zq11a03": "Tuan?",
  "zq11a04": "Daftar?",
  "zq11a05": "Buronan buat apa daftar!",
  "zq11a06": "Dia terdaftar,",
  "zq11a07": "istriku yang sah.",
  "zq11a08": "Tangkap?",
  "zq11a09": "Perlu surat perintah provinsi.",
  "zq11a10": "Suratnya mana?",
  "zq11a11": "Ngawur!",
  "zq11a12": {
    "text": "Hukum Keluarga, pasal dua belas:",
    "say": "Hukum Keluarga dua belas,"
  },
  "zq11a13": "yang terdaftar,",
  "zq11a14": "tanpa surat provinsi,",
  "zq11a15": "dilarang ditangkap.",
  "zq11a16": "Juru tulis, ada pasal itu?",
  "zq11a17": "Pasal tiga belas,",
  "zq11a18": "masih mau dengar?",
  "zq11a19": {
    "text": "Hafalnya ngalahin juru tulis.",
    "say": "Ngalahin juru tulis."
  },
  "zq11a20": "Tuan, nggak ada suratnya.",
  "zq11a21": {
    "text": "Tuan,",
    "say": "Hm,"
  },
  "zq11a22": "cek daftar.",
  "zq11a23": {
    "text": "Kalau begitu, kirim ke provinsi,",
    "say": "Kirim ke provinsi,"
  },
  "zq11a24": "periksa daftarnya!",
  "zq11a25": {
    "text": "Peringatan: daftar diperiksa,",
    "say": "Peringatan: diperiksa,"
  },
  "zq11a26": "semua identitas terbongkar.",
  "zq11a27": "Silakan.",
  "zq11a28": "Capnya,",
  "zq11a29": "Tuan sendiri yang cap kemarin.",
  "zq11a30": "Buronan dinikahkan,",
  "zq11a31": {
    "text": "provinsi hukum siapa dulu?",
    "say": "siapa dihukum?"
  },
  "zq11a32": "I… ini…",
  "zq11a33": "Mun… mundur!",
  "zq11a34": "Sarjana Xu,",
  "zq11a35": {
    "text": "saya beri kamu jalan keluar.",
    "say": "ada jalan."
  },
  "zq11a36": {
    "text": "Serahkan dia,",
    "say": "Serahkan,"
  },
  "zq11a37": "daftar tak usah diperiksa.",
  "zq11a38": "Saya tunggu jawabanmu."
}
