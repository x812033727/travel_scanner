{
  "zq11a01": "Sir,",
  "zq11a02": "brought the register?",
  "zq11a03": "Sir?",
  "zq11a04": "Register?",
  "zq11a05": "A fugitive needs no register!",
  "zq11a06": "She's registered,",
  "zq11a07": "as my lawful wife.",
  "zq11a08": "Seize?",
  "zq11a09": "That takes a prefecture warrant.",
  "zq11a10": "Got one?",
  "zq11a11": "Nonsense!",
  "zq11a12": "Household law, twelve:",
  "zq11a13": "the registered,",
  "zq11a14": "without a prefecture warrant,",
  "zq11a15": "may not be seized.",
  "zq11a16": "Clerk, is that real?",
  "zq11a17": "Thirteen?",
  "zq11a18": "shall I go on?",
  "zq11a19": "She knows it better than his clerk.",
  "zq11a20": "Sir, there's no warrant.",
  "zq11a21": "Hm.",
  "zq11a22": "check the register.",
  "zq11a23": "Then send it to the prefecture",
  "zq11a24": "and check the register!",
  "zq11a25": "Warning: once the register's checked,",
  "zq11a26": "every identity is exposed.",
  "zq11a27": "Check away.",
  "zq11a28": "Seal—",
  "zq11a29": "you stamped it yesterday, sir.",
  "zq11a30": "Wed a fugitive…",
  "zq11a31": "who's punished?",
  "zq11a32": "Th-this is…",
  "zq11a33": "B-back off!",
  "zq11a34": "Scholar Xu,",
  "zq11a35": "I'll give you a way out.",
  "zq11a36": "Hand her over,",
  "zq11a37": "and no register check.",
  "zq11a38": "I await your answer."
}
