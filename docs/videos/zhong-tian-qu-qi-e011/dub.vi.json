{
  "zq11a01": "Đại nhân,",
  "zq11a02": "có mang sổ không?",
  "zq11a03": "Đại nhân?",
  "zq11a04": "Sổ?",
  "zq11a05": "Khâm phạm cần gì sổ sách!",
  "zq11a06": "Nàng đã vào sổ,",
  "zq11a07": "là vợ phối hôn.",
  "zq11a08": "Bắt người,",
  "zq11a09": "phải có văn thư truy nã châu phủ.",
  "zq11a10": "Văn thư đâu?",
  "zq11a11": "Nói nhảm!",
  "zq11a12": "Hộ hôn luật, điều mười hai,",
  "zq11a13": "người đã vào sổ,",
  "zq11a14": "không có văn thư châu phủ,",
  "zq11a15": "không được bắt giữ.",
  "zq11a16": "Sư gia, có điều này à?",
  "zq11a17": "Điều mười ba,",
  "zq11a18": "còn cần đọc không?",
  "zq11a19": "Thuộc hơn cả sư gia.",
  "zq11a20": "Đại nhân, không có văn thư.",
  "zq11a21": "Ừm,",
  "zq11a22": "tra sổ đi.",
  "zq11a23": "Vậy thì gửi lên châu phủ,",
  "zq11a24": "tra lại sổ!",
  "zq11a25": "Cảnh báo: tra sổ,",
  "zq11a26": "thân phận lộ hết.",
  "zq11a27": "Tra cũng được.",
  "zq11a28": "Con ấn này,",
  "zq11a29": "là đại nhân đóng hôm qua.",
  "zq11a30": "Khâm phạm được phối hôn,",
  "zq11a31": "châu phủ xử ai trước?",
  "zq11a32": "Đây, đây là…",
  "zq11a33": "Lui… lui lại!",
  "zq11a34": "Hứa tú tài,",
  "zq11a35": {
    "text": "bổn quan chừa ngươi đường lui.",
    "say": "chừa đường lui."
  },
  "zq11a36": "Giao riêng ả ra,",
  "zq11a37": "sổ khỏi phải tra.",
  "zq11a38": "Bổn quan chờ một câu của ngươi."
}
