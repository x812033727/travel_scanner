{
  "zq11a01": "Señor,",
  "zq11a02": "¿trajo el registro?",
  "zq11a03": "¿Señor?",
  "zq11a04": "¿Registro?",
  "zq11a05": "¡Una prófuga no necesita registro!",
  "zq11a06": "Inscrita,",
  "zq11a07": "como mi esposa.",
  "zq11a08": "Eso",
  "zq11a09": "pide orden de captura.",
  "zq11a10": "¿La tiene?",
  "zq11a11": "¡Tonterías!",
  "zq11a12": {
    "text": "Ley de Familia, artículo doce:",
    "say": "Artículo doce:"
  },
  "zq11a13": "el inscrito,",
  "zq11a14": {
    "text": "sin orden de la prefectura,",
    "say": "sin orden,"
  },
  "zq11a15": {
    "text": "no puede ser arrestado.",
    "say": "no se toca."
  },
  "zq11a16": "Secretario, ¿existe eso?",
  "zq11a17": "¿El trece?",
  "zq11a18": "¿Lo recito también?",
  "zq11a19": "Le gana al secretario.",
  "zq11a20": "Señor, no hay orden.",
  "zq11a21": "Eh.",
  "zq11a22": {
    "text": "Señor, revise el registro.",
    "say": "El registro…"
  },
  "zq11a23": {
    "text": "Entonces, que vaya a la prefectura,",
    "say": "A la prefectura,"
  },
  "zq11a24": "¡a revisar el registro!",
  "zq11a25": {
    "text": "Advertencia: si revisan el registro,",
    "say": "Si revisan el registro,"
  },
  "zq11a26": {
    "text": "se exponen todas las identidades.",
    "say": "se expone todo."
  },
  "zq11a27": "Adelante.",
  "zq11a28": {
    "text": "Este sello",
    "say": "Sello:"
  },
  "zq11a29": "lo puso usted ayer.",
  "zq11a30": "Una prófuga casada…",
  "zq11a31": {
    "text": "¿a quién castigan?",
    "say": "¿quién paga?"
  },
  "zq11a32": "Es… esto es…",
  "zq11a33": "¡A… atrás!",
  "zq11a34": "Letrado Xu,",
  "zq11a35": {
    "text": "te doy una salida.",
    "say": "hay una salida."
  },
  "zq11a36": "Entrégamela,",
  "zq11a37": {
    "text": "y no reviso el registro.",
    "say": "y no reviso."
  },
  "zq11a38": "Espero tu respuesta."
}
