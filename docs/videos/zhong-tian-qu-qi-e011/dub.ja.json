{
  "zq11a01": "閣下、",
  "zq11a02": "名簿は？",
  "zq11a03": "閣下？",
  "zq11a04": "名簿だと？",
  "zq11a05": "罪人に名簿など要るか！",
  "zq11a06": "名簿に載る、",
  "zq11a07": "配婚の妻です。",
  "zq11a08": "捕縛、",
  "zq11a09": "州府の手配書が要る。",
  "zq11a10": "書状は？",
  "zq11a11": "黙れ！",
  "zq11a12": "戸婚律、第十二条、",
  "zq11a13": "名簿の者は、",
  "zq11a14": "州府の文書なしに、",
  "zq11a15": "捕縛できない。",
  "zq11a16": "書記、本当か？",
  "zq11a17": "第十三条、",
  "zq11a18": "それも言う？",
  "zq11a19": "書記より詳しい。",
  "zq11a20": "閣下、文書がありません。",
  "zq11a21": "殿、",
  "zq11a22": "名簿を調べれば。",
  "zq11a23": "では州府に送り、",
  "zq11a24": "名簿を照合だ！",
  "zq11a25": "警告：名簿を調べれば、",
  "zq11a26": "身元が全て露見。",
  "zq11a27": "結構です。",
  "zq11a28": "この印、",
  "zq11a29": "昨日閣下が押した。",
  "zq11a30": "罪人が配婚なら、",
  "zq11a31": "誰が先に？",
  "zq11a32": "こ、これは……",
  "zq11a33": "さ……下がれ！",
  "zq11a34": "秀才、",
  "zq11a35": "道をやろう。",
  "zq11a36": "一人渡せば、",
  "zq11a37": "名簿は調べぬ。",
  "zq11a38": "返事を待っておるぞ。"
}
