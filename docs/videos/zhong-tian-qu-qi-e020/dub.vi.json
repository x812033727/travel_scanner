{
  "zq20a01": "Nếu có người đến đưa ta đi,",
  "zq20a02": {
    "text": "huynh có để ta đi không?",
    "say": "huynh có để không?"
  },
  "zq20a03": "Ta không để.",
  "zq20a04": "Hứa Ký khai trương rồi!",
  "zq20a05": "Ba trăm văn một thếp,",
  "zq20a06": "Tiếp theo!",
  "zq20a07": {
    "text": "Giặt áo, rửa tay,",
    "say": "Giặt rửa,"
  },
  "zq20a08": "đều sạch.",
  "zq20a09": "Cảm ơn đại nương!",
  "zq20a10": "Đừng chen!",
  "zq20a11": "Giấy sắp bị giẫm nát rồi!",
  "zq20a12": "Từ từ,",
  "zq20a13": "ai cũng có!",
  "zq20a14": "Nhị Ngưu,",
  "zq20a15": "Xếp hàng!",
  "zq20a16": "Lần lượt!",
  "zq20a17": {
    "text": "Binh nàng luyện,",
    "say": "Binh nàng,"
  },
  "zq20a18": "dùng để xếp hàng à?",
  "zq20a19": "Còn hơn bị giẫm nát.",
  "zq20a20": "Hôm nay bán được…",
  "zq20a21": "Xe đó của nhà ai?",
  "zq20a22": {
    "text": "Không có gì,",
    "say": "Không,"
  },
  "zq20a23": "ta nhìn nhầm.",
  "zq20a24": "Ca!",
  "zq20a25": "là ông dán cáo thị!",
  "zq20a26": "Khách quý đây,",
  "zq20a27": "hội trưởng đích thân tới lấy hàng?",
  "zq20a28": "Hôm trước chẳng bảo,",
  "zq20a29": "một tờ cũng không nhận sao?",
  "zq20a30": "Muốn hàng thì được,",
  "zq20a31": "thêm ba phần.",
  "zq20a32": "Bán sạch rồi!",
  "zq20a33": "Không còn một tờ!",
  "zq20a34": {
    "text": "Hứa Ký khai trương:",
    "say": "Hứa Ký:"
  },
  "zq20a35": "ngày đầu bán sạch.",
  "zq20a36": "Ca, ăn thịt!",
  "zq20a37": {
    "text": "Chính tuyến Thiên hạ quy tâm:",
    "say": "Thiên hạ quy tâm:"
  },
  "zq20a38": "Một phần trăm.",
  "zq20a39": {
    "text": "Một bữa cơm,",
    "say": "Một bữa,"
  },
  "zq20a40": "mà tăng một nấc?",
  "zq20a41": "Lo mà ăn đi.",
  "zq20a42": "Cỗ xe đó,",
  "zq20a43": "hôm qua cũng đỗ bên kia đường.",
  "zq20a44": "Hứa lão bản,",
  "zq20a45": "đừng vội đóng cửa.",
  "zq20a46": "Tôn chưởng quỹ?",
  "zq20a47": "Vị hôn thê của ta…",
  "zq20a48": "ở nhà ngươi?"
}
