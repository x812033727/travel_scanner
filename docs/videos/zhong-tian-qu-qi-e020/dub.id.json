{
  "zq20a01": "Kalau ada yang membawaku pergi,",
  "zq20a02": "kamu bakal biarin?",
  "zq20a03": "Nggak kubiarin.",
  "zq20a04": "Toko Xu sudah buka!",
  "zq20a05": "Seikat tiga ratus koin,",
  "zq20a06": "berikutnya!",
  "zq20a07": {
    "text": "Cuci baju, cuci tangan,",
    "say": "Buat cuci,"
  },
  "zq20a08": "semua bersih.",
  "zq20a09": "Makasih, Bibi!",
  "zq20a10": "Jangan dorong!",
  "zq20a11": "Kertasnya keinjak nanti!",
  "zq20a12": {
    "text": "Pelan-pelan,",
    "say": "Pelan,"
  },
  "zq20a13": {
    "text": "semua kebagian!",
    "say": "semua dapat!"
  },
  "zq20a14": "Erniu,",
  "zq20a15": "berbaris!",
  "zq20a16": {
    "text": "Satu-satu!",
    "say": "Antre!"
  },
  "zq20a17": "Pasukan latihanmu,",
  "zq20a18": "dipakai buat antre?",
  "zq20a19": "Daripada diinjak.",
  "zq20a20": "Hari ini laku…",
  "zq20a21": "Kereta siapa itu?",
  "zq20a22": {
    "text": "Bukan apa-apa,",
    "say": "Nggak,"
  },
  "zq20a23": "salah lihat.",
  "zq20a24": "Kak,",
  "zq20a25": "kakek yang tempel pengumuman!",
  "zq20a26": {
    "text": "Wah, tamu langka,",
    "say": "Tamu langka,"
  },
  "zq20a27": {
    "text": "ketua serikat sendiri mau beli?",
    "say": "ketua serikat mau beli?"
  },
  "zq20a28": {
    "text": "Kemarin bukannya bilang,",
    "say": "Bukannya bilang,"
  },
  "zq20a29": "selembar pun nggak mau terima?",
  "zq20a30": "Mau barang, boleh,",
  "zq20a31": "naik tiga puluh persen.",
  "zq20a32": "Habis terjual!",
  "zq20a33": "Selembar pun nggak sisa!",
  "zq20a34": {
    "text": "Toko Xu buka,",
    "say": "Toko Xu,"
  },
  "zq20a35": {
    "text": "hari pertama habis terjual.",
    "say": "hari pertama, habis."
  },
  "zq20a36": {
    "text": "Kak, makan dagingnya!",
    "say": "Daging, Kak!"
  },
  "zq20a37": {
    "text": "Misi utama, rebut hati seluruh negeri:",
    "say": "Rebut hati negeri:"
  },
  "zq20a38": "satu persen.",
  "zq20a39": {
    "text": "Cuma makan,",
    "say": "Makan,"
  },
  "zq20a40": "naik satu strip?",
  "zq20a41": {
    "text": "Udah, makan.",
    "say": "Makan."
  },
  "zq20a42": "Kereta itu,",
  "zq20a43": "kemarin juga di seberang.",
  "zq20a44": "Bos Xu,",
  "zq20a45": {
    "text": "jangan tutup dulu.",
    "say": "jangan tutup."
  },
  "zq20a46": "Juragan Sun?",
  "zq20a47": "Tunanganku…",
  "zq20a48": {
    "text": "ada di rumahmu?",
    "say": "di rumahmu?"
  }
}
