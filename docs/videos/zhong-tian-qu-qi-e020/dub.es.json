{
  "zq20a01": "Si alguien viniera por mí,",
  "zq20a02": "¿lo dejarías?",
  "zq20a03": "No lo dejaría.",
  "zq20a04": "¡Ya abrió Casa Xu!",
  "zq20a05": {
    "text": "Trescientos cobres el paquete,",
    "say": "A trescientos,"
  },
  "zq20a06": "¡siguiente!",
  "zq20a07": "Deja todo",
  "zq20a08": "limpio.",
  "zq20a09": "¡Gracias, señora!",
  "zq20a10": "¡No empujen!",
  "zq20a11": "¡Van a pisar el papel!",
  "zq20a12": "¡Calma!",
  "zq20a13": "¡hay para todos!",
  "zq20a14": "Erniu,",
  "zq20a15": "¡en fila!",
  "zq20a16": "¡Fila!",
  "zq20a17": "Tus tropas,",
  "zq20a18": "¿para hacer fila?",
  "zq20a19": "Mejor que nos pisoteen.",
  "zq20a20": "Hoy vendimos…",
  "zq20a21": "¿Y ese carruaje?",
  "zq20a22": "Nada,",
  "zq20a23": "me confundí.",
  "zq20a24": {
    "text": "Hermano,",
    "say": "Mira,"
  },
  "zq20a25": "¡es el abuelito del aviso!",
  "zq20a26": "¡Milagro!",
  "zq20a27": "¿el jefe del gremio, de compras?",
  "zq20a28": "¿No que",
  "zq20a29": "no quería ni una hoja?",
  "zq20a30": "Si quiere papel,",
  "zq20a31": "treinta por ciento más.",
  "zq20a32": "¡Todo vendido!",
  "zq20a33": "¡Ni una hoja!",
  "zq20a34": "Casa Xu:",
  "zq20a35": "agotado el primer día.",
  "zq20a36": {
    "text": "¡Hermano, come carne!",
    "say": "¡Come carne!"
  },
  "zq20a37": {
    "text": "Misión principal, el corazón del reino:",
    "say": "Corazón del reino:"
  },
  "zq20a38": {
    "text": "uno por ciento.",
    "say": "uno por ciento"
  },
  "zq20a39": "¿Una cena",
  "zq20a40": "y sube un punto?",
  "zq20a41": "Come y calla.",
  "zq20a42": {
    "text": "Ese carruaje",
    "say": "Ese carro"
  },
  "zq20a43": "ayer estuvo enfrente.",
  "zq20a44": {
    "text": "Señor Xu,",
    "say": "Señor Xu"
  },
  "zq20a45": "no cierre todavía.",
  "zq20a46": "¿Encargado Sun?",
  "zq20a47": "Mi prometida…",
  "zq20a48": "¿está en tu casa?"
}
