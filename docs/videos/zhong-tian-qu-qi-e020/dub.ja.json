{
  "zq20a01": "迎えが来たら、",
  "zq20a02": "渡しちゃう？",
  "zq20a03": "渡さない。",
  "zq20a04": "シュー記、開店だぞ！",
  "zq20a05": "一束三百文、",
  "zq20a06": "次の方！",
  "zq20a07": "服も手も、",
  "zq20a08": "きれいに。",
  "zq20a09": "ありがとう！",
  "zq20a10": "押さないで！",
  "zq20a11": "紙が踏まれちゃう！",
  "zq20a12": "押すな、",
  "zq20a13": "全員分ある！",
  "zq20a14": "アーニウ、",
  "zq20a15": "整列！",
  "zq20a16": "順番だ！",
  "zq20a17": "鍛えた兵を、",
  "zq20a18": "行列整理に？",
  "zq20a19": "踏まれるよりマシ。",
  "zq20a20": "今日の売上……",
  "zq20a21": "誰の車？",
  "zq20a22": "別に、",
  "zq20a23": "見間違い。",
  "zq20a24": {
    "text": "兄さん、",
    "say": "あっ！"
  },
  "zq20a25": "貼り紙のおじいさん！",
  "zq20a26": {
    "text": "珍しい客だな、",
    "say": "おや"
  },
  "zq20a27": "組合長自ら仕入れに？",
  "zq20a28": "前は",
  "zq20a29": "一枚も買わないって？",
  "zq20a30": "仕入れはいいけど、",
  "zq20a31": "三割増し。",
  "zq20a32": "全部売れた！",
  "zq20a33": "一枚もない！",
  "zq20a34": "シュー記開店、",
  "zq20a35": "初日完売。",
  "zq20a36": "はい、お肉！",
  "zq20a37": "主線、天下帰心",
  "zq20a38": "一パーセント。",
  "zq20a39": "一食で",
  "zq20a40": "一目盛り？",
  "zq20a41": "黙って食べな。",
  "zq20a42": "あの車、",
  "zq20a43": "昨日も向かいにいた。",
  "zq20a44": "シュー店主、",
  "zq20a45": "閉めるのはまだ。",
  "zq20a46": "スン店主？",
  "zq20a47": "私の許嫁が、",
  "zq20a48": "あなたの家に？"
}
