{
  "zq20a01": "Se alguém viesse me levar,",
  "zq20a02": "deixaria?",
  "zq20a03": "Eu não deixo.",
  "zq20a04": "A Loja do Xu abriu!",
  "zq20a05": {
    "text": "Trezentas moedas o maço,",
    "say": "Trezentas o maço,"
  },
  "zq20a06": "Próximo!",
  "zq20a07": "Roupa e mão,",
  "zq20a08": "tudo limpo.",
  "zq20a09": "Obrigada, tia!",
  "zq20a10": "Não empurra!",
  "zq20a11": "Vão pisar no papel!",
  "zq20a12": {
    "text": "Calma, calma,",
    "say": "Calma,"
  },
  "zq20a13": "dá pra todos!",
  "zq20a14": "Erniu,",
  "zq20a15": "Em fila!",
  "zq20a16": {
    "text": "Um por um!",
    "say": "Um por um!!"
  },
  "zq20a17": "Sua tropa,",
  "zq20a18": "pra fazer fila?",
  "zq20a19": "Melhor que pisado.",
  "zq20a20": "Hoje vendemos…",
  "zq20a21": {
    "text": "De quem é aquela carruagem?",
    "say": "De quem é aquilo?"
  },
  "zq20a22": "Nada,",
  "zq20a23": "me enganei.",
  "zq20a24": "Mano,",
  "zq20a25": "é o vovô que pôs o aviso!",
  "zq20a26": "Que honra,",
  "zq20a27": {
    "text": "o chefe da guilda veio comprar?",
    "say": "a guilda veio comprar?"
  },
  "zq20a28": "O senhor não disse",
  "zq20a29": "que não queria nem uma folha?",
  "zq20a30": "Quer comprar? Pode,",
  "zq20a31": {
    "text": "com trinta por cento a mais.",
    "say": "e trinta a mais."
  },
  "zq20a32": "Esgotou tudo!",
  "zq20a33": "Nem uma folha!",
  "zq20a34": "Loja do Xu,",
  "zq20a35": "esgotada na estreia.",
  "zq20a36": {
    "text": "Mano, come carne!",
    "say": "Mano, come!"
  },
  "zq20a37": "O coração do reino:",
  "zq20a38": "um por cento.",
  "zq20a39": "Um jantar,",
  "zq20a40": "e sobe um ponto?",
  "zq20a41": "Come logo.",
  "zq20a42": "A carruagem,",
  "zq20a43": "tava aí ontem também.",
  "zq20a44": "Senhor Xu,",
  "zq20a45": "não feche ainda.",
  "zq20a46": "Gerente Sun?",
  "zq20a47": "Minha noiva,",
  "zq20a48": {
    "text": "tá na sua casa?",
    "say": "tá aqui?"
  }
}
