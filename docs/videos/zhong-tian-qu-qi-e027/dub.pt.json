{
  "zq27a01": {
    "text": "Por ordem do magistrado,",
    "say": "Ordem do magistrado"
  },
  "zq27a02": {
    "text": "a Loja do Xu está lacrada!",
    "say": "Loja lacrada!"
  },
  "zq27a03": {
    "text": "Doce envenenado:",
    "say": "Veneno.",
    "emotion": "冷冷地宣布，不笑，短促"
  },
  "zq27a04": "lacrem!",
  "zq27a05": {
    "text": "Trinta dias?",
    "say": "Um mês?",
    "emotion": "湊近，輕佻，語速快"
  },
  "zq27a06": {
    "text": "Você não aguenta nem hoje.",
    "emotion": "輕佻，得意"
  },
  "zq27a07": {
    "text": "O cliente,",
    "say": "O velho"
  },
  "zq27a08": "tá bem?",
  "zq27a09": {
    "text": "Não morre,",
    "say": "Não morre"
  },
  "zq27a10": "vem comigo!",
  "zq27a11": {
    "text": "Dor de barriga,",
    "say": "Dor de barriga",
    "emotion": "心虛，小聲，語速快"
  },
  "zq27a12": {
    "text": "não é culpa minha…",
    "emotion": "心虛，小聲"
  },
  "zq27a13": {
    "text": "Doce com veneno,",
    "say": "Doce com veneno"
  },
  "zq27a14": "confessa ou não?",
  "zq27a15": {
    "text": "O açúcar é meu,",
    "say": "O açúcar é meu",
    "emotion": "不卑不亢，語速快"
  },
  "zq27a16": {
    "text": "a droga não.",
    "emotion": "篤定"
  },
  "zq27a17": {
    "text": "O médico disse:",
    "emotion": "官腔，看手上的紙"
  },
  "zq27a18": "é só laxante.",
  "zq27a19": {
    "text": "O homem tá bem,",
    "say": "O homem tá bem",
    "emotion": "官腔"
  },
  "zq27a20": "a loja segue lacrada!",
  "zq27a21": {
    "text": "Faltam doze dias,",
    "say": "Doze dias"
  },
  "zq27a22": {
    "text": "faturamento: zero.",
    "say": "vendas: zero."
  },
  "zq27a23": {
    "text": "Excelência,",
    "say": "Olha",
    "emotion": "回頭，短促"
  },
  "zq27a24": "peço uma coisa.",
  "zq27a25": {
    "text": "O papel do bolinho.",
    "emotion": "篤定"
  },
  "zq27a26": {
    "text": "Um papel…",
    "say": "Um papel"
  },
  "zq27a27": {
    "text": "vai te salvar?",
    "emotion": "嘲弄，語速快"
  },
  "zq27a28": "Já basta.",
  "zq27a29": {
    "text": "Com a prata,",
    "say": "Com a prata",
    "emotion": "邊走邊嘀咕，語速快"
  },
  "zq27a30": "saio da cidade…",
  "zq27a31": {
    "text": "Quem?",
    "say": "Hã?",
    "emotion": "猛回頭，短促"
  },
  "zq27a32": "…um gato.",
  "zq27a33": {
    "text": "Tudo limpo?",
    "emotion": "笑咪咪，語速正常"
  },
  "zq27a34": "Ninguém te viu?",
  "zq27a35": {
    "text": "N-não,",
    "say": "N-não"
  },
  "zq27a36": "sou ligeiro.",
  "zq27a37": {
    "text": "Do senhorzinho,",
    "say": "Do senhorzinho",
    "emotion": "笑咪咪的口吻，不笑出聲，語速正常"
  },
  "zq27a38": "some uns dias.",
  "zq27a39": {
    "text": "Agradeça",
    "say": "Agradece"
  },
  "zq27a40": {
    "text": "ao senhor Wei.",
    "emotion": "討好，語速快"
  },
  "zq27a41": "Wei Shaoqing.",
  "zq27a42": {
    "text": "O senhorzinho Wei",
    "say": "O senhor Wei",
    "emotion": "得意，語速快"
  },
  "zq27a43": "que mão aberta!",
  "zq27a44": {
    "text": "Gente,",
    "say": "Gente",
    "emotion": "臉色發白，短促"
  },
  "zq27a45": "tão me seguindo!",
  "zq27a46": "Três."
}
