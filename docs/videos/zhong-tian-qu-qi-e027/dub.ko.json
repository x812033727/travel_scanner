{
  "zq27a01": "현령 나리 명으로,",
  "zq27a02": "쉬기를 봉한다!",
  "zq27a03": {"text":"독 가게,","say":"독 가게","emotion":"搖著扇，得意，語速快"},
  "zq27a04": "봉해!",
  "zq27a05": "삼십 일?",
  "zq27a06": "오늘도 못 넘겨.",
  "zq27a07": {"text":"손님은,","say":"손님은","emotion":"沉著，語速快"},
  "zq27a08": "괜찮아요?",
  "zq27a09": "안 죽어,",
  "zq27a10": "관아로 가자!",
  "zq27a11": "배탈 난 게,",
  "zq27a12": "나랑 무슨 상관…",
  "zq27a13": "독으로 해쳤다,",
  "zq27a14": "인정하느냐?",
  "zq27a15": {"text":"설탕은 제 거,","say":"설탕은 제 거","emotion":"不卑不亢，語速快"},
  "zq27a16": "약은 아닙니다.",
  "zq27a17": "의원 말로는,",
  "zq27a18": "그냥 설사약이다.",
  "zq27a19": {"text":"멀쩡하지만,","emotion":"官腔，不以為意"},
  "zq27a20": "가게는 봉한다!",
  "zq27a21": {"text":"십이 일 남음,","say":"십이 일 남음","emotion":"平板電子音，語速快"},
  "zq27a22": "매출, 제로.",
  "zq27a23": "나리,",
  "zq27a24": "하나만 주십시오.",
  "zq27a25": "떡을 싼 그 종이.",
  "zq27a26": "종이 한 장이,",
  "zq27a27": {"text":"널 살려?","emotion":"瞇眼，嗤笑，短促"},
  "zq27a28": "충분해.",
  "zq27a29": "돈 받았고,",
  "zq27a30": "성 밖으로…",
  "zq27a31": {"text":"누구?","emotion":"猛回頭，短促一聲"},
  "zq27a32": "…들고양이겠지.",
  "zq27a33": "깔끔히 했나?",
  "zq27a34": "본 사람 없지?",
  "zq27a35": "어, 없어요,",
  "zq27a36": "손이 빠르거든요.",
  "zq27a37": "도련님이 주신 거야,",
  "zq27a38": "며칠 숨어 있어.",
  "zq27a39": "고맙다고 전해 주세요,",
  "zq27a40": "웨이 도련님께.",
  "zq27a41": "웨이사오칭.",
  "zq27a42": "웨이 도련님,",
  "zq27a43": "통도 크셔.",
  "zq27a44": "형님들,",
  "zq27a45": "꼬리 붙었어!",
  "zq27a46": "셋."
}
