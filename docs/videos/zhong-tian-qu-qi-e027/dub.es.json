{
  "zq27a01": "Orden del magistrado:",
  "zq27a02": "¡Clausurada!",
  "zq27a03": {
    "text": "¡Veneno!",
    "emotion": "得意，語速正常"
  },
  "zq27a04": "¡ciérrenla!",
  "zq27a05": "¿Treinta días?",
  "zq27a06": "No aguantas ni hoy.",
  "zq27a07": "El hombre,",
  "zq27a08": "¿está bien?",
  "zq27a09": "No se muere,",
  "zq27a10": "¡al cuartel!",
  "zq27a11": "Un dolor de panza,",
  "zq27a12": {
    "text": "no es mi culpa…",
    "emotion": "心虛，小聲"
  },
  "zq27a13": "Dulce tóxico,",
  "zq27a14": "¿lo confiesas?",
  "zq27a15": "El azúcar es mía,",
  "zq27a16": "la droga no.",
  "zq27a17": {
    "text": "El médico:",
    "emotion": "官腔，看手上的紙"
  },
  "zq27a18": {
    "text": "un laxante.",
    "emotion": "不以為意，語速正常"
  },
  "zq27a19": {
    "text": "Está vivo,",
    "emotion": "官腔"
  },
  "zq27a20": "¡igual se cierra!",
  "zq27a21": "Doce días,",
  "zq27a22": "ventas en cero.",
  "zq27a23": "Señor,",
  "zq27a24": "pido una cosa.",
  "zq27a25": "El papel del pastel.",
  "zq27a26": "¿Un papel",
  "zq27a27": "¿te salva?",
  "zq27a28": "Basta.",
  "zq27a29": "Con esto,",
  "zq27a30": "me largo de aquí…",
  "zq27a31": "¿Eh?",
  "zq27a32": "…un gato.",
  "zq27a33": "¿Todo limpio?",
  "zq27a34": "¿Nadie te vio?",
  "zq27a35": "N-no,",
  "zq27a36": "soy rápido.",
  "zq27a37": "Del señorito,",
  "zq27a38": "escóndete unos días.",
  "zq27a39": "Dale las gracias",
  "zq27a40": "al señorito Wei.",
  "zq27a41": "Wei Shaoqing.",
  "zq27a42": "El señorito Wei",
  "zq27a43": "¡qué generoso!",
  "zq27a44": "¡Oigan,",
  "zq27a45": "nos siguen!",
  "zq27a46": "Tres."
}
