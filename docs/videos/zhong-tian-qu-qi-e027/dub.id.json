{
  "zq27a01": {
    "text": "Perintah Bupati,",
    "say": "Perintah Bupati"
  },
  "zq27a02": {
    "text": "Toko Xu disegel!",
    "emotion": "斜眼，語速快"
  },
  "zq27a03": {
    "text": "Racun,",
    "say": "Racun"
  },
  "zq27a04": "Segel!",
  "zq27a05": "Tiga puluh hari?",
  "zq27a06": {
    "text": "Hari ini pun kau tumbang.",
    "emotion": "輕蔑，不笑出聲"
  },
  "zq27a07": {
    "text": "Tuan,",
    "say": "Tuan"
  },
  "zq27a08": {
    "text": "dia gimana?",
    "emotion": "沉著，語速快"
  },
  "zq27a09": {
    "text": "Nggak mati,",
    "say": "Nggak mati"
  },
  "zq27a10": "Ikut aku!",
  "zq27a11": {
    "text": "Sakit perut,",
    "emotion": "小聲嘀咕，語速快",
    "say": "Sakit perut"
  },
  "zq27a12": "apa urusannya sama aku…",
  "zq27a13": {
    "text": "Meracuni rakyat,",
    "emotion": "官腔，語速快",
    "say": "Meracuni rakyat"
  },
  "zq27a14": "kau mengaku?",
  "zq27a15": {
    "text": "Gulaku,",
    "emotion": "語速快",
    "say": "Gulaku"
  },
  "zq27a16": {
    "text": "racunnya bukan.",
    "emotion": "篤定"
  },
  "zq27a17": {
    "text": "Kata tabib,",
    "say": "Kata tabib"
  },
  "zq27a18": "cuma obat pencahar.",
  "zq27a19": {
    "text": "Aman,",
    "emotion": "官腔，語速快",
    "say": "Aman"
  },
  "zq27a20": "toko tetap disegel!",
  "zq27a21": {
    "text": "Sisa dua belas hari,",
    "say": "12 hari"
  },
  "zq27a22": "omzet: nol.",
  "zq27a23": {
    "text": "Tuan,",
    "emotion": "回頭，短促",
    "say": "Tuan"
  },
  "zq27a24": "Satu hal saja.",
  "zq27a25": {
    "text": "Kertas bungkus kuenya.",
    "emotion": "篤定"
  },
  "zq27a26": "Selembar kertas",
  "zq27a27": {
    "text": "bisa selamatkanmu?",
    "emotion": "不信，語速快"
  },
  "zq27a28": "Cukup.",
  "zq27a29": {
    "text": "Ambil perak,",
    "say": "Ambil perak"
  },
  "zq27a30": "langsung keluar kota…",
  "zq27a31": {
    "text": "Hah?",
    "emotion": "猛回頭，短促一聲"
  },
  "zq27a32": {
    "text": "…Kucing doang.",
    "say": "Kucing doang.",
    "emotion": "放心，語速快"
  },
  "zq27a33": {
    "text": "Sudah beres?",
    "emotion": "笑咪咪"
  },
  "zq27a34": "Nggak ada yang lihat?",
  "zq27a35": {
    "text": "Ng-nggak,",
    "say": "Ng-nggak"
  },
  "zq27a36": "hamba gesit.",
  "zq27a37": {
    "text": "Dari Tuan Muda,",
    "say": "Dari Tuan Muda"
  },
  "zq27a38": "jangan muncul dulu.",
  "zq27a39": {
    "text": "Makasih,",
    "emotion": "討好，語速快",
    "say": "Makasih"
  },
  "zq27a40": {
    "text": "Tuan Muda Wei.",
    "emotion": "討好，語速快"
  },
  "zq27a41": "Wei Shaoqing.",
  "zq27a42": {
    "text": "Tuan Muda Wei,",
    "emotion": "得意，輕快",
    "say": "Tuan Muda Wei"
  },
  "zq27a43": "royal banget.",
  "zq27a44": {
    "text": "Hei!",
    "emotion": "臉色發白，短促一聲"
  },
  "zq27a45": "ada yang ngikutin!",
  "zq27a46": "Tiga."
}
