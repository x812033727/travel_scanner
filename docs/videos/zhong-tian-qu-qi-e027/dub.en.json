{
  "zq27a01": "Magistrate's orders,",
  "zq27a02": "Xu's is sealed!",
  "zq27a03": "A poison-sugar shop?",
  "zq27a04": "Seal it!",
  "zq27a05": "Thirty days?",
  "zq27a06": "You won't last today.",
  "zq27a07": "Sir,",
  "zq27a08": "is he okay?",
  "zq27a09": "He'll live.",
  "zq27a10": "Come with me!",
  "zq27a11": "A bellyache,",
  "zq27a12": "what's that got to do with me…",
  "zq27a13": "Poisoning folk with sugar—",
  "zq27a14": "do you confess?",
  "zq27a15": "I made the sugar,",
  "zq27a16": "not the drug.",
  "zq27a17": "Doctor says",
  "zq27a18": "it was only a purgative.",
  "zq27a19": "No one's hurt,",
  "zq27a20": "the shop stays shut!",
  "zq27a21": "Twelve days left,",
  "zq27a22": "revenue: zero.",
  "zq27a23": "My lord,",
  "zq27a24": "Just one thing.",
  "zq27a25": "The paper the cakes came in.",
  "zq27a26": "A scrap of paper",
  "zq27a27": "will save you?",
  "zq27a28": "It's enough.",
  "zq27a29": "Grab the silver,",
  "zq27a30": "then out of town…",
  "zq27a31": "Who?",
  "zq27a32": "…Just a cat.",
  "zq27a33": "Job done clean?",
  "zq27a34": "Nobody saw you?",
  "zq27a35": "N-nobody,",
  "zq27a36": "I'm quick.",
  "zq27a37": "From the young master.",
  "zq27a38": "Lie low for a few days.",
  "zq27a39": "Give my thanks",
  "zq27a40": "to Young Master Wei.",
  "zq27a41": "Wei Shaoqing.",
  "zq27a42": "Young Master Wei sure",
  "zq27a43": "pays well.",
  "zq27a44": { "text": "Hey!", "emotion": "臉色發白，短促一聲" },
  "zq27a45": "we've got a tail!",
  "zq27a46": "Three."
}
