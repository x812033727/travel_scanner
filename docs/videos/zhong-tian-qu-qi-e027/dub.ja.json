{
  "zq27a01": "県令の命により、",
  "zq27a02": "シュー記を封鎖！",
  "zq27a03": { "text": "毒の砂糖屋は、", "say": "毒の店は、", "emotion": "搖著扇，輕蔑" },
  "zq27a04": "封鎖だ！",
  "zq27a05": "三十日？",
  "zq27a06": "今日ももたないね。",
  "zq27a07": "あの客は、",
  "zq27a08": "無事か？",
  "zq27a09": "死にはせん、",
  "zq27a10": "役所へ来い！",
  "zq27a11": { "text": "ただの腹痛だろ、", "say": "ただの腹痛" },
  "zq27a12": "俺のせいじゃ……",
  "zq27a13": { "text": "毒の砂糖で人を害した、", "say": "毒を盛ったな", "emotion": "官腔，拍驚堂木" },
  "zq27a14": "認めるか？",
  "zq27a15": "砂糖は俺が、",
  "zq27a16": "薬は違う。",
  "zq27a17": { "text": "医者によれば、", "say": "医者曰く", "emotion": "官腔，看手上的紙" },
  "zq27a18": "ただの下剤だ。",
  "zq27a19": { "text": "命に別状はない、", "say": "命は無事", "emotion": "官腔" },
  "zq27a20": "店は封鎖！",
  "zq27a21": "残り十二日、",
  "zq27a22": "売上ゼロ。",
  "zq27a23": "閣下、",
  "zq27a24": "一つだけ欲しい。",
  "zq27a25": "菓子を包んだ紙を。",
  "zq27a26": "紙一枚で、",
  "zq27a27": "助かると？",
  "zq27a28": "十分です。",
  "zq27a29": "金もらったら、",
  "zq27a30": "町を出る……",
  "zq27a31": { "text": "ん!?", "say": "ん？", "emotion": "警覺，極短" },
  "zq27a32": "……野良猫か。",
  "zq27a33": "きれいに済んだか？",
  "zq27a34": "見られてないな？",
  "zq27a35": "い、いえ、",
  "zq27a36": "手は早いんで。",
  "zq27a37": "若様からの褒美だ、",
  "zq27a38": "しばらく身を隠せ。",
  "zq27a39": "よろしくお伝えを、",
  "zq27a40": "ウェイの若様に。",
  "zq27a41": "ウェイ・シャオチン。",
  "zq27a42": "ウェイの若様は、",
  "zq27a43": "太っ腹だねえ。",
  "zq27a44": { "text": "兄貴たち、", "say": "兄貴", "emotion": "臉色發白，急，極短" },
  "zq27a45": "つけられてる！",
  "zq27a46": "三人。"
}
