{
  "zq27a01": {
    "text": "Lệnh quan huyện,",
    "say": "Lệnh quan huyện"
  },
  "zq27a02": "niêm phong Hứa Ký!",
  "zq27a03": {
    "text": "Tiệm đường độc,",
    "say": "Tiệm đường độc",
    "emotion": "搖著扇，輕蔑"
  },
  "zq27a04": "Niêm phong!",
  "zq27a05": "Ba mươi ngày?",
  "zq27a06": {
    "text": "Hôm nay ngươi còn chẳng qua nổi.",
    "emotion": "輕蔑，不笑出聲"
  },
  "zq27a07": {
    "text": "Vị khách kia,",
    "say": "Vị khách",
    "emotion": "看向趙捕頭，短促"
  },
  "zq27a08": "ổn chứ?",
  "zq27a09": {
    "text": "Chưa chết được,",
    "say": "Chưa chết được"
  },
  "zq27a10": "về huyện nha!",
  "zq27a11": {
    "text": "Đau bụng thôi,",
    "say": "Đau bụng thôi"
  },
  "zq27a12": {
    "text": "liên quan gì tới ta…",
    "say": "liên quan gì tới ta",
    "emotion": "心虛，不笑出聲"
  },
  "zq27a13": {
    "text": "Đường độc hại người,",
    "say": "Đường độc hại người",
    "emotion": "官腔，語速快"
  },
  "zq27a14": {
    "text": "ngươi có nhận không?",
    "emotion": "官腔，假裝威嚴"
  },
  "zq27a15": {
    "text": "Đường ta làm,",
    "say": "Đường ta làm"
  },
  "zq27a16": "thuốc thì không.",
  "zq27a17": {
    "text": "Đại phu nói rồi,",
    "say": "Đại phu nói rồi",
    "emotion": "看手上的紙"
  },
  "zq27a18": "chỉ là thuốc xổ.",
  "zq27a19": {
    "text": "Người không sao,",
    "say": "Người không sao",
    "emotion": "官腔"
  },
  "zq27a20": "tiệm vẫn niêm phong!",
  "zq27a21": {
    "text": "Còn mười hai ngày,",
    "say": "Mười hai ngày",
    "emotion": "平板電子音，語速快"
  },
  "zq27a22": "doanh thu về không.",
  "zq27a23": {
    "text": "Đại nhân,",
    "say": "Đại nhân",
    "emotion": "回頭，短促"
  },
  "zq27a24": "chỉ xin một thứ.",
  "zq27a25": "Tờ giấy gói bánh đường.",
  "zq27a26": {
    "text": "Một tờ giấy,",
    "say": "Một tờ giấy"
  },
  "zq27a27": {
    "text": "cứu được ngươi?",
    "emotion": "瞇眼，不信，不笑出聲"
  },
  "zq27a28": "Đủ rồi.",
  "zq27a29": {
    "text": "Lấy bạc xong,",
    "say": "Lấy bạc xong"
  },
  "zq27a30": {
    "text": "là ra khỏi thành…",
    "say": "là ra khỏi thành"
  },
  "zq27a31": {
    "text": "Ai?",
    "emotion": "短促一聲，不喘氣"
  },
  "zq27a32": "…Mèo hoang thôi.",
  "zq27a33": {
    "text": "Việc xong gọn chưa?",
    "emotion": "慢條斯理，話裡藏刀，不笑出聲"
  },
  "zq27a34": "Không ai thấy chứ?",
  "zq27a35": {
    "text": "Không… không ạ,",
    "say": "Không… không ạ"
  },
  "zq27a36": "tiểu nhân nhanh tay.",
  "zq27a37": {
    "text": "Công tử thưởng đấy,",
    "say": "Công tử thưởng đấy"
  },
  "zq27a38": "mấy ngày này trốn xa chút.",
  "zq27a39": "Tạ ơn giùm",
  "zq27a40": {
    "text": "Ngụy công tử.",
    "emotion": "討好，不笑出聲"
  },
  "zq27a41": "Ngụy Thiếu Khanh.",
  "zq27a42": {
    "text": "Ngụy công tử ra tay,",
    "say": "Ngụy công tử ra tay",
    "emotion": "得意，語速快"
  },
  "zq27a43": "hào phóng thật.",
  "zq27a44": {
    "text": "Các đại ca,",
    "say": "Đại ca!",
    "emotion": "短促一聲，不喘氣"
  },
  "zq27a45": "có kẻ bám đuôi!",
  "zq27a46": "Ba tên."
}
