{
  "title": "AI 에이전트와 챗봇은 어떻게 다를까? 여행 일정으로 확인",
  "description": "대화가 완료는 아닙니다. 타이베이 반나절 일정에서 공개 자료로 다음 행동을 바꾸고 결과를 검수합니다. 조사: 2026년 9월 27일. 개관은 출발 전 공식 공지를 보세요.",
  "tags": [
    "AI 에이전트",
    "챗봇",
    "AI 입문",
    "여행 계획"
  ],
  "chapters": {
    "hook": "답하면 끝난 걸까요?",
    "pretty-answer": "그럴듯한 답과 완료는 다릅니다",
    "task-spec": "요청을 명확히 적기",
    "first-rule": "월요일 휴관의 예외",
    "fixed-flow": "에이전트가 필요한 순간",
    "task-recipe": "작은 일로 직접 시험하기"
  },
  "source_hashes": {
    "chapters": {
      "hook": "019d22d659e4",
      "pretty-answer": "049b54c3877f",
      "task-spec": "d60c0144db14",
      "first-rule": "2cb186e4296c",
      "fixed-flow": "d41643fb5fa2",
      "task-recipe": "cc0cdaaf637f"
    },
    "title": "17720e2d50c2",
    "description": "51c42d16c866",
    "tags": "ac86e99c508c"
  },
  "lines": {
    "ag001": {
      "source_hash": "dcfa7b731fe4",
      "text": "일정은 짰다는데, 조사했나요?"
    },
    "ag002": {
      "source_hash": "3016fb48cffc",
      "text": "월요일 박물관 방문 과제로 차이를 보겠습니다."
    },
    "ag003": {
      "source_hash": "41ffc3c696ac",
      "text": "끝에 직접 쓸 요청 목록을 얻습니다."
    },
    "ag004": {
      "source_hash": "c63d26579600",
      "text": "흔한 예입니다. 한 줄 묻자 목록이 옵니다."
    },
    "ag005": {
      "source_hash": "c6c1559089b6",
      "text": "매끈해도 개관일은 안 봤을 수 있습니다."
    },
    "ag006": {
      "source_hash": "85926c1e7b6c",
      "text": "저희 교육용 예시입니다. 제품 화면은 안 찍었습니다."
    },
    "ag007": {
      "source_hash": "5965470e0284",
      "text": "아직 구상뿐, 검수할 일정은 없습니다."
    },
    "ag008": {
      "source_hash": "09a4ab84685f",
      "text": "답변 뒤 행동은 당신 몫입니다."
    },
    "ag009": {
      "source_hash": "bd9592a3d803",
      "text": "고정 절차는 미리 짠 경로를 따릅니다."
    },
    "ag010": {
      "source_hash": "e79b623798e9",
      "text": "에이전트는 도구 결과로 다음을 정합니다."
    },
    "ag011": {
      "source_hash": "1aedb235ed9d",
      "text": "고정된 우열은 없고, 일의 요구가 핵심입니다."
    },
    "ag079": {
      "source_hash": "f846507b33e0",
      "text": "예로 매달 같은 항목의 표를 정리합니다."
    },
    "ag080": {
      "source_hash": "8f62e063dcdc",
      "text": "정해진 조건의 보고서는 프로그램이 더 안정적일 수 있습니다."
    },
    "ag081": {
      "source_hash": "ba5210509222",
      "text": "유행이라고 작은 일까지 추측에 맡기지 마세요."
    },
    "ag082": {
      "source_hash": "bc49c07b92c7",
      "text": "경로 바뀌는지 보고 유연성이 필요한지 정하세요"
    },
    "ag111": {
      "source_hash": "6eb25b7a6e6b",
      "text": "웹 도구 없인 박물관의 새 공지를 못 봅니다."
    },
    "ag112": {
      "source_hash": "d18b08ee2306",
      "text": "경로는 제안해도 개관일은 따로 봅니다."
    },
    "ag113": {
      "source_hash": "1bb69a0ed0aa",
      "text": "말솜씨가 아닌 도구 범위의 차이입니다."
    },
    "ag114": {
      "source_hash": "1eac86d88606",
      "text": "선택 전 읽고 할 수 있는 일을 봅니다."
    },
    "ag012": {
      "source_hash": "c173fe79513f",
      "text": "채팅창이 대화 전용이란 뜻은 아닙니다."
    },
    "ag013": {
      "source_hash": "aeed4df49018",
      "text": "에이전트란 이름도 완료를 보장하진 않습니다."
    },
    "ag014": {
      "source_hash": "1a026815b568",
      "text": "쓴 도구와 얻은 결과를 확인해야 합니다."
    },
    "ag015": {
      "source_hash": "3e14fba67465",
      "text": "그 결과가 이후 행동을 바꿨는지도 봅니다."
    },
    "ag083": {
      "source_hash": "a7474c704217",
      "text": "'조사했다'는 말만으론 증거가 안 됩니다."
    },
    "ag084": {
      "source_hash": "d5c22535ab31",
      "text": "본 페이지와 얻은 결과를 봅니다."
    },
    "ag085": {
      "source_hash": "45b28d1687fb",
      "text": "결과로 초안 고쳤는지 봅니다."
    },
    "ag086": {
      "source_hash": "d278d46bd937",
      "text": "아니면 사용자가 확인을 마쳐야 합니다."
    },
    "ag016": {
      "source_hash": "1b865a2ee125",
      "text": "개인정보 없이 공개자료만 씁니다."
    },
    "ag017": {
      "source_hash": "9ea5aa55439d",
      "text": "타이베이역 근처 반나절 박물관 산책을 짭니다."
    },
    "ag018": {
      "source_hash": "5bb586ba0ab0",
      "text": "2026년9월27일 조회,9월28일을 계획한 과거 예입니다."
    },
    "ag019": {
      "source_hash": "de636fb1bb06",
      "text": "공식 공개페이지만 보고 예약·결제 안 합니다."
    },
    "ag115": {
      "source_hash": "a91bbb7085e4",
      "text": "'타이베이 놀거리'는 영감에 좋습니다."
    },
    "ag116": {
      "source_hash": "7491818cc4f6",
      "text": "쓸 일정엔 날짜와 범위도 있어야 합니다."
    },
    "ag117": {
      "source_hash": "c9b885470018",
      "text": "증거 필요 항목도 밝힙니다."
    },
    "ag118": {
      "source_hash": "1216d46dbbd0",
      "text": "요청이 명확하면 완료 판단도 쉽습니다."
    },
    "ag020": {
      "source_hash": "8dbd1a0581dd",
      "text": "완료 기준부터 말해야 완료 확인이 쉽습니다."
    },
    "ag021": {
      "source_hash": "dde31bc71cf2",
      "text": "장소·순서·박물관 개관 근거를 쓰게 합니다."
    },
    "ag022": {
      "source_hash": "8efca501735f",
      "text": "교통·날씨 미확인은 표시합니다."
    },
    "ag023": {
      "source_hash": "4f837a0f0fca",
      "text": "항목이 자신만만한 말투보다 유용합니다."
    },
    "ag087": {
      "source_hash": "809e6035a19d",
      "text": "실명·전화번호·숙소 예약정보는 불필요합니다"
    },
    "ag088": {
      "source_hash": "5bc0a940bce0",
      "text": "공개 날짜·장소·목표만으로 전 과정을 보입니다."
    },
    "ag089": {
      "source_hash": "c342f6df5b7b",
      "text": "여행자 계정에도 에이전트를 로그인시키지 않습니다."
    },
    "ag090": {
      "source_hash": "027307703ea0",
      "text": "저위험 과제로 연습하면 능력이 잘 보입니다"
    },
    "ag024": {
      "source_hash": "3963c2df2320",
      "text": "개관시간 페이지부터 엽니다."
    },
    "ag025": {
      "source_hash": "60e155abee9d",
      "text": "매주 월요일은 쉽니다."
    },
    "ag026": {
      "source_hash": "ec6b70f20398",
      "text": "멈추면 이날 박물관은 빠집니다."
    },
    "ag027": {
      "source_hash": "5e720cb1c056",
      "text": "공식 페이지엔 공휴일 정상 개관도 가능합니다."
    },
    "ag028": {
      "source_hash": "5fd292a4e414",
      "text": "결과로 방향을 바꿀 때입니다."
    },
    "ag029": {
      "source_hash": "6bcf85b5939a",
      "text": "월요 휴관을 그대로 붙이진 않았습니다."
    },
    "ag030": {
      "source_hash": "007e75817a0d",
      "text": "예외를 보고 그해 개관·휴관 공지를 찾았습니다."
    },
    "ag031": {
      "source_hash": "dc972e542c03",
      "text": "기억에 기대지 않고 실제로 확인한 단계입니다."
    },
    "ag119": {
      "source_hash": "e41f36aa3446",
      "text": "상상 속 에이전트 흐름이 아닙니다."
    },
    "ag120": {
      "source_hash": "dd3b20024e46",
      "text": "제작 때 시간표 뒤 연간 공지를 열었습니다."
    },
    "ag121": {
      "source_hash": "038f43e8dab6",
      "text": "단계별 결과는 한 표에서 확인합니다."
    },
    "ag122": {
      "source_hash": "f567f83e1bb9",
      "text": "여행자 대신 버튼도 안 누르고 계정 접속도 안 했습니다"
    },
    "ag032": {
      "source_hash": "705111503b52",
      "text": "공지에 이날이 있습니다."
    },
    "ag033": {
      "source_hash": "26e814188158",
      "text": "9월28일 월요일,대만 교사의 날로 정상 개관합니다."
    },
    "ag034": {
      "source_hash": "d9e07e15e0f8",
      "text": "따라서 이날은 월요일 휴관이 아닙니다."
    },
    "ag035": {
      "source_hash": "de1b267fbfbc",
      "text": "화면엔 필요한 영어 한 줄, 출처는 설명란입니다."
    },
    "ag091": {
      "source_hash": "1ff7f8fe38ac",
      "text": "일반 규칙과 휴일 공지는 모순이 아닙니다."
    },
    "ag092": {
      "source_hash": "6ec95e069bff",
      "text": "앞은 평소 월요일, 뒤는 특정 날짜입니다."
    },
    "ag093": {
      "source_hash": "ea13645ba6d9",
      "text": "월요 휴관만 보면 예외를 놓칩니다."
    },
    "ag094": {
      "source_hash": "c31a640b7084",
      "text": "요청한 날짜에 출처를 맞춥니다."
    },
    "ag036": {
      "source_hash": "1e65220dae36",
      "text": "링크 하나를 더 붙였다는 뜻이 아닙니다."
    },
    "ag037": {
      "source_hash": "207d6e0c6c3d",
      "text": "새 자료로 초안을 고쳤습니다."
    },
    "ag038": {
      "source_hash": "f8eb62bd56f8",
      "text": "빼려던 박물관은 남길 수 있습니다."
    },
    "ag039": {
      "source_hash": "69733e853bcc",
      "text": "도구 결과로 다음을 바꾼 겁니다."
    },
    "ag123": {
      "source_hash": "94064504146a",
      "text": "여기에도 놓치기 쉬운 점이 있습니다."
    },
    "ag124": {
      "source_hash": "a0129fce1e30",
      "text": "9월 28일에 열어도 모든 월요일에 여는 건 아닙니다."
    },
    "ag125": {
      "source_hash": "c3c73595d17b",
      "text": "날짜·관명은 남기고 '월요일 가능'만 쓰지 않습니다."
    },
    "ag126": {
      "source_hash": "125d7819717d",
      "text": "여행 정보에는 예외가 많으니 출발 전 다시 확인하세요."
    },
    "ag040": {
      "source_hash": "7c9342695c2f",
      "text": "검수할 초안입니다"
    },
    "ag041": {
      "source_hash": "8e0f76861fe9",
      "text": "타이베이역 근처에서 출발해 국립타이완박물관 본관으로 갑니다."
    },
    "ag042": {
      "source_hash": "403381798aa1",
      "text": "다음은 인근 228 평화공원 야외입니다."
    },
    "ag043": {
      "source_hash": "1a7c62f6334d",
      "text": "초안의 순서이며 현장 길찾기는 아닙니다."
    },
    "ag095": {
      "source_hash": "b2aff1ee9447",
      "text": "칸별로 볼 수 있습니다."
    },
    "ag096": {
      "source_hash": "83e14c072e48",
      "text": "입장은 휴일 공지, 위치는 박물관 주소 페이지로 봅니다."
    },
    "ag097": {
      "source_hash": "30e4e1ee6275",
      "text": "박물관은 도보를 안내하지만, 저흰 실측도 날씨 확인도 안 했습니다."
    },
    "ag098": {
      "source_hash": "1b9cc95d12a2",
      "text": "가짜 숫자 대신 비워 둡니다."
    },
    "ag127": {
      "source_hash": "96e340f71d86",
      "text": "정보를 세 층으로 나눕니다."
    },
    "ag128": {
      "source_hash": "6f1abfcedc52",
      "text": "확인한 건 원래 출처를 붙입니다."
    },
    "ag129": {
      "source_hash": "8271f72d7403",
      "text": "출처로 추론한 건 초안입니다."
    },
    "ag130": {
      "source_hash": "b53006e93b3d",
      "text": "미확인은 확인 대기로, 확정란엔 안 넣습니다."
    },
    "ag044": {
      "source_hash": "98b4ba16cadb",
      "text": "쓸 결과물엔 안 한 일도 적습니다."
    },
    "ag045": {
      "source_hash": "339f66936db2",
      "text": "도보 시간 안 재고 날씨 안 봤습니다."
    },
    "ag046": {
      "source_hash": "de0c983781a9",
      "text": "예매·결제 없습니다."
    },
    "ag047": {
      "source_hash": "db42f869cdb1",
      "text": "미확인 표기도 품질의 일부입니다."
    },
    "ag099": {
      "source_hash": "36e4824720a5",
      "text": "전부 재실행은 불필요합니다."
    },
    "ag100": {
      "source_hash": "fc6aa7fec4e5",
      "text": "먼저 개관일 등 핵심을 확인합니다."
    },
    "ag101": {
      "source_hash": "d54da82b4068",
      "text": "관명·날짜·출처가 맞는지 봅니다."
    },
    "ag102": {
      "source_hash": "488db468ee42",
      "text": "출발 전 당일 공지로 변경을 다시 봅니다."
    },
    "ag131": {
      "source_hash": "335937567808",
      "text": "다음 사람이 이어받게 합니다."
    },
    "ag132": {
      "source_hash": "f4111f9849fa",
      "text": "순서 뒤 각 출처를 봅니다."
    },
    "ag133": {
      "source_hash": "9275ac19e68d",
      "text": "확인·미확인을 구분합니다."
    },
    "ag134": {
      "source_hash": "2d26f8a8f6a0",
      "text": "끝에 사람이 할 다음 일을 적고 완료만 외치진 않습니다"
    },
    "ag048": {
      "source_hash": "3307570c98c5",
      "text": "고정 절차도 두 페이지를 봅니다."
    },
    "ag049": {
      "source_hash": "366367b7dbec",
      "text": "맞습니다. 예외를 미리 짜 두면 안정적으로 해냅니다."
    },
    "ag050": {
      "source_hash": "f7466bc864ba",
      "text": "모델이 결과로 다음 일을 고릅니다."
    },
    "ag051": {
      "source_hash": "800ce03e7b31",
      "text": "도구 순위 얘기는 아닙니다."
    },
    "ag103": {
      "source_hash": "157040c17839",
      "text": "평소 챗봇도 웹페이지를 열 수 있는데요?"
    },
    "ag104": {
      "source_hash": "c47d7109d7b9",
      "text": "채팅창 유무로는 분류 못 합니다."
    },
    "ag105": {
      "source_hash": "8140312510ce",
      "text": "검색 한 번은 전체 자동 완료가 아닙니다"
    },
    "ag106": {
      "source_hash": "fdf6d17f00f3",
      "text": "계속 진행·수정하고 검증할 결과를 내는지 봅니다."
    },
    "ag135": {
      "source_hash": "c929a27eb4b1",
      "text": "처음부터 끝까지 맡길 필요는 없습니다."
    },
    "ag136": {
      "source_hash": "fe520d2d23f1",
      "text": "우선 읽기와 초안 권한만 줍니다."
    },
    "ag137": {
      "source_hash": "e014ba9602c2",
      "text": "결과 보고 더 허용할지 정합니다."
    },
    "ag138": {
      "source_hash": "ab3305e2d843",
      "text": "외부 전송·결제 전 멈춰 묻게 합니다."
    },
    "ag052": {
      "source_hash": "8011e592d9cd",
      "text": "모델의 조사 요청이 권한은 아닙니다."
    },
    "ag053": {
      "source_hash": "60c4168942a8",
      "text": "공개 페이지를 읽는다고 당신 계정에 들어갈 순 없습니다."
    },
    "ag054": {
      "source_hash": "e65a75ae1645",
      "text": "예약했다고 말해도 예약 기록이 없으면 미완료입니다."
    },
    "ag055": {
      "source_hash": "08a397ede1f8",
      "text": "글 설명과 외부의 실제 상태는 따로 봅니다"
    },
    "ag056": {
      "source_hash": "aecfc965de7f",
      "text": "세 가지를 묻습니다."
    },
    "ag057": {
      "source_hash": "2ec2a4e12ada",
      "text": "첫째 도구로 실제 자료 얻었나요?"
    },
    "ag058": {
      "source_hash": "a38cd9b7c7a3",
      "text": "둘째 새 정보가 다음 행동을 바꿨나요?"
    },
    "ag059": {
      "source_hash": "e0e4d8053541",
      "text": "셋째, 결과를 하나씩 확인할 수 있나요?"
    },
    "ag060": {
      "source_hash": "136f58a06b75",
      "text": "공식 페이지가 안 열리면 시간을 짐작해선 안 됩니다."
    },
    "ag061": {
      "source_hash": "83eeb89056fc",
      "text": "확인한 것과 못 읽은 페이지를 말합니다."
    },
    "ag062": {
      "source_hash": "d5ea147f5ca0",
      "text": "미확인은 사람에게 넘깁니다."
    },
    "ag063": {
      "source_hash": "c2ebe69749f6",
      "text": "이런 부분 완료가 그럴듯한 오답보다 낫습니다."
    },
    "ag107": {
      "source_hash": "dd149bf65234",
      "text": "연 웹페이지엔 무관한 지시가 있을 수 있습니다."
    },
    "ag108": {
      "source_hash": "19fdffbeaa72",
      "text": "외부 자료로 맡긴 권한을 늘려선 안 됩니다."
    },
    "ag109": {
      "source_hash": "cfd4e61fa995",
      "text": "조사 권한만으로 결제하면 안 됩니다."
    },
    "ag110": {
      "source_hash": "9453765677fc",
      "text": "중단선으로 결과 통제권을 유지합니다."
    },
    "ag064": {
      "source_hash": "c3188cb2e8ee",
      "text": "작고 다시 볼 과제로 시작합니다."
    },
    "ag065": {
      "source_hash": "43bd5633ead6",
      "text": "목표와 쓸 자료, 넘지 말 경계를 적습니다."
    },
    "ag066": {
      "source_hash": "22677874bd81",
      "text": "마지막엔 출처가 달린 할 일 목록처럼 검수법을 정합니다."
    },
    "ag067": {
      "source_hash": "f04f8177fb5d",
      "text": "빈틈은 미확인이라 쓰고 억지로 채우진 않습니다"
    },
    "ag139": {
      "source_hash": "d3a494a36629",
      "text": "나중에 예약이 필요하면 승인 지점을 미리 정합니다."
    },
    "ag140": {
      "source_hash": "f22d38ee5411",
      "text": "조사·초안은 해도 됩니다"
    },
    "ag141": {
      "source_hash": "f0e46eba97fb",
      "text": "계정·주문·결제는 사람 결정 뒤입니다"
    },
    "ag142": {
      "source_hash": "f326fca95b5a",
      "text": "넘길 곳을 알고 무리하게 진행하진 않습니다."
    },
    "ag068": {
      "source_hash": "352396f27442",
      "text": "'일정 짜 줘'보다 검수가 쉽습니다."
    },
    "ag069": {
      "source_hash": "d5c2d4d3bd50",
      "text": "공식 공개페이지만 보고 초안·출처 냅니다"
    },
    "ag070": {
      "source_hash": "6d1ace389579",
      "text": "미확인은 적고 예약·결제는 금지합니다."
    },
    "ag071": {
      "source_hash": "24f74db10c81",
      "text": "최종 결정은 당신이 하고 어디를 볼지도 알게 됩니다."
    },
    "ag072": {
      "source_hash": "955eaec8a529",
      "text": "에이전트 개념과 요청법은 설명란 첫 줄에 있습니다."
    },
    "ag073": {
      "source_hash": "b60013cb446d",
      "text": "글은 대화형 답변, 정해진 절차, 에이전트를 구분합니다."
    },
    "ag074": {
      "source_hash": "b896d8409f38",
      "text": "쓰는 도구가 실제 어디까지 하는지 비교해 보세요."
    },
    "ag075": {
      "source_hash": "15582667072d",
      "text": "다시, 답변은 완료가 아닙니다."
    },
    "ag076": {
      "source_hash": "566f542ac5f8",
      "text": "실제 결과로 다음을 고르는 게 가치입니다."
    },
    "ag077": {
      "source_hash": "792dd8f18b2c",
      "text": "검수 가능한 결과도 내야 합니다"
    },
    "ag078": {
      "source_hash": "ed923a6fbe52",
      "text": "네 칸 요청서로 작은 과제 하나 해 보세요."
    }
  }
}
