    { "id": "autonomy-spectrum", "template": "steps", "data": { "title": "可以逐步增加代理自由度", "steps": [ { "title": "先讀", "detail": "整理公開資料" }, { "title": "再草擬", "detail": "提出候選方案" }, { "title": "人核准", "detail": "對外動作前停下" } ] }, "lines": [
