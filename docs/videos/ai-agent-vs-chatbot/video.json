    { "id": "chat-can-use-tools", "template": "chat", "data": { "title": "聊天介面也可能用工具", "messages": [ { "side": "right", "name": "你", "text": "這個日期真的開館嗎？" }, { "side": "left", "name": "有工具的助理", "text": "讀公告後回報指定日期的狀態" } ] }, "lines": [
