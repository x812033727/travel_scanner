{
  "zq33a01": {
    "text": "Peço a viga emprestada.",
    "say": "Peço a viga.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "Devolvo em três anos.",
    "say": "Em três anos.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "Se os ancestrais culparem alguém,",
    "say": "Se os ancestrais culparem,",
    "emotion": "篤定"
  },
  "zq33a04": {
    "text": "que culpem este velho.",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "Corda amarrada.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "Afastem-se!",
    "say": "Saiam!",
    "emotion": "吼"
  },
  "zq33a07": {
    "text": "A viga vai descer!",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "Irmão Xu, aguenta?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "Missão da seca:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "Faltam sete dias.",
    "emotion": "平板電子音"
  },
  "zq33a11": "Sete dias?",
  "zq33a12": {
    "text": "Uma roda desse tamanho,",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "em sete dias não dá.",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "Dá, sim.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "Você lidera, eu desenho.",
    "say": "Lidera, eu desenho.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "Se der errado,",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "a viga é por sua conta.",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "Homens da vila,",
    "emotion": "嗓門亮，站在高處"
  },
  "zq33a19": {
    "text": "três turnos!",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "Um trabalha, dois dormem,",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "revezando, sem parar.",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "O açúcar da casa do açúcar,",
    "say": "O nosso açúcar,",
    "emotion": "得意"
  },
  "zq33a23": {
    "text": "virou quinze quilos de pregos.",
    "emotion": "袋子一塞",
    "say": "deu quinze quilos de pregos."
  },
  "zq33a24": {
    "text": "Bom prego.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "Desmontar o santuário,",
    "emotion": "尖著嗓子"
  },
  "zq33a26": {
    "text": "é castigo do Céu!",
    "emotion": "羅盤舉上天"
  },
  "zq33a27": {
    "text": "Largaram até os ancestrais,",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "Liuxi vai ficar sem descendentes.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "Castigo do Céu…",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "E aí, ainda desmonta?",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "Os ancestrais também têm sede!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "Quando a água vier,",
    "emotion": "理直氣壯"
  },
  "zq33a33": {
    "text": "os ancestrais bebem primeiro!",
    "say": "eles bebem primeiro!",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "Haha, os ancestrais bebem primeiro!",
    "say": "Haha, eles bebem primeiro!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "Riam.",
    "emotion": "陰"
  },
  "zq33a36": {
    "text": "No décimo dia, vamos ver quem chora.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "Turno dois,",
    "say": "Dois,"
  },
  "zq33a38": {
    "text": "troca!",
    "emotion": "旗桿敲石頭"
  },
  "zq33a39": {
    "text": "As pás, inclinadas três graus,",
    "say": "Pás inclinadas três graus,",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "façam assim.",
    "emotion": "畫外"
  },
  "zq33a41": "Um pra cada,",
  "zq33a42": {
    "text": "dá força pra trabalhar!",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "A última cunha.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "A armação ficou de pé.",
    "say": "Ficou de pé.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "Se gira, só ao meio-dia.",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "Missão da seca:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "vence hoje.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "Abram a comporta.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": "Erniu, puxa!",
  "zq33a50": {
    "text": "Gira…",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "Parou…",
    "emotion": "聲音發抖"
  },
  "zq33a52": "Hahahaha!",
  "zq33a53": {
    "text": "Sete dias de viga, e meia volta!",
    "emotion": "拍大腿",
    "say": "Sete dias, meia volta!"
  },
  "zq33a54": {
    "text": "Nem o Céu te ajuda!",
    "emotion": "笑到岔氣"
  }
}
