{
  "zq33a01": {
    "text": "Tomo la viga prestada.",
    "say": "Tomo la viga.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "En tres años, vuelve.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "Si los ancestros culpan,",
    "say": "Si culpan,",
    "emotion": "慢，篤定"
  },
  "zq33a04": {
    "text": "que culpen a este viejo.",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "Cuerda amarrada.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "¡Apártense!",
    "emotion": "吼"
  },
  "zq33a07": {
    "text": "¡Baja la viga!",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "Hermano Xu, ¿aguantas?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "Misión sequía:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "quedan siete días.",
    "emotion": "平板電子音"
  },
  "zq33a11": {
    "text": "¿Siete días?",
    "emotion": "瞪著圖，不信"
  },
  "zq33a12": {
    "text": "Una rueda tan grande,",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "no sale en siete días.",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "Sí sale.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "Usted manda, yo dibujo.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "Si sale mal,",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "la viga la pagas tú.",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "¡Hombres del pueblo,",
    "emotion": "嗓門亮，站在高處"
  },
  "zq33a19": {
    "text": "en tres turnos!",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "Uno trabaja, dos duermen,",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "rotando, sin parar.",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "El azúcar del taller,",
    "say": "Con azúcar,",
    "emotion": "得意"
  },
  "zq33a23": {
    "text": "por quince kilos de clavos.",
    "emotion": "袋子一塞"
  },
  "zq33a24": {
    "text": "Buen clavo.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "¡Derribar el santuario,",
    "emotion": "尖著嗓子，拖長音"
  },
  "zq33a26": {
    "text": "es castigo del cielo!",
    "emotion": "羅盤舉上天"
  },
  "zq33a27": {
    "text": "Abandonan a sus ancestros,",
    "say": "Dejan a sus ancestros,",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "Liuxi se queda sin herederos.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "Castigo del cielo…",
    "say": "Castigo divino…",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "¿Y aun así la quitamos?",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "¡Los ancestros también tienen sed!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "Cuando llegue el agua,",
    "emotion": "理直氣壯"
  },
  "zq33a33": {
    "text": "¡ellos beben primero!",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "¡Ja, ja, los ancestros primero!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "Ríanse.",
    "say": "Ríanse.",
    "emotion": "陰冷，低聲，只說這個詞，不笑"
  },
  "zq33a36": {
    "text": "Al décimo día, veremos quién llora.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "¡Turno dos,",
    "say": "¡Turno dos!",
    "emotion": "半夜，嗓門不減"
  },
  "zq33a38": {
    "text": "¡cambio!",
    "say": "¡Cambio!",
    "emotion": "短促有力"
  },
  "zq33a39": {
    "text": "Paletas un poco inclinadas,",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "háganlo así.",
    "emotion": "畫外"
  },
  "zq33a41": {
    "text": "Uno por cabeza,",
    "emotion": "甜，快"
  },
  "zq33a42": {
    "text": "¡para tener fuerzas!",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "La última cuña.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "Ya está en pie.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "Si gira, lo vemos al mediodía.",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "Misión sequía:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "vence hoy.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "Abran la compuerta.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": {
    "text": "¡Erniu, jala!",
    "emotion": "手一落"
  },
  "zq33a50": {
    "text": "Vamos, gira…",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "Se paró…",
    "emotion": "聲音發抖"
  },
  "zq33a52": {
    "text": "¡Ja, ja, ja, ja!",
    "emotion": "放聲大笑"
  },
  "zq33a53": {
    "text": "¡Siete días con la viga, y media vuelta!",
    "say": "¡Siete días, y media vuelta!",
    "emotion": "拍大腿，拖長音"
  },
  "zq33a54": {
    "text": "¡Ni el cielo te ayuda!",
    "emotion": "笑到岔氣"
  }
}
