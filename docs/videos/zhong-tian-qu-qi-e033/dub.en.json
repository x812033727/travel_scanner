{
  "zq33a01": {
    "text": "Borrow the beam.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "Back in three years.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "If the ancestors are angry,",
    "emotion": "慢，篤定",
    "say": "If they're angry,"
  },
  "zq33a04": {
    "text": "blame this old man.",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "Rope's tied.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "Stand back,",
    "emotion": "吼",
    "say": "Back!"
  },
  "zq33a07": {
    "text": "beam's coming down.",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "Brother Xu, can you hold it?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "Drought mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "seven days left.",
    "emotion": "平板電子音"
  },
  "zq33a11": {
    "text": "Seven days?",
    "emotion": "瞪著圖，不信"
  },
  "zq33a12": {
    "text": "A wheel this big,",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "no way in seven days.",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "Yes, there is.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "You lead the men, I'll draw.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "If it fails,",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "the beam's on you.",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "Every able man in the village,",
    "emotion": "嗓門亮，站在高處",
    "say": "All men,"
  },
  "zq33a19": {
    "text": "three shifts!",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "One works, two sleep,",
    "emotion": "俐落，快"
  },
  "zq33a21": {
    "text": "keep rotating, no stopping.",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "The sugar shop's sugar",
    "emotion": "得意",
    "say": "Our sugar"
  },
  "zq33a23": {
    "text": "bought thirty pounds of nails.",
    "emotion": "袋子一塞",
    "say": "for thirty pounds of nails!"
  },
  "zq33a24": {
    "text": "Good nails.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "Tear down the hall,",
    "emotion": "尖著嗓子，拖長音"
  },
  "zq33a26": {
    "text": "and heaven strikes you down!",
    "emotion": "羅盤舉上天",
    "say": "heaven strikes you down!"
  },
  "zq33a27": {
    "text": "Casting off your own ancestors,",
    "emotion": "油滑",
    "say": "Disowning your ancestors,"
  },
  "zq33a28": {
    "text": "Liuxi's bloodline ends right here.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "Heaven's wrath…",
    "emotion": "發毛",
    "say": "Cursed…"
  },
  "zq33a30": {
    "text": "So… do we still tear it down?",
    "emotion": "回頭問大家",
    "say": "Still tear it down?"
  },
  "zq33a31": {
    "text": "The ancestors are thirsty too!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "When the water comes,",
    "emotion": "理直氣壯，短促",
    "say": "Water!"
  },
  "zq33a33": {
    "text": "ancestors drink first!",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "Haha, ancestors drink first!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "Go on, laugh.",
    "emotion": "陰",
    "say": "Laugh."
  },
  "zq33a36": {
    "text": "When day ten comes, we'll see who's crying.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "Second shift,",
    "emotion": "半夜，嗓門不減",
    "say": "Two,"
  },
  "zq33a38": {
    "text": "switch!",
    "emotion": "短促，喊",
    "say": "Swap!"
  },
  "zq33a39": {
    "text": "Angle the blades three degrees,",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "build it like this.",
    "emotion": "畫外"
  },
  "zq33a41": {
    "text": "One piece each,",
    "emotion": "甜，快"
  },
  "zq33a42": {
    "text": "eat up, get strong!",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "Last piece.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "Frame's up.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "Whether it turns, we'll see at noon.",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "Drought mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "expires today.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "Open the gate.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": {
    "text": "Erniu, pull!",
    "emotion": "手一落"
  },
  "zq33a50": {
    "text": "Turn… come on…",
    "emotion": "不敢相信",
    "say": "Turn…"
  },
  "zq33a51": {
    "text": "It stopped…",
    "emotion": "聲音發抖"
  },
  "zq33a52": {
    "text": "Hahahaha!",
    "emotion": "放聲大笑"
  },
  "zq33a53": {
    "text": "Seven days on that beam, for half a turn!",
    "emotion": "嘲笑",
    "say": "Seven days, half a turn!"
  },
  "zq33a54": {
    "text": "Even heaven won't help you!",
    "emotion": "笑到岔氣"
  }
}
