{
  "zq33a01": {
    "text": "Pinjam baloknya.",
    "say": "Pinjam balok.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "Tiga tahun kukembalikan.",
    "say": "Tiga tahun kembali.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "Kalau leluhur marah,",
    "emotion": "篤定"
  },
  "zq33a04": {
    "text": "salahkan aku si tua.",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "Tali sudah terpasang.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "Semua mundur!",
    "emotion": "吼",
    "say": "Mundur!"
  },
  "zq33a07": {
    "text": "Baloknya turun!",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "Kak Xu, kuat?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "Misi kekeringan:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "Sisa tujuh hari.",
    "emotion": "平板電子音"
  },
  "zq33a11": "Tujuh hari?",
  "zq33a12": {
    "text": "Kincir sebesar ini,",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "tujuh hari nggak jadi.",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "Bisa.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "Kau pimpin orang, aku gambar.",
    "say": "Kau pimpin, aku gambar.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "Kalau gagal,",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "kau tanggung baloknya.",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "Semua lelaki desa,",
    "emotion": "嗓門亮，站在高處"
  },
  "zq33a19": {
    "text": "tiga regu!",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "Satu kerja, dua tidur,",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "bergilir, jangan berhenti.",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "Gula dari dapur gula,",
    "emotion": "得意",
    "say": "Gula kami,"
  },
  "zq33a23": {
    "text": "ditukar lima belas kilo paku.",
    "emotion": "袋子一塞"
  },
  "zq33a24": {
    "text": "Paku bagus.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "Bongkar rumah leluhur,",
    "emotion": "尖著嗓子，拖長音"
  },
  "zq33a26": {
    "text": "kena kutukan langit!",
    "emotion": "羅盤舉上天"
  },
  "zq33a27": {
    "text": "Leluhur saja sudah dibuang,",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "Liuxi bakal punah, lho.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "Kutukan langit…",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "Masih jadi dibongkar?",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "Leluhur juga haus!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "Kalau air datang,",
    "emotion": "理直氣壯",
    "say": "Air datang,"
  },
  "zq33a33": {
    "text": "leluhur minum duluan!",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "Haha, leluhur minum duluan!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "Tertawalah.",
    "emotion": "陰"
  },
  "zq33a36": {
    "text": "Hari kesepuluh, lihat siapa yang menangis.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "Regu dua,",
    "say": "Dua,"
  },
  "zq33a38": {
    "text": "ganti!",
    "emotion": "旗桿敲石頭"
  },
  "zq33a39": {
    "text": "Bilahnya miring tiga derajat,",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "buat begini.",
    "emotion": "畫外",
    "say": "Begini."
  },
  "zq33a41": "Satu orang satu,",
  "zq33a42": {
    "text": "biar kuat kerja!",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "Pasak terakhir.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "Rangkanya berdiri.",
    "say": "Sudah berdiri.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "Muter atau nggak, lihat siang.",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "Misi kekeringan:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "jatuh tempo hari ini.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "Buka pintu air.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": "Erniu, tarik!",
  "zq33a50": {
    "text": "Muter…",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "Berhenti…",
    "emotion": "聲音發抖"
  },
  "zq33a52": "Hahahaha!",
  "zq33a53": {
    "text": "Balok tujuh hari, muter setengah!",
    "emotion": "拍大腿，拖長音"
  },
  "zq33a54": {
    "text": "Langit pun nggak menolongmu!",
    "emotion": "笑到岔氣"
  }
}
