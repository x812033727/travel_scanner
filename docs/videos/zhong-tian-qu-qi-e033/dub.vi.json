{
  "zq33a01": {
    "text": "Mượn xà.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "Ba năm trả.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "Tổ tiên có trách,",
    "say": "Tổ tiên có trách",
    "emotion": "慢，篤定"
  },
  "zq33a04": "cứ trách lão già này.",
  "zq33a05": {
    "text": "Dây, buộc xong rồi.",
    "say": "Dây buộc xong rồi.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "Tránh ra hết,",
    "say": "Tránh ra",
    "emotion": "吼"
  },
  "zq33a07": "xà hạ xuống đây.",
  "zq33a08": {
    "text": "Hứa đại ca, chịu nổi không?",
    "say": "Hứa đại ca chịu nổi không?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "Nhiệm vụ hạn hán:",
    "say": "Nhiệm vụ: hạn hán",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "còn bảy ngày.",
    "emotion": "平板電子音"
  },
  "zq33a11": {
    "text": "Bảy ngày?",
    "emotion": "瞪著圖，不信"
  },
  "zq33a12": {
    "text": "Bánh xe to thế này,",
    "say": "Bánh xe to thế này",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": "bảy ngày không làm nổi.",
  "zq33a14": {
    "text": "Làm nổi.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "Ngươi dẫn người, ta vẽ.",
    "say": "Ngươi dẫn người ta vẽ.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "Làm hỏng,",
    "say": "Làm hỏng",
    "emotion": "瞇眼"
  },
  "zq33a17": "xà tính cho ngươi.",
  "zq33a18": {
    "text": "Trai tráng cả làng,",
    "say": "Trai tráng cả làng",
    "emotion": "嗓門亮，站在高處"
  },
  "zq33a19": "chia ba ca!",
  "zq33a20": {
    "text": "Một ca làm, hai ca ngủ,",
    "say": "Một ca làm hai ca ngủ",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "thay phiên, không được dừng.",
    "say": "thay phiên không được dừng."
  },
  "zq33a22": {
    "text": "Đường của xưởng,",
    "say": "Đường của xưởng",
    "emotion": "得意"
  },
  "zq33a23": "đổi được ba mươi cân đinh.",
  "zq33a24": {
    "text": "Đinh tốt.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "Dỡ từ đường,",
    "say": "Dỡ từ đường",
    "emotion": "尖著嗓子"
  },
  "zq33a26": "trời tru đất diệt!",
  "zq33a27": {
    "text": "Tổ tiên cũng chẳng cần,",
    "say": "Tổ tiên cũng chẳng cần",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "Liễu Khê sắp tuyệt tự rồi.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "Trời tru đất diệt…",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "Vậy còn dỡ không?",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "Tổ tiên cũng khát mà!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "Nước về rồi,",
    "say": "Nước về",
    "emotion": "短促"
  },
  "zq33a33": "tổ tiên uống trước!",
  "zq33a34": {
    "text": "Haha, tổ tiên uống trước!",
    "say": "Haha tổ tiên uống trước!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "Cứ cười đi.",
    "emotion": "陰"
  },
  "zq33a36": {
    "text": "Đến ngày thứ mười, xem ai khóc.",
    "say": "Đến ngày thứ mười xem ai khóc.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "Ca hai,",
    "say": "Ca hai",
    "emotion": "半夜，嗓門不減"
  },
  "zq33a38": {
    "text": "đổi!",
    "emotion": "旗桿敲石頭"
  },
  "zq33a39": {
    "text": "Cánh guồng nghiêng ba phân,",
    "say": "Cánh guồng nghiêng ba phân",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "làm theo đây.",
    "emotion": "畫外"
  },
  "zq33a41": {
    "text": "Mỗi người một miếng,",
    "say": "Mỗi người một miếng",
    "emotion": "甜，快"
  },
  "zq33a42": "ăn cho có sức!",
  "zq33a43": {
    "text": "Miếng cuối cùng.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "Khung dựng rồi.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "Quay hay không, trưa biết.",
    "say": "Quay hay không trưa biết."
  },
  "zq33a46": {
    "text": "Nhiệm vụ hạn hán:",
    "say": "Nhiệm vụ hạn hán",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "hôm nay hết hạn.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "Mở cống.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": {
    "text": "Nhị Ngưu, kéo!",
    "say": "Nhị Ngưu kéo!"
  },
  "zq33a50": {
    "text": "Quay đi…",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "Dừng rồi…",
    "emotion": "聲音發抖"
  },
  "zq33a52": {
    "text": "Ha ha ha ha!",
    "emotion": "放聲大笑"
  },
  "zq33a53": {
    "text": "Xà bảy ngày, quay nửa vòng!",
    "say": "Xà bảy ngày quay nửa vòng!",
    "emotion": "拍大腿"
  },
  "zq33a54": {
    "text": "Ông trời cũng chẳng giúp ngươi!",
    "emotion": "笑到岔氣"
  }
}
