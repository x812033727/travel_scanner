{
  "zq33a01": {
    "text": "대들보를 빌립니다.",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "삼 년 뒤 갚겠습니다.",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "조상님이 탓하시려거든,",
    "emotion": "慢，篤定"
  },
  "zq33a04": {
    "text": "이 늙은이를 탓하십시오.",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "밧줄, 다 걸었다.",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "다들 비켜,",
    "emotion": "吼"
  },
  "zq33a07": {
    "text": "대들보 내려간다.",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "쉬 형, 버틸 수 있어?",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "가뭄 임무:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "남은 기한, 7일.",
    "say": "남은 기한, 칠 일.",
    "emotion": "平板電子音"
  },
  "zq33a11": {
    "text": "7일?",
    "say": "칠 일?",
    "emotion": "瞪著圖，不信"
  },
  "zq33a12": {
    "text": "이렇게 큰 바퀴를,",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "7일에는 못 만들어.",
    "say": "칠 일에는 못 만들어.",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "만들 수 있어요.",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "사람은 목수님이, 도면은 제가.",
    "emotion": "炭筆指著梁"
  },
  "zq33a16": {
    "text": "망치면,",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "대들보 값은 네가 물어.",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "마을 장정 전부,",
    "emotion": "嗓門亮，站在高處"
  },
  "zq33a19": {
    "text": "세 조로 나눈다!",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "한 조는 일하고, 두 조는 잔다,",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "돌아가며 한다, 멈추지 마라.",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "공방 설탕으로,",
    "emotion": "得意"
  },
  "zq33a23": {
    "text": "못 서른 근으로 바꿔 왔어.",
    "emotion": "袋子一塞"
  },
  "zq33a24": {
    "text": "좋은 못이야.",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "사당을 헐면,",
    "emotion": "尖著嗓子，拖長音"
  },
  "zq33a26": {
    "text": "천벌을 받는다!",
    "emotion": "羅盤舉上天"
  },
  "zq33a27": {
    "text": "조상도 내버리다니,",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "류시는 대가 끊기겠구먼.",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "천벌이라……",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "그래도 헐어야 돼?",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "조상님도 목말라!",
    "emotion": "叉腰，奶聲奶氣地大聲"
  },
  "zq33a32": {
    "text": "물이 오면,",
    "emotion": "理直氣壯"
  },
  "zq33a33": {
    "text": "조상님 먼저 마셔!",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "하하, 조상님 먼저 마셔!",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "실컷 웃어라.",
    "emotion": "陰"
  },
  "zq33a36": {
    "text": "열흘 지나면, 누가 우는지 보자.",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "둘째 조,",
    "emotion": "半夜，嗓門不減"
  },
  "zq33a38": {
    "text": "교대!",
    "emotion": "旗桿敲石頭"
  },
  "zq33a39": {
    "text": "날개판은 삼 푼 기울여,",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "이대로 만들어.",
    "emotion": "畫外"
  },
  "zq33a41": {
    "text": "한 사람에 하나씩,",
    "emotion": "甜，快"
  },
  "zq33a42": {
    "text": "먹으면 힘이 나!",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "마지막 쐐기.",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "뼈대는 섰다.",
    "emotion": "難得的一點笑"
  },
  "zq33a45": {
    "text": "도는지는, 정오에 보자.",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "가뭄 임무:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "오늘 기한 만료.",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "수문을 열어라.",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": {
    "text": "얼뉴, 당겨!",
    "emotion": "手一落"
  },
  "zq33a50": {
    "text": "돌아라……",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "멈췄어……",
    "emotion": "聲音發抖"
  },
  "zq33a52": {
    "text": "하하하하!",
    "emotion": "放聲大笑"
  },
  "zq33a53": {
    "text": "이레 걸린 대들보가, 반 바퀴라니!",
    "emotion": "拍大腿，拖長音"
  },
  "zq33a54": {
    "text": "하늘도 널 안 돕는구먼!",
    "emotion": "笑到岔氣"
  }
}
