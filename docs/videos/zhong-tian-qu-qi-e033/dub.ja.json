{
  "zq33a01": {
    "text": "梁を借りる。",
    "emotion": "跪著，對著牌位，一字一頓"
  },
  "zq33a02": {
    "text": "三年で返す。",
    "emotion": "抬頭看著牌位，很穩"
  },
  "zq33a03": {
    "text": "ご先祖様が怒るなら、",
    "emotion": "篤定",
    "say": "怒るなら、"
  },
  "zq33a04": {
    "text": "この老いぼれを怒れ。",
    "emotion": "磕下頭去"
  },
  "zq33a05": {
    "text": "縄、かけたぞ。",
    "emotion": "畫外，粗啞"
  },
  "zq33a06": {
    "text": "離れろ、",
    "emotion": "吼",
    "say": "どけ！"
  },
  "zq33a07": {
    "text": "梁が下りる。",
    "emotion": "繩子繃緊"
  },
  "zq33a08": {
    "text": "兄貴、持つか？",
    "emotion": "喘，大嗓門"
  },
  "zq33a09": {
    "text": "干ばつ任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a10": {
    "text": "残り七日。",
    "emotion": "平板電子音"
  },
  "zq33a11": {
    "text": "七日？",
    "emotion": "瞪著圖，不信"
  },
  "zq33a12": {
    "text": "こんなでかい輪、",
    "emotion": "粗啞，不耐煩"
  },
  "zq33a13": {
    "text": "七日じゃ無理だ。",
    "emotion": "一掌拍在圖上"
  },
  "zq33a14": {
    "text": "できる。",
    "emotion": "很穩"
  },
  "zq33a15": {
    "text": "お前は人を、俺は図を。",
    "emotion": "炭筆指著梁",
    "say": "人はお前、図は俺。"
  },
  "zq33a16": {
    "text": "しくじったら、",
    "emotion": "瞇眼"
  },
  "zq33a17": {
    "text": "梁はお前持ちだ。",
    "emotion": "一把抓起圖"
  },
  "zq33a18": {
    "text": "村の男は全員、",
    "emotion": "嗓門亮，站在高處",
    "say": "男衆、"
  },
  "zq33a19": {
    "text": "三班に分ける！",
    "emotion": "旗子一揮"
  },
  "zq33a20": {
    "text": "一班が働き、二班は寝る。",
    "emotion": "俐落"
  },
  "zq33a21": {
    "text": "交代で、止めるな。",
    "emotion": "旗桿往石頭上一頓"
  },
  "zq33a22": {
    "text": "糖坊の砂糖で、",
    "emotion": "得意",
    "say": "砂糖で、"
  },
  "zq33a23": {
    "text": "釘三十斤と換えた。",
    "emotion": "袋子一塞",
    "say": "釘三十斤！"
  },
  "zq33a24": {
    "text": "いい釘だ。",
    "emotion": "畫外，難得滿意"
  },
  "zq33a25": {
    "text": "祠堂を壊せば、",
    "emotion": "尖著嗓子，拖長音"
  },
  "zq33a26": {
    "text": "天罰が下る！",
    "emotion": "羅盤舉上天"
  },
  "zq33a27": {
    "text": "ご先祖まで捨てて、",
    "emotion": "油滑，拖長音"
  },
  "zq33a28": {
    "text": "柳渓も終わりじゃのう。",
    "emotion": "冷笑"
  },
  "zq33a29": {
    "text": "天罰……",
    "emotion": "發毛"
  },
  "zq33a30": {
    "text": "まだ壊すのか？",
    "emotion": "回頭問大家"
  },
  "zq33a31": {
    "text": "ご先祖だって喉が渇く！",
    "emotion": "叉腰，奶聲奶氣地大聲",
    "say": "ご先祖も渇く！"
  },
  "zq33a32": {
    "text": "水が来たら、",
    "emotion": "理直氣壯"
  },
  "zq33a33": {
    "text": "ご先祖が先に飲む！",
    "emotion": "跺腳"
  },
  "zq33a34": {
    "text": "はは、ご先祖が先だ！",
    "emotion": "笑彎了腰"
  },
  "zq33a35": {
    "text": "笑え。",
    "emotion": "陰"
  },
  "zq33a36": {
    "text": "十日目に、誰が泣くか見ものじゃ。",
    "emotion": "拖長音，轉身就走"
  },
  "zq33a37": {
    "text": "二班、",
    "emotion": "半夜，嗓門不減"
  },
  "zq33a38": {
    "text": "交代！",
    "emotion": "旗桿敲石頭"
  },
  "zq33a39": {
    "text": "羽根板は三分傾ける、",
    "emotion": "畫外，邊畫邊說"
  },
  "zq33a40": {
    "text": "この通りに。",
    "emotion": "畫外"
  },
  "zq33a41": {
    "text": "一人一個、",
    "emotion": "甜，快"
  },
  "zq33a42": {
    "text": "食べて力を出せ！",
    "emotion": "踮腳"
  },
  "zq33a43": {
    "text": "最後の一本。",
    "emotion": "沙啞，七天沒睡好"
  },
  "zq33a44": {
    "text": "骨組みは立った。",
    "emotion": "難得滿意，短",
    "say": "立った。"
  },
  "zq33a45": {
    "text": "回るかは、昼に分かる。",
    "emotion": "拍他的背"
  },
  "zq33a46": {
    "text": "干ばつ任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq33a47": {
    "text": "本日期限。",
    "emotion": "平板電子音，冷"
  },
  "zq33a48": {
    "text": "水門を開けろ。",
    "emotion": "竹杖舉起來，慢，篤定"
  },
  "zq33a49": {
    "text": "アーニウ、引け！",
    "emotion": "手一落"
  },
  "zq33a50": {
    "text": "回れ……",
    "emotion": "不敢相信"
  },
  "zq33a51": {
    "text": "止まった……",
    "emotion": "聲音發抖"
  },
  "zq33a52": {
    "text": "ははははは！",
    "emotion": "放聲大笑"
  },
  "zq33a53": {
    "text": "七日の梁が、半回転！",
    "emotion": "拍大腿，拖長音"
  },
  "zq33a54": {
    "text": "天もお前を見放したわ！",
    "emotion": "笑到岔氣"
  }
}
