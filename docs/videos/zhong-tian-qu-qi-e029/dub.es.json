{
  "zq29a01": "¡Los Xu me obligaron",
  "zq29a02": "a culpar a Casa Wei!",
  "zq29a03": "¡Fuera, venenosos!",
  "zq29a04": "Mi dulce,",
  "zq29a05": {
    "text": "yo primero.",
    "emotion": "篤定，微笑"
  },
  "zq29a06": "¡Estás loco!",
  "zq29a07": "¡Silencio!",
  "zq29a08": "Xu Yan, ¿algo más que decir?",
  "zq29a09": {
    "text": "Él cambia,",
    "emotion": "篤定，語速快"
  },
  "zq29a10": "papel, no.",
  "zq29a11": {
    "text": "¿Un papel",
    "emotion": "搖扇，輕蔑，不笑出聲"
  },
  "zq29a12": "cambia algo?",
  "zq29a13": "El del veneno:",
  "zq29a14": {
    "text": "este.",
    "emotion": "畫外，短促"
  },
  "zq29a15": "Y este,",
  "zq29a16": "es de Casa Xu.",
  "zq29a17": {
    "text": "Prueba: marca de agua de sauce.",
    "say": "Prueba, marca de sauce."
  },
  "zq29a18": "El mío",
  "zq29a19": "lleva la hoja.",
  "zq29a20": {
    "text": "Este no,",
    "emotion": "舉起粗黃紙，語速快"
  },
  "zq29a21": "es de Casa Wei.",
  "zq29a22": "Papel,",
  "zq29a23": {
    "text": "cualquiera lo tiene.",
    "emotion": "冷冷地"
  },
  "zq29a24": "¡El libro!",
  "zq29a25": "Cada lote",
  "zq29a26": "¡numerado!",
  "zq29a27": "Quién,",
  "zq29a28": "aquí está.",
  "zq29a29": "Tu lote,",
  "zq29a30": "¡no existe!",
  "zq29a31": {
    "text": "Lote envenenado: no existe.",
    "say": "Lote tóxico, no existe."
  },
  "zq29a32": "Esa cena,",
  "zq29a33": "¿de quién?",
  "zq29a34": "¡El encargado Sun!",
  "zq29a35": "¡Me pagó!",
  "zq29a36": "¡Mentira!",
  "zq29a37": "Sun,",
  "zq29a38": "confiésalo tú.",
  "zq29a39": {
    "text": "¡A la cárcel!",
    "say": "¡Preso!",
    "emotion": "拍驚堂木，短促"
  },
  "zq29a40": {
    "text": "¡Casa Xu, inocente!",
    "say": "¡Xu, inocente!",
    "emotion": "抹汗"
  },
  "zq29a41": {
    "text": "Guerra comercial: Casa Xu triplica a Casa Wei.",
    "say": "Casa Xu, el triple que Casa Wei."
  },
  "zq29a42": "Este sello,",
  "zq29a43": "¡lo rompo!",
  "zq29a44": "¡Hija!",
  "zq29a45": "¡Cómo te busqué!",
  "zq29a46": "Papá…",
  "zq29a47": "¿Qué haces aquí?",
  "zq29a48": "Suegro,",
  "zq29a49": "justo a tiempo."
}
