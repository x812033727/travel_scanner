{
  "zq29a01": {"text":"쉬가가 시켰어요,","say":"쉬가가 시켰어요"},
  "zq29a02": "독으로 위지를 엮으라고!",
  "zq29a03": "독 가게, 꺼져라!",
  "zq29a04": {"text":"내 설탕,","say":"내 설탕","emotion":"平靜，舉起糖糕，語速快"},
  "zq29a05": {"text":"내가 먹지.","emotion":"輕鬆，語速快"},
  "zq29a06": "미쳤어!",
  "zq29a07": "조용!",
  "zq29a08": "쉬옌, 할 말 있느냐?",
  "zq29a09": {"text":"말은 변해도,","say":"말은 변해도","emotion":"看了賴三一眼，語速快"},
  "zq29a10": {"text":"종이는 그대로.","emotion":"篤定，語速快"},
  "zq29a11": {"text":"종이 한 장,","say":"종이 한 장","emotion":"搖扇，嗤笑，語速快"},
  "zq29a12": "뭘 뒤집어?",
  "zq29a13": {"text":"독 싼 종이,","say":"독 싼 종이","emotion":"畫外，乾脆，語速快"},
  "zq29a14": "이거.",
  "zq29a15": {"text":"그리고 이건,","say":"그리고 이건"},
  "zq29a16": "쉬기 종이.",
  "zq29a17": "물증: 버들잎 워터마크.",
  "zq29a18": {"text":"우리 건,","say":"우리 건","emotion":"對著人群，語速快"},
  "zq29a19": "속에 버들잎이 있죠.",
  "zq29a20": {"text":"이건 없어,","say":"이건 없어"},
  "zq29a21": "위지의 거친 종이야.",
  "zq29a22": {"text":"종이야,","say":"종이야"},
  "zq29a23": "누구나 사지.",
  "zq29a24": "장부는?",
  "zq29a25": {"text":"설탕마다,","say":"설탕마다","emotion":"翻開帳本，語速快"},
  "zq29a26": "번호가 있어!",
  "zq29a27": {"text":"산 사람도,","say":"산 사람도","emotion":"指著帳，語速快"},
  "zq29a28": "다 적혔어.",
  "zq29a29": {"text":"말한 그 물량,","say":"말한 그 물량"},
  "zq29a30": "아예 없어!",
  "zq29a31": "독 설탕 번호: 기록 없음.",
  "zq29a32": {"text":"어젯밤 찬합,","say":"어젯밤 찬합","emotion":"壓低聲音，語速快"},
  "zq29a33": "누가 줬어?",
  "zq29a34": "쑨 장궤예요!",
  "zq29a35": "그가 은자를 줬어요!",
  "zq29a36": "헛소리!",
  "zq29a37": {"text":"쑨 장궤,","say":"쑨 장궤"},
  "zq29a38": "네가 인정해.",
  "zq29a39": "끌어내라!",
  "zq29a40": "쉬기, 무죄!",
  "zq29a41": "매출전 총계: 쉬기가 위지의 세 배.",
  "zq29a42": {"text":"이 봉인은,","say":"이 봉인은"},
  "zq29a43": "내가 뜯을래!",
  "zq29a44": "아가!",
  "zq29a45": "아빠가 얼마나 찾았는데!",
  "zq29a46": "아빠…",
  "zq29a47": "여긴 어떻게 왔어?",
  "zq29a48": {"text":"장인어른,","say":"장인어른"},
  "zq29a49": "마침 잘 오셨습니다."
}
