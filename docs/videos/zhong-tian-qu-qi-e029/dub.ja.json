{
  "zq29a01": "シュー家に脅されて、",
  "zq29a02": "ウェイ記に罪を着せろと！",
  "zq29a03": "毒の店は出ていけ！",
  "zq29a04": { "text": "うちの砂糖、", "say": "うちのは", "emotion": "平靜" },
  "zq29a05": "まず俺が食う。",
  "zq29a06": "正気なの!?",
  "zq29a07": { "text": "静粛に！", "say": "静粛！", "emotion": "拍驚堂木，短促" },
  "zq29a08": { "text": "シュー・イェン、申し開きはあるか？", "emotion": "官腔" },
  "zq29a09": { "text": "人は寝返る、", "emotion": "篤定，快" },
  "zq29a10": "紙は違う。",
  "zq29a11": "紙一枚で、",
  "zq29a12": "何が覆る？",
  "zq29a13": { "text": "毒菓子を包んだのは", "say": "包んだのは", "emotion": "快" },
  "zq29a14": "この紙。",
  "zq29a15": "そしてこれ、",
  "zq29a16": "シュー記の紙。",
  "zq29a17": { "text": "物証：柳の葉の透かし。", "say": "物証、柳の葉の透かし。" },
  "zq29a18": { "text": "うちの紙は、", "say": "うちの紙", "emotion": "快" },
  "zq29a19": "中に柳の葉がある。",
  "zq29a20": "これには無い、",
  "zq29a21": "ウェイ記の粗紙だ。",
  "zq29a22": "紙など、",
  "zq29a23": "誰でも買える。",
  "zq29a24": "帳簿は？",
  "zq29a25": "シュー記の砂糖は、",
  "zq29a26": "全部番号付き！",
  "zq29a27": { "text": "買い手も、", "emotion": "快" },
  "zq29a28": "全部ここに。",
  "zq29a29": { "text": "その分、", "say": "その分", "emotion": "一秒變精明，快" },
  "zq29a30": "存在しない！",
  "zq29a31": "毒砂糖の番号：該当なし。",
  "zq29a32": { "text": "昨夜の重箱、", "say": "あの重箱", "emotion": "壓低聲音，快" },
  "zq29a33": "誰からだ？",
  "zq29a34": "スン店主だ！",
  "zq29a35": "金をくれた！",
  "zq29a36": "でたらめを！",
  "zq29a37": "スン店主、",
  "zq29a38": "潔く認めろ。",
  "zq29a39": "連れて行け！",
  "zq29a40": { "text": "シュー記、無罪！", "emotion": "官腔，宣判" },
  "zq29a41": { "text": "商戦総額：シュー記がウェイ記の三倍。", "say": "総額、シュー記がウェイ記の三倍。" },
  "zq29a42": "この封印、",
  "zq29a43": "私が剥がす！",
  "zq29a44": "娘や！",
  "zq29a45": "父さん探したんだぞぉ！",
  "zq29a46": { "text": "父さん……", "say": "父……", "emotion": "愣住，輕聲，極短，不要嘆氣" },
  "zq29a47": "どうしてここに？",
  "zq29a48": "お義父上、",
  "zq29a49": "ちょうどいい。"
}
