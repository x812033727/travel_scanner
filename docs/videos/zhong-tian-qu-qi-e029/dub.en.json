{
  "zq29a01": "The Xus made me poison it",
  "zq29a02": "to frame Wei and Co.!",
  "zq29a03": "Poison shop, get out of town!",
  "zq29a04": "Our sugar,",
  "zq29a05": { "text": "I eat first.", "emotion": "微笑著說，不笑出聲" },
  "zq29a06": "Are you crazy?",
  "zq29a07": "Silence!",
  "zq29a08": "Xu Yan, what have you to say?",
  "zq29a09": "Witnesses change,",
  "zq29a10": "paper doesn't.",
  "zq29a11": "A piece of paper",
  "zq29a12": "will turn the tables?",
  "zq29a13": "The poison cakes",
  "zq29a14": "used this.",
  "zq29a15": "And this one",
  "zq29a16": "is Xu's paper.",
  "zq29a17": "Evidence: willow-leaf watermark.",
  "zq29a18": "Ours",
  "zq29a19": "has a willow leaf inside.",
  "zq29a20": "This one doesn't.",
  "zq29a21": "It's Wei and Co.'s coarse paper.",
  "zq29a22": "Paper?",
  "zq29a23": "Anyone can buy it.",
  "zq29a24": "And the books?",
  "zq29a25": "Every batch we make",
  "zq29a26": "is numbered!",
  "zq29a27": "Who bought it",
  "zq29a28": "is all in here.",
  "zq29a29": "That batch",
  "zq29a30": "doesn't exist!",
  "zq29a31": "Poison batch number: no such batch.",
  "zq29a32": "Last night's supper box,",
  "zq29a33": "who brought it?",
  "zq29a34": "Manager Sun!",
  "zq29a35": "He paid me!",
  "zq29a36": "Lies!",
  "zq29a37": "Manager Sun,",
  "zq29a38": "just own up.",
  "zq29a39": { "text": "Take him!", "emotion": "拍驚堂木，短促一喝" },
  "zq29a40": "Xu's: not guilty!",
  "zq29a41": "Trade war total: Xu's at triple Wei and Co.",
  "zq29a42": "This seal,",
  "zq29a43": "I'll tear it!",
  "zq29a44": "Honey!",
  "zq29a45": "Daddy's searched everywhere for you!",
  "zq29a46": "Dad…",
  "zq29a47": "What are you doing here?",
  "zq29a48": "Father-in-law,",
  "zq29a49": "perfect timing."
}
