{
  "zq29a01": {
    "text": "Xu memaksaku,",
    "emotion": "指向許硯，語速快",
    "say": "Xu memaksaku"
  },
  "zq29a02": {
    "text": "racuni dan fitnah Wei!",
    "emotion": "喊，語速快"
  },
  "zq29a03": {
    "text": "Toko racun, pergi!",
    "emotion": "帶頭喊，語速快"
  },
  "zq29a04": {
    "text": "Gula kami,",
    "emotion": "平靜，短促",
    "say": "Gula kami"
  },
  "zq29a05": {
    "text": "aku dulu.",
    "emotion": "平靜"
  },
  "zq29a06": "Kamu gila!",
  "zq29a07": {
    "text": "Tenang!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq29a08": {
    "text": "Xu Yan, ada pembelaan?",
    "emotion": "官腔"
  },
  "zq29a09": {
    "text": "Saksi berubah,",
    "emotion": "語速快",
    "say": "Saksi berubah"
  },
  "zq29a10": "kertas nggak.",
  "zq29a11": {
    "text": "Kertas,",
    "say": "Kertas"
  },
  "zq29a12": "bisa apa?",
  "zq29a13": {
    "text": "Kue racun,",
    "say": "Kue racun"
  },
  "zq29a14": "pakai ini.",
  "zq29a15": {
    "text": "Yang ini,",
    "say": "Yang ini"
  },
  "zq29a16": "kertas Toko Xu.",
  "zq29a17": "Bukti: tanda air dedalu.",
  "zq29a18": {
    "text": "Punya kami,",
    "emotion": "語速快",
    "say": "Punya kami"
  },
  "zq29a19": {
    "text": "ada daun dedalunya.",
    "emotion": "篤定"
  },
  "zq29a20": {
    "text": "Ini?",
    "emotion": "舉起粗黃紙，短促"
  },
  "zq29a21": "kertas kasar Wei.",
  "zq29a22": "Kertas?",
  "zq29a23": "Semua bisa beli.",
  "zq29a24": "Pembukuan?",
  "zq29a25": {
    "text": "Tiap kloter gula,",
    "emotion": "揚聲，語速快",
    "say": "Tiap kloter gula"
  },
  "zq29a26": "ada nomornya!",
  "zq29a27": {
    "text": "Pembeli,",
    "say": "Pembeli"
  },
  "zq29a28": "tercatat.",
  "zq29a29": {
    "text": "Kloter itu,",
    "emotion": "精明，語速快",
    "say": "Kloter itu"
  },
  "zq29a30": "nggak pernah ada!",
  "zq29a31": "Kloter racun: tidak ada.",
  "zq29a32": {
    "text": "Rantang itu,",
    "emotion": "壓低聲音，語速快",
    "say": "Rantang itu"
  },
  "zq29a33": {
    "text": "dari siapa?",
    "emotion": "盯著他，語速快"
  },
  "zq29a34": {
    "text": "Juragan Sun!",
    "emotion": "崩潰大喊"
  },
  "zq29a35": {
    "text": "Dia bayar!",
    "emotion": "指向人群，語速快"
  },
  "zq29a36": {
    "text": "Fitnah!",
    "emotion": "臉色一僵，短促"
  },
  "zq29a37": {
    "text": "Sun,",
    "say": "Sun"
  },
  "zq29a38": "akui saja.",
  "zq29a39": {
    "text": "Bawa dia!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq29a40": {
    "text": "Toko Xu bebas!",
    "emotion": "官腔，語速快"
  },
  "zq29a41": "Omzet Toko Xu tiga kali Toko Wei.",
  "zq29a42": {
    "text": "Segel ini,",
    "say": "Segel ini"
  },
  "zq29a43": "aku yang robek!",
  "zq29a44": {
    "text": "Nak!",
    "emotion": "撲下車，大喊"
  },
  "zq29a45": {
    "text": "Ayah cari ke mana-mana!",
    "emotion": "誇張地喊，語速快"
  },
  "zq29a46": {
    "text": "Ayah…",
    "emotion": "愣住，短促"
  },
  "zq29a47": "Kok Ayah di sini?",
  "zq29a48": {
    "text": "Ayah mertua,",
    "say": "Ayah mertua"
  },
  "zq29a49": "pas sekali."
}
