{
  "zq29a01": {
    "text": "Hứa gia ép tiểu nhân",
    "emotion": "跪著，指向許硯，豁出去，語速快"
  },
  "zq29a02": {
    "text": "bỏ độc vu oan Ngụy Ký!",
    "emotion": "豁出去地喊，語速快"
  },
  "zq29a03": {
    "text": "Tiệm độc, cút khỏi huyện thành!",
    "say": "Tiệm độc cút khỏi huyện thành!"
  },
  "zq29a04": {
    "text": "Đường nhà ta,",
    "say": "Đường nhà ta",
    "emotion": "平靜，語速快"
  },
  "zq29a05": {
    "text": "ta ăn trước.",
    "emotion": "平靜，微笑著說，不笑出聲"
  },
  "zq29a06": "Huynh điên rồi!",
  "zq29a07": {
    "text": "Im lặng!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq29a08": {
    "text": "Hứa Nghiên, ngươi còn gì để nói?",
    "say": "Hứa Nghiên ngươi còn gì để nói?",
    "emotion": "官腔"
  },
  "zq29a09": {
    "text": "Nhân chứng đổi lời,",
    "say": "Nhân chứng đổi lời",
    "emotion": "篤定，語速快"
  },
  "zq29a10": "giấy thì không.",
  "zq29a11": {
    "text": "Một tờ giấy,",
    "say": "Một tờ giấy",
    "emotion": "搖扇，輕蔑"
  },
  "zq29a12": {
    "text": "lật được trời sao?",
    "emotion": "輕蔑"
  },
  "zq29a13": {
    "text": "Gói bánh độc,",
    "say": "Gói bánh độc"
  },
  "zq29a14": "là tờ này.",
  "zq29a15": {
    "text": "Còn tờ này,",
    "say": "Còn tờ này"
  },
  "zq29a16": "là giấy Hứa Ký.",
  "zq29a17": "Vật chứng: thủy ấn lá liễu.",
  "zq29a18": {
    "text": "Giấy Hứa Ký,",
    "say": "Giấy Hứa Ký",
    "emotion": "對著人群，語速快"
  },
  "zq29a19": {
    "text": "trong lòng đều có lá liễu.",
    "emotion": "得意，不笑出聲"
  },
  "zq29a20": {
    "text": "Tờ này không,",
    "say": "Tờ này không",
    "emotion": "舉起粗黃紙，語速快"
  },
  "zq29a21": "là giấy thô Ngụy Ký.",
  "zq29a22": {
    "text": "Giấy à,",
    "say": "Giấy à"
  },
  "zq29a23": {
    "text": "ai mà chẳng mua được.",
    "emotion": "冷冷地"
  },
  "zq29a24": "Còn sổ sách?",
  "zq29a25": {
    "text": "Mỗi mẻ đường,",
    "say": "Mỗi mẻ đường"
  },
  "zq29a26": "đều đánh số!",
  "zq29a27": {
    "text": "Ai mua,",
    "say": "Ai mua"
  },
  "zq29a28": "ghi hết đây.",
  "zq29a29": {
    "text": "Mẻ ngươi nói,",
    "say": "Mẻ ngươi nói",
    "emotion": "一秒變精明，語速快"
  },
  "zq29a30": "căn bản không có!",
  "zq29a31": "Lô đường độc: không tồn tại.",
  "zq29a32": {
    "text": "Hộp cơm đêm qua,",
    "say": "Hộp cơm đêm qua",
    "emotion": "壓低聲音，語速快"
  },
  "zq29a33": "ai mang tới?",
  "zq29a34": "Là Tôn chưởng quỹ!",
  "zq29a35": "Hắn đưa bạc!",
  "zq29a36": "Nói láo!",
  "zq29a37": {
    "text": "Tôn chưởng quỹ,",
    "say": "Tôn chưởng quỹ"
  },
  "zq29a38": "ngươi tự nhận đi.",
  "zq29a39": {
    "text": "Giải đi!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq29a40": {
    "text": "Hứa Ký, vô tội!",
    "say": "Hứa Ký vô tội!",
    "emotion": "抹汗，官腔"
  },
  "zq29a41": "Tổng sổ: Hứa Ký gấp ba Ngụy Ký.",
  "zq29a42": {
    "text": "Niêm phong này,",
    "say": "Niêm phong này"
  },
  "zq29a43": "để ta xé!",
  "zq29a44": {
    "text": "Con gái!",
    "emotion": "哭著喊"
  },
  "zq29a45": {
    "text": "Cha tìm con khổ quá!",
    "emotion": "誇張的哭腔"
  },
  "zq29a46": {
    "text": "Cha…",
    "say": "Cha",
    "emotion": "笑容僵住，短促"
  },
  "zq29a47": "sao cha lại tới đây?",
  "zq29a48": {
    "text": "Nhạc phụ đại nhân,",
    "say": "Nhạc phụ đại nhân",
    "emotion": "整整衣襟，討好"
  },
  "zq29a49": "đến thật đúng lúc."
}
