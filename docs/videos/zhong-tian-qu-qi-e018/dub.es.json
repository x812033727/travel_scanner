{
  "zq18a01": "¡La receta secreta está en el cofre del taller!",
  "zq18a02": "Cojea.",
  "zq18a03": "Picó el pez.",
  "zq18a04": "Misión obligatoria: cinco días.",
  "zq18a05": "Señor contador, pruebe un dulce.",
  "zq18a06": "Una bolsa por una página.",
  "zq18a07": {
    "text": "Casa Wei: trescientos taeles.",
    "say": "Wei: trescientos."
  },
  "zq18a08": "¿Quién es Wei?",
  "zq18a09": "Tras don Qian,",
  "zq18a10": "hay otro.",
  "zq18a11": "¿Los Qian lo quemaron",
  "zq18a12": "y la Casa Wei pagó?",
  "zq18a13": "Agua de cúrcuma,",
  "zq18a14": "¿Para qué es lo amarillo?",
  "zq18a15": "Esta noche lo verás.",
  "zq18a16": "¿Qué diablos es esto…?",
  "zq18a17": "¿Lo dejas ir?",
  "zq18a18": "Sí,",
  "zq18a19": "a ver quién abre.",
  "zq18a20": "¡Xu Yan vende papel y no paga ni un cobre de impuestos!",
  "zq18a21": "Xu Yan, ¿reconoces tu delito?",
  "zq18a22": "Don Qian,",
  "zq18a23": "¿sus manos?",
  "zq18a24": "Ha… hace frío.",
  "zq18a25": "Las manos.",
  "zq18a26": "La cúrcuma con ceniza…",
  "zq18a27": "enrojece.",
  "zq18a28": {
    "text": "Lai San: atrapado con las manos en la masa.",
    "say": "Lai San, manos en la masa."
  },
  "zq18a29": "Déjame ir,",
  "zq18a30": "y te digo quién te empujó al río."
}
