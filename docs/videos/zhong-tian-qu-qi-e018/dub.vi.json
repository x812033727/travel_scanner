{
  "zq18a01": "Công thức bí truyền nằm trong rương ở xưởng!",
  "zq18a02": "Kẻ thọt.",
  "zq18a03": "Cá cắn câu rồi.",
  "zq18a04": "Nhiệm vụ bắt buộc: còn năm ngày.",
  "zq18a05": "Tiên sinh giữ sổ, nếm thử kẹo nào.",
  "zq18a06": "Một gói kẹo, đổi một trang sổ.",
  "zq18a07": "Ngụy Ký: bạc ba trăm.",
  "zq18a08": {
    "text": "Ngụy Ký là ai?",
    "say": "Ngụy Ký?"
  },
  "zq18a09": "Sau lưng lão Tiền,",
  "zq18a10": "còn kẻ khác.",
  "zq18a11": "Tiền phủ phóng hỏa,",
  "zq18a12": "Ngụy Ký bỏ tiền?",
  "zq18a13": "Nước nghệ,",
  "zq18a14": "Thứ vàng này làm gì?",
  "zq18a15": "Đêm nay nàng sẽ biết.",
  "zq18a16": "Cái quái gì thế này…",
  "zq18a17": "Không bắt?",
  "zq18a18": "Thả hắn về,",
  "zq18a19": "xem ai mở rương.",
  "zq18a20": "Hứa Nghiên bán giấy, không nộp một văn thuế!",
  "zq18a21": "Hứa Nghiên, ngươi có biết tội chưa?",
  "zq18a22": {
    "text": "Tiền viên ngoại,",
    "say": "Viên ngoại,"
  },
  "zq18a23": "sao giấu tay thế?",
  "zq18a24": "Trời, trời lạnh.",
  "zq18a25": "Đưa tay ra.",
  "zq18a26": "Nghệ gặp tro bếp,",
  "zq18a27": "là hóa đỏ.",
  "zq18a28": "Lại Tam: bắt quả tang.",
  "zq18a29": "Tha cho ta,",
  "zq18a30": "ta nói ai đẩy ngươi xuống sông."
}
