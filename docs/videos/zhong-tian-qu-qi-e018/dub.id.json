{
  "zq18a01": "Resep rahasianya dikunci di peti pabrik kertas!",
  "zq18a02": {
    "text": "Si pincang.",
    "say": "Pincang."
  },
  "zq18a03": "Ikannya makan umpan.",
  "zq18a04": "Misi wajib, sisa lima hari.",
  "zq18a05": "Pak Juru Buku, cicipi gulanya.",
  "zq18a06": {
    "text": "Sebungkus gula, tukar satu halaman pembukuan.",
    "say": "Sebungkus gula, satu halaman."
  },
  "zq18a07": {
    "text": "Toko Wei, tiga ratus tael perak.",
    "say": "Toko Wei, tiga ratus."
  },
  "zq18a08": {
    "text": "Wei itu siapa?",
    "say": "Wei siapa?"
  },
  "zq18a09": "Di belakang Tuan Qian,",
  "zq18a10": "masih ada orang.",
  "zq18a11": "Keluarga Qian yang bakar,",
  "zq18a12": "Toko Wei yang bayar?",
  "zq18a13": "Air kunyit,",
  "zq18a14": {
    "text": "Yang kuning ini buat apa?",
    "say": "Kuning gini buat apa?"
  },
  "zq18a15": {
    "text": "Nanti malam kamu tahu.",
    "say": "Lihat nanti malam."
  },
  "zq18a16": "Benda apaan ini…",
  "zq18a17": {
    "text": "Nggak ditangkap?",
    "say": "Dibiarin?"
  },
  "zq18a18": {
    "text": "Biar dia bawa pulang,",
    "say": "Biar dibawa,"
  },
  "zq18a19": "siapa yang buka.",
  "zq18a20": {
    "text": "Xu Yan jual kertas, sekoin pun nggak bayar pajak!",
    "say": "Xu Yan nggak bayar pajak!"
  },
  "zq18a21": "Xu Yan, tahukah kau kesalahanmu?",
  "zq18a22": "Tuan Qian,",
  "zq18a23": {
    "text": "kok tangannya nggak dikeluarin?",
    "say": "tangannya kok diumpetin?"
  },
  "zq18a24": "Di… dingin, sih.",
  "zq18a25": {
    "text": "Ulurkan tangan.",
    "say": "Ulurkan."
  },
  "zq18a26": "Kunyit kena abu kayu,",
  "zq18a27": "jadi merah.",
  "zq18a28": "Lai San, tertangkap basah.",
  "zq18a29": "Lepasin aku,",
  "zq18a30": {
    "text": "kukasih tahu siapa yang dorong kau ke sungai.",
    "say": "siapa yang dorong kau."
  }
}
