{
  "zq18a01": "비법은 공방 상자 속에!",
  "zq18a02": "절어.",
  "zq18a03": "미끼 물었다.",
  "zq18a04": "강제 미션, 닷새 남음.",
  "zq18a05": "서기님, 사탕 드세요.",
  "zq18a06": "사탕 하나에 한 장.",
  "zq18a07": "위지, 은 삼백.",
  "zq18a08": "위지가 뭐야?",
  "zq18a09": "첸 나리 뒤에,",
  "zq18a10": "누가 있어.",
  "zq18a11": "첸 가가 불 지르고,",
  "zq18a12": "위지가 돈 댔다?",
  "zq18a13": "강황 물,",
  "zq18a14": "이 노란 거 뭐야?",
  "zq18a15": "밤에 알게 돼.",
  "zq18a16": "이게 뭐야…",
  "zq18a17": "안 잡아?",
  "zq18a18": "가져가게 둬,",
  "zq18a19": "누가 여는지.",
  "zq18a20": "쉬옌이 종이 팔고 세금 안 냈소!",
  "zq18a21": "쉬옌, 네 죄를 아느냐?",
  "zq18a22": "첸 나리,",
  "zq18a23": "손은 왜 숨겨요?",
  "zq18a24": "나, 날이 추워서.",
  "zq18a25": "손 내.",
  "zq18a26": "강황이 재에 닿으면,",
  "zq18a27": "빨개져.",
  "zq18a28": "라이싼, 현행범 확보.",
  "zq18a29": "한 번만 봐주게,",
  "zq18a30": "누가 자넬 밀었는지 알려 주지."
}
