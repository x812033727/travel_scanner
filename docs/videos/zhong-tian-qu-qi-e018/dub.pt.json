{
  "zq18a01": "A receita secreta tá no baú da oficina!",
  "zq18a02": "O manco.",
  "zq18a03": "O peixe mordeu.",
  "zq18a04": {
    "text": "Missão obrigatória: faltam cinco dias.",
    "say": "Missão: faltam cinco dias."
  },
  "zq18a05": "Seu contador, prova um doce.",
  "zq18a06": "Um saquinho, uma página.",
  "zq18a07": {
    "text": "Wei & Cia.: trezentos taéis.",
    "say": "Wei: trezentos taéis."
  },
  "zq18a08": "Quem é o Wei?",
  "zq18a09": {
    "text": "Por trás do Senhor Qian,",
    "say": "Por trás do Qian,"
  },
  "zq18a10": "tem outro.",
  "zq18a11": "Os Qian puseram fogo,",
  "zq18a12": {
    "text": "e a Wei & Cia. pagou?",
    "say": "e o Wei pagou?"
  },
  "zq18a13": "Água de cúrcuma,",
  "zq18a14": "Pra que esse amarelo?",
  "zq18a15": "De noite você vê.",
  "zq18a16": "Que diabo é isso…",
  "zq18a17": "Não pega?",
  "zq18a18": "Deixa ir,",
  "zq18a19": "e vê quem abre.",
  "zq18a20": "Xu Yan vende papel e não paga imposto!",
  "zq18a21": "Xu Yan, reconhece seu crime?",
  "zq18a22": {
    "text": "Senhor Qian,",
    "say": "Seu Qian,"
  },
  "zq18a23": {
    "text": "por que esconde as mãos?",
    "say": "e as mãos?"
  },
  "zq18a24": "É… é o frio.",
  "zq18a25": "Mostra a mão.",
  "zq18a26": "Cúrcuma com cinza,",
  "zq18a27": "avermelha.",
  "zq18a28": {
    "text": "Lai San: pego com a mão na massa.",
    "say": "Lai San: mão na massa."
  },
  "zq18a29": "Me livra dessa,",
  "zq18a30": "e eu digo quem te empurrou no rio."
}
