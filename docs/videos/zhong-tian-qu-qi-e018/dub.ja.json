{
  "zq18a01": "秘伝は工房の箱の中だ！",
  "zq18a02": "あの足。",
  "zq18a03": "魚がかかった。",
  "zq18a04": "強制任務、残り五日。",
  "zq18a05": "番頭さん、飴どうぞ。",
  "zq18a06": "飴一つで帳簿一枚。",
  "zq18a07": "ウェイ記、銀三百。",
  "zq18a08": "ウェイ記って？",
  "zq18a09": "チエンの裏に、",
  "zq18a10": "誰かいる。",
  "zq18a11": "放火はチエン、",
  "zq18a12": "金はウェイ記？",
  "zq18a13": "ウコン水、",
  "zq18a14": "その黄色は何？",
  "zq18a15": "今夜わかる。",
  "zq18a16": "なんだこりゃ……",
  "zq18a17": "捕らない？",
  "zq18a18": "帰らせて、",
  "zq18a19": "誰が開けるか。",
  "zq18a20": "紙を売って、税は一文も払わず！",
  "zq18a21": "シュー・イェン、罪を認めるか？",
  "zq18a22": "旦那",
  "zq18a23": "その手は？",
  "zq18a24": "さ、寒くてな。",
  "zq18a25": "手を。",
  "zq18a26": "ウコンに灰",
  "zq18a27": "赤くなる。",
  "zq18a28": "ライ・サン、現行犯。",
  "zq18a29": "見逃してくれ、",
  "zq18a30": "川に突き落とした奴を教える。"
}
