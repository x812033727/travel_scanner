{
  "zq18a01": "The secret recipe's locked in the mill's chest!",
  "zq18a02": "A limp.",
  "zq18a03": "The fish bit.",
  "zq18a04": "Mandatory mission: five days left.",
  "zq18a05": "Mister Bookkeeper, have some candy.",
  "zq18a06": "One bag of sugar, one page of books.",
  "zq18a07": "Wei and Co., three hundred.",
  "zq18a08": "Who's Wei?",
  "zq18a09": "Behind Squire Qian,",
  "zq18a10": "someone else.",
  "zq18a11": "The Qians set the fire,",
  "zq18a12": "and Wei and Co. paid?",
  "zq18a13": "Turmeric water,",
  "zq18a14": "What's the yellow stuff for?",
  "zq18a15": "You'll see tonight.",
  "zq18a16": "What the hell is this…",
  "zq18a17": "Not grabbing him?",
  "zq18a18": "Let him take it home,",
  "zq18a19": "see who opens it.",
  "zq18a20": "Xu Yan sells paper and pays no tax!",
  "zq18a21": "Xu Yan, do you know your crime?",
  "zq18a22": "Squire Qian,",
  "zq18a23": "why hide your hands?",
  "zq18a24": "It's, um, cold.",
  "zq18a25": "Hands out.",
  "zq18a26": "Add ash,",
