  "lines": {
    "c8ck": {
      "source_hash": "6e88b3971eb7",
      "text": "1991년 영국 노인 둘이 신문사에 고백합니다."
    },
    "rr6y": {
      "source_hash": "e9c2a10b9fff",
      "text": "크롭 서클을 나무판 하나로 눌러 만들었습니다."
    },
    "i5dd": {
      "source_hash": "5c0dd611980d",
      "text": "복잡해 사람이 못 만들 듯합니다."
    },
    "qnby": {
      "source_hash": "a6a7a52af1af",
      "text": "처음엔 원 하나입니다."
    },
    "hkq8": {
      "source_hash": "36abb7633671",
      "text": "왜 밝힙니까?"
    },
    "fp3p": {
      "source_hash": "043d0e4dc4f9",
      "text": "먼저 1980년대 잉글랜드 남부에 퍼진 이야기입니다."
    },
    "zpvc": {
      "source_hash": "0c92aa4cd1bc",
      "text": "새벽에 밭에 온 농부는 밀이 가지런한 원형으로 쓰러진 걸 봅니다."
    },
    "au44": {
      "source_hash": "be87f39c140a",
      "text": "전날은 멀쩡했는데 하룻밤에 생겼습니다."
    },
    "drad": {
      "source_hash": "5c421d47e0be",
      "text": "여러 설 모두 하룻밤에 생겼다 합니다."
    },
    "njrb": {
      "source_hash": "22899aa5a3f5",
      "text": "한 설은 비행접시 착륙 흔적입니다."
    },
    "wibu": {
      "source_hash": "4f83c43343b8",
      "text": "전기를 띤 회오리가 눌렀다는 설입니다."
    },
    "ew5z": {
      "source_hash": "11e29a775cd1",
      "text": "사람은 이런 도형을 못 만든다는 설도 있습니다."
    },
    "g48i": {
      "source_hash": "745673a6fcc9",
      "text": "1991년 TIME도 서클을 다뤘습니다."
    },
    "ji6j": {
      "source_hash": "496248cd9ab0",
      "text": "들판에 생긴 괴현상은 전에도 얘기로 풀었습니다."
    },
    "abr4": {
      "source_hash": "9a38aa3e5283",
      "text": "1678년 영국 책자는 악마가 하룻밤에 귀리를 벴다 합니다."
    },
    "5p7h": {
      "source_hash": "4ad6a5bc291d",
      "text": "최초 기록이라지만, 누른 게 아니라 벴습니다."
    },
    "52pf": {
      "source_hash": "a0071dd01685",
      "text": "첫 서클은 누가 언제 만들었습니까?"
    },
    "mgp6": {
      "source_hash": "d419de410b74",
      "text": "답은 술집에 있습니다. 오랜 친구 두 명이 금요일마다 한잔합니다."
    },
    "c9is": {
      "source_hash": "efe144c1b0bc",
      "text": "더그와 데이브, 둘 다 풍경화가입니다."
    },
    "jkpy": {
      "source_hash": "fa6707959344",
      "text": "남부 햄프셔 주민, 더그는 액자점주입니다."
    },
    "zbdi": {
      "source_hash": "f65a92a0bbb5",
      "text": "더그는 호주 이민 뒤 몇 년 후 귀국합니다."
    },
    "2wsg": {
      "source_hash": "131382287b83",
      "text": "호주 신문에서 이상한 소식을 읽었습니다."
    },
    "f9m4": {
      "source_hash": "54e1f5cfe18d",
      "text": "1966년 퀸즐랜드 농민은 비행접시가 뜨는 걸 봤다고 합니다."
    },
    "rqm4": {
      "source_hash": "3eb9baf96edd",
      "text": "갈대 위 원을 비행접시 둥지라 불렀습니다."
    },
    "nffc": {
      "source_hash": "a16bddfce71f",
      "text": "더그는 데이브에게 말해 접시 착륙처럼 꾸미려 합니다."
    },
    "97u4": {
      "source_hash": "57f83dcfb5a0",
      "text": "1970년대 후반, 보도엔 1976년 또는 1978년입니다."
    },
    "u4nc": {
      "source_hash": "08c5ef7f2ca4",
      "text": "제작자 측 기록엔 처음엔 철봉을 썼습니다."
    },
    "u8zr": {
      "source_hash": "c13f03808cd7",
      "text": "액자점 뒷문을 잠그던 철봉입니다."
    },
    "7mey": {
      "source_hash": "f2ee3e85bec2",
      "text": "첫 원은 단순한 하나, 지름 약 9미터입니다."
    },
    "4cqc": {
      "source_hash": "d079669e262c",
      "text": "남의 밭이며 망가진 작물도 남의 것입니다."
    },
    "xm5r": {
      "source_hash": "d9e42bcd56bc",
      "text": "이후엔 더그가 원 중심에서 밧줄을 잡습니다."
    },
    "n9pn": {
      "source_hash": "30d20fedcfac",
      "text": "데이브는 판을 무릎 높이로 가로 듭니다."
    },
    "nnct": {
      "source_hash": "50ca7ea7d462",
      "text": "중심을 한 바퀴 돌며 판으로 밀 줄기를 눕힙니다."
    },
    "zc29": {
      "source_hash": "7e79c0c4d963",
      "text": "야구모자 챙의 철사 고리는 조준용입니다."
    },
    "sk9s": {
      "source_hash": "ad9c0707e06b",
      "text": "도구는 판 하나, 밧줄뭉치 하나, 야구모자입니다."
    },
    "35mn": {
      "source_hash": "a994594b3fdd",
      "text": "첫3년은 아무도 그 서클을 못 알아챕니다."
    },
    "r3hc": {
      "source_hash": "b0dfcd36c721",
      "text": "더그 말론 아내가 차의 큰 주행거리를 알아챕니다."
    },
    "9eku": {
      "source_hash": "27087818b474",
      "text": "스크랩을 보이고 밭에 데려가 한번 보이자 아내가 믿습니다."
    },
    "7kew": {
      "source_hash": "3492651e3bdc",
      "text": "1980년 무렵 신문이 드디어 보도합니다."
    },
    "q4u7": {
      "source_hash": "a28ca48b9732",
      "text": "후대 추도글에 나온 기사 제목입니다."
    },
    "ejyk": {
      "source_hash": "2138b2821e47",
      "text": "그것이 돌아왔습니다."
    },
    "jq58": {
      "source_hash": "e47a3055e4fc",
      "text": "둘의 장난이 왜 전국의 미스터리가 됩니까?"
    },
    "67mu": {
      "source_hash": "938774d42c7c",
      "text": "보도되자 진지한 연구자들이 옵니다."
    },
    "fg56": {
      "source_hash": "bfe6e3a34a5d",
      "text": "한 기상학자는 원이 대기현상 때문이라 합니다."
    },
    "prze": {
      "source_hash": "578c51f3f62d",
      "text": "회전 공기기둥이 대전물질을 실어 작물을 누른답니다."
    },
    "h763": {
      "source_hash": "138decf6f0b2",
      "text": "그 가설을 플라스마 소용돌이라 불렀습니다."
    },
    "3njc": {
      "source_hash": "e457798080b4",
      "text": "은퇴 기술자의 공저 전문서는 5만 권 넘게 팔립니다."
    },
    "2pze": {
      "source_hash": "90d8b72e7b66",
      "text": "두 친구는 원과 날씨의 무관함을 입증하려 합니다."
    },
    "9h95": {
      "source_hash": "45e201442862",
      "text": "원 하나를 여러 원의 모음으로 만듭니다."
    },
    "yru3": {
      "source_hash": "6d90a361ad1b",
      "text": "나중엔 도형에 곧은 선도 등장합니다."
    },
    "kqrd": {
      "source_hash": "5398b3c0e136",
      "text": "기상학자도 직선 도형은 인공이라 인정합니다."
    },
    "xxc9": {
      "source_hash": "8a0760c33550",
      "text": "단순한 원은 대기현상일 수도 있다 강조합니다."
    },
    "gyq3": {
      "source_hash": "b14552f3103e",
      "text": "1991년 물리학자 호킹도 말합니다."
    },
    "ga8k": {
      "source_hash": "5f9c470e53ff",
      "text": "서클은 장난이거나 공기 소용돌이 때문입니다."
    },
    "dq9t": {
      "source_hash": "ce458b5094f4",
      "text": "몇 개? 브리태니커는 200개 넘습니다."
    },
    "zf26": {
      "source_hash": "7fa52fab5846",
      "text": "물리지:250개 제작 고백입니다."
    },
    "7mp5": {
      "source_hash": "fea1e458e485",
      "text": "TIME은 한 철 최대 20~30개라 합니다."
    },
    "a755": {
      "source_hash": "c0be961db71b",
      "text": "둘 외에도 이미 모방자가 등장합니다."
    },
    "wx2j": {
      "source_hash": "422d8aed0f5e",
      "text": "애호가는 정부 연구비까지 청합니다."
    },
    "i3qu": {
      "source_hash": "635c1e0e25f4",
      "text": "장난이 커졌는데 왜 공개했습니까?"
    },
    "xxwq": {
      "source_hash": "69ed2899e359",
      "text": "1991년 9월, 공개한 이유는 두 설명이 있습니다."
    },
    "dj8u": {
      "source_hash": "319362a2c2d4",
      "text": "TIME은 애호가가 정부에 돈을 청해서라 합니다."
    },
    "zeib": {
      "source_hash": "86603841bc2a",
      "text": "후대 추도글엔 공개는 데이브 생각이라 합니다."
    },
    "rh83": {
      "source_hash": "f1437f512033",
      "text": "그해에 더그는 67세, 데이브는 62세입니다."
    },
    "v6zv": {
      "source_hash": "3c06a7e9399b",
      "text": "영국 타블로이드 Today가 처음 보도합니다."
    },
    "2r37": {
      "source_hash": "bb4eaeb4ef73",
      "text": "켄트주에서 두 사람은 기자 앞에 원 하나를 만듭니다."
    },
    "vyy3": {
      "source_hash": "aaf5a2c60dca",
      "text": "기자는 전문서 저자를 불러 보게 합니다."
    },
    "q9a4": {
      "source_hash": "e39eb68c49ca",
      "text": "보고 한 말입니다."
    },
    "9a4t": {
      "source_hash": "408c5c147be3",
      "text": "사람은 못 만듭니다."
    },
    "48iv": {
      "source_hash": "9651948edc9d",
      "text": "더그는 답합니다. 계속 속여 왔습니다."
    },
    "vnvf": {
      "source_hash": "cccbc9fc3f7f",
      "text": "연구자는 우리 모두 속았다고 말합니다."
    },
    "gffu": {
      "source_hash": "01efd595b391",
      "text": "감정은 진짜·인간 제작 불가였습니다."
    },
    "s5u9": {
      "source_hash": "69a7cb7f3d30",
      "text": "현장에선 노인 둘이 만들고 기자가 처음부터 끝까지 봤습니다."
    },
    "vrcc": {
      "source_hash": "46199a3de571",
      "text": "9월9일 보도,제목은 세상을 속인 사람들입니다."
    },
    "jfde": {
      "source_hash": "d62c8ae9eb28",
      "text": "이후 햄프셔 밭에서 기자들 앞에 재연합니다."
    },
    "xpcc": {
      "source_hash": "82847bb3f58b",
      "text": "다른 연구자는 놀랄 게 없다 합니다."
    },
    "xx7q": {
      "source_hash": "41b99d4123eb",
      "text": "아주 건강한 60세 노인 둘 말고는 없습니다."
    },
    "d5z5": {
      "source_hash": "d3870f1dc1ed",
      "text": "그 연구자는 후에 일부만 만들었고 현상은 남았다 합니다."
    },
    "5xuj": {
      "source_hash": "1c52a5afe202",
      "text": "캐나다 서클도 있는데 판을 가져갔냐고 묻습니다."
    },
    "zf53": {
      "source_hash": "7eb4b0541fa3",
      "text": "이듬해 둘은 이그노벨 물리학상을 받습니다."
    },
    "mdex": {
      "source_hash": "b9ebfcfd7096",
      "text": "답을 밝혔는데 왜 서클은 안 사라집니까?"
    },
    "ffic": {
      "source_hash": "165d6fd6c681",
      "text": "제작자는 이미 둘만이 아니었습니다."
    },
    "ncp6": {
      "source_hash": "9434bf214b13",
      "text": "1991년 여름엔 다른 이도 밭에서 만듭니다."
    },
    "dauc": {
      "source_hash": "e328c551428c",
      "text": "일부는 이미 노인 둘이 만들 수준을 넘었습니다."
    },
    "h9vk": {
      "source_hash": "5594c385827e",
      "text": "그들의 도형은 두 번째 창작자 물결을 낳았습니다."
    },
    "px5z": {
      "source_hash": "f6862eb2eb5c",
      "text": "예술단체가 공개 수주해 광고용 서클을 만듭니다."
    },
    "vxj4": {
      "source_hash": "9bc07d5adb87",
      "text": "고객은 시리얼 브랜드, 통신사, TV 프로그램입니다."
    },
    "zkst": {
      "source_hash": "5c3c72a7c32d",
      "text": "제작자:신문 의뢰로 농민이 £6000 받았습니다."
    },
    "ytin": {
      "source_hash": "608ef371206a",
      "text": "망가진 작물은 약 100파운드뿐입니다."
    },
    "xeb8": {
      "source_hash": "c648c6eb7133",
      "text": "복잡해져 최대 2000개 독립 모양으로 됩니다."
    },
    "vz6a": {
      "source_hash": "298b98e77ac9",
      "text": "1998년 TV 촬영 때 팀이 원 100개를 만듭니다."
    },
    "kxv8": {
      "source_hash": "5c4e180040c1",
      "text": "속도는 원 하나에 약 1분입니다."
    },
    "ccht": {
      "source_hash": "94174a3dfab2",
      "text": "항공 모습입니다. 2007년 스위스 사진입니다."
    },
    "58ph": {
      "source_hash": "b4185a962e99",
      "text": "이제 도형은 원 하나뿐이 아닙니다."
    },
    "p2sw": {
      "source_hash": "3237f400c8c6",
      "text": "유명한 건 1996년 7월 스톤헨지 옆에 나타납니다."
    },
    "fq9d": {
      "source_hash": "e1a9214bab59",
      "text": "퍼진 설은 오후 5시 반에 의사가 소형기로 날았다는 것입니다."
    },
    "dmiu": {
      "source_hash": "a17f6b1950c5",
      "text": "없다가 45분 뒤 다시 비행하니 생겼습니다."
    },
    "57u4": {
      "source_hash": "e767e56a6db4",
      "text": "그래서 너무 빨라 사람은 못 만든다고 합니다."
    },
    "gcsz": {
      "source_hash": "2c953e59197a",
      "text": "세 질문 적용. 출처:1996년 인터뷰."
    },
    "6cv6": {
      "source_hash": "ca546bef5b1d",
      "text": "누가 말했습니까? 제작자 측은 전날 밤 3명이 만들었다고 합니다."
    },
    "4c7d": {
      "source_hash": "e819253533fc",
      "text": "미해결인 건 양쪽 모두 한 사람 말뿐이라는 겁니다."
    },
    "46n4": {
      "source_hash": "464333dad53e",
      "text": "제작자 측은 2시간 45분 걸렸고 의사는 못 봤을 뿐이라 합니다."
    },
    "upfz": {
      "source_hash": "9b2e98ea908b",
      "text": "자신이 만들었단 말은 없고 인터뷰 녹음도 없습니다."
    },
    "hx29": {
      "source_hash": "0a284097a07a",
      "text": "같은 달 다른 도형은 원 194개입니다."
    },
    "ijkv": {
      "source_hash": "c0477346d09b",
      "text": "연구자는 원 안 밀 줄기의 마디가 전자기파로 늘었다 합니다."
    },
    "wtat": {
      "source_hash": "170b153156e0",
      "text": "비판자들은 통계와 표본에 문제를 지적합니다."
    },
    "ikcn": {
      "source_hash": "a298c3aa455f",
      "text": "누운 밀은 원래 다르게 자란다 합니다."
    },
    "zir6": {
      "source_hash": "080fc8c6dfb2",
      "text": "한 물리학자는 연구가 입증도 반증도 안 됐다 합니다."
    },
    "2uwr": {
      "source_hash": "78fdb45a343c",
      "text": "그런데 그 밀밭은 누구 것입니까?"
    },
    "87cp": {
      "source_hash": "b14bbaa72d2e",
      "text": "모든 서클 밑엔 농민의 수확이 있습니다."
    },
    "bih4": {
      "source_hash": "078c8b4990e7",
      "text": "2017년 폭 60미터 원이 밀 2에이커를 누릅니다."
    },
    "eirw": {
      "source_hash": "d16c8f73ba66",
      "text": "밭에 통을 두고 방문객 기부를 청합니다."
    },
    "32xp": {
      "source_hash": "4e8e5c616bfe",
      "text": "2010년 다른 농장 입장은 £5 자율 기부입니다."
    },
    "sdxu": {
      "source_hash": "c1447b3513a5",
      "text": "가디언은 2018년부터 2022년까지 원 92개를 집계했습니다."
    },
    "jrkx": {
      "source_hash": "075c664e3b23",
      "text": "농민 수입 3만파운드 감소."
    },
    "cff6": {
      "source_hash": "71a52fe20e32",
      "text": "작물이 쓰러진 농지는 축구장 40개를 넘습니다."
    },
    "vsgd": {
      "source_hash": "26a76008ce1e",
      "text": "관광은 2004년 에이브버리 안내소 직원의 말입니다."
    },
    "md6j": {
      "source_hash": "8086c055bbbb",
      "text": "여름 장사의 80~90%가 서클 관련입니다."
    },
    "avsx": {
      "source_hash": "9cffef4121f7",
      "text": "법은 명확합니다. 윌트셔 경찰은 재물손괴라 합니다."
    },
    "vj4x": {
      "source_hash": "2144ccd7a997",
      "text": "2000년 남성이 죄를 인정해 £100 벌금입니다"
    },
    "ukvc": {
      "source_hash": "270d1b7621ec",
      "text": "농민조합은 남의 정원 침입·파괴와 같다 합니다."
    },
    "tiie": {
      "source_hash": "773c2ab15f47",
      "text": "그 나무판 이야기는 기록이지 권유가 아닙니다."
    },
    "q5iu": {
      "source_hash": "587318cb1a0d",
      "text": "더그는 어찌 됐습니까?"
    },
    "2jnb": {
      "source_hash": "98b6c5144a43",
      "text": "더그,2018년 94세까지 삽니다"
    },
    "u597": {
      "source_hash": "532196edfa64",
      "text": "노년엔 모두에게 말한 것을 후회한다 했습니다."
    },
    "m657": {
      "source_hash": "913f69a5d956",
      "text": "제작자 측은 그가 그저 눌린 밀 줄기라 할 거라 상상합니다."
    },
    "sr6f": {
      "source_hash": "da1040700e11",
      "text": "저는 누가 만든 건지가 제일 흥미롭진 않습니다."
    },
    "9wn4": {
      "source_hash": "02942903f8b9",
      "text": "답이 나와도 왜 여전히 믿지 않는가입니다."
    },
    "pa32": {
      "source_hash": "a4732258c498",
      "text": "믿는 이를 안 비웃고 둘도 장난이라 합니다."
    },
    "ifv4": {
      "source_hash": "6f8ea9f3f7de",
      "text": "1991년 최초 제작자와 도구를 밝혔습니다."
    },
    "pcay": {
      "source_hash": "bd64492728ff",
      "text": "남은 건 농민 손실과 관광 사업입니다."
    },
    "nxgf": {
      "source_hash": "361b4ab10283",
      "text": "고백해도 서클은 계속됩니다. 제작자가 바뀌었기 때문입니다."
    },
    "fx52": {
      "source_hash": "ad15e4f98f7b",
      "text": "어릴 땐 누구 작품?댓글 부탁드립니다."
    },
    "3s2t": {
      "source_hash": "42de4c8cb64c",
      "text": "다음 파일도 펼칩니다. 구독을 부탁드립니다."
    }
  },
  "thumbnail": {
    "tag": "도시전설",
    "headline": "비행접시?\n**나무판!**",
    "sub": "1991년,\n두 노인의 고백"
  }
}
