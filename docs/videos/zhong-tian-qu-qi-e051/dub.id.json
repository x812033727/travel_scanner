{
  "zq51a01": {
    "text": "Berani melawan?",
    "emotion": "大吼"
  },
  "zq51a02": {
    "text": "Bunuh di tempat!",
    "emotion": "刀出鞘一半"
  },
  "zq51a03": {
    "text": "Ikut mereka.",
    "emotion": "壓低聲音，很穩"
  },
  "zq51a04": {
    "text": "Kamu bilang apa?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "Kalau bertarung di sini,",
    "emotion": "低聲，一字一字",
    "say": "Melawan di sini,"
  },
  "zq51a06": {
    "text": "kamu benar-benar jadi buronan.",
    "emotion": "很穩",
    "say": "kamu jadi buronan."
  },
  "zq51a07": {
    "text": "Aku akan menjemputmu.",
    "emotion": "很輕，像承諾",
    "say": "Kujemput."
  },
  "zq51a08": {
    "text": "Aku jalan sendiri.",
    "emotion": "冷，抬下巴"
  },
  "zq51a09": {
    "text": "Misi wajib: selamatkan Qin Shuang dalam tiga hari.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misi wajib: selamatkan Qin Shuang tiga hari."
  },
  "zq51a10": {
    "text": "Gagal: poin suka Qin Shuang jadi nol.",
    "emotion": "平板電子音，冷冷的"
  },
  "zq51a11": {
    "text": "Xu Yan.",
    "emotion": "回頭，冷"
  },
  "zq51a12": {
    "text": "Tepati janjimu.",
    "emotion": "一字一字"
  },
  "zq51a13": {
    "text": "Kutepati.",
    "emotion": "低聲，咬牙"
  },
  "zq51a14": {
    "text": "Bang petugas,",
    "emotion": "甜甜的",
    "say": "Bang,"
  },
  "zq51a15": {
    "text": "salinkan satu surat perintahnya untukku.",
    "emotion": "笑著，壓低聲音",
    "say": "salinkan suratnya buatku."
  },
  "zq51a16": {
    "text": "Tambah satu keping.",
    "emotion": "畫外，笑，不慌不忙",
    "say": "Tambah satu."
  },
  "zq51a17": {
    "text": "Sebelum fajar,",
    "emotion": "壓低聲音"
  },
  "zq51a18": {
    "text": "Nona tak pernah melihat saya.",
    "emotion": "左右看一眼",
    "say": "Nona tak lihat saya."
  },
  "zq51a19": {
    "text": "Salinan surat perintah penangkapan,",
    "emotion": "得意，快，說完就停",
    "say": "Surat penangkapan,"
  },
  "zq51a20": {
    "text": "dibeli pakai uang keluarga Tang.",
    "emotion": "眨眼",
    "say": "dibeli uang keluarga Tang."
  },
  "zq51a21": {
    "text": "Kucatat di buku,",
    "emotion": "甜",
    "say": "Kucatat,"
  },
  "zq51a22": {
    "text": "bayarnya pelan-pelan.",
    "emotion": "笑出酒窩"
  },
  "zq51a23": {
    "text": "Oke,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq51a24": {
    "text": "kubayar.",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "A-Ling?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "Mana dia?",
    "emotion": "很輕，很冷"
  },
  "zq51a27": {
    "text": "Penjara prefektur.",
    "emotion": "低",
    "say": "Penjara."
  },
  "zq51a28": {
    "text": "Dalam tiga hari harus diselamatkan.",
    "emotion": "咬牙",
    "say": "Tiga hari harus keluar."
  },
  "zq51a29": {
    "text": "Dari Liuxi ke sini,",
    "emotion": "嚇一跳"
  },
  "zq51a30": {
    "text": "kamu berkuda semalaman?",
    "emotion": "瞪大眼",
    "say": "berkuda semalaman?"
  },
  "zq51a31": {
    "text": "Biro pengawal mengetuk pintu tengah malam.",
    "emotion": "淡淡的",
    "say": "Pengawal mengetuk tengah malam."
  },
  "zq51a32": {
    "text": "Xiaohe kutitipkan ke Kakek Han.",
    "emotion": "很短，快，說完就停",
    "say": "Xiaohe di Kakek Han."
  },
  "zq51a33": {
    "text": "Satu lagi,",
    "emotion": "收起笑，壓低聲音",
    "say": "Lalu,"
  },
  "zq51a34": {
    "text": "orang Ayah di ibu kota mengirim surat.",
    "emotion": "正經起來",
    "say": "orang Ayah di ibu kota kirim surat."
  },
  "zq51a35": {
    "text": "Wei Shaoqing sebulan lalu",
    "emotion": "畫外，低聲唸"
  },
  "zq51a36": {
    "text": "pulang ke ibu kota membawa seorang pelukis.",
    "emotion": "畫外，皺眉",
    "say": "pulang ke ibu kota bawa pelukis."
  },
  "zq51a37": {
    "text": "Pelukis?",
    "emotion": "一愣"
  },
  "zq51a38": {
    "text": "Dia mau melukis siapa?",
    "emotion": "低聲，心裡一沉",
    "say": "Melukis siapa?"
  },
  "zq51a39": {
    "text": "Ini salinan surat perintah penangkapan.",
    "emotion": "遞過去",
    "say": "Ini salinan surat penangkapan."
  },
  "zq51a40": {
    "text": "Cap ini,",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "palsu.",
    "emotion": "冷，很篤定"
  }
}
