{
  "zq51a01": {
    "text": "Dám kháng cự à?",
    "emotion": "大吼，快，說完就停",
    "say": "Dám kháng cự?"
  },
  "zq51a02": {
    "text": "Giết tại chỗ!",
    "emotion": "刀出鞘一半"
  },
  "zq51a03": {
    "text": "Đi với họ.",
    "emotion": "壓低聲音，很穩"
  },
  "zq51a04": {
    "text": "Chàng nói gì?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "Động thủ ở đây,",
    "emotion": "低聲，一字一字"
  },
  "zq51a06": {
    "text": "là thành kẻ trốn tội thật.",
    "emotion": "很穩",
    "say": "là thành tội phạm thật."
  },
  "zq51a07": {
    "text": "Ta sẽ đón nàng.",
    "emotion": "很輕，像承諾",
    "say": "Ta đón nàng."
  },
  "zq51a08": {
    "text": "Ta tự đi.",
    "emotion": "冷，抬下巴"
  },
  "zq51a09": {
    "text": "Nhiệm vụ bắt buộc: trong ba ngày cứu Tần Sương về.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq51a10": {
    "text": "Thất bại: độ hảo cảm của Tần Sương về không.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Thất bại: hảo cảm Tần Sương về không."
  },
  "zq51a11": {
    "text": "Hứa Nghiên.",
    "emotion": "回頭，冷"
  },
  "zq51a12": {
    "text": "Nói phải giữ lời.",
    "emotion": "一字一字"
  },
  "zq51a13": {
    "text": "Giữ lời.",
    "emotion": "低聲，咬牙"
  },
  "zq51a14": {
    "text": "Đại ca nha dịch,",
    "emotion": "甜甜的",
    "say": "Đại ca,"
  },
  "zq51a15": {
    "text": "chép cho ta một bản công văn.",
    "emotion": "笑著，壓低聲音",
    "say": "chép cho ta công văn."
  },
  "zq51a16": {
    "text": "Thêm một thỏi nữa.",
    "emotion": "畫外，笑，不慌不忙",
    "say": "Thêm một thỏi."
  },
  "zq51a17": {
    "text": "Trước khi trời sáng,",
    "emotion": "壓低聲音"
  },
  "zq51a18": {
    "text": "cô nương chưa từng gặp tôi.",
    "emotion": "左右看一眼",
    "say": "cô chưa gặp tôi."
  },
  "zq51a19": {
    "text": "Bản chép lệnh bắt,",
    "emotion": "得意"
  },
  "zq51a20": {
    "text": "mua bằng tiền nhà họ Đường.",
    "emotion": "眨眼"
  },
  "zq51a21": {
    "text": "Ghi sổ nhé,",
    "emotion": "甜，快，說完就停",
    "say": "Ghi sổ,"
  },
  "zq51a22": {
    "text": "chàng cứ từ từ trả.",
    "emotion": "笑出酒窩",
    "say": "từ từ trả."
  },
  "zq51a23": {
    "text": "Được,",
    "emotion": "笑出來"
  },
  "zq51a24": {
    "text": "ta trả.",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "A Lệnh?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "Người đâu?",
    "emotion": "很輕，很冷"
  },
  "zq51a27": {
    "text": "Ngục châu.",
    "emotion": "低"
  },
  "zq51a28": {
    "text": "Trong ba ngày phải cứu ra.",
    "emotion": "咬牙"
  },
  "zq51a29": {
    "text": "Từ Liễu Khê tới đây,",
    "emotion": "嚇一跳"
  },
  "zq51a30": {
    "text": "cưỡi ngựa suốt một đêm sao?",
    "emotion": "瞪大眼",
    "say": "cưỡi cả đêm sao?"
  },
  "zq51a31": {
    "text": "Tiêu cục nửa đêm gõ cửa.",
    "emotion": "淡淡的"
  },
  "zq51a32": {
    "text": "Tiểu Hòa giao cho Hàn bá rồi.",
    "emotion": "很短"
  },
  "zq51a33": {
    "text": "Còn nữa,",
    "emotion": "收起笑，壓低聲音"
  },
  "zq51a34": {
    "text": "người của cha ở kinh thành gửi thư tới.",
    "emotion": "正經起來",
    "say": "người của cha ở kinh gửi thư."
  },
  "zq51a35": {
    "text": "Ngụy Thiếu Khanh một tháng trước,",
    "emotion": "畫外，低聲唸"
  },
  "zq51a36": {
    "text": "dẫn theo một họa sư về kinh rồi.",
    "emotion": "畫外，皺眉"
  },
  "zq51a37": {
    "text": "Họa sư?",
    "emotion": "一愣"
  },
  "zq51a38": {
    "text": "Hắn định vẽ ai?",
    "emotion": "低聲，心裡一沉"
  },
  "zq51a39": {
    "text": "Đây là bản chép lệnh bắt.",
    "emotion": "遞過去"
  },
  "zq51a40": {
    "text": "Con ấn này,",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "là giả.",
    "emotion": "冷，很篤定"
  }
}
