{
  "zq51a01": {
    "text": "Resisting arrest?",
    "emotion": "大吼",
    "say": "Resisting?"
  },
  "zq51a02": {
    "text": "Kill her on the spot!",
    "emotion": "刀出鞘一半"
  },
  "zq51a03": {
    "text": "Go with them.",
    "emotion": "壓低聲音，很穩"
  },
  "zq51a04": {
    "text": "What did you say?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "Fight them here,",
    "emotion": "低聲，一字一字",
    "say": "Fight here,"
  },
  "zq51a06": {
    "text": "and you really become a fugitive.",
    "emotion": "很穩，快，說完就停",
    "say": "and you're a fugitive."
  },
  "zq51a07": {
    "text": "I'll come for you.",
    "emotion": "很輕，像承諾"
  },
  "zq51a08": {
    "text": "I'll walk on my own.",
    "emotion": "冷，抬下巴",
    "say": "I'll walk."
  },
  "zq51a09": {
    "text": "Mandatory mission: rescue Qin Shuang within three days.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Mandatory: rescue Qin Shuang in three days."
  },
  "zq51a10": {
    "text": "Failure: Qin Shuang's affection resets to zero.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Fail: Qin Shuang's affection to zero."
  },
  "zq51a11": {
    "text": "Xu Yan.",
    "emotion": "回頭，冷"
  },
  "zq51a12": {
    "text": "Keep your word.",
    "emotion": "冷，快，說完就停"
  },
  "zq51a13": {
    "text": "I will.",
    "emotion": "低聲，極短促，一口氣說完，不拖音"
  },
  "zq51a14": {
    "text": "Officer, sir,",
    "emotion": "甜甜的",
    "say": "Officer,"
  },
  "zq51a15": {
    "text": "make me a copy of the warrant.",
    "emotion": "笑著，壓低聲音",
    "say": "copy me the warrant."
  },
  "zq51a16": {
    "text": "And one more ingot.",
    "emotion": "畫外，笑，不慌不忙",
    "say": "One more."
  },
  "zq51a17": {
    "text": "Before dawn,",
    "emotion": "壓低聲音"
  },
  "zq51a18": {
    "text": "you never saw me.",
    "emotion": "左右看一眼"
  },
  "zq51a19": {
    "text": "A copy of the arrest warrant,",
    "emotion": "得意",
    "say": "The warrant copy,"
  },
  "zq51a20": {
    "text": "bought with Tang family money.",
    "emotion": "眨眼",
    "say": "bought with Tang money."
  },
  "zq51a21": {
    "text": "It's on your tab,",
    "emotion": "甜",
    "say": "On your tab,"
  },
  "zq51a22": {
    "text": "pay me back slowly.",
    "emotion": "笑出酒窩"
  },
  "zq51a23": {
    "text": "Okay,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq51a24": {
    "text": "I'll pay.",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "A-Ling?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "Where is she?",
    "emotion": "很輕，很冷",
    "say": "Where?"
  },
  "zq51a27": {
    "text": "The prefecture jail.",
    "emotion": "低",
    "say": "The jail."
  },
  "zq51a28": {
    "text": "We have to get her out within three days.",
    "emotion": "咬牙",
    "say": "Three days to get her out."
  },
  "zq51a29": {
    "text": "From Liuxi to here,",
    "emotion": "嚇一跳"
  },
  "zq51a30": {
    "text": "you rode all night?",
    "emotion": "瞪大眼"
  },
  "zq51a31": {
    "text": "The escort agency knocked at midnight.",
    "emotion": "淡淡的",
    "say": "The escorts knocked at midnight."
  },
  "zq51a32": {
    "text": "I left Xiaohe with Elder Han.",
    "emotion": "很短"
  },
  "zq51a33": {
    "text": "One more thing,",
    "emotion": "收起笑，壓低聲音",
    "say": "Also,"
  },
  "zq51a34": {
    "text": "Dad's people in the capital sent a letter.",
    "emotion": "正經起來",
    "say": "Dad's man in the capital wrote."
  },
  "zq51a35": {
    "text": "A month ago, Wei Shaoqing",
    "emotion": "畫外，低聲唸"
  },
  "zq51a36": {
    "text": "went back to the capital with a painter.",
    "emotion": "畫外，皺眉",
    "say": "took a painter back to the capital."
  },
  "zq51a37": {
    "text": "A painter?",
    "emotion": "一愣，快，說完就停",
    "say": "Painter?"
  },
  "zq51a38": {
    "text": "Who's he going to paint?",
    "emotion": "低聲，心裡一沉",
    "say": "Paint who?"
  },
  "zq51a39": {
    "text": "Here's the copy of the arrest warrant.",
    "emotion": "遞過去",
    "say": "Here's the warrant copy."
  },
  "zq51a40": {
    "text": "This seal,",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "is fake.",
    "emotion": "冷，很篤定"
  }
}
