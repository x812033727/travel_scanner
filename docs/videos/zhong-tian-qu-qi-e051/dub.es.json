{
  "zq51a01": {
    "text": "¿Te resistes al arresto?",
    "emotion": "大吼",
    "say": "¿Te resistes?"
  },
  "zq51a02": {
    "text": "¡La matamos aquí mismo!",
    "emotion": "刀出鞘一半",
    "say": "¡Mátenla aquí!"
  },
  "zq51a03": {
    "text": "Ve con ellos.",
    "emotion": "壓低聲音，很穩"
  },
  "zq51a04": {
    "text": "¿Qué dijiste?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "Si peleas aquí,",
    "emotion": "低聲，一字一字"
  },
  "zq51a06": {
    "text": "serás una fugitiva de verdad.",
    "emotion": "很穩",
    "say": "serás fugitiva."
  },
  "zq51a07": {
    "text": "Iré por ti.",
    "emotion": "很輕，像承諾"
  },
  "zq51a08": {
    "text": "Iré por mi cuenta.",
    "emotion": "冷，抬下巴",
    "say": "Voy sola."
  },
  "zq51a09": {
    "text": "Misión obligatoria: rescatar a Qin Shuang en tres días.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misión: rescatar a Qin Shuang en tres días."
  },
  "zq51a10": {
    "text": "Si fallas: el afecto de Qin Shuang vuelve a cero.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Si fallas: afecto de Qin Shuang a cero."
  },
  "zq51a11": {
    "text": "Xu Yan.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq51a12": {
    "text": "Cumple tu palabra.",
    "emotion": "一字一字"
  },
  "zq51a13": {
    "text": "La cumpliré.",
    "emotion": "低聲，咬牙",
    "say": "Cumpliré."
  },
  "zq51a14": {
    "text": "Oficial,",
    "emotion": "甜甜的，快，說完就停"
  },
  "zq51a15": {
    "text": "hágame una copia de la orden.",
    "emotion": "笑著，壓低聲音",
    "say": "una copia de la orden."
  },
  "zq51a16": {
    "text": "Y otro lingote.",
    "emotion": "畫外，快，說完就停",
    "say": "Otro."
  },
  "zq51a17": {
    "text": "Hasta que amanezca,",
    "emotion": "壓低聲音",
    "say": "Hasta el alba,"
  },
  "zq51a18": {
    "text": "usted no me ha visto.",
    "emotion": "左右看一眼",
    "say": "no me vio."
  },
  "zq51a19": {
    "text": "La copia de la orden de arresto,",
    "emotion": "得意",
    "say": "La copia de la orden,"
  },
  "zq51a20": {
    "text": "pagada con dinero de los Tang.",
    "emotion": "眨眼",
    "say": "con dinero Tang."
  },
  "zq51a21": {
    "text": "Te lo anoto en la cuenta,",
    "emotion": "甜",
    "say": "Anotado,"
  },
  "zq51a22": {
    "text": "me lo pagas con calma.",
    "emotion": "笑出酒窩",
    "say": "págame despacio."
  },
  "zq51a23": {
    "text": "Bueno,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Va,"
  },
  "zq51a24": {
    "text": "te lo pago.",
    "emotion": "認真",
    "say": "te pago."
  },
  "zq51a25": {
    "text": "¿A-Ling?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "¿Y ella?",
    "emotion": "很輕，快，說完就停"
  },
  "zq51a27": {
    "text": "En la cárcel de la prefectura.",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "Presa."
  },
  "zq51a28": {
    "text": "Hay que sacarla en tres días.",
    "emotion": "咬牙，快，說完就停",
    "say": "Tres días para sacarla."
  },
  "zq51a29": {
    "text": "¿De Liuxi hasta aquí,",
    "emotion": "嚇一跳",
    "say": "¿Desde Liuxi,"
  },
  "zq51a30": {
    "text": "cabalgaste toda la noche?",
    "emotion": "瞪大眼",
    "say": "toda la noche?"
  },
  "zq51a31": {
    "text": "La agencia de escoltas tocó a medianoche.",
    "emotion": "淡淡的",
    "say": "Los escoltas tocaron de noche."
  },
  "zq51a32": {
    "text": "Xiaohe se quedó con el anciano Han.",
    "emotion": "很短",
    "say": "Xiaohe está con el anciano Han."
  },
  "zq51a33": {
    "text": "Y otra cosa,",
    "emotion": "收起笑，壓低聲音",
    "say": "Además,"
  },
  "zq51a34": {
    "text": "llegó carta de la gente de papá en la capital.",
    "emotion": "正經起來",
    "say": "escribió la gente de papá."
  },
  "zq51a35": {
    "text": "Hace un mes, Wei Shaoqing",
    "emotion": "畫外，低聲唸"
  },
  "zq51a36": {
    "text": "volvió a la capital con un pintor.",
    "emotion": "畫外，皺眉"
  },
  "zq51a37": {
    "text": "¿Un pintor?",
    "emotion": "一愣，快，說完就停",
    "say": "¿Pintor?"
  },
  "zq51a38": {
    "text": "¿A quién va a pintar?",
    "emotion": "低聲，快，說完就停",
    "say": "¿Pintar a quién?"
  },
  "zq51a39": {
    "text": "Esta es la copia de la orden de arresto.",
    "emotion": "遞過去",
    "say": "La copia de la orden."
  },
  "zq51a40": {
    "text": "Este sello,",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "es falso.",
    "emotion": "冷，很篤定"
  }
}
