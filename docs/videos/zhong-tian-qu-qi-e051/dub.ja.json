{
  "zq51a01": {
    "text": "逮捕に逆らう気か？",
    "emotion": "大吼，快，說完就停",
    "say": "逆らうか？"
  },
  "zq51a02": {
    "text": "その場で斬り捨てる！",
    "emotion": "刀出鞘一半",
    "say": "斬り捨てろ！"
  },
  "zq51a03": {
    "text": "あいつらと行け。",
    "emotion": "壓低聲音，很穩",
    "say": "行け。"
  },
  "zq51a04": {
    "text": "何ですって？",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "ここでやり合えば、",
    "emotion": "低聲，一字一字",
    "say": "ここで戦えば、"
  },
  "zq51a06": {
    "text": "本当に逃亡者になる。",
    "emotion": "很穩，快，說完就停",
    "say": "逃亡者になる。"
  },
  "zq51a07": {
    "text": "迎えに行く。",
    "emotion": "很輕，像承諾"
  },
  "zq51a08": {
    "text": "自分で歩く。",
    "emotion": "冷，抬下巴"
  },
  "zq51a09": {
    "text": "強制任務：三日以内にチン・シュアンを救出せよ。",
    "emotion": "平板電子音，快，說完就停",
    "say": "強制任務：三日でチン・シュアン救出。"
  },
  "zq51a10": {
    "text": "失敗時：チン・シュアンの好感度はゼロに。",
    "emotion": "平板電子音，快，說完就停",
    "say": "失敗：チン・シュアン好感度ゼロ。"
  },
  "zq51a11": {
    "text": "シュー・イェン。",
    "emotion": "回頭，冷"
  },
  "zq51a12": {
    "text": "約束は守って。",
    "emotion": "冷，快，說完就停",
    "say": "約束よ。"
  },
  "zq51a13": {
    "text": "守る。",
    "emotion": "低聲，咬牙"
  },
  "zq51a14": {
    "text": "お役人さん、",
    "emotion": "甜甜的，快，說完就停",
    "say": "旦那、"
  },
  "zq51a15": {
    "text": "逮捕状の写しを一部ちょうだい。",
    "emotion": "笑著，壓低聲音",
    "say": "写しをちょうだい。"
  },
  "zq51a16": {
    "text": "銀をもう一つ。",
    "emotion": "畫外，快，說完就停",
    "say": "もう一つ。"
  },
  "zq51a17": {
    "text": "夜が明けるまで、",
    "emotion": "壓低聲音",
    "say": "夜明けまで、"
  },
  "zq51a18": {
    "text": "私とは会っていません。",
    "emotion": "左右看一眼",
    "say": "会ってませんよ。"
  },
  "zq51a19": {
    "text": "逮捕状の写しよ、",
    "emotion": "得意，快，說完就停",
    "say": "逮捕状よ、"
  },
  "zq51a20": {
    "text": "タン家のお金で買ったの。",
    "emotion": "眨眼",
    "say": "タン家のお金よ。"
  },
  "zq51a21": {
    "text": "ツケにしとくね、",
    "emotion": "甜，快，說完就停",
    "say": "ツケね、"
  },
  "zq51a22": {
    "text": "ゆっくり返して。",
    "emotion": "笑出酒窩"
  },
  "zq51a23": {
    "text": "ああ、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "うん、"
  },
  "zq51a24": {
    "text": "返す。",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "アーリン？",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "彼女は？",
    "emotion": "很輕，很冷",
    "say": "どこ？"
  },
  "zq51a27": {
    "text": "州の牢。",
    "emotion": "低"
  },
  "zq51a28": {
    "text": "三日以内に救い出す。",
    "emotion": "咬牙，快，說完就停",
    "say": "三日で救う。"
  },
  "zq51a29": {
    "text": "柳渓からここまで、",
    "emotion": "嚇一跳"
  },
  "zq51a30": {
    "text": "一晩中馬で？",
    "emotion": "瞪大眼"
  },
  "zq51a31": {
    "text": "鏢局が夜中に戸を叩いた。",
    "emotion": "淡淡的，快，說完就停",
    "say": "夜中に鏢局が来た。"
  },
  "zq51a32": {
    "text": "シャオホーはハン爺さんに預けた。",
    "emotion": "很短",
    "say": "シャオホーはハン爺さんに。"
  },
  "zq51a33": {
    "text": "それと、",
    "emotion": "收起笑，壓低聲音"
  },
  "zq51a34": {
    "text": "都にいる父さんの人から手紙が来た。",
    "emotion": "正經起來",
    "say": "父さんの都の人から手紙。"
  },
  "zq51a35": {
    "text": "ウェイ・シャオチンが一か月前、",
    "emotion": "畫外，低聲唸",
    "say": "ウェイ・シャオチンが先月、"
  },
  "zq51a36": {
    "text": "画師を連れて都に戻ったって。",
    "emotion": "畫外，皺眉",
    "say": "画師を連れて都へ。"
  },
  "zq51a37": {
    "text": "画師？",
    "emotion": "一愣"
  },
  "zq51a38": {
    "text": "誰を描く気だ？",
    "emotion": "低聲，快，說完就停",
    "say": "誰を描く？"
  },
  "zq51a39": {
    "text": "これが逮捕状の写し。",
    "emotion": "遞過去"
  },
  "zq51a40": {
    "text": "この印、",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "偽物。",
    "emotion": "冷，很篤定"
  }
}
