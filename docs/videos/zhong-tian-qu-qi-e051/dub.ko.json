{
  "zq51a01": {
    "text": "체포에 저항하겠다?",
    "emotion": "大吼",
    "say": "반항해?"
  },
  "zq51a02": {
    "text": "그 자리에서 베어라!",
    "emotion": "刀出鞘一半",
    "say": "베어 버려!"
  },
  "zq51a03": {
    "text": "따라가.",
    "emotion": "壓低聲音，很穩"
  },
  "zq51a04": {
    "text": "뭐라고?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "여기서 싸우면,",
    "emotion": "低聲，一字一字"
  },
  "zq51a06": {
    "text": "진짜 도망자가 돼.",
    "emotion": "很穩"
  },
  "zq51a07": {
    "text": "데리러 갈게.",
    "emotion": "很輕，像承諾"
  },
  "zq51a08": {
    "text": "내 발로 갈 거야.",
    "emotion": "冷，抬下巴",
    "say": "내 발로 가."
  },
  "zq51a09": {
    "text": "강제 미션: 사흘 안에 친솽을 구출하라.",
    "emotion": "平板電子音，快，說完就停",
    "say": "강제 미션: 사흘 내 친솽 구출."
  },
  "zq51a10": {
    "text": "실패 시: 친솽 호감도 초기화.",
    "emotion": "平板電子音，冷冷的"
  },
  "zq51a11": {
    "text": "쉬옌.",
    "emotion": "回頭，冷"
  },
  "zq51a12": {
    "text": "약속 지켜.",
    "emotion": "冷，快，說完就停"
  },
  "zq51a13": {
    "text": "지킬게.",
    "emotion": "低聲，咬牙"
  },
  "zq51a14": {
    "text": "나리,",
    "emotion": "甜甜的"
  },
  "zq51a15": {
    "text": "공문 한 부만 베껴 줘요.",
    "emotion": "笑著，壓低聲音",
    "say": "공문 사본 줘요."
  },
  "zq51a16": {
    "text": "한 덩이 더요.",
    "emotion": "畫外，笑，不慌不忙",
    "say": "하나 더요."
  },
  "zq51a17": {
    "text": "날이 밝기 전까지,",
    "emotion": "壓低聲音",
    "say": "날 밝기 전까지,"
  },
  "zq51a18": {
    "text": "저를 못 보신 겁니다.",
    "emotion": "左右看一眼",
    "say": "전 못 보신 겁니다."
  },
  "zq51a19": {
    "text": "체포 공문 사본이야,",
    "emotion": "得意",
    "say": "공문 사본이야,"
  },
  "zq51a20": {
    "text": "탕가 돈으로 샀어.",
    "emotion": "眨眼"
  },
  "zq51a21": {
    "text": "장부에 달아 둘게,",
    "emotion": "甜",
    "say": "외상이야,"
  },
  "zq51a22": {
    "text": "천천히 갚아.",
    "emotion": "笑出酒窩"
  },
  "zq51a23": {
    "text": "그래,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "응,"
  },
  "zq51a24": {
    "text": "갚을게.",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "아링?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "그 사람은?",
    "emotion": "很輕，很冷",
    "say": "어딨어?"
  },
  "zq51a27": {
    "text": "주 감옥.",
    "emotion": "低"
  },
  "zq51a28": {
    "text": "사흘 안에 꺼내야 해.",
    "emotion": "咬牙",
    "say": "사흘 안에 꺼내."
  },
  "zq51a29": {
    "text": "류시에서 여기까지,",
    "emotion": "嚇一跳"
  },
  "zq51a30": {
    "text": "밤새 달려온 거야?",
    "emotion": "瞪大眼",
    "say": "밤새 달려왔어?"
  },
  "zq51a31": {
    "text": "표국이 한밤중에 문을 두드렸어.",
    "emotion": "淡淡的，快，說完就停",
    "say": "밤중에 표국이 왔어."
  },
  "zq51a32": {
    "text": "샤오허는 한 어르신께 맡겼어.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "샤오허는 한 어르신께."
  },
  "zq51a33": {
    "text": "그리고,",
    "emotion": "收起笑，壓低聲音"
  },
  "zq51a34": {
    "text": "도성에 있는 아빠 사람한테서 편지가 왔어.",
    "emotion": "正經起來",
    "say": "도성에서 편지 왔어."
  },
  "zq51a35": {
    "text": "웨이사오칭이 한 달 전에,",
    "emotion": "畫外，低聲唸",
    "say": "웨이사오칭이 지난달,"
  },
  "zq51a36": {
    "text": "화공을 데리고 도성에 돌아갔대.",
    "emotion": "畫外，皺眉",
    "say": "화공을 데리고 갔대."
  },
  "zq51a37": {
    "text": "화공?",
    "emotion": "一愣"
  },
  "zq51a38": {
    "text": "누굴 그리려고?",
    "emotion": "低聲，心裡一沉",
    "say": "누굴 그려?"
  },
  "zq51a39": {
    "text": "이게 체포 공문 사본이야.",
    "emotion": "遞過去",
    "say": "이게 공문 사본이야."
  },
  "zq51a40": {
    "text": "이 도장,",
    "emotion": "很輕"
  },
  "zq51a41": {
    "text": "가짜야.",
    "emotion": "冷，很篤定"
  }
}
