{
  "zq51a01": {
    "text": "Resistindo à prisão?",
    "emotion": "大吼",
    "say": "Vai resistir?"
  },
  "zq51a02": {
    "text": "Matamos aqui mesmo!",
    "emotion": "刀出鞘一半",
    "say": "Matem ela!"
  },
  "zq51a03": {
    "text": "Vá com eles.",
    "emotion": "壓低聲音，很穩",
    "say": "Vai com eles."
  },
  "zq51a04": {
    "text": "O que você disse?",
    "emotion": "不敢相信，咬牙"
  },
  "zq51a05": {
    "text": "Se lutar aqui,",
    "emotion": "低聲，一字一字"
  },
  "zq51a06": {
    "text": "vira fugitiva de verdade.",
    "emotion": "很穩"
  },
  "zq51a07": {
    "text": "Eu vou te buscar.",
    "emotion": "很輕，像承諾",
    "say": "Vou te buscar."
  },
  "zq51a08": {
    "text": "Eu vou sozinha.",
    "emotion": "冷，抬下巴",
    "say": "Vou sozinha."
  },
  "zq51a09": {
    "text": "Missão obrigatória: resgatar Qin Shuang em três dias.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Missão: resgatar Qin Shuang em três dias."
  },
  "zq51a10": {
    "text": "Falha: a afeição de Qin Shuang volta a zero.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Falha: afeição de Qin Shuang a zero."
  },
  "zq51a11": {
    "text": "Xu Yan.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq51a12": {
    "text": "Cumpra sua palavra.",
    "emotion": "冷，快，說完就停",
    "say": "Cumpra a palavra."
  },
  "zq51a13": {
    "text": "Cumpro.",
    "emotion": "低聲，咬牙"
  },
  "zq51a14": {
    "text": "Seu guarda,",
    "emotion": "甜甜的"
  },
  "zq51a15": {
    "text": "me faz uma cópia do mandado.",
    "emotion": "壓低聲音，快，說完就停",
    "say": "uma cópia do mandado."
  },
  "zq51a16": {
    "text": "E mais um lingote.",
    "emotion": "畫外，笑，不慌不忙",
    "say": "Mais um."
  },
  "zq51a17": {
    "text": "Até o dia nascer,",
    "emotion": "壓低聲音",
    "say": "Até amanhecer,"
  },
  "zq51a18": {
    "text": "o senhor nunca me viu.",
    "emotion": "左右看一眼",
    "say": "nunca me viu."
  },
  "zq51a19": {
    "text": "A cópia do mandado de prisão,",
    "emotion": "得意",
    "say": "A cópia do mandado,"
  },
  "zq51a20": {
    "text": "comprada com o dinheiro dos Tang.",
    "emotion": "眨眼",
    "say": "com dinheiro dos Tang."
  },
  "zq51a21": {
    "text": "Fica na conta,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Na conta,"
  },
  "zq51a22": {
    "text": "vai pagando devagar.",
    "emotion": "甜，快，說完就停",
    "say": "paga devagar."
  },
  "zq51a23": {
    "text": "Tá bom,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tá,"
  },
  "zq51a24": {
    "text": "eu pago.",
    "emotion": "認真"
  },
  "zq51a25": {
    "text": "A-Ling?",
    "emotion": "不敢相信"
  },
  "zq51a26": {
    "text": "Cadê ela?",
    "emotion": "很輕，很冷",
    "say": "Cadê?"
  },
  "zq51a27": {
    "text": "Na cadeia da prefeitura.",
    "emotion": "低",
    "say": "Na cadeia."
  },
  "zq51a28": {
    "text": "Temos três dias pra tirar ela de lá.",
    "emotion": "咬牙",
    "say": "Três dias pra tirá-la."
  },
  "zq51a29": {
    "text": "Da Vila Liuxi até aqui,",
    "emotion": "嚇一跳",
    "say": "De Liuxi até aqui,"
  },
  "zq51a30": {
    "text": "você cavalgou a noite toda?",
    "emotion": "瞪大眼",
    "say": "a noite toda?"
  },
  "zq51a31": {
    "text": "A agência de escolta bateu à meia-noite.",
    "emotion": "淡淡的",
    "say": "A escolta bateu de madrugada."
  },
  "zq51a32": {
    "text": "Deixei Xiaohe com o Ancião Han.",
    "emotion": "很短"
  },
  "zq51a33": {
    "text": "E mais,",
    "emotion": "收起笑，壓低聲音"
  },
  "zq51a34": {
    "text": "o pessoal do papai na capital mandou carta.",
    "emotion": "正經起來",
    "say": "o pessoal do papai escreveu."
  },
  "zq51a35": {
    "text": "Há um mês, Wei Shaoqing",
    "emotion": "畫外，低聲，快，說完就停"
  },
  "zq51a36": {
    "text": "voltou à capital com um pintor.",
    "emotion": "畫外，皺眉"
  },
  "zq51a37": {
    "text": "Um pintor?",
    "emotion": "一愣，快，說完就停",
    "say": "Pintor?"
  },
  "zq51a38": {
    "text": "Pra pintar quem?",
    "emotion": "低聲，快，說完就停"
  },
  "zq51a39": {
    "text": "Esta é a cópia do mandado de prisão.",
    "emotion": "遞過去",
    "say": "A cópia do mandado."
  },
  "zq51a40": {
    "text": "Este selo,",
    "emotion": "很輕，快，說完就停"
  },
  "zq51a41": {
    "text": "é falso.",
    "emotion": "冷，很篤定"
  }
}
