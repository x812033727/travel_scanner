{
  "zq30a01": "¿Tú eres el letrado pobre?",
  "zq30a02": "Xu Yan.",
  "zq30a03": {
    "text": "Pobre, sí.",
    "emotion": "坦然，不躲"
  },
  "zq30a04": {
    "text": "Letrado pobre,",
    "emotion": "輕蔑，不笑"
  },
  "zq30a05": "¿con qué la mantienes?",
  "zq30a06": "Suegro,",
  "zq30a07": {
    "text": "sus paredes son de lodo.",
    "emotion": "輕佻"
  },
  "zq30a08": "¡Ya!",
  "zq30a09": "a ver su casa.",
  "zq30a10": "Mire,",
  "zq30a11": "esta es su casa.",
  "zq30a12": "Tome té, señor,",
  "zq30a13": "¡el agua es dulcita!",
  "zq30a14": "Taza rota,",
  "zq30a15": "pero rico.",
  "zq30a16": "Taza rota,",
  "zq30a17": {
    "text": "alma limpia.",
    "emotion": "冷冷地"
  },
  "zq30a18": "Hija,",
  "zq30a19": "vámonos al sur.",
  "zq30a20": "Papá, no vuelvo.",
  "zq30a21": "Esta es mi casa.",
  "zq30a22": "Aquí el contrato,",
  "zq30a23": "lo firmó el suegro.",
  "zq30a24": {
    "text": "Su reto",
    "emotion": "輕蔑"
  },
  "zq30a25": "aquí no cuenta.",
  "zq30a26": "Señor,",
  "zq30a27": "lea esto.",
  "zq30a28": "Un mes de cuentas,",
  "zq30a29": "son de Xiaotang.",
  "zq30a30": "Lotes, compradores,",
  "zq30a31": "todo…",
  "zq30a32": "Un mes,",
  "zq30a33": "¿el triple?",
  "zq30a34": "¿Y qué?",
  "zq30a35": {
    "text": "¡Soy hija de Tang Wanjin!",
    "say": "¡Hija de Tang Wanjin!"
  },
  "zq30a36": "Minucias,",
  "zq30a37": {
    "text": "¿para qué tomarlo en serio?",
    "emotion": "輕蔑"
  },
  "zq30a38": "Amo,",
  "zq30a39": "¿y la deuda?",
  "zq30a40": "Años atrás",
  "zq30a41": "tu padre pidió ocho barcos.",
  "zq30a42": "Prestados,",
  "zq30a43": "ni uno volvió.",
  "zq30a44": "¿Y qué?",
  "zq30a45": {
    "text": "Este contrato",
    "emotion": "盯著婚書，語速正常"
  },
  "zq30a46": "era la prenda.",
  "zq30a47": "¿Prenda?",
  "zq30a48": {
    "text": "Papá, ¿no me vendiste?",
    "emotion": "小聲，著急"
  },
  "zq30a49": {
    "text": "Tontita,",
    "emotion": "眼睛紅了，輕聲，短促"
  },
  "zq30a50": "temía por ti.",
  "zq30a51": "Tang Wanjin,",
  "zq30a52": "¿te atreves contra el primer ministro?",
  "zq30a53": "¡Basta!",
  "zq30a54": "¡no los quiero!",
  "zq30a55": "Perdiste,",
  "zq30a56": "¡retira todo!",
  "zq30a57": "…retiro.",
  "zq30a58": {
    "text": "¡Mantengo al yerno!",
    "emotion": "豪氣，拍肩，不笑，語速快"
  },
  "zq30a59": "¡Azúcar hay!",
  "zq30a60": "Fue ella,",
  "zq30a61": {
    "text": "el mérito es suyo.",
    "emotion": "看著她，溫柔"
  },
  "zq30a62": {
    "text": "Tang Xiaotang: afecto más seis,",
    "say": "Xiaotang, más seis,"
  },
  "zq30a63": "más de cuarenta.",
  "zq30a64": "Recompensa:",
  "zq30a65": "semillas fértiles.",
  "zq30a66": "Tú…",
  "zq30a67": "¿qué haces aquí?"
}
