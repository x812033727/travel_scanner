{
  "zq30a01": {
    "text": "Kau sarjana miskin itu?",
    "emotion": "瞪著許硯，語速快"
  },
  "zq30a02": {
    "text": "Xu Yan.",
    "emotion": "拱手，短促"
  },
  "zq30a03": {
    "text": "Memang miskin.",
    "emotion": "坦然，語速快"
  },
  "zq30a04": {
    "text": "Sarjana miskin,",
    "emotion": "冷冷地",
    "say": "Sarjana miskin"
  },
  "zq30a05": {
    "text": "putriku makan apa?",
    "emotion": "拍金鑰匙，語速快"
  },
  "zq30a06": {
    "text": "Tuh,",
    "say": "Tuh!"
  },
  "zq30a07": "dindingnya lumpur.",
  "zq30a08": {
    "text": "Yuk!",
    "emotion": "一甩袖，短促"
  },
  "zq30a09": {
    "text": "Aku mau lihat.",
    "emotion": "不屑，語速快"
  },
  "zq30a10": {
    "text": "Silakan,",
    "say": "Silakan"
  },
  "zq30a11": "ini rumahnya.",
  "zq30a12": {
    "text": "Paman, minum teh,",
    "say": "Paman, minum teh"
  },
  "zq30a13": "air sumurnya manis!",
  "zq30a14": {
    "text": "Mangkuknya gompal,",
    "say": "Mangkuknya gompal"
  },
  "zq30a15": "tapi tehnya manis.",
  "zq30a16": {
    "text": "Mangkuk retak,",
    "say": "Mangkuk retak"
  },
  "zq30a17": "hati bersih.",
  "zq30a18": {
    "text": "Nak,",
    "emotion": "語氣軟下來，短促",
    "say": "Nak"
  },
  "zq30a19": {
    "text": "ikut Ayah pulang.",
    "emotion": "不容商量，語速快"
  },
  "zq30a20": "Nggak, Ayah.",
  "zq30a21": "Ini rumahku.",
  "zq30a22": {
    "text": "Surat nikah,",
    "say": "Surat nikah."
  },
  "zq30a23": "tulisan Ayah.",
  "zq30a24": {
    "text": "Taruhan,",
    "say": "Taruhan."
  },
  "zq30a25": "kalah sama Ayah.",
  "zq30a26": {
    "text": "Tuan,",
    "emotion": "短促",
    "say": "Tuan"
  },
  "zq30a27": {
    "text": "lihat ini dulu.",
    "emotion": "平靜，語速快"
  },
  "zq30a28": {
    "text": "Tiga puluh hari,",
    "say": "Tiga puluh hari"
  },
  "zq30a29": "dihitung Xiaotang.",
  "zq30a30": {
    "text": "Kloter, pembeli,",
    "say": "Kloter dan pembeli",
    "emotion": "喃喃，語速快"
  },
  "zq30a31": {
    "text": "lengkap…",
    "emotion": "喃喃，語速快"
  },
  "zq30a32": {
    "text": "Sebulan,",
    "emotion": "驚訝，短促",
    "say": "Sebulan"
  },
  "zq30a33": "naik tiga kali?",
  "zq30a34": {
    "text": "Iyalah!",
    "emotion": "下巴一抬，短促"
  },
  "zq30a35": "Aku putri Tang Wanjin!",
  "zq30a36": {
    "text": "Cuma receh,",
    "say": "Cuma receh"
  },
  "zq30a37": "kenapa Ayah serius?",
  "zq30a38": {
    "text": "Tuan,",
    "say": "Tuan"
  },
  "zq30a39": "utang ibu kota…",
  "zq30a40": {
    "text": "Lima tahun lalu,",
    "emotion": "冷，語速快",
    "say": "Lima tahun lalu"
  },
  "zq30a41": {
    "text": "ayahmu pinjam delapan kapal.",
    "emotion": "冷，語速快"
  },
  "zq30a42": {
    "text": "Katanya pinjam,",
    "emotion": "冷",
    "say": "Katanya pinjam"
  },
  "zq30a43": {
    "text": "satu pun nggak balik.",
    "emotion": "冷，語速快"
  },
  "zq30a44": "Lalu?",
  "zq30a45": {
    "text": "Surat nikah ini,",
    "emotion": "咬牙，語速快",
    "say": "Surat nikah ini"
  },
  "zq30a46": {
    "text": "jaminan buat keluargamu.",
    "emotion": "咬牙"
  },
  "zq30a47": {
    "text": "Jaminan?",
    "emotion": "愣住，短促"
  },
  "zq30a48": {
    "text": "Ayah, bukan menjualku?",
    "emotion": "聲音發抖，語速快"
  },
  "zq30a49": {
    "text": "Nak bodoh,",
    "say": "Nak bodoh",
    "emotion": "放軟聲音，語速快"
  },
  "zq30a50": {
    "text": "Ayah takut kau disakiti.",
    "emotion": "放軟聲音，語速快"
  },
  "zq30a51": {
    "text": "Kau…",
    "say": "Kau!"
  },
  "zq30a52": "berani melawan kami?",
  "zq30a53": {
    "text": "Kapalnya,",
    "emotion": "搶過婚書，短促",
    "say": "Kapalnya"
  },
  "zq30a54": {
    "text": "ambil saja!",
    "emotion": "豁出去"
  },
  "zq30a55": {
    "text": "Kau kalah,",
    "emotion": "精明，語速快",
    "say": "Kau kalah"
  },
  "zq30a56": {
    "text": "cabut, batal nikah.",
    "emotion": "乾脆，語速快"
  },
  "zq30a57": {
    "text": "…Cabut.",
    "say": "Cabut."
  },
  "zq30a58": {
    "text": "Tang yang tanggung!",
    "emotion": "豪氣，拍肩，語速快"
  },
  "zq30a59": {
    "text": "Gula sepuasnya!",
    "emotion": "豪氣，語速快"
  },
  "zq30a60": {
    "text": "Itu Xiaotang,",
    "emotion": "拱手，語速快",
    "say": "Itu Xiaotang"
  },
  "zq30a61": {
    "text": "semua jasanya.",
    "emotion": "看著她，溫柔"
  },
  "zq30a62": {
    "text": "Tang Xiaotang, plus enam,",
    "say": "Tang Xiaotang, plus enam"
  },
  "zq30a63": "lewat empat puluh.",
  "zq30a64": "Hadiah:",
  "zq30a65": "sekantong benih unggul.",
  "zq30a66": {
    "text": "Hah…",
    "say": "Hah?"
  },
  "zq30a67": "kau kenapa di sini?"
}
