{
  "zq30a01": "네가 그 가난한 수재냐?",
  "zq30a02": "쉬옌입니다.",
  "zq30a03": {"text":"가난은 맞죠.","emotion":"坦然，語速快"},
  "zq30a04": {"text":"가난뱅이가,","say":"가난뱅이가","emotion":"冷，語速快"},
  "zq30a05": "뭘로 내 딸을 먹여?",
  "zq30a06": {"text":"장인,","say":"장인","emotion":"幸災樂禍，短促"},
  "zq30a07": "저 집 벽은 진흙이죠.",
  "zq30a08": {"text":"가!","emotion":"一甩袖，短促一聲，不拖音"},
  "zq30a09": "그 집 좀 봐야겠다.",
  "zq30a10": {"text":"보시죠,","say":"보시죠","emotion":"用扇子掩鼻，語速快"},
  "zq30a11": "이게 저자 집입니다.",
  "zq30a12": {"text":"아저씨, 차 드세요,","say":"아저씨, 차 드세요"},
  "zq30a13": "우물물이 달아요!",
  "zq30a14": {"text":"그릇 이가 빠졌군,","say":"그릇 이가 빠졌군"},
  "zq30a15": "차는 다네.",
  "zq30a16": {"text":"그릇은 깨졌어도,","say":"그릇은 깨졌어도"},
  "zq30a17": "마음은 깨끗해.",
  "zq30a18": {"text":"아가,","say":"아가"},
  "zq30a19": "아빠랑 강남 가자.",
  "zq30a20": {"text":"아빠, 안 가.","say":"아빠 안 가","emotion":"咬唇，語速快"},
  "zq30a21": "여기가 내 집이야.",
  "zq30a22": {"text":"혼서 여기,","say":"혼서 여기","emotion":"得意，語速快"},
  "zq30a23": "장인어른 친필이죠.",
  "zq30a24": {"text":"저 여자 내기로,","say":"저 여자 내기로","emotion":"居高臨下，語速快"},
  "zq30a25": "장인어른 뜻은 못 꺾죠.",
  "zq30a26": {"text":"나리,","say":"나리","emotion":"平靜，短促"},
  "zq30a27": "장부부터 보시죠.",
  "zq30a28": {"text":"삼십 일 장부,","say":"삼십 일 장부"},
  "zq30a29": "전부 샤오탕이 했어요.",
  "zq30a30": {"text":"번호, 구매자,","say":"번호, 구매자"},
  "zq30a31": {"text":"하나도 안 빠졌네…","say":"하나도 안 빠졌네","emotion":"畫外，喃喃，語速快"},
  "zq30a32": {"text":"삼십 일,","say":"삼십 일","emotion":"挑眉，語速快"},
  "zq30a33": "세 배?",
  "zq30a34": {"text":"그럼!","emotion":"下巴一抬，短促一聲，不拖音"},
  "zq30a35": "난 탕완진의 딸이야!",
  "zq30a36": {"text":"작은 장부,","say":"작은 장부","emotion":"不耐，語速快"},
  "zq30a37": "뭘 그리 진지하세요?",
  "zq30a38": {"text":"나리,","say":"나리"},
  "zq30a39": "도성의 그 빚…",
  "zq30a40": {"text":"오 년 전,","say":"오 년 전"},
  "zq30a41": {"text":"네 아비가 배 여덟 척,","say":"네 아비가 배 여덟 척","emotion":"冷，語速快"},
  "zq30a42": {"text":"빌린다더니,","say":"빌린다더니"},
  "zq30a43": "한 척도 안 갚았지.",
  "zq30a44": "그래서요?",
  "zq30a45": {"text":"이 혼서는,","say":"이 혼서는"},
  "zq30a46": "너희 집에 잡힌 담보다.",
  "zq30a47": "담보?",
  "zq30a48": "아빠, 날 판 게 아냐?",
  "zq30a49": {"text":"이 바보야,","say":"이 바보야"},
  "zq30a50": {"text":"널 지키려고 그랬어.","emotion":"放軟聲音，語速稍快"},
  "zq30a51": {"text":"탕완진,","say":"탕완진","emotion":"威脅，語速快"},
  "zq30a52": "재상부와 등질 셈이오?",
  "zq30a53": {"text":"배 여덟 척,","say":"배 여덟 척","emotion":"豁出去，語速快"},
  "zq30a54": "필요 없다!",
  "zq30a55": {"text":"내기는 네가 졌어,","say":"내기는 네가 졌어"},
  "zq30a56": "고소 철회, 파혼.",
  "zq30a57": "…철회하지.",
  "zq30a58": {"text":"사위쯤 먹여 살려!","emotion":"豪氣，語速快，不笑"},
  "zq30a59": {"text":"설탕 실컷!","emotion":"豪氣，短促"},
  "zq30a60": {"text":"샤오탕 장부,","say":"샤오탕 장부","emotion":"拱手，語速快"},
  "zq30a61": "공도 샤오탕 거죠.",
  "zq30a62": {"text":"탕샤오탕 호감, +6,","say":"탕샤오탕 호감, 플러스 육,"},
  "zq30a63": "사십 돌파.",
  "zq30a64": "보상 개봉:",
  "zq30a65": "다수확 종자 한 봉지.",
  "zq30a66": {"text":"너…","say":"너","emotion":"整個人僵住，短促一聲"},
  "zq30a67": "왜 여기 있지?"
}
