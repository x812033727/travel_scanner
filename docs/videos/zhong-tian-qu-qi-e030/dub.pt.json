{
  "zq30a01": "Você é o letrado pobretão?",
  "zq30a02": {
    "text": "Xu Yan.",
    "emotion": "拱手，坦然，短促"
  },
  "zq30a03": {
    "text": "Pobre, sim.",
    "emotion": "坦然，不躲"
  },
  "zq30a04": {
    "text": "Letrado pobre,",
    "say": "Letrado pobre",
    "emotion": "輕蔑，不笑"
  },
  "zq30a05": "sustenta ela com quê?",
  "zq30a06": {
    "text": "Sogro,",
    "say": "Sogro",
    "emotion": "冷淡，短促，不笑"
  },
  "zq30a07": {
    "text": "a parede dele é de barro.",
    "emotion": "輕佻"
  },
  "zq30a08": {
    "text": "Bora!",
    "emotion": "一甩袖，短促"
  },
  "zq30a09": {
    "text": "vou ver a casa dele.",
    "emotion": "不屑"
  },
  "zq30a10": {
    "text": "Veja, sogro:",
    "say": "Olha",
    "emotion": "嫌棄，短促"
  },
  "zq30a11": "esta é a casa dele.",
  "zq30a12": {
    "text": "Toma chá, tio,",
    "say": "Toma chá, tio"
  },
  "zq30a13": {
    "text": "a água do poço é docinha!",
    "say": "a água é docinha!"
  },
  "zq30a14": {
    "text": "A tigela tá lascada,",
    "say": "Tigela lascada"
  },
  "zq30a15": "mas o chá é doce.",
  "zq30a16": {
    "text": "A tigela é lascada,",
    "say": "Tigela lascada"
  },
  "zq30a17": {
    "text": "o coração é limpo.",
    "say": "coração limpo.",
    "emotion": "冷冷地"
  },
  "zq30a18": {
    "text": "Filha,",
    "say": "Filha",
    "emotion": "放下碗，語氣軟下來，短促"
  },
  "zq30a19": "vem pro sul comigo.",
  "zq30a20": {
    "text": "Pai, não volto.",
    "emotion": "咬唇"
  },
  "zq30a21": {
    "text": "Minha casa é aqui.",
    "emotion": "堅定，不退"
  },
  "zq30a22": {
    "text": "Aqui está o contrato,",
    "say": "Eis o contrato",
    "emotion": "從袖裡抽出婚書，語速正常"
  },
  "zq30a23": "o sogro assinou.",
  "zq30a24": {
    "text": "A aposta dela",
    "say": "A aposta",
    "emotion": "輕蔑，語速快"
  },
  "zq30a25": "não vale contra o pai.",
  "zq30a26": {
    "text": "Senhor Tang,",
    "say": "Tome",
    "emotion": "雙手遞帳本，短促"
  },
  "zq30a27": "veja as contas.",
  "zq30a28": {
    "text": "Trinta dias de contas,",
    "say": "Trinta dias"
  },
  "zq30a29": "tudo da Xiaotang.",
  "zq30a30": {
    "text": "Lote, comprador,",
    "say": "Lote e comprador",
    "emotion": "畫外，越翻越快"
  },
  "zq30a31": "nada falta…",
  "zq30a32": {
    "text": "Trinta dias,",
    "say": "Um mês"
  },
  "zq30a33": "o triplo?",
  "zq30a34": {
    "text": "Ué!",
    "emotion": "下巴一抬，短促"
  },
  "zq30a35": {
    "text": "Sou filha de Tang Wanjin!",
    "say": "Sou uma Tang!",
    "emotion": "得意，語速快"
  },
  "zq30a36": {
    "text": "Contas miúdas,",
    "say": "Coisa pouca",
    "emotion": "扇子停住，不耐"
  },
  "zq30a37": {
    "text": "pra que levar a sério, sogro?",
    "emotion": "輕蔑"
  },
  "zq30a38": {
    "text": "Patrão,",
    "say": "Patrão",
    "emotion": "湊到耳邊，壓低聲音，短促"
  },
  "zq30a39": "a conta na capital…",
  "zq30a40": {
    "text": "Anos atrás,",
    "say": "Anos atrás",
    "emotion": "站起來，語速快"
  },
  "zq30a41": {
    "text": "seu pai levou oito barcos de sal.",
    "say": "seu pai levou oito barcos.",
    "emotion": "笑全收了，冷"
  },
  "zq30a42": {
    "text": "Emprestados,",
    "say": "Emprestados"
  },
  "zq30a43": "nenhum voltou.",
  "zq30a44": "E daí?",
  "zq30a45": {
    "text": "Este contrato",
    "emotion": "盯著婚書，語速正常"
  },
  "zq30a46": "era a garantia pra vocês.",
  "zq30a47": "Garantia?",
  "zq30a48": {
    "text": "Pai, você não me vendeu?",
    "emotion": "小聲，著急"
  },
  "zq30a49": {
    "text": "Bobinha,",
    "say": "Bobinha",
    "emotion": "眼睛紅了，輕聲，短促"
  },
  "zq30a50": "o papai temia por você.",
  "zq30a51": {
    "text": "Tang Wanjin,",
    "say": "Tang Wanjin",
    "emotion": "扇子一指，威脅"
  },
  "zq30a52": "vai enfrentar a casa do chanceler?",
  "zq30a53": {
    "text": "Oito barcos,",
    "say": "Os barcos",
    "emotion": "一把搶過婚書，短促"
  },
  "zq30a54": "não quero mais!",
  "zq30a55": {
    "text": "Perdeu a aposta,",
    "say": "Perdeu",
    "emotion": "抹掉眼淚，精明，短促"
  },
  "zq30a56": {
    "text": "retira a queixa e devolve o contrato.",
    "say": "retira tudo!"
  },
  "zq30a57": "…retiro.",
  "zq30a58": {
    "text": "Os Tang sustentam o genro!",
    "say": "Sustento o genro!",
    "emotion": "豪氣，拍肩，不笑，語速快"
  },
  "zq30a59": {
    "text": "Açúcar à vontade!",
    "say": "Tem açúcar!",
    "emotion": "豪氣，語速快"
  },
  "zq30a60": {
    "text": "As contas são dela,",
    "say": "Foi ela",
    "emotion": "拱手，語速快，短促"
  },
  "zq30a61": {
    "text": "o mérito é dela.",
    "emotion": "看著她，溫柔"
  },
  "zq30a62": {
    "text": "Tang Xiaotang: afeição, mais seis,",
    "say": "Xiaotang: mais seis."
  },
  "zq30a63": "mais de quarenta.",
  "zq30a64": {
    "text": "Recompensa do baú:",
    "say": "Recompensa:"
  },
  "zq30a65": {
    "text": "um saquinho de sementes de alta produtividade.",
    "say": "sementes de alto rendimento."
  },
  "zq30a66": {
    "text": "Você…",
    "emotion": "整個人僵住，短促"
  },
  "zq30a67": {
    "text": "o que faz aqui?",
    "emotion": "聲音發乾"
  }
}
