{
  "zq30a01": "お前が貧乏秀才か？",
  "zq30a02": "シュー・イェンです。",
  "zq30a03": "貧乏は本当です。",
  "zq30a04": "貧乏秀才が、",
  "zq30a05": "どうやって娘を養う？",
  "zq30a06": "お義父上、",
  "zq30a07": "こいつの家、壁は泥ですよ。",
  "zq30a08": { "text": "行け！", "emotion": "一甩袖，短促有力" },
  "zq30a09": "家を見てやる。",
  "zq30a10": "ご覧ください、",
  "zq30a11": "これがこいつの家です。",
  "zq30a12": "おじさん、お茶どうぞ、",
  "zq30a13": "井戸水、甘いよ！",
  "zq30a14": "碗が欠けとる、",
  "zq30a15": { "text": "茶は甘いな。", "say": "茶は甘い。", "emotion": "愣住" },
  "zq30a16": "碗は欠けてても、",
  "zq30a17": { "text": "心はきれいよ。", "say": "心は清い", "emotion": "乾脆，不要冷笑聲" },
  "zq30a18": { "text": "娘や、", "say": "娘", "emotion": "輕聲，極短" },
  "zq30a19": "江南へ帰るぞ。",
  "zq30a20": "父さん、帰らない。",
  "zq30a21": "ここが私の家。",
  "zq30a22": "婚書はここに、",
  "zq30a23": { "text": "義父の直筆。", "emotion": "得意，快" },
  "zq30a24": { "text": "彼女の賭けなど、", "say": "賭けは", "emotion": "輕蔑，快，不拖長" },
  "zq30a25": "親の決めた事には敵わない。",
  "zq30a26": { "text": "タン様、", "say": "タン様" },
  "zq30a27": "まず帳簿を。",
  "zq30a28": "三十日の帳簿、",
  "zq30a29": "全部シャオタンが。",
  "zq30a30": "番号、買い手、",
  "zq30a31": "漏れ一つない……",
  "zq30a32": { "text": "三十日で、", "say": "三十日", "emotion": "挑眉，快，短" },
  "zq30a33": "三倍だと？",
  "zq30a34": "当然よ。",
  "zq30a35": "タン・ワンジンの娘よ！",
  "zq30a36": { "text": "はした金です、", "say": "はした金", "emotion": "不耐，快" },
  "zq30a37": "お義父上、お気になさらず。",
  "zq30a38": { "text": "旦那様、", "say": "旦那様", "emotion": "壓低聲音，快" },
  "zq30a39": "都の、あの件……",
  "zq30a40": "五年前、",
  "zq30a41": { "text": "お前の父に塩船八隻を貸した。", "say": "お前の父に八隻貸した", "emotion": "笑全收了，冷，快" },
  "zq30a42": "借りると言って、",
  "zq30a43": "一隻も返さん。",
  "zq30a44": { "text": "だから？", "emotion": "強撐，快" },
  "zq30a45": "この婚書は、",
  "zq30a46": "お前の家への担保だ。",
  "zq30a47": "担保？",
  "zq30a48": { "text": "父さん、売ったんじゃないの？", "say": "売ったんじゃないの？" },
  "zq30a49": { "text": "馬鹿だな、", "say": "馬鹿だな", "emotion": "眼睛紅了，輕聲，不哭，快" },
  "zq30a50": "お前を守りたかったんだ。",
  "zq30a51": "タン・ワンジン、",
  "zq30a52": "宰相府を敵に回す気か？",
  "zq30a53": { "text": "船は、", "say": "船は", "emotion": "豁出去，快" },
  "zq30a54": "くれてやる！",
  "zq30a55": { "text": "賭けはあなたの負け、", "say": "賭けはあなたの負け", "emotion": "乾脆，快" },
  "zq30a56": "訴えも婚約も撤回。",
  "zq30a57": "……撤回だ。",
  "zq30a58": { "text": "婿くらい養えるわ！", "say": "婿は養う！", "emotion": "豪氣，拍肩，不笑" },
  "zq30a59": { "text": "砂糖も山ほどだ！", "say": "砂糖は山ほど！", "emotion": "豪氣，快" },
  "zq30a60": { "text": "計算は彼女、", "say": "計算は彼女", "emotion": "拱手，快" },
  "zq30a61": "手柄は彼女のものです。",
  "zq30a62": { "text": "シャオタン好感度、プラス六、", "say": "シャオタン、プラス六" },
  "zq30a63": "四十突破。",
  "zq30a64": { "text": "開封報酬：", "say": "報酬", "emotion": "平板電子音" },
  "zq30a65": "高収量の種、一袋。",
  "zq30a66": { "text": "お前……", "say": "お前", "emotion": "僵住，短" },
  "zq30a67": "なぜここに？"
}
