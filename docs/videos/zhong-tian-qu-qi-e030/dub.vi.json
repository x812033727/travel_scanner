{
  "zq30a01": {
    "text": "Ngươi là tên tú tài nghèo đó?",
    "emotion": "轉頭瞪著許硯，不笑出聲，語速快"
  },
  "zq30a02": {
    "text": "Vãn bối Hứa Nghiên.",
    "say": "Hứa Nghiên.",
    "emotion": "拱手，坦然，短促"
  },
  "zq30a03": {
    "text": "Nghèo là thật.",
    "emotion": "坦然，不笑出聲"
  },
  "zq30a04": {
    "text": "Tú tài nghèo,",
    "say": "Tú tài nghèo",
    "emotion": "冷，不笑出聲"
  },
  "zq30a05": {
    "text": "lấy gì nuôi con gái ta?",
    "emotion": "拍腰間的金鑰匙，不笑出聲"
  },
  "zq30a06": {
    "text": "Nhạc phụ,",
    "say": "Nhạc phụ",
    "emotion": "短促一聲，語速快，不拖長，不笑出聲"
  },
  "zq30a07": {
    "text": "tường nhà hắn trát bằng bùn.",
    "emotion": "輕佻，不笑出聲"
  },
  "zq30a08": {
    "text": "Dẫn đường!",
    "emotion": "一甩袖，短促"
  },
  "zq30a09": {
    "text": "Ta đến nhà hắn xem.",
    "emotion": "哼，不笑出聲"
  },
  "zq30a10": {
    "text": "Nhạc phụ mời xem,",
    "say": "Nhạc phụ mời xem",
    "emotion": "用扇子掩鼻，語速快"
  },
  "zq30a11": {
    "text": "đây là nhà hắn đấy.",
    "emotion": "嫌棄"
  },
  "zq30a12": {
    "text": "Bá bá uống trà,",
    "say": "Bá bá uống trà"
  },
  "zq30a13": "nước giếng ngọt lắm!",
  "zq30a14": {
    "text": "Bát mẻ một góc,",
    "say": "Bát mẻ một góc"
  },
  "zq30a15": "trà lại ngọt.",
  "zq30a16": {
    "text": "Bát thì mẻ,",
    "say": "Bát thì mẻ"
  },
  "zq30a17": {
    "text": "lòng thì sạch.",
    "emotion": "冷淡，不笑出聲"
  },
  "zq30a18": {
    "text": "Con gái,",
    "say": "Con gái",
    "emotion": "語氣軟下來，短促，不笑出聲"
  },
  "zq30a19": "theo cha về Giang Nam.",
  "zq30a20": {
    "text": "Cha, con không về.",
    "say": "Cha con không về."
  },
  "zq30a21": "Đây là nhà con.",
  "zq30a22": {
    "text": "Hôn thư ở đây,",
    "say": "Hôn thư ở đây"
  },
  "zq30a23": "nhạc phụ tự tay viết.",
  "zq30a24": {
    "text": "Vụ cược của nàng,",
    "say": "Vụ cược của nàng",
    "emotion": "居高臨下"
  },
  "zq30a25": "không thay nhạc phụ quyết được.",
  "zq30a26": {
    "text": "Đường lão gia,",
    "say": "Lão gia",
    "emotion": "上前一步，短促"
  },
  "zq30a27": "xem sổ này trước.",
  "zq30a28": {
    "text": "Sổ ba mươi ngày,",
    "say": "Sổ ba mươi ngày"
  },
  "zq30a29": "đều do Tiểu Đường tính.",
  "zq30a30": {
    "text": "Số lô, người mua,",
    "say": "Số lô người mua",
    "emotion": "畫外，越翻越快"
  },
  "zq30a31": {
    "text": "không sót một khoản…",
    "say": "không sót một khoản",
    "emotion": "畫外，喃喃，不笑出聲"
  },
  "zq30a32": {
    "text": "Ba mươi ngày,",
    "say": "Ba mươi ngày",
    "emotion": "驚訝，不笑出聲"
  },
  "zq30a33": "gấp ba lần?",
  "zq30a34": "Chứ sao!",
  "zq30a35": {
    "text": "Con gái Đường Vạn Kim đấy!",
    "emotion": "得意，語速快"
  },
  "zq30a36": {
    "text": "Sổ vặt thôi,",
    "say": "Sổ vặt thôi",
    "emotion": "不耐，短，不笑出聲"
  },
  "zq30a37": {
    "text": "nhạc phụ cần gì coi là thật?",
    "emotion": "假意客氣，不笑出聲"
  },
  "zq30a38": {
    "text": "Lão gia,",
    "say": "Lão gia"
  },
  "zq30a39": {
    "text": "khoản nợ ở kinh thành…",
    "say": "khoản nợ ở kinh thành"
  },
  "zq30a40": {
    "text": "Năm năm trước,",
    "say": "Năm năm trước",
    "emotion": "冷，語速正常，不笑出聲"
  },
  "zq30a41": {
    "text": "cha ngươi mượn ta tám thuyền muối.",
    "emotion": "冷，語速正常，不笑出聲"
  },
  "zq30a42": {
    "text": "Nói là mượn,",
    "say": "Nói là mượn",
    "emotion": "冷，不笑出聲"
  },
  "zq30a43": "chưa trả một chiếc.",
  "zq30a44": {
    "text": "Thì sao?",
    "emotion": "強撐，短促，語速快，不拖長"
  },
  "zq30a45": {
    "text": "Tờ hôn thư này,",
    "say": "Tờ hôn thư này",
    "emotion": "咬牙，語速正常，不停頓，不笑出聲"
  },
  "zq30a46": "là đem cầm cho nhà ngươi.",
  "zq30a47": "Cầm cố?",
  "zq30a48": {
    "text": "Cha, cha không bán con?",
    "say": "Cha cha không bán con?"
  },
  "zq30a49": {
    "text": "Con gái ngốc,",
    "say": "Con gái ngốc",
    "emotion": "眼睛紅了，放軟聲音，不笑出聲"
  },
  "zq30a50": "cha sợ bọn chúng hại con.",
  "zq30a51": {
    "text": "Đường Vạn Kim,",
    "say": "Đường Vạn Kim"
  },
  "zq30a52": "ngươi dám trở mặt với phủ tể tướng?",
  "zq30a53": {
    "text": "Tám chiếc thuyền,",
    "say": "Tám chiếc thuyền",
    "emotion": "一把搶過婚書，語速快"
  },
  "zq30a54": "ta không cần nữa!",
  "zq30a55": {
    "text": "Ngươi thua cược,",
    "say": "Ngươi thua cược"
  },
  "zq30a56": {
    "text": "rút đơn, thoái hôn.",
    "say": "rút đơn thoái hôn."
  },
  "zq30a57": "…Rút.",
  "zq30a58": {
    "text": "Đường gia nuôi nổi rể!",
    "emotion": "豪氣，拍肩，不笑出聲，語速快"
  },
  "zq30a59": {
    "text": "Đường, ăn thả ga!",
    "say": "Đường ăn thả ga!"
  },
  "zq30a60": {
    "text": "Tiểu Đường tính sổ,",
    "say": "Tiểu Đường tính sổ",
    "emotion": "拱手，語速快"
  },
  "zq30a61": {
    "text": "công là của nàng.",
    "emotion": "看著她，溫和，不笑出聲"
  },
  "zq30a62": {
    "text": "Tiểu Đường, hảo cảm cộng sáu,",
    "say": "Tiểu Đường hảo cảm cộng sáu",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq30a63": "vượt bốn mươi.",
  "zq30a64": {
    "text": "Mở rương thưởng:",
    "say": "Mở rương",
    "emotion": "平板電子音，語速偏快"
  },
  "zq30a65": "một túi nhỏ giống cao sản.",
  "zq30a66": {
    "text": "Ngươi…",
    "say": "Ngươi",
    "emotion": "整個人僵住，短促"
  },
  "zq30a67": "sao lại ở đây?"
}
