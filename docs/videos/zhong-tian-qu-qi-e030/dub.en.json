{
  "zq30a01": {
    "text": "You're the poor scholar?",
    "emotion": "轉頭瞪著許硯，不笑出聲，語速快"
  },
  "zq30a02": "I'm Xu Yan.",
  "zq30a03": "Poor, yes.",
  "zq30a04": "A poor scholar—",
  "zq30a05": {
    "text": "how'll you feed my girl?",
    "emotion": "拍腰間的金鑰匙，不笑出聲"
  },
  "zq30a06": {
    "text": "Look,",
    "emotion": "幸災樂禍，短促，不笑出聲"
  },
  "zq30a07": "his walls are made of mud.",
  "zq30a08": {
    "text": "Go!",
    "emotion": "一甩袖，短促"
  },
  "zq30a09": {
    "text": "Show me.",
    "emotion": "哼，不笑出聲"
  },
  "zq30a10": "Behold, Father,",
  "zq30a11": "this is his home.",
  "zq30a12": "Have some tea, sir,",
  "zq30a13": "the well water's sweet!",
  "zq30a14": "The bowl's chipped,",
  "zq30a15": "but the tea is sweet.",
  "zq30a16": "Chipped bowls,",
  "zq30a17": {
    "text": "clean hearts.",
    "emotion": "冷淡，不笑出聲"
  },
  "zq30a18": {
    "text": "Hon,",
    "emotion": "語氣軟下來，短，不笑出聲"
  },
  "zq30a19": "come home with me.",
  "zq30a20": "Dad, I'm not going.",
  "zq30a21": "This is my home.",
  "zq30a22": "Here's the marriage contract,",
  "zq30a23": "in your own hand.",
  "zq30a24": "Her bet",
  "zq30a25": "can't overrule her father.",
  "zq30a26": "Sir,",
  "zq30a27": "see these books first.",
  "zq30a28": "Thirty days of books,",
  "zq30a29": "all kept by Xiaotang.",
  "zq30a30": "Batches, buyers,",
  "zq30a31": {
    "text": "all here…",
    "emotion": "畫外，喃喃，不笑出聲"
  },
  "zq30a32": {
    "text": "A month,",
    "emotion": "驚訝，不笑出聲"
  },
  "zq30a33": "it tripled?",
  "zq30a34": "Duh!",
  "zq30a35": "I'm Tang Wanjin's daughter!",
  "zq30a36": {
    "text": "Trifles,",
    "emotion": "不耐，短，不笑出聲"
  },
  "zq30a37": "Why take them seriously, Father?",
  "zq30a38": "Master,",
  "zq30a39": "the capital debt…",
  "zq30a40": {
    "text": "Five years ago,",
    "emotion": "冷，語速正常，不笑出聲"
  },
  "zq30a41": {
    "text": "your dad borrowed eight ships.",
    "emotion": "冷，語速正常，不笑出聲"
  },
  "zq30a42": "Borrowed, he said.",
  "zq30a43": "Not one came back.",
  "zq30a44": "So what?",
  "zq30a45": {
    "text": "This match",
    "emotion": "咬牙，語速正常，不停頓，不笑出聲"
  },
  "zq30a46": "was a pledge to your family.",
  "zq30a47": "A pledge?",
  "zq30a48": "Dad, you didn't sell me?",
  "zq30a49": {
    "text": "Child,",
    "emotion": "眼睛紅了，放軟聲音，不笑出聲"
  },
  "zq30a50": "I was scared they'd hurt you.",
  "zq30a51": "Tang Wanjin,",
  "zq30a52": "you'd defy the chancellor's house?",
  "zq30a53": "Eight ships?",
  "zq30a54": "Keep them!",
  "zq30a55": "You lost the bet.",
  "zq30a56": "Drop the suit, end the match.",
  "zq30a57": "…Dropped.",
  "zq30a58": {
    "text": "The Tangs can feed him!",
    "emotion": "豪氣，拍肩，不笑出聲，語速快"
  },
  "zq30a59": "Sugar for all!",
  "zq30a60": "Xiaotang's books,",
  "zq30a61": "the credit's hers.",
  "zq30a62": {
    "text": "Tang Xiaotang, plus six,",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq30a63": "affection past forty.",
  "zq30a64": "Chest reward:",
  "zq30a65": "a small sack of high-yield seed.",
  "zq30a66": {
    "text": "You…",
    "emotion": "整個人僵住，短促"
  },
  "zq30a67": "what are you doing here?"
}
