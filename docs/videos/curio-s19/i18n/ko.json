  "lines": {
    "ef101": {
      "source_hash": "6c2f9b0034f6",
      "text": "1906년, 파리 시의회 위원회 보고서의 질문."
    },
    "ef102": {
      "source_hash": "788be65bcd66",
      "text": "1889년 박람회 최대 명물을 남길까, 철거할까?"
    },
    "ef103": {
      "source_hash": "41b52cb54aca",
      "text": "답 없이, 후임자가 때가 되면 정하라고만 썼습니다."
    },
    "ef104": {
      "source_hash": "5672c12d2c17",
      "text": "그뿐 아닙니다."
    },
    "ef105": {
      "source_hash": "197eea41378a",
      "text": "탑은 1887년 계약으로 지어졌고, 계약엔 기한이 있었습니다."
    },
    "ef106": {
      "source_hash": "870f957d81b9",
      "text": "같은 해 명사들이 신문에서 비난했고, 에펠은 전쟁을 말합니다."
    },
    "ef107": {
      "source_hash": "3891758c8e08",
      "text": "훗날 탑에서 4km 밖 팡테옹으로 신호를 보냈고,"
    },
    "ef108": {
      "source_hash": "4f23702a8e64",
      "text": "육군부는 탑을 세계 유일이라 평했습니다."
    },
    "ef109": {
      "source_hash": "86a9c79050af",
      "text": "기초에 물이 차 무너질 수 있다는 외신도."
    },
    "ef110": {
      "source_hash": "cee0712c359c",
      "text": "1909년에 철거될 뻔했다는데, 사실일까요?"
    },
    "ef201": {
      "source_hash": "78226069c9c5",
      "text": "계약은 1887년 1월 8일, 세 당사자가 맺었습니다."
    },
    "ef202": {
      "source_hash": "cf2461dc5d17",
      "text": "국가의 로크루아 장관, 파리의 푸벨 지사, 그리고 에펠."
    },
    "ef203": {
      "source_hash": "fd31fd5ba866",
      "text": "에펠은 150만 프랑과"
    },
    "ef204": {
      "source_hash": "d90ceb299a19",
      "text": "박람회 해와 1890년 1월 1일부터 20년 운영권을 받았습니다."
    },
    "ef205": {
      "source_hash": "3ed39fd508dd",
      "text": "탑은 박람회 뒤 파리시 소유였고,"
    },
    "ef206": {
      "source_hash": "118b1ec318d5",
      "text": "기한이 끝나면 운영권만 돌려주며,"
    },
    "ef207": {
      "source_hash": "bac02c5487ac",
      "text": "탑을 잘 정비해 반환해야 했습니다."
    },
    "ef208": {
      "source_hash": "5fed4a7ac0a8",
      "text": "만료 시 철거 조항은?"
    },
    "ef209": {
      "source_hash": "2fd1f2695d9f",
      "text": "없습니다. 철거는 에펠이 완공 못 할 때뿐."
    },
    "ef210": {
      "source_hash": "2d0cb91293b9",
      "text": "오히려 층마다 과학·군사 실험실을 두게 했습니다."
    },
    "ef211": {
      "source_hash": "1fe2f56ebe05",
      "text": "그런데 서명 한 달여 뒤 2월 14일, 그 항의가 르 탕에 실립니다."
    },
    "ef212": {
      "source_hash": "56326f1f4945",
      "text": "예술가·작가 50명 가까이, 모파상도 서명."
    },
    "ef213": {
      "source_hash": "a9377dbcc2d7",
      "text": "쓸모없고 흉측하며,"
    },
    "ef214": {
      "source_hash": "3f1c89c5abaf",
      "text": "20년간 그 혐오스런 그림자가 잉크 얼룩처럼 번진다고."
    },
    "ef215": {
      "source_hash": "7d9ee9521511",
      "text": "볼트로 조인 흉한 철판 기둥이라며,"
    },
    "ef216": {
      "source_hash": "d4e02cd25543",
      "text": "상업의 나라 미국도 거절."
    },
    "ef217": {
      "source_hash": "dee076468ad8",
      "text": "에펠의 답은?"
    },
    "ef218": {
      "source_hash": "e79f249454f7",
      "text": "먼저, 늦었다, 계약도 기초도 끝났다고."
    },
    "ef219": {
      "source_hash": "ecceba89dd75",
      "text": "서명한 가르니에가 탑 심사위원이라고도."
    },
    "ef220": {
      "source_hash": "a0a06d9e9b5d",
      "text": "같은 날 기자가 짚습니다. 반대는 박람회 뒤에도 탑이 서는 것."
    },
    "ef221": {
      "source_hash": "2dced9246398",
      "text": "에펠: 그럼 늦은 게 아니라 이른 겁니다."
    },
    "ef222": {
      "source_hash": "9ba932a363cd",
      "text": "제 탑은 아름다울 겁니다. 이집트에서 찬탄받는 것이 왜 파리에선 추하고 우습나요?"
    },
    "ef223": {
      "source_hash": "2ac856b93162",
      "text": "기한 뒤엔 시가 마음대로 하라고도."
    },
    "ef224": {
      "source_hash": "718726a6aeeb",
      "text": "천문·기상·물리 과학자 모두 쓰고,"
    },
    "ef225": {
      "source_hash": "68947a0a70d9",
      "text": "전쟁 얘기의 원문은, 전시에 파리와 프랑스 각지를 잇는다."
    },
    "ef226": {
      "source_hash": "686ff97a5283",
      "text": "박람회 뒤 누가 돈 내고 오를까요?"
    },
    "ef301": {
      "source_hash": "667d1de3068d",
      "text": "줄어듭니다. 1889년 박람회 땐"
    },
    "ef302": {
      "source_hash": "757986c1d50b",
      "text": "유료로 1층에 오른 이가 약 197만 명,"
    },
    "ef303": {
      "source_hash": "ee0fd792df4d",
      "text": "1898년엔 연 18만 3천여 명뿐."
    },
    "ef304": {
      "source_hash": "e13c28288b2c",
      "text": "그럼 에펠은 탑으로 뭘?"
    },
    "ef305": {
      "source_hash": "9b0c4c62d53c",
      "text": "실험입니다. 완공 직후 꼭대기 지름 1.6m 단에 기상 장비를 두고,"
    },
    "ef306": {
      "source_hash": "e9c4463271ad",
      "text": "케이블로 중앙기상국에 전송."
    },
    "ef307": {
      "source_hash": "a9bb893930b0",
      "text": "팡테옹으로 간 신호, 기억하십니까?"
    },
    "ef308": {
      "source_hash": "9bb657988033",
      "text": "1898년 10월 26일, 신호를 보낸 이는 뒤크레테."
    },
    "ef309": {
      "source_hash": "725600f347b2",
      "text": "4km 거리에 높은 건물들, 팡테옹에서 받았을까요?"
    },
    "ef310": {
      "source_hash": "92f4ea0bca2e",
      "text": "늘 또렷이, 짙은 안개에도 잡혔습니다."
    },
    "ef311": {
      "source_hash": "2b477b61acde",
      "text": "반대로 팡테옹에서 탑으론 안 잡혔습니다."
    },
    "ef312": {
      "source_hash": "fa1c249b741a",
      "text": "11월 7일, 그는 두 결과를 과학 아카데미에 보고합니다."
    },
    "ef313": {
      "source_hash": "9c650ae7af00",
      "text": "저희는 탑이 처음으로 높이로 자신을 증명했다고 봅니다."
    },
    "ef314": {
      "source_hash": "0da5756ea0a7",
      "text": "1902년부터 에펠은 탑에서 물체를 떨어뜨려 공기 저항도 쟀습니다."
    },
    "ef315": {
      "source_hash": "210b2297b1ec",
      "text": "계약 기한은 다가오고, 파리시는 탑을 남길까요?"
    },
    "ef401": {
      "source_hash": "228fa82d514a",
      "text": "실제로 물었습니다. 1903년, 센 도지사가 탑 감독위원회에 편지를 씁니다."
    },
    "ef402": {
      "source_hash": "18423c3f7b9d",
      "text": "계약 만료 때 탑을 남길까, 철거할까?"
    },
    "ef403": {
      "source_hash": "52717426aec8",
      "text": "10월 10일, 위원회는 만장일치로 보존이 이롭다고."
    },
    "ef404": {
      "source_hash": "dfc6ff150529",
      "text": "구조는 튼튼하고 관람객도 회복세이며,"
    },
    "ef405": {
      "source_hash": "1a015e27163c",
      "text": "육군은 루앙·퐁텐블로와 광통신 시험 중."
    },
    "ef406": {
      "source_hash": "d519f0df0d2f",
      "text": "무선이 앞으로 쓰임을 키운다고."
    },
    "ef407": {
      "source_hash": "07bae2110c2e",
      "text": "1906년, 탑 회사가 운영권 연장을 신청합니다."
    },
    "ef408": {
      "source_hash": "d0cc886dfb2e",
      "text": "후임자에게 넘긴 그 보고서, 기억하십니까?"
    },
    "ef409": {
      "source_hash": "073350a0945b",
      "text": "작성자는 샹드마르스 정비가 몇 년 걸린다면서도,"
    },
    "ef410": {
      "source_hash": "ed573961b530",
      "text": "탑에서 매일 하는 많은 실험이 분명 유용하고 인상 깊었다고 썼습니다."
    },
    "ef411": {
      "source_hash": "81dbdb9ecde8",
      "text": "후임자가 정할 때까지 정비하고 계속 개방하자는 의견."
    },
    "ef412": {
      "source_hash": "b525530237b9",
      "text": "7월 12일, 시의회는 1915년까지 5년 연장."
    },
    "ef413": {
      "source_hash": "8eb3b8fa85f6",
      "text": "조건은 매년 시에 5000프랑과 수익 일부, 지적된 결함의 즉시 수리."
    },
    "ef414": {
      "source_hash": "b2ef9ea2fcd3",
      "text": "그때 무선은 얼마나 멀리?"
    },
    "ef415": {
      "source_hash": "131e5f5c80dd",
      "text": "1500km 밖 비제르트도 수신했고,"
    },
    "ef416": {
      "source_hash": "78da13ea7fff",
      "text": "1907년 8월엔 1700km 밖 카사블랑카 앞바다 순양함도 받았다고."
    },
    "ef417": {
      "source_hash": "eebdeb537044",
      "text": "그런데 1908년 2월, 탑 옆 새 무선국이 불탔습니다."
    },
    "ef418": {
      "source_hash": "faecffba76e1",
      "text": "탑은 무사했습니다."
    },
    "ef419": {
      "source_hash": "e55acf3203f0",
      "text": "그해 육군부는 안테나를 탑 꼭대기에 달려 했습니다. 에펠의 전시 통신을 진지하게 본 겁니다."
    },
    "ef420": {
      "source_hash": "928f9099e6fc",
      "text": "'세계 유일'은 무슨 뜻일까요?"
    },
    "ef421": {
      "source_hash": "b5b40b591efa",
      "text": "그 형태와 센강 바로 옆이라는 입지로, 현재 세계 유일의 안테나 지지대라는 것."
    },
    "ef422": {
      "source_hash": "75c559a8add0",
      "text": "육군 허가는 탑 회사 운영권에 묶여, 운영권이 있는 한 무선국도 남습니다."
    },
    "ef423": {
      "source_hash": "e1e3c1768556",
      "text": "1908년 5월 15일, 운영권은 1926년까지 11년 더."
    },
    "ef424": {
      "source_hash": "3a532fd4f174",
      "text": "1909년, 육군 지하 무선국이 탑에서 약 200m 잔디밭 밑에 공사 중."
    },
    "ef425": {
      "source_hash": "1563d8260c34",
      "text": "같은 해 경도국이 하루 두 번 시보를 보내게 했습니다."
    },
    "ef426": {
      "source_hash": "2cf8d24b0a11",
      "text": "왜 시보?"
    },
    "ef427": {
      "source_hash": "5c5bf9036723",
      "text": "배가 시각을 맞추고 경도를 구하려고."
    },
    "ef428": {
      "source_hash": "66777069d5d3",
      "text": "그런데 그해 8월, 미국 소도시 신문은 몇 년 안에 철거된다고 했습니다."
    },
    "ef429": {
      "source_hash": "0f5c2621d536",
      "text": "원래 기한 1910년 1월 1일, 그날 탑은 어떻게 될까요?"
    },
    "ef501": {
      "source_hash": "ecd02d5f85ab",
      "text": "아무 일 없습니다. 11년 연장, 기억하십니까? 이미 기한이 아니었습니다."
    },
    "ef502": {
      "source_hash": "6da36bc0ad0d",
      "text": "그 1909년 이야기, 찾은 기록엔 철거 계획도 제안도 표결도 없습니다."
    },
    "ef503": {
      "source_hash": "f63cc7609a1b",
      "text": "미국 신문의 '곧 철거'는 소문일 뿐."
    },
    "ef504": {
      "source_hash": "ee3af42804d0",
      "text": "탑 밑 무선국은 이때 시보를 시작할 참이었습니다."
    },
    "ef505": {
      "source_hash": "6847e4185ae8",
      "text": "그런데 1910년 1월 말, 센강이 범람합니다."
    },
    "ef506": {
      "source_hash": "37e93aed1fab",
      "text": "무너질 수 있다는 외신이 이때 나왔습니다."
    },
    "ef507": {
      "source_hash": "07ad740bb48f",
      "text": "정말 잠긴 건?"
    },
    "ef508": {
      "source_hash": "03629fca54c1",
      "text": "지하 무선국입니다. 하수도가 터져 통째로 잠기고 장비가 상했습니다."
    },
    "ef509": {
      "source_hash": "16ef7ca4b2c2",
      "text": "첫 시보는 언제였을까요?"
    },
    "ef510": {
      "source_hash": "824da031bbd9",
      "text": "5월 23일에야 탑의 무선국이 첫 시보를 보냈습니다."
    },
    "ef511": {
      "source_hash": "7ae6e2039add",
      "text": "그 후임자들, 기억하십니까? 철거는 없었고 운영권은 1980년까지 연장됐습니다. 이 파일, 보관합니다."
    },
    "ef512": {
      "source_hash": "7812cfaba71c",
      "text": "철거될 뻔한 얘기, 어디서 들었나요?"
    },
    "ef513": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 다룹니다. 함께하려면 구독해 주세요."
    }
  }
}
