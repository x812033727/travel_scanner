{
  "zq13a01": "수재 말은 못 믿어!",
  "zq13a02": "말도 안 했는데.",
  "zq13a03": "대나무 발, 마을에 그 사람뿐.",
  "zq13a04": "전 수재가 삼 년 품삯 떼먹었어!",
  "zq13a05": "현령 나리 지시요!",
  "zq13a06": "판정: 거짓말.",
  "zq13a07": "내일, 거짓말 금지.",
  "zq13a08": "현령이?",
  "zq13a09": "직접 오라 해.",
  "zq13a10": "비켜, 이건 내가.",
  "zq13a11": "종이 팔리면,",
  "zq13a12": "일 할 줘요.",
  "zq13a13": "빈말이야,",
  "zq13a14": "수재 특기지.",
  "zq13a15": "계약서 쓰고,",
  "zq13a16": "도장 꾹.",
  "zq13a17": "촘촘하게?",
  "zq13a18": "그릴 수 있어?",
  "zq13a19": "여기요.",
  "zq13a20": "이야…",
  "zq13a21": "제법이군.",
  "zq13a22": "사흘에, 한 장.",
  "zq13a23": "앞으로,",
  "zq13a24": "이 규칙대로.",
  "zq13a25": "이 밤에, 어딜?",
  "zq13a26": "이름 없는 무덤…",
  "zq13a27": "기다려.",
  "zq13a28": "꼭 찾아낼게.",
  "zq13a29": "날 미행했어?"
}
