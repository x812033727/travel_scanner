{
  "zq13a01": "Janji sarjana nggak laku!",
  "zq13a02": "Aku belum ngomong.",
  "zq13a03": "Saringan bambu: cuma dia bisa.",
  "zq13a04": "Sarjana dulu nipu upahku tiga tahun!",
  "zq13a05": "Ini pesanan Tuan Bupati!",
  "zq13a06": "Vonis: bohong.",
  "zq13a07": "Besok, hanya boleh jujur.",
  "zq13a08": {
    "text": "Pesanan bupati?",
    "say": "Bupati, hah?"
  },
  "zq13a09": "Suruh dia datang!",
  "zq13a10": "Minggir, yang begini urusanku.",
  "zq13a11": "Kertas laku,",
  "zq13a12": {
    "text": "dapat sepuluh persen.",
    "say": "sepuluh persen!"
  },
  "zq13a13": "Janji kosong,",
  "zq13a14": "keahlian sarjana.",
  "zq13a15": "Kita bikin kontrak,",
  "zq13a16": "cap jempol.",
  "zq13a17": "Rapatnya?",
  "zq13a18": "Bisa gambar?",
  "zq13a19": "Sudah kugambar.",
  "zq13a20": {
    "text": "Rapat begini…",
    "say": "Rapat…"
  },
  "zq13a21": "Menarik juga.",
  "zq13a22": "Tiga hari, satu saringan.",
  "zq13a23": "Ke depan,",
  "zq13a24": "semua pakai aturan ini.",
  "zq13a25": "Malam begini, ke mana?",
  "zq13a26": "Kuburan tanpa nama…",
  "zq13a27": "Tunggu, ya.",
  "zq13a28": "Aku pasti temukan dia.",
  "zq13a29": "Kamu buntuti aku?"
}
