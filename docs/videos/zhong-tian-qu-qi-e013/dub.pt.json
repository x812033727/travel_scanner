{
  "zq13a01": "Letrado não tem palavra!",
  "zq13a02": "Eu nem abri a boca.",
  "zq13a03": {
    "text": "Telas de bambu: só ele faz na vila.",
    "say": "Tela de bambu: só ele faz."
  },
  "zq13a04": "O último me deu calote de três anos!",
  "zq13a05": "É pro magistrado!",
  "zq13a06": {
    "text": "Veredito: mentira.",
    "say": "Mentira."
  },
  "zq13a07": "Amanhã, só a verdade.",
  "zq13a08": {
    "text": "Pro magistrado?",
    "say": "Magistrado?"
  },
  "zq13a09": "Ele que venha.",
  "zq13a10": "Sai, deixa comigo.",
  "zq13a11": "Vendeu o papel,",
  "zq13a12": {
    "text": "dez por cento é seu.",
    "say": "dez por cento."
  },
  "zq13a13": "Promessa vazia,",
  "zq13a14": "letrado é bom nisso.",
  "zq13a15": "No contrato,",
  "zq13a16": {
    "text": "com digital.",
    "say": "digital."
  },
  "zq13a17": "Fina quanto?",
  "zq13a18": "Sabe desenhar?",
  "zq13a19": {
    "text": "Já desenhei.",
    "say": "Tá aqui."
  },
  "zq13a20": "Fina assim…",
  "zq13a21": "Interessante.",
  "zq13a22": "Três dias, uma tela.",
  "zq13a23": {
    "text": "Daqui pra frente,",
    "say": "Viu?"
  },
  "zq13a24": "contrato é assim.",
  "zq13a25": "Tão tarde, aonde vai?",
  "zq13a26": "Um túmulo sem nome…",
  "zq13a27": {
    "text": "Espere mais um pouco.",
    "say": "Logo."
  },
  "zq13a28": "Eu vou achar ele.",
  "zq13a29": "Você me seguiu?"
}
