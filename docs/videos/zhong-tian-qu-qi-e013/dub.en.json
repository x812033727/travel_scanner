{
  "zq13a01": "A scholar's word is worthless!",
  "zq13a02": "I haven't said a thing.",
  "zq13a03": "Bamboo screens: only he makes them here.",
  "zq13a04": "The last scholar cheated me out of three years' pay!",
  "zq13a05": "It's for the magistrate!",
  "zq13a06": "Verdict: lie.",
  "zq13a07": "Tomorrow, truth only.",
  "zq13a08": "For the magistrate?",
  "zq13a09": "Then he can come himself.",
  "zq13a10": "Move over, I've got this.",
  "zq13a11": "When paper sells,",
  "zq13a12": "you get ten percent.",
  "zq13a13": "Empty promises,",
  "zq13a14": "a scholar's specialty.",
  "zq13a15": "We'll put it in writing,",
  "zq13a16": "Thumbprint it.",
  "zq13a17": "How fine?",
  "zq13a18": "Can you draw it?",
  "zq13a19": "Already did.",
  "zq13a20": "Fine…",
  "zq13a21": "Not bad.",
  "zq13a22": "Three days, one screen.",
  "zq13a23": "From here,",
  "zq13a24": "hires get this deal.",
  "zq13a25": "This late? Where to?",
  "zq13a26": "A grave with no name…",
  "zq13a27": "A bit longer.",
  "zq13a28": "I'll find him.",
  "zq13a29": "You followed me?"
}
