{
  "zq13a01": "秀才は信用せん！",
  "zq13a02": "何も言ってない。",
  "zq13a03": "竹の簾、村で作れるのは彼だけ。",
  "zq13a04": "前の秀才に三年タダ働きだ！",
  "zq13a05": "県令様の注文だ！",
  "zq13a06": "判定：嘘。",
  "zq13a07": "明日は真実のみ。",
  "zq13a08": "県令の？",
  "zq13a09": "なら本人が来い。",
  "zq13a10": "どいて、私がやる。",
  "zq13a11": "売れたら、",
  "zq13a12": "一割あげる。",
  "zq13a13": "口約束なんぞ、",
  "zq13a14": "秀才のお家芸だ。",
  "zq13a15": "契約書にして、",
  "zq13a16": "拇印も。",
  "zq13a17": "目の細かさは？",
  "zq13a18": "描けるのか？",
  "zq13a19": "これだ。",
  "zq13a20": "細かい……",
  "zq13a21": "面白い。",
  "zq13a22": "三日で、一枚だ。",
  "zq13a23": "今後も、",
  "zq13a24": "このやり方で。",
  "zq13a25": "夜中にどこへ？",
  "zq13a26": "名のない墓……",
  "zq13a27": "待ってて。",
  "zq13a28": "必ず見つける。",
  "zq13a29": "つけてきたの？"
}
