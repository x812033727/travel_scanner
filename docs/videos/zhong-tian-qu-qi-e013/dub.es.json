{
  "zq13a01": "¡Palabra de letrado no vale!",
  "zq13a02": "Ni he hablado.",
  "zq13a03": "Tamiz de bambú: solo él lo hace.",
  "zq13a04": "¡Un letrado me estafó tres años!",
  "zq13a05": "¡Es del magistrado!",
  "zq13a06": {
    "text": "Veredicto: mentira.",
    "say": "Mentira."
  },
  "zq13a07": "Mañana, solo la verdad.",
  "zq13a08": {
    "text": "¿Para el magistrado?",
    "say": "¿Para él?"
  },
  "zq13a09": "Que venga él.",
  "zq13a10": "Quítate, esto es mío.",
  "zq13a11": {
    "text": "Cuando el papel se venda,",
    "say": "Si vendo,"
  },
  "zq13a12": {
    "text": "te toca el diez por ciento.",
    "say": "diez para ti."
  },
  "zq13a13": "Puro cuento,",
  "zq13a14": "típico de letrados.",
  "zq13a15": {
    "text": "Lo ponemos por escrito,",
    "say": "Por escrito,"
  },
  "zq13a16": {
    "text": "con tu huella.",
    "say": "y firmas."
  },
  "zq13a17": "¿Qué tan fino?",
  "zq13a18": "¿Y el dibujo?",
  "zq13a19": "Aquí está.",
  "zq13a20": {
    "text": "Tan fino…",
    "say": "Fino…"
  },
  "zq13a21": "Nada mal.",
  "zq13a22": "Tres días, un tamiz.",
  "zq13a23": "Desde hoy,",
  "zq13a24": "todos con este trato.",
  "zq13a25": "¿Tan tarde? ¿A dónde?",
  "zq13a26": "Tumba sin nombre…",
  "zq13a27": "Un poco más.",
  "zq13a28": "Lo voy a encontrar.",
  "zq13a29": "¿Me seguiste?"
}
