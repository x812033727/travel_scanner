{
  "zq8a01": {
    "text": "Resepnya nggak dijual.",
    "say": "Nggak kujual."
  },
  "zq8a02": "Poin suka plus tiga.",
  "zq8a03": {
    "text": "Kurang dua tael,",
    "say": "Kurang dua,"
  },
  "zq8a04": "lima kilo, keburu?",
  "zq8a05": "Ke pengawal!",
  "zq8a06": "Mereka bau keringat!",
  "zq8a07": "Sabun lagi?",
  "zq8a08": "Nggak usah!",
  "zq8a09": "Sekali cuci,",
  "zq8a10": "nggak wangi, gratis.",
  "zq8a11": "Wangi.",
  "zq8a12": "Sepeti ini kuborong!",
  "zq8a13": {
    "text": "Tujuh puluh batang, dua tael seratus koin,",
    "say": "Tujuh puluh, dua tael,"
  },
  "zq8a14": "Pas semua!",
  "zq8a15": "Aw!",
  "zq8a16": "Rambutku berantakan!",
  "zq8a17": "Pegangan!",
  "zq8a18": "Waktu habis,",
  "zq8a19": "jam lima lewat!",
  "zq8a20": "Mataharinya, belum terbenam.",
  "zq8a21": {
    "text": "Surat utangnya bilang matahari terbenam,",
    "say": "Tertulisnya senja,"
  },
  "zq8a22": "bukan jam lima!",
  "zq8a23": "Minggir.",
  "zq8a24": "Siapa suruh masuk?",
  "zq8a25": {
    "text": "Pengawal!",
    "say": "Hei!"
  },
  "zq8a26": {
    "text": "Dua puluh tael,",
    "say": "Dua puluh,"
  },
  "zq8a27": "nggak kurang sekoin.",
  "zq8a28": "Lewat jam lima,",
  "zq8a29": "Tak sah!",
  "zq8a30": "Utang dibayar,",
  "zq8a31": "Mana suratnya.",
  "zq8a32": {
    "text": "Poin suka plus lima.",
    "say": "Plus lima."
  },
  "zq8a33": "Utang lunas.",
  "zq8a34": "Xu Yan,",
  "zq8a35": "Awas kamu!",
  "zq8a36": "Topi jerami tali merah…",
  "zq8a37": "Yang di tepi sungai?",
  "zq8a38": "Misi rahasia: malam pertama.",
  "zq8a39": {
    "text": "Malam ini, poin suka salah satu istri plus sepuluh.",
    "say": "Malam ini, satu istri, plus sepuluh."
  },
  "zq8a40": "Bertaniku diambil?",
  "zq8a41": {
    "text": "Malam ini… malam pertama?",
    "say": "Malam ini, malam pertama?"
  }
}
