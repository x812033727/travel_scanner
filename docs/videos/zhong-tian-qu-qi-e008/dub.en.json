{
  "zq8a01": "The recipe's not for sale.",
  "zq8a02": "Affection: plus three.",
  "zq8a03": "Two taels short,",
  "zq8a04": "and three miles to go. In time?",
  "zq8a05": "Escorts!",
  "zq8a06": "They're always sweaty!",
  "zq8a07": "Soap again?",
  "zq8a08": "No, no!",
  "zq8a09": "One wash—",
  "zq8a10": "no scent, no charge.",
  "zq8a11": "Nice!",
  "zq8a12": "I'll take the whole crate!",
  "zq8a13": "Seventy bars, two taels,",
  "zq8a14": "that covers it!",
  "zq8a15": "Whoa!",
  "zq8a16": "My hair's coming down!",
  "zq8a17": "Hold on!",
  "zq8a18": "Time's up,",
  "zq8a19": "it's past five!",
  "zq8a20": "Sun's still up.",
  "zq8a21": "The IOU says sunset,",
  "zq8a22": "not five o'clock!",
  "zq8a23": "Move.",
  "zq8a24": "Who let you in?",
  "zq8a25": "Guards!",
  "zq8a26": "Twenty taels,",
  "zq8a27": "every coin.",
  "zq8a28": "It's past five,",
  "zq8a29": "doesn't count!",
  "zq8a30": "Debt's paid.",
  "zq8a31": "Hand over the IOU.",
  "zq8a32": "Affection: plus five.",
  "zq8a33": "Debt cleared.",
  "zq8a34": "Xu Yan,",
  "zq8a35": "you'll pay!",
  "zq8a36": "Straw hat, red cord…",
  "zq8a37": "The one by the river?",
  "zq8a38": "Hidden mission: wedding night.",
  "zq8a39": "Tonight, any wife's affection plus ten.",
  "zq8a40": "They'd take my farming?",
  "zq8a41": "Tonight… the wedding night?"
}
