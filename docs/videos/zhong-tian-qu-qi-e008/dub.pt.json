{
  "zq8a01": {
    "text": "A receita não tá à venda.",
    "say": "Não vendo."
  },
  "zq8a02": {
    "text": "Afeição: mais três.",
    "say": "Mais três."
  },
  "zq8a03": {
    "text": "Faltam dois taéis,",
    "say": "Faltam dois,"
  },
  "zq8a04": "e cinco quilômetros. Dá tempo?",
  "zq8a05": "Escolta!",
  "zq8a06": "Eles vivem suados!",
  "zq8a07": "Sabão de novo?",
  "zq8a08": "Não, não!",
  "zq8a09": "Uma lavada,",
  "zq8a10": {
    "text": "não cheirou, não paga.",
    "say": "ou é de graça."
  },
  "zq8a11": {
    "text": "Cheiroso!",
    "say": "Cheira!"
  },
  "zq8a12": "Levo a caixa inteira!",
  "zq8a13": {
    "text": "Setenta barras, dois taéis e cem moedas,",
    "say": "Setenta: dois taéis,"
  },
  "zq8a14": "Fechou a conta!",
  "zq8a15": {
    "text": "Devagar!",
    "say": "Ui!"
  },
  "zq8a16": {
    "text": "Meu coque vai desmanchar!",
    "say": "Meu cabelo!"
  },
  "zq8a17": "Segura!",
  "zq8a18": "Acabou o prazo,",
  "zq8a19": "já passou das cinco!",
  "zq8a20": "O sol… não se pôs.",
  "zq8a21": {
    "text": "A promissória diz pôr do sol,",
    "say": "Diz pôr do sol,"
  },
  "zq8a22": "não cinco horas!",
  "zq8a23": "Sai da frente.",
  "zq8a24": "Quem deixou entrar?",
  "zq8a25": "Guardas!",
  "zq8a26": {
    "text": "Vinte taéis,",
    "say": "Vinte,"
  },
  "zq8a27": "nenhum a menos.",
  "zq8a28": "Passou das cinco,",
  "zq8a29": "não vale!",
  "zq8a30": "Dívida paga,",
  "zq8a31": "a promissória.",
  "zq8a32": {
    "text": "Afeição: mais cinco.",
    "say": "Mais cinco."
  },
  "zq8a33": "Dívida zerada.",
  "zq8a34": "Xu Yan,",
  "zq8a35": "você me paga!",
  "zq8a36": {
    "text": "Chapéu de palha, fita vermelha…",
    "say": "Chapéu de palha…"
  },
  "zq8a37": "Aquele do rio?",
  "zq8a38": {
    "text": "Missão oculta: noite de núpcias.",
    "say": "Missão oculta: núpcias."
  },
  "zq8a39": {
    "text": "Esta noite, qualquer esposa: afeição mais dez.",
    "say": "Hoje: uma esposa, mais dez."
  },
  "zq8a40": "Até a roça?",
  "zq8a41": {
    "text": "Hoje… a noite de núpcias?",
    "say": "Hoje… núpcias?"
  }
}
