{
  "zq8a01": "Không bán công thức.",
  "zq8a02": "Hảo cảm cộng ba.",
  "zq8a03": "Còn thiếu hai lượng,",
  "zq8a04": "mười dặm đường, kịp không?",
  "zq8a05": "Tiêu cục!",
  "zq8a06": "Ngày nào cũng đầy mồ hôi!",
  "zq8a07": "Lại bán xà phòng?",
  "zq8a08": "Không cần!",
  "zq8a09": "Giặt một lần,",
  "zq8a10": "không thơm, miễn tiền.",
  "zq8a11": "Thơm!",
  "zq8a12": "Cả thùng này ta lấy hết!",
  "zq8a13": "Bảy mươi bánh, hơn hai lượng,",
  "zq8a14": "đủ cả rồi!",
  "zq8a15": {
    "text": "Chậm thôi!",
    "say": "Ối!"
  },
  "zq8a16": "Búi tóc ta sắp xổ rồi!",
  "zq8a17": "Bám chắc!",
  "zq8a18": "Hết giờ rồi,",
  "zq8a19": "qua giờ Thân rồi!",
  "zq8a20": "Mặt trời, chưa lặn.",
  "zq8a21": "Văn tự ghi mặt trời lặn,",
  "zq8a22": "đâu phải giờ Thân!",
  "zq8a23": "Tránh ra.",
  "zq8a24": "Ai cho các ngươi vào?",
  "zq8a25": {
    "text": "Người đâu!",
    "say": "Bắt!"
  },
  "zq8a26": {
    "text": "Hai mươi lượng,",
    "say": "Hai mươi,"
  },
  "zq8a27": "không thiếu một đồng.",
  "zq8a28": "Qua giờ Thân rồi,",
  "zq8a29": "không tính.",
  "zq8a30": "Có nợ thì trả,",
  "zq8a31": "đưa văn tự đây.",
  "zq8a32": {
    "text": "Hảo cảm cộng năm.",
    "say": "Cộng năm."
  },
  "zq8a33": "Nợ: về không.",
  "zq8a34": {
    "text": "Hứa Nghiên,",
    "say": "Ngươi!"
  },
  "zq8a35": "ngươi cứ chờ đấy!",
  "zq8a36": "Mũ rơm dây đỏ…",
  "zq8a37": "cái ở bờ sông?",
  "zq8a38": "Nhiệm vụ ẩn: động phòng hoa chúc.",
  "zq8a39": {
    "text": "Đêm nay, hảo cảm một người vợ cộng mười.",
    "say": "Đêm nay, một vợ cộng mười."
  },
  "zq8a40": "Trừ cả làm ruộng?",
  "zq8a41": "Đêm nay… động phòng?"
}
