{
  "zq8a01": "No la vendo.",
  "zq8a02": "Afecto: más tres.",
  "zq8a03": {
    "text": "Le faltan dos taeles,",
    "say": "Le faltan dos,"
  },
  "zq8a04": "y cinco kilómetros. ¿Llega?",
  "zq8a05": {
    "text": "¡Ya sé: los escoltas!",
    "say": "¡Ya sé!"
  },
  "zq8a06": "¡Siempre andan sudados!",
  "zq8a07": "¿Otra vez jabón?",
  "zq8a08": {
    "text": "¡No, no!",
    "say": "¡No!"
  },
  "zq8a09": "Una lavada,",
  "zq8a10": "o gratis.",
  "zq8a11": "¡Rico!",
  "zq8a12": "¡Me llevo toda la caja!",
  "zq8a13": {
    "text": "Setenta barras: dos taeles y cien cobres,",
    "say": "Setenta, dos taeles,"
  },
  "zq8a14": "¡Completamos!",
  "zq8a15": {
    "text": "¡Ay, despacio!",
    "say": "¡Ay!"
  },
  "zq8a16": {
    "text": "¡Se me deshace el peinado!",
    "say": "¡Mi peinado!"
  },
  "zq8a17": "¡Agárrate!",
  "zq8a18": "Se acabó el tiempo,",
  "zq8a19": "¡pasan de las cinco!",
  "zq8a20": "Aún hay sol.",
  "zq8a21": {
    "text": "El pagaré dice atardecer,",
    "say": "Dice atardecer,"
  },
  "zq8a22": "¡no las cinco!",
  "zq8a23": "Quítate.",
  "zq8a24": "¿Quién los dejó entrar?",
  "zq8a25": {
    "text": "¡Guardias!",
    "say": "¡Hey!"
  },
  "zq8a26": {
    "text": "Veinte taeles,",
    "say": "Veinte,"
  },
  "zq8a27": "ni un cobre menos.",
  "zq8a28": "Pasaron las cinco,",
  "zq8a29": {
    "text": "¡No vale!",
    "say": "¡No!"
  },
  "zq8a30": "Deuda pagada.",
  "zq8a31": "Deme el pagaré.",
  "zq8a32": {
    "text": "Afecto: más cinco.",
    "say": "Más cinco."
  },
  "zq8a33": "Deuda: cero.",
  "zq8a34": {
    "text": "Xu Yan,",
    "say": "¡Xu!"
  },
  "zq8a35": "¡Ya verás!",
  "zq8a36": {
    "text": "Sombrero de paja, cordón rojo…",
    "say": "Ese sombrero…"
  },
  "zq8a37": "¿El del río?",
  "zq8a38": "Misión oculta: noche de bodas.",
  "zq8a39": "Hoy, una esposa: más diez.",
  "zq8a40": "¿Me quitas sembrar?",
  "zq8a41": {
    "text": "¿Esta noche… noche de bodas?",
    "say": "¿Noche… de bodas?"
  }
}
