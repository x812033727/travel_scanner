{
  "zq8a01": "안 팝니다.",
  "zq8a02": {"text": "호감, +3.", "say": "호감, 플러스 삼."},
  "zq8a03": "두 냥 부족,",
  "zq8a04": "십 리 길, 갈 수 있겠나?",
  "zq8a05": "표국!",
  "zq8a06": "맨날 땀범벅이야!",
  "zq8a07": "또 비누?",
  "zq8a08": "됐어 됐어!",
  "zq8a09": "써 보고,",
  "zq8a10": "별로면 공짜.",
  "zq8a11": "오!",
  "zq8a12": "이 상자 다 사겠다!",
  "zq8a13": "두 냥 일 전,",
  "zq8a14": "다 채웠다!",
  "zq8a15": "악!",
  "zq8a16": "머리 풀려!",
  "zq8a17": "꽉 잡아!",
  "zq8a18": "시간 다 됐어,",
  "zq8a19": "신시 지났다!",
  "zq8a20": "해는, 아직 안 졌어.",
  "zq8a21": "차용증엔 일몰이야,",
  "zq8a22": "신시 말고!",
  "zq8a23": "비켜.",
  "zq8a24": "누가 들여보냈어?",
  "zq8a25": "여봐!",
  "zq8a26": "스무 냥,",
  "zq8a27": "다 있소.",
  "zq8a28": "신시 지났으니,",
  "zq8a29": "무효다!",
  "zq8a30": "빚은 갚았으니,",
  "zq8a31": "증서 줘요.",
  "zq8a32": {"text": "호감, +5.", "say": "호감, 플러스 오."},
  "zq8a33": "부채 청산.",
  "zq8a34": "너,",
  "zq8a35": "두고 보자!",
  "zq8a36": "붉은 끈 모자…",
  "zq8a37": "강가의 그?",
  "zq8a38": "히든 미션: 첫날밤.",
  "zq8a39": {"text": "오늘 밤, 아내 호감 +10.", "say": "오늘 밤, 아내 호감 플러스 십."},
  "zq8a40": "농사도 깎아?",
  "zq8a41": "오늘… 첫날밤?"
}
