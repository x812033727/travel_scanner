  },
  "lines": {
    "ok101": {
      "source_hash": "bc405b8625c1",
      "text": "에이로쿠 3년 5월 18일 깊은 밤, 기요스성."
    },
    "ok102": {
      "source_hash": "2163d37ba7c5",
      "text": "동쪽의 이마가와 대군은 이미 오와리에."
    },
    "ok103": {
      "source_hash": "685bee949d12",
      "text": "가신들은 스물일곱 살 성주 오다 노부나가의 내일 작전을 기다렸다."
    },
    "ok104": {
      "source_hash": "3660b08ad1a6",
      "text": "그는 싸움 얘기는 한마디 없이 한밤중까지 잡담하다 말했다. 가서 자라."
    },
    "ok105": {
      "source_hash": "ac8699350c72",
      "text": "성문을 나서며 누군가 비웃었다. 운이 다해 머리까지 흐려졌군."
    },
    "ok106": {
      "source_hash": "5672c12d2c17",
      "text": "이건 약과다."
    },
    "ok107": {
      "source_hash": "22a191c80bcd",
      "text": "다음 날, 우박 같은 큰비가 한쪽 얼굴에만 쏟아진다."
    },
    "ok108": {
      "source_hash": "25252a3026c9",
      "text": "300여 년 뒤 일본 육군 참모본부가 이 전투 지도를 그렸다."
    },
    "ok109": {
      "source_hash": "aa5a356deffc",
      "text": "지금도 남은 칼 한 자루엔 글 한 줄이 더해졌다."
    },
    "ok110": {
      "source_hash": "48ee81cca35d",
      "text": "그날 그는 대체 어느 길로 갔을까?"
    },
    "ok201": {
      "source_hash": "d716b34acccd",
      "text": "그 '가서 자라' 기억나는가? 동트기 전, 전선의 소식이 온다."
    },
    "ok202": {
      "source_hash": "c940743a1123",
      "text": "이마가와군이 국경 요새 둘을 포위했다."
    },
    "ok203": {
      "source_hash": "ade8d18796c9",
      "text": "그는 일어나 '아쓰모리'를 춘다."
    },
    "ok204": {
      "source_hash": "c634b04fb3d8",
      "text": "인간 세상 오십 년, 하늘에 비하면 한바탕 꿈과 같다는 노래다."
    },
    "ok205": {
      "source_hash": "8359be92cc14",
      "text": "춤을 마치고 외친다. 소라! 갑옷!"
    },
    "ok206": {
      "source_hash": "b216d65e3b0b",
      "text": "갑옷을 입고 선 채 밥을 먹고, 투구를 쓰고 성문을 나선다."
    },
    "ok207": {
      "source_hash": "6e457a4a6608",
      "text": "따른 것은 기마 시동 다섯뿐."
    },
    "ok208": {
      "source_hash": "4dae2f8f8cf3",
      "text": "군대가 모이기도 전이었다."
    },
    "ok217": {
      "source_hash": "120acdced197",
      "text": "그 밤 왜 작전을 말하지 않았는지 가장 이른 상세 기록엔 없다. 날이 밝은 뒤의 행동뿐이다."
    },
    "ok216": {
      "source_hash": "7351dca55b80",
      "text": "남동쪽으로 십수 킬로를 단숨에."
    },
    "ok209": {
      "source_hash": "05bd56fc37b9",
      "text": "아침 7, 8시쯤 아쓰타에 닿아 동쪽을 보니, 두 요새 쪽에 연기가 올랐다."
    },
    "ok210": {
      "source_hash": "fda886a62fad",
      "text": "뒤따라온 건 보병 200명 정도."
    },
    "ok215": {
      "source_hash": "ff70e714943c",
      "text": "전선의 젠쇼지 요새에서 모여드는 병사를 모으고 전장을 살폈다."
    },
    "ok211": {
      "source_hash": "66785888cc1e",
      "text": "가장 이른 기록엔 2천 명 미만."
    },
    "ok212": {
      "source_hash": "eec7fe68279f",
      "text": "이마가와군은 가장 이른 기록에 4만 5천, 오늘날 흔한 추정은 2만 5천 정도다."
    },
    "ok213": {
      "source_hash": "46ffd60df17c",
      "text": "적게 잡아도 열 배 이상. 요새에서 기다릴까?"
    },
    "ok320": {
      "source_hash": "640285a080b3",
      "text": "노부나가가 오자 선두 300명이 요시모토에게 돌진."
    },
    "ok321": {
      "source_hash": "a94c10b89a85",
      "text": "곧 흩어졌다."
    },
    "ok314": {
      "source_hash": "22f3b857af99",
      "text": "산 위의 요시모토는 또 이겼다."
    },
    "ok315": {
      "source_hash": "8e510e1d9cfb",
      "text": "내 창끝은 천마귀신도 못 막는다."
    },
    "ok316": {
      "source_hash": "de25c3eea7b4",
      "text": "진중에선 느긋이 우타이를 시켰다."
    },
    "ok326": {
      "source_hash": "b9a64f6b8475",
      "text": "우타이는 노에서 부르는 노래다."
    },
    "ok301": {
      "source_hash": "46b72e8d8359",
      "text": "그걸 본 노부나가는 젠쇼지에 머물지 않고, 최전선 나카지마 요새로 가려 했다."
    },
    "ok302": {
      "source_hash": "42df339e0809",
      "text": "가로들이 고삐를 잡는다."
    },
    "ok303": {
      "source_hash": "4824e8d1a8bd",
      "text": "양쪽이 깊은 논이라 한 줄로만 가야 합니다."
    },
    "ok304": {
      "source_hash": "aea43c355336",
      "text": "적에게 우리 수가 보입니다."
    },
    "ok324": {
      "source_hash": "6dbe2439e25f",
      "text": "그가 멈출까?"
    },
    "ok305": {
      "source_hash": "581d95dc9bdb",
      "text": "듣지 않고 나아갔다."
    },
    "ok306": {
      "source_hash": "55658dfa257a",
      "text": "흔한 이야기로는 노부나가가 몰래 산 뒤로 돌아가 기습한다."
    },
    "ok307": {
      "source_hash": "e0715e199a04",
      "text": "하지만 가장 이른 기록 속 길은 바로 이 길."
    },
    "ok325": {
      "source_hash": "f85dfdafe93b",
      "text": "이 차이로 어떻게 싸울까?"
    },
    "ok308": {
      "source_hash": "0bd6d5ed44db",
      "text": "더 나가려 하자 가로들이 이번엔 필사적으로 막았다."
    },
    "ok311": {
      "source_hash": "f19ba99053d4",
      "text": "그가 외쳤다."
    },
    "ok309": {
      "source_hash": "16433629e882",
      "text": "적은 어젯밤 오다카성에 군량을 넣고, 새벽엔 요새 앞에서 싸워 밤새 지쳤다."
    },
    "ok310": {
      "source_hash": "4caaa001a996",
      "text": "우리 힘은 새롭다."
    },
    "ok323": {
      "source_hash": "894a30aed244",
      "text": "적이 오면 물러나고, 물러나면 쫓아라."
    },
    "ok312": {
      "source_hash": "aeb1658da4b6",
      "text": "또 말했다. 목은 베지 말고, 쓰러뜨리면 전진하라."
    },
    "ok313": {
      "source_hash": "f59649d01af9",
      "text": "적다고 대적을 두려워 마라. 운은 하늘에 있다."
    },
    "ok322": {
      "source_hash": "f1c44889b914",
      "text": "그리고 군을 산기슭으로."
    },
    "ok317": {
      "source_hash": "f3b3fb1293dc",
      "text": "후대 책엔 요시모토가 진중에서 술로 자축했다."
    },
    "ok318": {
      "source_hash": "c034bc6d5251",
      "text": "가장 이른 기록엔 오케하자마산에서 쉬었다."
    },
    "ok319": {
      "source_hash": "5f73c452b113",
      "text": "요시모토는 날씨가 바뀔 줄 몰랐다."
    },
    "ok401": {
      "source_hash": "7efe6af706f9",
      "text": "정말 바뀐다. 음력 5월, 장마철이다."
    },
    "ok402": {
      "source_hash": "432c4b8f298e",
      "text": "갑자기 돌과 얼음을 던지듯 소나기가 쏟아진다."
    },
    "ok403": {
      "source_hash": "eeb05859ca7e",
      "text": "그 한쪽 비, 기억나나?"
    },
    "ok404": {
      "source_hash": "b258f84a13f7",
      "text": "이마가와군은 얼굴로 맞았다."
    },
    "ok405": {
      "source_hash": "95138ca07621",
      "text": "오다군은 등으로 맞았다."
    },
    "ok406": {
      "source_hash": "a4a581faf151",
      "text": "두세 명이 안을 큰 녹나무가 빗속에 동쪽으로 쓰러진다."
    },
    "ok407": {
      "source_hash": "91655693cd23",
      "text": "사람들은 말했다. 아쓰타 신이 보낸 신병인가?"
    },
    "ok408": {
      "source_hash": "fb8daa8584b8",
      "text": "천마귀신 장담, 기억나나?"
    },
    "ok409": {
      "source_hash": "8dd8beadd083",
      "text": "그를 먼저 막은 건 비였다."
    },
    "ok410": {
      "source_hash": "cbb9b77b2b33",
      "text": "비가 그치고 하늘이 갠다."
    },
    "ok411": {
      "source_hash": "e9e71a33d146",
      "text": "창을 쥔 노부나가, 가라! 가라!"
    },
    "ok412": {
      "source_hash": "d6d89c59bf23",
      "text": "오다군이 검은 연기 같은 먼지를 일으키며 돌진."
    },
    "ok413": {
      "source_hash": "c2f7119b05ee",
      "text": "이마가와군은 쏟은 물처럼 확 흩어졌다."
    },
    "ok414": {
      "source_hash": "61f498bf824b",
      "text": "요시모토의 칠한 가마도 버렸다."
    },
    "ok423": {
      "source_hash": "6be5591e17ff",
      "text": "흔히 요시모토가 뚱뚱해 말을 못 타 가마를 탔다지만, 칠한 가마는 신분의 상징이었다."
    },
    "ok415": {
      "source_hash": "07ba825cede4",
      "text": "노부나가가 외친다. 본진이 저기다! 쳐라!"
    },
    "ok416": {
      "source_hash": "780f8c8f6a31",
      "text": "처음엔 300기가 요시모토를 감싸 퇴각."
    },
    "ok417": {
      "source_hash": "c393b152f0b2",
      "text": "거듭 부딪치다 결국 50기만 남았다."
    },
    "ok420": {
      "source_hash": "6a98d49dbba0",
      "text": "요시모토와 첫 대결은 핫토리 고헤이타."
    },
    "ok418": {
      "source_hash": "76aef7f9cb8a",
      "text": "마지막에 마흔두 살 이마가와 요시모토는 모리 신스케 손에 죽는다."
    },
    "ok421": {
      "source_hash": "b3b896bb573d",
      "text": "해 지기 전, 노부나가는 기요스성에 돌아왔다."
    },
    "ok419": {
      "source_hash": "95b28a01ae7e",
      "text": "산 뒤로 도는 길은 어디서 나왔을까?"
    },
    "ok501": {
      "source_hash": "23abfe67b388",
      "text": "그 길은 노부나가 한 세대 뒤 사람이 썼다."
    },
    "ok527": {
      "source_hash": "0fa2eb4ecafb",
      "text": "그보다 먼저 이날을 쓴 건 궁수였다가 노부나가의 서기가 된 오타 규이치, 책은 『신초코키』다."
    },
    "ok502": {
      "source_hash": "ec4a96bab8df",
      "text": "적에게 보이는 그 길, 기억나는가? 그가 쓴 건 그 길이다."
    },
    "ok503": {
      "source_hash": "ec57728f03bc",
      "text": "전투 50~60년 뒤, 오제 호안이라는 사람이 노부나가 이야기를 다시 썼다."
    },
    "ok504": {
      "source_hash": "b975a389789e",
      "text": "소설에 가깝고, 원전에 없는 줄거리가 많다."
    },
    "ok505": {
      "source_hash": "a94a2f7b1574",
      "text": "산 뒤로 돌아 등 뒤를 친 이야기는 이 책에서 나왔다."
    },
    "ok506": {
      "source_hash": "6afe8fd1c2ea",
      "text": "오타 규이치 책은 필사본, 호안 책은 일찍 인쇄돼 팔렸다."
    },
    "ok525": {
      "source_hash": "5b239c79df29",
      "text": "에도 시대 사람들은 대개 이 책을 읽었다."
    },
    "ok528": {
      "source_hash": "9f99592fb670",
      "text": "그런데 한 책의 이야기가 어떻게 모두 믿는 정답이 됐을까?"
    },
    "ok507": {
      "source_hash": "d9fc5fb97d54",
      "text": "처음의 참모본부 지도, 기억나는가?"
    },
    "ok508": {
      "source_hash": "df1aebbbe0ed",
      "text": "메이지 32년 참모본부는 『일본전사』 「오케하자마 전역」을 병법 교재로 냈다."
    },
    "ok509": {
      "source_hash": "1338c7ebe9ee",
      "text": "호안의 산 뒤로 도는 길, 기억나는가? 이 책도 그 길이다."
    },
    "ok529": {
      "source_hash": "639c4a1f261e",
      "text": "호안만 쓴 척후의 보고까지 넣었다."
    },
    "ok510": {
      "source_hash": "7e5558205102",
      "text": "이 설은 호안에서 참모본부로 이어졌고, 군의 책이 나온 뒤 80여 년간 정답이었다."
    },
    "ok511": {
      "source_hash": "dfcf34ce2654",
      "text": "1982년에야 한 연구자가 『신초코키』를 다시 읽고,"
    },
    "ok512": {
      "source_hash": "10d43191d52e",
      "text": "우회 기습은 없다고 했다."
    },
    "ok526": {
      "source_hash": "9175c6b97f45",
      "text": "이후 연구는 이마가와 대군이 여러 곳에 흩어져 요시모토의 본진은 많지 않았다고 본다."
    },
    "ok513": {
      "source_hash": "1ef64d5836e4",
      "text": "그때부터 비가 그친 뒤 정면 돌격설이 유력해졌지만, 세부는 지금도 논쟁 중이다."
    },
    "ok514": {
      "source_hash": "0814fd0d517d",
      "text": "그 칼, 기억나나? 요시모토의 칼이다."
    },
    "ok515": {
      "source_hash": "1e2f0131d784",
      "text": "자루 속 슴베에 금으로 한 줄이 새겨졌고, 서명은 오다 오와리노카미 노부나가."
    },
    "ok516": {
      "source_hash": "2153488e92c1",
      "text": "에이로쿠 3년 5월 19일 요시모토를 치다."
    },
    "ok517": {
      "source_hash": "7cb2663384bf",
      "text": "연구자 말로는 당시 노부나가는 오와리노카미가 아닌 가즈사노스케였고, 『신초코키』도 이 싸움에서 그리 부른다."
    },
    "ok518": {
      "source_hash": "851135bf82a2",
      "text": "문화청은 노부나가가 칼을 얻을 때 새겼다지만, 칭호가 안 맞는다. 이것도 나중에 넣었을까?"
    },
    "ok524": {
      "source_hash": "f656826eb630",
      "text": "저희 생각엔, 우회 기습이 끌리는 건 소수 승리에 영리한 이유를 줘서입니다."
    },
    "ok519": {
      "source_hash": "be21dfc9d5a7",
      "text": "이 파일은 미해결이다."
    },
    "ok520": {
      "source_hash": "ad98df294624",
      "text": "오케하자마, 첫 만남은 대하드라마? 게임? 교과서?"
    },
    "ok521": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 다룹니다. 함께 파일을 열려면 구독을."
    }
  }
}
