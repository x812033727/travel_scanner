        "ep02-s05": {
          "instruction": {
            "zh-CN": "看看小熊，也可以跟着说。",
            "ja": "くまさんを見よう。言ってみてもいいよ。",
            "ko": "곰돌이를 봐요. 따라 말해도 좋아요."
          },
          "demo_translation": {
            "zh-TW": "難過。",
            "zh-CN": "难过。",
            "ja": "かなしい。",
            "ko": "슬퍼요."
          }
        },
        "ep02-s06": {
          "instruction": {
            "zh-CN": "听一听，指一指表情。",
            "ja": "聞いて、顔を指さしてみよう。",
            "ko": "듣고 표정을 가리켜 봐요."
          },
          "demo_translation": {
            "zh-TW": "開心。",
            "zh-CN": "开心。",
            "ja": "うれしい。",
            "ko": "기뻐요."
          }
        },
        "ep02-s07": {
          "instruction": {
            "zh-CN": "听一听，找一找表情。",
            "ja": "聞いて、顔をさがしてみよう。",
            "ko": "듣고 표정을 찾아봐요."
          },
          "demo_translation": {
            "zh-TW": "難過。",
            "zh-CN": "难过。",
            "ja": "かなしい。",
            "ko": "슬퍼요."
          }
        },
        "ep02-s08": {
          "instruction": {
            "zh-CN": "轮到你啦，可以学着笑一笑。",
            "ja": "同じように、にっこりしてみよう。",
            "ko": "이렇게 웃어 봐도 좋아요."
