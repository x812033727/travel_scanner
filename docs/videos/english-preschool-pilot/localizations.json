    "ep02": {
      "titles": {
        "zh-TW": "Happy 與 Sad：看看心情",
        "zh-CN": "Happy 和 Sad：看看心情",
        "ja": "Happy と Sad：どんなきもち？",
        "ko": "Happy와 Sad: 어떤 기분일까요?"
      },
      "scenes": {
        "ep02-s01": {
          "instruction": {
            "zh-CN": "挥挥手，看看小熊的心情。",
            "ja": "手をふって、くまさんの顔を見よう。",
            "ko": "손을 흔들고 곰돌이 표정을 봐요."
