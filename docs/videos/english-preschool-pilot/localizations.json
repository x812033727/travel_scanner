          "demo_translation": {
            "zh-TW": "開心。",
            "zh-CN": "开心。",
            "ja": "うれしい。",
            "ko": "기뻐요."
          }
        },
        "ep02-s09": {
          "instruction": {
            "zh-CN": "开心或难过，都可以。",
            "ja": "うれしくても、かなしくてもいいんだよ。",
            "ko": "기뻐도 슬퍼도 괜찮아요."
          },
          "demo_translation": {
            "zh-TW": "難過。",
            "zh-CN": "难过。",
            "ja": "かなしい。",
            "ko": "슬퍼요."
          }
        },
        "ep02-s10": {
          "instruction": {
            "zh-CN": "和两位朋友挥手说再见。",
            "ja": "ふたりに手をふろう。またね。",
            "ko": "두 친구에게 손을 흔들어요. 안녕!"
          },
          "demo_translation": {
            "zh-TW": "再見！",
            "zh-CN": "再见！",
            "ja": "またね！",
            "ko": "안녕!"
          }
        }
      }
