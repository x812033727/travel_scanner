{
  "zq14a01": "Buntuti aku?",
  "zq14a02": {
    "text": "Tengah malam lewat,",
    "say": "Tengah malam,"
  },
  "zq14a03": "hukuman jujur berlaku.",
  "zq14a04": "Aku takut kamu kenapa-napa.",
  "zq14a05": "Sendiri ke hutan,",
  "zq14a06": "aku cemas.",
  "zq14a07": "Lain kali,",
  "zq14a08": "langkahnya pelan.",
  "zq14a09": {
    "text": "Poin suka Qin Shuang,",
    "say": "Qin Shuang,"
  },
  "zq14a10": "plus lima.",
  "zq14a11": "Kak Xu!",
  "zq14a12": { "text": "Bambu hancur!", "emotion": "得意，大嗓門" },
  "zq14a13": "Sepuluh hari tinggal tujuh,",
  "zq14a14": "semalam kamu ke mana?",
  "zq14a15": "Ngikutin Qin Shuang,",
  "zq14a16": "masuk kuburan.",
  "zq14a17": "Ku… kuburan?",
  "zq14a18": "Masih hidup?",
  "zq14a19": "Aku atau dia, siapa cantik?",
  "zq14a20": "Pas hitung,",
  "zq14a21": "paling cantik.",
  "zq14a22": {
    "text": "Poin suka Tang Xiaotang, plus satu.",
    "say": "Tang Xiaotang, plus satu."
  },
  "zq14a23": "Saringan jadi.",
  "zq14a24": "Tuan Bupati,",
  "zq14a25": "beneran mau?",
  "zq14a26": "Nggak",
  "zq14a27": "aku bohongin kamu.",
  "zq14a28": "Sarjana,",
  "zq14a29": "sama semua!",
  "zq14a30": "Bagi hasil asli,",
  "zq14a31": "gambarnya juga punyaku.",
  "zq14a32": "Sarjana jujur,",
  "zq14a33": "baru sekarang.",
  "zq14a34": "Siapa kamu sebenarnya?",
  "zq14a35": "Dari tempat yang jauh.",
  "zq14a36": "Seberapa jauh?",
  "zq14a37": {
    "text": "Jauh sampai…",
    "say": "Jauh…"
  },
  "zq14a38": "nggak bisa pulang.",
  "zq14a39": {
    "text": "Kertas putih pertama,",
    "say": "Kertas pertama,"
  },
  "zq14a40": "selesai.",
  "zq14a41": "Kertas ini…",
  "zq14a42": "lebih putih dari di kota.",
  "zq14a43": "Gawat!",
  "zq14a44": "Dari serikat toko buku!",
  "zq14a45": "Kertas putih Liuxi,",
  "zq14a46": "ditolak semua toko di kota!"
}
