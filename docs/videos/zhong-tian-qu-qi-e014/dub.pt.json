{
  "zq14a01": "Você me seguiu?",
  "zq14a02": {
    "text": "Passou da meia-noite.",
    "say": "Meia-noite."
  },
  "zq14a03": {
    "text": "Castigo da verdade: ativado.",
    "say": "Castigo da verdade."
  },
  "zq14a04": "Tive medo por você.",
  "zq14a05": {
    "text": "Sozinha na mata,",
    "say": "Sozinha,"
  },
  "zq14a06": "me preocupei.",
  "zq14a07": "Se seguir,",
  "zq14a08": "pisa mais leve.",
  "zq14a09": "Qin Shuang:",
  "zq14a10": "mais cinco.",
  "zq14a11": "Ô, Xu!",
  "zq14a12": {
    "text": "O bambu virou pasta!",
    "say": "Virou pasta!"
  },
  "zq14a13": "Dos dez dias, sobram sete.",
  "zq14a14": "Onde você tava ontem?",
  "zq14a15": {
    "text": "Segui a Shuang",
    "say": "Atrás da Shuang,"
  },
  "zq14a16": "ao cemitério.",
  "zq14a17": "Ce… cemitério?",
  "zq14a18": {
    "text": "Saiu vivo?",
    "say": "Tá vivo?"
  },
  "zq14a19": "Quem é mais bonita, eu ou ela?",
  "zq14a20": "Nas contas,",
  "zq14a21": {
    "text": "você fica linda.",
    "say": "você brilha."
  },
  "zq14a22": "Tang Xiaotang: mais um.",
  "zq14a23": "A tela tá pronta.",
  "zq14a24": {
    "text": "O magistrado",
    "say": "Magistrado"
  },
  "zq14a25": "quer o papel?",
  "zq14a26": "Não,",
  "zq14a27": "eu menti pra você.",
  "zq14a28": "Letrado",
  "zq14a29": "é tudo igual!",
  "zq14a30": "A parte é real,",
  "zq14a31": "o desenho é meu.",
  "zq14a32": "Letrado sincero,",
  "zq14a33": {
    "text": "primeira vez que vejo.",
    "say": "nunca vi."
  },
  "zq14a34": "Quem é você?",
  "zq14a35": "Vim de muito longe.",
  "zq14a36": "Longe quanto?",
  "zq14a37": "Tão longe…",
  "zq14a38": "que não dá pra voltar.",
  "zq14a39": {
    "text": "Primeira folha branca:",
    "say": "Primeira folha:"
  },
  "zq14a40": "pronta.",
  "zq14a41": {
    "text": "Esse papel…",
    "say": "Isso…"
  },
  "zq14a42": "mais branco que o da cidade.",
  "zq14a43": "Problema!",
  "zq14a44": {
    "text": "Da guilda dos livreiros!",
    "say": "É da guilda!"
  },
  "zq14a45": "Papel branco de Liuxi:",
  "zq14a46": "nenhuma loja compra!"
}
