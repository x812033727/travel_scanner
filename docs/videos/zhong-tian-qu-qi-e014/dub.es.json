{
  "zq14a01": "¿Me seguiste?",
  "zq14a02": {
    "text": "Pasó la medianoche.",
    "say": "Medianoche."
  },
  "zq14a03": {
    "text": "Castigo de la verdad: activo.",
    "say": "Castigo: activo."
  },
  "zq14a04": "Temía que te pasara algo.",
  "zq14a05": {
    "text": "Tú sola, en el bosque,",
    "say": "Tú sola,"
  },
  "zq14a06": "me preocupé.",
  "zq14a07": "La próxima,",
  "zq14a08": "pisa suave.",
  "zq14a09": "Qin Shuang:",
  "zq14a10": "más cinco.",
  "zq14a11": "¡Xu!",
  "zq14a12": {
    "text": "¡El bambú ya es pulpa!",
    "say": "¡Pulpa lista!"
  },
  "zq14a13": "Quedan siete días.",
  "zq14a14": "¿Y anoche, dónde?",
  "zq14a15": "Seguí a Shuang",
  "zq14a16": "a las tumbas.",
  "zq14a17": "¿Las… tumbas?",
  "zq14a18": {
    "text": "¿Y sigues vivo?",
    "say": "¿Vivo?"
  },
  "zq14a19": "¿Quién es más linda, ella o yo?",
  "zq14a20": "Con el ábaco,",
  "zq14a21": "brillas.",
  "zq14a22": "Tang Xiaotang: más uno.",
  "zq14a23": "Tamiz listo.",
  "zq14a24": "¿El magistrado",
  "zq14a25": "lo quiere?",
  "zq14a26": "No,",
  "zq14a27": "te mentí.",
  "zq14a28": "Letrados,",
  "zq14a29": "¡todos iguales!",
  "zq14a30": {
    "text": "Tu parte de la ganancia es real,",
    "say": "Tu parte, sí,"
  },
  "zq14a31": "y el dibujo es mío.",
  "zq14a32": "Letrado honesto…",
  "zq14a33": {
    "text": "es el primero.",
    "say": "es nuevo."
  },
  "zq14a34": "¿Quién eres?",
  "zq14a35": "Vengo de muy lejos.",
  "zq14a36": {
    "text": "¿Qué tan lejos?",
    "say": "¿Cuánto?"
  },
  "zq14a37": "Tan lejos…",
  "zq14a38": "que no puedo volver.",
  "zq14a39": {
    "text": "Primera hoja de papel blanco:",
    "say": "Primera hoja:"
  },
  "zq14a40": "lista.",
  "zq14a41": "Este papel…",
  "zq14a42": "más blanco que en la ciudad.",
  "zq14a43": {
    "text": "¡Problemas!",
    "say": "¡Ay, no!"
  },
  "zq14a44": {
    "text": "¡Lo pegó el gremio de libreros!",
    "say": "¡Lo puso el gremio!"
  },
  "zq14a45": "Papel de Liuxi:",
  "zq14a46": "¡nadie en la ciudad lo compra!"
}
