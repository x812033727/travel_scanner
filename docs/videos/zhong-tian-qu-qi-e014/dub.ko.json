{
  "zq14a01": "날 미행했어?",
  "zq14a02": "자시 경과,",
  "zq14a03": "진실 페널티 발동.",
  "zq14a04": "너 다칠까 봐.",
  "zq14a05": "혼자 숲에,",
  "zq14a06": "걱정돼서.",
  "zq14a07": "다음엔,",
  "zq14a08": "발소리 죽여.",
  "zq14a09": "친솽 호감,",
  "zq14a10": {"text": "+5.", "say": "플러스 오."},
  "zq14a11": "형!",
  "zq14a12": "대나무 다 찧었어!",
  "zq14a13": "이제 이레 남았는데,",
  "zq14a14": "어젯밤 어디 갔어?",
  "zq14a15": "친솽 따라서,",
  "zq14a16": "무덤에 갔어.",
  "zq14a17": "무… 무덤?",
  "zq14a18": "안 베였어?",
  "zq14a19": "나랑 걔, 누가 예뻐?",
  "zq14a20": "장부 볼 때,",
  "zq14a21": "제일 예뻐.",
  "zq14a22": {"text": "탕샤오탕, +1.", "say": "탕샤오탕, 플러스 일."},
  "zq14a23": "발 다 됐어.",
  "zq14a24": "현령이,",
  "zq14a25": "정말 원해?",
  "zq14a26": "아니",
  "zq14a27": "거짓말이었어요.",
  "zq14a28": "수재란 놈들,",
  "zq14a29": "다 똑같아!",
  "zq14a30": "배당은 진짜고,",
  "zq14a31": "도면도 제 거예요.",
  "zq14a32": "솔직한 수재는,",
  "zq14a33": "처음 보네.",
  "zq14a34": "누구야?",
  "zq14a35": "먼 데서 왔어.",
  "zq14a36": "얼마나?",
  "zq14a37": "멀어서…",
  "zq14a38": "못 돌아가.",
  "zq14a39": "첫 번째 흰 종이,",
  "zq14a40": "완성.",
  "zq14a41": "이 종이…",
  "zq14a42": "읍내 것보다 하얘.",
  "zq14a43": "큰일이야!",
  "zq14a44": "책방 조합 공고야!",
  "zq14a45": "류시 종이,",
  "zq14a46": "읍내 전면 거부!"
}
