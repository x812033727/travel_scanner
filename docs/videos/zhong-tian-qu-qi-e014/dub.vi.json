{
  "zq14a01": "Ngươi theo dõi ta?",
  "zq14a02": "Đã qua giờ Tý,",
  "zq14a03": "bắt đầu phạt nói thật.",
  "zq14a04": "Ta sợ nàng gặp chuyện.",
  "zq14a05": {
    "text": "Nàng một mình vào rừng,",
    "say": "Một mình vào rừng,"
  },
  "zq14a06": "ta không yên tâm.",
  "zq14a07": "Lần sau,",
  "zq14a08": "theo thì nhẹ chân.",
  "zq14a09": "Hảo cảm Tần Sương,",
  "zq14a10": "cộng năm.",
  "zq14a11": "Hứa huynh đệ!",
  "zq14a12": "Tre giã nhuyễn rồi!",
  "zq14a13": "Mười ngày còn bảy,",
  "zq14a14": "đêm qua huynh đi đâu?",
  "zq14a15": "Theo Tần Sương,",
  "zq14a16": "vào bãi tha ma.",
  "zq14a17": "Bãi… bãi tha ma?",
  "zq14a18": "Không bị chém à?",
  "zq14a19": "Thế ta với nàng ấy, ai đẹp hơn?",
  "zq14a20": "Lúc nàng tính sổ,",
  "zq14a21": "là đẹp nhất.",
  "zq14a22": {
    "text": "Hảo cảm Đường Tiểu Đường: cộng một.",
    "say": "Tiểu Đường: cộng một."
  },
  "zq14a23": "Mành làm xong rồi.",
  "zq14a24": "Quan huyện,",
  "zq14a25": "thật cần giấy này?",
  "zq14a26": "Không!",
  "zq14a27": "ta lừa ông đấy.",
  "zq14a28": "Tú tài,",
  "zq14a29": "đều một giuộc!",
  "zq14a30": "Tiền chia lời là thật,",
  "zq14a31": "bản vẽ cũng do ta vẽ.",
  "zq14a32": "Tú tài nói thật,",
  "zq14a33": "lần đầu mới thấy.",
  "zq14a34": "Rốt cuộc ngươi là ai?",
  "zq14a35": "Từ nơi rất xa.",
  "zq14a36": "Bao xa?",
  "zq14a37": "Xa đến mức…",
  "zq14a38": "không về được nữa.",
  "zq14a39": "Tờ giấy đầu tiên,",
  "zq14a40": "hoàn thành.",
  "zq14a41": "Giấy này…",
  "zq14a42": "trắng hơn cả trên huyện.",
  "zq14a43": "Nguy rồi!",
  "zq14a44": "Hội thư phường dán đấy!",
  "zq14a45": "Giấy trắng Liễu Khê,",
  "zq14a46": "huyện thành không nhận một tờ!"
}
