{
  "zq14a01": "You followed me?",
  "zq14a02": "Midnight has passed.",
  "zq14a03": "Truth penalty in effect.",
  "zq14a04": "I was scared for you.",
  "zq14a05": "Alone in the woods—",
  "zq14a06": "I was worried.",
  "zq14a07": "Next time,",
  "zq14a08": "step lighter.",
  "zq14a09": "Qin Shuang:",
  "zq14a10": "plus five.",
  "zq14a11": "Hey Xu!",
  "zq14a12": "Bamboo's pulped!",
  "zq14a13": "Seven days left.",
  "zq14a14": "Where were you last night?",
  "zq14a15": "Following Qin Shuang",
  "zq14a16": "a graveyard.",
  "zq14a17": "A gr-graveyard?",
  "zq14a18": "Alive?",
  "zq14a19": "Who's cuter, me or her?",
  "zq14a20": "Doing the books,",
  "zq14a21": "you glow.",
  "zq14a22": "Xiaotang: plus one.",
  "zq14a23": "Screen's done.",
  "zq14a24": "The magistrate",
  "zq14a25": "really wants this?",
  "zq14a26": "No,",
  "zq14a27": "I lied to you.",
  "zq14a28": "Scholars,",
  "zq14a29": "all the same!",
  "zq14a30": "The bonus is real,",
  "zq14a31": "the plan's mine.",
  "zq14a32": "An honest scholar—",
  "zq14a33": "that's a first.",
  "zq14a34": "Who are you?",
  "zq14a35": "Someone from very far away.",
  "zq14a36": "How far?",
  "zq14a37": "So far…",
  "zq14a38": "I can't go back.",
  "zq14a39": "First white sheet:",
  "zq14a40": "complete.",
  "zq14a41": "This paper…",
  "zq14a42": "whiter than the town's.",
  "zq14a43": "Trouble!",
  "zq14a44": "From the booksellers' guild!",
  "zq14a45": "Liuxi white paper:",
  "zq14a46": "banned from every shop in town!"
}
