{
  "zq14a01": "つけてきたの？",
  "zq14a02": "子の刻を過ぎた、",
  "zq14a03": "真実罰、発動。",
  "zq14a04": "君が心配で。",
  "zq14a05": "一人で林に、",
  "zq14a06": "心配だ。",
  "zq14a07": "次つけるなら、",
  "zq14a08": "足音消して。",
  "zq14a09": "チン・シュアン、",
  "zq14a10": "プラス五。",
  "zq14a11": "兄弟！",
  "zq14a12": "竹が糊に！",
  "zq14a13": "十日が残り七日、",
  "zq14a14": "昨夜どこ行ってた？",
  "zq14a15": "シュアンと、",
  "zq14a16": "墓場へ。",
  "zq14a17": "は……墓場？",
  "zq14a18": {
    "text": "斬られてないの？",
    "say": "首は？"
  },
  "zq14a19": "私と彼女、どっちが綺麗？",
  "zq14a20": "算盤の君が",
  "zq14a21": "一番綺麗。",
  "zq14a22": "シャオタン、プラス一。",
  "zq14a23": "簾ができた。",
  "zq14a24": "お上が、",
  "zq14a25": "本当にか？",
  "zq14a26": "いや、",
  "zq14a27": "嘘をついた。",
  "zq14a28": "秀才は、",
  "zq14a29": "皆同じだ！",
  "zq14a30": "配当は本物",
  "zq14a31": "図も俺が描いた。",
  "zq14a32": "正直な秀才なんぞ、",
  "zq14a33": "初めて見た。",
  "zq14a34": "何者なの？",
  "zq14a35": "遠い所から来た。",
  "zq14a36": "遠い？",
  "zq14a37": "遠くて……",
  "zq14a38": "帰れない。",
  "zq14a39": "最初の白紙、",
  "zq14a40": "完成。",
  "zq14a41": "この紙は……",
  "zq14a42": "町のより白い。",
  "zq14a43": "大変！",
  "zq14a44": "書坊組合の貼り紙！",
  "zq14a45": "柳渓の紙、",
  "zq14a46": "町では一枚も買わない！"
}
