    { "id": "marker-trap", "template": "chat", "data": { "title": "腳註標記不能共用一切", "messages": [ { "side": "left", "name": "示意段落", "text": "引用有助查核；所以不用再查了。〔一〕" }, { "side": "right", "name": "你的檢查", "text": "〔一〕只支持前半句嗎？" } ] }, "lines": [
