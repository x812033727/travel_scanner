    { "id": "open-link", "chapter": "第一步：真的打開連結", "template": "steps", "data": { "title": "不要只看來源清單", "steps": [ { "title": "按開連結", "detail": "確認能讀到內容" }, { "title": "核對網站", "detail": "看域名與頁面標題" }, { "title": "找到原文", "detail": "不要只停在搜尋摘要" } ] }, "lines": [
