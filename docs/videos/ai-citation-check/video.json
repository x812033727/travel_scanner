  "scenes": [
    { "id": "hook", "chapter": "有連結，還是要核對", "template": "title", "data": { "tag": "一則示意回答當場拆解", "title": "有連結，還是要核對", "subtitle": "三步抓出說反的引用" }, "lines": [
      { "id": "ci001", "text": "這個回答附了官方連結，結論卻說反了。" },
      { "id": "ci002", "text": "只看連結有沒有，你可能會把錯誤轉出去。" },
