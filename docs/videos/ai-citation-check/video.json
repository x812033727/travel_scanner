    { "id": "mock-purpose", "template": "bullets", "data": { "title": "為什麼用示意回答", "items": ["錯句是編輯刻意寫的", "連結是實際可開的官方頁", "不暗示某產品真的犯過這個錯"] }, "lines": [
      { "id": "ci076", "text": "我們用示意，是為了讓你清楚看到錯在哪裡。" },
