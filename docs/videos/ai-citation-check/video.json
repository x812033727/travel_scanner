    { "id": "redirect-check", "template": "steps", "data": { "title": "開啟後再看兩個地方", "steps": [ { "title": "最終網址", "detail": "可能已跳到其他頁" }, { "title": "頁面標題", "detail": "是否仍是那份文件" }, { "title": "內文", "detail": "是否真的能讀到" } ] }, "lines": [
      { "id": "ci120", "text": "有些連結會跳轉到網站首頁或新版說明。" },
