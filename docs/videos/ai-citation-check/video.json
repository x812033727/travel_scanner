    { "id": "mock-answer", "chapter": "一則刻意寫錯的回答", "template": "chat", "data": { "title": "教學示意：刻意寫錯的回答", "messages": [ { "side": "right", "name": "提問", "text": "人工智慧附引用，還要查嗎？" }, { "side": "left", "name": "錯誤示意", "text": "官方說附引用就不必人工查核。" } ] }, "lines": [
