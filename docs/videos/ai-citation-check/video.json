    { "id": "link-vs-proof", "template": "compare", "data": { "title": "第一步只證明一件事", "left": { "heading": "已確認", "points": ["連結可開", "是原始官方頁"] }, "right": { "heading": "還沒確認", "points": ["錯句有沒有被支持", "是否省略限制"] }, "verdict": "繼續對原文" }, "lines": [
