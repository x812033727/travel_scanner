      { "id": "ci082", "text": "所以查核不是挑一個看起來可信的網址。" },
      { "id": "ci083", "text": "是要把特定主張，對到特定的原文。" }
    ] },
    { "id": "three-questions", "template": "steps", "data": { "title": "先記住三個問題", "steps": [ { "title": "連結", "detail": "真的通往原始來源嗎" }, { "title": "原文", "detail": "支持哪一個主張" }, { "title": "上下文", "detail": "有條件或時間差嗎" } ] }, "lines": [
      { "id": "ci012", "text": "三步查法只有三個問題。" },
