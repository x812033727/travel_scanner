    },
    "89abca81": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "672324c7": {
      "text": "正確答案是 C。二十分鐘後。",
      "source_hash": "90dbbd345405"
    },
    "e2eb9f1d": {
      "text": "對話中提到要搭幾站接駁車？",
      "source_hash": "44d6e63aaef1"
    },
    "88f67069": {
      "text": "A. 四站",
      "source_hash": "63ea1bb2aff5"
    },
    "afab58a1": {
      "text": "C. 三站",
      "source_hash": "cbadf35aad1c"
    },
    "3b1e50d2": {
      "text": "到衛星航廈要搭幾站？",
      "source_hash": "a6c49482296e"
    },
    "3ec9fd39": {
      "text": "只要一站。下車後請查看標誌。",
      "source_hash": "2163214f9316"
    },
    "6d0d3bf4": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "ce85becf": {
      "text": "正確答案是 B。一站。",
      "source_hash": "99e579830e5d"
    },
    "cea1f48f": {
      "text": "最後用自然語速重聽兩段對話。想挑戰自己，可以關掉翻譯字幕，專心聽聲音。",
