  "lines": {
    "98427211": {
      "text": "好的。這是我的會議確認文件和住宿資料。",
      "source_hash": "71f543ffa843"
    },
    "be6f24c9": {
      "text": "查驗人員問你入境目的時，你能用一句話說清楚嗎？",
      "source_hash": "33f3088673fa"
    },
    "9c00bc80": {
      "text": "練習聽出旅行目的，以及預計停留多久。",
      "source_hash": "302504d5b9d8"
    },
    "92d6ea7a": {
      "text": "先聽第一段對話，留意雙方需要確認什麼。",
      "source_hash": "352e3421406a"
    },
    "5f6411d1": {
      "text": "午安。您這次來的目的是什麼？",
      "source_hash": "c86d6447b511"
    },
    "def1d871": {
      "text": "我是來觀光的。我打算參觀博物館，也跟朋友相聚幾天。",
      "source_hash": "3ac71f1d84fe"
    },
    "272f08d6": {
      "text": "您預計在這個國家停留多久？",
      "source_hash": "16daadd55969"
    },
    "bc4b9c7a": {
      "text": "十天。我已經訂了十八日的回程機票。",
      "source_hash": "1d597ff25622"
    },
    "ae5e75cd": {
      "text": "您是自己旅行，還是有人同行？",
      "source_hash": "46112ec31317"
    },
    "3d6f3a4a": {
      "text": "我跟姊妹一起旅行，她就在我後面等。",
      "source_hash": "1e06295a917d"
    },
    "a072aba2": {
      "text": "再聽一次，把每個回答和前面的問題連起來。",
      "source_hash": "39c8ae003342"
    },
    "ab2ca6cb": {
      "text": "午安。您這次來的目的是什麼？",
      "source_hash": "c86d6447b511"
    },
    "93f10800": {
      "text": "我是來觀光的。我打算參觀博物館，也跟朋友相聚幾天。",
      "source_hash": "3ac71f1d84fe"
    },
    "c4d7fc94": {
      "text": "您預計在這個國家停留多久？",
      "source_hash": "16daadd55969"
    },
    "7a597009": {
      "text": "十天。我已經訂了十八日的回程機票。",
      "source_hash": "1d597ff25622"
    },
    "d48288cd": {
      "text": "您是自己旅行，還是有人同行？",
      "source_hash": "46112ec31317"
    },
    "ec7441a8": {
      "text": "我跟姊妹一起旅行，她就在我後面等。",
      "source_hash": "1e06295a917d"
    },
    "8e96af1c": {
      "text": "現在逐段台詞練習。先聽，再開口跟讀。需要更多時間時，請暫停影片。",
      "source_hash": "9ed3ca978b19"
    },
    "bef9dc95": {
      "text": "午安。您這次來的目的是什麼？",
      "source_hash": "c86d6447b511"
    },
    "e87beadd": {
      "text": "我是來觀光的。我打算參觀博物館，也跟朋友相聚幾天。",
      "source_hash": "3ac71f1d84fe"
    },
    "2b7b94d8": {
      "text": "您預計在這個國家停留多久？",
      "source_hash": "16daadd55969"
    },
    "64eeb38d": {
      "text": "十天。我已經訂了十八日的回程機票。",
      "source_hash": "1d597ff25622"
    },
    "9491ff38": {
      "text": "您是自己旅行，還是有人同行？",
      "source_hash": "46112ec31317"
    },
    "22b571e3": {
      "text": "我跟姊妹一起旅行，她就在我後面等。",
      "source_hash": "1e06295a917d"
    },
    "d446a912": {
      "text": "換一個情境，不要假設答案相同。請聽出改變了哪些資訊。",
      "source_hash": "17ed4f02eb84"
    },
    "38368c3e": {
      "text": "您這趟來是為了什麼？",
      "source_hash": "c24acda44000"
    },
    "994be2aa": {
      "text": "我是來參加商務會議的。我帶了邀請函和活動詳細資料。",
      "source_hash": "883161a6bc80"
    },
    "da2f6b6b": {
      "text": "停留期間，您還會從事其他活動嗎？",
      "source_hash": "cc672110eb86"
    },
    "0ff37275": {
      "text": "會議結束後，我也會去觀光。",
      "source_hash": "2b47d18b352d"
    },
    "2630bb28": {
      "text": "請出示能佐證您訪問目的的資料。",
      "source_hash": "63df6aca2e2b"
    },
    "05cc97b0": {
      "text": "好的。這是我的會議確認文件和住宿資料。",
      "source_hash": "71f543ffa843"
    },
    "d8a59797": {
      "text": "再聽一次，把每個回答和前面的問題連起來。",
      "source_hash": "39c8ae003342"
    },
    "387a24ed": {
      "text": "您這趟來是為了什麼？",
      "source_hash": "c24acda44000"
    },
    "40a6c3ed": {
      "text": "我是來參加商務會議的。我帶了邀請函和活動詳細資料。",
      "source_hash": "883161a6bc80"
    },
    "dc63bc44": {
      "text": "停留期間，您還會從事其他活動嗎？",
      "source_hash": "cc672110eb86"
    },
    "cb050b0f": {
      "text": "會議結束後，我也會去觀光。",
      "source_hash": "2b47d18b352d"
    },
    "3702f16f": {
      "text": "請出示能佐證您訪問目的的資料。",
      "source_hash": "63df6aca2e2b"
    },
    "9b0d4799": {
      "text": "好的。這是我的會議確認文件和住宿資料。",
      "source_hash": "71f543ffa843"
    },
    "166ad490": {
      "text": "和第一段對話比較改變的細節，再開口跟讀。需要更多時間時，請暫停影片。",
      "source_hash": "635e32d7292c"
    },
    "3fa6003e": {
      "text": "您這趟來是為了什麼？",
      "source_hash": "c24acda44000"
    },
    "87f7ca11": {
      "text": "我是來參加商務會議的。我帶了邀請函和活動詳細資料。",
      "source_hash": "883161a6bc80"
    },
    "b2def221": {
      "text": "停留期間，您還會從事其他活動嗎？",
      "source_hash": "cc672110eb86"
    },
    "8ac5191d": {
      "text": "會議結束後，我也會去觀光。",
      "source_hash": "2b47d18b352d"
    },
    "fafc5af0": {
      "text": "請出示能佐證您訪問目的的資料。",
      "source_hash": "63df6aca2e2b"
    },
    "fa9b8ef0": {
      "text": "好的。這是我的會議確認文件和住宿資料。",
      "source_hash": "71f543ffa843"
    },
    "aa4cd3ce": {
      "text": "接下來有三題聽力測驗。聽相關對話，在解答前選出答案。",
      "source_hash": "93538b29bd11"
    },
    "37ba360b": {
      "text": "第一位旅客的旅行目的是什麼？",
      "source_hash": "da81ed0a5175"
    },
    "99a0fde8": {
      "text": "A. 開始一份新工作",
      "source_hash": "b6aba73d8d6e"
    },
    "c5667030": {
      "text": "B. 觀光",
      "source_hash": "72e62b167aec"
    },
    "cf430c78": {
      "text": "C. 求學",
      "source_hash": "350c977aefd3"
    },
    "23b9bd79": {
      "text": "午安。您這次來的目的是什麼？",
      "source_hash": "c86d6447b511"
    },
    "d82fcd7a": {
      "text": "我是來觀光的。我打算參觀博物館，也跟朋友相聚幾天。",
      "source_hash": "3ac71f1d84fe"
    },
    "be1c464c": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "6e4f930c": {
      "text": "正確答案是B。觀光。",
      "source_hash": "f00c1da8576e"
    },
    "4c17b7c0": {
      "text": "第一位旅客要停留多久？",
      "source_hash": "c814e3e6904a"
    },
    "5710d581": {
      "text": "A. 十天",
      "source_hash": "e653c59cc564"
    },
    "36d72015": {
      "text": "B. 十八個月",
      "source_hash": "6c88aa6eb4b4"
    },
    "f8e1b150": {
      "text": "C. 三天",
      "source_hash": "5e7b3630ef86"
    },
    "066800c4": {
      "text": "您預計在這個國家停留多久？",
      "source_hash": "16daadd55969"
    },
    "86a29c88": {
      "text": "十天。我已經訂了十八日的回程機票。",
      "source_hash": "1d597ff25622"
    },
    "f89b6e5c": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "3db4e057": {
      "text": "正確答案是A。十天。",
      "source_hash": "b020eb591045"
    },
    "014227ec": {
      "text": "第二位旅客要參加什麼活動？",
      "source_hash": "c6f4870b9451"
    },
    "4d402dbd": {
      "text": "A. 運動營",
      "source_hash": "36dd433442b9"
    },
    "b517a3be": {
      "text": "B. 婚禮",
      "source_hash": "3fd0f7e281e6"
    },
    "163485f2": {
      "text": "C. 商務會議",
      "source_hash": "b274caac7d20"
    },
    "910f273f": {
      "text": "您這趟來是為了什麼？",
      "source_hash": "c24acda44000"
    },
    "98bdef3a": {
      "text": "我是來參加商務會議的。我帶了邀請函和活動詳細資料。",
      "source_hash": "883161a6bc80"
    },
    "0405d84b": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "f5acfad6": {
      "text": "正確答案是C。商務會議。",
      "source_hash": "465eccf9b3ca"
    },
    "ddbefb81": {
      "text": "最後用自然語速重聽兩段對話。想挑戰自己，可以關掉翻譯字幕，專心聽聲音。",
      "source_hash": "ad5abc8a3fad"
    },
    "2c56b5f4": {
      "text": "午安。您這次來的目的是什麼？",
      "source_hash": "c86d6447b511"
    },
    "de00bea1": {
      "text": "我是來觀光的。我打算參觀博物館，也跟朋友相聚幾天。",
      "source_hash": "3ac71f1d84fe"
    },
