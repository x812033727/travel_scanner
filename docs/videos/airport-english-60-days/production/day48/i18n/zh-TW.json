    "05ba7ffa": {
      "text": "接下來有三題聽力測驗。聽相關對話，在解答前選出答案。",
      "source_hash": "93538b29bd11"
    },
    "4dfc456b": {
      "text": "一開始在Harbor Hotel訂了幾晚？",
      "source_hash": "8d022299729c"
    },
    "c53e3be2": {
      "text": "A. 四晚",
      "source_hash": "63ea1bb2aff5"
    },
    "879aeb93": {
      "text": "B. 十二晚",
      "source_hash": "dd1f227f920d"
    },
    "005d6f66": {
      "text": "C. 一晚",
      "source_hash": "e88f51864a56"
    },
    "64d25adf": {
      "text": "您這次來訪期間會住在哪裡？",
      "source_hash": "5a3a29605696"
    },
    "23ecceb8": {
      "text": "前四晚住在Harbor Hotel，之後住朋友家。",
      "source_hash": "12a1f68c391f"
    },
    "35b20924": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "479a4f51": {
      "text": "正確答案是A。四晚。",
      "source_hash": "62b054259c5f"
    },
    "b167833f": {
      "text": "第一位旅客總共停留多久？",
      "source_hash": "8ab0653abf9b"
    },
    "1697f8d1": {
      "text": "A. 四個月",
      "source_hash": "be5278a49ba8"
    },
    "4df50640": {
      "text": "B. 七天",
      "source_hash": "3820796a7de4"
    },
    "3cfb5487": {
      "text": "C. 十二天",
      "source_hash": "924cad471d84"
    },
    "18be2cf5": {
      "text": "您預計總共停留多久？",
      "source_hash": "f8faff8ec923"
    },
    "7bceefff": {
      "text": "十二天。如果需要，我可以出示剩下的行程。",
      "source_hash": "23e2c5afc62f"
    },
    "62dcd494": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "2136faa4": {
      "text": "正確答案是C。十二天。",
      "source_hash": "b8bb5e7617e9"
    },
    "54a18c06": {
      "text": "第二位旅客如何分配這一週的住宿？",
      "source_hash": "65d416579e49"
    },
    "522b624d": {
      "text": "A. 首都四晚，海岸邊三晚",
      "source_hash": "2dc2a5e8f100"
    },
    "1e8cff1b": {
      "text": "B. 首都三晚，海岸邊四晚",
      "source_hash": "6a42bea2b058"
    },
    "f5fa6048": {
      "text": "C. 七晚都在首都",
      "source_hash": "964ef0c21c84"
    },
    "63fc4406": {
      "text": "您整趟行程都會待在同一個城市嗎？",
      "source_hash": "c02ad4ee32fa"
    },
    "328e05a4": {
      "text": "不會。我會在首都住三晚，在海岸附近住四晚。",
      "source_hash": "da6489c85392"
    },
    "ed014e3d": {
      "text": "現在選出你的答案。",
      "source_hash": "a5652ce999fa"
    },
    "217118f6": {
      "text": "正確答案是B。首都三晚，海岸邊四晚。",
      "source_hash": "90f9c8106ff6"
    },
    "c043fb04": {
      "text": "最後用自然語速重聽兩段對話。想挑戰自己，可以關掉翻譯字幕，專心聽聲音。",
      "source_hash": "ad5abc8a3fad"
    },
