{
  "zq10a01": {
    "text": "Ada obor di jalan,",
    "say": "Ada obor,"
  },
  "zq10a02": "menuju desa.",
  "zq10a03": "Berapa orang?",
  "zq10a04": "Tiga puluhan,",
  "zq10a05": "petugas dan anak buah.",
  "zq10a06": {
    "text": "Tiga puluh orang, lima belas menit.",
    "say": "Tiga puluh, lima belas menit."
  },
  "zq10a07": "Tongkat doang,",
  "zq10a08": "lawan tiga puluh?",
  "zq10a09": "Tiga puluh lawan lima,",
  "zq10a10": "dihitung gimana pun kalah.",
  "zq10a11": "Dua belas obor di depan,",
  "zq10a12": "baris dua lajur.",
  "zq10a13": "Belakangnya anak buah,",
  "zq10a14": "gampang kabur.",
  "zq10a15": "Kamu paham formasi?",
  "zq10a16": "Pernah perang?",
  "zq10a17": "Pernah lihat.",
  "zq10a18": "Petugas takkan duluan.",
  "zq10a19": "Kak Xu!",
  "zq10a20": {
    "text": "Delapan orang desa datang!",
    "say": "Delapan orang!"
  },
  "zq10a21": {
    "text": "Erniu, delapan orangmu,",
    "say": "Erniu,"
  },
  "zq10a22": "jongkok di pagar.",
  "zq10a23": "Tongkat naik,",
  "zq10a24": "jangan pukul duluan.",
  "zq10a25": "Beberapa menit, udah siap?",
  "zq10a26": "Dia ini siapa, sih?",
  "zq10a27": "A-Ling mana?",
  "zq10a28": "Misi: tahan A-Ling.",
  "zq10a29": "Ke mana?",
  "zq10a30": "Ini rumahmu,",
  "zq10a31": {
    "text": "Mereka datang menangkapku.",
    "say": "Mereka cari aku."
  },
  "zq10a32": "Jangan pergi.",
  "zq10a33": "Sendirian, bisa lolos?",
  "zq10a34": {
    "text": "Kak ipar, jangan pergi!",
    "say": "Jangan, Kak!"
  },
  "zq10a35": "Jangan tinggalin Xiaohe!",
  "zq10a36": "Baik, aku tetap.",
  "zq10a37": "Poin suka, plus empat.",
  "zq10a38": "Itu… Tuan Qian?",
  "zq10a39": "Dia di dalam,",
  "zq10a40": "Terima kasih, Tuan.",
  "zq10a41": "Saya paham betul,",
  "zq10a42": "Malam ini.",
  "zq10a43": "Minimal lima puluh tael.",
  "zq10a44": {
    "text": "Keluarga Xu menyembunyikan buronan kerajaan!",
    "say": "Keluarga Xu sembunyikan buronan!"
  },
  "zq10a45": "Kepung mereka!",
  "zq10a46": "Tengah malam begini,",
  "zq10a47": "Tuan cari siapa?",
  "zq10a48": "Tangkap perempuan pendiam itu!",
  "zq10a49": {
    "text": "Kawan-kawan,",
    "say": "Ayo,"
  },
  "zq10a50": "Tangkap!"
}
