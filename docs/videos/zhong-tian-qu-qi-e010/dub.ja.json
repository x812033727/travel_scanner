{
  "zq10a01": "道に松明、",
  "zq10a02": "村に来る。",
  "zq10a03": "何人？",
  "zq10a04": "三十ほど、",
  "zq10a05": "役人も手下も。",
  "zq10a06": "三十人、十五分で到着。",
  "zq10a07": "この棒だけで、",
  "zq10a08": "三十人？",
  "zq10a09": "三十対五、",
  "zq10a10": "どう見ても無理。",
  "zq10a11": "前の十二本、",
  "zq10a12": "二列で進んでる。",
  "zq10a13": "後ろは手下、",
  "zq10a14": "殴れば逃げる。",
  "zq10a15": "隊形まで？",
  "zq10a16": "戦に出た？",
  "zq10a17": "見ただけ。",
  "zq10a18": "役人は動けない。",
  "zq10a19": "兄貴！",
  "zq10a20": "八人来たぞ！",
  "zq10a21": "アーニウ、八人で、",
  "zq10a22": "垣根に伏せて。",
  "zq10a23": "棒を掲げて、",
  "zq10a24": "先に打つな。",
  "zq10a25": "もう布陣？",
  "zq10a26": "何者なの？",
  "zq10a27": "アーリン？",
  "zq10a28": "任務：アーリンを留めよ。",
  "zq10a29": "どこへ？",
  "zq10a30": "君の家だ。",
  "zq10a31": "狙いは私。",
  "zq10a32": "なおさらだ。",
  "zq10a33": "一人で逃げ切れるか？",
  "zq10a34": "お姉ちゃん行かないで！",
  "zq10a35": "行っちゃやだ！",
  "zq10a36": "うん、行かない。",
  "zq10a37": "好感度、プラス四。",
  "zq10a38": "あれは……チエン旦那？",
  "zq10a39": "中です、",
  "zq10a40": "ご苦労様です。",
  "zq10a41": "本官、心得ておる。",
  "zq10a42": "今夜だ。",
  "zq10a43": "最低五十両。",
  "zq10a44": "シュー家、罪人を匿うとは！",
  "zq10a45": "囲め！",
  "zq10a46": "夜更けに、",
  "zq10a47": "誰を？",
  "zq10a48": "そこの黙った女を捕らえよ！",
  "zq10a49": "皆、",
  "zq10a50": "かかれ！"
}
