{
  "zq10a01": "Có đuốc trên đường,",
  "zq10a02": "đang vào thôn.",
  "zq10a03": "Mấy người?",
  "zq10a04": "Chừng ba mươi,",
  "zq10a05": "cả nha dịch lẫn gia đinh.",
  "zq10a06": "Ba mươi người, một khắc tới.",
  "zq10a07": "Chỉ mấy cây gậy này,",
  "zq10a08": "cản ba mươi người?",
  "zq10a09": "Ba mươi đấu năm,",
  "zq10a10": "tính kiểu gì cũng thua.",
  "zq10a11": "Phía trước mười hai đuốc,",
  "zq10a12": "đi thành hai hàng.",
  "zq10a13": "Phía sau lộn xộn là gia đinh,",
  "zq10a14": "đánh là chạy.",
  "zq10a15": "Nhìn ra cả đội hình?",
  "zq10a16": "Từng ra trận?",
  "zq10a17": "Từng thấy.",
  "zq10a18": "Nha dịch không dám ra tay trước.",
  "zq10a19": "Hứa huynh đệ!",
  "zq10a20": "Tám người tới rồi!",
  "zq10a21": "Nhị Ngưu, tám người,",
  "zq10a22": "nấp sau hàng rào.",
  "zq10a23": "Giơ gậy cao,",
  "zq10a24": "cấm ai đánh trước.",
  "zq10a25": "Nửa khắc, xếp xong rồi?",
  "zq10a26": "Nàng ta là ai vậy?",
  "zq10a27": "A Lệnh đâu?",
  "zq10a28": "Nhiệm vụ: giữ chân A Lệnh.",
  "zq10a29": "Đi đâu?",
  "zq10a30": "Đây là nhà nàng.",
  "zq10a31": "Họ đến bắt ta.",
  "zq10a32": "Vậy càng không được đi.",
  "zq10a33": "Một mình, đi nổi sao?",
  "zq10a34": "Tẩu tẩu đừng đi!",
  "zq10a35": "Tiểu Hòa không cho tẩu đi!",
  "zq10a36": "Được, không đi.",
  "zq10a37": "Hảo cảm cộng bốn.",
  "zq10a38": "Kia là… Tiền viên ngoại?",
  "zq10a39": "Người ở ngay trong đó,",
  "zq10a40": "đại nhân vất vả rồi.",
  "zq10a41": "Bổn quan trong lòng đã rõ,",
  "zq10a42": "đêm nay xử.",
  "zq10a43": "Ít nhất năm mươi lượng.",
  "zq10a44": "Nhà họ Hứa chứa chấp khâm phạm,",
  "zq10a45": "bao vây cho ta!",
  "zq10a46": "Nửa đêm canh ba,",
  "zq10a47": "đại nhân tìm ai?",
  "zq10a48": "Bắt người đàn bà không nói kia!",
  "zq10a49": "Các huynh đệ,",
  "zq10a50": "bắt người!"
}
