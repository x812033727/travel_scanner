{
  "zq10a01": {
    "text": "Antorchas en el camino,",
    "say": "Antorchas,"
  },
  "zq10a02": "vienen al pueblo.",
  "zq10a03": "¿Cuántos?",
  "zq10a04": "Unos treinta,",
  "zq10a05": "guardias y matones.",
  "zq10a06": {
    "text": "Treinta hombres; llegan en un cuarto de hora.",
    "say": "Treinta: cuarto de hora."
  },
  "zq10a07": {
    "text": "¿Con estos palitos",
    "say": "¿Con palos"
  },
  "zq10a08": "contra treinta?",
  "zq10a09": "Treinta contra cinco,",
  "zq10a10": "perdemos sí o sí.",
  "zq10a11": "Doce al frente,",
  "zq10a12": "en dos filas.",
  "zq10a13": "Atrás van los matones,",
  "zq10a14": "esos huyen.",
  "zq10a15": "¿Formaciones?",
  "zq10a16": {
    "text": "¿Estuviste en una guerra?",
    "say": "¿Guerra?"
  },
  "zq10a17": "La vi.",
  "zq10a18": "No pegarán primero.",
  "zq10a19": "¡Xu!",
  "zq10a20": {
    "text": "¡Vinieron ocho del pueblo!",
    "say": "¡Llegaron ocho!"
  },
  "zq10a21": {
    "text": "Erniu, tus ocho,",
    "say": "Tus ocho,"
  },
  "zq10a22": "tras la cerca.",
  "zq10a23": "Palos arriba,",
  "zq10a24": "nadie pega primero.",
  "zq10a25": "¿Listos en minutos?",
  "zq10a26": "¿Quién es ella?",
  "zq10a27": "¿Y A-Ling?",
  "zq10a28": "Misión: retener a A-Ling.",
  "zq10a29": "¿Adónde?",
  "zq10a30": "Es tu casa.",
  "zq10a31": "Vienen por mí.",
  "zq10a32": "No te vas.",
  "zq10a33": "¿Sola, hasta dónde llegarías?",
  "zq10a34": "¡Cuñada, no te vayas!",
  "zq10a35": "¡Por favor, quédate!",
  "zq10a36": "Bien. Me quedo.",
  "zq10a37": "Afecto: más cuatro.",
  "zq10a38": "¿Ese es… don Qian?",
  "zq10a39": "Está adentro,",
  "zq10a40": "gracias, Su Señoría.",
  "zq10a41": "Sé muy bien qué hacer,",
  "zq10a42": "esta noche.",
  "zq10a43": "Mínimo cincuenta.",
  "zq10a44": "¡Los Xu esconden a una prófuga!",
  "zq10a45": "¡Rodéenlos!",
  "zq10a46": "A medianoche,",
  "zq10a47": "¿a quién busca?",
  "zq10a48": "¡Atrapen a la mujer que no habla!",
  "zq10a49": {
    "text": "¡Muchachos!",
    "say": "¡Ya!"
  },
  "zq10a50": "¡Atrápenla!"
}
