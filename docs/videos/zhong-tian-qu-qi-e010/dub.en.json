{
  "zq10a01": "Torches on the road,",
  "zq10a02": "headed this way.",
  "zq10a03": "How many?",
  "zq10a04": "Thirty or so,",
  "zq10a05": "constables and thugs.",
  "zq10a06": "Thirty men, fifteen minutes out.",
  "zq10a07": "Just these sticks,",
  "zq10a08": "against thirty?",
  "zq10a09": "Thirty against five,",
  "zq10a10": "we lose any way you count it.",
  "zq10a11": "Twelve torches in front,",
  "zq10a12": "marching in two lines.",
  "zq10a13": "The stragglers are house thugs,",
  "zq10a14": "they'll scatter.",
  "zq10a15": "Formations?",
  "zq10a16": "Fought in a war?",
  "zq10a17": "Seen one.",
  "zq10a18": "Constables won't strike first.",
  "zq10a19": "Hey, Xu!",
  "zq10a20": "Eight from the village!",
  "zq10a21": "Erniu, your eight men,",
  "zq10a22": "behind the fence.",
  "zq10a23": "Sticks up high,",
  "zq10a24": "nobody hits first.",
  "zq10a25": "All set in minutes?",
  "zq10a26": "Who is she?",
  "zq10a27": "A-Ling?",
  "zq10a28": "Mission: keep A-Ling.",
  "zq10a29": "Where to?",
  "zq10a30": "This is your home.",
  "zq10a31": "They've come for me.",
  "zq10a32": "Then you can't go.",
  "zq10a33": "Alone? How far would you get?",
  "zq10a34": "Sister, don't go!",
  "zq10a35": "Please don't leave!",
  "zq10a36": "Fine. I'll stay.",
  "zq10a37": "Affection: plus four.",
  "zq10a38": "Is that… Squire Qian?",
  "zq10a39": "She's right in there,",
  "zq10a40": "thank you, Your Honor.",
  "zq10a41": "I know exactly what to do.",
  "zq10a42": "Tonight.",
  "zq10a43": "Fifty taels at least.",
  "zq10a44": "The Xus are hiding a fugitive!",
  "zq10a45": "Surround them!",
  "zq10a46": "In the dead of night,",
  "zq10a47": "who are you after?",
  "zq10a48": "Seize the silent woman!",
  "zq10a49": "Men,",
  "zq10a50": "take her!"
}
