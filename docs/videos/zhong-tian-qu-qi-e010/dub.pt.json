{
  "zq10a01": {
    "text": "Tochas na estrada,",
    "say": "Tem tochas,"
  },
  "zq10a02": "vindo pra vila.",
  "zq10a03": "Quantos?",
  "zq10a04": "Uns trinta,",
  "zq10a05": "guardas e capangas.",
  "zq10a06": {
    "text": "Trinta homens, chegam em quinze minutos.",
    "say": "Trinta homens. Quinze minutos."
  },
  "zq10a07": "Só com esses paus,",
  "zq10a08": "contra trinta?",
  "zq10a09": "Trinta contra cinco,",
  "zq10a10": "de todo jeito, perde.",
  "zq10a11": "Doze tochas na frente,",
  "zq10a12": "em duas fileiras.",
  "zq10a13": "Atrás, capangas,",
  "zq10a14": "fogem fácil.",
  "zq10a15": {
    "text": "Você reconhece a formação?",
    "say": "Formação?"
  },
  "zq10a16": "Já lutou?",
  "zq10a17": "Já vi.",
  "zq10a18": "Guarda não começa.",
  "zq10a19": {
    "text": "Xu, meu irmão!",
    "say": "Ei, Xu!"
  },
  "zq10a20": {
    "text": "Oito da vila, tão todos aqui!",
    "say": "Oito da vila!"
  },
  "zq10a21": "Erniu, seus oito,",
  "zq10a22": "atrás da cerca.",
  "zq10a23": "Paus no alto,",
  "zq10a24": "ninguém bate antes.",
  "zq10a25": "Tudo pronto já?",
  "zq10a26": "Quem é ela?",
  "zq10a27": "E a A-Ling?",
  "zq10a28": "Missão: segurar A-Ling.",
  "zq10a29": "Aonde?",
  "zq10a30": "É sua casa.",
  "zq10a31": "Vieram por mim.",
  "zq10a32": "Então não vai.",
  "zq10a33": "Sozinha, vai longe?",
  "zq10a34": "Fica, cunhada!",
  "zq10a35": "Não vai embora!",
  "zq10a36": "Tá. Eu fico.",
  "zq10a37": "Afeição: mais quatro.",
  "zq10a38": "Aquele é… o Senhor Qian?",
  "zq10a39": "Tá lá dentro,",
  "zq10a40": "obrigado, Excelência.",
  "zq10a41": "Eu sei bem o que fazer.",
  "zq10a42": "Hoje mesmo.",
  "zq10a43": "Cinquenta taéis, no mínimo.",
  "zq10a44": "Os Xu escondem uma foragida!",
  "zq10a45": "Cerquem!",
  "zq10a46": "No meio da noite,",
  "zq10a47": "quem, senhor?",
  "zq10a48": "Prendam a mulher calada!",
  "zq10a49": "Vamos,",
  "zq10a50": "prendam!"
}
