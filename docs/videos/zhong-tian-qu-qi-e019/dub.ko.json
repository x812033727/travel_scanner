{
  "zq19a01": "날 놔주면,",
  "zq19a02": "누가 널 밀었는지 말하지.",
  "zq19a03": "진실은 내가 캐.",
  "zq19a04": "네—이놈!",
  "zq19a05": "밤새,",
  "zq19a06": "안 지워지죠?",
  "zq19a07": "탈세 고발이 들어왔다,",
  "zq19a08": "인정하느냐?",
  "zq19a09": "나리,",
  "zq19a10": "손부터.",
  "zq19a11": "염색하다 그랬소,",
  "zq19a12": "안 되나?",
  "zq19a13": "라이싼 손도요.",
  "zq19a14": "저, 전 모릅니다…",
  "zq19a15": "말조심해라.",
  "zq19a16": "말 안 하면,",
  "zq19a17": "저자가 널 버려.",
  "zq19a18": "첸 가로 간 상자,",
  "zq19a19": "누가 열었지?",
  "zq19a20": "손목까지 빨간 자.",
  "zq19a21": "증거는?",
  "zq19a22": "왜 나라는 거냐?",
  "zq19a23": "증거, 여기 있어요.",
  "zq19a24": "장부에,",
  "zq19a25": "초이레, 라이싼에게 닷 냥.",
  "zq19a26": "나리,",
  "zq19a27": "이 사람이 찾았죠.",
  "zq19a28": "그래…",
  "zq19a29": "내가 불 지르라 했다.",
  "zq19a30": "첸 씨 방화,",
  "zq19a31": "은 백 냥 배상!",
  "zq19a32": "미션 완료.",
  "zq19a33": "네가 물에 빠진 날,",
  "zq19a34": "네 집안에 물어봐.",
  "zq19a35": "듣지 마.",
  "zq19a36": "진실을 걸었는데,",
  "zq19a37": "안 받았네.",
  "zq19a38": "정의는,",
  "zq19a39": "거래 안 해.",
  "zq19a40": "관아에서,",
  "zq19a41": "나는 뺐네.",
  "zq19a42": "세 사람 호감, 이십 돌파.",
  "zq19a43": "보상: 제당법, 대열 훈련법…",
  "zq19a44": "오리로… 메뚜기를?",
  "zq19a45": "메인 미션, 천하귀심.",
  "zq19a46": "누가 날 데리러 오면,",
  "zq19a47": "보내 줄 거야?"
}
