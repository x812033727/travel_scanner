{
  "zq19a01": "Lepasin aku,",
  "zq19a02": {
    "text": "kukasih tahu siapa yang dorong kau ke sungai.",
    "say": "siapa yang dorong kau."
  },
  "zq19a03": "Kebenarannya aku cari sendiri.",
  "zq19a04": {
    "text": "Kau— kurang ajar!",
    "say": "Kurang ajar!"
  },
  "zq19a05": {
    "text": "Dicuci semalaman,",
    "say": "Cuci semalam,"
  },
  "zq19a06": "nggak hilang, kan?",
  "zq19a07": {
    "text": "Tuan Qian menuduhmu menggelapkan pajak,",
    "say": "Kau dituduh gelapkan pajak,"
  },
  "zq19a08": {
    "text": "kau mengaku tidak?",
    "say": "kau mengaku?"
  },
  "zq19a09": "Tuan,",
  "zq19a10": {
    "text": "lihat tangannya dulu.",
    "say": "lihat tangannya."
  },
  "zq19a11": "Pewarna kain,",
  "zq19a12": {
    "text": "Memangnya nggak boleh?",
    "say": "Kenapa?"
  },
  "zq19a13": {
    "text": "Kalau gitu, Lai San juga ulurkan tangan.",
    "say": "Lai San juga ulurkan."
  },
  "zq19a14": "Ha… hamba nggak tahu…",
  "zq19a15": "Jaga mulutmu.",
  "zq19a16": "Kalau diam,",
  "zq19a17": "dia pun buang kamu.",
  "zq19a18": "Peti masuk rumah Qian,",
  "zq19a19": "siapa buka kuncinya?",
  "zq19a20": {
    "text": "Yang merah sampai pergelangan.",
    "say": "Merah sampai pergelangan."
  },
  "zq19a21": {
    "text": "Buktinya?",
    "say": "Bukti?"
  },
  "zq19a22": "Kenapa harus aku?",
  "zq19a23": "Bukti? Aku punya.",
  "zq19a24": "Buku kas keluarga Qian,",
  "zq19a25": {
    "text": "tanggal tujuh, bayar Lai San lima tael.",
    "say": "tanggal tujuh, Lai San lima tael."
  },
  "zq19a26": "Tuan,",
  "zq19a27": "dia yang bongkar pembukuan ini.",
  "zq19a28": "Iya…",
  "zq19a29": "aku suruh dia bakar.",
  "zq19a30": {
    "text": "Si Qian, pelaku pembakaran,",
    "say": "Si Qian membakar,"
  },
  "zq19a31": "ganti rugi seratus tael!",
  "zq19a32": "Misi selesai.",
  "zq19a33": {
    "text": "Hari kau jatuh ke sungai itu,",
    "say": "Hari kau jatuh,"
  },
  "zq19a34": {
    "text": "tanya saja keluarga Xu-mu.",
    "say": "tanya keluarga Xu."
  },
  "zq19a35": "Jangan dengar dia.",
  "zq19a36": {
    "text": "Dia nawarin kebenaran,",
    "say": "Dia mau tukar,"
  },
  "zq19a37": {
    "text": "kamu nggak mau tukar.",
    "say": "kamu nolak."
  },
  "zq19a38": "Keadilan",
  "zq19a39": "tak dijual.",
  "zq19a40": {
    "text": "Di pengadilan,",
    "say": "Tadi,"
  },
  "zq19a41": {
    "text": "kau tak sebut aku.",
    "say": "aku tak disebut."
  },
  "zq19a42": {
    "text": "Poin suka ketiganya tembus dua puluh.",
    "say": "Ketiganya tembus dua puluh."
  },
  "zq19a43": {
    "text": "Hadiah: teknik membuat gula, teknik baris-berbaris…",
    "say": "Hadiah: teknik gula, baris-berbaris…"
  },
  "zq19a44": {
    "text": "Bebek… basmi belalang?",
    "say": "Pakai bebek?"
  },
  "zq19a45": {
    "text": "Misi utama: rebut hati seluruh negeri.",
    "say": "Misi utama: rebut hati negeri."
  },
  "zq19a46": "Kalau ada yang membawaku pergi,",
  "zq19a47": "kamu bakal biarin?"
}
