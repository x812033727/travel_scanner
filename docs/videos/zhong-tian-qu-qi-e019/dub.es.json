{
  "zq19a01": "Déjame ir,",
  "zq19a02": "y te digo quién te empujó al río.",
  "zq19a03": "La verdad la busco yo.",
  "zq19a04": "¡Atrevido!",
  "zq19a05": "Toda la noche,",
  "zq19a06": "¿y no se le quita?",
  "zq19a07": {
    "text": "Don Qian te acusa de evadir impuestos.",
    "say": "Te acusan de evasión."
  },
  "zq19a08": "¿Lo admites?",
  "zq19a09": "Señor,",
  "zq19a10": "vea sus manos.",
  "zq19a11": "Es de teñir tela,",
  "zq19a12": "¿y qué?",
  "zq19a13": "Que Lai San las muestre.",
  "zq19a14": "Y-yo no sé nada…",
  "zq19a15": "Cuidado con lo que dices.",
  "zq19a16": "Si no hablas,",
  "zq19a17": "él igual te desecha.",
  "zq19a18": "En la mansión Qian,",
  "zq19a19": "¿quién abrió el cofre?",
  "zq19a20": "El de la muñeca roja.",
  "zq19a21": "¿Pruebas?",
  "zq19a22": "¿Por qué iba a ser yo?",
  "zq19a23": "¿Pruebas? Aquí tengo.",
  "zq19a24": {
    "text": "Libro de la mansión Qian:",
    "say": "Libro de los Qian:"
  },
  "zq19a25": "día siete: cinco taeles a Lai San.",
  "zq19a26": "Señor,",
  "zq19a27": "esto lo encontró ella.",
  "zq19a28": "Sí…",
  "zq19a29": "yo le mandé quemarlo.",
  "zq19a30": "¡Qian, culpable de incendio,",
  "zq19a31": "¡paga cien taeles!",
  "zq19a32": "Misión cumplida.",
  "zq19a33": "Cuando caíste al río,",
  "zq19a34": "pregúntale a la familia Xu.",
  "zq19a35": "No le creas.",
  "zq19a36": "La verdad a cambio,",
  "zq19a37": "y dijiste no.",
  "zq19a38": {
    "text": "La justicia",
    "say": "Eso"
  },
  "zq19a39": "no se negocia.",
  "zq19a40": {
    "text": "En el juicio,",
    "say": "Allá,"
  },
  "zq19a41": "no me nombraste.",
  "zq19a42": {
    "text": "Las tres: afecto sobre veinte.",
    "say": "Las tres pasan de veinte."
  },
  "zq19a43": {
    "text": "Recompensa: refinado de azúcar, instrucción militar…",
    "say": "Recompensa: azúcar, instrucción…"
  },
  "zq19a44": "¿Patos contra langostas?",
  "zq19a45": {
    "text": "Misión principal: ganarse el corazón del reino.",
    "say": "Misión principal: el corazón del reino."
  },
  "zq19a46": "Si alguien viniera por mí,",
  "zq19a47": "¿lo dejarías?"
}
