{
  "zq19a01": "Me poupa,",
  "zq19a02": "e eu conto quem te empurrou.",
  "zq19a03": "A verdade, eu acho.",
  "zq19a04": "Insolente!",
  "zq19a05": {
    "text": "Esfregou a noite toda,",
    "say": "Esfregou,"
  },
  "zq19a06": "e não sai, né?",
  "zq19a07": {
    "text": "O Senhor Qian te acusa de sonegar imposto.",
    "say": "Senhor Qian te acusa de sonegar."
  },
  "zq19a08": "Confessa ou não?",
  "zq19a09": "Bem,",
  "zq19a10": {
    "text": "Excelência, olhe as mãos dele.",
    "say": "olhe as mãos."
  },
  "zq19a11": "É de tingir pano,",
  "zq19a12": "e daí?",
  "zq19a13": "Lai San também.",
  "zq19a14": "N-não sei nada…",
  "zq19a15": "Cuidado com a língua.",
  "zq19a16": "Se calar,",
  "zq19a17": "ele te descarta.",
  "zq19a18": "O baú foi pros Qian,",
  "zq19a19": "quem destrancou?",
  "zq19a20": "O da mão vermelha.",
  "zq19a21": "E a prova?",
  "zq19a22": "Por que logo eu?",
  "zq19a23": "Prova? Tenho aqui.",
  "zq19a24": "Contas da casa Qian,",
  "zq19a25": {
    "text": "dia sete: cinco taéis pro Lai San.",
    "say": "dia sete: cinco taéis, Lai San."
  },
  "zq19a26": {
    "text": "Excelência,",
    "say": "Olhe,"
  },
  "zq19a27": "foi ela que achou isso.",
  "zq19a28": "Fui…",
  "zq19a29": "eu mandei queimar.",
  "zq19a30": "Qian, pelo incêndio,",
  "zq19a31": "paga cem taéis!",
  "zq19a32": "Missão cumprida.",
  "zq19a33": {
    "text": "No dia que você caiu no rio,",
    "say": "No dia do rio,"
  },
  "zq19a34": {
    "text": "pergunta pra sua família.",
    "say": "pergunta em casa."
  },
  "zq19a35": {
    "text": "Não liga pra ele.",
    "say": "Não liga."
  },
  "zq19a36": {
    "text": "Ele ofereceu a verdade,",
    "say": "Ele ofereceu,"
  },
  "zq19a37": {
    "text": "você não trocou.",
    "say": "você não quis."
  },
  "zq19a38": {
    "text": "Justiça",
    "say": "Não."
  },
  "zq19a39": "não é moeda.",
  "zq19a40": {
    "text": "No tribunal,",
    "say": "Lá,"
  },
  "zq19a41": "nem me citou.",
  "zq19a42": {
    "text": "Afeição das três: acima de vinte.",
    "say": "As três: mais de vinte."
  },
  "zq19a43": {
    "text": "Recompensas: refino de açúcar, treino de formação…",
    "say": "Prêmios: refino de açúcar, treino…"
  },
  "zq19a44": "Pato… contra gafanhoto?",
  "zq19a45": {
    "text": "Missão principal: o coração do reino.",
    "say": "Missão principal: coração do reino."
  },
  "zq19a46": "Se alguém viesse me levar,",
  "zq19a47": "você deixaria?"
}
