{
  "zq19a01": "見逃してくれ、",
  "zq19a02": "川に落とした奴を教える。",
  "zq19a03": "真相は自分で探す。",
  "zq19a04": "き、貴様！",
  "zq19a05": "一晩中",
  "zq19a06": "落ちないだろ？",
  "zq19a07": "チエンが脱税で訴えておる、",
  "zq19a08": "認めるか？",
  "zq19a09": "閣下、",
  "zq19a10": "奴の手を。",
  "zq19a11": "布を染めたんだ、",
  "zq19a12": "悪いか？",
  "zq19a13": "ライ・サンの手も。",
  "zq19a14": "し、知りません……",
  "zq19a15": "口に気をつけろ。",
  "zq19a16": "黙っても",
  "zq19a17": "奴に消される。",
  "zq19a18": "箱をチエン家で、",
  "zq19a19": "鍵を開けたのは？",
  "zq19a20": "手首まで赤い人。",
  "zq19a21": "証拠は？",
  "zq19a22": "なぜわしだと？",
  "zq19a23": "証拠ならここに。",
  "zq19a24": "チエン家の帳簿、",
  "zq19a25": "七日、ライ・サンに五両。",
  "zq19a26": "殿",
  "zq19a27": "彼女の手柄です。",
  "zq19a28": "そう……",
  "zq19a29": "わしが燃やさせた。",
  "zq19a30": "放火犯チエン",
  "zq19a31": "賠償銀百両！",
  "zq19a32": "任務完了。",
  "zq19a33": "落ちた日のことは、",
  "zq19a34": "シュー家の者に聞け。",
  "zq19a35": "無視して。",
  "zq19a36": "彼は売った",
  "zq19a37": "断ったのね。",
  "zq19a38": "正義",
  "zq19a39": "取引しない。",
  "zq19a40": "あの場で、",
  "zq19a41": "私を伏せた。",
  "zq19a42": {
    "text": "三人の好感度、二十突破。",
    "say": "三人二十突破。"
  },
  "zq19a43": "報酬：製糖法、隊列訓練法……",
  "zq19a44": "アヒルで……蝗退治？",
  "zq19a45": "メイン任務、天下帰心。",
  "zq19a46": "迎えが来たら、",
  "zq19a47": "渡しちゃう？"
}
