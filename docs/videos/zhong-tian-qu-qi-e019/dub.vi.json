{
  "zq19a01": "Tha cho ta,",
  "zq19a02": "ta nói ai đẩy ngươi xuống sông.",
  "zq19a03": "Sự thật, ta tự điều tra.",
  "zq19a04": {
    "text": "Ngươi— càn rỡ!",
    "say": "Ngươi dám!"
  },
  "zq19a05": "Rửa cả đêm,",
  "zq19a06": "không sạch nhỉ?",
  "zq19a07": "Tiền viên ngoại kiện ngươi trốn thuế,",
  "zq19a08": "ngươi có nhận không?",
  "zq19a09": {
    "text": "Đại nhân,",
    "say": "Bẩm,"
  },
  "zq19a10": "xem tay hắn trước.",
  "zq19a11": "Nhuộm vải đấy,",
  "zq19a12": "Thì sao?",
  "zq19a13": "Vậy Lại Tam cũng đưa tay.",
  "zq19a14": "Tiểu nhân… không biết…",
  "zq19a15": "Liệu mà ăn nói.",
  "zq19a16": "Không nói,",
  "zq19a17": "lão cũng sẽ bỏ ngươi.",
  "zq19a18": "Rương vào Tiền phủ,",
  "zq19a19": "ai đã mở khóa?",
  "zq19a20": "Kẻ đỏ tới cổ tay.",
  "zq19a21": {
    "text": "Chứng cứ đâu?",
    "say": "Chứng cứ?"
  },
  "zq19a22": "Sao lại là ta?",
  "zq19a23": "Chứng cứ, ta có đây.",
  "zq19a24": "Sổ sách Tiền phủ,",
  "zq19a25": "mùng bảy, trả Lại Tam năm lượng.",
  "zq19a26": {
    "text": "Đại nhân,",
    "say": "Bẩm!"
  },
  "zq19a27": "sổ này là nàng ấy tra ra.",
  "zq19a28": "Là…",
  "zq19a29": "là ta sai hắn đốt.",
  "zq19a30": "Tiền mỗ phóng hỏa,",
  "zq19a31": "bồi thường một trăm lượng bạc!",
  "zq19a32": "Nhiệm vụ hoàn thành.",
  "zq19a33": {
    "text": "Hôm ngươi rơi xuống sông,",
    "say": "Hôm rơi sông,"
  },
  "zq19a34": "hỏi người nhà ngươi.",
  "zq19a35": "Đừng nghe hắn.",
  "zq19a36": "Hắn đem sự thật đổi,",
  "zq19a37": {
    "text": "ngươi không đổi.",
    "say": "mà không đổi."
  },
  "zq19a38": "Công đạo,",
  "zq19a39": "không đem ra đổi.",
  "zq19a40": {
    "text": "Trên công đường,",
    "say": "Ban nãy,"
  },
  "zq19a41": "ngươi không nhắc ta.",
  "zq19a42": "Hảo cảm cả ba: vượt hai mươi.",
  "zq19a43": {
    "text": "Phần thưởng: cách chế đường, phép thao luyện đội ngũ…",
    "say": "Phần thưởng: chế đường, thao luyện…"
  },
  "zq19a44": "Vịt trị châu chấu?",
  "zq19a45": {
    "text": "Nhiệm vụ chính tuyến: Thiên hạ quy tâm.",
    "say": "Chính tuyến: Thiên hạ quy tâm."
  },
  "zq19a46": "Nếu có người đến đưa ta đi,",
  "zq19a47": "huynh có để ta đi không?"
}
