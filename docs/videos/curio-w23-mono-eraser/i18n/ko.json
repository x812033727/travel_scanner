  "lines": {
    "m001": {
      "source_hash": "bed263c24855",
      "text": "시험장 3색 지우개, 원래는 안 팔았어요."
    },
    "m002": {
      "source_hash": "f59e976bda29",
      "text": "고급 연필 사면 주던 사은품이었죠."
    },
    "m003": {
      "source_hash": "2ac10780db81",
      "text": "보통 사은품은 주인공을 돕는 조연이죠."
    },
    "m004": {
      "source_hash": "f290eea89f43",
      "text": "반세기 뒤엔 일본 시장 절반을 잡았어요."
    },
    "m005": {
      "source_hash": "1d677fc62bd6",
      "text": "승인율 2% 미만의 좁은 문도 뚫었죠."
    },
    "m006": {
      "source_hash": "718e56c8b251",
      "text": "3색으로 일본 1호 색채상표를 땄죠."
    },
    "m007": {
      "source_hash": "66a381937abb",
      "text": "5개월 뒤엔 글자 없는 신제품을 냈죠."
    },
    "m008": {
      "source_hash": "076947b2ee0d",
      "text": "글자 하나 없는데 시험장 필수템이 됐어요."
    },
    "m009": {
      "source_hash": "094b8b49352b",
      "text": "사은품이 어떻게 일본 1호 상표가 됐을까요?"
    },
    "m010": {
      "source_hash": "ce7dcc3c8cd1",
      "text": "역전극은 1950년대 말 시작돼요."
    },
    "m011": {
      "source_hash": "ceabda989268",
      "text": "당시 일본은 수입 천연고무라 비싸고 번졌죠."
    },
    "m012": {
      "source_hash": "8d8a114754cb",
      "text": "1959년 일본이 먼저 PVC 지우개를 냈죠."
    },
    "m013": {
      "source_hash": "e0919d54f90c",
      "text": "익숙한 고무 대신 신소재를 누가 퍼뜨렸죠?"
    },
    "m014": {
      "source_hash": "7e1f18e7266d",
      "text": "주인공은 연필 명가 톰보우였어요."
    },
    "m015": {
      "source_hash": "5565ac4f8428",
      "text": "10년 전부터 심을 갈고 있었죠."
    },
    "m016": {
      "source_hash": "db9178f3b3a8",
      "text": "1949년부터 14년간 흑연·점토를 갈았죠."
    },
    "m017": {
      "source_hash": "f3ac416aa28d",
      "text": "1세제곱밀리에 80억 입자를 채워 넣었죠."
    },
    "m018": {
      "source_hash": "251c3223a8b5",
      "text": "1963년 고급 연필 MONO가 등장했어요."
    },
    "m019": {
      "source_hash": "d983254028e2",
      "text": "진하고 부드러워 설계계서 대박 났죠."
    },
    "m020": {
      "source_hash": "1cd87f9a3929",
      "text": "1967년엔 한 단계 위 MONO100을 냈죠."
    },
    "m021": {
      "source_hash": "aa999359d343",
      "text": "진한 만큼 안 지워질까 걱정이 컸죠."
    },
    "m022": {
      "source_hash": "0e340767d717",
      "text": "그때 한 다스에 한 개씩 끼워 줬죠."
    },
    "m023": {
      "source_hash": "cd11f2ece094",
      "text": "당시 드문 플라스틱 지우개였거든요."
    },
    "m024": {
      "source_hash": "36c652ac1d58",
      "text": "진한 글씨도 잘 지워진단 증거였죠."
    },
    "m025": {
      "source_hash": "e13ff04675c1",
      "text": "막상 지워보니 구매자들 반응이 폭발했어요."
    },
    "m026": {
      "source_hash": "4da814366242",
      "text": "입소문이 퍼져 문구점에 문의가 쏟아졌죠."
    },
    "m027": {
      "source_hash": "0980b66b33cd",
      "text": "연필 말고 지우개만 따로 못 사나요?"
    },
    "m028": {
      "source_hash": "759e73e9ef67",
      "text": "요청이 커지자 회사도 결국 움직였어요."
    },
    "m029": {
      "source_hash": "72c4863927f6",
      "text": "1969년, 사은품이 단독 출시됐어요."
    },
    "m030": {
      "source_hash": "b4ae6e9fb901",
      "text": "출시 직전, 디자인팀이 고민에 빠져요."
    },
    "m031": {
      "source_hash": "4bc4e0709298",
      "text": "몇 센티 지우개가 매대서 눈에 띌까요?"
    },
    "m032": {
      "source_hash": "95f55cb254e0",
      "text": "팀은 삼색기의 강렬한 대비에 착안했죠."
    },
    "m033": {
      "source_hash": "2b945cc9128e",
      "text": "파랑·하양·검정 3등분 띠를 둘렀죠."
    },
    "m034": {
      "source_hash": "c4d07c049335",
      "text": "멀리서도 한눈에 쏙 들어왔거든요."
    },
    "m035": {
      "source_hash": "23f6220b9268",
      "text": "게다가 종이 케이스는 물리 갑옷이죠."
    },
    "m036": {
      "source_hash": "02f0fa19dad2",
      "text": "PVC 가소제가 플라스틱 자에 들러붙거든요."
    },
    "m037": {
      "source_hash": "2ecf35f4d67e",
      "text": "지금도 쓰고 케이스에 넣으라 안내해요."
    },
    "m038": {
      "source_hash": "b7818858ef5a",
      "text": "덕분에 케이스는 못 떼는 간판이 됐어요."
    },
    "m039": {
      "source_hash": "3a87a4749c53",
      "text": "쓸 때마다 3색이 머릿속에 각인된 거죠."
    },
    "m040": {
      "source_hash": "932f07e899ab",
      "text": "더 놀라운 결정은 그 뒤 반세기죠."
    },
    "m041": {
      "source_hash": "a05e7b034f3a",
      "text": "2013년 5대까지 네 번 바꿨어요."
    },
    "m042": {
      "source_hash": "c5231f1475e1",
      "text": "로고와 글꼴은 바뀌고 파랑도 조금 달랐어요."
    },
    "m043": {
      "source_hash": "5544bbcf1b6c",
      "text": "하지만 3색 비율은 반세기 내내 지켰죠."
    },
    "m044": {
      "source_hash": "ff6783bb1828",
      "text": "2015년 추정치로 일본 절반을 잡았죠."
    },
    "m045": {
      "source_hash": "954a38794c08",
      "text": "3색은 학교와 직장의 국민 문구가 됐죠."
    },
    "m046": {
      "source_hash": "4c59bfee302d",
      "text": "국민템이 되자 비슷한 배색 짝퉁이 넘쳤어요."
    },
    "m047": {
      "source_hash": "0aa39dcc28e8",
      "text": "색만 보고 집어가니 어떻게 막을까요?"
    },
    "m048": {
      "source_hash": "aa7cc70159a4",
      "text": "사실 1999년에 평면 상표 둘을 땄죠."
    },
    "m049": {
      "source_hash": "dc225a75a7d0",
      "text": "이듬해엔 입체 상표로 형태도 묶었죠."
    },
    "m050": {
      "source_hash": "a59afde50cb2",
      "text": "글자·모양에 묶여 배색 모방은 못 막죠."
    },
    "m051": {
      "source_hash": "222ee397f4eb",
      "text": "색 자체를 지킬 더 센 무기가 있을까요?"
    },
    "m052": {
      "source_hash": "90699f5f6b8e",
      "text": "2015년 4월 1일, 상표 제도가 바뀌죠."
    },
    "m053": {
      "source_hash": "9050bbc6b5a2",
      "text": "일본 특허청이 순수 색채상표를 처음 열었죠."
    },
    "m054": {
      "source_hash": "da79a2a44235",
      "text": "통과하면 지정 상품의 색을 독점해요."
    },
    "m055": {
      "source_hash": "817a571fc70a",
      "text": "첫날 신청했지만 문턱은 어땠을까요?"
    },
    "m056": {
      "source_hash": "154c7b22e503",
      "text": "일본 상표법상 색만으론 식별력이 없어요."
    },
    "m057": {
      "source_hash": "835b5d0ab628",
      "text": "오랜 사용과 국민 인지도를 입증해야 하죠."
    },
    "m058": {
      "source_hash": "8c2bdcf3e190",
      "text": "점유율·기사·광고를 낱낱이 모았죠."
    },
    "m059": {
      "source_hash": "45759da340f2",
      "text": "글자 뺀 색깔 블라인드 테스트였어요."
    },
    "m060": {
      "source_hash": "b702b991ad69",
      "text": "전국 조사서 압도적 인지도가 필수죠."
    },
    "m061": {
      "source_hash": "b2a649b54ea8",
      "text": "높은 문턱을 몇 건이나 넘었을까요?"
    },
    "m062": {
      "source_hash": "3333862ee278",
      "text": "2022년 6월까지 약 560건 중,"
    },
    "m063": {
      "source_hash": "f4891f847538",
      "text": "고작 9건만 통과해 2% 미만이었죠."
    },
    "m064": {
      "source_hash": "8da6a767ca85",
      "text": "색은 공공재라 쉽게 못 내주거든요."
    },
    "m065": {
      "source_hash": "e209718220fa",
      "text": "대기업도 몇 년씩 보완하며 기다려요."
    },
    "m066": {
      "source_hash": "f4e82f417097",
      "text": "이 2% 미만 명단에 또 누가 있을까요?"
    },
    "m067": {
      "source_hash": "340974aa1fcf",
      "text": "편의점 3색 줄무늬와 원조 치킨라면이죠."
    },
    "m116": {
      "source_hash": "13b9d0585c5e",
      "text": "60년 판 치킨라면도 3년 반 걸렸죠."
    },
    "m117": {
      "source_hash": "d2db36e6b234",
      "text": "세대별 설문 증거를 내고 겨우 통과했죠."
    },
    "m108": {
      "source_hash": "9dde8d1c20bb",
      "text": "대부분 자금력 막강한 국민 대기업들인데요."
    },
    "m109": {
      "source_hash": "544bf33171b0",
      "text": "평범한 지우개가 왜 1호를 땄을까요?"
    },
    "m118": {
      "source_hash": "2702ec86bc68",
      "text": "비결은 수십 년 단일 품목 노출이죠."
    },
    "m119": {
      "source_hash": "d63e5148f051",
      "text": "매일 3색을 쥐니 인지도가 엄청났죠."
    },
    "m068": {
      "source_hash": "319fcfa0c4f0",
      "text": "2017년 3월 10일 마침내 등록됐어요."
    },
    "m069": {
      "source_hash": "54b4fbbcfea8",
      "text": "일본 최초의 순수 색채상표가 탄생했죠."
    },
    "m070": {
      "source_hash": "038e35cb454a",
      "text": "문구가 1호를 따자 업계가 들썩였어요."
    },
    "m071": {
      "source_hash": "65d0f81b5363",
      "text": "이젠 글자 없이 3색만으로도 보호받죠."
    },
    "m072": {
      "source_hash": "1108ebcee57c",
      "text": "짝퉁을 막았으니 해피엔딩일 줄 알았죠."
    },
    "m073": {
      "source_hash": "6d885e4818b5",
      "text": "축배 대신 왜 글자 없는 판을 냈을까요?"
    },
    "m074": {
      "source_hash": "92119a0229af",
      "text": "정답은 일본 대입 시험장에 숨어 있어요."
    },
    "m075": {
      "source_hash": "51a4a283d80b",
      "text": "당시 센터시험은 영어 문구를 엄격히 막았죠."
    },
    "m076": {
      "source_hash": "627bf9d52822",
      "text": "수험생들은 걸릴까 봐 케이스를 뜯었죠."
    },
    "m077": {
      "source_hash": "3e468d03707d",
      "text": "케이스가 없으면 잘 부러지고 미끄럽죠."
    },
    "m078": {
      "source_hash": "037dee3a1773",
      "text": "5개월 뒤인 2017년 8월 승부수!"
    },
    "m079": {
      "source_hash": "9557e6a9b875",
      "text": "글자·숫자·기호를 싹 뺀 시험판이죠."
    },
    "m110": {
      "source_hash": "b0351cea0806",
      "text": "시험철마다 수험생 걱정이 싹 사라졌죠."
    },
    "m111": {
      "source_hash": "db748ed03ccf",
      "text": "뒷면 영어를 살필 필요 없이 챙기면 됐죠."
    },
    "m080": {
      "source_hash": "d4d57bde7b72",
      "text": "남들은 무명이 되지만 3색은 남거든요."
    },
    "m081": {
      "source_hash": "813ca18392a1",
      "text": "규정 통과에 어떤 디테일이 더 있죠?"
    },
    "m082": {
      "source_hash": "18e706bdcb7d",
      "text": "시험 중 떨어뜨릴까 봐 2개입으로 냈죠."
    },
    "m083": {
      "source_hash": "e70cc19753e0",
      "text": "시험장선 못 빌려서 여분을 챙기거든요."
    },
    "m084": {
      "source_hash": "70d8d4e59f56",
      "text": "필통에 쏙 드는 작은 크기로 골랐죠."
    },
    "m085": {
      "source_hash": "4229bd080b94",
      "text": "무지 연필과 딱 맞는 수험 세트죠."
    },
    "m120": {
      "source_hash": "bc8fe5ba1998",
      "text": "무문자 케이스도 재생펄프를 고집했죠."
    },
    "m121": {
      "source_hash": "fc611cebc37f",
      "text": "규정에 친환경까지 챙겨 대호평이었죠."
    },
    "m086": {
      "source_hash": "9b2cdb96a386",
      "text": "첫해 6만 5천 팩을 목표로 잡았어요."
    },
    "m087": {
      "source_hash": "fa72445234f7",
      "text": "정규 품목이 됐지만 끝이 아니에요."
    },
    "m088": {
      "source_hash": "3eaed7e7c29c",
      "text": "2019년 50주년엔 5대 복각판을 냈어요."
    },
    "m089": {
      "source_hash": "94a79ae36909",
      "text": "다섯 케이스에 반세기 집념이 담겼죠."
    },
    "m122": {
      "source_hash": "1e37122bfee0",
      "text": "3색은 35개 문구 품목으로 번졌죠."
    },
    "m123": {
      "source_hash": "0b5c9452e0db",
      "text": "연필부터 수정테이프까지 백여 종으로 커졌죠."
    },
    "m112": {
      "source_hash": "2f50c91ee2c0",
      "text": "제도판부터 시험장까지 함께해 왔죠."
    },
    "m113": {
      "source_hash": "29681d64cc4b",
      "text": "3색 띠는 세대를 잇는 국민 기억이죠."
    },
    "m090": {
      "source_hash": "2691b9ab8fab",
      "text": "소모품이 문구 덕후의 아이콘이 됐죠."
    },
    "m091": {
      "source_hash": "439b0759def3",
      "text": "하지만 디지털 시대에도 버틸까요?"
    },
    "m092": {
      "source_hash": "e8daf8a04967",
      "text": "태블릿이 늘며 지우개 시장도 줄었죠."
    },
    "m093": {
      "source_hash": "4e5f720fe7c4",
      "text": "기능만 늘리다 지우는 힘을 잃곤 해요."
    },
    "m094": {
      "source_hash": "4131bb92d5a2",
      "text": "2024년 가리비 껍질 10% 이상 넣었죠."
    },
    "m095": {
      "source_hash": "5c8c079e43d3",
      "text": "백색 착색 뺀 아이보리, 잘 지워질까요?"
    },
    "m114": {
      "source_hash": "c038599df74b",
      "text": "친환경 문구는 안 지워질까 걱정하죠."
    },
    "m115": {
      "source_hash": "654b8f302db6",
      "text": "첫 바이오매스 인증에 지우는 힘도 그대로예요."
    },
    "m124": {
      "source_hash": "604c8e89bd65",
      "text": "2011년 롱라이프 디자인상을 탔죠."
    },
    "m125": {
      "source_hash": "74b23f515a69",
      "text": "수십 년 미니멀한 형태는 일본 디자인의 상징."
    },
    "m096": {
      "source_hash": "dbfe018bc38d",
      "text": "2024년 친환경작도 다시 디자인상을 탔죠."
    },
    "m097": {
      "source_hash": "fa27cf46a263",
      "text": "하얗지 않은데도 왜 사람들은 살까요?"
    },
    "m098": {
      "source_hash": "4cb0489b2cb8",
      "text": "수십 년 신뢰가 흰색을 넘어섰기 때문이죠."
    },
    "m099": {
      "source_hash": "2e9b7f425b99",
      "text": "60년 역전엔 두 법칙이 있어요."
    },
    "m100": {
      "source_hash": "78a166680465",
      "text": "첫째, 사은품이라도 고객 말을 들어요."
    },
    "m101": {
      "source_hash": "69a51dfc8a76",
      "text": "그때 무시했다면 제왕은 없었을 테죠."
    },
    "m102": {
      "source_hash": "088f49530c18",
      "text": "둘째, 브랜드는 시간의 복리거든요."
    },
    "m103": {
      "source_hash": "714a2d599758",
      "text": "한 배색을 끝까지 지켜야 법도 독점을 주죠."
    },
    "m104": {
      "source_hash": "1d6a301c8dd3",
      "text": "이름을 지워도 알아보는 게 진짜 해자."
    },
    "m105": {
      "source_hash": "387d62047f3b",
      "text": "공짜 사은품이 지재권 교과서가 됐죠."
    },
    "m106": {
      "source_hash": "3fde30538022",
      "text": "지우개 끝까지 썼나요, 잃어버렸나요?"
    },
    "m107": {
      "source_hash": "b1651dd75b22",
      "text": "댓글 남기고 기문파일국 구독해 주세요."
    }
  }
}
