  "lines": {
    "kc101": {
      "source_hash": "fd436efe7e21",
      "text": "가정 함락. 소설 속 제갈량은 서성에서 군량을 옮긴다."
    },
    "kc102": {
      "source_hash": "a2072e8e34ff",
      "text": "급보: 사마의 15만 대군이 온다. 성엔 2,500명뿐."
    },
    "kc103": {
      "source_hash": "c21a8de6420f",
      "text": "성문을 열고 병사는 백성처럼 비질;"
    },
    "kc104": {
      "source_hash": "789322ff66e0",
      "text": "자신은 성루에서 향 피워 거문고."
    },
    "kc105": {
      "source_hash": "0135d79fb68d",
      "text": "사마소: 아버님, 병사가 없어 꾸민 걸까요?"
    },
    "kc106": {
      "source_hash": "933c1fce5f10",
      "text": "사마의: 제갈량은 신중하다. 복병이다. 퇴각!"
    },
    "kc107": {
      "source_hash": "ae661c1a3ba6",
      "text": "대군은 물러갔다. 소설 속 제갈량도 웃었다."
    },
    "kc108": {
      "source_hash": "a34973a9214f",
      "text": "내가 사마의면 안 물러나."
    },
    "kc109": {
      "source_hash": "5672c12d2c17",
      "text": "더 이상한 건"
    },
    "kc110": {
      "source_hash": "752e6b1d9e4c",
      "text": "최초 판본엔 거문고가 있었을까?"
    },
    "kc111": {
      "source_hash": "2036d589c925",
      "text": "처음 이 얘기를 들은 건 사마의의 친아들."
    },
    "kc112": {
      "source_hash": "e7f537f9958f",
      "text": "그해 산 아래서 또 누가 북을 계속 쳤다. 그는 누굴 속이려 했나?"
    },
    "kc113": {
      "source_hash": "d50d834646ba",
      "text": "공성계 날, 사마의는 어디에?"
    },
    "kc201": {
      "source_hash": "387db573f9fe",
      "text": "그런데 진수의 『삼국지』 본문엔 이 장면이 한 글자도 없다."
    },
    "kc202": {
      "source_hash": "43fc3ad2e6ce",
      "text": "최초의 공성 이야기는 후대 주석 속에."
    },
    "kc203": {
      "source_hash": "6968ef2cb370",
      "text": "수십 년 뒤 서진 초, 부풍왕 사마준이 관중을 지켰다."
    },
    "kc204": {
      "source_hash": "f72055933311",
      "text": "그가 바로 사마의의 아들."
    },
    "kc205": {
      "source_hash": "7a69e779b5da",
      "text": "부하들은 제갈량을 두고 대부분 비웃었다. 힘은 작은데 큰일을 꾀한다고."
    },
    "kc206": {
      "source_hash": "9e0fb06cde12",
      "text": "그때 금성 사람 곽충이 제갈량을 편들었다."
    },
    "kc207": {
      "source_hash": "2e7b0af82af7",
      "text": "제갈량에겐 아무도 모르는 일 다섯이 있다고."
    },
    "kc208": {
      "source_hash": "efb468ad0e0b",
      "text": "공성은 세 번째."
    },
    "kc209": {
      "source_hash": "0309f65cbd45",
      "text": "곽충판은 서성 아닌 한중 양평."
    },
    "kc210": {
      "source_hash": "9180f7aa2e16",
      "text": "위연에게 대군을 주어 동쪽으로, 자신은 1만만 남긴다."
    },
    "kc211": {
      "source_hash": "71e6d6f4d932",
      "text": "사마의 20만이 위연과 엇갈려 60리 앞까지 온다."
    },
    "kc212": {
      "source_hash": "d61540345487",
      "text": "위연을 부르기엔 늦었다. 다들 사색."
    },
    "kc213": {
      "source_hash": "1205bd936b36",
      "text": "제갈량은 어떻게?"
    },
    "kc214": {
      "source_hash": "4edcde90994e",
      "text": "태연히 깃발을 눕히고 북을 멈추고 막사 밖 금지."
    },
    "kc215": {
      "source_hash": "99977af614cd",
      "text": "네 성문을 열고 비질하고 물을 뿌렸다."
    },
    "kc216": {
      "source_hash": "03157dee406c",
      "text": "늘 신중하던 제갈량이 약한 척하자 사마의는 의심했다."
    },
    "kc217": {
      "source_hash": "542de2bb037c",
      "text": "복병을 의심했다. 소설의 \"필시 복병\"과 거의 같다."
    },
    "kc218": {
      "source_hash": "171520dee96b",
      "text": "그는 북쪽 산으로 물러갔다."
    },
    "kc219": {
      "source_hash": "c943478c01bd",
      "text": "이튿날 아침밥 때, 제갈량은 막료에게 손뼉 치며 웃었다."
    },
    "kc220": {
      "source_hash": "e7eae6e00802",
      "text": "날 겁먹고 복병 뒀다 여겨 산으로 갔겠지."
    },
    "kc221": {
      "source_hash": "9d9cb11714a9",
      "text": "정찰병 보고: 과연."
    },
    "kc222": {
      "source_hash": "2383e5cce571",
      "text": "곽충: 사마의는 훗날 알고 분했다."
    },
    "kc223": {
      "source_hash": "69fd6958f88a",
      "text": "사마의가 정말 제갈량에게 속아 물러난 적이?"
    },
    "kc224": {
      "source_hash": "efa09f4ac394",
      "text": "거문고는? 곽충 판엔 거문고도 성루도 사마소도 없다."
    },
    "kc225": {
      "source_hash": "46937fd2bd39",
      "text": "가정도 없다."
    },
    "kc226": {
      "source_hash": "daf65e778e42",
      "text": "모두 훗날 소설에서야."
    },
    "kc227": {
      "source_hash": "bc730a9d3953",
      "text": "그해 제갈량은 양평 일대에 있었다. 진수의 기록."
    },
    "kc228": {
      "source_hash": "f4fd0628588a",
      "text": "그럼 성 밖의 사마의는? 그해 정말 거기 있었나?"
    },
    "kc301": {
      "source_hash": "2d1ecf473df1",
      "text": "이걸 검증한 건 주석가 배송지."
    },
    "kc302": {
      "source_hash": "3a4e0fe20986",
      "text": "그는 429년 주석을 바쳤다. 그 싸움 후 약 200년."
    },
    "kc303": {
      "source_hash": "1aafb1a970bd",
      "text": "원칙: 안 맞으면 바로 바로잡기."
    },
    "kc304": {
      "source_hash": "bc517582b903",
      "text": "다섯 가지 앞에 썼다. 제갈량 미담이야 물론 듣고 싶다고."
    },
    "kc305": {
      "source_hash": "a2e953260f5f",
      "text": "이어서: 곽충의 말은 모두 의심스럽다."
    },
    "kc306": {
      "source_hash": "7496b1ce548d",
      "text": "먼저 양평부터."
    },
    "kc307": {
      "source_hash": "930b6676c4d1",
      "text": "제갈량이 양평에 왔을 때 사마의는 형주 도독, 완에 주둔."
    },
    "kc308": {
      "source_hash": "39b5aadfe42a",
      "text": "또: 한 사람이 죽은 뒤에야 둘은 관중에서 맞섰다."
    },
    "kc309": {
      "source_hash": "24efd2f63a4d",
      "text": "그게 누구?"
    },
    "kc310": {
      "source_hash": "a379f6b8d1de",
      "text": "기록상 위는 사마의를 완에서 서성을 거쳐 촉으로 보냈다."
    },
    "kc311": {
      "source_hash": "837fe036f2f6",
      "text": "서성? 소설의 그 성인가?"
    },
    "kc312": {
      "source_hash": "19d9e625afae",
      "text": "요지는, 그 무렵 양평엔 전투가 없었다."
    },
    "kc313": {
      "source_hash": "94390f246046",
      "text": "병력도 따졌다. 곽충의 20만 기억하나? 그 대군이 성이 빈 것도 알았다."
    },
    "kc314": {
      "source_hash": "178c73c9187a",
      "text": "복병이 무서워도 진을 치고 천천히. 왜 돌아서나?"
    },
    "kc315": {
      "source_hash": "005275a96279",
      "text": "소설 속 \"내가 사마의면 안 물러나\" 기억하나?"
    },
    "kc316": {
      "source_hash": "7848fee20a50",
      "text": "배송지의 계산도 같다."
    },
    "kc317": {
      "source_hash": "6dd2c76d9344",
      "text": "대군 이끌고 동쪽 간 위연도 검증했다."
    },
    "kc318": {
      "source_hash": "7ec584a908bf",
      "text": "위연은 늘 1만으로 따로 가길 청했고 제갈량은 늘 거절."
    },
    "kc319": {
      "source_hash": "92d407ac815e",
      "text": "그것도 안 준 그가 대군을 맡기고 약졸로 성을?"
    },
    "kc320": {
      "source_hash": "377eaa5dbc60",
      "text": "끝으로, 누가 듣고 있었나."
    },
    "kc321": {
      "source_hash": "327e8cbb6ba3",
      "text": "부풍왕 기억하나? 곽충은 그 아버지의 망신을 말했다."
    },
    "kc322": {
      "source_hash": "3dc9eb319b25",
      "text": "배송지: 아들 앞에서 아버지 흉은 안 될 일."
    },
    "kc323": {
      "source_hash": "451ad744cbea",
      "text": "그런데 부풍왕이 칭찬했다니."
    },
    "kc324": {
      "source_hash": "f2031722e78e",
      "text": "결론: 이 책이 든 건 다 거짓."
    },
    "kc325": {
      "source_hash": "93d21fd1519e",
      "text": "하지만 배송지 한 사람의 말일 뿐. 그해 사마의 행적, 다른 사서와 맞을까?"
    },
    "kc401": {
      "source_hash": "44629265fbec",
      "text": "맞는다. 『진서』에 따르면 227년 6월부터 그가 지킨 곳은 바로 그 완."
    },
    "kc402": {
      "source_hash": "abdf0ec1f640",
      "text": "형주·예주 군을 지휘."
    },
    "kc403": {
      "source_hash": "b18e0db7729a",
      "text": "연말, 신성 태수 맹달 반란."
    },
    "kc404": {
      "source_hash": "3af810d10f7d",
      "text": "맹달의 계산: 완은 낙양까지 800리, 자기까지 1200리."
    },
    "kc405": {
      "source_hash": "55f6071ec8b1",
      "text": "사마의는?"
    },
    "kc406": {
      "source_hash": "199ae8c29823",
      "text": "밤낮 달려 8일 만에 성 아래."
    },
    "kc407": {
      "source_hash": "675179d4b472",
      "text": "오·촉 구원군을 사마의가 부장 보내 막았다."
    },
    "kc408": {
      "source_hash": "74387f29528d",
      "text": "16일 만에 성이 함락, 맹달 사망."
    },
    "kc409": {
      "source_hash": "4d9dd52ec12d",
      "text": "그리고 완으로 복귀."
    },
    "kc410": {
      "source_hash": "7407895add4f",
      "text": "처음 질문 기억나나? 공성계 날 사마의는 어디에?"
    },
    "kc411": {
      "source_hash": "add641d6f12a",
      "text": "사서는 같은 달에 쓴다. 228년 정월, 신성 함락;"
    },
    "kc412": {
      "source_hash": "735e4e81c4a5",
      "text": "곧 제갈량 출병."
    },
    "kc413": {
      "source_hash": "7ece4d4c8e55",
      "text": "그해 봄, 제갈량은 다른 길을 흘리고 주력으로 기산을 쳤다."
    },
    "kc414": {
      "source_hash": "09c3324c498b",
      "text": "위는 누구를?"
    },
    "kc415": {
      "source_hash": "668e4c25eb31",
      "text": "대장군 조진은 관서를, 장합은 가정으로 나갔다."
    },
    "kc416": {
      "source_hash": "18cc24c49e23",
      "text": "이 명단엔 사마의가 없다."
    },
    "kc417": {
      "source_hash": "de35a585dd22",
      "text": "아버지께 묻던 사마소는? 그해 열여덟쯤. 출전 기록 없음."
    },
    "kc418": {
      "source_hash": "ef373640661b",
      "text": "가정의 촉군은 마속."
    },
    "kc419": {
      "source_hash": "a7c009e74119",
      "text": "제갈량 배치를 어기고 물을 떠나 산 위로."
    },
    "kc420": {
      "source_hash": "29899c0a1244",
      "text": "왕평이 말려도 무시."
    },
    "kc421": {
      "source_hash": "d78b34d4f1cc",
      "text": "물 없이 얼마나 버틸까?"
    },
    "kc422": {
      "source_hash": "2f1bc616e135",
      "text": "장합은 물길부터 끊었다."
    },
    "kc423": {
      "source_hash": "47a0faa2549c",
      "text": "촉군 대패, 뿔뿔이."
    },
    "kc424": {
      "source_hash": "9fecbe2a582a",
      "text": "1천 명만 버텼다."
    },
    "kc425": {
      "source_hash": "cf6f6d0d69f7",
      "text": "멈춰서 북을 쳤다."
    },
    "kc501": {
      "source_hash": "8736097c254c",
      "text": "이끈 이는 마속을 말린 왕평."
    },
    "kc502": {
      "source_hash": "4c640a57010a",
      "text": "북은 계속, 대열은 그대로."
    },
    "kc503": {
      "source_hash": "c6017cab7f20",
      "text": "장합은 멈췄다. 복병을 의심해 다가가지 못했다."
    },
    "kc504": {
      "source_hash": "742985e623b6",
      "text": "산 아래서 북 치던 사람, 바로 왕평. 속은 건 장합."
    },
    "kc505": {
      "source_hash": "f2fcbd589356",
      "text": "왕평은 흩어진 병사를 모아 돌아왔다."
    },
    "kc506": {
      "source_hash": "de2d13a34ff9",
      "text": "이긴 장합은 어디로?"
    },
    "kc507": {
      "source_hash": "017ca105d190",
      "text": "형주로, 사마의 휘하."
    },
    "kc508": {
      "source_hash": "4e3772612519",
      "text": "그해 겨울 사마의는? 형주에서 수군을 만들어 물길로 오를 치려 했다."
    },
    "kc509": {
      "source_hash": "e9c63db93a80",
      "text": "겨울 물이 얕아 큰 배가 못 가 장합은 회군."
    },
    "kc510": {
      "source_hash": "a6a62ce1b9af",
      "text": "배송지가 쓴 서성은?"
    },
    "kc511": {
      "source_hash": "12ced5555da2",
      "text": "230년, 사마의는 정말 서성에서 산길을 냈다."
    },
    "kc512": {
      "source_hash": "6f82e278765a",
      "text": "제갈량은 성고 적판에서 대기."
    },
    "kc513": {
      "source_hash": "ec912714d09b",
      "text": "비가 30여 일, 잔도가 끊겨 위군 철수."
    },
    "kc514": {
      "source_hash": "8082983e7309",
      "text": "그 서성은 한수 상류, 소설과 다른 곳."
    },
    "kc515": {
      "source_hash": "fdd146cc5c81",
      "text": "누가 죽어야 둘이 맞선다던 그 사람은?"
    },
    "kc516": {
      "source_hash": "9bb52a11a285",
      "text": "조진. 231년 조진이 병사하자 사마의가 형주에서 서쪽으로."
    },
    "kc517": {
      "source_hash": "cb427b03e38c",
      "text": "그해 제갈량이 기산 포위, 사마의 공격."
    },
    "kc518": {
      "source_hash": "0893720397a8",
      "text": "둘의 첫 진짜 대결."
    },
    "kc519": {
      "source_hash": "ac74ce3a1865",
      "text": "다시 묻자. 사마의가 제갈량에게 속아 물러난 적이?"
    },
    "kc520": {
      "source_hash": "729618a5518a",
      "text": "3년 뒤 제갈량은 진중에서 병사."
    },
    "kc521": {
      "source_hash": "c9b2a6b5f474",
      "text": "사후 촉군이 깃발을 돌리고 북을 쳐 사마의를 칠 듯했다."
    },
    "kc522": {
      "source_hash": "ea2726909aa0",
      "text": "사마의는 물러나 다가가지 못했다."
    },
    "kc523": {
      "source_hash": "6248251e0645",
      "text": "사람들 왈, 죽은 제갈량이 산 중달을 쫓았다. 중달이 사마의."
    },
    "kc524": {
      "source_hash": "4fff11e69d83",
      "text": "사마의: 산 자는 헤아려도 죽은 자는 못 헤아린다."
    },
    "kc525": {
      "source_hash": "09b0fc11109f",
      "text": "아까 그 명단, 곽충이든 소설이든, 그해 제갈량의 맞수는 사마의가 아니었다."
    },
    "kc526": {
      "source_hash": "adac7c3c671a",
      "text": "저희 생각에, 그해 적을 속인 건 성루의 거문고가 아니라 가정 산 아래의 북이었다."
    },
    "kc527": {
      "source_hash": "1484bd2a38ff",
      "text": "이 파일, 보관."
    },
    "kc528": {
      "source_hash": "9e3eb846d5e1",
      "text": "공성계, 처음 본 건 소설? 무대? 드라마?"
    },
    "kc529": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 말합니다. 함께 파일을 열려면 구독."
    }
  }
}
