    "thumbnail": "f8ea37736989"
  },
  "lines": {
    "p001": {
      "source_hash": "b7172e801960",
      "text": "Diretora! Calorão!"
    },
    "p002": {
      "source_hash": "3f5b61642553",
      "text": "Abri a porta,"
    },
    "p003": {
      "source_hash": "168c59f250fe",
      "text": "e senti o frio!"
    },
    "p004": {
      "source_hash": "7bf79f51a091",
      "text": "Já sei!"
    },
    "p005": {
      "source_hash": "8b23cc53bc02",
      "text": "Deixo aberta,"
    },
    "p006": {
      "source_hash": "ec357ef013f5",
      "text": "e chega de ar ligado!"
    },
    "p007": {
      "source_hash": "8395747e3950",
      "text": "Calma, espera."
    },
    "p008": {
      "source_hash": "c88a1c380fdb",
      "text": "Chuta: porta sempre aberta,"
    },
    "p009": {
      "source_hash": "7667289aae3d",
      "text": "a cozinha esfria ou esquenta?"
    },
    "p010": {
      "source_hash": "002e57b4aaa5",
      "text": "Calor?"
    },
    "p011": {
      "source_hash": "d5d7f4e1f933",
      "text": "A geladeira é fria!"
    },
    "p012": {
      "source_hash": "8a877c6d664c",
      "text": "Põe a mão atrás da geladeira."
    },
    "p013": {
      "source_hash": "5fad15bf2f6d",
      "text": "Ali não tem nada de frio."
    },
    "p014": {
      "source_hash": "0b087fdc1ec2",
      "text": "Lá atrás..."
    },
    "p015": {
      "source_hash": "e87865d778ae",
      "text": "o que se esconde?"
    },
    "p016": {
      "source_hash": "915a9848b82a",
      "text": "E a caixa que zumbe na varanda:"
    },
    "p017": {
      "source_hash": "d5da43348a89",
      "text": "o vento dela é frio ou quente?"
    },
    "p018": {
      "source_hash": "64872e30b282",
      "text": "A do ar"
    },
    "p019": {
      "source_hash": "7ec9f7b51336",
      "text": "sopra vento frio, né?"
    },
    "p020": {
      "source_hash": "aee671c7ac12",
      "text": "A resposta está na geladeira."
    },
    "p021": {
      "source_hash": "d329b4aea270",
      "text": "Com a porta aberta, pra onde vai o calor?"
    },
    "p022": {
      "source_hash": "f1fbe5370dca",
      "text": "Tá cheia de frio,"
    },
    "p023": {
      "source_hash": "db519e542b90",
      "text": "abriu a porta, o frio sai!"
    },
    "p024": {
      "source_hash": "8c8d0ac2f508",
      "text": "Pensa num chá quente."
    },
    "p025": {
      "source_hash": "70f485a4b48d",
      "text": "E depois de um tempinho?"
    },
    "p026": {
      "source_hash": "a1db32b61f99",
      "text": "Fica morno."
    },
    "p027": {
      "source_hash": "c1f7b9777c52",
      "text": "O calor foi!"
    },
    "p028": {
      "source_hash": "2561d58ec95e",
      "text": "E um gelo na mesa?"
    },
    "p029": {
      "source_hash": "29949618a983",
      "text": "Vai derreter."
    },
    "p030": {
      "source_hash": "39f36455444d",
      "text": "O gelo derrete com o calor do ar em volta."
    },
    "p031": {
      "source_hash": "225d245b624a",
      "text": "Sozinho, o calor só vai do quente pro frio."
    },
    "p032": {
      "source_hash": "61e8dce75fb3",
      "text": "E frio?"
    },
    "p033": {
      "source_hash": "7072e93bbb8b",
      "text": "O ar gelado não se mexe?"
    },
    "p034": {
      "source_hash": "d93c5aab02b6",
      "text": "Frio é só ter menos calor."
    },
    "p035": {
      "source_hash": "034b4877b852",
      "text": "Frio não é coisa que escapa."
    },
    "p036": {
      "source_hash": "efca9195884d",
      "text": "E o rosto,"
    },
    "p037": {
      "source_hash": "a1d48a27d2ed",
      "text": "por que ficou fresco?"
    },
    "p038": {
      "source_hash": "70e3b42cdb9f",
      "text": "O ar frio sai e toca seu rosto,"
    },
    "p039": {
      "source_hash": "95fd93cf0b40",
      "text": "e o calor do rosto vai pra ele."
    },
    "p040": {
      "source_hash": "0bb13789f451",
      "text": "Roubaram meu calor!"
    },
    "p041": {
      "source_hash": "b6d74c1d6dcf",
      "text": "Vamos desenhar um círculo."
    },
    "p042": {
      "source_hash": "8094f53d46b8",
      "text": "Anotamos todo calor que entra ou sai dele."
    },
    "p043": {
      "source_hash": "7f741889678a",
      "text": "Calor: bolinhas vermelhas."
    },
    "p044": {
      "source_hash": "aa7814faf297",
      "text": "Primeiro, só por dentro."
    },
    "p045": {
      "source_hash": "f40432e0831b",
      "text": "Em cima, de 3 a 5 graus,"
    },
    "p046": {
      "source_hash": "1635dcd9825b",
      "text": "bem mais frio que a cozinha."
    },
    "p047": {
      "source_hash": "c88b1e8516c1",
      "text": "E o freezer, chuta?"
    },
    "p048": {
      "source_hash": "0e6fe5844c83",
      "text": "Uns 18 graus negativos, ou menos."
    },
    "p049": {
      "source_hash": "2c4f1b1915af",
      "text": "Menos 18!"
    },
    "p050": {
      "source_hash": "e4562096a5cd",
      "text": "Mais frio que inverno!"
    },
    "p051": {
      "source_hash": "d5d8dd87011b",
      "text": "Mais diferença, mais calor entra."
    },
    "p052": {
      "source_hash": "69606f40df49",
      "text": "O calor daqui"
    },
    "p053": {
      "source_hash": "e8044ff9c033",
      "text": "quer entrar nela?"
    },
    "p054": {
      "source_hash": "84858753c1b7",
      "text": "Quer. O calor sempre vai pro frio."
    },
    "p055": {
      "source_hash": "0c159cbff7e5",
      "text": "Mas a porta segura ele um pouco."
    },
    "p056": {
      "source_hash": "399cfe6588f9",
      "text": "Toca a borda dela:"
    },
    "p057": {
      "source_hash": "5a88375b6bd5",
      "text": "grossa, pesada, com borracha macia."
    },
    "p058": {
      "source_hash": "e08d08650ed0",
      "text": "Igual uma térmica!"
    },
    "p059": {
      "source_hash": "185271b7781d",
      "text": "É, tem isolante por dentro."
    },
    "p060": {
      "source_hash": "59b39972f5f2",
      "text": "É o isolamento: freia o calor."
    },
    "p061": {
      "source_hash": "796ec4046f41",
      "text": "Guarde essa porta, ela vai voltar."
    },
    "p062": {
      "source_hash": "bd96aec42c6c",
      "text": "Só freia?"
    },
    "p063": {
      "source_hash": "13f4d5f3db90",
      "text": "E ainda entra?"
    },
    "p064": {
      "source_hash": "3b92cd9d7d93",
      "text": "Entra. Mas segue fria,"
    },
    "p065": {
      "source_hash": "57ef5c8a1fbc",
      "text": "então algo tira esse calor."
    },
    "p066": {
      "source_hash": "a0c91d1c24f5",
      "text": "Bolinhas saem do círculo, uma a uma."
    },
    "p067": {
      "source_hash": "47283fea74d1",
      "text": "E elas"
    },
    "p068": {
      "source_hash": "41ee68987691",
      "text": "vão pra onde?"
    },
    "p069": {
      "source_hash": "be11f6a5a898",
      "text": "A geladeira"
    },
    "p070": {
      "source_hash": "0cec453a5dc3",
      "text": "come o calor?"
    },
    "p071": {
      "source_hash": "7becdf761571",
      "text": "Calor não some, muda de lugar."
    },
    "p072": {
      "source_hash": "5ef3679c80b5",
      "text": "Olha atrás da geladeira."
    },
    "p073": {
      "source_hash": "6f0e9e8688bc",
      "text": "Ué? Tá morno!"
    },
    "p074": {
      "source_hash": "73d24cbaae95",
      "text": "Ar morno!"
    },
    "p075": {
      "source_hash": "a49f26eea7ea",
      "text": "Só chegue a mão; tem fios, não mexa."
    },
    "p076": {
      "source_hash": "462c50c43919",
      "text": "Os canos curvos aqui tão mornos."
    },
    "p077": {
      "source_hash": "380e8fd1a016",
      "text": "Por aqui o calor volta pra cozinha."
    },
    "p078": {
      "source_hash": "e95a80445e89",
      "text": "O calor veio pra trás!"
    },
    "p079": {
      "source_hash": "9bce21fe93ad",
      "text": "Umas sopram ar morno por baixo."
    },
    "p080": {
      "source_hash": "15ffc9f633b5",
      "text": "já sentiu um ventinho no pé?"
    },
    "p081": {
      "source_hash": "d8391d830a0b",
      "text": "Pé morno,"
    },
    "p082": {
      "source_hash": "34ab9467f167",
      "text": "rosto fresco!"
    },
    "p083": {
      "source_hash": "ee2e6d9cc774",
      "text": "Mas ela não tem mãos,"
    },
    "p084": {
      "source_hash": "d152ca25322f",
      "text": "como ela carrega?"
    },
    "p085": {
      "source_hash": "0751b621f960",
      "text": "Nos canos, algo roda em círculos,"
    },
    "p086": {
      "source_hash": "33f41bdbb110",
      "text": "o gás refrigerante."
    },
    "p087": {
      "source_hash": "1bc9f4cd28e1",
      "text": "Hã?"
    },
    "p088": {
      "source_hash": "ff6c7307a4e7",
      "text": "Ele é frio?"
    },
    "p089": {
      "source_hash": "572d772e9217",
      "text": "Nem sempre, ele muda. Depois do banho,"
    },
    "p090": {
      "source_hash": "2a481522d9d1",
      "text": "saindo molhado, você não treme?"
    },
    "p091": {
      "source_hash": "83ec21889dbc",
      "text": "Sim! Água quente!"
    },
    "p092": {
      "source_hash": "0e3109c97ff4",
      "text": "Quando a água vira vapor e voa,"
    },
    "p093": {
      "source_hash": "205b3b934b24",
      "text": "leva junto o seu calor."
    },
    "p094": {
      "source_hash": "ba6b32042453",
      "text": "Por isso dá frio!"
    },
    "p095": {
      "source_hash": "b68f95bdbd47",
      "text": "O fluido também vira gás lá dentro,"
    },
    "p096": {
      "source_hash": "2964963c1cc3",
      "text": "levando o calor para os canos."
    },
    "p097": {
      "source_hash": "d88e32ea3e04",
      "text": "Tão gelado,"
    },
    "p098": {
      "source_hash": "766d0cb1f76c",
      "text": "ele vira gás mesmo assim?"
    },
    "p099": {
      "source_hash": "8cd725bde610",
      "text": "Vira. É um líquido que ferve fácil,"
    },
    "p100": {
      "source_hash": "65e692591700",
      "text": "pouco calor já o faz virar gás."
    },
    "p101": {
      "source_hash": "42846c9e49a7",
      "text": "Ferve gelado?"
    },
    "p102": {
      "source_hash": "bb4a69618061",
      "text": "Que líquido estranho!"
    },
    "p103": {
      "source_hash": "7518a2b18c99",
      "text": "E esse gás"
    },
    "p104": {
      "source_hash": "9eb4faf4c902",
      "text": "vai pra onde?"
    },
    "p105": {
      "source_hash": "e48936cab7ce",
      "text": "Num tambor de metal."
    },
    "p106": {
      "source_hash": "28f428d21fb9",
      "text": "Ele se chama compressor."
    },
    "p107": {
      "source_hash": "c7d417713f75",
      "text": "Ele aperta bem o gás."
    },
    "p108": {
      "source_hash": "3e9aa7d87bce",
      "text": "O gás apertado vai pros canos de trás,"
    },
    "p109": {
      "source_hash": "bbff0f0a54f8",
      "text": "vira líquido e solta o calor ali."
    },
    "p110": {
      "source_hash": "77a975998970",
      "text": "Depois volta pra dentro e roda de novo."
    },
    "p111": {
      "source_hash": "63db4baa6c9b",
      "text": "Um trenzinho de calor!"
    },
    "p112": {
      "source_hash": "7baf69c37ec5",
      "text": "Isso. Volta após volta, leva o calor pra fora."
    },
    "p113": {
      "source_hash": "7e942b397d8b",
      "text": "Alguém empurra o trem?"
    },
    "p114": {
      "source_hash": "12652fd29511",
      "text": "É a eletricidade. Apertar gás cansa,"
    },
    "p115": {
      "source_hash": "be8011a3125a",
      "text": "e o compressor gasta energia."
    },
    "p116": {
      "source_hash": "049788cf513e",
      "text": "Energia: um raiozinho amarelo."
    },
    "p117": {
      "source_hash": "24ab05860f20",
      "text": "Nem sempre roda: esquentou, liga;"
    },
    "p118": {
      "source_hash": "e55082a0f762",
      "text": "gelou, descansa."
    },
    "p119": {
      "source_hash": "55d81ae16193",
      "text": "Por isso às vezes tá quieta!"
    },
    "p120": {
      "source_hash": "d3da14b332db",
      "text": "E essa energia,"
    },
    "p121": {
      "source_hash": "f2ab77da9298",
      "text": "vai pra onde?"
    },
    "p122": {
      "source_hash": "73b7521ec063",
      "text": "E o calor de trás"
    },
    "p123": {
      "source_hash": "e4f1584f39bf",
      "text": "é igual ao"
    },
    "p124": {
      "source_hash": "75df1cd5c7e7",
      "text": "que saiu?"
    },
    "p125": {
      "source_hash": "f2255ae9f464",
      "text": "Vamos aumentar o círculo:"
    },
    "p126": {
      "source_hash": "7d4bf8b2e882",
      "text": "a cozinha toda dentro."
    },
    "p127": {
      "source_hash": "aa50778a6617",
      "text": "Geladeira, a parte de trás, você:"
    },
    "p128": {
      "source_hash": "71e36c86143b",
      "text": "agora tudo no mesmo círculo."
    },
    "p129": {
      "source_hash": "3b7d5d97c732",
      "text": "Porta fechada. Conta fácil:"
    },
    "p130": {
      "source_hash": "43ca28d04bce",
      "text": "tira duas bolinhas de dentro,"
    },
    "p131": {
      "source_hash": "cd9ee06bf0f3",
      "text": "e gasta um raiozinho."
    },
    "p132": {
      "source_hash": "1a9aba9a876d",
      "text": "Saem quantas?"
    },
    "p133": {
      "source_hash": "62a7c0ee0d48",
      "text": "Três. As duas, mais uma."
    },
    "p134": {
      "source_hash": "80fd1b3727a5",
      "text": "Essa uma veio da energia gasta."
    },
    "p135": {
      "source_hash": "26ae01210cdc",
      "text": "Sai mais do que tirou!"
    },
    "p136": {
      "source_hash": "e760c2879753",
      "text": "Isso. A energia usada não some, vira calor."
    },
    "p137": {
      "source_hash": "a5c13336517a",
      "text": "E fechada, a cozinha esquenta?"
    },
    "p138": {
      "source_hash": "e98d5b7e0889",
      "text": "As duas entraram devagar pelas paredes."
    },
    "p139": {
      "source_hash": "ede7b25ad758",
      "text": "Voltam à cozinha, mais uma da energia."
    },
    "p140": {
      "source_hash": "36f06a827477",
      "text": "Mesmo fechada,"
    },
    "p141": {
      "source_hash": "3254249642e1",
      "text": "a cozinha esquenta?"
    },
    "p142": {
      "source_hash": "f76687cf1119",
      "text": "Sim, ligada, ela aquece um pouquinho a cozinha."
    },
    "p143": {
      "source_hash": "005ebd05fb40",
      "text": "E se eu abrir"
    },
    "p144": {
      "source_hash": "0e34bb8e2063",
      "text": "a porta?"
    },
    "p145": {
      "source_hash": "625dc61639d1",
      "text": "O calor entra pela porta,"
    },
    "p146": {
      "source_hash": "e4c425ec5331",
      "text": "ela joga de volta lá atrás."
    },
    "p147": {
      "source_hash": "2ddd2f1d3e23",
      "text": "O calor anda em círculo!"
    },
    "p148": {
      "source_hash": "98bf9e64094d",
      "text": "As duas bolinhas voltam pela porta,"
    },
    "p149": {
      "source_hash": "993448b744d4",
      "text": "e a cozinha não perde nenhuma."
    },
    "p150": {
      "source_hash": "e25151dec489",
      "text": "Mas cada volta, o raio"
    },
    "p151": {
      "source_hash": "b941f4490e4d",
      "text": "cria mais uma bolinha."
    },
    "p152": {
      "source_hash": "5d4a730599d5",
      "text": "Porta aberta"
    },
    "p153": {
      "source_hash": "defd13d28935",
      "text": "esquenta a cozinha!"
    },
    "p154": {
      "source_hash": "034e0dbc348d",
      "text": "Mas aqui na frente"
    },
    "p155": {
      "source_hash": "5b6396465b28",
      "text": "tá fresquinho!"
    },
    "p156": {
      "source_hash": "3677bf0254a1",
      "text": "Sim, bem ali esfria um pouco."
    },
    "p157": {
      "source_hash": "01bf3f39f165",
      "text": "Mas saiu dali, não adianta nada."
    },
    "p158": {
      "source_hash": "f77e16007326",
      "text": "E ela esquenta por dentro,"
    },
    "p159": {
      "source_hash": "382ef4689927",
      "text": "e o compressor não para de gastar."
    },
    "p160": {
      "source_hash": "1e062ea5c74d",
      "text": "Coitada da geladeira!"
    },
    "p161": {
      "source_hash": "c9604ed3360d",
      "text": "E do medidor de luz:"
    },
    "p162": {
      "source_hash": "70427cb4f5c3",
      "text": "a conta sobe junto."
    },
    "p163": {
      "source_hash": "d86a30ddd6a2",
      "text": "Aberta, a geladeira"
    },
    "p164": {
      "source_hash": "4531a6e99a75",
      "text": "vira um aquecedor?"
    },
    "p165": {
      "source_hash": "c9d31a47be23",
      "text": "Quase, com um desvio,"
    },
    "p166": {
      "source_hash": "7fe1c5c54c52",
      "text": "e ainda esquenta a comida dentro."
    },
    "p167": {
      "source_hash": "049670cdb014",
      "text": "Eis o truque dela:"
    },
    "p168": {
      "source_hash": "aa856c62028b",
      "text": "ela move calor, não fabrica frio."
    },
    "p169": {
      "source_hash": "b2de70b627aa",
      "text": "Me enganou!"
    },
    "p170": {
      "source_hash": "5a19c061ddb5",
      "text": "E o ar?"
    },
    "p171": {
      "source_hash": "10f181af712d",
      "text": "O ar também move calor?"
    },
    "p172": {
      "source_hash": "6624f41099c1",
      "text": "Sim. É a mesma máquina."
    },
    "p173": {
      "source_hash": "a658a955447e",
      "text": "Também tem fluido e compressor."
    },
    "p174": {
      "source_hash": "7f477276f4db",
      "text": "Então ligado"
    },
    "p175": {
      "source_hash": "be545d00643f",
      "text": "por que o quarto esfria?"
    },
    "p176": {
      "source_hash": "35fec431bc49",
      "text": "A resposta tá na varanda. Vamos lá!"
    },
    "p177": {
      "source_hash": "b60f6fc856c9",
      "text": "Uau, sai vento quente!"
    },
    "p178": {
      "source_hash": "31bccbba51df",
      "text": "É a unidade externa. O calor"
    },
    "p179": {
      "source_hash": "d61869418d48",
      "text": "veio de dentro do seu quarto."
    },
    "p180": {
      "source_hash": "91805969a0d7",
      "text": "Sei! Pega o ar de fora,"
    },
    "p181": {
      "source_hash": "64f138e91c2f",
      "text": "esfria e joga aqui!"
    },
    "p182": {
      "source_hash": "56b7cf461036",
      "text": "Muita gente acha. Mas ele sopra"
    },
    "p183": {
      "source_hash": "ce5381ed2aa4",
      "text": "o próprio ar do seu quarto."
    },
    "p184": {
      "source_hash": "810fd8c0bc0c",
      "text": "O da parede puxa o ar, tira calor e devolve."
    },
    "p185": {
      "source_hash": "ac94aeb4fba7",
      "text": "Dois canos ligam ele ao da varanda."
    },
    "p186": {
      "source_hash": "075b90beeb23",
      "text": "Neles, o fluido"
    },
    "p187": {
      "source_hash": "64eab5ac35ab",
      "text": "Lembra a geladeira?"
    },
    "p188": {
      "source_hash": "3883049c7a1b",
      "text": "O trenzinho!"
    },
    "p189": {
      "source_hash": "87514029d25a",
      "text": "O círculo é seu quarto: o dentro da geladeira,"
    },
    "p190": {
      "source_hash": "ffd8c07723e8",
      "text": "e o lado de trás foi pra fora."
    },
    "p191": {
      "source_hash": "f90421ab5108",
      "text": "O lado quente fora!"
    },
    "p192": {
      "source_hash": "27057a6795ea",
      "text": "Agora o calor sai do círculo e não volta,"
    },
    "p193": {
      "source_hash": "d9285d4e57a2",
      "text": "e aí o calor dentro diminui mesmo."
    },
    "p194": {
      "source_hash": "e76e131ecec3",
      "text": "A energia do ar vira calor"
    },
    "p195": {
      "source_hash": "4dc752fb85cc",
      "text": "e sai lá fora também."
    },
    "p196": {
      "source_hash": "d93a2caeb0d2",
      "text": "Com um raiozinho,"
    },
    "p197": {
      "source_hash": "b70d841e99c1",
      "text": "move várias de calor."
    },
    "p198": {
      "source_hash": "78a9bba627ff",
      "text": "Um raio, muito calor?"
    },
    "p199": {
      "source_hash": "adf8f49190f8",
      "text": "Quanto calor!"
    },
    "p200": {
      "source_hash": "c5fcf3400156",
      "text": "Depende do ar e do clima;"
    },
    "p201": {
      "source_hash": "9f4e09e91cfb",
      "text": "com calorão, ele sofre mais."
    },
    "p202": {
      "source_hash": "f4a3e7b259f0",
      "text": "E a porta grossa?"
    },
    "p203": {
      "source_hash": "4f7f8bd66f25",
      "text": "Com ar ligado, fechar janela e cortina"
    },
    "p204": {
      "source_hash": "22c0e9cfa253",
      "text": "é fechar a porta."
    },
    "p205": {
      "source_hash": "250d80e40dd7",
      "text": "Por isso fecha a janela!"
    },
    "p206": {
      "source_hash": "710940f0c9b4",
      "text": "O ar tira o calor,"
    },
    "p207": {
      "source_hash": "2698a5ea6c80",
      "text": "o isolante freia o calor que volta."
    },
    "p208": {
      "source_hash": "b809024d9aaa",
      "text": "Tira e segura!"
    },
    "p209": {
      "source_hash": "049df23e51ff",
      "text": "E com a janela aberta?"
    },
    "p210": {
      "source_hash": "d218ae468eaf",
      "text": "Igual à geladeira aberta: não para."
    },
    "p211": {
      "source_hash": "dfd9872abf53",
      "text": "O quarto é"
    },
    "p212": {
      "source_hash": "0eee606120bc",
      "text": "geladeirão!"
    },
    "p213": {
      "source_hash": "1a0fa704cc26",
      "text": "Isso, e você mora dentro dela."
    },
    "p214": {
      "source_hash": "f4168efd0a7f",
      "text": "Voltemos à cozinha. A porta tá aberta."
    },
    "p215": {
      "source_hash": "859f7800a50c",
      "text": "Minha ideia?"
    },
    "p216": {
      "source_hash": "1c7ea3d3eb29",
      "text": "Desisto dela!"
    },
    "p217": {
      "source_hash": "bf6960fa08f3",
      "text": "O lado quente fica"
    },
    "p218": {
      "source_hash": "137add139f63",
      "text": "aqui na cozinha!"
    },
    "p219": {
      "source_hash": "5dcc24284233",
      "text": "Ar e geladeira são iguais, né?"
    },
    "p220": {
      "source_hash": "7c70e3a0475c",
      "text": "Só muda onde fica o lado quente."
    },
    "p221": {
      "source_hash": "b1068e783445",
      "text": "Toca atrás da geladeira:"
    },
    "p222": {
      "source_hash": "fdbb4a8a9698",
      "text": "Lembra das três bolinhas? Esse morno são elas."
    },
    "p223": {
      "source_hash": "36d742bcb996",
      "text": "Entendi!"
    },
    "p224": {
      "source_hash": "b997a16cd350",
      "text": "Cadê a do seu ar?"
    },
    "p225": {
      "source_hash": "a7d234c4eb2e",
      "text": "Quão quente sopra? Comenta aí!"
    },
    "p226": {
      "source_hash": "88de677d4daa",
      "text": "Siga o Escritório do Ah, É Por Isso e ache os porquês!"
    }
  }
}
