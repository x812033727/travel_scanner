  },
  "lines": {
    "p001": {
      "source_hash": "b7172e801960",
      "text": "Bu! Panas banget,"
    },
    "p002": {
      "source_hash": "3f5b61642553",
      "text": "aku buka kulkas,"
    },
    "p003": {
      "source_hash": "168c59f250fe",
      "text": "wajahku adem!"
    },
    "p004": {
      "source_hash": "7bf79f51a091",
      "text": "Ide bagus!"
    },
    "p005": {
      "source_hash": "8b23cc53bc02",
      "text": "Pintunya dibuka,"
    },
    "p006": {
      "source_hash": "ec357ef013f5",
      "text": "dapur tak perlu AC lagi!"
    },
    "p007": {
      "source_hash": "8395747e3950",
      "text": "Jangan cabut AC!"
    },
    "p008": {
      "source_hash": "c88a1c380fdb",
      "text": "Tebak: pintu terus terbuka,"
    },
    "p009": {
      "source_hash": "7667289aae3d",
      "text": "dapur jadi sejuk atau malah panas?"
    },
    "p010": {
      "source_hash": "002e57b4aaa5",
      "text": "Panas?"
    },
    "p011": {
      "source_hash": "d5d7f4e1f933",
      "text": "Kulkas kan dingin!"
    },
    "p012": {
      "source_hash": "8a877c6d664c",
      "text": "Dekatkan tangan ke belakang kulkas."
    },
    "p013": {
      "source_hash": "5fad15bf2f6d",
      "text": "Di situ sama sekali tak dingin."
    },
    "p014": {
      "source_hash": "0b087fdc1ec2",
      "text": "Di belakang,"
    },
    "p015": {
      "source_hash": "e87865d778ae",
      "text": "ada apa, ya?"
    },
    "p016": {
      "source_hash": "915a9848b82a",
      "text": "Lalu kotak berdengung di balkon,"
    },
    "p017": {
      "source_hash": "d5da43348a89",
      "text": "anginnya dingin atau panas?"
    },
    "p018": {
      "source_hash": "64872e30b282",
      "text": "Kotak AC"
    },
    "p019": {
      "source_hash": "7ec9f7b51336",
      "text": "pasti anginnya dingin, kan?"
    },
    "p020": {
      "source_hash": "aee671c7ac12",
      "text": "Jawabannya ada di satu kulkas."
    },
    "p021": {
      "source_hash": "d329b4aea270",
      "text": "Saat pintunya terbuka, panasnya ke mana?"
    },
    "p022": {
      "source_hash": "f1fbe5370dca",
      "text": "Kulkas penuh dingin,"
    },
    "p023": {
      "source_hash": "db519e542b90",
      "text": "pintu dibuka, dinginnya keluar!"
    },
    "p024": {
      "source_hash": "8c8d0ac2f508",
      "text": "Ingat teh panas di meja?"
    },
    "p025": {
      "source_hash": "70f485a4b48d",
      "text": "Lama-lama jadi bagaimana?"
    },
    "p026": {
      "source_hash": "a1db32b61f99",
      "text": "Jadi hangat."
    },
    "p027": {
      "source_hash": "c1f7b9777c52",
      "text": "Panasnya pergi"
    },
    "p028": {
      "source_hash": "2561d58ec95e",
      "text": "Kalau es batu?"
    },
    "p029": {
      "source_hash": "29949618a983",
      "text": "Meleleh."
    },
    "p030": {
      "source_hash": "39f36455444d",
      "text": "Es meleleh karena panas udara di sekitarnya masuk."
    },
    "p031": {
      "source_hash": "225d245b624a",
      "text": "Dengan sendirinya, panas cuma pindah ke yang dingin."
    },
    "p032": {
      "source_hash": "61e8dce75fb3",
      "text": "Dingin?"
    },
    "p033": {
      "source_hash": "7072e93bbb8b",
      "text": "Udara dingin tak bisa pindah?"
    },
    "p034": {
      "source_hash": "d93c5aab02b6",
      "text": "Dingin itu panasnya sedikit."
    },
    "p035": {
      "source_hash": "034b4877b852",
      "text": "Dingin bukan benda yang kabur."
    },
    "p036": {
      "source_hash": "efca9195884d",
      "text": "Lalu wajahku"
    },
    "p037": {
      "source_hash": "a1d48a27d2ed",
      "text": "kok jadi adem?"
    },
    "p038": {
      "source_hash": "70e3b42cdb9f",
      "text": "Udara dingin keluar, menyentuh wajahmu,"
    },
    "p039": {
      "source_hash": "95fd93cf0b40",
      "text": "panas wajahmu pindah ke udara itu."
    },
    "p040": {
      "source_hash": "0bb13789f451",
      "text": "Panasku dicuri!"
    },
    "p041": {
      "source_hash": "b6d74c1d6dcf",
      "text": "Ayo gambar satu lingkaran."
    },
    "p042": {
      "source_hash": "8094f53d46b8",
      "text": "Panas yang masuk atau keluar, kita catat."
    },
    "p043": {
      "source_hash": "7f741889678a",
      "text": "Panas jadi bola-bola merah."
    },
    "p044": {
      "source_hash": "aa7814faf297",
      "text": "Mulai dari dalam kulkas."
    },
    "p045": {
      "source_hash": "f40432e0831b",
      "text": "Rak atas cuma 3 sampai 5 derajat,"
    },
    "p046": {
      "source_hash": "1635dcd9825b",
      "text": "jauh lebih dingin dari dapur."
    },
    "p047": {
      "source_hash": "c88b1e8516c1",
      "text": "Freezer di bawah, tebak?"
    },
    "p048": {
      "source_hash": "0e6fe5844c83",
      "text": "Biasanya minus 18 derajat, bahkan lebih."
    },
    "p049": {
      "source_hash": "2c4f1b1915af",
      "text": "Minus 18!"
    },
    "p050": {
      "source_hash": "e4562096a5cd",
      "text": "Lebih dingin dari musim dingin!"
    },
    "p051": {
      "source_hash": "d5d8dd87011b",
      "text": "Makin beda suhu, panas makin menyusup."
    },
    "p052": {
      "source_hash": "69606f40df49",
      "text": "Panas dapur"
    },
    "p053": {
      "source_hash": "e8044ff9c033",
      "text": "mau masuk kulkas?"
    },
    "p054": {
      "source_hash": "84858753c1b7",
      "text": "Mau. Panas selalu pergi ke yang dingin."
    },
    "p055": {
      "source_hash": "0c159cbff7e5",
      "text": "Tapi pintunya menahan sedikit."
    },
    "p056": {
      "source_hash": "399cfe6588f9",
      "text": "Pegang tepi pintunya,"
    },
    "p057": {
      "source_hash": "5a88375b6bd5",
      "text": "tebal, berat, ada karet lembut di tepinya."
    },
    "p058": {
      "source_hash": "e08d08650ed0",
      "text": "Tebal kayak termos!"
    },
    "p059": {
      "source_hash": "185271b7781d",
      "text": "Ya, isinya bahan penahan panas."
    },
    "p060": {
      "source_hash": "59b39972f5f2",
      "text": "Itu insulasi: panas jadi lambat."
    },
    "p061": {
      "source_hash": "796ec4046f41",
      "text": "Ingat pintu tebal ini, nanti muncul lagi."
    },
    "p062": {
      "source_hash": "bd96aec42c6c",
      "text": "Cuma lambat?"
    },
    "p063": {
      "source_hash": "13f4d5f3db90",
      "text": "Panas tetap masuk?"
    },
    "p064": {
      "source_hash": "3b92cd9d7d93",
      "text": "Ya. Tapi tetap dingin,"
    },
    "p065": {
      "source_hash": "57ef5c8a1fbc",
      "text": "artinya ada yang membuang panas."
    },
    "p066": {
      "source_hash": "a0c91d1c24f5",
      "text": "Bola panas dikirim keluar satu-satu."
    },
    "p067": {
      "source_hash": "47283fea74d1",
      "text": "Panas"
    },
    "p068": {
      "source_hash": "41ee68987691",
      "text": "dibawa ke mana?"
    },
    "p069": {
      "source_hash": "be11f6a5a898",
      "text": "Apa kulkasnya"
    },
    "p070": {
      "source_hash": "0cec453a5dc3",
      "text": "memakan panas?"
    },
    "p071": {
      "source_hash": "7becdf761571",
      "text": "Panas tak hilang, cuma pindah."
    },
    "p072": {
      "source_hash": "5ef3679c80b5",
      "text": "Coba lihat belakang kulkas."
    },
    "p073": {
      "source_hash": "6f0e9e8688bc",
      "text": "Eh? Hangat!"
    },
    "p074": {
      "source_hash": "73d24cbaae95",
      "text": "Ada angin!"
    },
    "p075": {
      "source_hash": "a49f26eea7ea",
      "text": "Dekatkan saja; ada kabel, jangan dipegang."
    },
    "p076": {
      "source_hash": "462c50c43919",
      "text": "Pipa berkelok di sini terasa hangat."
    },
    "p077": {
      "source_hash": "380e8fd1a016",
      "text": "Panas yang hilang dari dalam keluar sini."
    },
    "p078": {
      "source_hash": "e95a80445e89",
      "text": "Panasnya ke belakang!"
    },
    "p079": {
      "source_hash": "9bce21fe93ad",
      "text": "Ada kulkas meniup hangat dari bawah,"
    },
    "p080": {
      "source_hash": "15ffc9f633b5",
      "text": "kakimu pernah tertiup saat di depannya?"
    },
    "p081": {
      "source_hash": "d8391d830a0b",
      "text": "Kaki anget"
    },
    "p082": {
      "source_hash": "34ab9467f167",
      "text": "wajah adem!"
    },
    "p083": {
      "source_hash": "ee2e6d9cc774",
      "text": "Kulkas tak punya tangan,"
    },
    "p084": {
      "source_hash": "d152ca25322f",
      "text": "gimana bawa panas?"
    },
    "p085": {
      "source_hash": "0751b621f960",
      "text": "Di pipanya ada sesuatu yang berputar,"
    },
    "p086": {
      "source_hash": "33f41bdbb110",
      "text": "namanya refrigeran."
    },
    "p087": {
      "source_hash": "1bc9f4cd28e1",
      "text": "Hah?"
    },
    "p088": {
      "source_hash": "ff6c7307a4e7",
      "text": "Itu dingin?"
    },
    "p089": {
      "source_hash": "572d772e9217",
      "text": "Tak selalu, tapi bisa berubah. Habis mandi,"
    },
    "p090": {
      "source_hash": "2a481522d9d1",
      "text": "keluar basah-basah, menggigil, kan?"
    },
    "p091": {
      "source_hash": "83ec21889dbc",
      "text": "Iya! Air panas, lho!"
    },
    "p092": {
      "source_hash": "0e3109c97ff4",
      "text": "Air di tubuhmu menguap dan terbang,"
    },
    "p093": {
      "source_hash": "205b3b934b24",
      "text": "membawa panas tubuhmu."
    },
    "p094": {
      "source_hash": "ba6b32042453",
      "text": "Makanya basah itu dingin!"
    },
    "p095": {
      "source_hash": "b68f95bdbd47",
      "text": "Di dalam kulkas, refrigeran juga cair jadi gas,"
    },
    "p096": {
      "source_hash": "2964963c1cc3",
      "text": "membawa panas ke dalam pipa."
    },
    "p097": {
      "source_hash": "d88e32ea3e04",
      "text": "Sedingin itu,"
    },
    "p098": {
      "source_hash": "766d0cb1f76c",
      "text": "refrigeran bisa jadi gas?"
    },
    "p099": {
      "source_hash": "8cd725bde610",
      "text": "Bisa. Refrigeran gampang mendidih,"
    },
    "p100": {
      "source_hash": "65e692591700",
      "text": "sedikit panas kulkas cukup jadi gas."
    },
    "p101": {
      "source_hash": "42846c9e49a7",
      "text": "Dingin kok didih?"
    },
    "p102": {
      "source_hash": "bb4a69618061",
      "text": "Cairan yang aneh!"
    },
    "p103": {
      "source_hash": "7518a2b18c99",
      "text": "Gas panasnya"
    },
    "p104": {
      "source_hash": "9eb4faf4c902",
      "text": "lalu ke mana?"
    },
    "p105": {
      "source_hash": "e48936cab7ce",
      "text": "Masuk ke tabung bundar."
    },
    "p106": {
      "source_hash": "28f428d21fb9",
      "text": "Tabung itu namanya kompresor."
    },
    "p107": {
      "source_hash": "c7d417713f75",
      "text": "Kompresor memampatkan gas."
    },
    "p108": {
      "source_hash": "3e9aa7d87bce",
      "text": "Refrigeran yang dimampatkan ke pipa belakang,"
    },
    "p109": {
      "source_hash": "bbff0f0a54f8",
      "text": "jadi cair, panasnya diberi ke dapur."
    },
    "p110": {
      "source_hash": "77a975998970",
      "text": "Lalu kembali ke dalam, berputar lagi."
    },
    "p111": {
      "source_hash": "63db4baa6c9b",
      "text": "Kayak kereta pembawa panas!"
    },
    "p112": {
      "source_hash": "7baf69c37ec5",
      "text": "Mirip. Berputar terus, membawa panas dari dalam ke luar."
    },
    "p113": {
      "source_hash": "7e942b397d8b",
      "text": "Kereta itu perlu didorong?"
    },
    "p114": {
      "source_hash": "12652fd29511",
      "text": "Listrik. Memampatkan gas itu berat,"
    },
    "p115": {
      "source_hash": "be8011a3125a",
      "text": "kompresor perlu listrik terus."
    },
    "p116": {
      "source_hash": "049788cf513e",
      "text": "Listrik kita gambar jadi petir kuning."
    },
    "p117": {
      "source_hash": "24ab05860f20",
      "text": "Tak terus jalan: kalau hangat, ia kerja,"
    },
    "p118": {
      "source_hash": "e55082a0f762",
      "text": "dingin, ia rehat."
    },
    "p119": {
      "source_hash": "55d81ae16193",
      "text": "Pantas kadang sepi!"
    },
    "p120": {
      "source_hash": "d3da14b332db",
      "text": "Listriknya,"
    },
    "p121": {
      "source_hash": "f2ab77da9298",
      "text": "akhirnya ke mana?"
    },
    "p122": {
      "source_hash": "73b7521ec063",
      "text": "Lalu panas belakang,"
    },
    "p123": {
      "source_hash": "e4f1584f39bf",
      "text": "sama banyak"
    },
    "p124": {
      "source_hash": "75df1cd5c7e7",
      "text": "dari dalam?"
    },
    "p125": {
      "source_hash": "f2255ae9f464",
      "text": "Lingkarannya kita perbesar,"
    },
    "p126": {
      "source_hash": "7d4bf8b2e882",
      "text": "seluruh dapur masuk."
    },
    "p127": {
      "source_hash": "aa50778a6617",
      "text": "Kulkas, belakangnya, dan kamu,"
    },
    "p128": {
      "source_hash": "71e36c86143b",
      "text": "sekarang dalam satu lingkaran."
    },
    "p129": {
      "source_hash": "3b7d5d97c732",
      "text": "Pintu tutup, angka gampang:"
    },
    "p130": {
      "source_hash": "43ca28d04bce",
      "text": "kulkas membuang dua bola panas,"
    },
    "p131": {
      "source_hash": "cd9ee06bf0f3",
      "text": "kompresor pakai satu listrik."
    },
    "p132": {
      "source_hash": "1a9aba9a876d",
      "text": "Keluar berapa bola?"
    },
    "p133": {
      "source_hash": "62a7c0ee0d48",
      "text": "Tiga. Dua tadi, ditambah satu."
    },
    "p134": {
      "source_hash": "80fd1b3727a5",
      "text": "Satu itu dari listrik kompresor."
    },
    "p135": {
      "source_hash": "26ae01210cdc",
      "text": "Yang keluar lebih banyak!"
    },
    "p136": {
      "source_hash": "e760c2879753",
      "text": "Ya. Listrik tak hilang, akhirnya jadi panas."
    },
    "p137": {
      "source_hash": "a5c13336517a",
      "text": "Pintu tertutup, dapur jadi panas?"
    },
    "p138": {
      "source_hash": "e98d5b7e0889",
      "text": "Dua bola itu tadinya menyusup lewat dinding, pintu."
    },
    "p139": {
      "source_hash": "ede7b25ad758",
      "text": "Kini balik ke dapur, plus satu dari listrik."
    },
    "p140": {
      "source_hash": "36f06a827477",
      "text": "Jadi meski tertutup,"
    },
    "p141": {
      "source_hash": "3254249642e1",
      "text": "dapur jadi lebih panas?"
    },
    "p142": {
      "source_hash": "f76687cf1119",
      "text": "Ya, selama kulkas jalan, dapur sedikit lebih panas."
    },
    "p143": {
      "source_hash": "005ebd05fb40",
      "text": "Kalau pintu"
    },
    "p144": {
      "source_hash": "0e34bb8e2063",
      "text": "kubuka?"
    },
    "p145": {
      "source_hash": "625dc61639d1",
      "text": "Panas dapur masuk lewat pintu,"
    },
    "p146": {
      "source_hash": "e4c425ec5331",
      "text": "kulkas membuangnya lagi ke dapur."
    },
    "p147": {
      "source_hash": "2ddd2f1d3e23",
      "text": "Panasnya muter-muter!"
    },
    "p148": {
      "source_hash": "98bf9e64094d",
      "text": "Ya, dua bola itu masuk lagi lewat pintu,"
    },
    "p149": {
      "source_hash": "993448b744d4",
      "text": "panas dapur tak berkurang satu pun."
    },
    "p150": {
      "source_hash": "e25151dec489",
      "text": "Tapi tiap putaran, petir"
    },
    "p151": {
      "source_hash": "b941f4490e4d",
      "text": "menambah satu bola panas."
    },
    "p152": {
      "source_hash": "5d4a730599d5",
      "text": "Jadi pintu terbuka,"
    },
    "p153": {
      "source_hash": "defd13d28935",
      "text": "dapur malah panas!"
    },
    "p154": {
      "source_hash": "034e0dbc348d",
      "text": "Tapi di depan pintu"
    },
    "p155": {
      "source_hash": "5b6396465b28",
      "text": "memang adem!"
    },
    "p156": {
      "source_hash": "3677bf0254a1",
      "text": "Benar, di depan pintu memang sejuk."
    },
    "p157": {
      "source_hash": "01bf3f39f165",
      "text": "Tapi kamu pergi, sejuknya tak berguna."
    },
    "p158": {
      "source_hash": "f77e16007326",
      "text": "Dalam kulkas terus hangat,"
    },
    "p159": {
      "source_hash": "382ef4689927",
      "text": "kompresor tak berhenti, terus pakai listrik."
    },
    "p160": {
      "source_hash": "1e062ea5c74d",
      "text": "Kasihan kulkasnya!"
    },
    "p161": {
      "source_hash": "c9604ed3360d",
      "text": "Meteran listrik juga,"
    },
    "p162": {
      "source_hash": "70427cb4f5c3",
      "text": "tagihan ikut naik."
    },
    "p163": {
      "source_hash": "d86a30ddd6a2",
      "text": "Kulkas terbuka itu"
    },
    "p164": {
      "source_hash": "4531a6e99a75",
      "text": "kayak pemanas ruangan?"
    },
    "p165": {
      "source_hash": "c9d31a47be23",
      "text": "Mirip. Cuma memutar,"
    },
    "p166": {
      "source_hash": "7fe1c5c54c52",
      "text": "dan isi kulkas ikut jadi hangat."
    },
    "p167": {
      "source_hash": "049670cdb014",
      "text": "Inilah tipuan kulkas:"
    },
    "p168": {
      "source_hash": "aa856c62028b",
      "text": "ia pemindah panas, bukan pembuat dingin."
    },
    "p169": {
      "source_hash": "b2de70b627aa",
      "text": "Aku tertipu!"
    },
    "p170": {
      "source_hash": "5a19c061ddb5",
      "text": "Kalau AC?"
    },
    "p171": {
      "source_hash": "10f181af712d",
      "text": "AC juga pemindah panas?"
    },
    "p172": {
      "source_hash": "6624f41099c1",
      "text": "Ya. AC dan kulkas mesin yang sama."
    },
    "p173": {
      "source_hash": "a658a955447e",
      "text": "Ada refrigeran, kompresor, pakai listrik."
    },
    "p174": {
      "source_hash": "7f477276f4db",
      "text": "Lalu AC"
    },
    "p175": {
      "source_hash": "be545d00643f",
      "text": "kok bisa bikin kamar sejuk?"
    },
    "p176": {
      "source_hash": "35fec431bc49",
      "text": "Jawabannya di balkon. Yuk lihat ke sana."
    },
    "p177": {
      "source_hash": "b60f6fc856c9",
      "text": "Wah, anginnya panas!"
    },
    "p178": {
      "source_hash": "31bccbba51df",
      "text": "Ini unit outdoor. Panasnya"
    },
    "p179": {
      "source_hash": "d61869418d48",
      "text": "diangkut dari dalam kamarmu."
    },
    "p180": {
      "source_hash": "91805969a0d7",
      "text": "Aku tahu! Udara luar"
    },
    "p181": {
      "source_hash": "64f138e91c2f",
      "text": "didinginkan, ditiup!"
    },
    "p182": {
      "source_hash": "56b7cf461036",
      "text": "Banyak yang kira begitu. Padahal AC"
    },
    "p183": {
      "source_hash": "ce5381ed2aa4",
      "text": "meniup udara kamarmu sendiri."
    },
    "p184": {
      "source_hash": "810fd8c0bc0c",
      "text": "Unit dinding sedot udara, ambil panas, tiup balik."
    },
    "p185": {
      "source_hash": "ac94aeb4fba7",
      "text": "Ia dan unit balkon disambung dua pipa."
    },
    "p186": {
      "source_hash": "075b90beeb23",
      "text": "Refrigeran berputar,"
    },
    "p187": {
      "source_hash": "64eab5ac35ab",
      "text": "mirip apa di kulkas?"
    },
    "p188": {
      "source_hash": "3883049c7a1b",
      "text": "Kereta panas!"
    },
    "p189": {
      "source_hash": "87514029d25a",
      "text": "Kini lingkari kamarmu: kamar itu bagian dalam kulkas,"
    },
    "p190": {
      "source_hash": "ffd8c07723e8",
      "text": "dan belakang kulkas di luar."
    },
    "p191": {
      "source_hash": "f90421ab5108",
      "text": "Bagian panas di luar!"
    },
    "p192": {
      "source_hash": "27057a6795ea",
      "text": "Kini panas dibuang ke luar, tak langsung balik,"
    },
    "p193": {
      "source_hash": "d9285d4e57a2",
      "text": "panas di dalam benar-benar berkurang."
    },
    "p194": {
      "source_hash": "e76e131ecec3",
      "text": "Listrik AC juga jadi panas,"
    },
    "p195": {
      "source_hash": "4dc752fb85cc",
      "text": "ikut keluar di unit outdoor."
    },
    "p196": {
      "source_hash": "d93a2caeb0d2",
      "text": "AC biasa, 1 listrik"
    },
    "p197": {
      "source_hash": "b70d841e99c1",
      "text": "memindah beberapa panas."
    },
    "p198": {
      "source_hash": "78a9bba627ff",
      "text": "Satu listrik, banyak panas?"
    },
    "p199": {
      "source_hash": "adf8f49190f8",
      "text": "Banyak banget!"
    },
    "p200": {
      "source_hash": "c5fcf3400156",
      "text": "Tergantung AC dan cuaca,"
    },
    "p201": {
      "source_hash": "9f4e09e91cfb",
      "text": "makin panas luar, makin berat."
    },
    "p202": {
      "source_hash": "f4a3e7b259f0",
      "text": "Ingat pintu tebal?"
    },
    "p203": {
      "source_hash": "4f7f8bd66f25",
      "text": "Saat AC nyala, kamu tutup jendela dan tirai,"
    },
    "p204": {
      "source_hash": "22c0e9cfa253",
      "text": "itu pintu tebalnya."
    },
    "p205": {
      "source_hash": "250d80e40dd7",
      "text": "Makanya jendela ditutup!"
    },
    "p206": {
      "source_hash": "710940f0c9b4",
      "text": "AC memindah panas keluar,"
    },
    "p207": {
      "source_hash": "2698a5ea6c80",
      "text": "insulasi bikin panas luar lambat kembali."
    },
    "p208": {
      "source_hash": "b809024d9aaa",
      "text": "Angkut dan tahan!"
    },
    "p209": {
      "source_hash": "049df23e51ff",
      "text": "Kalau jendela terbuka?"
    },
    "p210": {
      "source_hash": "d218ae468eaf",
      "text": "Sama kayak kulkas terbuka, tak berhenti."
    },
    "p211": {
      "source_hash": "dfd9872abf53",
      "text": "Kamar AC"
    },
    "p212": {
      "source_hash": "0eee606120bc",
      "text": "kulkas besar!"
    },
    "p213": {
      "source_hash": "1a0fa704cc26",
      "text": "Ya, dan kamu tinggal di dalamnya."
    },
    "p214": {
      "source_hash": "f4168efd0a7f",
      "text": "Yuk balik ke dapur. Pintunya masih terbuka."
    },
    "p215": {
      "source_hash": "859f7800a50c",
      "text": "Ide bagusku?"
    },
    "p216": {
      "source_hash": "1c7ea3d3eb29",
      "text": "Aku tarik lagi!"
    },
    "p217": {
      "source_hash": "bf6960fa08f3",
      "text": "Bagian panasnya"
    },
    "p218": {
      "source_hash": "137add139f63",
      "text": "masih di dapur!"
    },
    "p219": {
      "source_hash": "5dcc24284233",
      "text": "Kulkas dan AC mesin yang sama, kan?"
    },
    "p220": {
      "source_hash": "7c70e3a0475c",
      "text": "Bedanya: bagian panas di dalam atau luar."
    },
    "p221": {
      "source_hash": "b1068e783445",
      "text": "Nanti, raba belakang kulkas:"
    },
    "p222": {
      "source_hash": "fdbb4a8a9698",
      "text": "Ingat tiga bola merah? Hangat itu ya mereka."
    },
    "p223": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p224": {
      "source_hash": "b997a16cd350",
      "text": "Unit outdoor di mana?"
    },
    "p225": {
      "source_hash": "a7d234c4eb2e",
      "text": "Seberapa panas? Tulis di komentar."
    },
    "p226": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
