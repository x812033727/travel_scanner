  },
  "lines": {
    "p001": {
      "source_hash": "b7172e801960",
      "text": "소장님! 더워요!"
    },
    "p002": {
      "source_hash": "3f5b61642553",
      "text": "냉장고 여니까"
    },
    "p003": {
      "source_hash": "168c59f250fe",
      "text": "얼굴이 시원해요!"
    },
    "p004": {
      "source_hash": "7bf79f51a091",
      "text": "좋은 수!"
    },
    "p005": {
      "source_hash": "8b23cc53bc02",
      "text": "문을 계속 열면"
    },
    "p006": {
      "source_hash": "ec357ef013f5",
      "text": "에어컨 필요 없겠죠!"
    },
    "p007": {
      "source_hash": "8395747e3950",
      "text": "플러그는 아직!"
    },
    "p008": {
      "source_hash": "c88a1c380fdb",
      "text": "맞혀 봐. 문을 계속 열면"
    },
    "p009": {
      "source_hash": "7667289aae3d",
      "text": "부엌이 시원해질까, 더워질까?"
    },
    "p010": {
      "source_hash": "002e57b4aaa5",
      "text": "더워?"
    },
    "p011": {
      "source_hash": "d5d7f4e1f933",
      "text": "냉장고는 차갑잖아요!"
    },
    "p012": {
      "source_hash": "8a877c6d664c",
      "text": "냉장고 뒤에 손을 대 봐."
    },
    "p013": {
      "source_hash": "5fad15bf2f6d",
      "text": "거긴 전혀 안 차가워."
    },
    "p014": {
      "source_hash": "0b087fdc1ec2",
      "text": "냉장고 뒤에"
    },
    "p015": {
      "source_hash": "e87865d778ae",
      "text": "뭐가 있어요?"
    },
    "p016": {
      "source_hash": "915a9848b82a",
      "text": "베란다에서 윙윙 도는 큰 상자,"
    },
    "p017": {
      "source_hash": "d5da43348a89",
      "text": "그 바람은 찬 바람일까, 더운 바람일까?"
    },
    "p018": {
      "source_hash": "64872e30b282",
      "text": "에어컨?"
    },
    "p019": {
      "source_hash": "7ec9f7b51336",
      "text": "당연히 찬 바람이죠?"
    },
    "p020": {
      "source_hash": "aee671c7ac12",
      "text": "답은 다 이 냉장고에 있어."
    },
    "p021": {
      "source_hash": "d329b4aea270",
      "text": "문을 열면, 열은 어디로 갈까?"
    },
    "p022": {
      "source_hash": "f1fbe5370dca",
      "text": "안에 냉기가 가득,"
    },
    "p023": {
      "source_hash": "db519e542b90",
      "text": "열면 냉기가 나와요!"
    },
    "p024": {
      "source_hash": "8c8d0ac2f508",
      "text": "뜨거운 차 식혀 봤어?"
    },
    "p025": {
      "source_hash": "70f485a4b48d",
      "text": "식탁에 두면 어떻게 돼?"
    },
    "p026": {
      "source_hash": "a1db32b61f99",
      "text": "미지근해요."
    },
    "p027": {
      "source_hash": "c1f7b9777c52",
      "text": "열이 갔어요!"
    },
    "p028": {
      "source_hash": "2561d58ec95e",
      "text": "얼음은?"
    },
    "p029": {
      "source_hash": "29949618a983",
      "text": "천천히 녹아요."
    },
    "p030": {
      "source_hash": "39f36455444d",
      "text": "얼음이 녹는 건 공기의 열이 들어가서야."
    },
    "p031": {
      "source_hash": "225d245b624a",
      "text": "열은 스스로 뜨거운 데서 찬 데로만 가."
    },
    "p032": {
      "source_hash": "61e8dce75fb3",
      "text": "냉기는?"
    },
    "p033": {
      "source_hash": "7072e93bbb8b",
      "text": "찬 공기는 안 움직여요?"
    },
    "p034": {
      "source_hash": "d93c5aab02b6",
      "text": "차가움은 열이 적은 거야."
    },
    "p035": {
      "source_hash": "034b4877b852",
      "text": "냉기는 새어 나오는 게 아냐."
    },
    "p036": {
      "source_hash": "efca9195884d",
      "text": "그럼 얼굴은"
    },
    "p037": {
      "source_hash": "a1d48a27d2ed",
      "text": "왜 시원했어요?"
    },
    "p038": {
      "source_hash": "70e3b42cdb9f",
      "text": "찬 공기가 나와 얼굴에 닿으면,"
    },
    "p039": {
      "source_hash": "95fd93cf0b40",
      "text": "얼굴 열이 그 공기로 가."
    },
    "p040": {
      "source_hash": "0bb13789f451",
      "text": "열을 뺏겼어요!"
    },
    "p041": {
      "source_hash": "b6d74c1d6dcf",
      "text": "원을 그려 열을 따라가자."
    },
    "p042": {
      "source_hash": "8094f53d46b8",
      "text": "원 안의 열이 늘든 줄든 다 적어 둘게."
    },
    "p043": {
      "source_hash": "7f741889678a",
      "text": "열은 빨간 공으로 그릴게."
    },
    "p044": {
      "source_hash": "aa7814faf297",
      "text": "먼저 냉장고 안만."
    },
    "p045": {
      "source_hash": "f40432e0831b",
      "text": "냉장실은 3도에서 5도쯤,"
    },
    "p046": {
      "source_hash": "1635dcd9825b",
      "text": "여름 부엌보다 훨씬 차."
    },
    "p047": {
      "source_hash": "c88b1e8516c1",
      "text": "냉동실은 몇 도일까?"
    },
    "p048": {
      "source_hash": "0e6fe5844c83",
      "text": "보통 영하 18도, 더 낮기도 해."
    },
    "p049": {
      "source_hash": "2c4f1b1915af",
      "text": "영하18!"
    },
    "p050": {
      "source_hash": "e4562096a5cd",
      "text": "대만 겨울보다 추워요!"
    },
    "p051": {
      "source_hash": "d5d8dd87011b",
      "text": "안팎 차이가 클수록 열이 급해져."
    },
    "p052": {
      "source_hash": "69606f40df49",
      "text": "부엌 열이"
    },
    "p053": {
      "source_hash": "e8044ff9c033",
      "text": "냉장고로 가요?"
    },
    "p054": {
      "source_hash": "84858753c1b7",
      "text": "응. 그 규칙대로 열은 찬 데로."
    },
    "p055": {
      "source_hash": "0c159cbff7e5",
      "text": "그런데 문이 막아 줘."
    },
    "p056": {
      "source_hash": "399cfe6588f9",
      "text": "문 테두리 만져 봐."
    },
    "p057": {
      "source_hash": "5a88375b6bd5",
      "text": "두껍고 무겁고, 말랑한 고무가 있어."
    },
    "p058": {
      "source_hash": "e08d08650ed0",
      "text": "보온병처럼 두꺼워!"
    },
    "p059": {
      "source_hash": "185271b7781d",
      "text": "응. 문과 벽에 단열재가."
    },
    "p060": {
      "source_hash": "59b39972f5f2",
      "text": "단열이야. 열이 늦게 들어와."
    },
    "p061": {
      "source_hash": "796ec4046f41",
      "text": "이 두꺼운 문, 기억해. 또 나와."
    },
    "p062": {
      "source_hash": "bd96aec42c6c",
      "text": "늦게만요?"
    },
    "p063": {
      "source_hash": "13f4d5f3db90",
      "text": "열이 들어와요?"
    },
    "p064": {
      "source_hash": "3b92cd9d7d93",
      "text": "응. 그래도 차갑지."
    },
    "p065": {
      "source_hash": "57ef5c8a1fbc",
      "text": "뭔가 열을 계속 내보낸단 뜻."
    },
    "p066": {
      "source_hash": "a0c91d1c24f5",
      "text": "원 안의 열이 하나씩 밖으로."
    },
    "p067": {
      "source_hash": "47283fea74d1",
      "text": "그 열"
    },
    "p068": {
      "source_hash": "41ee68987691",
      "text": "어디로 가요?"
    },
    "p069": {
      "source_hash": "be11f6a5a898",
      "text": "냉장고가"
    },
    "p070": {
      "source_hash": "0cec453a5dc3",
      "text": "열을 먹었나?"
    },
    "p071": {
      "source_hash": "7becdf761571",
      "text": "열은 안 사라져. 자리만 옮겨."
    },
    "p072": {
      "source_hash": "5ef3679c80b5",
      "text": "냉장고 뒤로 가 봐."
    },
    "p073": {
      "source_hash": "6f0e9e8688bc",
      "text": "어? 따뜻해요!"
    },
    "p074": {
      "source_hash": "73d24cbaae95",
      "text": "더운 바람!"
    },
    "p075": {
      "source_hash": "a49f26eea7ea",
      "text": "손만 대 봐. 전선 있으니 넣지 말고."
    },
    "p076": {
      "source_hash": "462c50c43919",
      "text": "뒤쪽 구불구불한 관이 따뜻하지."
    },
    "p077": {
      "source_hash": "380e8fd1a016",
      "text": "안에서 줄어든 열이 여기로 나와."
    },
    "p078": {
      "source_hash": "e95a80445e89",
      "text": "열이 뒤로 갔네요!"
    },
    "p079": {
      "source_hash": "9bce21fe93ad",
      "text": "밑으로 더운 바람 내는 것도 있어"
    },
    "p080": {
      "source_hash": "15ffc9f633b5",
      "text": "앞에 서면 발에 바람 느껴지지?"
    },
    "p081": {
      "source_hash": "d8391d830a0b",
      "text": "발은 따뜻"
    },
    "p082": {
      "source_hash": "34ab9467f167",
      "text": "얼굴은 시원!"
    },
    "p083": {
      "source_hash": "ee2e6d9cc774",
      "text": "냉장고는 손도 없는데"
    },
    "p084": {
      "source_hash": "d152ca25322f",
      "text": "어떻게 옮겨요?"
    },
    "p085": {
      "source_hash": "0751b621f960",
      "text": "관 속에서 빙빙 도는 게 있는데,"
    },
    "p086": {
      "source_hash": "33f41bdbb110",
      "text": "냉매라고 해."
    },
    "p087": {
      "source_hash": "1bc9f4cd28e1",
      "text": "냉매"
    },
    "p088": {
      "source_hash": "ff6c7307a4e7",
      "text": "그게 차가워요?"
    },
    "p089": {
      "source_hash": "572d772e9217",
      "text": "꼭 차진 않지만 변신해. 샤워하고"
    },
    "p090": {
      "source_hash": "2a481522d9d1",
      "text": "젖은 채 나오면 덜덜 떨리지?"
    },
    "p091": {
      "source_hash": "83ec21889dbc",
      "text": "네! 더운 물인데!"
    },
    "p092": {
      "source_hash": "0e3109c97ff4",
      "text": "몸의 물이 수증기로 날아가면서"
    },
    "p093": {
      "source_hash": "205b3b934b24",
      "text": "몸의 열을 가져가."
    },
    "p094": {
      "source_hash": "ba6b32042453",
      "text": "그래서 추운 거구나!"
    },
    "p095": {
      "source_hash": "b68f95bdbd47",
      "text": "냉매도 안에서 액체가 기체로 바뀌며"
    },
    "p096": {
      "source_hash": "2964963c1cc3",
      "text": "안의 열을 관으로 옮겨."
    },
    "p097": {
      "source_hash": "d88e32ea3e04",
      "text": "그렇게 찬데"
    },
    "p098": {
      "source_hash": "766d0cb1f76c",
      "text": "기체가 돼요?"
    },
    "p099": {
      "source_hash": "8cd725bde610",
      "text": "응. 냉매는 잘 끓는 특별한 액체라,"
    },
    "p100": {
      "source_hash": "65e692591700",
      "text": "냉장고 속 작은 열로도 기체가 돼."
    },
    "p101": {
      "source_hash": "42846c9e49a7",
      "text": "찬데 끓어요?"
    },
    "p102": {
      "source_hash": "bb4a69618061",
      "text": "신기한 액체네요!"
    },
    "p103": {
      "source_hash": "7518a2b18c99",
      "text": "열 든 기체"
    },
    "p104": {
      "source_hash": "9eb4faf4c902",
      "text": "다음엔요?"
    },
    "p105": {
      "source_hash": "e48936cab7ce",
      "text": "둥근 쇠통으로 가."
    },
    "p106": {
      "source_hash": "28f428d21fb9",
      "text": "이 통이 압축기야."
    },
    "p107": {
      "source_hash": "c7d417713f75",
      "text": "압축기가 꽉 눌러."
    },
    "p108": {
      "source_hash": "3e9aa7d87bce",
      "text": "눌린 냉매는 뒤쪽 관으로 흘러가"
    },
    "p109": {
      "source_hash": "bbff0f0a54f8",
      "text": "액체로 돌아가며 부엌에 열을 줘."
    },
    "p110": {
      "source_hash": "77a975998970",
      "text": "다시 안으로 와서 또 한 바퀴."
    },
    "p111": {
      "source_hash": "63db4baa6c9b",
      "text": "열 싣는 꼬마 기차!"
    },
    "p112": {
      "source_hash": "7baf69c37ec5",
      "text": "맞아. 빙글빙글, 열을 안에서 밖으로."
    },
    "p113": {
      "source_hash": "7e942b397d8b",
      "text": "기차는 누가 밀어요?"
    },
    "p114": {
      "source_hash": "12652fd29511",
      "text": "전기야. 기체를 누르는 건 힘들어서"
    },
    "p115": {
      "source_hash": "be8011a3125a",
      "text": "압축기는 계속 전기를 먹어."
    },
    "p116": {
      "source_hash": "049788cf513e",
      "text": "전기는 노란 번개로 그릴게."
    },
    "p117": {
      "source_hash": "24ab05860f20",
      "text": "늘 돌진 않아. 데워지면 켜지고,"
    },
    "p118": {
      "source_hash": "e55082a0f762",
      "text": "차가우면 쉬어."
    },
    "p119": {
      "source_hash": "55d81ae16193",
      "text": "그래서 조용할 때가 있구나!"
    },
    "p120": {
      "source_hash": "d3da14b332db",
      "text": "먹은 전기는"
    },
    "p121": {
      "source_hash": "f2ab77da9298",
      "text": "어디로 가요?"
    },
    "p122": {
      "source_hash": "73b7521ec063",
      "text": "뒤로 나온 열이"
    },
    "p123": {
      "source_hash": "e4f1584f39bf",
      "text": "안의 열과"
    },
    "p124": {
      "source_hash": "75df1cd5c7e7",
      "text": "같아요?"
    },
    "p125": {
      "source_hash": "f2255ae9f464",
      "text": "답하려면 원을 크게,"
    },
    "p126": {
      "source_hash": "7d4bf8b2e882",
      "text": "부엌 전체를 넣자."
    },
    "p127": {
      "source_hash": "aa50778a6617",
      "text": "냉장고, 그 뒤, 네가 선 곳,"
    },
    "p128": {
      "source_hash": "71e36c86143b",
      "text": "이제 다 한 원 안이야."
    },
    "p129": {
      "source_hash": "3b7d5d97c732",
      "text": "문 닫고 쉬운 숫자로 가정해"
    },
    "p130": {
      "source_hash": "43ca28d04bce",
      "text": "안에서 빨간 공 둘을 옮기고,"
    },
    "p131": {
      "source_hash": "cd9ee06bf0f3",
      "text": "압축기는 전기 하나를 써."
    },
    "p132": {
      "source_hash": "1a9aba9a876d",
      "text": "뒤로 몇 개요?"
    },
    "p133": {
      "source_hash": "62a7c0ee0d48",
      "text": "세 개. 옮긴 둘에 하나 더."
    },
    "p134": {
      "source_hash": "80fd1b3727a5",
      "text": "그 하나는 전기가 바뀐 거야."
    },
    "p135": {
      "source_hash": "26ae01210cdc",
      "text": "옮긴 것보다 많아요!"
    },
    "p136": {
      "source_hash": "e760c2879753",
      "text": "응. 전기는 안 사라지고 열이 돼."
    },
    "p137": {
      "source_hash": "a5c13336517a",
      "text": "문 닫아도 부엌이 더워져요?"
    },
    "p138": {
      "source_hash": "e98d5b7e0889",
      "text": "그 둘은 벽과 문으로 천천히 들어온 열이야."
    },
    "p139": {
      "source_hash": "ede7b25ad758",
      "text": "부엌으로 돌아오고, 전기 하나가 더해져."
    },
    "p140": {
      "source_hash": "36f06a827477",
      "text": "문을 닫아도"
    },
    "p141": {
      "source_hash": "3254249642e1",
      "text": "부엌이 조금 더워져요?"
    },
    "p142": {
      "source_hash": "f76687cf1119",
      "text": "응. 돌아가는 동안 부엌을 조금 데워."
    },
    "p143": {
      "source_hash": "005ebd05fb40",
      "text": "문을 열면"
    },
    "p144": {
      "source_hash": "0e34bb8e2063",
      "text": "어때요?"
    },
    "p145": {
      "source_hash": "625dc61639d1",
      "text": "부엌 열이 문으로 들어가고,"
    },
    "p146": {
      "source_hash": "e4c425ec5331",
      "text": "냉장고가 뒤로 다시 내보내."
    },
    "p147": {
      "source_hash": "2ddd2f1d3e23",
      "text": "열이 빙빙 돌아요!"
    },
    "p148": {
      "source_hash": "98bf9e64094d",
      "text": "응. 옮긴 둘이 문으로 다시 들어가."
    },
    "p149": {
      "source_hash": "993448b744d4",
      "text": "부엌 열은 하나도 안 줄어."
    },
    "p150": {
      "source_hash": "e25151dec489",
      "text": "한 바퀴마다 번개가"
    },
    "p151": {
      "source_hash": "b941f4490e4d",
      "text": "열을 하나 더 만들어."
    },
    "p152": {
      "source_hash": "5d4a730599d5",
      "text": "그래서 문 열면"
    },
    "p153": {
      "source_hash": "defd13d28935",
      "text": "부엌이 더 더워져!"
    },
    "p154": {
      "source_hash": "034e0dbc348d",
      "text": "그래도 문 앞은"
    },
    "p155": {
      "source_hash": "5b6396465b28",
      "text": "진짜 시원해요!"
    },
    "p156": {
      "source_hash": "3677bf0254a1",
      "text": "맞아. 문 앞만 조금 시원해."
    },
    "p157": {
      "source_hash": "01bf3f39f165",
      "text": "하지만 떠나면 그 시원함은 끝이야."
    },
    "p158": {
      "source_hash": "f77e16007326",
      "text": "게다가 열면 안이 데워져"
    },
    "p159": {
      "source_hash": "382ef4689927",
      "text": "압축기가 쉬지 못하고 전기를 먹어."
    },
    "p160": {
      "source_hash": "1e062ea5c74d",
      "text": "냉장고 힘들겠다!"
    },
    "p161": {
      "source_hash": "c9604ed3360d",
      "text": "전기 계량기도,"
    },
    "p162": {
      "source_hash": "70427cb4f5c3",
      "text": "전기 요금도 올라."
    },
    "p163": {
      "source_hash": "d86a30ddd6a2",
      "text": "문 열린 냉장고는"
    },
    "p164": {
      "source_hash": "4531a6e99a75",
      "text": "겨울 난로 같아요?"
    },
    "p165": {
      "source_hash": "c9d31a47be23",
      "text": "맞아. 빙 돌아서,"
    },
    "p166": {
      "source_hash": "7fe1c5c54c52",
      "text": "안의 음식까지 데우지만."
    },
    "p167": {
      "source_hash": "049670cdb014",
      "text": "냉장고의 큰 속임수:"
    },
    "p168": {
      "source_hash": "aa856c62028b",
      "text": "열을 옮기는 기계지, 냉기 기계가 아냐."
    },
    "p169": {
      "source_hash": "b2de70b627aa",
      "text": "속았어요!"
    },
    "p170": {
      "source_hash": "5a19c061ddb5",
      "text": "에어컨은?"
    },
    "p171": {
      "source_hash": "10f181af712d",
      "text": "에어컨도 열을 옮겨요?"
    },
    "p172": {
      "source_hash": "6624f41099c1",
      "text": "응. 에어컨도 같은 기계야."
    },
    "p173": {
      "source_hash": "a658a955447e",
      "text": "냉매도 압축기도 있고, 전기도 먹어."
    },
    "p174": {
      "source_hash": "7f477276f4db",
      "text": "그럼 에어컨은"
    },
    "p175": {
      "source_hash": "be545d00643f",
      "text": "방을 어떻게 식혀요?"
    },
    "p176": {
      "source_hash": "35fec431bc49",
      "text": "답은 베란다에. 큰 상자 보러 가자."
    },
    "p177": {
      "source_hash": "b60f6fc856c9",
      "text": "와, 더운 바람이에요!"
    },
    "p178": {
      "source_hash": "31bccbba51df",
      "text": "이건 실외기야. 이 열은"
    },
    "p179": {
      "source_hash": "d61869418d48",
      "text": "네 방에서 옮겨 온 거야."
    },
    "p180": {
      "source_hash": "91805969a0d7",
      "text": "알아요! 바깥 공기를"
    },
    "p181": {
      "source_hash": "64f138e91c2f",
      "text": "식혀서 넣는 거죠!"
    },
    "p182": {
      "source_hash": "56b7cf461036",
      "text": "다들 그렇게 생각해. 그런데 에어컨은"
    },
    "p183": {
      "source_hash": "ce5381ed2aa4",
      "text": "네 방 공기를 불어."
    },
    "p184": {
      "source_hash": "810fd8c0bc0c",
      "text": "벽의 기계가 공기를 빨아 열을 빼고 돌려보내."
    },
    "p185": {
      "source_hash": "ac94aeb4fba7",
      "text": "베란다 기계와 관 두 개로 이어져."
    },
    "p186": {
      "source_hash": "075b90beeb23",
      "text": "냉매가 사이를 돌아."
    },
    "p187": {
      "source_hash": "64eab5ac35ab",
      "text": "뭐랑 닮았지?"
    },
    "p188": {
      "source_hash": "3883049c7a1b",
      "text": "열 기차!"
    },
    "p189": {
      "source_hash": "87514029d25a",
      "text": "이제 원을 방에 그려. 방이 냉장고 안이고,"
    },
    "p190": {
      "source_hash": "ffd8c07723e8",
      "text": "냉장고 뒤는 벽 밖으로 갔어."
    },
    "p191": {
      "source_hash": "f90421ab5108",
      "text": "뜨거운 쪽이 밖에!"
    },
    "p192": {
      "source_hash": "27057a6795ea",
      "text": "이번엔 열이 원 밖으로 나가 안 돌아와."
    },
    "p193": {
      "source_hash": "d9285d4e57a2",
      "text": "그래서 원 안의 열이 진짜 줄어."
    },
    "p194": {
      "source_hash": "e76e131ecec3",
      "text": "에어컨 전기도 거의 열이 돼"
    },
    "p195": {
      "source_hash": "4dc752fb85cc",
      "text": "실외기에서 같이 나가."
    },
    "p196": {
      "source_hash": "d93a2caeb0d2",
      "text": "전기 하나로"
    },
    "p197": {
      "source_hash": "b70d841e99c1",
      "text": "열을 여러 개 옮겨."
    },
    "p198": {
      "source_hash": "78a9bba627ff",
      "text": "하나로 여러 개요?"
    },
    "p199": {
      "source_hash": "adf8f49190f8",
      "text": "많이 옮기네요!"
    },
    "p200": {
      "source_hash": "c5fcf3400156",
      "text": "기종과 날씨에 따라,"
    },
    "p201": {
      "source_hash": "9f4e09e91cfb",
      "text": "밖이 더울수록 더 힘들어."
    },
    "p202": {
      "source_hash": "f4a3e7b259f0",
      "text": "두꺼운 문 기억나?"
    },
    "p203": {
      "source_hash": "4f7f8bd66f25",
      "text": "에어컨 켤 때 창 닫고 커튼 치는 건,"
    },
    "p204": {
      "source_hash": "22c0e9cfa253",
      "text": "방의 두꺼운 문."
    },
    "p205": {
      "source_hash": "250d80e40dd7",
      "text": "그래서 창을 닫는구나!"
    },
    "p206": {
      "source_hash": "710940f0c9b4",
      "text": "에어컨은 열을 내보내고"
    },
    "p207": {
      "source_hash": "2698a5ea6c80",
      "text": "단열은 바깥 열이 천천히 오게 해."
    },
    "p208": {
      "source_hash": "b809024d9aaa",
      "text": "옮기고, 막고!"
    },
    "p209": {
      "source_hash": "049df23e51ff",
      "text": "켜고 창 열면요?"
    },
    "p210": {
      "source_hash": "d218ae468eaf",
      "text": "냉장고 문 연 것처럼 쉼 없이 일해."
    },
    "p211": {
      "source_hash": "dfd9872abf53",
      "text": "에어컨 방"
    },
    "p212": {
      "source_hash": "0eee606120bc",
      "text": "큰 냉장고!"
    },
    "p213": {
      "source_hash": "1a0fa704cc26",
      "text": "응. 넌 냉장고 안에 사는 거야."
    },
    "p214": {
      "source_hash": "f4168efd0a7f",
      "text": "자, 부엌으로. 문이 아직 열렸어."
    },
    "p215": {
      "source_hash": "859f7800a50c",
      "text": "제 생각요?"
    },
    "p216": {
      "source_hash": "1c7ea3d3eb29",
      "text": "취소할래요!"
    },
    "p217": {
      "source_hash": "bf6960fa08f3",
      "text": "문 열면 뜨거운 쪽이"
    },
    "p218": {
      "source_hash": "137add139f63",
      "text": "부엌에 남아요!"
    },
    "p219": {
      "source_hash": "5dcc24284233",
      "text": "냉장고와 에어컨, 같은 기계지?"
    },
    "p220": {
      "source_hash": "7c70e3a0475c",
      "text": "차이는 뜨거운 쪽이 원 안이냐 밖이냐야."
    },
    "p221": {
      "source_hash": "b1068e783445",
      "text": "다음엔 뒤를 만져 봐."
    },
    "p222": {
      "source_hash": "fdbb4a8a9698",
      "text": "빨간 공 세 개 기억나? 그 따뜻함이 그거야."
    },
    "p223": {
      "source_hash": "36d742bcb996",
      "text": "그래서그랬구나!"
    },
    "p224": {
      "source_hash": "b997a16cd350",
      "text": "너희 집 실외기는?"
    },
    "p225": {
      "source_hash": "a7d234c4eb2e",
      "text": "바람이 얼마나 뜨거워? 댓글 줘."
    },
    "p226": {
      "source_hash": "88de677d4daa",
      "text": "생활 속 '왜'를 찾으려면 그래서그랬구나 사무소 구독!"
    }
  }
}
