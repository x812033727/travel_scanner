  "lines": {
    "p001": {
      "source_hash": "b7172e801960",
      "text": "¡Directora! ¡Calor!"
    },
    "p002": {
      "source_hash": "3f5b61642553",
      "text": "Abro el refri,"
    },
    "p003": {
      "source_hash": "168c59f250fe",
      "text": "¡cara fresquita!"
    },
    "p004": {
      "source_hash": "7bf79f51a091",
      "text": "¡Ya sé!"
    },
    "p005": {
      "source_hash": "8b23cc53bc02",
      "text": "Refri abierto,"
    },
    "p006": {
      "source_hash": "ec357ef013f5",
      "text": "¡y sin aire en la cocina!"
    },
    "p007": {
      "source_hash": "8395747e3950",
      "text": "¡No lo apagues!"
    },
    "p008": {
      "source_hash": "c88a1c380fdb",
      "text": "Adivina: con la puerta abierta,"
    },
    "p009": {
      "source_hash": "7667289aae3d",
      "text": "¿la cocina se enfría o se calienta?"
    },
    "p010": {
      "source_hash": "002e57b4aaa5",
      "text": "¿Más?"
    },
    "p011": {
      "source_hash": "d5d7f4e1f933",
      "text": "¡Pero el refri es frío!"
    },
    "p012": {
      "source_hash": "8a877c6d664c",
      "text": "Acerca la mano a la parte de atrás."
    },
    "p013": {
      "source_hash": "5fad15bf2f6d",
      "text": "Ahí no se siente nada de frío."
    },
    "p014": {
      "source_hash": "0b087fdc1ec2",
      "text": "¿Detrás,"
    },
    "p015": {
      "source_hash": "e87865d778ae",
      "text": "qué se esconde?"
    },
    "p016": {
      "source_hash": "915a9848b82a",
      "text": "Y esa caja que zumba en tu balcón,"
    },
    "p017": {
      "source_hash": "d5da43348a89",
      "text": "¿sopla aire frío o caliente?"
    },
    "p018": {
      "source_hash": "64872e30b282",
      "text": "¿Esa?"
    },
    "p019": {
      "source_hash": "7ec9f7b51336",
      "text": "¡Frío, seguro!"
    },
    "p020": {
      "source_hash": "aee671c7ac12",
      "text": "Todo se responde en este refri."
    },
    "p021": {
      "source_hash": "d329b4aea270",
      "text": "Con la puerta abierta, ¿a dónde va el calor?"
    },
    "p022": {
      "source_hash": "f1fbe5370dca",
      "text": "Está lleno de frío,"
    },
    "p023": {
      "source_hash": "db519e542b90",
      "text": "¡abres y el frío sale!"
    },
    "p024": {
      "source_hash": "8c8d0ac2f508",
      "text": "¿Has enfriado un té caliente?"
    },
    "p025": {
      "source_hash": "70f485a4b48d",
      "text": "En la mesa, ¿qué le pasa?"
    },
    "p026": {
      "source_hash": "a1db32b61f99",
      "text": "Se entibia."
    },
    "p027": {
      "source_hash": "c1f7b9777c52",
      "text": "¡Se fue!"
    },
    "p028": {
      "source_hash": "2561d58ec95e",
      "text": "¿Y un hielo?"
    },
    "p029": {
      "source_hash": "29949618a983",
      "text": "Se derrite."
    },
    "p030": {
      "source_hash": "39f36455444d",
      "text": "Se derrite porque entra el calor del aire."
    },
    "p031": {
      "source_hash": "225d245b624a",
      "text": "Solo, el calor va siempre de lo caliente a lo frío."
    },
    "p032": {
      "source_hash": "61e8dce75fb3",
      "text": "¿Y frío?"
    },
    "p033": {
      "source_hash": "7072e93bbb8b",
      "text": "¿El aire frío no se mueve solo?"
    },
    "p034": {
      "source_hash": "d93c5aab02b6",
      "text": "Frío es solo menos calor."
    },
    "p035": {
      "source_hash": "034b4877b852",
      "text": "El frío no es algo que escape."
    },
    "p036": {
      "source_hash": "efca9195884d",
      "text": "¿Y mi cara,"
    },
    "p037": {
      "source_hash": "a1d48a27d2ed",
      "text": "por qué se refrescó?"
    },
    "p038": {
      "source_hash": "70e3b42cdb9f",
      "text": "El aire frío sale, toca tu cara,"
    },
    "p039": {
      "source_hash": "95fd93cf0b40",
      "text": "y el calor de tu cara pasa al aire."
    },
    "p040": {
      "source_hash": "0bb13789f451",
      "text": "¡Me robó el calor!"
    },
    "p041": {
      "source_hash": "b6d74c1d6dcf",
      "text": "Sigue el calor en un círculo."
    },
    "p042": {
      "source_hash": "8094f53d46b8",
      "text": "Si el calor del círculo sube o baja, lo anotamos."
    },
    "p043": {
      "source_hash": "7f741889678a",
      "text": "El calor serán bolitas rojas."
    },
    "p044": {
      "source_hash": "aa7814faf297",
      "text": "Primero, solo el interior."
    },
    "p045": {
      "source_hash": "f40432e0831b",
      "text": "Arriba hay apenas 3 a 5 grados,"
    },
    "p046": {
      "source_hash": "1635dcd9825b",
      "text": "menos que la cocina en verano."
    },
    "p047": {
      "source_hash": "c88b1e8516c1",
      "text": "¿Y el congelador?"
    },
    "p048": {
      "source_hash": "0e6fe5844c83",
      "text": "Casi siempre 18 bajo cero, o menos."
    },
    "p049": {
      "source_hash": "2c4f1b1915af",
      "text": "¡Menos 18!"
    },
    "p050": {
      "source_hash": "e4562096a5cd",
      "text": "¡Más que el invierno de Taiwán!"
    },
    "p051": {
      "source_hash": "d5d8dd87011b",
      "text": "Más diferencia, más prisa por entrar."
    },
    "p052": {
      "source_hash": "69606f40df49",
      "text": "¿El calor"
    },
    "p053": {
      "source_hash": "e8044ff9c033",
      "text": "quiere entrar al refri?"
    },
    "p054": {
      "source_hash": "84858753c1b7",
      "text": "Sí. Por esa regla, va hacia lo frío."
    },
    "p055": {
      "source_hash": "0c159cbff7e5",
      "text": "Pero la puerta del refri lo frena."
    },
    "p056": {
      "source_hash": "399cfe6588f9",
      "text": "Ábrela, toca el borde."
    },
    "p057": {
      "source_hash": "5a88375b6bd5",
      "text": "Gruesa, pesada, con una tira de goma suave."
    },
    "p058": {
      "source_hash": "e08d08650ed0",
      "text": "¡Gruesa como un termo!"
    },
    "p059": {
      "source_hash": "185271b7781d",
      "text": "Sí. Puerta y paredes aíslan."
    },
    "p060": {
      "source_hash": "59b39972f5f2",
      "text": "Es aislamiento: entra más lento."
    },
    "p061": {
      "source_hash": "796ec4046f41",
      "text": "Recuerda esta puerta gruesa. Va a volver."
    },
    "p062": {
      "source_hash": "bd96aec42c6c",
      "text": "¿Más lento?"
    },
    "p063": {
      "source_hash": "13f4d5f3db90",
      "text": "¿O sea que entra?"
    },
    "p064": {
      "source_hash": "3b92cd9d7d93",
      "text": "Sí. Y aun así sigue frío,"
    },
    "p065": {
      "source_hash": "57ef5c8a1fbc",
      "text": "o sea: algo saca el calor sin parar"
    },
    "p066": {
      "source_hash": "a0c91d1c24f5",
      "text": "El calor sale del círculo, de a uno."
    },
    "p067": {
      "source_hash": "47283fea74d1",
      "text": "¿Y eso,"
    },
    "p068": {
      "source_hash": "41ee68987691",
      "text": "a dónde va?"
    },
    "p069": {
      "source_hash": "be11f6a5a898",
      "text": "¿El refri"
    },
    "p070": {
      "source_hash": "0cec453a5dc3",
      "text": "se lo comió?"
    },
    "p071": {
      "source_hash": "7becdf761571",
      "text": "El calor no desaparece. Se muda."
    },
    "p072": {
      "source_hash": "5ef3679c80b5",
      "text": "¿No me crees? Ve por detrás."
    },
    "p073": {
      "source_hash": "6f0e9e8688bc",
      "text": "¿Eh? ¡Está tibio!"
    },
    "p074": {
      "source_hash": "73d24cbaae95",
      "text": "¡Aire tibio!"
    },
    "p075": {
      "source_hash": "a49f26eea7ea",
      "text": "Solo acerca la mano: hay cables."
    },
    "p076": {
      "source_hash": "462c50c43919",
      "text": "Estos tubos curvos de atrás, tibios."
    },
    "p077": {
      "source_hash": "380e8fd1a016",
      "text": "El calor que sale de adentro vuelve aquí."
    },
    "p078": {
      "source_hash": "e95a80445e89",
      "text": "¡El calor se fue atrás!"
    },
    "p079": {
      "source_hash": "9bce21fe93ad",
      "text": "Algunos soplan aire tibio abajo."
    },
    "p080": {
      "source_hash": "15ffc9f633b5",
      "text": "Párate enfrente. ¿Sientes los pies?"
    },
    "p081": {
      "source_hash": "d8391d830a0b",
      "text": "Pie tibio,"
    },
    "p082": {
      "source_hash": "34ab9467f167",
      "text": "cara fresca!"
    },
    "p083": {
      "source_hash": "ee2e6d9cc774",
      "text": "El refri no tiene manos."
    },
    "p084": {
      "source_hash": "d152ca25322f",
      "text": "¿Cómo lo mueve?"
    },
    "p085": {
      "source_hash": "0751b621f960",
      "text": "En sus tubos algo corre en círculos,"
    },
    "p086": {
      "source_hash": "33f41bdbb110",
      "text": "es el refrigerante."
    },
    "p087": {
      "source_hash": "1bc9f4cd28e1",
      "text": "¿Eh?"
    },
    "p088": {
      "source_hash": "ff6c7307a4e7",
      "text": "¿Es frío?"
    },
    "p089": {
      "source_hash": "572d772e9217",
      "text": "No siempre, pero cambia. Tras un baño,"
    },
    "p090": {
      "source_hash": "2a481522d9d1",
      "text": "si sales mojado, ¿no tiemblas de frío?"
    },
    "p091": {
      "source_hash": "83ec21889dbc",
      "text": "¡Sí! ¡Era caliente!"
    },
    "p092": {
      "source_hash": "0e3109c97ff4",
      "text": "Cuando el agua en ti se hace vapor,"
    },
    "p093": {
      "source_hash": "205b3b934b24",
      "text": "se lleva tu calor con ella."
    },
    "p094": {
      "source_hash": "ba6b32042453",
      "text": "¡Por eso mojado da frío!"
    },
    "p095": {
      "source_hash": "b68f95bdbd47",
      "text": "En el refri, el refrigerante se vuelve gas,"
    },
    "p096": {
      "source_hash": "2964963c1cc3",
      "text": "y lleva el calor de adentro a los tubos."
    },
    "p097": {
      "source_hash": "d88e32ea3e04",
      "text": "¿Tan frío,"
    },
    "p098": {
      "source_hash": "766d0cb1f76c",
      "text": "y aun así se vuelve gas?"
    },
    "p099": {
      "source_hash": "8cd725bde610",
      "text": "Sí. Es un líquido que hierve muy fácil;"
    },
    "p100": {
      "source_hash": "65e692591700",
      "text": "con poquito calor se vuelve gas."
    },
    "p101": {
      "source_hash": "42846c9e49a7",
      "text": "¿Hierve en frío?"
    },
    "p102": {
      "source_hash": "bb4a69618061",
      "text": "¡Qué líquido raro!"
    },
    "p103": {
      "source_hash": "7518a2b18c99",
      "text": "Ese gas,"
    },
    "p104": {
      "source_hash": "9eb4faf4c902",
      "text": "¿a dónde va?"
    },
    "p105": {
      "source_hash": "e48936cab7ce",
      "text": "Entra a una lata redonda"
    },
    "p106": {
      "source_hash": "28f428d21fb9",
      "text": "Esa lata es el compresor."
    },
    "p107": {
      "source_hash": "c7d417713f75",
      "text": "El compresor lo aprieta."
    },
    "p108": {
      "source_hash": "3e9aa7d87bce",
      "text": "El gas apretado va a los tubos de atrás,"
    },
    "p109": {
      "source_hash": "bbff0f0a54f8",
      "text": "se hace líquido y da calor a la cocina"
    },
    "p110": {
      "source_hash": "77a975998970",
      "text": "Luego vuelve adentro y da otra vuelta."
    },
    "p111": {
      "source_hash": "63db4baa6c9b",
      "text": "¡Un trencito de calor!"
    },
    "p112": {
      "source_hash": "7baf69c37ec5",
      "text": "Algo así. Vuelta tras vuelta, de adentro afuera."
    },
    "p113": {
      "source_hash": "7e942b397d8b",
      "text": "¿Alguien empuja el tren?"
    },
    "p114": {
      "source_hash": "12652fd29511",
      "text": "La electricidad. Apretar gas cuesta,"
    },
    "p115": {
      "source_hash": "be8011a3125a",
      "text": "y el compresor gasta sin parar"
    },
    "p116": {
      "source_hash": "049788cf513e",
      "text": "La luz será un rayito amarillo."
    },
    "p117": {
      "source_hash": "24ab05860f20",
      "text": "No va siempre: si se entibia, arranca,"
    },
    "p118": {
      "source_hash": "e55082a0f762",
      "text": "y ya frío, para."
    },
    "p119": {
      "source_hash": "55d81ae16193",
      "text": "¡Por eso a veces calla!"
    },
    "p120": {
      "source_hash": "d3da14b332db",
      "text": "¿Y esa luz"
    },
    "p121": {
      "source_hash": "f2ab77da9298",
      "text": "a dónde va?"
    },
    "p122": {
      "source_hash": "73b7521ec063",
      "text": "Y el calor de atrás"
    },
    "p123": {
      "source_hash": "e4f1584f39bf",
      "text": "y el interior"
    },
    "p124": {
      "source_hash": "75df1cd5c7e7",
      "text": "¿son iguales?"
    },
    "p125": {
      "source_hash": "f2255ae9f464",
      "text": "Para eso, un círculo mayor,"
    },
    "p126": {
      "source_hash": "7d4bf8b2e882",
      "text": "con toda la cocina."
    },
    "p127": {
      "source_hash": "aa50778a6617",
      "text": "El refri, su espalda, donde estás tú,"
    },
    "p128": {
      "source_hash": "71e36c86143b",
      "text": "ya están todos en el mismo círculo."
    },
    "p129": {
      "source_hash": "3b7d5d97c732",
      "text": "Puerta cerrada. Cuenta fácil:"
    },
    "p130": {
      "source_hash": "43ca28d04bce",
      "text": "el refri saca dos bolitas de calor,"
    },
    "p131": {
      "source_hash": "cd9ee06bf0f3",
      "text": "y el compresor gasta un rayito"
    },
    "p132": {
      "source_hash": "1a9aba9a876d",
      "text": "¿Y salen atrás?"
    },
    "p133": {
      "source_hash": "62a7c0ee0d48",
      "text": "Tres. Las dos que sacó, más una."
    },
    "p134": {
      "source_hash": "80fd1b3727a5",
      "text": "Esa una es la luz del compresor."
    },
    "p135": {
      "source_hash": "26ae01210cdc",
      "text": "¡Sale más de lo que sacó!"
    },
    "p136": {
      "source_hash": "e760c2879753",
      "text": "Sí. La luz gastada no se pierde: acaba en calor."
    },
    "p137": {
      "source_hash": "a5c13336517a",
      "text": "Cerrada, ¿se calienta la cocina?"
    },
    "p138": {
      "source_hash": "e98d5b7e0889",
      "text": "Esas dos entraron despacio por paredes y puerta."
    },
    "p139": {
      "source_hash": "ede7b25ad758",
      "text": "Vuelven a la cocina, y con la del rayito."
    },
    "p140": {
      "source_hash": "36f06a827477",
      "text": "¿Cerrada y todo,"
    },
    "p141": {
      "source_hash": "3254249642e1",
      "text": "la cocina se calienta?"
    },
    "p142": {
      "source_hash": "f76687cf1119",
      "text": "Sí. Mientras funciona, calienta un poquito la cocina."
    },
    "p143": {
      "source_hash": "005ebd05fb40",
      "text": "¿Y si la abro,"
    },
    "p144": {
      "source_hash": "0e34bb8e2063",
      "text": "qué pasa?"
    },
    "p145": {
      "source_hash": "625dc61639d1",
      "text": "El calor de la cocina entra,"
    },
    "p146": {
      "source_hash": "e4c425ec5331",
      "text": "y lo echa atrás, a la cocina."
    },
    "p147": {
      "source_hash": "2ddd2f1d3e23",
      "text": "¡El calor da vueltas!"
    },
    "p148": {
      "source_hash": "98bf9e64094d",
      "text": "Sí. Las dos bolitas vuelven a entrar."
    },
    "p149": {
      "source_hash": "993448b744d4",
      "text": "La cocina no pierde ni una."
    },
    "p150": {
      "source_hash": "e25151dec489",
      "text": "Pero cada vuelta, el rayo"
    },
    "p151": {
      "source_hash": "b941f4490e4d",
      "text": "suma una bolita más."
    },
    "p152": {
      "source_hash": "5d4a730599d5",
      "text": "Con la puerta abierta,"
    },
    "p153": {
      "source_hash": "defd13d28935",
      "text": "¡se calienta más!"
    },
    "p154": {
      "source_hash": "034e0dbc348d",
      "text": "¡Pero en la puerta"
    },
    "p155": {
      "source_hash": "5b6396465b28",
      "text": "sí está fresco!"
    },
    "p156": {
      "source_hash": "3677bf0254a1",
      "text": "Cierto. Frente a la puerta refresca."
    },
    "p157": {
      "source_hash": "01bf3f39f165",
      "text": "Pero si te vas, ese fresco ya no es tuyo."
    },
    "p158": {
      "source_hash": "f77e16007326",
      "text": "Abierta, adentro se entibia,"
    },
    "p159": {
      "source_hash": "382ef4689927",
      "text": "y el compresor no para de gastar luz."
    },
    "p160": {
      "source_hash": "1e062ea5c74d",
      "text": "¡Pobre refri cansado!"
    },
    "p161": {
      "source_hash": "c9604ed3360d",
      "text": "Y tu medidor de luz,"
    },
    "p162": {
      "source_hash": "70427cb4f5c3",
      "text": "y el recibo sube."
    },
    "p163": {
      "source_hash": "d86a30ddd6a2",
      "text": "¿Un refri abierto"
    },
    "p164": {
      "source_hash": "4531a6e99a75",
      "text": "es como un calefactor?"
    },
    "p165": {
      "source_hash": "c9d31a47be23",
      "text": "Casi. Da un rodeo,"
    },
    "p166": {
      "source_hash": "7fe1c5c54c52",
      "text": "y de paso calienta la comida."
    },
    "p167": {
      "source_hash": "049670cdb014",
      "text": "El truco del refri:"
    },
    "p168": {
      "source_hash": "aa856c62028b",
      "text": "mueve calor. No es una máquina de frío."
    },
    "p169": {
      "source_hash": "b2de70b627aa",
      "text": "¡Me engañó!"
    },
    "p170": {
      "source_hash": "5a19c061ddb5",
      "text": "¿El aire?"
    },
    "p171": {
      "source_hash": "10f181af712d",
      "text": "¿El aire también mueve calor?"
    },
    "p172": {
      "source_hash": "6624f41099c1",
      "text": "Sí. Aire y refri: la misma máquina."
    },
    "p173": {
      "source_hash": "a658a955447e",
      "text": "Tiene refrigerante, compresor y gasta luz."
    },
    "p174": {
      "source_hash": "7f477276f4db",
      "text": "¿Y el aire,"
    },
    "p175": {
      "source_hash": "be545d00643f",
      "text": "cómo se enfría el cuarto?"
    },
    "p176": {
      "source_hash": "35fec431bc49",
      "text": "La respuesta está en el balcón. Vamos."
    },
    "p177": {
      "source_hash": "b60f6fc856c9",
      "text": "¡Sopla aire caliente!"
    },
    "p178": {
      "source_hash": "31bccbba51df",
      "text": "Es la unidad exterior. Ese calor"
    },
    "p179": {
      "source_hash": "d61869418d48",
      "text": "lo sacó de tu cuarto."
    },
    "p180": {
      "source_hash": "91805969a0d7",
      "text": "¡Ya sé! Toma aire de afuera,"
    },
    "p181": {
      "source_hash": "64f138e91c2f",
      "text": "¡lo enfría y lo mete!"
    },
    "p182": {
      "source_hash": "56b7cf461036",
      "text": "Muchos lo creen. Pero el aire sopla"
    },
    "p183": {
      "source_hash": "ce5381ed2aa4",
      "text": "el aire de tu propio cuarto."
    },
    "p184": {
      "source_hash": "810fd8c0bc0c",
      "text": "El del muro toma aire, le saca calor, lo devuelve."
    },
    "p185": {
      "source_hash": "ac94aeb4fba7",
      "text": "Se une al del balcón con dos tubos."
    },
    "p186": {
      "source_hash": "075b90beeb23",
      "text": "El refrigerante circula,"
    },
    "p187": {
      "source_hash": "64eab5ac35ab",
      "text": "¿te suena al refri?"
    },
    "p188": {
      "source_hash": "3883049c7a1b",
      "text": "¡Tren de calor!"
    },
    "p189": {
      "source_hash": "87514029d25a",
      "text": "Ahora el círculo es tu cuarto: el cuarto es el refri,"
    },
    "p190": {
      "source_hash": "ffd8c07723e8",
      "text": "y la espalda del refri, afuera."
    },
    "p191": {
      "source_hash": "f90421ab5108",
      "text": "¡Lo caliente afuera!"
    },
    "p192": {
      "source_hash": "27057a6795ea",
      "text": "Ahora el calor sale del círculo y no regresa,"
    },
    "p193": {
      "source_hash": "d9285d4e57a2",
      "text": "y el calor de adentro de verdad baja."
    },
    "p194": {
      "source_hash": "e76e131ecec3",
      "text": "Casi toda su luz es calor,"
    },
    "p195": {
      "source_hash": "4dc752fb85cc",
      "text": "y sale por la de afuera."
    },
    "p196": {
      "source_hash": "d93a2caeb0d2",
      "text": "Con un rayito,"
    },
    "p197": {
      "source_hash": "b70d841e99c1",
      "text": "mueve varias bolitas."
    },
    "p198": {
      "source_hash": "78a9bba627ff",
      "text": "¿Un rayito, varias bolitas?"
    },
    "p199": {
      "source_hash": "adf8f49190f8",
      "text": "¡Cuánto mueve!"
    },
    "p200": {
      "source_hash": "c5fcf3400156",
      "text": "Depende del aparato y clima;"
    },
    "p201": {
      "source_hash": "9f4e09e91cfb",
      "text": "más calor afuera, más cuesta."
    },
    "p202": {
      "source_hash": "f4a3e7b259f0",
      "text": "¿Y la puerta gruesa?"
    },
    "p203": {
      "source_hash": "4f7f8bd66f25",
      "text": "Con el aire, cierras ventanas y cortinas:"
    },
    "p204": {
      "source_hash": "22c0e9cfa253",
      "text": "una puerta gruesa."
    },
    "p205": {
      "source_hash": "250d80e40dd7",
      "text": "¡Por eso se cierra!"
    },
    "p206": {
      "source_hash": "710940f0c9b4",
      "text": "El aire saca el calor,"
    },
    "p207": {
      "source_hash": "2698a5ea6c80",
      "text": "y el aislante frena el calor de afuera."
    },
    "p208": {
      "source_hash": "b809024d9aaa",
      "text": "¡Saca y frena!"
    },
    "p209": {
      "source_hash": "049df23e51ff",
      "text": "¿Y con ventanas abiertas?"
    },
    "p210": {
      "source_hash": "d218ae468eaf",
      "text": "Como el refri abierto: trabaja sin parar."
    },
    "p211": {
      "source_hash": "dfd9872abf53",
      "text": "Ese cuarto"
    },
    "p212": {
      "source_hash": "0eee606120bc",
      "text": "¡es un refri!"
    },
    "p213": {
      "source_hash": "1a0fa704cc26",
      "text": "Sí, y tú vives dentro del refri."
    },
    "p214": {
      "source_hash": "f4168efd0a7f",
      "text": "Bueno, a la cocina. Sigue abierta."
    },
    "p215": {
      "source_hash": "859f7800a50c",
      "text": "¿Mi idea?"
    },
    "p216": {
      "source_hash": "1c7ea3d3eb29",
      "text": "¡La retiro!"
    },
    "p217": {
      "source_hash": "bf6960fa08f3",
      "text": "Abierto, lo caliente"
    },
    "p218": {
      "source_hash": "137add139f63",
      "text": "¡queda adentro!"
    },
    "p219": {
      "source_hash": "5dcc24284233",
      "text": "Refri y aire: la misma máquina."
    },
    "p220": {
      "source_hash": "7c70e3a0475c",
      "text": "Solo cambia: lo caliente, ¿dentro o fuera?"
    },
    "p221": {
      "source_hash": "b1068e783445",
      "text": "Toca atrás de tu refri:"
    },
    "p222": {
      "source_hash": "fdbb4a8a9698",
      "text": "¿Y las tres bolitas rojas? Ese tibio son ellas."
    },
    "p223": {
      "source_hash": "36d742bcb996",
      "text": "¡Ah, por eso!"
    },
    "p224": {
      "source_hash": "b997a16cd350",
      "text": "¿Y tu unidad?"
    },
    "p225": {
      "source_hash": "a7d234c4eb2e",
      "text": "¿Qué tan caliente sopla? Dinos abajo"
    },
    "p226": {
      "source_hash": "88de677d4daa",
      "text": "Para más porqués, suscríbete a La Oficina del Por Eso."
    }
  }
}
