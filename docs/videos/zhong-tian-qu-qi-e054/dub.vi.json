{
  "zq54a01": {
    "text": "Thư,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a02": {
    "text": "ta tự đi lấy.",
    "emotion": "一字一字"
  },
  "zq54a03": {
    "text": "Lấy được rồi.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "Tha, tha mạng…",
    "emotion": "嚇破膽"
  },
  "zq54a05": {
    "text": "Ngục châu,",
    "emotion": "冷"
  },
  "zq54a06": {
    "text": "đến lượt ngươi ngồi.",
    "emotion": "抬下巴"
  },
  "zq54a07": {
    "text": "Sợi xích này,",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "trả ngươi.",
    "emotion": "畫外，拉緊"
  },
  "zq54a09": {
    "text": "Người các ngươi đắc tội,",
    "emotion": "陰沉"
  },
  "zq54a10": {
    "text": "các ngươi không kham nổi.",
    "emotion": "冷笑",
    "say": "không kham nổi."
  },
  "zq54a11": {
    "text": "Thư đã đưa ngươi rồi,",
    "emotion": "陪笑"
  },
  "zq54a12": {
    "text": "tha cho ta một con đường sống.",
    "emotion": "討饒",
    "say": "cho ta đường sống."
  },
  "zq54a13": {
    "text": "Đồ của cha ta,",
    "emotion": "冷"
  },
  "zq54a14": {
    "text": "vốn là của ta.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "Hắn nói,",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "hắn biết nàng là ai.",
    "emotion": "看著她，快，說完就停",
    "say": "biết nàng là ai."
  },
  "zq54a17": {
    "text": "Ngươi không hỏi?",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "Khi nào nàng muốn nói,",
    "emotion": "很輕，快，說完就停",
    "say": "Khi nàng muốn nói,"
  },
  "zq54a19": {
    "text": "ta sẽ nghe.",
    "emotion": "很穩",
    "say": "ta nghe."
  },
  "zq54a20": {
    "text": "Của ngươi.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "Ta…",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a22": {
    "text": "không dám mở.",
    "emotion": "很小聲"
  },
  "zq54a23": {
    "text": "Ta mở cùng nàng.",
    "emotion": "很溫柔"
  },
  "zq54a24": {
    "text": "Cha…",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "Giấy trắng?",
    "emotion": "畫外，愣住"
  },
  "zq54a26": {
    "text": "Làm gì có thư nào,",
    "emotion": "嘲弄，快，說完就停",
    "say": "Làm gì có thư,"
  },
  "zq54a27": {
    "text": "lừa ngươi thôi.",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "Ta cứ tưởng…",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "ta cứ tưởng đã tìm được cha…",
    "emotion": "哽咽",
    "say": "tưởng đã tìm được cha…"
  },
  "zq54a30": {
    "text": "Có ta đây.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "Cả đám kia,",
    "emotion": "淡淡的，快，說完就停",
    "say": "Đám kia,"
  },
  "zq54a32": {
    "text": "sáng mai giải về châu phủ.",
    "emotion": "很穩",
    "say": "mai giải về châu phủ."
  },
  "zq54a33": {
    "text": "Ngày cha ta bị định tội,",
    "emotion": "很低，快，說完就停",
    "say": "Ngày cha bị định tội,"
  },
  "zq54a34": {
    "text": "tội danh là thông đồng với giặc.",
    "emotion": "咬牙",
    "say": "tội danh: thông địch."
  },
  "zq54a35": {
    "text": "Cha giữ Bắc Cương hai mươi năm.",
    "emotion": "聲音發顫"
  },
  "zq54a36": {
    "text": "Miếng ngọc này,",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "cha chưa từng rời thân.",
    "emotion": "畫外，快，說完就停",
    "say": "chưa từng rời thân."
  },
  "zq54a38": {
    "text": "Cha giao cho thân binh tin cậy nhất,",
    "emotion": "慢慢說",
    "say": "Cha giao cho thân binh tin cậy,"
  },
  "zq54a39": {
    "text": "mang ra ngoài.",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "Người đó,",
    "emotion": "低，極短促，一口氣說完，不拖音"
  },
  "zq54a41": {
    "text": "không bao giờ trở về.",
    "emotion": "幾乎聽不見",
    "say": "không về nữa."
  },
  "zq54a42": {
    "text": "Cuối cùng hắn,",
    "emotion": "小心地問",
    "say": "Cuối cùng,"
  },
  "zq54a43": {
    "text": "đã đi đâu?",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "Lá thư cuối cùng nói,",
    "emotion": "很慢",
    "say": "Thư cuối nói,"
  },
  "zq54a45": {
    "text": "đã tới Liễu Khê, Thanh Châu.",
    "emotion": "看著他，快，說完就停",
    "say": "tới Liễu Khê, Thanh Châu."
  },
  "zq54a46": {
    "text": "Vậy miếng ngọc này,",
    "emotion": "低聲，快，說完就停",
    "say": "Vậy ngọc này,"
  },
  "zq54a47": {
    "text": "là mất ở Liễu Khê.",
    "emotion": "低聲"
  },
  "zq54a48": {
    "text": "Mẹ đợi mãi không có tin,",
    "emotion": "低聲，快，說完就停",
    "say": "Mẹ đợi không có tin,"
  },
  "zq54a49": {
    "text": "lâm bệnh rồi không dậy nữa.",
    "emotion": "很輕，快，說完就停",
    "say": "bệnh rồi không dậy nữa."
  },
  "zq54a50": {
    "text": "Ngôi mộ trong rừng trúc,",
    "emotion": "很慢",
    "say": "Mộ trong rừng trúc,"
  },
  "zq54a51": {
    "text": "là mẹ ta.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "Nỗi oan của cha nàng,",
    "emotion": "很穩",
    "say": "Oan của cha nàng,"
  },
  "zq54a53": {
    "text": "ta cùng nàng rửa.",
    "emotion": "一字一字"
  },
  "zq54a54": {
    "text": "Đêm ở khách điếm,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Đêm khách điếm,"
  },
  "zq54a55": {
    "text": "cảm ơn ngươi đã giữ ta lại.",
    "emotion": "第一次這麼軟，快，說完就停",
    "say": "cảm ơn đã giữ ta."
  },
  "zq54a56": {
    "text": "Tần Sương hảo cảm, sáu mươi sáu.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq54a57": {
    "text": "Hứa Nghiên.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "Ngươi hay cười với chỗ đó.",
    "emotion": "好奇，很直"
  },
  "zq54a59": {
    "text": "Ở đó có gì?",
    "emotion": "追問"
  }
}
