{
  "zq54a01": {
    "text": "Surat itu,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Surat,"
  },
  "zq54a02": {
    "text": "akan kuambil sendiri.",
    "emotion": "一字一字",
    "say": "kuambil sendiri."
  },
  "zq54a03": {
    "text": "Dapat.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "Am-ampun…",
    "emotion": "嚇破膽",
    "say": "Ampun…"
  },
  "zq54a05": {
    "text": "Penjara prefektur,",
    "emotion": "冷，快，說完就停",
    "say": "Penjara,"
  },
  "zq54a06": {
    "text": "sekarang kau yang masuk.",
    "emotion": "抬下巴",
    "say": "giliranmu."
  },
  "zq54a07": {
    "text": "Rantai ini,",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "kukembalikan.",
    "emotion": "畫外，拉緊"
  },
  "zq54a09": {
    "text": "Orang yang kalian usik,",
    "emotion": "陰沉",
    "say": "Yang kalian usik,"
  },
  "zq54a10": {
    "text": "bukan lawan kalian.",
    "emotion": "冷笑"
  },
  "zq54a11": {
    "text": "Suratnya sudah kuberikan,",
    "emotion": "陪笑",
    "say": "Surat sudah kuberi,"
  },
  "zq54a12": {
    "text": "ampuni nyawaku.",
    "emotion": "討饒",
    "say": "ampuni aku."
  },
  "zq54a13": {
    "text": "Barang ayahku",
    "emotion": "冷，快，說完就停"
  },
  "zq54a14": {
    "text": "memang milikku.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "Katanya,",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "dia tahu siapa kamu.",
    "emotion": "看著她"
  },
  "zq54a17": {
    "text": "Tidak tanya?",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "Kalau kamu mau cerita,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Kalau siap,"
  },
  "zq54a19": {
    "text": "baru aku dengar.",
    "emotion": "很穩",
    "say": "aku dengar."
  },
  "zq54a20": {
    "text": "Punyamu.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "Aku…",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a22": {
    "text": "tak berani membukanya.",
    "emotion": "很小聲",
    "say": "tak berani buka."
  },
  "zq54a23": {
    "text": "Aku temani kau membukanya.",
    "emotion": "很溫柔",
    "say": "Kita buka bersama."
  },
  "zq54a24": {
    "text": "Ayah…",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "Kertas kosong?",
    "emotion": "畫外，愣住",
    "say": "Kosong?"
  },
  "zq54a26": {
    "text": "Mana ada surat,",
    "emotion": "嘲弄，快，說完就停"
  },
  "zq54a27": {
    "text": "aku menipumu.",
    "emotion": "得意",
    "say": "kau tertipu."
  },
  "zq54a28": {
    "text": "Kukira…",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "kukira aku sudah menemukannya…",
    "emotion": "哽咽",
    "say": "kukira sudah ketemu…"
  },
  "zq54a30": {
    "text": "Aku di sini.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "Rombongan itu,",
    "emotion": "淡淡的，快，說完就停",
    "say": "Mereka,"
  },
  "zq54a32": {
    "text": "besok pagi dibawa ke prefektur.",
    "emotion": "很穩，快，說完就停",
    "say": "besok ke prefektur."
  },
  "zq54a33": {
    "text": "Hari ayahku dihukum,",
    "emotion": "很低，快，說完就停",
    "say": "Saat ayah dihukum,"
  },
  "zq54a34": {
    "text": "tuduhannya bersekongkol dengan musuh.",
    "emotion": "咬牙",
    "say": "tuduhannya berkhianat."
  },
  "zq54a35": {
    "text": "Ia menjaga perbatasan utara dua puluh tahun.",
    "emotion": "聲音發顫",
    "say": "Dua puluh tahun jaga perbatasan."
  },
  "zq54a36": {
    "text": "Giok ini,",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "tak pernah lepas darinya.",
    "emotion": "畫外，快，說完就停",
    "say": "tak pernah lepas."
  },
  "zq54a38": {
    "text": "Ia titipkan pada pengawal paling tepercaya,",
    "emotion": "慢慢說",
    "say": "Dititipkan ke pengawal setia,"
  },
  "zq54a39": {
    "text": "untuk dibawa pergi.",
    "emotion": "很輕",
    "say": "dibawa pergi."
  },
  "zq54a40": {
    "text": "Orang itu,",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "Dia,"
  },
  "zq54a41": {
    "text": "tak pernah kembali.",
    "emotion": "幾乎聽不見"
  },
  "zq54a42": {
    "text": "Terakhir,",
    "emotion": "低聲，快，說完就停",
    "say": "Akhirnya,"
  },
  "zq54a43": {
    "text": "dia pergi ke mana?",
    "emotion": "低",
    "say": "ke mana dia?"
  },
  "zq54a44": {
    "text": "Surat terakhirnya bilang,",
    "emotion": "很慢",
    "say": "Surat terakhir bilang,"
  },
  "zq54a45": {
    "text": "sudah sampai di Liuxi, Qingzhou.",
    "emotion": "看著他",
    "say": "sampai di Liuxi."
  },
  "zq54a46": {
    "text": "Jadi giok ini",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a47": {
    "text": "hilang di Liuxi.",
    "emotion": "低聲"
  },
  "zq54a48": {
    "text": "Ibu tak kunjung dapat kabar,",
    "emotion": "低聲，極短促，一口氣說完，不拖音",
    "say": "Ibu tak dapat kabar,"
  },
  "zq54a49": {
    "text": "jatuh sakit dan tak bangun lagi.",
    "emotion": "很輕，快，說完就停",
    "say": "sakit lalu wafat."
  },
  "zq54a50": {
    "text": "Makam di hutan bambu itu,",
    "emotion": "很慢",
    "say": "Makam di hutan bambu,"
  },
  "zq54a51": {
    "text": "itu ibuku.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "Fitnah atas ayahmu,",
    "emotion": "很穩，快，說完就停",
    "say": "Fitnah ayahmu,"
  },
  "zq54a53": {
    "text": "akan kubersihkan bersamamu.",
    "emotion": "很穩，快，說完就停",
    "say": "kita bersihkan."
  },
  "zq54a54": {
    "text": "Malam di penginapan itu,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Di penginapan,"
  },
  "zq54a55": {
    "text": "terima kasih sudah menahanku.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "makasih menahanku."
  },
  "zq54a56": {
    "text": "Poin suka Qin Shuang, enam puluh enam.",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang, enam puluh enam."
  },
  "zq54a57": {
    "text": "Xu Yan.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "Kau sering tersenyum ke arah sana.",
    "emotion": "好奇，很直",
    "say": "Kau sering senyum ke sana."
  },
  "zq54a59": {
    "text": "Ada apa di sana?",
    "emotion": "追問"
  }
}
