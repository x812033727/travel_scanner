{
  "zq54a01": {
    "text": "手紙は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "手紙、"
  },
  "zq54a02": {
    "text": "自分で取る。",
    "emotion": "一字一字"
  },
  "zq54a03": {
    "text": "取った。",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "お、お助けを……",
    "emotion": "嚇破膽，快，說完就停",
    "say": "お助けを……"
  },
  "zq54a05": {
    "text": "州の牢には、",
    "emotion": "冷"
  },
  "zq54a06": {
    "text": "今度はあんたが入る番。",
    "emotion": "抬下巴",
    "say": "あんたが入れ。"
  },
  "zq54a07": {
    "text": "この鎖、",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "返してやる。",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "返す。"
  },
  "zq54a09": {
    "text": "お前らが逆らった相手は、",
    "emotion": "陰沉",
    "say": "お前らの相手は、"
  },
  "zq54a10": {
    "text": "手に負えねえぞ。",
    "emotion": "冷笑"
  },
  "zq54a11": {
    "text": "手紙は渡しただろ、",
    "emotion": "陪笑",
    "say": "手紙は渡した、"
  },
  "zq54a12": {
    "text": "命だけは助けてくれ。",
    "emotion": "討饒",
    "say": "見逃してくれ。"
  },
  "zq54a13": {
    "text": "父のものは、",
    "emotion": "冷"
  },
  "zq54a14": {
    "text": "もともと私のものよ。",
    "emotion": "一字一字",
    "say": "元から私のもの。"
  },
  "zq54a15": {
    "text": "あいつ、",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "君の正体を知ってるって。",
    "emotion": "低聲，快，說完就停",
    "say": "正体を知ってる。"
  },
  "zq54a17": {
    "text": "聞かないの？",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "話したくなったら、",
    "emotion": "很輕，快，說完就停",
    "say": "話せる時に、"
  },
  "zq54a19": {
    "text": "そのとき聞く。",
    "emotion": "很穩"
  },
  "zq54a20": {
    "text": "あなたの。",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "私……",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "私…"
  },
  "zq54a22": {
    "text": "怖くて開けられない。",
    "emotion": "很小聲",
    "say": "開けられない。"
  },
  "zq54a23": {
    "text": "一緒に開けよう。",
    "emotion": "很溫柔"
  },
  "zq54a24": {
    "text": "父上……",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "白紙？",
    "emotion": "畫外，愣住"
  },
  "zq54a26": {
    "text": "手紙なんかねえよ、",
    "emotion": "大笑"
  },
  "zq54a27": {
    "text": "騙したのさ。",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "てっきり……",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "父を見つけたと思ったのに……",
    "emotion": "哽咽",
    "say": "見つけたと思ったのに……"
  },
  "zq54a30": {
    "text": "ここにいる。",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "あの連中は、",
    "emotion": "淡淡的，快，說完就停",
    "say": "奴らは、"
  },
  "zq54a32": {
    "text": "明朝、州府へ護送だ。",
    "emotion": "很穩，快，說完就停",
    "say": "明朝、州府へ。"
  },
  "zq54a33": {
    "text": "父が罪に問われた日、",
    "emotion": "很低，望著火"
  },
  "zq54a34": {
    "text": "罪状は敵との内通。",
    "emotion": "咬牙",
    "say": "罪状は内通。"
  },
  "zq54a35": {
    "text": "北の辺境を二十年守ってきたのに。",
    "emotion": "聲音發顫",
    "say": "二十年、辺境を守ったのに。"
  },
  "zq54a36": {
    "text": "この玉は、",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "片時も離さなかった。",
    "emotion": "畫外，快，說完就停",
    "say": "肌身離さず。"
  },
  "zq54a38": {
    "text": "一番信頼する親兵に託して、",
    "emotion": "慢慢說",
    "say": "腹心の兵に託して、"
  },
  "zq54a39": {
    "text": "送り出したの。",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "その人は、",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "彼は、"
  },
  "zq54a41": {
    "text": "二度と戻らなかった。",
    "emotion": "幾乎聽不見"
  },
  "zq54a42": {
    "text": "最後に、",
    "emotion": "小心地問"
  },
  "zq54a43": {
    "text": "どこへ行った？",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "最後の手紙には、",
    "emotion": "很慢"
  },
  "zq54a45": {
    "text": "青州の柳渓に着いたと。",
    "emotion": "看著他，快，說完就停",
    "say": "柳渓に着いたと。"
  },
  "zq54a46": {
    "text": "じゃあこの玉は、",
    "emotion": "低聲，快，說完就停",
    "say": "この玉は、"
  },
  "zq54a47": {
    "text": "柳渓で失われたのか。",
    "emotion": "低聲"
  },
  "zq54a48": {
    "text": "母は便りを待ちきれず、",
    "emotion": "低聲，快，說完就停",
    "say": "母は便りを待てず、"
  },
  "zq54a49": {
    "text": "病に倒れて、それきり。",
    "emotion": "很輕，快，說完就停",
    "say": "病に倒れたきり。"
  },
  "zq54a50": {
    "text": "竹林のあのお墓は、",
    "emotion": "很慢"
  },
  "zq54a51": {
    "text": "母なの。",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "君の父上の冤罪は、",
    "emotion": "很穩",
    "say": "父上の冤罪、"
  },
  "zq54a53": {
    "text": "一緒に晴らそう。",
    "emotion": "一字一字"
  },
  "zq54a54": {
    "text": "宿屋のあの夜、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "宿屋の夜、"
  },
  "zq54a55": {
    "text": "止めてくれてありがとう。",
    "emotion": "第一次這麼軟，快，說完就停",
    "say": "止めてくれてありがと。"
  },
  "zq54a56": {
    "text": "チン・シュアン、好感度、六十六。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq54a57": {
    "text": "シュー・イェン。",
    "emotion": "低聲，快，說完就停"
  },
  "zq54a58": {
    "text": "あなた、よくあそこに笑いかけてる。",
    "emotion": "好奇，很直",
    "say": "よくあそこに笑ってる。"
  },
  "zq54a59": {
    "text": "あそこに何があるの？",
    "emotion": "追問",
    "say": "何があるの？"
  }
}
