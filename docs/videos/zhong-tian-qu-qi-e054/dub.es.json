{
  "zq54a01": {
    "text": "La carta,",
    "emotion": "很冷"
  },
  "zq54a02": {
    "text": "la tomo yo misma.",
    "emotion": "一字一字",
    "say": "la tomo yo."
  },
  "zq54a03": {
    "text": "La tengo.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "¡Pi-piedad…!",
    "emotion": "嚇破膽",
    "say": "¡Piedad…!"
  },
  "zq54a05": {
    "text": "La cárcel de la prefectura,",
    "emotion": "冷",
    "say": "La cárcel,"
  },
  "zq54a06": {
    "text": "ahora te toca a ti.",
    "emotion": "抬下巴",
    "say": "te toca a ti."
  },
  "zq54a07": {
    "text": "Esta cadena,",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "te la devuelvo.",
    "emotion": "畫外，拉緊"
  },
  "zq54a09": {
    "text": "A quien ofendieron,",
    "emotion": "陰沉"
  },
  "zq54a10": {
    "text": "es demasiado para ustedes.",
    "emotion": "冷笑",
    "say": "les queda grande."
  },
  "zq54a11": {
    "text": "Ya tienes la carta,",
    "emotion": "陪笑"
  },
  "zq54a12": {
    "text": "perdóname la vida.",
    "emotion": "討饒",
    "say": "déjame ir."
  },
  "zq54a13": {
    "text": "Lo que era de mi padre",
    "emotion": "冷"
  },
  "zq54a14": {
    "text": "siempre fue mío.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "Dijo",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "que sabe quién eres.",
    "emotion": "看著她"
  },
  "zq54a17": {
    "text": "¿No preguntas?",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "Cuando quieras contarlo,",
    "emotion": "笑，很輕",
    "say": "Cuando quieras,"
  },
  "zq54a19": {
    "text": "te escucharé.",
    "emotion": "很穩",
    "say": "te escucho."
  },
  "zq54a20": {
    "text": "Tuya.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "Yo…",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a22": {
    "text": "no me atrevo a abrirla.",
    "emotion": "很小聲",
    "say": "no me atrevo."
  },
  "zq54a23": {
    "text": "La abrimos juntos.",
    "emotion": "很溫柔"
  },
  "zq54a24": {
    "text": "Padre…",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "¿En blanco?",
    "emotion": "畫外，愣住"
  },
  "zq54a26": {
    "text": "No hay ninguna carta,",
    "emotion": "嘲弄，快，說完就停",
    "say": "No hay carta,"
  },
  "zq54a27": {
    "text": "te engañé.",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "Creí que…",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "creí que lo había encontrado…",
    "emotion": "哽咽",
    "say": "creí que lo hallé…"
  },
  "zq54a30": {
    "text": "Aquí estoy.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "Esa fila de presos,",
    "emotion": "淡淡的，快，說完就停",
    "say": "Esos,"
  },
  "zq54a32": {
    "text": "mañana temprano van a la prefectura.",
    "emotion": "很穩",
    "say": "al alba, a la prefectura."
  },
  "zq54a33": {
    "text": "El día que condenaron a mi padre,",
    "emotion": "很低，快，說完就停",
    "say": "Cuando condenaron a papá,"
  },
  "zq54a34": {
    "text": "el cargo fue colaborar con el enemigo.",
    "emotion": "咬牙",
    "say": "el cargo: traición."
  },
  "zq54a35": {
    "text": "Defendió la frontera norte veinte años.",
    "emotion": "聲音發顫",
    "say": "Veinte años defendió el norte."
  },
  "zq54a36": {
    "text": "Este jade",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "nunca se lo quitaba.",
    "emotion": "畫外，快，說完就停",
    "say": "nunca se lo quitó."
  },
  "zq54a38": {
    "text": "Se lo dio a su guardia más fiel",
    "emotion": "慢慢說",
    "say": "Se lo dio a su guardia fiel"
  },
  "zq54a39": {
    "text": "para que lo sacara.",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "Ese hombre",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "Él"
  },
  "zq54a41": {
    "text": "nunca volvió.",
    "emotion": "幾乎聽不見"
  },
  "zq54a42": {
    "text": "Y al final,",
    "emotion": "小心地問"
  },
  "zq54a43": {
    "text": "¿adónde fue?",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "Su última carta decía",
    "emotion": "很慢"
  },
  "zq54a45": {
    "text": "que llegó a Liuxi, en Qingzhou.",
    "emotion": "看著他",
    "say": "que llegó a Liuxi."
  },
  "zq54a46": {
    "text": "Entonces este jade",
    "emotion": "恍然",
    "say": "Así que el jade"
  },
  "zq54a47": {
    "text": "se perdió en Liuxi.",
    "emotion": "低聲"
  },
  "zq54a48": {
    "text": "Mi madre nunca tuvo noticias,",
    "emotion": "低聲，快，說完就停",
    "say": "Mamá no supo nada,"
  },
  "zq54a49": {
    "text": "enfermó y no se levantó más.",
    "emotion": "很輕，快，說完就停",
    "say": "enfermó y murió."
  },
  "zq54a50": {
    "text": "La tumba del bambusal",
    "emotion": "很慢",
    "say": "La tumba del bambú"
  },
  "zq54a51": {
    "text": "es de mi madre.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "El nombre de tu padre,",
    "emotion": "很穩"
  },
  "zq54a53": {
    "text": "lo limpiaremos juntos.",
    "emotion": "很穩，快，說完就停",
    "say": "lo limpiamos juntos."
  },
  "zq54a54": {
    "text": "Aquella noche en la posada,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "En la posada,"
  },
  "zq54a55": {
    "text": "gracias por detenerme.",
    "emotion": "第一次這麼軟，快，說完就停",
    "say": "gracias por frenarme."
  },
  "zq54a56": {
    "text": "Qin Shuang, afecto: sesenta y seis.",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang: sesenta y seis."
  },
  "zq54a57": {
    "text": "Xu Yan.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "Siempre le sonríes a ese lugar.",
    "emotion": "好奇，很直",
    "say": "Siempre sonríes hacia ahí."
  },
  "zq54a59": {
    "text": "¿Qué hay ahí?",
    "emotion": "追問"
  }
}
