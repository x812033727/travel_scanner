{
  "zq54a01": {
    "text": "편지,",
    "emotion": "很冷"
  },
  "zq54a02": {
    "text": "내가 직접 가져간다.",
    "emotion": "一字一字",
    "say": "내가 가져가."
  },
  "zq54a03": {
    "text": "잡았어.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "사, 살려 주시오……",
    "emotion": "嚇破膽",
    "say": "살려 주시오……"
  },
  "zq54a05": {
    "text": "주 감옥엔,",
    "emotion": "冷",
    "say": "감옥엔,"
  },
  "zq54a06": {
    "text": "이제 네가 들어가.",
    "emotion": "抬下巴，快，說完就停",
    "say": "네가 가."
  },
  "zq54a07": {
    "text": "이 쇠사슬,",
    "emotion": "畫外，笑，冷",
    "say": "이 사슬,"
  },
  "zq54a08": {
    "text": "돌려주지.",
    "emotion": "畫外，拉緊"
  },
  "zq54a09": {
    "text": "너희가 건드린 사람은,",
    "emotion": "陰沉",
    "say": "너희가 건드린 건,"
  },
  "zq54a10": {
    "text": "감당 못 해.",
    "emotion": "冷笑"
  },
  "zq54a11": {
    "text": "편지도 줬잖아,",
    "emotion": "陪笑"
  },
  "zq54a12": {
    "text": "목숨만 살려 줘.",
    "emotion": "討饒",
    "say": "살려 줘."
  },
  "zq54a13": {
    "text": "아버지 물건은,",
    "emotion": "冷"
  },
  "zq54a14": {
    "text": "원래 내 거야.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "저자가,",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "네가 누군지 안대.",
    "emotion": "看著她"
  },
  "zq54a17": {
    "text": "안 물어?",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "말하고 싶을 때,",
    "emotion": "很輕，快，說完就停",
    "say": "말할 때,"
  },
  "zq54a19": {
    "text": "그때 들을게.",
    "emotion": "很穩"
  },
  "zq54a20": {
    "text": "네 거.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "나……",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "나…"
  },
  "zq54a22": {
    "text": "뜯을 엄두가 안 나.",
    "emotion": "很小聲",
    "say": "못 뜯겠어."
  },
  "zq54a23": {
    "text": "같이 뜯자.",
    "emotion": "很溫柔"
  },
  "zq54a24": {
    "text": "아버지……",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "백지?",
    "emotion": "畫外，愣住"
  },
  "zq54a26": {
    "text": "편지는 무슨,",
    "emotion": "大笑"
  },
  "zq54a27": {
    "text": "속인 거다.",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "난……",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "아버지를 찾은 줄 알았어……",
    "emotion": "哽咽",
    "say": "찾은 줄 알았어……"
  },
  "zq54a30": {
    "text": "내가 있어.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "저 패거리는,",
    "emotion": "淡淡的，快，說完就停",
    "say": "저놈들,"
  },
  "zq54a32": {
    "text": "내일 아침 주 관아로 압송해.",
    "emotion": "很穩，快，說完就停",
    "say": "내일 관아로 압송."
  },
  "zq54a33": {
    "text": "아버지가 죄를 받던 날,",
    "emotion": "很低，快，說完就停",
    "say": "아버지 죄받던 날,"
  },
  "zq54a34": {
    "text": "죄명은 적과의 내통이었어.",
    "emotion": "咬牙",
    "say": "죄명은 내통이었어."
  },
  "zq54a35": {
    "text": "북방 변경을 이십 년 지키셨는데.",
    "emotion": "聲音發顫",
    "say": "변경을 이십 년 지키셨는데."
  },
  "zq54a36": {
    "text": "이 옥은,",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "늘 몸에 지니셨어.",
    "emotion": "畫外，快，說完就停",
    "say": "늘 지니셨어."
  },
  "zq54a38": {
    "text": "가장 믿는 친병에게 맡겨,",
    "emotion": "慢慢說",
    "say": "믿는 친병에게 맡겨,"
  },
  "zq54a39": {
    "text": "내보내셨어.",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "그 사람은,",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "그는,"
  },
  "zq54a41": {
    "text": "끝내 돌아오지 않았어.",
    "emotion": "幾乎聽不見",
    "say": "끝내 안 돌아왔어."
  },
  "zq54a42": {
    "text": "마지막에,",
    "emotion": "小心地問"
  },
  "zq54a43": {
    "text": "어디로 갔어?",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "마지막 편지에,",
    "emotion": "很慢"
  },
  "zq54a45": {
    "text": "청주 류시에 닿았다고.",
    "emotion": "看著他"
  },
  "zq54a46": {
    "text": "그럼 이 옥은,",
    "emotion": "恍然",
    "say": "그럼 옥은,"
  },
  "zq54a47": {
    "text": "류시에서 잃어버린 거군.",
    "emotion": "低聲",
    "say": "류시에서 잃은 거군."
  },
  "zq54a48": {
    "text": "어머니는 소식을 못 받고,",
    "emotion": "低聲，快，說完就停",
    "say": "어머닌 소식 없이,"
  },
  "zq54a49": {
    "text": "병이 나서 다시 못 일어나셨어.",
    "emotion": "很輕",
    "say": "앓다 가셨어."
  },
  "zq54a50": {
    "text": "대숲의 그 무덤,",
    "emotion": "很慢"
  },
  "zq54a51": {
    "text": "우리 어머니야.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "네 아버지 누명,",
    "emotion": "很穩，快，說完就停",
    "say": "네 부친 누명,"
  },
  "zq54a53": {
    "text": "내가 같이 벗길게.",
    "emotion": "一字一字",
    "say": "같이 벗기자."
  },
  "zq54a54": {
    "text": "객잔에서 그날 밤,",
    "emotion": "很輕",
    "say": "그날 밤,"
  },
  "zq54a55": {
    "text": "붙잡아 줘서 고마워.",
    "emotion": "第一次這麼軟，快，說完就停",
    "say": "잡아 줘서 고마워."
  },
  "zq54a56": {
    "text": "친솽 호감도, 육십육.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq54a57": {
    "text": "쉬옌.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "너 자꾸 저기 보고 웃더라.",
    "emotion": "好奇，很直",
    "say": "자꾸 저기 보고 웃더라."
  },
  "zq54a59": {
    "text": "저기 뭐가 있어?",
    "emotion": "追問",
    "say": "뭐가 있어?"
  }
}
