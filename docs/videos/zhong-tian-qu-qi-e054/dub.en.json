{
  "zq54a01": {
    "text": "The letter,",
    "emotion": "很冷"
  },
  "zq54a02": {
    "text": "I'll take it myself.",
    "emotion": "一字一字",
    "say": "I'll take it."
  },
  "zq54a03": {
    "text": "Got it.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "M-mercy…",
    "emotion": "嚇破膽"
  },
  "zq54a05": {
    "text": "The prefecture jail,",
    "emotion": "冷",
    "say": "The jail,"
  },
  "zq54a06": {
    "text": "now it's your turn to sit in it.",
    "emotion": "抬下巴",
    "say": "your turn now."
  },
  "zq54a07": {
    "text": "This chain,",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "back to you.",
    "emotion": "畫外，拉緊"
  },
  "zq54a09": {
    "text": "The people you've crossed,",
    "emotion": "陰沉",
    "say": "Who you crossed,"
  },
  "zq54a10": {
    "text": "are too big for you.",
    "emotion": "冷笑",
    "say": "too big for you."
  },
  "zq54a11": {
    "text": "You've got the letter,",
    "emotion": "陪笑"
  },
  "zq54a12": {
    "text": "so spare my life.",
    "emotion": "討饒",
    "say": "spare me."
  },
  "zq54a13": {
    "text": "What was my father's",
    "emotion": "冷"
  },
  "zq54a14": {
    "text": "was always mine.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "He said",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "he knows who you are.",
    "emotion": "看著她"
  },
  "zq54a17": {
    "text": "You won't ask?",
    "emotion": "很輕"
  },
  "zq54a18": {
    "text": "When you want to tell me,",
    "emotion": "笑，很輕",
    "say": "When you're ready,"
  },
  "zq54a19": {
    "text": "I'll listen.",
    "emotion": "很穩"
  },
  "zq54a20": {
    "text": "Yours.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "I…",
    "emotion": "聲音發抖"
  },
  "zq54a22": {
    "text": "I'm afraid to open it.",
    "emotion": "很小聲",
    "say": "can't open it."
  },
  "zq54a23": {
    "text": "I'll open it with you.",
    "emotion": "很溫柔",
    "say": "Together, then."
  },
  "zq54a24": {
    "text": "Father…",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "A blank sheet?",
    "emotion": "畫外，愣住",
    "say": "Blank?"
  },
  "zq54a26": {
    "text": "There's no letter,",
    "emotion": "大笑"
  },
  "zq54a27": {
    "text": "I tricked you.",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "I thought…",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "I thought I'd found him…",
    "emotion": "哽咽"
  },
  "zq54a30": {
    "text": "I'm here.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "That lot,",
    "emotion": "淡淡的，快，說完就停",
    "say": "Them,"
  },
  "zq54a32": {
    "text": "go back to the prefecture at dawn.",
    "emotion": "很穩",
    "say": "to the prefecture at dawn."
  },
  "zq54a33": {
    "text": "The day my father was convicted,",
    "emotion": "很低，快，說完就停",
    "say": "When Father was convicted,"
  },
  "zq54a34": {
    "text": "the charge was colluding with the enemy.",
    "emotion": "咬牙",
    "say": "the charge was treason."
  },
  "zq54a35": {
    "text": "He held the northern frontier for twenty years.",
    "emotion": "聲音發顫",
    "say": "He held the frontier twenty years."
  },
  "zq54a36": {
    "text": "This jade,",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "he never took it off.",
    "emotion": "畫外，哽咽",
    "say": "never left him."
  },
  "zq54a38": {
    "text": "He gave it to his most trusted guard,",
    "emotion": "慢慢說",
    "say": "He gave it to his trusted guard,"
  },
  "zq54a39": {
    "text": "to get it out.",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "That man",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "He"
  },
  "zq54a41": {
    "text": "never came back.",
    "emotion": "幾乎聽不見"
  },
  "zq54a42": {
    "text": "And in the end,",
    "emotion": "小心地問"
  },
  "zq54a43": {
    "text": "where did he go?",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "His last letter said",
    "emotion": "很慢"
  },
  "zq54a45": {
    "text": "he'd reached Liuxi, in Qingzhou.",
    "emotion": "看著他",
    "say": "he'd reached Liuxi."
  },
  "zq54a46": {
    "text": "So this jade",
    "emotion": "低聲，快，說完就停",
    "say": "So the jade"
  },
  "zq54a47": {
    "text": "was lost in Liuxi.",
    "emotion": "低聲"
  },
  "zq54a48": {
    "text": "My mother never got word,",
    "emotion": "低聲，快，說完就停",
    "say": "Mother got no word,"
  },
  "zq54a49": {
    "text": "she fell ill and never got up again.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "fell ill and died."
  },
  "zq54a50": {
    "text": "That grave in the bamboo grove",
    "emotion": "很慢"
  },
  "zq54a51": {
    "text": "is my mother's.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "Your father's name,",
    "emotion": "很穩"
  },
  "zq54a53": {
    "text": "we'll clear it together.",
    "emotion": "一字一字"
  },
  "zq54a54": {
    "text": "That night at the inn,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "At the inn,"
  },
  "zq54a55": {
    "text": "thank you for holding me back.",
    "emotion": "第一次這麼軟，快，說完就停",
    "say": "thanks for stopping me."
  },
  "zq54a56": {
    "text": "Qin Shuang, affection: sixty-six.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq54a57": {
    "text": "Xu Yan.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "You keep smiling at that spot.",
    "emotion": "好奇，很直"
  },
  "zq54a59": {
    "text": "What's over there?",
    "emotion": "追問",
    "say": "What's there?"
  }
}
