{
  "zq54a01": {
    "text": "A carta,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Carta,"
  },
  "zq54a02": {
    "text": "eu mesma pego.",
    "emotion": "一字一字",
    "say": "eu pego."
  },
  "zq54a03": {
    "text": "Peguei.",
    "emotion": "淡淡的"
  },
  "zq54a04": {
    "text": "P-perdão…",
    "emotion": "嚇破膽",
    "say": "Perdão…"
  },
  "zq54a05": {
    "text": "A cadeia da prefeitura,",
    "emotion": "冷，快，說完就停",
    "say": "A cadeia,"
  },
  "zq54a06": {
    "text": "agora quem vai pra lá é você.",
    "emotion": "抬下巴",
    "say": "agora é sua."
  },
  "zq54a07": {
    "text": "Esta corrente,",
    "emotion": "畫外，笑，冷"
  },
  "zq54a08": {
    "text": "devolvo pra você.",
    "emotion": "畫外，拉緊",
    "say": "toma de volta."
  },
  "zq54a09": {
    "text": "Quem vocês provocaram",
    "emotion": "陰沉"
  },
  "zq54a10": {
    "text": "é demais pra vocês.",
    "emotion": "冷笑"
  },
  "zq54a11": {
    "text": "Já te dei a carta,",
    "emotion": "陪笑"
  },
  "zq54a12": {
    "text": "me deixa viver.",
    "emotion": "討饒",
    "say": "me poupa."
  },
  "zq54a13": {
    "text": "O que era do meu pai",
    "emotion": "冷，快，說完就停",
    "say": "O que era do pai"
  },
  "zq54a14": {
    "text": "sempre foi meu.",
    "emotion": "一字一字"
  },
  "zq54a15": {
    "text": "Ele disse",
    "emotion": "低聲"
  },
  "zq54a16": {
    "text": "que sabe quem você é.",
    "emotion": "看著她"
  },
  "zq54a17": {
    "text": "Não vai perguntar?",
    "emotion": "很輕",
    "say": "Não pergunta?"
  },
  "zq54a18": {
    "text": "Quando quiser contar,",
    "emotion": "笑，很輕",
    "say": "Quando quiser,"
  },
  "zq54a19": {
    "text": "eu escuto.",
    "emotion": "很穩"
  },
  "zq54a20": {
    "text": "É sua.",
    "emotion": "很輕"
  },
  "zq54a21": {
    "text": "Eu…",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq54a22": {
    "text": "não tenho coragem de abrir.",
    "emotion": "很小聲",
    "say": "não consigo abrir."
  },
  "zq54a23": {
    "text": "Eu abro com você.",
    "emotion": "很溫柔"
  },
  "zq54a24": {
    "text": "Pai…",
    "emotion": "很輕，發抖"
  },
  "zq54a25": {
    "text": "Em branco?",
    "emotion": "畫外，愣住"
  },
  "zq54a26": {
    "text": "Não tem carta nenhuma,",
    "emotion": "嘲弄，快，說完就停",
    "say": "Que carta,"
  },
  "zq54a27": {
    "text": "te enganei.",
    "emotion": "得意"
  },
  "zq54a28": {
    "text": "Eu achei…",
    "emotion": "哭出聲"
  },
  "zq54a29": {
    "text": "achei que tinha encontrado ele…",
    "emotion": "哽咽",
    "say": "achei que o achei…"
  },
  "zq54a30": {
    "text": "Tô aqui.",
    "emotion": "很輕"
  },
  "zq54a31": {
    "text": "Aquela fila de presos,",
    "emotion": "淡淡的，快，說完就停",
    "say": "Aqueles,"
  },
  "zq54a32": {
    "text": "volta pra prefeitura amanhã cedo.",
    "emotion": "很穩，快，說完就停",
    "say": "amanhã, à prefeitura."
  },
  "zq54a33": {
    "text": "No dia em que condenaram meu pai,",
    "emotion": "很低，快，說完就停",
    "say": "Quando condenaram papai,"
  },
  "zq54a34": {
    "text": "a acusação foi conluio com o inimigo.",
    "emotion": "咬牙",
    "say": "acusação: traição."
  },
  "zq54a35": {
    "text": "Ele guardou a fronteira norte por vinte anos.",
    "emotion": "聲音發顫",
    "say": "Guardou a fronteira vinte anos."
  },
  "zq54a36": {
    "text": "Este jade,",
    "emotion": "畫外，很輕"
  },
  "zq54a37": {
    "text": "ele nunca tirava.",
    "emotion": "畫外，快，說完就停",
    "say": "nunca tirava."
  },
  "zq54a38": {
    "text": "Deu ao guarda em quem mais confiava",
    "emotion": "慢慢說",
    "say": "Deu ao guarda mais fiel"
  },
  "zq54a39": {
    "text": "pra levar embora.",
    "emotion": "很輕"
  },
  "zq54a40": {
    "text": "Esse homem",
    "emotion": "低，極短促，一口氣說完，不拖音",
    "say": "Ele"
  },
  "zq54a41": {
    "text": "nunca voltou.",
    "emotion": "幾乎聽不見"
  },
  "zq54a42": {
    "text": "E no fim,",
    "emotion": "小心地問"
  },
  "zq54a43": {
    "text": "pra onde ele foi?",
    "emotion": "低"
  },
  "zq54a44": {
    "text": "A última carta dizia",
    "emotion": "很慢"
  },
  "zq54a45": {
    "text": "que chegou à Vila Liuxi, em Qingzhou.",
    "emotion": "看著他",
    "say": "que chegou à Vila Liuxi."
  },
  "zq54a46": {
    "text": "Então este jade",
    "emotion": "低聲，快，說完就停",
    "say": "Então o jade"
  },
  "zq54a47": {
    "text": "se perdeu na Vila Liuxi.",
    "emotion": "低聲",
    "say": "se perdeu em Liuxi."
  },
  "zq54a48": {
    "text": "Minha mãe nunca teve notícias,",
    "emotion": "低聲，極短促，一口氣說完，不拖音",
    "say": "Mamãe não teve notícia,"
  },
  "zq54a49": {
    "text": "adoeceu e não levantou mais.",
    "emotion": "很輕，快，說完就停",
    "say": "adoeceu e morreu."
  },
  "zq54a50": {
    "text": "Aquele túmulo no bambuzal",
    "emotion": "很慢",
    "say": "O túmulo no bambuzal"
  },
  "zq54a51": {
    "text": "é da minha mãe.",
    "emotion": "眼淚掉下來"
  },
  "zq54a52": {
    "text": "O nome do seu pai,",
    "emotion": "很穩"
  },
  "zq54a53": {
    "text": "a gente limpa junto.",
    "emotion": "很穩，快，說完就停",
    "say": "limpamos juntos."
  },
  "zq54a54": {
    "text": "Aquela noite na estalagem,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Na estalagem,"
  },
  "zq54a55": {
    "text": "obrigada por me segurar.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "valeu por me parar."
  },
  "zq54a56": {
    "text": "Qin Shuang, afeição: sessenta e seis.",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang: sessenta e seis."
  },
  "zq54a57": {
    "text": "Xu Yan.",
    "emotion": "抹掉眼淚"
  },
  "zq54a58": {
    "text": "Você vive sorrindo pra ali.",
    "emotion": "好奇，很直",
    "say": "Vive sorrindo pra ali."
  },
  "zq54a59": {
    "text": "O que tem ali?",
    "emotion": "追問"
  }
}
