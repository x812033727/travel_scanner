{
  "zq7a01": {
    "text": "Letrado Xu—",
    "say": "Ô, Xu—"
  },
  "zq7a02": "No pôr do sol, você é meu.",
  "zq7a03": "Então, fora do mercado.",
  "zq7a04": "Fora do mercado, pra quem?",
  "zq7a05": "Trezentas moedas? Quem se atreve?",
  "zq7a06": "Vou virar a mesa dele!",
  "zq7a07": "Virar mesa não dá lucro.",
  "zq7a08": {
    "text": "Missão: pagar vinte taéis até o pôr do sol.",
    "say": "Vinte taéis até o pôr do sol."
  },
  "zq7a09": "Lavou e não cheirou? Não paga!",
  "zq7a10": "Vinte barras de uma vez?",
  "zq7a11": "Não limpou? Eu pago!",
  "zq7a12": "Ganho: seis taéis.",
  "zq7a13": "Aprendeu com quem?",
  "zq7a14": "Fazia as contas do meu pai.",
  "zq7a15": "Esse sabão queima a mão!",
  "zq7a16": "Queima? Olha eu lavando.",
  "zq7a17": "Lai San, dos Qian!",
  "zq7a18": "Só… só passando…",
  "zq7a19": "Ganho: doze taéis.",
  "zq7a20": "Dezessete taéis…",
  "zq7a21": "Dezoito!",
  "zq7a22": "Pôr do sol em duas horas.",
  "zq7a23": "Me venda a receita.",
  "zq7a24": "Cinquenta taéis.",
  "zq7a25": {
    "text": "Vender a receita, ou apostar no pôr do sol?",
    "say": "Vender, ou apostar no sol?"
  }
}
