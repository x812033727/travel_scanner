{
  "zq7a01": {
    "text": "Letrado Xu…",
    "say": "¡Xu!"
  },
  "zq7a02": "Al atardecer eres mío.",
  "zq7a03": "Fuera del mercado.",
  "zq7a04": "¿Y a quién le vendemos?",
  "zq7a05": "A trescientos, ¿quién?",
  "zq7a06": "¡Le volteo la mesa!",
  "zq7a07": "Voltear mesas no deja dinero.",
  "zq7a08": {
    "text": "Misión: pagar veinte taeles antes del atardecer.",
    "say": "Misión: veinte taeles, hoy."
  },
  "zq7a09": "Una lavada: si no huele, ¡gratis!",
  "zq7a10": "¿Veinte de una vez?",
  "zq7a11": "¡Si no limpia, yo pago!",
  "zq7a12": "Ganado: seis taeles.",
  "zq7a13": "¿Dónde aprendiste?",
  "zq7a14": "Desde niña llevo cuentas.",
  "zq7a15": "¡Ese jabón quema las manos!",
  "zq7a16": "¿Quema? Mira cómo me lavo.",
  "zq7a17": "¡Lai San, de los Qian!",
  "zq7a18": "Yo… solo pasaba…",
  "zq7a19": "Ganado: doce taeles.",
  "zq7a20": {
    "text": "Diecisiete taeles…",
    "say": "Diecisiete…"
  },
  "zq7a21": "¡Dieciocho!",
  "zq7a22": "Atardecer en dos horas.",
  "zq7a23": "Véndame la receta.",
  "zq7a24": "Cincuenta taeles.",
  "zq7a25": {
    "text": "¿Vender la receta, o apostar al atardecer?",
    "say": "¿Vendes la receta o apuestas?"
  }
}
