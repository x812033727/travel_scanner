{
  "zq7a01": "쉬 수재—",
  "zq7a02": "해 지면, 넌 내 거다.",
  "zq7a03": "장터 말고 팔자.",
  "zq7a04": "그럼 어디서?",
  "zq7a05": "한 개 삼 전, 누가 사겠나?",
  "zq7a06": "상 엎으러 간다!",
  "zq7a07": "상 엎으면, 돈 안 돼.",
  "zq7a08": "해 지기 전, 스무 냥 상환.",
  "zq7a09": "써 보고, 별로면 공짜!",
  "zq7a10": "스무 개나?",
  "zq7a11": "못 빼면 내가 물어!",
  "zq7a12": "수익, 여섯 냥.",
  "zq7a13": "어디서 배웠어?",
  "zq7a14": "아빠 장부 담당!",
  "zq7a15": "이 비누 손 상해!",
  "zq7a16": "손 상해? 씻어 볼게.",
  "zq7a17": "첸 가의 라이싼!",
  "zq7a18": "지, 지나가다…",
  "zq7a19": "수익, 열두 냥.",
  "zq7a20": "열일곱 냥…",
  "zq7a21": "열여덟 냥!",
  "zq7a22": "일몰까지, 한 시진.",
  "zq7a23": "그 비법, 파시게.",
  "zq7a24": "쉰 냥.",
  "zq7a25": "비법 판매? 일몰 도박?"
}
