{
  "zq7a01": "ふん。",
  "zq7a02": "日没で、お前は俺のものだ。",
  "zq7a03": "なら市場の外で。",
  "zq7a04": "外で誰に売る？",
  "zq7a05": "一個三銭、誰が買う？",
  "zq7a06": "殴り込みよ！",
  "zq7a07": "暴れても、儲からない。",
  "zq7a08": "日没までに二十両。",
  "zq7a09": "香らなきゃタダよ。",
  "zq7a10": "一気に二十個？",
  "zq7a11": "落ちなきゃ弁償！",
  "zq7a12": "収益、六両。",
  "zq7a13": "誰に習った？",
  "zq7a14": "父の帳簿でね。",
  "zq7a15": "手が荒れるぞ！",
  "zq7a16": "荒れる？洗ってみせる。",
  "zq7a17": "チエン家のライ・サン！",
  "zq7a18": "た、たまたま……",
  "zq7a19": "収益、十二両。",
  "zq7a20": "十七両……",
  "zq7a21": "十八両！",
  "zq7a22": "日没まで、あと二時間。",
  "zq7a23": "製法、売りませんか。",
  "zq7a24": "五十両で。",
  "zq7a25": "売るか、日没に賭けるか？"
}
