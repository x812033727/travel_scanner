{
  "zq7a01": {
    "text": "Sarjana Xu—",
    "say": "Xu—"
  },
  "zq7a02": {
    "text": "Matahari terbenam, kamu milikku.",
    "say": "Senja nanti, kamu milikku."
  },
  "zq7a03": "Ya jangan di pasar.",
  "zq7a04": "Terus jual ke siapa?",
  "zq7a05": {
    "text": "Tiga ratus koin? Siapa mau?",
    "say": "Tiga ratus? Siapa mau?"
  },
  "zq7a06": "Kubalik mejanya!",
  "zq7a07": "Balik meja nggak dapat uang.",
  "zq7a08": {
    "text": "Misi: lunasi dua puluh tael sebelum matahari terbenam.",
    "say": "Misi: lunas sebelum senja."
  },
  "zq7a09": "Sekali cuci nggak wangi, gratis!",
  "zq7a10": "Langsung dua puluh?",
  "zq7a11": "Nggak bersih, aku ganti!",
  "zq7a12": "Didapat: enam tael.",
  "zq7a13": "Belajar dari siapa?",
  "zq7a14": "Dari kecil urus buku Ayah.",
  "zq7a15": "Sabun ini merusak tangan!",
  "zq7a16": "Rusak? Kucuci di depanmu.",
  "zq7a17": "Lai San dari Qian!",
  "zq7a18": {
    "text": "A… aku cuma lewat…",
    "say": "A… aku lewat…"
  },
  "zq7a19": "Didapat: dua belas tael.",
  "zq7a20": "Tujuh belas tael…",
  "zq7a21": "Delapan belas!",
  "zq7a22": {
    "text": "Dua jam lagi matahari terbenam.",
    "say": "Senja, dua jam lagi."
  },
  "zq7a23": "Resepnya, jual padaku.",
  "zq7a24": "Lima puluh tael.",
  "zq7a25": {
    "text": "Jual resep, atau kejar matahari terbenam?",
    "say": "Jual resep, atau taruhan?"
  }
}
