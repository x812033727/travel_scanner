  "zq7a03": "Then we skip the market.",
  "zq7a04": "Sell to who?",
  "zq7a05": "Three hundred coppers? Who'd dare?",
  "zq7a06": "I'll flip his table!",
  "zq7a07": "Flipped tables don't pay.",
  "zq7a08": "Mission: repay twenty taels by sunset.",
  "zq7a09": "Not fragrant after one wash? Free!",
  "zq7a10": "Twenty bars at once?",
  "zq7a11": "Not clean? I'll pay!",
  "zq7a12": "Earned: six taels.",
  "zq7a13": "Where'd you learn that?",
  "zq7a14": "Kept Dad's books as a kid.",
  "zq7a15": "This soap burns your hands!",
  "zq7a16": "Burns? Watch me wash.",
  "zq7a17": "Qian's Lai San!",
  "zq7a18": "J-just passing by…",
  "zq7a19": "Earned: twelve taels.",
  "zq7a20": "Seventeen taels…",
  "zq7a21": "Eighteen!",
  "zq7a22": "Two hours to sunset.",
  "zq7a23": "Sell me the recipe.",
  "zq7a24": "Fifty taels.",
  "zq7a25": "Sell the recipe, or gamble on sunset?"
