{
  "zq6a01": "Dậy, thành thân!",
  "zq6a02": "Giờ Ngọ huyện nha đóng cửa!",
  "zq6a03": "Được, nói điều kiện.",
  "zq6a04": "Sổ sách trong nhà, ta giữ.",
  "zq6a05": "Toàn bộ sổ sách?",
  "zq6a06": "Được, nàng giữ.",
  "zq6a07": "Nửa đêm ta đi đâu,",
  "zq6a08": "ngươi đừng quản.",
  "zq6a09": "Ngủ riêng.",
  "zq6a10": "Chuyện cũ, không được hỏi.",
  "zq6a11": "Đề nghị: đồng ý.",
  "zq6a12": "Nhất bái thiên địa!",
  "zq6a13": "Vương Nhị Ngưu ta làm chứng!",
  "zq6a14": "Nhị bái cao đường…",
  "zq6a15": "Cao đường đâu?",
  "zq6a16": "Vậy bái Tiểu Hòa!",
  "zq6a17": "Phu thê giao bái.",
  "zq6a18": {
    "text": "Hôn thư chưa đóng ấn,",
    "say": "Chưa đóng ấn,"
  },
  "zq6a19": "không tính.",
  "zq6a20": "Trước giờ Ngọ, tới huyện nha!",
  "zq6a21": "Đứng lại!",
  "zq6a22": "Thành thân? Sính lễ đâu?",
  "zq6a23": "Một văn… cũng không có.",
  "zq6a24": {
    "text": "Không sính lễ,",
    "say": "Hừ,"
  },
  "zq6a25": "không đóng ấn.",
  "zq6a26": "Sắp đánh trống giờ Ngọ!",
  "zq6a27": "Hay ta đi cướp?",
  "zq6a28": "Thôi.",
  "zq6a29": "Sính lễ… có rồi!",
  "zq6a30": "Ba phần sính lễ, xin nhận.",
  "zq6a31": "…Thơm à?",
  "zq6a32": "Xà phòng, để rửa tay.",
  "zq6a33": "Nhiệm vụ bắt buộc: hoàn thành.",
  "zq6a34": "Thành hôn: ba trên ba.",
  "zq6a35": "Bảng Lương Duyên: mở.",
  "zq6a36": "Hảo cảm: hiển thị.",
  "zq6a37": "A Lệnh… mới một?",
  "zq6a38": "Chê ít?",
  "zq6a39": "Ta mười lăm nha!",
  "zq6a40": "Sao đóng cửa hết rồi?",
  "zq6a41": {
    "text": "Ai mua hàng nhà họ Hứa,",
    "say": "Mua hàng họ Hứa,"
  },
  "zq6a42": "nợ Tiền phủ một lượng.",
  "zq6a43": {
    "text": "Hứa tú tài,",
    "say": "Tú tài."
  },
  "zq6a44": {
    "text": "mặt trời lặn gặp nhé.",
    "say": "hoàng hôn gặp."
  },
  "zq6a45": "Trước lúc mặt trời lặn, hai mươi lượng…",
  "zq6a46": "Chặn cả phố…",
  "zq6a47": "Bán cho ai?"
}
