{
  "zq6a01": "¡Arriba, boda!",
  "zq6a02": {
    "text": "¡El registro cierra a mediodía!",
    "say": "¡A mediodía cierran!"
  },
  "zq6a03": "Bueno, ¿qué quieren?",
  "zq6a04": "Yo llevo las cuentas.",
  "zq6a05": {
    "text": "¿Todas las cuentas?",
    "say": "¿Todas?"
  },
  "zq6a06": "Va, tuyas.",
  "zq6a07": "A dónde voy de noche",
  "zq6a08": "no es asunto tuyo.",
  "zq6a09": {
    "text": "Duermo sola.",
    "say": "Sola."
  },
  "zq6a10": "Mi pasado: no preguntes.",
  "zq6a11": "Consejo: acepta.",
  "zq6a12": {
    "text": "¡Reverencia al Cielo y la Tierra!",
    "say": "¡Al Cielo y a la Tierra!"
  },
  "zq6a13": "¡Erniu es testigo!",
  "zq6a14": {
    "text": "Reverencia a los padres…",
    "say": "¡A los padres…!"
  },
  "zq6a15": "¿Y los padres?",
  "zq6a16": "¡Entonces a mí!",
  "zq6a17": {
    "text": "¡Reverencia entre esposos!",
    "say": "¡Entre esposos!"
  },
  "zq6a18": {
    "text": "Contrato sin sello:",
    "say": "Sin sello:"
  },
  "zq6a19": "Nulo.",
  "zq6a20": {
    "text": "¡Al registro antes de mediodía!",
    "say": "¡Al registro, rápido!"
  },
  "zq6a21": "¡Alto!",
  "zq6a22": "¿Boda? ¿Y el regalo de bodas?",
  "zq6a23": "Ni un cobre…",
  "zq6a24": "Ja.",
  "zq6a25": {
    "text": "Sin regalo, no sello.",
    "say": "No sello."
  },
  "zq6a26": {
    "text": "¡Ya va a sonar el tambor del mediodía!",
    "say": "¡Ya va el tambor!"
  },
  "zq6a27": "¿Y si lo robo?",
  "zq6a28": "No.",
  "zq6a29": "Regalo de bodas… ¡ya sé!",
  "zq6a30": {
    "text": "Tres regalos. Tenga.",
    "say": "Tres regalos."
  },
  "zq6a31": "¿…Huele rico?",
  "zq6a32": "Jabón. Para las manos.",
  "zq6a33": {
    "text": "Misión obligatoria: cumplida.",
    "say": "Misión cumplida."
  },
  "zq6a34": "Bodas: tres de tres.",
  "zq6a35": {
    "text": "Panel Casamentero: activado.",
    "say": "Panel Casamentero."
  },
  "zq6a36": "Afecto: visible.",
  "zq6a37": "A-Ling… ¿solo uno?",
  "zq6a38": "¿Poco?",
  "zq6a39": "¡Yo tengo quince!",
  "zq6a40": "¿Por qué cerraron todo?",
  "zq6a41": "Cliente de Xu",
  "zq6a42": "debe un tael a Qian.",
  "zq6a43": {
    "text": "Letrado Xu,",
    "say": "¡Letrado!"
  },
  "zq6a44": "¡Al atardecer!",
  "zq6a45": "Veinte taeles antes del atardecer…",
  "zq6a46": {
    "text": "La calle, bloqueada…",
    "say": "Bloqueado…"
  },
  "zq6a47": "¿A quién vendo?"
}
