{
  "zq6a01": {
    "text": "Acordem! Casamento!",
    "say": "Bora casar!"
  },
  "zq6a02": "O cartório fecha ao meio-dia!",
  "zq6a03": "Tá, quais as condições?",
  "zq6a04": "As contas são minhas.",
  "zq6a05": "Todas as contas?",
  "zq6a06": "Fechado!",
  "zq6a07": "Aonde vou à noite",
  "zq6a08": "não é da sua conta.",
  "zq6a09": {
    "text": "Quartos separados.",
    "say": "Sozinha."
  },
  "zq6a10": "Do passado, nada.",
  "zq6a11": {
    "text": "Sugestão: aceite.",
    "say": "Sugestão: sim."
  },
  "zq6a12": "Reverência ao Céu e à Terra!",
  "zq6a13": "Erniu é testemunha!",
  "zq6a14": {
    "text": "Reverência aos pais…",
    "say": "Agora, os pais…"
  },
  "zq6a15": "Cadê os pais?",
  "zq6a16": "Então, pra mim!",
  "zq6a17": {
    "text": "Reverência entre os noivos!",
    "say": "Noivos!"
  },
  "zq6a18": "Sem selo:",
  "zq6a19": "nulo.",
  "zq6a20": {
    "text": "Pro cartório antes do meio-dia!",
    "say": "Pro cartório, já!"
  },
  "zq6a21": "Alto lá!",
  "zq6a22": "Casar? Cadê o dote?",
  "zq6a23": "Nem… uma moeda.",
  "zq6a24": {
    "text": "Sem dote,",
    "say": "Hum,"
  },
  "zq6a25": "sem selo.",
  "zq6a26": {
    "text": "O tambor do meio-dia vai tocar!",
    "say": "Quase meio-dia!"
  },
  "zq6a27": "Quer que eu roube?",
  "zq6a28": "Para.",
  "zq6a29": "O dote… achei!",
  "zq6a30": "Três dotes, por favor.",
  "zq6a31": "…Cheiroso?",
  "zq6a32": "Sabão. Pra lavar as mãos.",
  "zq6a33": {
    "text": "Missão obrigatória: cumprida.",
    "say": "Missão cumprida."
  },
  "zq6a34": "Casamentos: três de três.",
  "zq6a35": {
    "text": "Painel Casamenteiro: ativado.",
    "say": "Painel Casamenteiro."
  },
  "zq6a36": "Afeição: visível.",
  "zq6a37": "A-Ling… só um?",
  "zq6a38": "Pouco?",
  "zq6a39": "Eu tô com quinze!",
  "zq6a40": "Por que tá tudo fechado?",
  "zq6a41": {
    "text": "Quem comprar dos Xu",
    "say": "Quem compra,"
  },
  "zq6a42": "deve um tael aos Qian.",
  "zq6a43": {
    "text": "Letrado Xu,",
    "say": "Ô, Xu,"
  },
  "zq6a44": {
    "text": "ao pôr do sol.",
    "say": "pôr do sol."
  },
  "zq6a45": "Vinte taéis até o pôr do sol…",
  "zq6a46": {
    "text": "Rua fechada…",
    "say": "Fecharam…"
  },
  "zq6a47": "Vendo pra quem?"
}
