{
  "zq6a01": "Bangun, nikah!",
  "zq6a02": "Kantor tutup tengah hari!",
  "zq6a03": "Oke, apa syaratnya.",
  "zq6a04": "Pembukuan, aku pegang.",
  "zq6a05": "Semua pembukuan?",
  "zq6a06": "Oke, pegang.",
  "zq6a07": "Ke mana aku malam-malam,",
  "zq6a08": "bukan urusanmu.",
  "zq6a09": "Pisah kamar.",
  "zq6a10": "Jangan tanya masa lalu.",
  "zq6a11": {
    "text": "Saran: setuju.",
    "say": "Saran setuju."
  },
  "zq6a12": {
    "text": "Hormat pertama, langit dan bumi!",
    "say": "Hormat langit!"
  },
  "zq6a13": "Erniu, saksinya!",
  "zq6a14": "Hormat kedua, orang tua…",
  "zq6a15": "Orang tuanya mana?",
  "zq6a16": "Hormat ke aku aja!",
  "zq6a17": {
    "text": "Suami istri, saling hormat!",
    "say": "Saling hormat!"
  },
  "zq6a18": {
    "text": "Surat nikah belum dicap,",
    "say": "Belum dicap,"
  },
  "zq6a19": "batal.",
  "zq6a20": {
    "text": "Ke kantor bupati sebelum tengah hari!",
    "say": "Ke kantor bupati, cepat!"
  },
  "zq6a21": "Berhenti!",
  "zq6a22": "Menikah? Maharnya mana?",
  "zq6a23": "Sekoin… pun nggak ada.",
  "zq6a24": {
    "text": "Tanpa mahar,",
    "say": "Hmph,"
  },
  "zq6a25": "nggak dicap.",
  "zq6a26": "Genderang mau bunyi!",
  "zq6a27": "Atau aku rampok aja?",
  "zq6a28": "Jangan.",
  "zq6a29": "Mahar… ada!",
  "zq6a30": "Tiga mahar, silakan.",
  "zq6a31": "…Wangi?",
  "zq6a32": "Sabun, buat cuci tangan.",
  "zq6a33": "Misi wajib, selesai.",
  "zq6a34": "Nikah: tiga dari tiga.",
  "zq6a35": "Panel Jodoh, aktif.",
  "zq6a36": "Poin suka, terlihat.",
  "zq6a37": "A-Ling… cuma satu?",
  "zq6a38": "Kurang?",
  "zq6a39": "Aku lima belas, lho!",
  "zq6a40": "Kok semua tutup?",
  "zq6a41": {
    "text": "Siapa beli barang keluarga Xu,",
    "say": "Beli dari Xu,"
  },
  "zq6a42": "utang satu tael ke Qian.",
  "zq6a43": {
    "text": "Sarjana Xu,",
    "say": "Sarjana!"
  },
  "zq6a44": {
    "text": "sampai matahari terbenam.",
    "say": "Senja, ya."
  },
  "zq6a45": {
    "text": "Sebelum matahari terbenam, dua puluh tael…",
    "say": "Sebelum senja, dua puluh tael…"
  },
  "zq6a46": {
    "text": "Jalan ditutup…",
    "say": "Tutup."
  },
  "zq6a47": "Aku jual ke siapa?"
}
