[[SCENE {"id": "E35-S17", "date": "2026-10-17", "location": "L04", "time": "DAY", "cast": ["C01", "C03"], "voice_only": [], "extras": [], "props": ["P32", "P31", "P36"], "flags": ["screen"], "beat": "setup", "planned_seconds": 145}]]

