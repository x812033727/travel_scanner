[[SCENE {"id": "E33-S20", "date": "2026-10-12", "location": "L08", "time": "NIGHT", "cast": ["C01", "C16", "C07", "C40"], "voice_only": [], "extras": [], "props": ["P35", "P45", "P38"], "flags": ["none"], "beat": "setup", "planned_seconds": 130}]]

