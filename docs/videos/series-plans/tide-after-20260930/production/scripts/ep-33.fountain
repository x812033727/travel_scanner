.外景 以寧車後 黃昏 #E33-S17#

[[SCENE {"id": "E33-S17", "date": "2026-10-12", "location": "L32", "time": "DUSK", "cast": ["C01", "C15"], "voice_only": [], "extras": ["員警甲", "員警乙"], "props": ["P45", "P41", "P42", "P35"], "flags": ["vehicle"], "beat": "setup", "planned_seconds": 150}]]

