.內景 鹽澳分局詢問室 黃昏 #E33-S18#

[[SCENE {"id": "E33-S18", "date": "2026-10-12", "location": "L08", "time": "DUSK", "cast": ["C01", "C15", "C16"], "voice_only": [], "extras": ["紀錄人員"], "props": ["P35", "P45", "P41"], "flags": ["none"], "beat": "setup", "planned_seconds": 145}]]

