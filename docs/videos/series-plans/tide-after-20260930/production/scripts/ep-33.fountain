[[SCENE {"id": "E33-S19", "date": "2026-10-12", "location": "L08", "time": "DUSK", "cast": ["C01", "C07", "C15", "C16"], "voice_only": [], "extras": ["紀錄人員"], "props": ["P38", "P31", "P35", "P37"], "flags": ["screen"], "beat": "climax_45", "planned_seconds": 155}]]

