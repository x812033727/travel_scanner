  "lines": {
    "lz101": {
      "source_hash": "cb16bf3f774a",
      "text": "천보 15년, 양귀비는 피란길에 죽었습니다."
    },
    "lz102": {
      "source_hash": "e431779f7fb6",
      "text": "수십 년 뒤, 만당 시인 두목이 여산 화청궁을 읊습니다."
    },
    "lz103": {
      "source_hash": "cc9c9f0b86d2",
      "text": "붉은 먼지에 귀비 웃네, 리치인 줄 누가 알까."
    },
    "lz104": {
      "source_hash": "e9977693d291",
      "text": "송나라가 엮은 『신당서』도, 리치가 수천 리를 달려 맛이 그대로였다고 씁니다."
    },
    "lz105": {
      "source_hash": "97d6c4ecfa49",
      "text": "그런데 백거이는 따고 사흘이면 맛이 변한다고 했습니다."
    },
    "lz106": {
      "source_hash": "ee4d81797e1e",
      "text": "천보 5년, 하루에 갈 역 수를 정한 조서."
    },
    "lz107": {
      "source_hash": "33e13b5897a5",
      "text": "두보가 쓴, 리치를 바치러 달린 사신. 어디서 왔을까?"
    },
    "lz108": {
      "source_hash": "38ac80d9aa68",
      "text": "한 송나라 학자는 같은 책에 이 일을 두 번 썼고,"
    },
    "lz109": {
      "source_hash": "b25e8d01d753",
      "text": "두목의 시가 사실과 다르다는 송나라 사람도."
    },
    "lz110": {
      "source_hash": "1f7b01b07b62",
      "text": "양귀비의 리치, 어떻게 장안에 왔을까?"
    },
    "lz201": {
      "source_hash": "90cf1ed2f977",
      "text": "답은 『신당서』 그 구절 바로 앞에. 말 탄 이를 두어, 역마다 이어 달렸습니다."
    },
    "lz202": {
      "source_hash": "61f9c62a3c5d",
      "text": "당 역은 약 30리마다, 1,600여 곳."
    },
    "lz203": {
      "source_hash": "552c336508cf",
      "text": "하루에 몇 역을 달렸을까?"
    },
    "lz204": {
      "source_hash": "daa2b682443a",
      "text": "평소엔 급하지 않으면 하루 네 역까지."
    },
    "lz205": {
      "source_hash": "6b3f1a7fe620",
      "text": "급하면 통행증에 하루 역 수를 적었고,"
    },
    "lz206": {
      "source_hash": "6d3741264e70",
      "text": "하루 늦으면 곤장 80대."
    },
    "lz207": {
      "source_hash": "e45fb2063c0e",
      "text": "처음 그 조서는 천보 5년 7월."
    },
    "lz208": {
      "source_hash": "4d995b09383f",
      "text": "좌천된 관리들이 늑장을 부리자, 죄가 무거우면 하루 열 역 이상."
    },
    "lz209": {
      "source_hash": "aa15ce2f7d85",
      "text": "열 역이면 약 300리."
    },
    "lz210": {
      "source_hash": "bf6598a1233d",
      "text": "『자치통감』은 이 조서를 리치와 같은 쪽에,"
    },
    "lz211": {
      "source_hash": "b547561d0315",
      "text": "이어서 씁니다. 이후 좌천된 이 다수가 살아서 못 갔다고."
    },
    "lz212": {
      "source_hash": "0319c66de7d7",
      "text": "리치는 며칠을 버틸까?"
    },
    "lz213": {
      "source_hash": "019008a6ac96",
      "text": "당나라 이조는 『당국사보』에, 리치는 한여름에 익고 하룻밤이면 상한다고."
    },
    "lz214": {
      "source_hash": "7ea0e37ca12e",
      "text": "백거이는 그 사흘을 더 자세히:"
    },
    "lz215": {
      "source_hash": "481e0e7833a2",
      "text": "따면 하루에 색, 이틀에 향이 변하고 사오일이면 색향미가 다 사라진다."
    },
    "lz216": {
      "source_hash": "94b809eebe12",
      "text": "쓰촨 충주 벼슬 시절, 리치 그림을 그리게 했죠. 누구 보라고?"
    },
    "lz217": {
      "source_hash": "7c65e923e733",
      "text": "생리치를 못 본 이들."
    },
    "lz218": {
      "source_hash": "607360364565",
      "text": "장안 고관들은 봤을까?"
    },
    "lz219": {
      "source_hash": "429cfe440eb9",
      "text": "개원 연간, 영남 출신 장구령이 장안에서 리치 맛을 자랑했지만,"
    },
    "lz220": {
      "source_hash": "2564b616c304",
      "text": "대부분 모르고 안 믿었다."
    },
    "lz221": {
      "source_hash": "c8077ac55dd2",
      "text": "장안에서 오래 벼슬한 백거이도 충주에서 처음 맛봤습니다."
    },
    "lz222": {
      "source_hash": "1131aeae8341",
      "text": "역마의 리치는 어디서 출발했을까?"
    },
    "lz301": {
      "source_hash": "bd4b29406f17",
      "text": "당나라 두보는 남해라 합니다. 상원 2년, 시에서 그 사신을 떠올리죠."
    },
    "lz302": {
      "source_hash": "fe03ad4257d5",
      "text": "그 옛날 남해 사신이 리치를 바치러 달려왔다고."
    },
    "lz303": {
      "source_hash": "2f92c2d0a750",
      "text": "찾은 당시 가운데 천보에 가장 가깝고, 남해를 명시합니다."
    },
    "lz304": {
      "source_hash": "24c96a0a1de3",
      "text": "몇 해 뒤엔, 현종과 귀비가 죽은 뒤에도 리치는 장안에 갔다고 썼습니다."
    },
    "lz305": {
      "source_hash": "ec733517e2d0",
      "text": "또 다른 시인 포방은 더 과장합니다."
    },
    "lz306": {
      "source_hash": "c5f378c01a47",
      "text": "오월 리치가 익자, 아침에 상군을 떠나 저녁에 함곡관."
    },
    "lz307": {
      "source_hash": "07deccfd59c1",
      "text": "과장이지 기록이 아니라고 봅니다."
    },
    "lz308": {
      "source_hash": "eb8adc11e34b",
      "text": "영남에서 장안까진 얼마나 멀까?"
    },
    "lz309": {
      "source_hash": "0f0f079df984",
      "text": "당 지리지엔 영남 광주서 장안까지 4,200여 리, 다른 길 5,000여 리."
    },
    "lz310": {
      "source_hash": "4eed36be3821",
      "text": "이조의 '하룻밤이면 상한다', 그 글 앞부분엔:"
    },
    "lz311": {
      "source_hash": "5df0c1cf6c2b",
      "text": "귀비는 촉에서 나 리치를 즐겼고, 남해 것이 촉 것보다 나아 해마다 급송했다."
    },
    "lz312": {
      "source_hash": "c0ee1f8697e7",
      "text": "촉에도 리치가 있었습니다. '촉'을 기억하세요."
    },
    "lz313": {
      "source_hash": "69e56f327ad0",
      "text": "만당 소설 『감택요』의 여산 장면:"
    },
    "lz314": {
      "source_hash": "df6e5203c2b2",
      "text": "생일날 현종이 장생전에서 새 곡을 듣는데 남해 리치가 와서,"
    },
    "lz315": {
      "source_hash": "652b4074670c",
      "text": "곡명이 '여지향'."
    },
    "lz316": {
      "source_hash": "9919ef0fa479",
      "text": "송나라 사마광의 『자치통감』은 직설적:"
    },
    "lz317": {
      "source_hash": "c895dd532cd9",
      "text": "해마다 영남에 명해 역마로."
    },
    "lz318": {
      "source_hash": "7a50ebf2dae1",
      "text": "펼친 사서 중 영남을 쓴 건 이것뿐,"
    },
    "lz319": {
      "source_hash": "3d7801439f26",
      "text": "다만 천보에서 이삼백 년 뒤."
    },
    "lz320": {
      "source_hash": "999de42684e6",
      "text": "그런데 같은 송나라에 다른 곳을 댄 사람이. 어디일까?"
    },
    "lz401": {
      "source_hash": "9e9bea48d931",
      "text": "쓰촨의 부주. 북송 채양은 『여지보』에:"
    },
    "lz402": {
      "source_hash": "609dfe5c4536",
      "text": "당 천보 연간 귀비가 즐겨, 부주에서 해마다 역마로 보냈다."
    },
    "lz403": {
      "source_hash": "3b2e3fd335c0",
      "text": "찾은 중 부주를 쓴 가장 이른 글."
    },
    "lz404": {
      "source_hash": "a30bafdc8ff9",
      "text": "아무리 빨라도 도착하면 색향미가 거의 없다고."
    },
    "lz405": {
      "source_hash": "3d4fbdf3815d",
      "text": "이조의 '촉'이 돌아왔습니다. 부주는 쓰촨."
    },
    "lz406": {
      "source_hash": "95eecb153768",
      "text": "소동파도 시의 자주에서 같은 생각:"
    },
    "lz407": {
      "source_hash": "70e713fc9b6f",
      "text": "천보엔 아마 부주 리치를 자오곡 길로 장안에."
    },
    "lz408": {
      "source_hash": "c1449ca3dd4a",
      "text": "그 길은 얼마나?"
    },
    "lz409": {
      "source_hash": "52f3cf640bc4",
      "text": "지리지: 부주서 장안 2,200에서 2,300여 리,"
    },
    "lz410": {
      "source_hash": "5fc612a8e954",
      "text": "영남 길의 절반쯤."
    },
    "lz411": {
      "source_hash": "b6a5f157be07",
      "text": "충주의 백거이? 충주는 부주 바로 하류 이웃."
    },
    "lz412": {
      "source_hash": "fa4e169e434c",
      "text": "그곳 리치는 도성에 갔을까?"
    },
    "lz413": {
      "source_hash": "d48aa0abfaaf",
      "text": "아뇨. 공물이 못 돼 도성에 못 간다고 썼습니다."
    },
    "lz414": {
      "source_hash": "5fa608747220",
      "text": "다만 백거이 때 일, 천보에 없던 증거는 아님."
    },
    "lz415": {
      "source_hash": "adea8db41664",
      "text": "두 번 쓴 송나라 학자는 오증입니다."
    },
    "lz416": {
      "source_hash": "8556771cd1c1",
      "text": "먼저: 사서도 두보 시도 남쪽이라, 현종의 리치는 영남산이 분명하다."
    },
    "lz417": {
      "source_hash": "74525a3abd5e",
      "text": "그런데 같은 책 뒤쪽에서 말을 바꿉니다."
    },
    "lz418": {
      "source_hash": "7de68cf85a0f",
      "text": "『부주도경』을 읽고 현지인에게 묻죠:"
    },
    "lz419": {
      "source_hash": "3297424dac7f",
      "text": "부주에 비자원이 있고, 장안까지 지름길로 이레가 안 걸린다."
    },
    "lz420": {
      "source_hash": "393ce65e6800",
      "text": "동파도 쓰촨 사람이라 실정을 안다고."
    },
    "lz421": {
      "source_hash": "b6dcae39eda6",
      "text": "우리가 보기엔 근거가 지방지와 현지인 말이지, 당 문서가 아닙니다."
    },
    "lz422": {
      "source_hash": "d4bfcf51a0e2",
      "text": "비자원은 훗날 어떻게 쓰였나?"
    },
    "lz423": {
      "source_hash": "51de09a23cc7",
      "text": "남송 지방지 『여지기승』은 비자원을 부주 고적에 넣고:"
    },
    "lz424": {
      "source_hash": "b039c9580bc6",
      "text": "말을 이어 칠일 밤낮에 도성에, 길에서 죽은 사람과 말이 매우 많았다."
    },
    "lz425": {
      "source_hash": "e71e9d5d2c5b",
      "text": "두목의 그 시, 기억나죠? 지방지는 그걸 비자원 항목에 옮겨, 여기라 합니다."
    },
    "lz426": {
      "source_hash": "58283d03a938",
      "text": "뒤의 『방여승람』이 베낄 때 앞에 네 글자를 붙였습니다. '도경상전'."
    },
    "lz427": {
      "source_hash": "aa54d59813f0",
      "text": "송나라 말대로 칠일 밤낮이면, 하루 몇 리?"
    },
    "lz428": {
      "source_hash": "6d2323dea2ee",
      "text": "300여 리. 천보 5년 조서가 다그친 속도와 비슷합니다."
    },
    "lz429": {
      "source_hash": "bcc76b6a32a8",
      "text": "품질은 어땠나?"
    },
    "lz430": {
      "source_hash": "fdb5bc6e30c9",
      "text": "순희 4년 7월, 범성대는"
    },
    "lz431": {
      "source_hash": "d6c6b2355466",
      "text": "부주 리치는 별로라고."
    },
    "lz432": {
      "source_hash": "bf426f115ace",
      "text": "지방지조차 부주 리치는 귀비 덕에 유명할 뿐, 노주와 서주만 못하다고."
    },
    "lz433": {
      "source_hash": "8e72e28c4eba",
      "text": "두목이 틀렸다던 송나라 사람, 무엇을 짚었나?"
    },
    "lz501": {
      "source_hash": "de79f6dff12b",
      "text": "달입니다. 숭녕·대관 무렵, 북송의 진정민은 썼습니다:"
    },
    "lz502": {
      "source_hash": "bafe2a5be608",
      "text": "현종은 늘 시월에 여산에 가 봄이면 환궁, 유월엔 없었다. 이조 말 기억나죠? 리치는 한여름에 익습니다."
    },
    "lz503": {
      "source_hash": "052f474a3c80",
      "text": "결론: 시는 좋으나 사실과 다르다."
    },
    "lz504": {
      "source_hash": "fa504658c463",
      "text": "송나라 왕관국도, 리치가 올 땐 귀비가 이미 화청궁을 떠났다고."
    },
    "lz505": {
      "source_hash": "abf91c756320",
      "text": "그런데 두목을 편든 이가: 정대창."
    },
    "lz506": {
      "source_hash": "9607f5838f09",
      "text": "『감택요』 장면 기억나요? 정대창은 그 날짜를 짚습니다:"
    },
    "lz507": {
      "source_hash": "08feef2f08c9",
      "text": "천보 14년 6월 1일, 귀비 생일, 현종은 여산에."
    },
    "lz508": {
      "source_hash": "aba6d1e03483",
      "text": "한 필기도 들죠. 해마다 칠월 칠일 밤, 둘은 화청궁에서 연회를."
    },
    "lz509": {
      "source_hash": "2257ce6909d1",
      "text": "백거이 「장한가」도: 칠월 칠일 장생전."
    },
    "lz510": {
      "source_hash": "ad0b2198842e",
      "text": "두목은 당시 전해진 사실을 썼다는 것."
    },
    "lz511": {
      "source_hash": "33aad6d67d51",
      "text": "우리가 보기엔 소설·필기·시지, 사서가 아닙니다."
    },
    "lz512": {
      "source_hash": "5d7aab46dc39",
      "text": "사서에선?"
    },
    "lz513": {
      "source_hash": "19f0338fe817",
      "text": "사서 속 여산행은 수십 번, 대부분 진정민 말과 같습니다."
    },
    "lz514": {
      "source_hash": "7c7710a1d0f3",
      "text": "그런데 『구당서』 현종 본기, 천보 8년 여름 4월에 한 줄:"
    },
    "lz515": {
      "source_hash": "3c754a95f730",
      "text": "화청궁 관풍루에 행차. 머문 기간은 없고,"
    },
    "lz516": {
      "source_hash": "bb5431653e17",
      "text": "『신당서』 본기도 『자치통감』도 안 적었습니다."
    },
    "lz517": {
      "source_hash": "c34c6fabd85e",
      "text": "두목도 한 장시에서 화청궁을 팔월로: '누대는 팔월에 서늘'."
    },
    "lz518": {
      "source_hash": "afcadb985261",
      "text": "처음의 그 붉은 먼지 기억나죠? 같은 장시에서 황폐한 화청궁엔 흩어진 리치 바구니뿐."
    },
    "lz519": {
      "source_hash": "5456b5fa502f",
      "text": "역마의 리치, 송나라 사람들의 시 논쟁, 이 파일은 보관. 어디서, 며칠, 신선했나는 아직 미결입니다."
    },
    "lz520": {
      "source_hash": "72528e834235",
      "text": "두목의 붉은 먼지, 계절이 틀렸을까요?"
    },
    "lz521": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 다룹니다. 함께 파일을 열려면 구독을."
    }
  }
}
