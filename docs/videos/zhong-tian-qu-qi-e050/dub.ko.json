{
  "zq50a01": {
    "text": "쉬옌,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "나……",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "해원 나리,",
    "emotion": "諂媚，聲音發抖"
  },
  "zq50a04": {
    "text": "저희가 눈이 멀었습니다!",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "……저우 나리?",
    "emotion": "愣住",
    "say": "……나리?"
  },
  "zq50a06": {
    "text": "그때 그 혼사는,",
    "emotion": "低頭"
  },
  "zq50a07": {
    "text": "이 늙은이가 어리석었습니다.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "인삼, 은자, 옥여의,",
    "emotion": "眼睛發亮，飛快"
  },
  "zq50a09": {
    "text": "못해도 삼백 냥.",
    "emotion": "小聲"
  },
  "zq50a10": {
    "text": "나리,",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "일어나세요.",
    "emotion": "伸手扶",
    "say": "일어나요."
  },
  "zq50a12": {
    "text": "그 옛 빚은,",
    "emotion": "平靜，笑"
  },
  "zq50a13": {
    "text": "제가 갚을 빚이 아닙니다.",
    "emotion": "一字一字",
    "say": "남의 빚이죠."
  },
  "zq50a14": {
    "text": "그럼……",
    "emotion": "傻住"
  },
  "zq50a15": {
    "text": "이 예물은?",
    "emotion": "捧著盒子，快，說完就停",
    "say": "예물은?"
  },
  "zq50a16": {
    "text": "예물은,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "예물,"
  },
  "zq50a17": {
    "text": "도로 가져가세요.",
    "emotion": "客氣但不留",
    "say": "가져가세요."
  },
  "zq50a18": {
    "text": "삼백 냥……",
    "emotion": "心疼"
  },
  "zq50a19": {
    "text": "안 받아?",
    "emotion": "噘嘴"
  },
  "zq50a20": {
    "text": "아까워?",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "해원,",
    "emotion": "笑，走上台階"
  },
  "zq50a22": {
    "text": "노부가 늦었네.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "이건 지부 나리께서",
    "emotion": "示意書童，快，說完就停",
    "say": "지부 나리가"
  },
  "zq50a24": {
    "text": "노부 편에 보내신 걸세.",
    "emotion": "笑",
    "say": "보내신 걸세."
  },
  "zq50a25": {
    "text": "한마디 해 주지.",
    "emotion": "收起笑"
  },
  "zq50a26": {
    "text": "나무가 크면 바람을 탄다네.",
    "emotion": "眼神銳利，極短促，一口氣說完，不拖音",
    "say": "큰 나무는 바람 타."
  },
  "zq50a27": {
    "text": "학생,",
    "emotion": "鄭重"
  },
  "zq50a28": {
    "text": "명심하겠습니다.",
    "emotion": "深深一揖",
    "say": "명심하죠."
  },
  "zq50a29": {
    "text": "오늘 밤은,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "오늘 밤,"
  },
  "zq50a30": {
    "text": "탕가가 쏜다!",
    "emotion": "大聲"
  },
  "zq50a31": {
    "text": "아우야,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "아우,"
  },
  "zq50a32": {
    "text": "형이 한잔 올리마!",
    "emotion": "舉杯",
    "say": "한잔 받게!"
  },
  "zq50a33": {
    "text": "형님,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "건배!",
    "emotion": "仰頭"
  },
  "zq50a35": {
    "text": "해원 나리,",
    "emotion": "陪笑，拔高嗓門"
  },
  "zq50a36": {
    "text": "오늘 밤은 공짜입니다!",
    "emotion": "拍櫃檯",
    "say": "오늘은 공짜요!"
  },
  "zq50a37": {
    "text": "올라가.",
    "emotion": "低聲"
  },
  "zq50a38": {
    "text": "할 말 있어.",
    "emotion": "眼睛不看人"
  },
  "zq50a39": {
    "text": "올라가?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "벌써?",
    "emotion": "笑得很賊"
  },
  "zq50a41": {
    "text": "그 옥,",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a42": {
    "text": "보여 줘.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "그날,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "안색이 변했잖아.",
    "emotion": "看著她",
    "say": "얼굴 변했잖아."
  },
  "zq50a45": {
    "text": "이건 아버지 거야.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "아버지는,",
    "emotion": "抬起頭"
  },
  "zq50a47": {
    "text": "친례산이야.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "알아.",
    "emotion": "溫和"
  },
  "zq50a49": {
    "text": "말해, 들을게.",
    "emotion": "點頭"
  },
  "zq50a50": {
    "text": "스무 해를 몸에 지니고,",
    "emotion": "回憶",
    "say": "이십 년을 지니고,"
  },
  "zq50a51": {
    "text": "한 번도 떼지 않으셨어.",
    "emotion": "聲音發緊",
    "say": "한 번도 안 뗐어."
  },
  "zq50a52": {
    "text": "그게 어떻게 네 손에 있는지,",
    "emotion": "抬眼",
    "say": "왜 네 손에 있는지,"
  },
  "zq50a53": {
    "text": "나도 몰라.",
    "emotion": "搖頭"
  },
  "zq50a54": {
    "text": "그냥 낡은 책궤에 있었어,",
    "emotion": "老實"
  },
  "zq50a55": {
    "text": "누가 넣었는지는 기억 안 나.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "그분을 만나면,",
    "emotion": "看著她",
    "say": "만나면,"
  },
  "zq50a57": {
    "text": "직접 돌려드리자.",
    "emotion": "篤定"
  },
  "zq50a58": {
    "text": "……응.",
    "emotion": "眼眶紅了，笑"
  },
  "zq50a59": {
    "text": "서브 미션 완료:",
    "emotion": "平板電子音，快，說完就停",
    "say": "미션 완료:"
  },
  "zq50a60": {
    "text": "옥패의 주인.",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "뭐 하는 거예요?",
    "emotion": "臉色發白，大聲",
    "say": "뭐 해요?"
  },
  "zq50a62": {
    "text": "계단에……",
    "emotion": "壓低聲音，快，說完就停"
  },
  "zq50a63": {
    "text": "누가 있어.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "죄신의 딸 친솽,",
    "emotion": "吼"
  },
  "zq50a65": {
    "text": "군적 이탈 죄로,",
    "emotion": "官腔"
  },
  "zq50a66": {
    "text": "체포하라!",
    "emotion": "揮手",
    "say": "잡아라!"
  },
  "zq50a67": {
    "text": "잠깐!",
    "emotion": "一步擋在她前面"
  }
}
