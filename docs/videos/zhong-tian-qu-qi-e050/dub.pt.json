{
  "zq50a01": {
    "text": "Xu Yan,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "eu…",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "Ilustre primeiro do exame,",
    "emotion": "諂媚，極短促，一口氣說完，不拖音",
    "say": "Excelência,"
  },
  "zq50a04": {
    "text": "fomos cegos!",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "…Senhor Zhou?",
    "emotion": "愣住，快，說完就停"
  },
  "zq50a06": {
    "text": "Aquele noivado de antigamente,",
    "emotion": "低頭，快，說完就停",
    "say": "Aquele noivado,"
  },
  "zq50a07": {
    "text": "foi tolice deste velho.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "Ginseng, prata, um ruyi de jade,",
    "emotion": "眼睛發亮，飛快",
    "say": "Ginseng, prata, jade,"
  },
  "zq50a09": {
    "text": "trezentos taéis, no mínimo.",
    "emotion": "小聲，快，說完就停",
    "say": "no mínimo trezentos."
  },
  "zq50a10": {
    "text": "Senhor Zhou,",
    "emotion": "上前",
    "say": "Senhor,"
  },
  "zq50a11": {
    "text": "levante-se.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "De pé."
  },
  "zq50a12": {
    "text": "Essa dívida antiga,",
    "emotion": "平靜，快，說完就停",
    "say": "Dívida antiga,"
  },
  "zq50a13": {
    "text": "não é minha para pagar.",
    "emotion": "一字一字",
    "say": "não é minha."
  },
  "zq50a14": {
    "text": "Então…",
    "emotion": "傻住，快，說完就停",
    "say": "Então"
  },
  "zq50a15": {
    "text": "e os presentes?",
    "emotion": "捧著盒子，快，說完就停"
  },
  "zq50a16": {
    "text": "Os presentes,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Isso,"
  },
  "zq50a17": {
    "text": "leve de volta, por favor.",
    "emotion": "客氣但不留",
    "say": "leve de volta."
  },
  "zq50a18": {
    "text": "Trezentos taéis…",
    "emotion": "心疼",
    "say": "Trezentos…"
  },
  "zq50a19": {
    "text": "Vai recusar?",
    "emotion": "噘嘴",
    "say": "Recusa?"
  },
  "zq50a20": {
    "text": "Doeu?",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "Primeiro do exame,",
    "emotion": "溫和，快，說完就停",
    "say": "Primeiro,"
  },
  "zq50a22": {
    "text": "este velho chegou tarde.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "Isto é do senhor prefeito,",
    "emotion": "示意書童，快，說完就停",
    "say": "Do prefeito,"
  },
  "zq50a24": {
    "text": "que me pediu para trazer.",
    "emotion": "溫和，快，說完就停",
    "say": "por mim."
  },
  "zq50a25": {
    "text": "Te dou um conselho:",
    "emotion": "收起笑"
  },
  "zq50a26": {
    "text": "árvore alta atrai vento.",
    "emotion": "眼神銳利，極短促，一口氣說完，不拖音",
    "say": "Árvore alta, mais vento."
  },
  "zq50a27": {
    "text": "Seu aluno",
    "emotion": "鄭重",
    "say": "Mestre,"
  },
  "zq50a28": {
    "text": "vai guardar isso.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Guardo."
  },
  "zq50a29": {
    "text": "Hoje à noite,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Hoje,"
  },
  "zq50a30": {
    "text": "os Tang pagam!",
    "emotion": "大聲"
  },
  "zq50a31": {
    "text": "Primo,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a32": {
    "text": "seu primo mais velho brinda a você!",
    "emotion": "舉杯",
    "say": "um brinde a você!"
  },
  "zq50a33": {
    "text": "Primo,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "saúde!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a35": {
    "text": "Ilustre primeiro do exame,",
    "emotion": "拔高嗓門，快，說完就停",
    "say": "Excelência,"
  },
  "zq50a36": {
    "text": "hoje é por conta da casa!",
    "emotion": "拍櫃檯",
    "say": "por conta da casa!"
  },
  "zq50a37": {
    "text": "Lá em cima.",
    "emotion": "低聲",
    "say": "Suba."
  },
  "zq50a38": {
    "text": "Preciso falar com você.",
    "emotion": "眼睛不看人",
    "say": "Quero falar."
  },
  "zq50a39": {
    "text": "Lá em cima?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "Tão cedo?",
    "emotion": "笑得很賊"
  },
  "zq50a41": {
    "text": "Aquele jade,",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a42": {
    "text": "me deixa ver.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "Naquele dia,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "você ficou pálida.",
    "emotion": "看著她"
  },
  "zq50a45": {
    "text": "Era do meu pai.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "Meu pai",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Papai"
  },
  "zq50a47": {
    "text": "é Qin Lieshan.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "Eu sei.",
    "emotion": "溫和"
  },
  "zq50a49": {
    "text": "Fala, eu escuto.",
    "emotion": "點頭，快，說完就停",
    "say": "Fala, escuto."
  },
  "zq50a50": {
    "text": "Ele o usou junto ao peito por vinte anos,",
    "emotion": "回憶",
    "say": "Usou-o vinte anos,"
  },
  "zq50a51": {
    "text": "nunca o tirou.",
    "emotion": "聲音發緊"
  },
  "zq50a52": {
    "text": "Como foi parar na sua mão,",
    "emotion": "抬眼",
    "say": "Como chegou a você,"
  },
  "zq50a53": {
    "text": "também não sei.",
    "emotion": "搖頭",
    "say": "não sei."
  },
  "zq50a54": {
    "text": "Estava no velho baú de livros;",
    "emotion": "老實，快，說完就停",
    "say": "Estava no baú velho;"
  },
  "zq50a55": {
    "text": "quem pôs lá, não lembro.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "Quando o encontrarmos,",
    "emotion": "看著她",
    "say": "Quando o vir,"
  },
  "zq50a57": {
    "text": "devolvo com minhas próprias mãos.",
    "emotion": "篤定",
    "say": "devolvo eu mesmo."
  },
  "zq50a58": {
    "text": "…Hum.",
    "emotion": "眼眶紅了，笑"
  },
  "zq50a59": {
    "text": "Missão secundária concluída:",
    "emotion": "平板電子音，快，說完就停",
    "say": "Concluída:"
  },
  "zq50a60": {
    "text": "o dono do jade.",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "O que vocês estão fazendo?",
    "emotion": "臉色發白，大聲",
    "say": "O que é isso?"
  },
  "zq50a62": {
    "text": "A escada…",
    "emotion": "壓低聲音，快，說完就停"
  },
  "zq50a63": {
    "text": "tem alguém.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "Qin Shuang, filha de um traidor,",
    "emotion": "吼，快，說完就停",
    "say": "Qin Shuang, filha de traidor,"
  },
  "zq50a65": {
    "text": "fugitiva do registro militar,",
    "emotion": "官腔，快，說完就停",
    "say": "fugitiva militar,"
  },
  "zq50a66": {
    "text": "prendam-na!",
    "emotion": "揮手",
    "say": "Prendam!"
  },
  "zq50a67": {
    "text": "Alto!",
    "emotion": "一步擋在她前面"
  }
}
