{
  "zq50a01": {
    "text": "Xu Yan,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "I…",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "Honored Jieyuan,",
    "emotion": "諂媚，聲音發抖"
  },
  "zq50a04": {
    "text": "we were blind!",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "…Squire Zhou?",
    "emotion": "愣住",
    "say": "…Squire?"
  },
  "zq50a06": {
    "text": "That match back then,",
    "emotion": "低頭"
  },
  "zq50a07": {
    "text": "was this old fool's mistake.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "Ginseng, silver, a jade ruyi,",
    "emotion": "眼睛發亮，一口氣飛快說完，不停頓",
    "say": "Ginseng, silver, jade"
  },
  "zq50a09": {
    "text": "three hundred taels, at least.",
    "emotion": "小聲",
    "say": "three hundred, easy."
  },
  "zq50a10": {
    "text": "Squire,",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "please rise.",
    "emotion": "伸手扶",
    "say": "Rise."
  },
  "zq50a12": {
    "text": "That old debt,",
    "emotion": "平靜，笑"
  },
  "zq50a13": {
    "text": "isn't mine to settle.",
    "emotion": "一字一字",
    "say": "isn't mine."
  },
  "zq50a14": {
    "text": "Then…",
    "emotion": "傻住"
  },
  "zq50a15": {
    "text": "the gifts?",
    "emotion": "捧著盒子"
  },
  "zq50a16": {
    "text": "The gifts,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Gifts"
  },
  "zq50a17": {
    "text": "please take them back.",
    "emotion": "客氣但不留",
    "say": "take them back."
  },
  "zq50a18": {
    "text": "Three hundred taels…",
    "emotion": "心疼",
    "say": "Three hundred…"
  },
  "zq50a19": {
    "text": "You're refusing?",
    "emotion": "噘嘴",
    "say": "Refused?"
  },
  "zq50a20": {
    "text": "Does it hurt?",
    "emotion": "斜眼，低聲，快，說完就停",
    "say": "Hurts?"
  },
  "zq50a21": {
    "text": "Jieyuan,",
    "emotion": "笑，走上台階"
  },
  "zq50a22": {
    "text": "this old man is late.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "His Excellency the prefect",
    "emotion": "示意書童",
    "say": "The prefect"
  },
  "zq50a24": {
    "text": "asked me to bring you this.",
    "emotion": "笑"
  },
  "zq50a25": {
    "text": "Let me give you one saying:",
    "emotion": "收起笑",
    "say": "A word of advice:"
  },
  "zq50a26": {
    "text": "the tallest tree catches the wind.",
    "emotion": "眼神銳利，快，說完就停",
    "say": "tall trees catch wind."
  },
  "zq50a27": {
    "text": "Your student",
    "emotion": "鄭重",
    "say": "Sir,"
  },
  "zq50a28": {
    "text": "will remember it.",
    "emotion": "深深一揖",
    "say": "noted."
  },
  "zq50a29": {
    "text": "Tonight,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a30": {
    "text": "drinks are on the Tang family!",
    "emotion": "大聲",
    "say": "drinks on the Tangs!"
  },
  "zq50a31": {
    "text": "Cousin,",
    "emotion": "笑得很親熱"
  },
  "zq50a32": {
    "text": "your big cousin drinks to you!",
    "emotion": "舉杯",
    "say": "a toast to you!"
  },
  "zq50a33": {
    "text": "Dalang,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "bottoms up!",
    "emotion": "仰頭",
    "say": "Cheers!"
  },
  "zq50a35": {
    "text": "Honored Jieyuan,",
    "emotion": "拔高嗓門，快，說完就停",
    "say": "Jieyuan, sir,"
  },
  "zq50a36": {
    "text": "tonight it's on the house!",
    "emotion": "拍櫃檯",
    "say": "it's on the house!"
  },
  "zq50a37": {
    "text": "Upstairs.",
    "emotion": "低聲"
  },
  "zq50a38": {
    "text": "I need to talk to you.",
    "emotion": "眼睛不看人",
    "say": "We need to talk."
  },
  "zq50a39": {
    "text": "Upstairs?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "So early?",
    "emotion": "笑得很賊"
  },
  "zq50a41": {
    "text": "That jade,",
    "emotion": "深吸一口氣"
  },
  "zq50a42": {
    "text": "let me see it.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "That day,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "your face went pale.",
    "emotion": "看著她"
  },
  "zq50a45": {
    "text": "This was my father's.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "My father",
    "emotion": "抬起頭"
  },
  "zq50a47": {
    "text": "is Qin Lieshan.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "I know.",
    "emotion": "溫和"
  },
  "zq50a49": {
    "text": "Tell me. I'm listening.",
    "emotion": "點頭",
    "say": "Go on, I'm listening."
  },
  "zq50a50": {
    "text": "He wore it close for twenty years,",
    "emotion": "回憶",
    "say": "He wore it twenty years,"
  },
  "zq50a51": {
    "text": "never took it off.",
    "emotion": "聲音發緊"
  },
  "zq50a52": {
    "text": "How it ended up in your hands,",
    "emotion": "抬眼",
    "say": "How you got it,"
  },
  "zq50a53": {
    "text": "I don't know either.",
    "emotion": "搖頭",
    "say": "I don't know."
  },
  "zq50a54": {
    "text": "It was just lying in the old book chest;",
    "emotion": "老實",
    "say": "It was in the old book chest;"
  },
  "zq50a55": {
    "text": "who put it there, I don't remember.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "When we find him,",
    "emotion": "看著她"
  },
  "zq50a57": {
    "text": "I'll give it back to him myself.",
    "emotion": "篤定",
    "say": "I'll return it myself."
  },
  "zq50a58": {
    "text": "…Mm.",
    "emotion": "眼眶紅了，笑"
  },
  "zq50a59": {
    "text": "Side quest complete:",
    "emotion": "平板電子音，快，說完就停",
    "say": "Side quest done:"
  },
  "zq50a60": {
    "text": "the owner of the jade pendant.",
    "emotion": "平板電子音",
    "say": "the jade's owner."
  },
  "zq50a61": {
    "text": "What are you doing?",
    "emotion": "臉色發白，大聲"
  },
  "zq50a62": {
    "text": "The stairs…",
    "emotion": "臉色一變，壓低聲音"
  },
  "zq50a63": {
    "text": "someone's there.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "Qin Shuang, a disgraced official's daughter,",
    "emotion": "吼",
    "say": "Qin Shuang, convict's daughter,"
  },
  "zq50a65": {
    "text": "deserting the military register,",
    "emotion": "官腔",
    "say": "army deserter,"
  },
  "zq50a66": {
    "text": "seize her!",
    "emotion": "揮手"
  },
  "zq50a67": {
    "text": "Hold it!",
    "emotion": "一步擋在她前面",
    "say": "Stop!"
  }
}
