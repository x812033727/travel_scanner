{
  "zq50a01": {
    "text": "シュー・イェン、",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "私……",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "解元様、",
    "emotion": "諂媚，聲音發抖"
  },
  "zq50a04": {
    "text": "私どもの目が節穴でした！",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "……周旦那？",
    "emotion": "愣住，快，說完就停",
    "say": "旦那？"
  },
  "zq50a06": {
    "text": "あの縁談は、",
    "emotion": "低頭"
  },
  "zq50a07": {
    "text": "わしが愚かでした。",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "人参、銀、玉如意、",
    "emotion": "眼睛發亮，飛快"
  },
  "zq50a09": {
    "text": "少なくとも三百両。",
    "emotion": "小聲",
    "say": "ざっと三百両。"
  },
  "zq50a10": {
    "text": "旦那、",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "お立ちください。",
    "emotion": "伸手扶",
    "say": "立って。"
  },
  "zq50a12": {
    "text": "その古い借りは、",
    "emotion": "平靜，笑",
    "say": "昔の借りは、"
  },
  "zq50a13": {
    "text": "俺には関係ない。",
    "emotion": "一字一字",
    "say": "俺とは無縁。"
  },
  "zq50a14": {
    "text": "で、では……",
    "emotion": "傻住",
    "say": "では……"
  },
  "zq50a15": {
    "text": "この品は？",
    "emotion": "捧著盒子"
  },
  "zq50a16": {
    "text": "品は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "礼、"
  },
  "zq50a17": {
    "text": "お持ち帰りください。",
    "emotion": "客氣但不留",
    "say": "お持ち帰りを。"
  },
  "zq50a18": {
    "text": "三百両……",
    "emotion": "心疼"
  },
  "zq50a19": {
    "text": "断るの？",
    "emotion": "噘嘴，快，說完就停",
    "say": "断る？"
  },
  "zq50a20": {
    "text": "惜しい？",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "解元殿、",
    "emotion": "笑，走上台階"
  },
  "zq50a22": {
    "text": "遅くなったな。",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "これは知府殿が",
    "emotion": "示意書童",
    "say": "知府殿が"
  },
  "zq50a24": {
    "text": "わしに託された品だ。",
    "emotion": "笑",
    "say": "わしに託した品だ。"
  },
  "zq50a25": {
    "text": "一言贈ろう。",
    "emotion": "收起笑"
  },
  "zq50a26": {
    "text": "高い木ほど風を受ける。",
    "emotion": "眼神銳利",
    "say": "高木は風を招く。"
  },
  "zq50a27": {
    "text": "肝に、",
    "emotion": "鄭重"
  },
  "zq50a28": {
    "text": "銘じます。",
    "emotion": "深深一揖"
  },
  "zq50a29": {
    "text": "今夜は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "今夜"
  },
  "zq50a30": {
    "text": "唐家のおごりよ！",
    "emotion": "大聲",
    "say": "唐家のおごり！"
  },
  "zq50a31": {
    "text": "いとこよ、",
    "emotion": "笑得很親熱",
    "say": "いとこ、"
  },
  "zq50a32": {
    "text": "兄からの一杯だ！",
    "emotion": "舉杯"
  },
  "zq50a33": {
    "text": "兄さん、",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "乾杯！",
    "emotion": "仰頭"
  },
  "zq50a35": {
    "text": "解元様、",
    "emotion": "陪笑，拔高嗓門"
  },
  "zq50a36": {
    "text": "今夜はお代はいりません！",
    "emotion": "拍櫃檯",
    "say": "今夜はタダです！"
  },
  "zq50a37": {
    "text": "上へ。",
    "emotion": "低聲"
  },
  "zq50a38": {
    "text": "話があるの。",
    "emotion": "眼睛不看人"
  },
  "zq50a39": {
    "text": "上へ？",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "こんなに早く？",
    "emotion": "笑得很賊",
    "say": "もう？"
  },
  "zq50a41": {
    "text": "あの玉、",
    "emotion": "低聲，快，說完就停",
    "say": "あの玉"
  },
  "zq50a42": {
    "text": "見せて。",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "あの日、",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "顔色が変わったな。",
    "emotion": "看著她",
    "say": "顔色が変わった。"
  },
  "zq50a45": {
    "text": "これは父のものよ。",
    "emotion": "很輕",
    "say": "父のものよ。"
  },
  "zq50a46": {
    "text": "父は、",
    "emotion": "抬起頭，快，說完就停",
    "say": "父は"
  },
  "zq50a47": {
    "text": "チン・リエシャン。",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "知ってる。",
    "emotion": "溫和"
  },
  "zq50a49": {
    "text": "話してくれ、聞くよ。",
    "emotion": "點頭",
    "say": "話して。聞く。"
  },
  "zq50a50": {
    "text": "二十年、肌身離さず着けていた、",
    "emotion": "回憶，快，說完就停",
    "say": "二十年肌身離さず、"
  },
  "zq50a51": {
    "text": "片時も外さなかった。",
    "emotion": "聲音發緊",
    "say": "片時も外さず。"
  },
  "zq50a52": {
    "text": "どうしてあなたの手にあるのか、",
    "emotion": "抬眼",
    "say": "なぜあなたの手に、"
  },
  "zq50a53": {
    "text": "私にもわからない。",
    "emotion": "搖頭",
    "say": "わからない。"
  },
  "zq50a54": {
    "text": "古い書箱に入ってただけだ、",
    "emotion": "老實，快，說完就停",
    "say": "書箱にあった、"
  },
  "zq50a55": {
    "text": "誰が入れたかは覚えてない。",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "父上に会えたら、",
    "emotion": "看著她",
    "say": "会えたら、"
  },
  "zq50a57": {
    "text": "この手で返そう。",
    "emotion": "篤定"
  },
  "zq50a58": {
    "text": "……うん。",
    "emotion": "眼眶紅了，笑"
  },
  "zq50a59": {
    "text": "サブ任務完了：",
    "emotion": "平板電子音，快，說完就停",
    "say": "任務完了："
  },
  "zq50a60": {
    "text": "玉佩の持ち主。",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "何するの！",
    "emotion": "臉色發白，大聲"
  },
  "zq50a62": {
    "text": "階段に……",
    "emotion": "壓低聲音，快，說完就停",
    "say": "階段に"
  },
  "zq50a63": {
    "text": "誰かいる。",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "罪臣の娘チン・シュアン、",
    "emotion": "吼"
  },
  "zq50a65": {
    "text": "軍籍から逃亡した罪で、",
    "emotion": "官腔",
    "say": "軍籍逃亡の罪、"
  },
  "zq50a66": {
    "text": "捕らえよ！",
    "emotion": "揮手"
  },
  "zq50a67": {
    "text": "待て！",
    "emotion": "一步擋在她前面"
  }
}
