{
  "zq50a01": {
    "text": "Xu Yan,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "aku…",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "Tuan Juara Pertama,",
    "emotion": "諂媚，極短促，一口氣說完，不拖音",
    "say": "Tuan Juara"
  },
  "zq50a04": {
    "text": "kami yang buta!",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "…Tuan Zhou?",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tuan Zhou?"
  },
  "zq50a06": {
    "text": "Perjodohan dulu itu,",
    "emotion": "低頭，快，說完就停"
  },
  "zq50a07": {
    "text": "kebodohan orang tua ini.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "Ginseng, perak, ruyi giok,",
    "emotion": "眼睛發亮，飛快"
  },
  "zq50a09": {
    "text": "paling sedikit tiga ratus tael.",
    "emotion": "小聲，快，說完就停",
    "say": "tiga ratus tael!"
  },
  "zq50a10": {
    "text": "Tuan,",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "silakan bangun.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Bangun."
  },
  "zq50a12": {
    "text": "Utang lama itu,",
    "emotion": "平靜，快，說完就停"
  },
  "zq50a13": {
    "text": "bukan urusanku.",
    "emotion": "一字一字"
  },
  "zq50a14": {
    "text": "Lalu…",
    "emotion": "傻住，快，說完就停",
    "say": "Lalu"
  },
  "zq50a15": {
    "text": "hadiahnya?",
    "emotion": "捧著盒子，快，說完就停"
  },
  "zq50a16": {
    "text": "Hadiahnya,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ini,"
  },
  "zq50a17": {
    "text": "silakan dibawa pulang.",
    "emotion": "客氣但不留",
    "say": "bawa pulang."
  },
  "zq50a18": {
    "text": "Tiga ratus tael…",
    "emotion": "心疼",
    "say": "Tiga ratus…"
  },
  "zq50a19": {
    "text": "Ditolak?",
    "emotion": "噘嘴"
  },
  "zq50a20": {
    "text": "Sakit hati?",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "Juara pertama,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Juara,"
  },
  "zq50a22": {
    "text": "saya datang terlambat.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "Ini dari Tuan Prefek,",
    "emotion": "示意書童，快，說完就停",
    "say": "Dari prefek,"
  },
  "zq50a24": {
    "text": "dititipkan lewat saya.",
    "emotion": "溫和，快，說完就停",
    "say": "titip lewat saya."
  },
  "zq50a25": {
    "text": "Saya beri satu pesan:",
    "emotion": "收起笑",
    "say": "Satu pesan:"
  },
  "zq50a26": {
    "text": "pohon tinggi diterpa angin.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "pohon tinggi kena angin"
  },
  "zq50a27": {
    "text": "Murid ini",
    "emotion": "鄭重",
    "say": "Baik,"
  },
  "zq50a28": {
    "text": "akan mengingatnya.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "saya ingat."
  },
  "zq50a29": {
    "text": "Malam ini,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a30": {
    "text": "keluarga Tang yang traktir!",
    "emotion": "大聲",
    "say": "Tang yang traktir!"
  },
  "zq50a31": {
    "text": "Sepupu,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a32": {
    "text": "kakak bersulang untukmu!",
    "emotion": "舉杯",
    "say": "bersulang!"
  },
  "zq50a33": {
    "text": "Kakak,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "bersulang!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tos!"
  },
  "zq50a35": {
    "text": "Tuan Juara Pertama,",
    "emotion": "拔高嗓門，快，說完就停",
    "say": "Tuan Juara,"
  },
  "zq50a36": {
    "text": "malam ini gratis!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a37": {
    "text": "Ke atas.",
    "emotion": "低聲，快，說完就停",
    "say": "Naik."
  },
  "zq50a38": {
    "text": "Aku mau bicara.",
    "emotion": "眼睛不看人"
  },
  "zq50a39": {
    "text": "Ke atas?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "Secepat ini?",
    "emotion": "眨眼，快，說完就停",
    "say": "Kok cepat?"
  },
  "zq50a41": {
    "text": "Giok itu,",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a42": {
    "text": "coba kulihat.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "Waktu itu,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "wajahmu langsung berubah.",
    "emotion": "看著她",
    "say": "wajahmu berubah."
  },
  "zq50a45": {
    "text": "Ini milik ayahku.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "Ayahku,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a47": {
    "text": "Qin Lieshan.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "Aku tahu.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a49": {
    "text": "Ceritakan, aku dengar.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Cerita, kudengar."
  },
  "zq50a50": {
    "text": "Dua puluh tahun ia memakainya,",
    "emotion": "回憶，快，說完就停",
    "say": "Dua puluh tahun dipakai,"
  },
  "zq50a51": {
    "text": "tak pernah dilepas.",
    "emotion": "聲音發緊",
    "say": "tak pernah lepas."
  },
  "zq50a52": {
    "text": "Kenapa bisa di tanganmu,",
    "emotion": "抬眼",
    "say": "Kok di tanganmu,"
  },
  "zq50a53": {
    "text": "aku juga tak tahu.",
    "emotion": "搖頭",
    "say": "aku tak tahu."
  },
  "zq50a54": {
    "text": "Ada begitu saja di peti buku lama,",
    "emotion": "老實，快，說完就停",
    "say": "Ada di peti buku lama,"
  },
  "zq50a55": {
    "text": "siapa yang taruh, aku tak ingat.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "Nanti kalau bertemu dia,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Kalau ketemu,"
  },
  "zq50a57": {
    "text": "kukembalikan sendiri.",
    "emotion": "篤定"
  },
  "zq50a58": {
    "text": "…Mm.",
    "emotion": "輕聲，極短促，一口氣說完，不拖音",
    "say": "Mm."
  },
  "zq50a59": {
    "text": "Misi sampingan selesai:",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misi selesai:"
  },
  "zq50a60": {
    "text": "pemilik liontin giok.",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "Kalian mau apa?",
    "emotion": "臉色發白，大聲",
    "say": "Mau apa?"
  },
  "zq50a62": {
    "text": "Tangga…",
    "emotion": "壓低聲音，快，說完就停"
  },
  "zq50a63": {
    "text": "ada orang.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "Qin Shuang, putri pejabat terhukum,",
    "emotion": "吼，快，說完就停",
    "say": "Qin Shuang, putri terhukum,"
  },
  "zq50a65": {
    "text": "kabur dari daftar militer,",
    "emotion": "官腔，快，說完就停",
    "say": "kabur dari militer,"
  },
  "zq50a66": {
    "text": "tangkap!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a67": {
    "text": "Tunggu!",
    "emotion": "一步擋在她前面"
  }
}
