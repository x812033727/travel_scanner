{
  "zq50a01": {
    "text": "Xu Yan,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "yo…",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "Ilustre primero del examen,",
    "emotion": "諂媚，極短促，一口氣說完，不拖音",
    "say": "¡Excelencia,"
  },
  "zq50a04": {
    "text": "¡estábamos ciegos!",
    "emotion": "磕頭"
  },
  "zq50a05": {
    "text": "…¿Don Zhou?",
    "emotion": "愣住，快，說完就停",
    "say": "¿Don Zhou?"
  },
  "zq50a06": {
    "text": "Aquel compromiso de entonces,",
    "emotion": "低頭",
    "say": "Aquel compromiso,"
  },
  "zq50a07": {
    "text": "fue una torpeza de este viejo.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "Ginseng, plata, un ruyi de jade,",
    "emotion": "眼睛發亮，飛快",
    "say": "Ginseng, plata, jade,"
  },
  "zq50a09": {
    "text": "trescientos taeles, mínimo.",
    "emotion": "小聲，快，說完就停",
    "say": "¡trescientos, mínimo!"
  },
  "zq50a10": {
    "text": "Don Zhou,",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "levántese.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Arriba."
  },
  "zq50a12": {
    "text": "Esa vieja deuda,",
    "emotion": "平靜，笑"
  },
  "zq50a13": {
    "text": "no me toca a mí.",
    "emotion": "一字一字",
    "say": "no es mía."
  },
  "zq50a14": {
    "text": "Entonces…",
    "emotion": "傻住"
  },
  "zq50a15": {
    "text": "¿los regalos?",
    "emotion": "捧著盒子，快，說完就停"
  },
  "zq50a16": {
    "text": "Los regalos,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Eso,"
  },
  "zq50a17": {
    "text": "lléveselos, por favor.",
    "emotion": "客氣但不留",
    "say": "lléveselos."
  },
  "zq50a18": {
    "text": "Trescientos taeles…",
    "emotion": "心疼",
    "say": "Trescientos…"
  },
  "zq50a19": {
    "text": "¿Los rechazas?",
    "emotion": "噘嘴",
    "say": "¿Rechazas?"
  },
  "zq50a20": {
    "text": "¿Te duele?",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "Primero del examen,",
    "emotion": "溫和，快，說完就停",
    "say": "Primero,"
  },
  "zq50a22": {
    "text": "este viejo llega tarde.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "Esto lo manda el señor prefecto,",
    "emotion": "示意書童，快，說完就停",
    "say": "Del prefecto,"
  },
  "zq50a24": {
    "text": "me pidió que te lo trajera.",
    "emotion": "笑",
    "say": "por mi mano."
  },
  "zq50a25": {
    "text": "Te regalo un dicho:",
    "emotion": "收起笑"
  },
  "zq50a26": {
    "text": "el árbol alto atrae el viento.",
    "emotion": "眼神銳利，極短促，一口氣說完，不拖音",
    "say": "Árbol alto, más viento."
  },
  "zq50a27": {
    "text": "Su alumno",
    "emotion": "鄭重",
    "say": "Maestro,"
  },
  "zq50a28": {
    "text": "lo tendrá presente.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "anotado."
  },
  "zq50a29": {
    "text": "Esta noche,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a30": {
    "text": "¡invitan los Tang!",
    "emotion": "大聲"
  },
  "zq50a31": {
    "text": "Primo,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a32": {
    "text": "¡tu primo mayor brinda por ti!",
    "emotion": "舉杯",
    "say": "¡brindo por ti!"
  },
  "zq50a33": {
    "text": "Primo,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "¡salud!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a35": {
    "text": "Ilustre primero del examen,",
    "emotion": "拔高嗓門，快，說完就停",
    "say": "¡Señor primero,"
  },
  "zq50a36": {
    "text": "¡esta noche no se cobra!",
    "emotion": "拍櫃檯",
    "say": "¡hoy no se paga!"
  },
  "zq50a37": {
    "text": "Arriba.",
    "emotion": "低聲"
  },
  "zq50a38": {
    "text": "Tengo que hablarte.",
    "emotion": "眼睛不看人"
  },
  "zq50a39": {
    "text": "¿Arriba?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "¿Tan temprano?",
    "emotion": "笑得很賊",
    "say": "¿Tan pronto?"
  },
  "zq50a41": {
    "text": "Ese jade,",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a42": {
    "text": "déjame verlo.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "Aquel día,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "te cambió la cara.",
    "emotion": "看著她"
  },
  "zq50a45": {
    "text": "Era de mi padre.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "Mi padre",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Papá"
  },
  "zq50a47": {
    "text": "es Qin Lieshan.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "Lo sé.",
    "emotion": "溫和"
  },
  "zq50a49": {
    "text": "Habla, te escucho.",
    "emotion": "點頭"
  },
  "zq50a50": {
    "text": "Lo llevó encima veinte años,",
    "emotion": "回憶"
  },
  "zq50a51": {
    "text": "nunca se lo quitó.",
    "emotion": "聲音發緊"
  },
  "zq50a52": {
    "text": "Cómo llegó a tus manos,",
    "emotion": "抬眼"
  },
  "zq50a53": {
    "text": "tampoco lo sé.",
    "emotion": "搖頭",
    "say": "no lo sé."
  },
  "zq50a54": {
    "text": "Estaba en el viejo baúl de libros;",
    "emotion": "老實，快，說完就停",
    "say": "En el baúl viejo;"
  },
  "zq50a55": {
    "text": "quién lo puso, no lo recuerdo.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "Cuando lo encontremos,",
    "emotion": "看著她",
    "say": "Al verlo,"
  },
  "zq50a57": {
    "text": "se lo devolveré yo mismo.",
    "emotion": "篤定",
    "say": "se lo devuelvo."
  },
  "zq50a58": {
    "text": "…Mm.",
    "emotion": "眼眶紅了，笑"
  },
  "zq50a59": {
    "text": "Misión secundaria completada:",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misión cumplida:"
  },
  "zq50a60": {
    "text": "el dueño del jade.",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "¿Qué están haciendo?",
    "emotion": "臉色發白，大聲",
    "say": "¿Qué hacen?"
  },
  "zq50a62": {
    "text": "La escalera…",
    "emotion": "壓低聲音，快，說完就停"
  },
  "zq50a63": {
    "text": "hay alguien.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "Qin Shuang, hija de un traidor,",
    "emotion": "吼，快，說完就停",
    "say": "¡Qin Shuang, hija de traidor,"
  },
  "zq50a65": {
    "text": "desertora del registro militar,",
    "emotion": "官腔，快，說完就停",
    "say": "prófuga militar,"
  },
  "zq50a66": {
    "text": "¡arréstenla!",
    "emotion": "揮手",
    "say": "¡A ella!"
  },
  "zq50a67": {
    "text": "¡Alto!",
    "emotion": "一步擋在她前面"
  }
}
