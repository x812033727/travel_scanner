{
  "zq50a01": {
    "text": "Hứa Nghiên,",
    "emotion": "停下腳步"
  },
  "zq50a02": {
    "text": "ta…",
    "emotion": "話到嘴邊"
  },
  "zq50a03": {
    "text": "Giải nguyên lão gia,",
    "emotion": "諂媚，極短促，一口氣說完，不拖音",
    "say": "Giải nguyên lão gia"
  },
  "zq50a04": {
    "text": "là chúng tôi có mắt như mù!",
    "emotion": "磕頭",
    "say": "chúng tôi có mắt như mù!"
  },
  "zq50a05": {
    "text": "…Chu viên ngoại?",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Viên ngoại?"
  },
  "zq50a06": {
    "text": "Mối hôn sự năm ấy,",
    "emotion": "低頭，快，說完就停"
  },
  "zq50a07": {
    "text": "là lão già này hồ đồ.",
    "emotion": "陪笑"
  },
  "zq50a08": {
    "text": "Nhân sâm, bạc trắng, ngọc như ý,",
    "emotion": "眼睛發亮，飛快"
  },
  "zq50a09": {
    "text": "ít nhất ba trăm lượng.",
    "emotion": "小聲，快，說完就停"
  },
  "zq50a10": {
    "text": "Viên ngoại,",
    "emotion": "上前"
  },
  "zq50a11": {
    "text": "xin đứng dậy.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "đứng lên."
  },
  "zq50a12": {
    "text": "Món nợ cũ ấy,",
    "emotion": "平靜，快，說完就停"
  },
  "zq50a13": {
    "text": "không tính lên đầu tôi được.",
    "emotion": "一字一字",
    "say": "không tính cho tôi."
  },
  "zq50a14": {
    "text": "Vậy…",
    "emotion": "傻住，快，說完就停"
  },
  "zq50a15": {
    "text": "lễ vật này?",
    "emotion": "捧著盒子，快，說完就停"
  },
  "zq50a16": {
    "text": "Lễ vật,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lễ,"
  },
  "zq50a17": {
    "text": "xin mang về cho.",
    "emotion": "客氣但不留",
    "say": "xin mang về."
  },
  "zq50a18": {
    "text": "Ba trăm lượng…",
    "emotion": "心疼"
  },
  "zq50a19": {
    "text": "Không nhận?",
    "emotion": "噘嘴"
  },
  "zq50a20": {
    "text": "Tiếc à?",
    "emotion": "斜眼，低聲，快，說完就停"
  },
  "zq50a21": {
    "text": "Giải nguyên lang,",
    "emotion": "溫和，快，說完就停",
    "say": "Giải nguyên,"
  },
  "zq50a22": {
    "text": "lão phu đến muộn rồi.",
    "emotion": "溫潤"
  },
  "zq50a23": {
    "text": "Đây là quà Tri phủ đại nhân",
    "emotion": "示意書童，極短促，一口氣說完，不拖音",
    "say": "Quà Tri phủ"
  },
  "zq50a24": {
    "text": "nhờ lão phu mang tới.",
    "emotion": "溫和，快，說完就停"
  },
  "zq50a25": {
    "text": "Lão phu tặng ngươi một câu:",
    "emotion": "收起笑",
    "say": "Tặng ngươi một câu:"
  },
  "zq50a26": {
    "text": "cây cao đón gió.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a27": {
    "text": "Học trò,",
    "emotion": "鄭重"
  },
  "zq50a28": {
    "text": "xin ghi nhớ.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ghi nhớ."
  },
  "zq50a29": {
    "text": "Tối nay,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a30": {
    "text": "nhà họ Đường mời!",
    "emotion": "大聲"
  },
  "zq50a31": {
    "text": "Đường đệ,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a32": {
    "text": "đại ca kính đệ một ly!",
    "emotion": "舉杯",
    "say": "kính đệ một ly!"
  },
  "zq50a33": {
    "text": "Đại ca,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a34": {
    "text": "cạn!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a35": {
    "text": "Giải nguyên lão gia,",
    "emotion": "拔高嗓門，快，說完就停"
  },
  "zq50a36": {
    "text": "tối nay không lấy tiền!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a37": {
    "text": "Lên lầu.",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a38": {
    "text": "Ta có chuyện muốn nói.",
    "emotion": "眼睛不看人",
    "say": "Ta có chuyện nói."
  },
  "zq50a39": {
    "text": "Lên lầu?",
    "emotion": "眨眼"
  },
  "zq50a40": {
    "text": "Sớm vậy?",
    "emotion": "眨眼，快，說完就停"
  },
  "zq50a41": {
    "text": "Miếng ngọc đó,",
    "emotion": "低聲，快，說完就停"
  },
  "zq50a42": {
    "text": "cho ta xem.",
    "emotion": "伸手"
  },
  "zq50a43": {
    "text": "Hôm đó,",
    "emotion": "輕聲"
  },
  "zq50a44": {
    "text": "sắc mặt nàng đều thay đổi.",
    "emotion": "看著她",
    "say": "nàng biến sắc."
  },
  "zq50a45": {
    "text": "Đây là của cha ta.",
    "emotion": "很輕"
  },
  "zq50a46": {
    "text": "Cha ta,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a47": {
    "text": "là Tần Liệt Sơn.",
    "emotion": "一字一字"
  },
  "zq50a48": {
    "text": "Ta biết.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a49": {
    "text": "Nàng nói đi, ta nghe.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Nói đi, ta nghe."
  },
  "zq50a50": {
    "text": "Ông đeo sát người hai mươi năm,",
    "emotion": "回憶，快，說完就停"
  },
  "zq50a51": {
    "text": "chưa từng rời thân.",
    "emotion": "聲音發緊"
  },
  "zq50a52": {
    "text": "Sao lại nằm trong tay ngươi,",
    "emotion": "抬眼，快，說完就停",
    "say": "Sao ở tay ngươi,"
  },
  "zq50a53": {
    "text": "ta cũng không biết.",
    "emotion": "搖頭"
  },
  "zq50a54": {
    "text": "Nó cứ nằm trong rương sách cũ,",
    "emotion": "老實，快，說完就停",
    "say": "Nó nằm trong rương sách cũ,"
  },
  "zq50a55": {
    "text": "ai để vào, ta không nhớ.",
    "emotion": "皺眉"
  },
  "zq50a56": {
    "text": "Đợi gặp được ông,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Gặp được ông,"
  },
  "zq50a57": {
    "text": "tự tay trả lại.",
    "emotion": "篤定"
  },
  "zq50a58": {
    "text": "…Ừm.",
    "emotion": "輕聲，極短促，一口氣說完，不拖音"
  },
  "zq50a59": {
    "text": "Nhiệm vụ phụ hoàn thành:",
    "emotion": "平板電子音，快，說完就停",
    "say": "Hoàn thành:"
  },
  "zq50a60": {
    "text": "chủ nhân ngọc bội.",
    "emotion": "平板電子音"
  },
  "zq50a61": {
    "text": "Các người làm gì vậy?",
    "emotion": "臉色發白，大聲",
    "say": "Làm gì vậy?"
  },
  "zq50a62": {
    "text": "Cầu thang…",
    "emotion": "壓低聲音，快，說完就停"
  },
  "zq50a63": {
    "text": "có người.",
    "emotion": "手按住他"
  },
  "zq50a64": {
    "text": "Con gái tội thần Tần Sương,",
    "emotion": "吼，快，說完就停"
  },
  "zq50a65": {
    "text": "tự ý trốn quân tịch,",
    "emotion": "官腔，快，說完就停"
  },
  "zq50a66": {
    "text": "bắt lấy!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq50a67": {
    "text": "Khoan đã!",
    "emotion": "一步擋在她前面",
    "say": "Khoan!"
  }
}
