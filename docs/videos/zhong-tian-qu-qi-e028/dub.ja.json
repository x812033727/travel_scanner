{
  "zq28a01": { "text": "一人だろ、", "say": "一人だ", "emotion": "冷笑，快" },
  "zq28a02": "やれ！",
  "zq28a03": "まとめて。",
  "zq28a04": "行く。",
  "zq28a05": { "text": "犯人、", "emotion": "冷淡，快" },
  "zq28a06": "ともらった金。",
  "zq28a07": "一人で行ったの？",
  "zq28a08": { "text": "死ぬ気？", "emotion": "又急又氣，快，不要跺腳聲" },
  "zq28a09": { "text": "次は、", "say": "次は", "emotion": "輕聲，快" },
  "zq28a10": "連れてけ。",
  "zq28a11": "足手まとい。",
  "zq28a12": { "text": "アーリン、好感プラス七。", "say": "アーリン、好感七。" },
  "zq28a13": { "text": "足手まといって、", "say": "足手まといって", "emotion": "不服氣，快" },
  "zq28a14": "笑ってる？",
  "zq28a15": "明日、午の刻、",
  "zq28a16": "県城の広場で公開裁判！",
  "zq28a17": "全部吐きます、",
  "zq28a18": { "text": "全部！", "emotion": "心虛，快，短，只說一次" },
  "zq28a19": "町じゅうの前で、",
  "zq28a20": "それが一番だ。",
  "zq28a21": "一晩も、",
  "zq28a22": "ウェイ家が待つ？",
  "zq28a23": "ライさん、",
  "zq28a24": "若様からの差し入れだ。",
  "zq28a25": "スン店主……",
  "zq28a26": "差し入れだと？",
  "zq28a27": "明日うまく言えば、",
  "zq28a28": "全部お前のものだ。",
  "zq28a29": "時間だ、",
  "zq28a30": "明日の裁判で。",
  "zq28a31": "警告：証人、動揺。",
  "zq28a32": "言わせておけ。",
  "zq28a33": "ライ・サン！",
  "zq28a34": "誰の指図で薬を盛った？",
  "zq28a35": "シュー家に脅され、",
  "zq28a36": "ウェイ記に罪を着せろと！",
  "zq28a37": "でたらめ！",
  "zq28a38": "警告：証言、撤回。"
}
