{
  "zq28a01": { "text": "One girl,", "emotion": "壯膽，短促，不笑" },
  "zq28a02": "get her!",
  "zq28a03": "All of you.",
  "zq28a04": "Move.",
  "zq28a05": "The poisoner,",
  "zq28a06": "and his silver.",
  "zq28a07": "You went alone?",
  "zq28a08": "Are you crazy?",
  "zq28a09": "Next time,",
  "zq28a10": "take me.",
  "zq28a11": "You'd slow me.",
  "zq28a12": "A-Ling: affection plus seven.",
  "zq28a13": "She says you'd slow her,",
  "zq28a14": "and you smile?",
  "zq28a15": "Tomorrow at noon,",
  "zq28a16": "public trial on the town square!",
  "zq28a17": "I confess everything,",
  "zq28a18": "everything!",
  "zq28a19": "In public,",
  "zq28a20": "nice and clean.",
  "zq28a21": "Overnight,",
  "zq28a22": "will the Weis wait?",
  "zq28a23": "Lai San,",
  "zq28a24": "the young master sent your supper.",
  "zq28a25": "Manager Sun…",
  "zq28a26": "bringing supper?",
  "zq28a27": "Say it right tomorrow,",
  "zq28a28": "and it's all yours.",
  "zq28a29": "Time's up,",
  "zq28a30": "see you at the trial.",
  "zq28a31": "Warning: witness wavering.",
  "zq28a32": "Let him talk.",
  "zq28a33": { "text": "Lai San!", "emotion": "拍驚堂木，短促一喝" },
  "zq28a34": "Who put you up to the drugging?",
  "zq28a35": "The Xus forced me",
  "zq28a36": "to poison and frame Wei and Co.!",
  "zq28a37": "You liar!",
  "zq28a38": "Warning: witness recanted."
}
