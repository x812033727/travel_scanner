{
  "zq28a01": {
    "text": "Cewek doang!",
    "say": "Cewek!",
    "emotion": "短促，喊"
  },
  "zq28a02": {
    "text": "Hajar!",
    "emotion": "喊，短促"
  },
  "zq28a03": "Maju semua.",
  "zq28a04": "Jalan.",
  "zq28a05": {
    "text": "Peracunnya,",
    "say": "Peracunnya"
  },
  "zq28a06": "dan peraknya.",
  "zq28a07": "Sendirian?",
  "zq28a08": "Cari mati?",
  "zq28a09": {
    "text": "Lain kali,",
    "emotion": "輕聲，短促",
    "say": "Lain kali"
  },
  "zq28a10": {
    "text": "aku ikut.",
    "emotion": "語速快"
  },
  "zq28a11": "Kau beban.",
  "zq28a12": {
    "text": "A-Ling, poin suka plus tujuh.",
    "say": "A-Ling, plus tujuh."
  },
  "zq28a13": {
    "text": "Dibilang beban,",
    "say": "Dibilang beban"
  },
  "zq28a14": {
    "text": "kok senyum?",
    "emotion": "戳他手臂，語速快"
  },
  "zq28a15": {
    "text": "Besok tengah hari,",
    "say": "Besok tengah hari"
  },
  "zq28a16": "sidang di alun-alun!",
  "zq28a17": {
    "text": "Hamba ngaku,",
    "emotion": "磕頭，語速快",
    "say": "Hamba ngaku"
  },
  "zq28a18": {
    "text": "semua!",
    "emotion": "心虛，語速快"
  },
  "zq28a19": {
    "text": "Di depan umum,",
    "say": "Di depan umum"
  },
  "zq28a20": "paling bersih.",
  "zq28a21": {
    "text": "Semalaman,",
    "emotion": "壓低聲音，短促",
    "say": "Semalaman"
  },
  "zq28a22": "Wei bakal diam?",
  "zq28a23": {
    "text": "Tuan San,",
    "emotion": "語速快",
    "say": "Tuan San"
  },
  "zq28a24": "Tuan Muda kirim makanan.",
  "zq28a25": "Juragan Sun…",
  "zq28a26": {
    "text": "antar makanan?",
    "emotion": "冷冷地，不笑出聲"
  },
  "zq28a27": {
    "text": "Besok bilang yang benar,",
    "emotion": "話裡藏刀",
    "say": "Besok bilang yang benar"
  },
  "zq28a28": {
    "text": "semua milikmu.",
    "emotion": "語速快"
  },
  "zq28a29": {
    "text": "Waktu habis,",
    "emotion": "不耐煩，語速快",
    "say": "Waktu habis"
  },
  "zq28a30": {
    "text": "besok sidang.",
    "emotion": "不耐煩，語速快"
  },
  "zq28a31": "Peringatan: saksi goyah.",
  "zq28a32": {
    "text": "Biar dia ngomong.",
    "emotion": "不急，語速快"
  },
  "zq28a33": {
    "text": "Lai San!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq28a34": {
    "text": "Siapa yang menyuruhmu?",
    "emotion": "官腔"
  },
  "zq28a35": {
    "text": "Xu memaksaku,",
    "emotion": "豁出去，語速快",
    "say": "Xu memaksaku"
  },
  "zq28a36": "racuni dan fitnah Wei!",
  "zq28a37": "Bohong!",
  "zq28a38": {
    "text": "Peringatan: saksi ingkar.",
    "say": "Waspada: saksi ingkar."
  }
}
