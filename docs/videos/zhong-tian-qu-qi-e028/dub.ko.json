{
  "zq28a01": {"text":"혼자네,","say":"혼자네","emotion":"壯膽，短促，不笑"},
  "zq28a02": {"text":"쳐!","emotion":"往後一縮，短促地喊"},
  "zq28a03": "다 와.",
  "zq28a04": "가.",
  "zq28a05": "약 탄 놈,",
  "zq28a06": "그리고 받은 은자.",
  "zq28a07": "혼자 갔어?",
  "zq28a08": "죽고 싶어?",
  "zq28a09": {"text":"다음엔,","say":"다음엔","emotion":"輕聲，語速快"},
  "zq28a10": "데려가.",
  "zq28a11": "짐 돼.",
  "zq28a12": {"text":"아링, 호감 +7.","say":"아링 호감 플러스 칠","emotion":"平板電子音，語速快"},
  "zq28a13": "짐이라는데,",
  "zq28a14": "웃음이 나와?",
  "zq28a15": "내일 오시,",
  "zq28a16": "광장에서 공개 재판!",
  "zq28a17": {"text":"다 불게요,","say":"다 불게요","emotion":"磕頭如搗蒜，急促"},
  "zq28a18": "전부요!",
  "zq28a19": {"text":"다 보는 데서,","say":"다 보는 데서","emotion":"滿意，語速快"},
  "zq28a20": "제일 깔끔해.",
  "zq28a21": {"text":"하룻밤,","say":"하룻밤","emotion":"咬著唇，壓低聲音，語速快"},
  "zq28a22": "웨이 가가 가만둬?",
  "zq28a23": {"text":"나리,","say":"나리","emotion":"慢條斯理，短促"},
  "zq28a24": "도련님이 밥 보내셨소.",
  "zq28a25": "쑨 장궤가…",
  "zq28a26": "밥을 줘?",
  "zq28a27": {"text":"내일 잘 말하면,","say":"내일 잘 말하면","emotion":"話裡藏刀，語速稍快"},
  "zq28a28": "다 네 거야.",
  "zq28a29": "시간 끝났어,",
  "zq28a30": "내일 재판에서 봐.",
  "zq28a31": "경고: 증인 흔들림.",
  "zq28a32": "말하게 둬.",
  "zq28a33": "라이싼!",
  "zq28a34": "누가 약을 타라 했느냐?",
  "zq28a35": {"text":"쉬가가 시켰어요,","say":"쉬가가 시켰어요","emotion":"抬手一指，豁出去，語速快"},
  "zq28a36": "독으로 위지를 엮으라고!",
  "zq28a37": "거짓말!",
  "zq28a38": "경고: 증인 번복."
