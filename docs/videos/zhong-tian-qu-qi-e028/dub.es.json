{
  "zq28a01": {
    "text": "¡Es una!",
    "emotion": "壯膽，短促，不笑"
  },
  "zq28a02": "¡Vayan!",
  "zq28a03": "Vengan.",
  "zq28a04": "Anda.",
  "zq28a05": "El culpable,",
  "zq28a06": "y su plata.",
  "zq28a07": "¿Fuiste sola?",
  "zq28a08": "¿Estás loca?",
  "zq28a09": {
    "text": "Luego,",
    "emotion": "輕聲，短促"
  },
  "zq28a10": "llévame.",
  "zq28a11": "Estorbas.",
  "zq28a12": {
    "text": "A-Ling: afecto más siete.",
    "say": "A-Ling, más siete."
  },
  "zq28a13": "Dice que estorbas,",
  "zq28a14": "¿y te ríes?",
  "zq28a15": "Mañana a mediodía,",
  "zq28a16": "¡juicio en la plaza!",
  "zq28a17": "¡Confieso todo,",
  "zq28a18": "todo!",
  "zq28a19": "Frente a todos,",
  "zq28a20": "queda limpio.",
  "zq28a21": "Una noche,",
  "zq28a22": "¿y Wei, quieto?",
  "zq28a23": "Don Lai,",
  "zq28a24": "el señorito te manda comida.",
  "zq28a25": "Encargado Sun…",
  "zq28a26": "¿trae comida?",
  "zq28a27": "Habla bien,",
  "zq28a28": "y todo es tuyo.",
  "zq28a29": "Es la hora,",
  "zq28a30": "mañana, juicio.",
  "zq28a31": {
    "text": "Advertencia: el testigo vacila.",
    "say": "Advertencia, testigo duda."
  },
  "zq28a32": "Que hable.",
  "zq28a33": "¡Lai San!",
  "zq28a34": "¿Quién te mandó?",
  "zq28a35": "¡Los Xu me obligaron",
  "zq28a36": "a envenenar y culpar a Wei!",
  "zq28a37": "¡Mentira!",
  "zq28a38": {
    "text": "Advertencia: el testigo se retracta.",
    "say": "Advertencia, se retracta."
  }
}
