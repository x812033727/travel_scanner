{
  "zq28a01": {
    "text": "Có một ả,",
    "say": "Một ả",
    "emotion": "壯膽，短促，不笑"
  },
  "zq28a02": {
    "text": "xông lên!",
    "emotion": "往後一縮，喊，短促"
  },
  "zq28a03": "Lên cả đi.",
  "zq28a04": "Đi.",
  "zq28a05": {
    "text": "Kẻ bỏ thuốc,",
    "say": "Kẻ bỏ thuốc"
  },
  "zq28a06": "cùng bạc hắn nhận.",
  "zq28a07": "Đi một mình?",
  "zq28a08": "Chán sống à?",
  "zq28a09": {
    "text": "Lần sau,",
    "say": "Lần sau"
  },
  "zq28a10": "gọi ta.",
  "zq28a11": "Ngươi vướng chân.",
  "zq28a12": {
    "text": "A Lệnh, hảo cảm cộng bảy.",
    "say": "A Lệnh hảo cảm cộng bảy.",
    "emotion": "平板電子音，叮一聲，語速快"
  },
  "zq28a13": {
    "text": "Bị chê vướng chân,",
    "say": "Bị chê vướng chân"
  },
  "zq28a14": "huynh còn cười?",
  "zq28a15": {
    "text": "Giờ Ngọ ngày mai,",
    "say": "Giờ Ngọ ngày mai",
    "emotion": "拍驚堂木，官腔"
  },
  "zq28a16": {
    "text": "xử công khai giữa quảng trường!",
    "emotion": "假裝威嚴"
  },
  "zq28a17": {
    "text": "Tiểu nhân khai,",
    "say": "Tiểu nhân khai"
  },
  "zq28a18": "khai hết!",
  "zq28a19": {
    "text": "Khai trước cả thành,",
    "say": "Khai trước cả thành"
  },
  "zq28a20": "mới sạch sẽ.",
  "zq28a21": {
    "text": "Một đêm,",
    "say": "Một đêm"
  },
  "zq28a22": "Ngụy gia chịu ngồi yên?",
  "zq28a23": {
    "text": "Tam gia,",
    "say": "Tam gia",
    "emotion": "笑咪咪的語氣，不笑出聲"
  },
  "zq28a24": "công tử sai mang cơm cho ngươi.",
  "zq28a25": {
    "text": "Tôn chưởng quỹ…",
    "say": "Tôn chưởng quỹ"
  },
  "zq28a26": {
    "text": "tới đưa cơm?",
    "emotion": "冷冷地"
  },
  "zq28a27": {
    "text": "Mai nói cho đúng,",
    "say": "Mai nói cho đúng",
    "emotion": "話裡藏刀，不笑出聲"
  },
  "zq28a28": "tất cả là của ngươi.",
  "zq28a29": {
    "text": "Hết giờ,",
    "say": "Hết giờ"
  },
  "zq28a30": "mai gặp lúc xử.",
  "zq28a31": {
    "text": "Cảnh báo: nhân chứng lung lay.",
    "emotion": "平板電子音，叮一聲，語速快"
  },
  "zq28a32": {
    "text": "Cứ để hắn nói.",
    "emotion": "不急，從容"
  },
  "zq28a33": {
    "text": "Lại Tam!",
    "emotion": "拍驚堂木，短促一喝"
  },
  "zq28a34": {
    "text": "Ai sai ngươi bỏ thuốc?",
    "emotion": "官腔"
  },
  "zq28a35": {
    "text": "Hứa gia ép tiểu nhân",
    "emotion": "抬手一指，豁出去，語速快"
  },
  "zq28a36": "bỏ độc vu oan Ngụy Ký!",
  "zq28a37": "Ngươi nói láo!",
  "zq28a38": {
    "text": "Cảnh báo: nhân chứng phản cung.",
    "emotion": "平板電子音，警報聲，語速快"
  }
}
