    },
    "title": "7bc89124273b",
    "description": "cb1d2d0a71f2",
    "tags": "64d5b05f180a"
  },
  "lines": {
    "2892": {
      "source_hash": "93ef86f97b95",
      "text": "재시도, 도구, 샌드박스 비용도 계산에 넣어야 합니다."
    },
    "jrpz": {
      "source_hash": "d78f4564aedb",
      "text": "같은 일도 에이전트는 10여 배 비쌀 수 있습니다."
    },
    "rhcy": {
      "source_hash": "8754ffbb3f10",
      "text": "어디서 비싸지는지, 비용을 잡는 설정도 알려 드립니다."
    },
    "w977": {
      "source_hash": "938f43954bc9",
      "text": "진짜 에이전트인지 가리는 한 문장도 알려 드립니다."
    },
    "cs5g": {
      "source_hash": "26ea9d0cad2c",
      "text": "채팅창을 에이전트로 착각합니다."
    },
    "j3jv": {
      "source_hash": "bbf8d81ef3bc",
      "text": "핵심은 채팅창 말고 누가 결정하느냐입니다."
    },
    "83wx": {
      "source_hash": "d955d630dfe8",
      "text": "묻고 안내받으면 채팅입니다."
    },
    "vegh": {
      "source_hash": "90c415dad037",
      "text": "늘 정해진 순서면 고정 절차입니다."
    },
    "quyv": {
      "source_hash": "5f6e2f912f98",
      "text": "에이전트는 스스로 단계·도구를 정합니다."
    },
    "t86a": {
      "source_hash": "5f00eeba4d1f",
      "text": "도구 1회론 에이전트 아닙니다."
    },
    "yxd7": {
      "source_hash": "27a54fc1cd5d",
      "text": "규칙 안정된 일은 고정 절차가 더 예측됩니다."
    },
    "8dan": {
      "source_hash": "e2b5cbe41526",
      "text": "신청 자료에서 중복을 찾게 합니다."
    },
    "g6hk": {
      "source_hash": "c4d0b647d01e",
      "text": "필드를 읽으니 동명이인일 수 있습니다."
    },
    "q3cg": {
      "source_hash": "e4e4e9f7f78b",
      "text": "허용 필드로 맞춥니다."
    },
    "gich": {
      "source_hash": "6157fee1a9ad",
      "text": "이 전환이 에이전트의 특징입니다."
    },
    "3iur": {
      "source_hash": "dd8c69ec0bec",
      "text": "삭제 없이 대조 방식만 바꿨습니다."
    },
    "t4e7": {
      "source_hash": "e02ab5b291be",
      "text": "자율이란 방식을 바꾸는 것이지 권한을 넓히는 게 아닙니다."
    },
    "b672": {
      "source_hash": "3d78eab9371f",
      "text": "그럼 에이전트는 무엇으로 이루어져 있을까요?"
    },
    "z3xv": {
      "source_hash": "ce6b1d7340db",
      "text": "에이전트는 네 부분으로 나눠 볼 수 있습니다."
    },
    "x2sc": {
      "source_hash": "d7355e47aba8",
      "text": "모델은 판단."
    },
    "e889": {
      "source_hash": "a5ab849d277f",
      "text": "지시는 맡긴 목표입니다."
    },
    "7gj6": {
      "source_hash": "cb99cf08cf09",
      "text": "실제로 읽고 고치는 손은 도구입니다."
    },
    "trh6": {
      "source_hash": "3aaf9b2a707e",
      "text": "실행 도구는 샌드박스에서 작동합니다."
    },
    "2z76": {
      "source_hash": "1d71fe926b0e",
      "text": "샌드박스는 선택입니다."
    },
    "dep5": {
      "source_hash": "3b2c640316d7",
      "text": "외부 서비스 직결 도구도 있고, 관건은 기능·권한 연결입니다."
    },
    "wfy8": {
      "source_hash": "3d01fe0cd436",
      "text": "먼저 어떤 도구와 권한이 있는지 봅니다."
    },
    "bszf": {
      "source_hash": "aed7dfa0eab1",
      "text": "도구 범위도 제한됩니다. 폴더 하나 읽기가 컴퓨터 전체는 아닙니다."
    },
    "naw5": {
      "source_hash": "0a16e5a7551d",
      "text": "업데이트했다는 말이 실제 실행은 아닙니다."
    },
    "677u": {
      "source_hash": "036ed46b3df6",
      "text": "도구나 권한이 없으면 못 고칩니다."
    },
    "vbtd": {
      "source_hash": "ec5f11b05502",
      "text": "말의 확신 말고 실제 결과를 봅니다."
    },
    "8wag": {
      "source_hash": "e550eac3bf06",
      "text": "파일이 없거나 설명과 다르면 미완료입니다."
    },
    "c68n": {
      "source_hash": "75bfb86c3767",
      "text": "완료에는 \"다 했습니다\"라는 말이 아니라 증거가 필요합니다."
    },
    "5a79": {
      "source_hash": "8bfb00ead06e",
      "text": "상태가 불확실하면 완료로 치지 말고 다시 확인합니다."
    },
    "n3m5": {
      "source_hash": "cd9fcf02ebe2",
      "text": "에이전트는 끝날 때까지 루프로 돕니다."
    },
    "dgnj": {
      "source_hash": "87ee7d352ec9",
      "text": "다음 할 일을 판단하고"
    },
    "rqdt": {
      "source_hash": "dafa8ffba09e",
      "text": "도구로 실행"
    },
    "hwmy": {
      "source_hash": "08005d56f2ac",
      "text": "결과 보고 다음을 정합니다."
    },
    "rjcw": {
      "source_hash": "55445dd2010d",
      "text": "한 바퀴마다 모델 호출이 늘고 비용이 붙습니다."
    },
    "erz6": {
      "source_hash": "2fe7f7846986",
      "text": "루프가 더 돌면 청구액은 얼마가 될까요?"
    },
    "un5z": {
      "source_hash": "c79bad3396a5",
      "text": "왜 문답 1회보다 비쌀까요?"
    },
    "qfq7": {
      "source_hash": "1723965228e2",
      "text": "일 하나에 모델을 여러 번 부르기 때문입니다."
    },
    "mhbv": {
      "source_hash": "b891233109e8",
      "text": "매번 앞 대화·결과를 재처리할 수 있습니다."
    },
    "gixc": {
      "source_hash": "5d850e0e8d98",
      "text": "지시, 도구 정의, 도구 결과도 매번 함께 들어갑니다."
    },
    "6pn5": {
      "source_hash": "85bfdede1ce9",
      "text": "하위 에이전트도 각각 계산합니다."
    },
    "tik7": {
      "source_hash": "fb5dfd20456a",
      "text": "오래 하고 오갈수록 이름만으로 비용을 가늠하기 어렵습니다."
    },
    "nuez": {
      "source_hash": "c4682d93b8a9",
      "text": "제 생각에 계산 없이 쓰면 청구서에 놀라기 쉽습니다."
    },
    "9hqz": {
      "source_hash": "8d4913b967cf",
      "text": "한 번 묻고 답하면 약 6센트입니다."
    },
    "th3u": {
      "source_hash": "e74787d796e0",
      "text": "다섯 번 오가는 에이전트는 약 95센트입니다."
    },
    "36u6": {
      "source_hash": "320eccc9ba6c",
      "text": "약 16배 차이고, 하위 에이전트는 뺀 겁니다."
    },
    "k7aw": {
      "source_hash": "b65e14725bdb",
      "text": "구조를 보이는 예시일 뿐 실제 청구서가 아닙니다."
    },
    "nwfx": {
      "source_hash": "4a1c3fee6d7b",
      "text": "실제는 5회 이상이 흔합니다."
    },
    "e2ux": {
      "source_hash": "a7ec154715dc",
      "text": "차이는 모델값 아닌 구조 탓입니다."
    },
    "59w3": {
      "source_hash": "d6d6e8c2b5d5",
      "text": "하위 에이전트도 각자 모델을 씁니다."
    },
    "rjzv": {
      "source_hash": "07d048da8f8b",
      "text": "주 에이전트가 일을 나눠 맡깁니다."
    },
    "t2rw": {
      "source_hash": "fae4c858bbe7",
      "text": "하위 에이전트 사용량도 합산합니다."
    },
    "6nza": {
      "source_hash": "4c520092805c",
      "text": "다섯 번을 펼치면 청구서는 어떻게 생겼을까요?"
    },
    "gq6q": {
      "source_hash": "a69de7bdb3b8",
      "text": "5회 펼치면 돈이 보입니다."
    },
    "bjcd": {
      "source_hash": "985950301570",
      "text": "1회차 입력 2만 토큰입니다."
    },
    "utze": {
      "source_hash": "c34cf4170c5e",
      "text": "매번 앞을 다시 읽어 입력이 커집니다."
    },
    "we3p": {
      "source_hash": "1bd0ccf5bd65",
      "text": "5회차 15만"
    },
    "bgnm": {
      "source_hash": "bb1f4ac3346e",
      "text": "합계 입력 40만 출력 14,500 토큰."
    },
    "eugj": {
      "source_hash": "a358d4ec8381",
      "text": "총 1달러 가까이."
    },
    "i28v": {
      "source_hash": "44b32a5b4f6f",
      "text": "출력은 적고 입력이 계속 커진 겁니다."
    },
    "3bfe": {
      "source_hash": "78cd54f3172a",
      "text": "이 예시의 비용은 주로 반복 처리되는 입력에서 나옵니다."
    },
    "yuae": {
      "source_hash": "b003f89d89e5",
      "text": "모델이 바뀌면 배수도 다를 수 있습니다."
    },
    "yug2": {
      "source_hash": "0d607bcfde9e",
      "text": "캐시 미적중 가정"
    },
    "ucxc": {
      "source_hash": "930c303e8f4c",
      "text": "캐시는 입력비를 줄일 수 있으나 읽기·쓰기는 별도 단가."
    },
    "t5sk": {
      "source_hash": "b6afccc9674b",
      "text": "도구와 샌드박스 비용도 넣지 않았습니다."
    },
    "3n94": {
      "source_hash": "7e7c4b890d96",
      "text": "OpenAI 자체 문서에 있는 말입니다."
    },
    "nhwz": {
      "source_hash": "52cd97460493",
      "text": "에이전트는 모델을 여러 번 부를 수 있다고 합니다."
    },
    "bqbk": {
      "source_hash": "e2d2c6e9b0df",
      "text": "긴 기록을 반복 처리할 수 있다고도 씁니다."
    },
    "e633": {
      "source_hash": "a23417c931c9",
      "text": "저는 작업명만으로 총액 짐작이 어렵다고 봅니다."
    },
    "mhmx": {
      "source_hash": "ae5c5435b5e2",
      "text": "적용 방법 전체는 설명란 첫 줄의 글에 있습니다."
    },
    "avps": {
      "source_hash": "087f876d1fca",
      "text": "회차 수와 글자 수만 바꾸면 내 청구액을 추정합니다."
    },
    "ni5n": {
      "source_hash": "f2c5764cb8d9",
      "text": "한 번 계산하면 맡길지 압니다."
    },
    "kj63": {
      "source_hash": "a0d013610359",
      "text": "에이전트 외주를 맡기려면 계약 전에 무엇을 물을까요?"
    },
    "bh3n": {
      "source_hash": "b244b0729776",
      "text": "계약 전 네 가지 질문."
    },
    "grrh": {
      "source_hash": "ce11f6df2065",
      "text": "첫째, 읽고 쓰는 데이터와 연결 서비스는?"
    },
    "ntt6": {
      "source_hash": "2f38345cca70",
      "text": "둘째, 기록의 열람·보관은?"
    },
    "zjhh": {
      "source_hash": "e3c7b8235d52",
      "text": "셋째, 잘못되면 누가 멈춥니까?"
    },
    "8qcn": {
      "source_hash": "d73dc73c5d7f",
      "text": "넷째, 실제 데이터로 일주일 시험하고 비용을 적습니다."
    },
    "vzet": {
      "source_hash": "765f9f3c924c",
      "text": "네 질문에 답 못 하는 외주는 보류합니다."
    },
    "jj2b": {
      "source_hash": "3bffa20ea2f9",
      "text": "답해야 사고 대비를 생각한 겁니다."
    },
    "3xde": {
      "source_hash": "feb9890c117a",
      "text": "이건 쓸 때도 체크리스트입니다."
    },
    "48gr": {
      "source_hash": "954897d8dfee",
      "text": "저는 모델이 똑똑한지 비교보다 이 질문이 중요하다고 봅니다."
    },
    "wxkd": {
      "source_hash": "c9eeab8e1760",
      "text": "저는 이 중 예산 상한이 가장 든든하다고 봅니다."
    },
    "f5f8": {
      "source_hash": "129e78320fc4",
      "text": "OpenAI는 월 하드 한도가 있습니다."
    },
    "i86p": {
      "source_hash": "1761c7eb0a93",
      "text": "한도에 닿으면 요청 거부됩니다."
    },
    "ix3h": {
      "source_hash": "1051bd924b4e",
      "text": "다만 경고는 알림뿐입니다."
    },
    "qb7f": {
      "source_hash": "185c4fa4088c",
      "text": "하드 한도는 지연돼 조금 초과할 수 있습니다."
    },
    "twky": {
      "source_hash": "bb2b863b8c5b",
      "text": "그래서 작업당 한도와 언제든 멈출 수 있는 흐름도 함께 두세요."
    },
    "ghc5": {
      "source_hash": "b9ab0d921a86",
      "text": "하드 한도를 켰는지 확인하고, 경고를 정지로 착각하지 마세요."
    },
    "tzx5": {
      "source_hash": "e3cd67e0e16a",
      "text": "저는 낮게 시작해 잘 돌면 올리기를 권합니다."
    },
    "yhq4": {
      "source_hash": "ee5e11602b5b",
      "text": "잘못되면 이력을 알아야 합니다."
    },
    "72vw": {
      "source_hash": "e2e8329d88c4",
      "text": "세션 기록에서 매 회차를 조회합니다."
    },
    "97dz": {
      "source_hash": "05e236745e65",
      "text": "기록이 어디 있고 누가 보는지 물어야 합니다."
    },
    "wtui": {
      "source_hash": "3ab994c69383",
      "text": "기록 사용량은 최선 기록이며 최종 청구서가 아닙니다."
    },
    "grtm": {
      "source_hash": "704ef461ad5b",
      "text": "규정상 OpenAI Agents API는 제한 둘."
    },
    "6k39": {
      "source_hash": "7fa91d8edb45",
      "text": "2026년 9월 기준 데이터 상주는 미국뿐입니다."
    },
    "r35n": {
      "source_hash": "c5bc2d425ef2",
      "text": "제로 데이터 보존 미지원, 자체 샌드박스도."
    },
    "e65x": {
      "source_hash": "ee159f54e488",
      "text": "개발 전에 확인합니다. 중간에 알면 늦습니다."
    },
    "dx6f": {
      "source_hash": "c78a723e8767",
      "text": "연결한 서비스의 규정이 데이터에 적용됩니다."
    },
    "y4j5": {
      "source_hash": "c02b8990a785",
      "text": "규정이 기능보다 먼저 사용 여부를 정합니다."
    },
    "8zn8": {
      "source_hash": "49911c0c3590",
      "text": "정말 쓴다면 첫걸음은 어디서 시작할까요?"
    },
    "gfgy": {
      "source_hash": "8e458ee537b1",
      "text": "저는 안전한 일부터 권합니다."
    },
    "rjnj": {
      "source_hash": "aee9dabc130b",
      "text": "읽기 전용·추적 가능한 일부터: 공개 자료 정리, 초안."
    },
    "3auf": {
      "source_hash": "31bfc23d9809",
      "text": "수정 동작은 사람 확인 후 맡깁니다."
    },
    "igut": {
      "source_hash": "beb9eb19a5cb",
      "text": "비용 기록, 삭제 절차, 사람 확인이 잘 돌면 넓힙니다."
    },
    "kmqx": {
      "source_hash": "ee7f086a118f",
      "text": "에이전트라고 전권을 주면 안 됩니다."
    },
    "9yif": {
      "source_hash": "4cc5a7c94df1",
      "text": "고객 기밀 없는 내부 업무가 시험에 제격입니다."
    },
    "jfu4": {
      "source_hash": "b08c31f32b18",
      "text": "끝으로, 자율성이 높다고 더 믿음직하진 않습니다."
    },
    "mhmq": {
      "source_hash": "6866a7b503b5",
      "text": "앞 단계 결과가 뒤 모든 단계의 근거가 됩니다."
    },
    "pdfe": {
      "source_hash": "3dad94550167",
      "text": "1단계 오독은 중복 제거·집계·보고서에 번질 수 있습니다."
    },
    "5g7p": {
      "source_hash": "e7eb406b180e",
      "text": "좋은 흐름은 갈림길에서 멈춰 확인합니다."
    },
    "2xyf": {
      "source_hash": "6e0f3a2fbb62",
      "text": "확인 대기 정지는 무능이 아니라 올바른 처리입니다."
    },
    "69tt": {
      "source_hash": "f9417f63c328",
      "text": "처음 질문으로 돌아가, 에이전트는 어디서 비싸고 어떻게 다스릴까요?"
    },
    "2xgp": {
      "source_hash": "1cc6cbb07be4",
      "text": "첫째, 스스로 다음 단계를 정하는지 봅니다."
    },
    "sknr": {
      "source_hash": "1a5e17013927",
      "text": "둘째, 다회 호출은 기록을 재처리 가능합니다."
    },
    "t344": {
      "source_hash": "02c111744c8b",
      "text": "셋째, 하드 한도, 경고, 정지 흐름으로 예산을 통제합니다."
    },
    "7e7i": {
      "source_hash": "7a3e6789a8cd",
      "text": "맡기면 수작업이 줄지, 통제를 버리진 않습니다."
    },
    "jd27": {
      "source_hash": "56422ec9d171",
      "text": "다음 영상에서 만나요."
    }
  }
}
