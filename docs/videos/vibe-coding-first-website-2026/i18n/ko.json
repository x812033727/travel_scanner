    "tags": "dc96d8a4df8e"
  },
  "lines": {
    "6jm7": {
      "source_hash": "fc03f6a2a280",
      "text": "세 AI 모두 대화로 웹사이트를 만드나, 무료 계정은 안 될 수 있습니다."
    },
    "9acq": {
      "source_hash": "7b7fdb3dc301",
      "text": "같은 요구로 세 곳을 비교하고 무료 배포까지 갑니다."
    },
    "32bz": {
      "source_hash": "e8f5615c5880",
      "text": "도구 선택은 모델 성능 싸움이라고 생각하지만,"
    },
    "yck8": {
      "source_hash": "a84e4b29b6f7",
      "text": "첫 관문은 계정 사용 여부입니다."
    },
    "hsiq": {
      "source_hash": "6876c8b30ba1",
      "text": "세 곳의 공식 페이지는 뭐라고 할까요?"
    },
    "z52a": {
      "source_hash": "bd36b1c24d65",
      "text": "Claude Artifacts는 무료도 됩니다."
    },
    "3rhn": {
      "source_hash": "b2d908aecfb8",
      "text": "Gemini Canvas는 공식상 누구나 씁니다."
    },
    "swky": {
      "source_hash": "6b3896367396",
      "text": "ChatGPT Sites, 무료와 Go는 안 됩니다."
    },
    "aini": {
      "source_hash": "e5efee176cc5",
      "text": "비슷해 보여도 차이는 내 계정에 있습니다."
    },
    "sbwf": {
      "source_hash": "8d409a396424",
      "text": "공식상 무료가 되는 곳은 Claude와 Gemini입니다."
    },
    "7up6": {
      "source_hash": "92e2c21c3292",
      "text": "ChatGPT는 무료와 Go 모두 안 됩니다."
    },
    "x9sq": {
      "source_hash": "21f077fe3382",
      "text": "같은 요구를 세 곳에 다 시험하려면, 요구를 어떻게 써야 할까요?"
    },
    "tm5t": {
      "source_hash": "71b79df06150",
      "text": "먼저 목적, 누가 보고 무엇을 할지 씁니다."
    },
    "q87a": {
      "source_hash": "8ebeb71d3e13",
      "text": "그다음 내용, 글은 직접 붙입니다."
    },
    "9unv": {
      "source_hash": "e625da978e18",
      "text": "스타일은 구체적으로, 아이보리에 진녹색 포인트."
    },
    "u297": {
      "source_hash": "5efdb7ccede1",
      "text": "넷째는 하지 말 것, 자주 빠집니다."
    },
    "2b4k": {
      "source_hash": "f84c93ecd641",
      "text": "끝으로 기술 범위와 파일 형태를 씁니다."
    },
    "hti7": {
      "source_hash": "566e6ccb70bb",
      "text": "하지 말 것이 없으면 AI가 불필요한 걸 잔뜩 채웁니다."
    },
    "s5hs": {
      "source_hash": "2e117a441f13",
      "text": "'웹사이트 만들어 줘'는 AI의 추측뿐입니다."
    },
    "t4ni": {
      "source_hash": "c7ef2a4622c7",
      "text": "네 항목을 다 쓰면 원하는 것에 가까워집니다."
    },
    "pjat": {
      "source_hash": "81d9430800c3",
      "text": "제 생각에 문턱은 코딩이 아니라 요구를 분명히 말하는 겁니다."
    },
    "dv87": {
      "source_hash": "d08e2c0f5f98",
      "text": "HTML 파일 하나만, index.html로 요청합니다."
    },
    "ztfe": {
      "source_hash": "75f7071cb028",
      "text": "스타일도 같은 파일 안에 씁니다."
    },
    "wm55": {
      "source_hash": "95b840339b6b",
      "text": "외부 이미지와 글꼴, 프레임워크는 쓰지 않습니다."
    },
    "frv7": {
      "source_hash": "d4008a2d3c0e",
      "text": "세 도구에 템플릿을 붙이고 괄호 안을 채웁니다."
    },
    "ctf9": {
      "source_hash": "36cc557ede47",
      "text": "요구를 썼다면, 세 곳의 입구는 각각 어디일까요?"
    },
    "iret": {
      "source_hash": "7500b422daa7",
      "text": "Claude는 붙이면 대화 옆 창에 바로 열립니다."
    },
    "tyw4": {
      "source_hash": "81e0bf374c52",
      "text": "Gemini는 창 아래 Canvas부터 고릅니다."
    },
    "8jfe": {
      "source_hash": "3497430f8cac",
      "text": "웹에선 Work를 고릅니다."
    },
    "xvtz": {
      "source_hash": "0245d3a139ce",
      "text": "프롬프트에 website 또는 Sites를 씁니다."
    },
    "7haj": {
      "source_hash": "751a5c58a898",
      "text": "Claude를 쓰기 전에 설정을 엽니다."
    },
    "uww9": {
      "source_hash": "dd46cc00b024",
      "text": "Capabilities로."
    },
    "wpkd": {
      "source_hash": "74fe57e6964b",
      "text": "코드 실행 및 파일 생성 스위치가 켜졌는지 확인합니다."
    },
    "j3xg": {
      "source_hash": "776068d59479",
      "text": "공식상 Artifacts에 필요하며 무료는 기본 켜짐입니다."
    },
    "39ct": {
      "source_hash": "e12d5f9d65ec",
      "text": "Claude는 무료로 되고, 설정 하나만 확인합니다."
    },
    "yrac": {
      "source_hash": "7de36a1e8b73",
      "text": "Gemini는 코드를 고치고 오류 땐 콘솔도 봅니다."
    },
    "6x9c": {
      "source_hash": "a78f3df059ee",
      "text": "다만 내보내기에 웹 파일 다운로드 안내는 없습니다."
    },
    "i6k9": {
      "source_hash": "62d23de65ec8",
      "text": "ChatGPT는 설명부터 게시까지 한 곳에서 되지만 아직 공개 베타입니다."
    },
    "e4kn": {
      "source_hash": "d05a50e7b13a",
      "text": "ChatGPT 공식 FAQ는 아주 직설적입니다."
    },
    "epsd": {
      "source_hash": "f8618a243655",
      "text": "Sites는 무료 플랜과 Go 플랜에서 쓸 수 없습니다."
    },
    "uyi5": {
      "source_hash": "fb393f422c8e",
      "text": "곳마다 새 대화에 같은 요구를 붙입니다."
    },
    "3aaf": {
      "source_hash": "204b5d6ade46",
      "text": "결과는 각자 폴더에 index.html로 저장합니다."
    },
    "djbb": {
      "source_hash": "5cd28a61acb2",
      "text": "나란히 열고, 계정 안 되는 곳은 건너뜁니다."
    },
    "wskr": {
      "source_hash": "d4073af3e450",
      "text": "어느 쪽이 가까운지 눈으로 보입니다."
    },
    "fvv9": {
      "source_hash": "6b64f7f26ce2",
      "text": "이름·플랜이 잘 바뀌니 당일 공식 사이트 기준입니다."
    },
    "p2zu": {
      "source_hash": "bbce6ea1ccfc",
      "text": "도구를 고르고 파일도 받았다면, 어떻게 고쳐야 덜 꼬일까요?"
    },
    "x9y8": {
      "source_hash": "ee7f8ca9576a",
      "text": "다운로드 버튼이 있으면 받고, 없으면 코드를 복사합니다."
    },
    "y8wd": {
      "source_hash": "723066002755",
      "text": "텍스트 편집기에 붙여 index.html로 저장하고, 새 폴더에 넣습니다."
    },
    "cbym": {
      "source_hash": "950448c36c36",
      "text": "더블클릭해 브라우저로 열면 진짜 모습입니다."
    },
    "fi98": {
      "source_hash": "6d1b89b35d68",
      "text": "버튼이 바뀌어 못 찾으면 복사합니다."
    },
    "9e6i": {
      "source_hash": "67fe2e0018bc",
      "text": "미리보기가 괜찮아도 파일이 괜찮은 건 아닙니다."
    },
    "4hsz": {
      "source_hash": "c85082495e71",
      "text": "글을 읽고, 모든 링크가 맞는 곳으로 가는지 봅니다."
    },
    "zhva": {
      "source_hash": "e0a389337efd",
      "text": "끝으로 창을 좁혀 모바일이 뭉치는지 봅니다."
    },
    "izrh": {
      "source_hash": "060b328cf891",
      "text": "여기서 보는 건 화면과 글, 코드가 아닙니다."
    },
    "g5pn": {
      "source_hash": "13740f447dfd",
      "text": "템플릿과 수정 프롬프트 셋은 글에 있습니다."
    },
    "39fm": {
      "source_hash": "0e37a8ac4d0e",
      "text": "글 링크는 설명란 첫 줄에 있습니다."
    },
    "dftp": {
      "source_hash": "c6beeb241894",
      "text": "템플릿을 그대로 복사해 괄호 안만 내 내용으로 바꾸면 됩니다."
    },
    "2zbn": {
      "source_hash": "a878c6c7563d",
      "text": "5개를 한꺼번에 안 던집니다."
    },
    "nieh": {
      "source_hash": "f57bead282d9",
      "text": "첫 번째는 색만, 어느 부분을 무슨 색으로 바꿀지 씁니다."
    },
    "6ijm": {
      "source_hash": "c25c9f1909ff",
      "text": "둘째는 내용 추가, 위치를 씁니다."
    },
    "sxwe": {
      "source_hash": "eee45d5f1926",
      "text": "셋째는 모바일, 좁은 배치를 씁니다."
    },
    "fgdh": {
      "source_hash": "7a4aba4ae5aa",
      "text": "하나 고치면 종종 다른 게 깨집니다."
    },
    "x464": {
      "source_hash": "8b6827b1db79",
      "text": "천천히 가야 더 빠릅니다."
    },
    "98ag": {
      "source_hash": "ab213e5f0356",
      "text": "셋째는 모바일 프롬프트, 범위와 결과를 짚습니다."
    },
    "4tvp": {
      "source_hash": "e35a8ab5014f",
      "text": "끝줄에 쓴 브레이크포인트를 말하게 하면 다른 곳을 건드렸나 압니다."
    },
    "9ppa": {
      "source_hash": "59622c7a4732",
      "text": "'예쁘게'는 안 됩니다."
    },
    "i69p": {
      "source_hash": "5a2ffd22e242",
      "text": "제목 진녹색, 작품 영역 2열이라야 알아듣습니다."
    },
    "3r7m": {
      "source_hash": "ff585adb071f",
      "text": "고칠 때마다 다시 받아 다시 열어 봅니다."
    },
    "tjmt": {
      "source_hash": "542f9b77d641",
      "text": "고친 뒤 중간 버전을 올리기 쉽습니다."
    },
    "qfg7": {
      "source_hash": "18704eb04e14",
      "text": "만족할 때마다 백업을 저장합니다."
    },
    "yqcj": {
      "source_hash": "7e29f815816c",
      "text": "백업했다면, 이 버전을 무료로 올리려면 어떻게 할까요?"
    },
    "a4vh": {
      "source_hash": "6de3fa2b6632",
      "text": "무료 정적 서비스에 올립니다."
    },
    "hvjf": {
      "source_hash": "5e0ea8a20b7f",
      "text": "GitHub Pages는 1GB, 월 대역폭 소프트 100GB입니다."
    },
    "bguq": {
      "source_hash": "5c5f8af48e8f",
      "text": "Cloudflare Pages는 월 500회 빌드, 사이트당 파일 2만개입니다."
    },
    "knvi": {
      "source_hash": "9abda1ab5c21",
      "text": "소프트와 하드 한도를 구분합니다."
    },
    "wyvs": {
      "source_hash": "54a02f6e763a",
      "text": "GitHub 사이트는 1GB를 넘을 수 없습니다."
    },
    "4raw": {
      "source_hash": "4799789f39ba",
      "text": "GitHub Pages는 시간당 빌드 10회가 소프트 한도입니다."
    },
    "svsx": {
      "source_hash": "aac924998b0c",
      "text": "사용자 지정 GitHub Actions 흐름으로 빌드하고 발행하면 이 한도를 받지 않습니다."
    },
    "sitm": {
      "source_hash": "3c72ba20e72b",
      "text": "배포 전에 폴더를 가장 단순하게 정리합니다."
    },
    "5ymd": {
      "source_hash": "0d4d7ff86889",
      "text": "이 단일 HTML의 첫 파일은 index.html, 올려야 입구가 됩니다."
    },
    "5y3q": {
      "source_hash": "04e98230ca41",
      "text": "이미지는 같은 폴더에, 파일명은 영문 소문자로 공백 없이."
    },
    "z4ax": {
      "source_hash": "2ce13ed527e5",
      "text": "파일명·경로가 다르면 배포 후 안 열릴 수 있습니다."
    },
    "7g2d": {
      "source_hash": "1faf82cbdd28",
      "text": "Cloudflare 직접 업로드는 폴더째 끌어 놓습니다."
    },
    "25nv": {
      "source_hash": "62c34095f2bb",
      "text": "한 번에 최대 1000개 파일입니다."
    },
    "zt9w": {
      "source_hash": "c34aafadd4e4",
      "text": "유의점입니다."
    },
    "ihai": {
      "source_hash": "77abb9e37a4e",
      "text": "GitHub는 Pages로 무료 온라인 사업·쇼핑몰을 금지합니다."
    },
    "5azv": {
      "source_hash": "256021fd90e2",
      "text": "개인 소개·포트폴리오는 되고 판매는 다른 서비스를 찾습니다."
    },
    "7f5w": {
      "source_hash": "66152eb78385",
      "text": "GitHub 무료 플랜 Pages는 공개 저장소에서만 됩니다."
    },
    "vy3f": {
      "source_hash": "78ab8ecf84c9",
      "text": "올린 것은 누구나 봅니다."
    },
    "wvvw": {
      "source_hash": "74c6ab90e224",
      "text": "저는 배포 전에 텍스트 편집기로 index.html을 열어 봅니다."
    },
    "kuii": {
      "source_hash": "89390964ff23",
      "text": "먼저 전화와 주소를 검색합니다."
    },
    "2gnu": {
      "source_hash": "c618d6910471",
      "text": "신분증 번호도 검색합니다."
    },
    "d4hc": {
      "source_hash": "0fe6680e28dd",
      "text": "키처럼 보이는 문자열도 한 번 검색합니다."
    },
    "ykf6": {
      "source_hash": "771cb95c8304",
      "text": "이 단계는 직접 꼼꼼히 보고, AI가 문제없다는 말만 믿지 않습니다."
    },
    "e4d8": {
      "source_hash": "ef20234a7e5d",
      "text": "소스는 공개라 지워도 남의 캐시에 남을 수 있습니다."
    },
    "m8xm": {
      "source_hash": "51ca31b82a5d",
      "text": "배포했다면, 세 곳 중 어디가 나에게 맞을까요?"
    },
    "k26g": {
      "source_hash": "520f0c3ef573",
      "text": "무료면 공식상 Claude와 Gemini입니다."
    },
    "sbpk": {
      "source_hash": "10df11347f18",
      "text": "Gemini 계정은 Canvas부터, 제한은 공식 사이트에서 봅니다."
    },
    "6yd4": {
      "source_hash": "ade97369cd96",
      "text": "Plus·Pro·워크스페이스면 Sites도 됩니다."
    },
    "tie9": {
      "source_hash": "5957cd880246",
      "text": "처음으로: 결과는 계정 사용 여부가 정합니다."
    },
    "s5cf": {
      "source_hash": "dc2933883c59",
      "text": "나머지는 같은 방법입니다. 요구를 채우고, 하나씩 고치고, 공개 전에 개인정보를 검색합니다."
    },
    "cuqe": {
      "source_hash": "8305e228fe2c",
      "text": "답은 쓸 수 있는 곳을 고르고, 설명란의 글대로 첫 페이지를 만드는 것입니다."
    }
  }
}
