{
  "zq25a01": {
    "text": "Escrevo,",
    "say": "Escrevo",
    "emotion": "握著筆，小聲，語速快"
  },
  "zq25a02": "e o papai me acha.",
  "zq25a03": "Nem um torrão de mascavo!",
  "zq25a04": {
    "text": "Sem mascavo?",
    "say": "Acabou?"
  },
  "zq25a05": "Usamos cana.",
  "zq25a06": {
    "text": "A cana do sul,",
    "say": "A cana do sul",
    "emotion": "放下筆，輕聲，語速快"
  },
  "zq25a07": "metade é Tang.",
  "zq25a08": "D-dos Tang?",
  "zq25a09": {
    "text": "O velho Zheng serve o papai há trinta anos.",
    "say": "Zheng, trinta anos de casa."
  },
  "zq25a10": {
    "text": "Uma carta, e em três dias tem barco.",
    "say": "Em três dias tem barco.",
    "emotion": "畫外，輕聲，語速快"
  },
  "zq25a11": "Então bora!",
  "zq25a12": {
    "text": "Só que",
    "say": "Mas",
    "emotion": "笑容收起，短促"
  },
  "zq25a13": "o Wei descobre.",
  "zq25a14": {
    "text": "Guerra comercial, dia oito: vinte por cento atrás.",
    "say": "Dia oito: vinte por cento atrás."
  },
  "zq25a15": {
    "text": "Vai,",
    "say": "Vai",
    "emotion": "很輕，短促"
  },
  "zq25a16": {
    "text": "eu tô aqui.",
    "say": "tô aqui."
  },
  "zq25a17": "Não me impede?",
  "zq25a18": {
    "text": "A família é sua,",
    "say": "É sua",
    "emotion": "溫柔，語速快，不笑出聲"
  },
  "zq25a19": "você manda.",
  "zq25a20": {
    "text": "Tang Xiaotang: afeição, mais seis.",
    "say": "Tang Xiaotang: mais seis."
  },
  "zq25a21": "Três barcos!",
  "zq25a22": {
    "text": "Cheios de cana!",
    "say": "Só cana!",
    "emotion": "大叫，不笑，短促"
  },
  "zq25a23": {
    "text": "É carga dos Wei!",
    "say": "É do Wei!"
  },
  "zq25a24": {
    "text": "Ninguém descarrega!",
    "say": "Ninguém mexe!"
  },
  "zq25a25": {
    "text": "Proteger os barcos?",
    "say": "Os barcos?"
  },
  "zq25a26": {
    "text": "Quem manda é a Qin Shuang.",
    "say": "É a Qin Shuang."
  },
  "zq25a27": {
    "text": "Qin Shuang: afeição, mais seis.",
    "say": "Qin Shuang: mais seis."
  },
  "zq25a28": {
    "text": "Paus na frente,",
    "say": "Paus!",
    "emotion": "乾脆，短促一聲"
  },
  "zq25a29": "cordas nos barcos!",
  "zq25a30": "Vão ver só!",
  "zq25a31": {
    "text": "Duas filas,",
    "say": "Filas!",
    "emotion": "一聲令下，短促"
  },
  "zq25a32": "puxem juntos!",
  "zq25a33": "É o jovem Xu?",
  "zq25a34": {
    "text": "O acordo do patrão com o chanceler…",
    "say": "O trato com o chanceler…"
  },
  "zq25a35": "a menina não sabe?",
  "zq25a36": "Que trato?",
  "zq25a37": "Falei demais.",
  "zq25a38": {
    "text": "Filha!",
    "emotion": "畫外，慈愛，短促，不笑"
  },
  "zq25a39": {
    "text": "já comeu?",
    "emotion": "慈愛，語速快"
  },
  "zq25a40": "Papai…"
}
