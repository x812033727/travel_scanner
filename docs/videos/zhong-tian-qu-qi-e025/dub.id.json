{
  "zq25a01": {
    "text": "Kutulis,",
    "emotion": "握著筆，小聲，短促",
    "say": "Kutulis"
  },
  "zq25a02": "Ayah bakal tahu aku di mana.",
  "zq25a03": "Sebongkah gula merah pun nggak ada!",
  "zq25a04": "Gula habis?",
  "zq25a05": "Rebus tebu aja.",
  "zq25a06": {
    "text": "Separuh tebu,",
    "say": "Separuh tebu"
  },
  "zq25a07": {
    "text": "milik keluarga Tang.",
    "say": "milik Tang."
  },
  "zq25a08": "Ke-keluarga Tang?",
  "zq25a09": "Paman Zheng tangan kanan Ayah.",
  "zq25a10": "Satu surat, tiga hari ada kapal.",
  "zq25a11": "Tunggu apa lagi?",
  "zq25a12": {
    "text": "Tapi,",
    "say": "Tapi"
  },
  "zq25a13": "Wei juga tahu.",
  "zq25a14": {
    "text": "Hari kedelapan: kalah dua puluh persen.",
    "say": "Hari delapan: kalah dua puluh persen.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq25a15": {
    "text": "Ya,",
    "emotion": "很輕，短促",
    "say": "Ya"
  },
  "zq25a16": "Aku ada.",
  "zq25a17": "Nggak larang?",
  "zq25a18": {
    "text": "Rumahmu,",
    "emotion": "溫柔，不笑出聲",
    "say": "Rumahmu"
  },
  "zq25a19": "pilihanmu.",
  "zq25a20": "Tang Xiaotang, poin suka plus enam.",
  "zq25a21": "Tiga kapal!",
  "zq25a22": {
    "text": "Semuanya tebu!",
    "emotion": "大叫，不笑出聲，短促"
  },
  "zq25a23": "Barang Wei!",
  "zq25a24": "Jangan dibongkar!",
  "zq25a25": {
    "text": "Jaga kapal,",
    "emotion": "頭也不回，語速快，短促",
    "say": "Jaga kapal"
  },
  "zq25a26": "ikut Qin Shuang.",
  "zq25a27": {
    "text": "Qin Shuang, poin suka plus enam.",
    "say": "Qin Shuang, plus enam.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq25a28": {
    "text": "Tongkat!",
    "emotion": "乾脆，短促一聲"
  },
  "zq25a29": "Tali ke kapal!",
  "zq25a30": "Awas kalian!",
  "zq25a31": {
    "text": "Dua baris,",
    "say": "Dua baris"
  },
  "zq25a32": "tarik bareng!",
  "zq25a33": "Tuan Muda Xu, ya?",
  "zq25a34": {
    "text": "Urusan Tuan dan Perdana Menteri,",
    "say": "Tuan dan Perdana Menteri"
  },
  "zq25a35": "Nona belum tahu, kan?",
  "zq25a36": "Urusan apa?",
  "zq25a37": "Hamba kelepasan bicara.",
  "zq25a38": {
    "text": "Nak,",
    "emotion": "慈愛",
    "say": "Nak"
  },
  "zq25a39": "udah makan?",
  "zq25a40": "Ayah…"
}
