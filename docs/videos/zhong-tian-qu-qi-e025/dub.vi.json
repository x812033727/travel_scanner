{
  "zq25a01": {
    "text": "Nếu viết,",
    "say": "Nếu viết"
  },
  "zq25a02": "cha sẽ biết ta ở đâu.",
  "zq25a03": "Chẳng mua nổi một cục đường đỏ!",
  "zq25a04": {
    "text": "Không có đường đỏ,",
    "say": "Hết đường đỏ"
  },
  "zq25a05": "thì lấy mía nấu.",
  "zq25a06": {
    "text": "Mía Giang Nam,",
    "say": "Mía Giang Nam"
  },
  "zq25a07": "một nửa họ Đường.",
  "zq25a08": "Họ… họ Đường?",
  "zq25a09": {
    "text": "Trịnh bá theo cha ba mươi năm,",
    "say": "Trịnh bá theo cha ba mươi năm"
  },
  "zq25a10": {
    "text": "một lá thư, ba ngày có thuyền.",
    "say": "một lá thư ba ngày có thuyền."
  },
  "zq25a11": "Còn chờ gì nữa?",
  "zq25a12": {
    "text": "Thư tới,",
    "say": "Thư tới"
  },
  "zq25a13": "Ngụy gia cũng biết.",
  "zq25a14": "Đấu thương ngày tám: kém hai phần.",
  "zq25a15": {
    "text": "Nàng chọn,",
    "say": "Nàng chọn.",
    "emotion": "很輕，短促，語速快"
  },
  "zq25a16": "ta ở đây.",
  "zq25a17": "Huynh không khuyên ta?",
  "zq25a18": {
    "text": "Nhà của nàng,",
    "say": "Nhà của nàng",
    "emotion": "溫和，不笑出聲"
  },
  "zq25a19": "nàng quyết định.",
  "zq25a20": {
    "text": "Tiểu Đường, hảo cảm cộng sáu.",
    "say": "Tiểu Đường hảo cảm cộng sáu."
  },
  "zq25a21": "Ba thuyền!",
  "zq25a22": "Toàn là mía!",
  "zq25a23": {
    "text": "Hàng Ngụy Ký,",
    "say": "Hàng Ngụy Ký"
  },
  "zq25a24": "không ai được dỡ!",
  "zq25a25": {
    "text": "Chuyện hộ thuyền,",
    "say": "Chuyện hộ thuyền"
  },
  "zq25a26": "Tần Sương lo.",
  "zq25a27": {
    "text": "Tần Sương, hảo cảm cộng sáu.",
    "say": "Tần Sương hảo cảm cộng sáu.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq25a28": {
    "text": "Gậy lên trước,",
    "say": "Gậy!",
    "emotion": "乾脆，短促一聲"
  },
  "zq25a29": "dây lên thuyền!",
  "zq25a30": "Cứ chờ đấy!",
  "zq25a31": {
    "text": "Hai hàng,",
    "say": "Hai hàng!",
    "emotion": "乾脆，短促，語速快"
  },
  "zq25a32": "cùng kéo!",
  "zq25a33": "Có phải Hứa công tử?",
  "zq25a34": {
    "text": "Món nợ lão gia với tể tướng,",
    "say": "Món nợ lão gia với tể tướng"
  },
  "zq25a35": "tiểu thư không biết chứ?",
  "zq25a36": "Nợ gì?",
  "zq25a37": "Lão nô lắm lời rồi.",
  "zq25a38": {
    "text": "Con gái,",
    "say": "Con gái",
    "emotion": "慈愛"
  },
  "zq25a39": {
    "text": "ăn no chưa?",
    "emotion": "慈愛，不笑出聲"
  },
  "zq25a40": {
    "text": "Cha…",
    "say": "Cha"
  }
}
