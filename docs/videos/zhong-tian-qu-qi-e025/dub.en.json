{
  "zq25a01": "If I write,",
  "zq25a02": "Dad will know where I am.",
  "zq25a03": "Not one lump of brown sugar left!",
  "zq25a04": "No brown sugar?",
  "zq25a05": "Then we boil cane.",
  "zq25a06": "Half the cane",
  "zq25a07": "is Tang cane.",
  "zq25a08": "T-Tang cane?",
  "zq25a09": "Old Zheng's served Dad thirty years.",
  "zq25a10": "One letter, ships in three days.",
  "zq25a11": "So what are we waiting for?",
  "zq25a12": "But then",
  "zq25a13": "the Weis will know too.",
  "zq25a14": "Trade war, day eight: twenty percent behind.",
  "zq25a15": { "text": "Pick.", "emotion": "很輕，短促" },
  "zq25a16": "I'm here.",
  "zq25a17": "You won't talk me out of it?",
  "zq25a18": "It's your family.",
  "zq25a19": "You decide.",
  "zq25a20": "Tang Xiaotang: affection plus six.",
  "zq25a21": "Three ships!",
  "zq25a22": "All sugarcane!",
  "zq25a23": "That's Wei cargo!",
  "zq25a24": "Nobody unloads!",
  "zq25a25": "Guarding the ships?",
  "zq25a26": "Qin Shuang's call.",
  "zq25a27": { "text": "Qin Shuang: affection plus six.", "emotion": "平板電子音，叮一聲，語速偏快" },
  "zq25a28": { "text": "Staffs!", "emotion": "乾脆，短促一聲" },
  "zq25a29": "ropes on the ships!",
  "zq25a30": "You'll pay for this!",
  "zq25a31": "Line up,",
  "zq25a32": "pull together!",
  "zq25a33": "Master Xu, is it?",
  "zq25a34": "The master's deal with the chancellor—",
  "zq25a35": "the young miss doesn't know?",
  "zq25a36": "What deal?",
  "zq25a37": "I've said too much.",
  "zq25a38": { "text": "Dear,", "emotion": "慈愛" },
  "zq25a39": "eaten yet?",
  "zq25a40": "Dad…"
}
