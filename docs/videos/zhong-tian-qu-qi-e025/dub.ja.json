{
  "zq25a01": "書けば、",
  "zq25a02": "父に居場所が。",
  "zq25a03": "黒糖、一個も買えねえ！",
  "zq25a04": "ないなら、",
  "zq25a05": "サトウキビを煮る。",
  "zq25a06": "江南のキビは、",
  "zq25a07": "半分タン家。",
  "zq25a08": "タ、タン家!?",
  "zq25a09": "ジェン爺は父の腹心。",
  "zq25a10": { "text": "手紙で三日、船が来る。", "say": "三日で船が来る。" },
  "zq25a11": "なら急げよ！",
  "zq25a12": "届けば、",
  "zq25a13": "ウェイ家にも漏れる。",
  "zq25a14": "商戦八日目、二割劣勢。",
  "zq25a15": "選べ、",
  "zq25a16": "俺はいる。",
  "zq25a17": "止めないの？",
  "zq25a18": { "text": "君の家、", "emotion": "溫柔，輕聲，不笑" },
  "zq25a19": "君が決めろ。",
  "zq25a20": "シャオタン、好感プラス六。",
  "zq25a21": "船が三隻！",
  "zq25a22": "全部キビだ！",
  "zq25a23": { "text": "うちの荷だ、", "say": "うちの荷！", "emotion": "尖聲，短促，快" },
  "zq25a24": "降ろすな！",
  "zq25a25": "船の守りは",
  "zq25a26": "チン・シュアンに。",
  "zq25a27": { "text": "チン・シュアン、好感プラス六。", "say": "シュアン好感プラス六。" },
  "zq25a28": { "text": "棒は前、", "say": "棒、前！", "emotion": "一聲令下，短促有力" },
  "zq25a29": "縄を船へ！",
  "zq25a30": "お、覚えてろ！",
  "zq25a31": "二列、",
  "zq25a32": "一斉に引け！",
  "zq25a33": "シュー様で？",
  "zq25a34": "旦那様と宰相の取引、",
  "zq25a35": "お嬢様はご存じない？",
  "zq25a36": "取引？",
  "zq25a37": "口が過ぎました。",
  "zq25a38": { "text": "娘や、", "say": "娘", "emotion": "畫外，慈愛，輕聲，極短" },
  "zq25a39": "食べたか？",
  "zq25a40": "父さん……"
}
