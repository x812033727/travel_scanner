{
  "zq25a01": {
    "text": "Listo,",
    "emotion": "握著筆，聲音微抖"
  },
  "zq25a02": "papá me hallará.",
  "zq25a03": "¡Ni un trozo de azúcar morena!",
  "zq25a04": "Sin azúcar,",
  "zq25a05": "la hacemos de caña.",
  "zq25a06": {
    "text": "La caña,",
    "emotion": "輕聲，語速快，不嘆氣"
  },
  "zq25a07": "la mitad es Tang.",
  "zq25a08": "¿De… de los Tang?",
  "zq25a09": "Zheng, treinta años con papá,",
  "zq25a10": "una carta, y en tres días, barcos.",
  "zq25a11": "¿Y qué esperamos?",
  "zq25a12": "Al llegar,",
  "zq25a13": "lo sabrá Wei.",
  "zq25a14": {
    "text": "Guerra comercial, día ocho: veinte por ciento abajo.",
    "say": "Día ocho: veinte por ciento abajo."
  },
  "zq25a15": "Elige,",
  "zq25a16": "te apoyo.",
  "zq25a17": "¿No me detienes?",
  "zq25a18": {
    "text": "Tu familia,",
    "emotion": "溫柔，語速快，不笑出聲"
  },
  "zq25a19": "tú decides.",
  "zq25a20": {
    "text": "Tang Xiaotang: afecto más seis.",
    "say": "Xiaotang: afecto más seis."
  },
  "zq25a21": "¡Tres barcos!",
  "zq25a22": "¡Todos con caña!",
  "zq25a23": "¡Es de los Wei,",
  "zq25a24": "nadie descarga!",
  "zq25a25": "Barcos:",
  "zq25a26": "manda Qin Shuang.",
  "zq25a27": {
    "text": "Qin Shuang: afecto más seis.",
    "say": "Qin Shuang, más seis."
  },
  "zq25a28": "¡Palos delante,",
  "zq25a29": "cuerdas al barco!",
  "zq25a30": "¡Ya verán!",
  "zq25a31": {
    "text": "¡Filas!",
    "emotion": "一聲令下，短促"
  },
  "zq25a32": "¡jalen juntos!",
  "zq25a33": "¿Usted es el joven Xu?",
  "zq25a34": "Lo del amo y el ministro,",
  "zq25a35": "¿la señorita no sabe?",
  "zq25a36": "¿Deuda?",
  "zq25a37": "Hablé de más.",
  "zq25a38": "¡Hija!",
  "zq25a39": {
    "text": "¿ya comiste?",
    "emotion": "慈愛，不笑，語速快"
  },
  "zq25a40": "Papá…"
}
