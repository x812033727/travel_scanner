{
  "zq25a01": {"text": "썼어,", "emotion": "握著筆，小聲，短促"},
  "zq25a02": "아빠가 날 찾겠지.",
  "zq25a03": "흑설탕이 하나도 없어!",
  "zq25a04": "설탕 없으면,",
  "zq25a05": "사탕수수로 졸여.",
  "zq25a06": {"text": "강남에선,", "emotion": "苦笑，語速稍快"},
  "zq25a07": "절반이 탕가 거야.",
  "zq25a08": "타, 탕가?",
  "zq25a09": "정 어르신은 아빠랑 삼십 년,",
  "zq25a10": "편지면 사흘 뒤 배가 와.",
  "zq25a11": "그럼 뭘 기다려?",
  "zq25a12": "편지 가면,",
  "zq25a13": "웨이 가도 알아.",
  "zq25a14": "매출전 팔 일째, 이 할 열세.",
  "zq25a15": {"text": "골라.", "emotion": "很輕，短促"},
  "zq25a16": "내가 있어.",
  "zq25a17": "안 말려?",
  "zq25a18": "네 집이잖아,",
  "zq25a19": "네가 정해.",
  "zq25a20": {"text": "탕샤오탕, 호감 +6.", "say": "탕샤오탕, 호감 플러스 육."},
  "zq25a21": "배 세 척!",
  "zq25a22": {"text": "사탕수수!", "emotion": "樂得大叫，短促"},
  "zq25a23": "위지 거다,",
  "zq25a24": "아무도 못 내려!",
  "zq25a25": "배 지키기,",
  "zq25a26": "친솽 말 들어.",
  "zq25a27": {"text": "친솽, 호감 +6.", "say": "친솽, 호감 플러스 육."},
  "zq25a28": {"text": "몽둥이!", "emotion": "一聲令下，短促"},
  "zq25a29": "밧줄은 배로!",
  "zq25a30": "두, 두고 봐!",
  "zq25a31": "두 줄로,",
  "zq25a32": "같이 당겨!",
  "zq25a33": "쉬 공자시오?",
  "zq25a34": "나리와 재상의 그 빚,",
  "zq25a35": "아가씨는 모르시지요?",
  "zq25a36": "무슨 빚?",
  "zq25a37": "늙은이가 말이 많았소.",
  "zq25a38": "아가,",
  "zq25a39": "밥은 먹었니?",
  "zq25a40": "아빠…"
}
