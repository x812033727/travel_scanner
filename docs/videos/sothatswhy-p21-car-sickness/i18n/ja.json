  },
  "lines": {
    "p001": {
      "source_hash": "5c4beee3def0",
      "text": "おばあちゃんちへ行く車で、"
    },
    "p002": {
      "source_hash": "6e4dc476716c",
      "text": "マンガを読んでたら、"
    },
    "p003": {
      "source_hash": "7e650caf1db2",
      "text": "頭くらくら、おなかも変。"
    },
    "p004": {
      "source_hash": "d798a939e80f",
      "text": "でもパパは前で運転してて、"
    },
    "p005": {
      "source_hash": "a1c0c699cc30",
      "text": "平気なの！"
    },
    "p006": {
      "source_hash": "5ee1aa552d1b",
      "text": "同じ車と道で、あなただけ酔ったの？"
    },
    "p007": {
      "source_hash": "7567ca07d2f5",
      "text": "もっとふしぎよ。目かくしで車に乗ると酔う？"
    },
    "p008": {
      "source_hash": "5341e2cf534f",
      "text": "ソファでじっとして、レースの画面を見るだけなら？"
    },
    "p009": {
      "source_hash": "c0153c674d15",
      "text": "どっちも平気！"
    },
    "p010": {
      "source_hash": "0190ad30208e",
      "text": "待って。酔うのは絶対あなただけじゃないわ。"
    },
    "p011": {
      "source_hash": "ea1c6043b795",
      "text": "おばあちゃんちまでの道で理由を探そう。"
    },
    "p012": {
      "source_hash": "90ca0aa398c1",
      "text": "頭とおなか、"
    },
    "p013": {
      "source_hash": "c8d6b19858db",
      "text": "どうしたの？"
    },
    "p014": {
      "source_hash": "27e32fd3ef80",
      "text": "車酔いって、"
    },
    "p015": {
      "source_hash": "998ca2b0cdf2",
      "text": "耳の中が悪いからって聞いたよ？"
    },
    "p016": {
      "source_hash": "25756bfb2ddf",
      "text": "それは内耳ね。そうとも限らないの。車酔いの研究者によると、"
    },
    "p017": {
      "source_hash": "71e23299cc8a",
      "text": "内耳のバランス機能が全く使えない人だけが、全く酔わないの。"
    },
    "p018": {
      "source_hash": "9e7ad68ab721",
      "text": "耳が元気な人は、ほとんど誰でも酔うかも。"
    },
    "p019": {
      "source_hash": "349e9c3e20b9",
      "text": "じゃあ、耳はちゃんと働いてるの？"
    },
    "p020": {
      "source_hash": "90a7746c2902",
      "text": "そうね。酔うのは、それがずっと働いてる証拠。"
    },
    "p021": {
      "source_hash": "f328024742e1",
      "text": "何をしてるの？"
    },
    "p022": {
      "source_hash": "6f9e9698eae2",
      "text": "耳の奥深くに、細い管と小袋がいくつかあって、"
    },
    "p023": {
      "source_hash": "3dc758a16f0a",
      "text": "中に液体が入ってるの。"
    },
    "p024": {
      "source_hash": "d42e563dc9c9",
      "text": "コップで考えよう。"
    },
    "p025": {
      "source_hash": "be2507c79251",
      "text": "車が曲がると、水は片側にゆれる。"
    },
    "p026": {
      "source_hash": "8203904a575c",
      "text": "ブレーキでも加速でもゆれる。"
    },
    "p027": {
      "source_hash": "24200361cd3f",
      "text": "耳の液体もゆれるの。中には小さな粒があって、地球に下へ引かれてる。"
    },
    "p028": {
      "source_hash": "563ed675c89c",
      "text": "脳はそのゆれ方で、曲がってるか、加速かブレーキかを知るの。"
    },
    "p029": {
      "source_hash": "6100567044eb",
      "text": "コップはただのたとえよ。本物の耳の中はすごく小さくて、"
    },
    "p030": {
      "source_hash": "d29d9d2558f9",
      "text": "曲がるのを感じる所と、加速を感じる所は、別々なの。"
    },
    "p031": {
      "source_hash": "0a11a0675b4f",
      "text": "目も脳に教えてるの？"
    },
    "p032": {
      "source_hash": "b6de6598e2d4",
      "text": "ええ。目も外の景色の動きで、動いてると脳に伝えてる。"
    },
    "p033": {
      "source_hash": "083e4c9d2f9c",
      "text": "足の裏や筋肉もよ。"
    },
    "p034": {
      "source_hash": "b6d5cb9490e2",
      "text": "歩いてるときは？"
    },
    "p035": {
      "source_hash": "ca203f2d583d",
      "text": "歩くと、道は後ろへ流れて見えて、コップの水もゆれる。"
    },
    "p036": {
      "source_hash": "e12a871d0929",
      "text": "みんな同じ話で、脳は安心。"
    },
    "p037": {
      "source_hash": "8166a5d5f198",
      "text": "マンガのときは、"
    },
    "p038": {
      "source_hash": "f9888b0af1b1",
      "text": "誰がうそつき？"
    },
    "p039": {
      "source_hash": "f87635bb3768",
      "text": "うそはないの。見てる物が違うだけ。"
    },
    "p040": {
      "source_hash": "79dacadf1529",
      "text": "ずっとマンガ見てた！"
    },
    "p041": {
      "source_hash": "75a9482742bd",
      "text": "マンガは手の中で一緒にゆれる。"
    },
    "p042": {
      "source_hash": "c28f498fd9f7",
      "text": "それを見る目は「動いてない」。"
    },
    "p043": {
      "source_hash": "01812e53b9c7",
      "text": "でも車が曲がると、コップの水がゆれる。"
    },
    "p044": {
      "source_hash": "3d4edc2ff3a8",
      "text": "内耳の報告は「曲がってる」。"
    },
    "p045": {
      "source_hash": "175d1c25b669",
      "text": "動いてない、"
    },
    "p046": {
      "source_hash": "2649ca8ccc0e",
      "text": "曲がってる！"
    },
    "p047": {
      "source_hash": "286b0a1764ac",
      "text": "そう、二つの報告が合わないの。"
    },
    "p048": {
      "source_hash": "ae8e9677670f",
      "text": "目を閉じたら、"
    },
    "p049": {
      "source_hash": "8ca7bd7682b0",
      "text": "ケンカなし？"
    },
    "p050": {
      "source_hash": "10c53893fa0e",
      "text": "目かくしの乗客も酔うって言ったの、覚えてる？"
    },
    "p051": {
      "source_hash": "22c11d50bca6",
      "text": "イギリスの研究で、郊外を三十分車で走ったら、"
    },
    "p052": {
      "source_hash": "5563d968cc9e",
      "text": "目かくしの人も、前が見えない人も、同じくらい酔ったんだって。"
    },
    "p053": {
      "source_hash": "23c7c6e7c512",
      "text": "目を閉じても、脳が静まるとは限らない。"
    },
    "p054": {
      "source_hash": "5196d3c1ea23",
      "text": "誰とケンカ？"
    },
    "p055": {
      "source_hash": "53f4a9cb43a4",
      "text": "そこよ。脳は報告を聞くだけじゃなく、先に予想もするの。"
    },
    "p056": {
      "source_hash": "ee04a1fdfeb9",
      "text": "心の中で「このままなら、次はこう感じるはず」と考えてる。"
    },
    "p057": {
      "source_hash": "fd92f94c2e81",
      "text": "報告が予想と合わないと、気分が悪くなる。"
    },
    "p058": {
      "source_hash": "3ebc1e7cc21c",
      "text": "これが感覚の食い違い。今の車酔い研究で一番有力な説明よ。"
    },
    "p059": {
      "source_hash": "cb7264e07928",
      "text": "でも説明の一つで、全部の答えじゃない。"
    },
    "p060": {
      "source_hash": "74aaab34f3d4",
      "text": "外を見るとましになる？"
    },
    "p061": {
      "source_hash": "fafdcc697452",
      "text": "研究者が本当に聞いたの。イギリスで三千人以上の観光バスの乗客に、"
    },
    "p062": {
      "source_hash": "e795fa26cf33",
      "text": "前の道がまったく見えなかった人で、気分が悪くなった人は、"
    },
    "p063": {
      "source_hash": "ca791a401ff3",
      "text": "よく見えた人の約三倍だったの。"
    },
    "p064": {
      "source_hash": "71f91a52f7fc",
      "text": "さっきの目かくしの実験でも、横の窓しか見えないと、"
    },
    "p065": {
      "source_hash": "fad68aab08c4",
      "text": "前が見えないのとほぼ同じ。"
    },
    "p066": {
      "source_hash": "7e9f2dcd2af9",
      "text": "前の道が見えると、酔いにくいの。"
    },
    "p067": {
      "source_hash": "7f75c461a226",
      "text": "窓じゃない？"
    },
    "p068": {
      "source_hash": "73c5663e696c",
      "text": "そう。あの実験では、座る席でははっきり差が出なかったの。"
    },
    "p069": {
      "source_hash": "9759e1b7b1ed",
      "text": "私の考えは、カーブを目が先に見て、"
    },
    "p070": {
      "source_hash": "787dd47d1cae",
      "text": "脳が水のゆれを読めるの。"
    },
    "p071": {
      "source_hash": "7499c3da7cae",
      "text": "オランダの実験では、乗客が車の中で画面を見て物を探したの。"
    },
    "p072": {
      "source_hash": "146e090d15bd",
      "text": "画面が前窓の高さで外も見えると、低い位置より酔いにくかった。"
    },
    "p073": {
      "source_hash": "895468a19115",
      "text": "パパは？"
    },
    "p074": {
      "source_hash": "19928187b679",
      "text": "酔わないの？"
    },
    "p075": {
      "source_hash": "6e46aa9a60e5",
      "text": "それは一部。運転手が酔いにくいことは研究者も気づいてた。"
    },
    "p076": {
      "source_hash": "54c6f9273ba0",
      "text": "イスラエルの実験で、二十二組の人が回る機械に乗ったの。"
    },
    "p077": {
      "source_hash": "0bfb2704917e",
      "text": "二人は同じように回るけど、操作できるのは片方だけ。"
    },
    "p078": {
      "source_hash": "6384d4a421ad",
      "text": "操作できる人が、"
    },
    "p079": {
      "source_hash": "2bdd10949861",
      "text": "酔わない？"
    },
    "p080": {
      "source_hash": "dcc4c866d9b1",
      "text": "ええ、操作した方が、気持ち悪さが明らかに少なかった。"
    },
    "p081": {
      "source_hash": "98de71fe889a",
      "text": "研究者いわく、自分で曲がると脳は先に知ってて、"
    },
    "p082": {
      "source_hash": "5c93fd895187",
      "text": "水がゆれても、ちょうど予想どおりになるの。"
    },
    "p083": {
      "source_hash": "b338f1878c36",
      "text": "音で「いつ、どっちへ」を先に知らせる実験も。"
    },
    "p084": {
      "source_hash": "3b8afea6420c",
      "text": "合図があると、同じ人でも酔いにくい。"
    },
    "p085": {
      "source_hash": "1a2801fde467",
      "text": "パパが先に、"
    },
    "p086": {
      "source_hash": "ae988f4a22d3",
      "text": "「曲がるよ」って？"
    },
    "p087": {
      "source_hash": "71e5bfecfdb0",
      "text": "近いわ。実験はレールの車で、山道じゃない。"
    },
    "p088": {
      "source_hash": "1ece36879d4a",
      "text": "目は動いてて、"
    },
    "p089": {
      "source_hash": "eefb469d2204",
      "text": "体は動いてないなら？"
    },
    "p090": {
      "source_hash": "1cd814630e8a",
      "text": "それがさっきのソファの話よ。"
    },
    "p091": {
      "source_hash": "2b4118395067",
      "text": "ソファでレースゲームを見ると、画面の道がどんどん迫ってくる。"
    },
    "p092": {
      "source_hash": "e20d0e7f58d3",
      "text": "目の報告は「すごく速い」。"
    },
    "p093": {
      "source_hash": "45d9502d28a1",
      "text": "でも机の水はぴくりともしない。"
    },
    "p094": {
      "source_hash": "8aeae008a9f3",
      "text": "内耳の報告も「動いてない」。"
    },
    "p095": {
      "source_hash": "fd7296c40d32",
      "text": "今度は目が、"
    },
    "p096": {
      "source_hash": "2da00e00ccfe",
      "text": "動いてるって！"
    },
    "p097": {
      "source_hash": "f28273145da8",
      "text": "そう、マンガとちょうど逆。これでも酔う人がいて、"
    },
    "p098": {
      "source_hash": "bddbba282e8c",
      "text": "研究者はそれを、視覚誘発性動揺病と呼ぶの。"
    },
    "p099": {
      "source_hash": "6ac0d759ee61",
      "text": "名前長い！"
    },
    "p100": {
      "source_hash": "198628494688",
      "text": "「映像酔い」で覚えて。"
    },
    "p101": {
      "source_hash": "7524bc90c44a",
      "text": "映画館の大画面やVRでも、なる人がいるわ。"
    },
    "p102": {
      "source_hash": "22e35bea5e42",
      "text": "止まってるのに、"
    },
    "p103": {
      "source_hash": "c1d517851e3f",
      "text": "なんで動く感じ？"
    },
    "p104": {
      "source_hash": "374b64d2a9e5",
      "text": "電車あるでしょ？止まってる時、隣の電車が出ると、"
    },
    "p105": {
      "source_hash": "34c99b2e0b95",
      "text": "急に自分のほうが動いた気がする。"
    },
    "p106": {
      "source_hash": "365d6370ff3d",
      "text": "ある！発車したと思った！"
    },
    "p107": {
      "source_hash": "a26790b2f1eb",
      "text": "自分が動いてると感じる錯覚よ。目は一瞬で脳をだますの。"
    },
    "p108": {
      "source_hash": "1dd78294687d",
      "text": "映像酔いは、この錯覚と一緒に起きやすいの。"
    },
    "p109": {
      "source_hash": "2729c3b8e20a",
      "text": "でも錯覚があっても酔うとは限らないし、二つのつながりは研究者もまだ議論中よ。"
    },
    "p110": {
      "source_hash": "651b2fbb3682",
      "text": "じゃあどっちでも、"
    },
    "p111": {
      "source_hash": "2b88e3ff7047",
      "text": "合わないと酔うかも？"
    },
    "p112": {
      "source_hash": "2d0b5bde0369",
      "text": "感覚の食い違いで説明できる"
    },
    "p113": {
      "source_hash": "770ea67c07f9",
      "text": "別の実験で、二人が全く同じ運転ゲームの画面を見る。"
    },
    "p114": {
      "source_hash": "1c9c58c58c6f",
      "text": "一人は自分で遊んで、一人は録画を見るの。"
    },
    "p115": {
      "source_hash": "745442d9d200",
      "text": "自分で、"
    },
    "p116": {
      "source_hash": "2bdd10949861",
      "text": "酔わない？"
    },
    "p117": {
      "source_hash": "13670440dfdb",
      "text": "正解。自分で運転した人ほど、酔ったと言う人が少なかったの。"
    },
    "p118": {
      "source_hash": "9e8feca81b0f",
      "text": "車が画面の中だけでも、操作できると違うのね。"
    },
    "p119": {
      "source_hash": "5dc86c03e8ea",
      "text": "じゃあ車で、"
    },
    "p120": {
      "source_hash": "2ffea27f78e3",
      "text": "画面に前の道を映したら？"
    },
    "p121": {
      "source_hash": "22d023c3ad95",
      "text": "あのイギリスの実験で試したわ。"
    },
    "p122": {
      "source_hash": "eb61405a88b9",
      "text": "前の道を画面に生中継しても、酔いにくくはならなかった。"
    },
    "p123": {
      "source_hash": "6a2a11937545",
      "text": "えっ、効かないの！"
    },
    "p124": {
      "source_hash": "0ba09c6c7455",
      "text": "研究者も、まだ調べが要るって。"
    },
    "p125": {
      "source_hash": "243d1a7e670d",
      "text": "画面のどんなものが酔わせて、どんなものが酔いを防ぐのか。"
    },
    "p126": {
      "source_hash": "474872127de4",
      "text": "これが説明の限界。どこが食い違うかは言えても、"
    },
    "p127": {
      "source_hash": "b1b1b6302c84",
      "text": "誰がどれくらい酔うかは、毎回ぴたりとは言えないの。"
    },
    "p128": {
      "source_hash": "84032b8ca726",
      "text": "なんで同じ車で、"
    },
    "p129": {
      "source_hash": "b2086e69908a",
      "text": "すごく酔う人と、"
    },
    "p130": {
      "source_hash": "65e40b21817d",
      "text": "平気な人がいるの？"
    },
    "p131": {
      "source_hash": "17711739a273",
      "text": "それは研究でもまだ解けきってないの。"
    },
    "p132": {
      "source_hash": "4c3fb44210de",
      "text": "何十年も研究した科学者の見積もりでは、一番酔う人と酔わない人で、"
    },
    "p133": {
      "source_hash": "3cd5675b92a0",
      "text": "酔い方が一万倍も違うの。"
    },
    "p134": {
      "source_hash": "ae7d5d8a2219",
      "text": "一万倍！"
    },
    "p135": {
      "source_hash": "c2f1ba8aa70b",
      "text": "米国の疾病対策センターによると、二歳未満の子はあまり酔わないの。"
    },
    "p136": {
      "source_hash": "5f81612779bd",
      "text": "その後酔いやすくなり、七歳から十二歳が一番で、だんだん減るの。"
    },
    "p137": {
      "source_hash": "0555187becf8",
      "text": "わたし八歳！"
    },
    "p138": {
      "source_hash": "fa2a42b33790",
      "text": "ちょうどその年ね。"
    },
    "p139": {
      "source_hash": "6e1acb846647",
      "text": "双子の研究では、酔いやすさの大きな部分が、遺伝に関係してたの。"
    },
    "p140": {
      "source_hash": "08e99aa0b837",
      "text": "一部は生まれつき？"
    },
    "p141": {
      "source_hash": "9c00826471db",
      "text": "一部はそう。でも何がどう違うのかは、まだわかってないの。"
    },
    "p142": {
      "source_hash": "2fd81eed05c2",
      "text": "あのバスの調査では、年が上で、よく乗る人ほど酔いにくかったの。"
    },
    "p143": {
      "source_hash": "133be0fa6a0c",
      "text": "なんで吐きそうになるの？"
    },
    "p144": {
      "source_hash": "1ff74078247d",
      "text": "正直、まだ誰も知らない。起き方は分かっても、"
    },
    "p145": {
      "source_hash": "773bfe9223e2",
      "text": "体がなぜ吐き気になるかは謎。"
    },
    "p146": {
      "source_hash": "4f5c68d54f96",
      "text": "こんな説も。感覚を狂わせる毒があるから、"
    },
    "p147": {
      "source_hash": "776c63270afe",
      "text": "体は吐いたほうが安心。車酔いはゆれでうっかりスイッチが入ったって。"
    },
    "p148": {
      "source_hash": "c4a1fafdc488",
      "text": "変なもの食べたと思った？"
    },
    "p149": {
      "source_hash": "c30155c2ef5a",
      "text": "これは一つの説だけ。支える証拠もあれば、合わない証拠もあるの。"
    },
    "p150": {
      "source_hash": "b257840a3921",
      "text": "なぜよりによって吐き気か、答えはまだ「わからない」。"
    },
    "p151": {
      "source_hash": "3085a351cf4c",
      "text": "脳の中に、"
    },
    "p152": {
      "source_hash": "fe4da1d8dda7",
      "text": "ケンカ係の場所はある？"
    },
    "p153": {
      "source_hash": "1b67eb3749ef",
      "text": "サルの脳には、誰かに動かされると強く反応する細胞たちがいて、"
    },
    "p154": {
      "source_hash": "7ce2b1b50b1a",
      "text": "自分で動くと静かめ。"
    },
    "p155": {
      "source_hash": "ddf55146a220",
      "text": "研究者は、脳はここで比べて違いを探しているのかも、と考えてる。"
    },
    "p156": {
      "source_hash": "968f6e69605b",
      "text": "でも吐き気につながる仕組みは、まだ見つかってない。"
    },
    "p157": {
      "source_hash": "1c91ffd9a321",
      "text": "じゃあマンガで酔ったのは、"
    },
    "p158": {
      "source_hash": "b0c98e99d1e8",
      "text": "結局なんで？"
    },
    "p159": {
      "source_hash": "df852825be7f",
      "text": "言ってみて。マンガから、あのコップの水まで。"
    },
    "p160": {
      "source_hash": "36d742bcb996",
      "text": "なるほど！"
    },
    "p161": {
      "source_hash": "1b0fe69fdadc",
      "text": "あのコップの水！目と耳の話が違って、"
    },
    "p162": {
      "source_hash": "10fef6ec5cf4",
      "text": "脳が合わなくて、"
    },
    "p163": {
      "source_hash": "55ba535bc589",
      "text": "酔ったんだ！"
    },
    "p164": {
      "source_hash": "cbe2e83044d7",
      "text": "パパは曲がるのを先に知ってて、"
    },
    "p165": {
      "source_hash": "ffd93200f609",
      "text": "だから平気！"
    },
    "p166": {
      "source_hash": "aedb0163ce5d",
      "text": "いいわね。最初に、酔うのはずっと働いてる証拠って言ったの覚えてる？"
    },
    "p167": {
      "source_hash": "e340940230a4",
      "text": "一番おもしろいのは、体がずっと動きを本気で計算してること。"
    },
    "p168": {
      "source_hash": "150fbc471bf1",
      "text": "おばあちゃんちだ！"
    },
    "p169": {
      "source_hash": "5c7c3aeb8f0e",
      "text": "会いに行く！"
    },
    "p170": {
      "source_hash": "49664c13c26b",
      "text": "車や画面で、一番酔うのはいつ？"
    },
    "p171": {
      "source_hash": "fe508e80b52e",
      "text": "コメントしてね"
    },
    "p172": {
      "source_hash": "88de677d4daa",
      "text": "暮らしの「なぜ」を一緒に探すなら、なるほど事務所をチャンネル登録！"
    }
  }
}
