  "lines": {
    "p001": {
      "source_hash": "b1520677110c",
      "text": "Bu, dengar deh!"
    },
    "p002": {
      "source_hash": "5c4beee3def0",
      "text": "Naik mobil ke rumah Nenek,"
    },
    "p003": {
      "source_hash": "6e4dc476716c",
      "text": "sambil baca komik,"
    },
    "p004": {
      "source_hash": "7e650caf1db2",
      "text": "kepalaku pusing, perutku juga aneh."
    },
    "p005": {
      "source_hash": "d798a939e80f",
      "text": "Tapi Ayah yang menyetir,"
    },
    "p006": {
      "source_hash": "a1c0c699cc30",
      "text": "biasa saja!"
    },
    "p007": {
      "source_hash": "5ee1aa552d1b",
      "text": "Mobil sama, jalan sama, cuma kamu?"
    },
    "p008": {
      "source_hash": "7567ca07d2f5",
      "text": "Lebih aneh: mata ditutup, masih mabuk?"
    },
    "p009": {
      "source_hash": "5341e2cf534f",
      "text": "Diam di sofa nonton balapan, mabuk juga?"
    },
    "p010": {
      "source_hash": "c0153c674d15",
      "text": "Kurasa tidak!"
    },
    "p011": {
      "source_hash": "0190ad30208e",
      "text": "Tunggu. Bukan cuma kamu yang mabuk."
    },
    "p012": {
      "source_hash": "ea1c6043b795",
      "text": "Kita cari tahu lewat jalan ke Nenek."
    },
    "p013": {
      "source_hash": "90ca0aa398c1",
      "text": "Kepala, perut,"
    },
    "p014": {
      "source_hash": "c8d6b19858db",
      "text": "kenapa sih?"
    },
    "p015": {
      "source_hash": "27e32fd3ef80",
      "text": "Mabuk,"
    },
    "p016": {
      "source_hash": "998ca2b0cdf2",
      "text": "katanya telinga rusak?"
    },
    "p017": {
      "source_hash": "25756bfb2ddf",
      "text": "Itu telinga dalam. Belum tentu! Peneliti menemukan,"
    },
    "p018": {
      "source_hash": "71e23299cc8a",
      "text": "cuma yang keseimbangan telinganya mati, kebal total."
    },
    "p019": {
      "source_hash": "9e7ad68ab721",
      "text": "Yang sehat, hampir semua bisa mabuk."
    },
    "p020": {
      "source_hash": "9eee7fc6ab3b",
      "text": "Jadi aku mabuk,"
    },
    "p021": {
      "source_hash": "b8f1ea7fe19f",
      "text": "telinga rajin?"
    },
    "p022": {
      "source_hash": "90a7746c2902",
      "text": "Bisa dibilang: mabuk tanda ia terus kerja."
    },
    "p023": {
      "source_hash": "6e3525999ead",
      "text": "Di dalam telinga,"
    },
    "p024": {
      "source_hash": "f328024742e1",
      "text": "sedang apa?"
    },
    "p025": {
      "source_hash": "6f9e9698eae2",
      "text": "Jauh di telingamu ada pipa-pipa dan kantong kecil,"
    },
    "p026": {
      "source_hash": "3dc758a16f0a",
      "text": "ada cairan."
    },
    "p027": {
      "source_hash": "d42e563dc9c9",
      "text": "Pakai air."
    },
    "p028": {
      "source_hash": "be2507c79251",
      "text": "Mobil belok, air miring ke sisi;"
    },
    "p029": {
      "source_hash": "8203904a575c",
      "text": "rem, gas, air ikut goyang."
    },
    "p030": {
      "source_hash": "24200361cd3f",
      "text": "Cairan telinga juga goyang, ada butiran mungil ditarik bumi."
    },
    "p031": {
      "source_hash": "563ed675c89c",
      "text": "Dari situ otak tahu kamu belok, ngegas, atau ngerem."
    },
    "p032": {
      "source_hash": "6100567044eb",
      "text": "Gelas cuma perumpamaan. Aslinya kecil sekali,"
    },
    "p033": {
      "source_hash": "d29d9d2558f9",
      "text": "dan pengatur belokan dan percepatan itu terpisah."
    },
    "p034": {
      "source_hash": "48b6cd8a21a6",
      "text": "Mata?"
    },
    "p035": {
      "source_hash": "0a11a0675b4f",
      "text": "Mata juga lapor ke otak?"
    },
    "p036": {
      "source_hash": "b6de6598e2d4",
      "text": "Ya. Mata lihat benda di luar lewat, lapor kamu bergerak."
    },
    "p037": {
      "source_hash": "083e4c9d2f9c",
      "text": "Telapak kaki, otot juga."
    },
    "p038": {
      "source_hash": "b6d5cb9490e2",
      "text": "Kalau aku jalan?"
    },
    "p039": {
      "source_hash": "ca203f2d583d",
      "text": "Kamu jalan: jalanan tampak mundur, air pun goyang."
    },
    "p040": {
      "source_hash": "e12a871d0929",
      "text": "Semua sama, otak tenang."
    },
    "p041": {
      "source_hash": "8166a5d5f198",
      "text": "Waktu baca komik,"
    },
    "p042": {
      "source_hash": "f9888b0af1b1",
      "text": "siapa bohong?"
    },
    "p043": {
      "source_hash": "f87635bb3768",
      "text": "Tak ada. Lihatnya saja beda."
    },
    "p044": {
      "source_hash": "79dacadf1529",
      "text": "Aku terus lihat komik!"
    },
    "p045": {
      "source_hash": "75a9482742bd",
      "text": "Komik di tangan ikut goyang."
    },
    "p046": {
      "source_hash": "c28f498fd9f7",
      "text": "Mata menatapnya, lapor: diam."
    },
    "p047": {
      "source_hash": "01812e53b9c7",
      "text": "Tapi mobil belok, air di gelas goyang."
    },
    "p048": {
      "source_hash": "3d4edc2ff3a8",
      "text": "Telinga lapor: kita belok."
    },
    "p049": {
      "source_hash": "175d1c25b669",
      "text": "Satu diam,"
    },
    "p050": {
      "source_hash": "2649ca8ccc0e",
      "text": "satu belok!"
    },
    "p051": {
      "source_hash": "286b0a1764ac",
      "text": "Ya, laporannya tak cocok."
    },
    "p052": {
      "source_hash": "ae8e9677670f",
      "text": "Aku merem,"
    },
    "p053": {
      "source_hash": "b969dde7a033",
      "text": "diam,"
    },
    "p054": {
      "source_hash": "8ca7bd7682b0",
      "text": "tak ribut?"
    },
    "p055": {
      "source_hash": "10c53893fa0e",
      "text": "Ingat? Yang matanya ditutup tetap mabuk."
    },
    "p056": {
      "source_hash": "22c11d50bca6",
      "text": "Di Inggris: 30 menit naik mobil di pinggiran,"
    },
    "p057": {
      "source_hash": "5563d968cc9e",
      "text": "mata ditutup atau tak lihat depan, mabuknya hampir sama."
    },
    "p058": {
      "source_hash": "23c7c6e7c512",
      "text": "Merem pun belum tentu otak tenang."
    },
    "p059": {
      "source_hash": "6986bb99120e",
      "text": "Mata sudah merem,"
    },
    "p060": {
      "source_hash": "5196d3c1ea23",
      "text": "ribut siapa?"
    },
    "p061": {
      "source_hash": "53f4a9cb43a4",
      "text": "Itu intinya. Otak tak cuma dengar, ia juga menebak."
    },
    "p062": {
      "source_hash": "ee04a1fdfeb9",
      "text": "Ia membayangkan: begini terus, nanti terasa apa."
    },
    "p063": {
      "source_hash": "fd92f94c2e81",
      "text": "Tak cocok dengan bayangan, badan tak enak."
    },
    "p064": {
      "source_hash": "3ebc1e7cc21c",
      "text": "Namanya konflik indra, penjelasan paling diterima kini."
    },
    "p065": {
      "source_hash": "cb7264e07928",
      "text": "Tapi itu penjelasan, belum semua."
    },
    "p066": {
      "source_hash": "a3aa6943def3",
      "text": "Lihat luar?"
    },
    "p067": {
      "source_hash": "74aaab34f3d4",
      "text": "Bikin lebih enak?"
    },
    "p068": {
      "source_hash": "fafdcc697452",
      "text": "Sudah ditanyakan. Di Inggris, 3.000 lebih penumpang bus wisata,"
    },
    "p069": {
      "source_hash": "e795fa26cf33",
      "text": "yang sama sekali tak lihat depan, yang tak enak badan"
    },
    "p070": {
      "source_hash": "ca791a401ff3",
      "text": "sekitar tiga kali yang lihat jelas."
    },
    "p071": {
      "source_hash": "31a2c93c5b5a",
      "text": "Tiga!"
    },
    "p072": {
      "source_hash": "71f91a52f7fc",
      "text": "Percobaan mobil tadi juga: cuma lihat jendela samping,"
    },
    "p073": {
      "source_hash": "fad68aab08c4",
      "text": "mirip tak lihat depan."
    },
    "p074": {
      "source_hash": "7e9f2dcd2af9",
      "text": "Lihat depan, kurang mabuk."
    },
    "p075": {
      "source_hash": "7fe9c1b21168",
      "text": "Jadi kuncinya depan,"
    },
    "p076": {
      "source_hash": "7f75c461a226",
      "text": "bukan jendela?"
    },
    "p077": {
      "source_hash": "73c5663e696c",
      "text": "Ya. Di percobaan itu, posisi duduk tak beda jelas."
    },
    "p078": {
      "source_hash": "9759e1b7b1ed",
      "text": "Kataku: jalan belok, mata lihat dulu,"
    },
    "p079": {
      "source_hash": "787dd47d1cae",
      "text": "otak tebak air akan goyang."
    },
    "p080": {
      "source_hash": "7499c3da7cae",
      "text": "Di Belanda, penumpang cari benda di layar dalam mobil."
    },
    "p081": {
      "source_hash": "146e090d15bd",
      "text": "Layar setinggi kaca depan, luar tampak: lebih ringan."
    },
    "p082": {
      "source_hash": "895468a19115",
      "text": "Ayah?"
    },
    "p083": {
      "source_hash": "5f1b556d633b",
      "text": "lihat depan,"
    },
    "p084": {
      "source_hash": "19928187b679",
      "text": "jadi tak mabuk?"
    },
    "p085": {
      "source_hash": "6e46aa9a60e5",
      "text": "Itu cuma sebagian. Peneliti sadar sopir jarang mabuk."
    },
    "p086": {
      "source_hash": "54c6f9273ba0",
      "text": "Di Israel, 22 pasang orang naik mesin putar."
    },
    "p087": {
      "source_hash": "0bfb2704917e",
      "text": "Putarannya sama persis, tapi cuma satu yang kendali."
    },
    "p088": {
      "source_hash": "6384d4a421ad",
      "text": "Si pengendali,"
    },
    "p089": {
      "source_hash": "2bdd10949861",
      "text": "kurang?"
    },
    "p090": {
      "source_hash": "dcc4c866d9b1",
      "text": "Ya, rasa tak enaknya jelas lebih sedikit."
    },
    "p091": {
      "source_hash": "98de71fe889a",
      "text": "Kata peneliti: belok sendiri, otak tahu,"
    },
    "p092": {
      "source_hash": "5c93fd895187",
      "text": "air goyang, pas tebakannya."
    },
    "p093": {
      "source_hash": "b338f1878c36",
      "text": "Ada yang pakai suara: kapan, ke mana."
    },
    "p094": {
      "source_hash": "3b8afea6420c",
      "text": "Ada aba-aba, kurang mabuk."
    },
    "p095": {
      "source_hash": "1a2801fde467",
      "text": "Ayah teriak,"
    },
    "p096": {
      "source_hash": "ae988f4a22d3",
      "text": "mau belok?"
    },
    "p097": {
      "source_hash": "71e5bfecfdb0",
      "text": "Mirip. Tapi itu mobil di rel, bukan gunung."
    },
    "p098": {
      "source_hash": "7a314df23f28",
      "text": "Terbalik,"
    },
    "p099": {
      "source_hash": "1ece36879d4a",
      "text": "mata: gerak,"
    },
    "p100": {
      "source_hash": "eefb469d2204",
      "text": "badan: diam?"
    },
    "p101": {
      "source_hash": "1cd814630e8a",
      "text": "Itu dia kasus sofa tadi."
    },
    "p102": {
      "source_hash": "2b4118395067",
      "text": "Main game balap di sofa, jalan terus melesat ke kamu,"
    },
    "p103": {
      "source_hash": "e20d0e7f58d3",
      "text": "mata lapor: kita ngebut!"
    },
    "p104": {
      "source_hash": "45d9502d28a1",
      "text": "Tapi air di meja diam saja,"
    },
    "p105": {
      "source_hash": "8aeae008a9f3",
      "text": "telinga dalam lapor: diam."
    },
    "p106": {
      "source_hash": "fd7296c40d32",
      "text": "Kali ini mata,"
    },
    "p107": {
      "source_hash": "2da00e00ccfe",
      "text": "bilang gerak!"
    },
    "p108": {
      "source_hash": "f28273145da8",
      "text": "Ya, kebalikan komik. Ada juga yang mabuk,"
    },
    "p109": {
      "source_hash": "bddbba282e8c",
      "text": "namanya mabuk gerak akibat penglihatan."
    },
    "p110": {
      "source_hash": "6ac0d759ee61",
      "text": "Panjang amat!"
    },
    "p111": {
      "source_hash": "198628494688",
      "text": "Ingat: mabuk dari mata."
    },
    "p112": {
      "source_hash": "7524bc90c44a",
      "text": "Di bioskop atau main VR, ada yang kena."
    },
    "p113": {
      "source_hash": "22e35bea5e42",
      "text": "Aku kan diam,"
    },
    "p114": {
      "source_hash": "c1d517851e3f",
      "text": "kok rasanya bergerak?"
    },
    "p115": {
      "source_hash": "374b64d2a9e5",
      "text": "Di kereta yang berhenti, kereta sebelah berangkat,"
    },
    "p116": {
      "source_hash": "34c99b2e0b95",
      "text": "rasanya keretamu yang jalan."
    },
    "p117": {
      "source_hash": "365d6370ff3d",
      "text": "Iya! Kukira jalan!"
    },
    "p118": {
      "source_hash": "a26790b2f1eb",
      "text": "Itu ilusi diri bergerak. Sekejap, mata menipu otak."
    },
    "p119": {
      "source_hash": "1dd78294687d",
      "text": "Mabuk dari mata sering bareng ilusi ini."
    },
    "p120": {
      "source_hash": "2729c3b8e20a",
      "text": "Tapi yang kena ilusi belum tentu mabuk; kaitannya masih diperdebatkan."
    },
    "p121": {
      "source_hash": "651b2fbb3682",
      "text": "Jadi sisi mana pun,"
    },
    "p122": {
      "source_hash": "2b88e3ff7047",
      "text": "tak cocok bisa mabuk?"
    },
    "p123": {
      "source_hash": "2d0b5bde0369",
      "text": "Ya, di sini konflik indra cocok."
    },
    "p124": {
      "source_hash": "770ea67c07f9",
      "text": "Lagi: dua orang lihat game menyetir yang sama,"
    },
    "p125": {
      "source_hash": "1c9c58c58c6f",
      "text": "satu main sendiri, satu nonton rekamannya."
    },
    "p126": {
      "source_hash": "745442d9d200",
      "text": "Pemainnya"
    },
    "p127": {
      "source_hash": "2bdd10949861",
      "text": "kurang mabuk?"
    },
    "p128": {
      "source_hash": "13670440dfdb",
      "text": "Betul, yang main lebih jarang mabuk."
    },
    "p129": {
      "source_hash": "9e8feca81b0f",
      "text": "Mobil cuma di layar pun, kendali tetap beda."
    },
    "p130": {
      "source_hash": "5dc86c03e8ea",
      "text": "Di mobil,"
    },
    "p131": {
      "source_hash": "2ffea27f78e3",
      "text": "layar putar jalan depan?"
    },
    "p132": {
      "source_hash": "240eef99e0fc",
      "text": "jadi lihat depan?"
    },
    "p133": {
      "source_hash": "22d023c3ad95",
      "text": "Riset Inggris tadi coba."
    },
    "p134": {
      "source_hash": "eb61405a88b9",
      "text": "Jalan depan disiarkan langsung, mabuknya tak berkurang."
    },
    "p135": {
      "source_hash": "6a2a11937545",
      "text": "Lho, tak mempan!"
    },
    "p136": {
      "source_hash": "0ba09c6c7455",
      "text": "Kata peneliti, perlu diteliti:"
    },
    "p137": {
      "source_hash": "243d1a7e670d",
      "text": "bagian gambar mana yang bikin mabuk, mana yang mencegah."
    },
    "p138": {
      "source_hash": "474872127de4",
      "text": "Ini batasnya: ia tahu mana yang tak cocok,"
    },
    "p139": {
      "source_hash": "b1b1b6302c84",
      "text": "tapi belum pasti, siapa mabuk dan seberapa."
    },
    "p140": {
      "source_hash": "84032b8ca726",
      "text": "Kenapa satu mobil,"
    },
    "p141": {
      "source_hash": "b2086e69908a",
      "text": "ada yang rentan,"
    },
    "p142": {
      "source_hash": "65e40b21817d",
      "text": "ada yang kebal?"
    },
    "p143": {
      "source_hash": "17711739a273",
      "text": "Ini juga belum terpecahkan."
    },
    "p144": {
      "source_hash": "4c3fb44210de",
      "text": "Ahli puluhan tahun menaksir: paling rentan dan paling tahan,"
    },
    "p145": {
      "source_hash": "3cd5675b92a0",
      "text": "bisa beda sepuluh ribu kali."
    },
    "p146": {
      "source_hash": "ae7d5d8a2219",
      "text": "Sepuluh ribu!"
    },
    "p147": {
      "source_hash": "c2f1ba8aa70b",
      "text": "CDC AS: anak di bawah dua tahun biasanya jarang mabuk;"
    },
    "p148": {
      "source_hash": "5f81612779bd",
      "text": "lalu makin mudah, puncaknya 7 sampai 12 tahun, lalu turun."
    },
    "p149": {
      "source_hash": "0555187becf8",
      "text": "Aku delapan!"
    },
    "p150": {
      "source_hash": "acf986830290",
      "text": "pas lagi paling rentan!"
    },
    "p151": {
      "source_hash": "fa2a42b33790",
      "text": "Ya, pas umurnya."
    },
    "p152": {
      "source_hash": "6e1acb846647",
      "text": "Riset kembar: mudah mabuk, banyak dari keturunan."
    },
    "p153": {
      "source_hash": "d33766372e53",
      "text": "Jadi mabuk,"
    },
    "p154": {
      "source_hash": "08e99aa0b837",
      "text": "sebagian bawaan?"
    },
    "p155": {
      "source_hash": "9c00826471db",
      "text": "Sebagian ya. Tapi persis bedanya di mana, belum jelas."
    },
    "p156": {
      "source_hash": "2fd81eed05c2",
      "text": "Survei bus tadi: makin tua dan sering naik, makin jarang mabuk."
    },
    "p157": {
      "source_hash": "e8b2a6b6e861",
      "text": "Tapi kalau tak cocok,"
    },
    "p158": {
      "source_hash": "133be0fa6a0c",
      "text": "kenapa malah mual?"
    },
    "p159": {
      "source_hash": "1ff74078247d",
      "text": "Jujur, belum ada yang tahu. Pemicunya bisa dijelaskan,"
    },
    "p160": {
      "source_hash": "773bfe9223e2",
      "text": "tapi bukan kenapa tubuh memilih mual."
    },
    "p161": {
      "source_hash": "4f5c68d54f96",
      "text": "Satu tebakan: racun bisa mengacaukan indra,"
    },
    "p162": {
      "source_hash": "776c63270afe",
      "text": "tubuh muntah biar aman; mabuk itu salah picu oleh goyangan."
    },
    "p163": {
      "source_hash": "daf948c9652b",
      "text": "Jadi otak kira,"
    },
    "p164": {
      "source_hash": "c4a1fafdc488",
      "text": "aku salah makan?"
    },
    "p165": {
      "source_hash": "c30155c2ef5a",
      "text": "Ini cuma tebakan. Ada bukti yang mendukung, ada yang tak cocok,"
    },
    "p166": {
      "source_hash": "b257840a3921",
      "text": "jadi kenapa harus mual, jawabannya masih: tak tahu."
    },
    "p167": {
      "source_hash": "3085a351cf4c",
      "text": "Di otak,"
    },
    "p168": {
      "source_hash": "fe4da1d8dda7",
      "text": "ada bagian yang bertengkar?"
    },
    "p169": {
      "source_hash": "1b67eb3749ef",
      "text": "Otak monyet punya sel yang heboh saat dibawa gerak;"
    },
    "p170": {
      "source_hash": "7ce2b1b50b1a",
      "text": "gerak sendiri, tenang."
    },
    "p171": {
      "source_hash": "ddf55146a220",
      "text": "Dugaan peneliti: di situ otak membandingkan, cari beda."
    },
    "p172": {
      "source_hash": "968f6e69605b",
      "text": "Tapi bagaimana mereka bikin mual, belum ketemu."
    },
    "p173": {
      "source_hash": "1c91ffd9a321",
      "text": "Jadi aku mabuk baca komik,"
    },
    "p174": {
      "source_hash": "b0c98e99d1e8",
      "text": "sebenarnya kenapa?"
    },
    "p175": {
      "source_hash": "df852825be7f",
      "text": "Coba jelaskan, dari komik sampai gelas air."
    },
    "p176": {
      "source_hash": "36d742bcb996",
      "text": "Oh begitu!"
    },
    "p177": {
      "source_hash": "1b0fe69fdadc",
      "text": "Seperti air itu: mata dan telinga beda,"
    },
    "p178": {
      "source_hash": "10fef6ec5cf4",
      "text": "otak bingung,"
    },
    "p179": {
      "source_hash": "55ba535bc589",
      "text": "aku mabuk!"
    },
    "p180": {
      "source_hash": "cbe2e83044d7",
      "text": "Ayah tahu mau belok,"
    },
    "p181": {
      "source_hash": "ffd93200f609",
      "text": "jadi tak mabuk!"
    },
    "p182": {
      "source_hash": "aedb0163ce5d",
      "text": "Bagus. Ingat kataku tadi, mabuk tanda ia terus bekerja?"
    },
    "p183": {
      "source_hash": "e340940230a4",
      "text": "Serunya: tubuhmu selalu rajin menghitung caramu bergerak."
    },
    "p184": {
      "source_hash": "150fbc471bf1",
      "text": "Rumah Nenek!"
    },
    "p185": {
      "source_hash": "5c7c3aeb8f0e",
      "text": "Cari Nenek!"
    },
    "p186": {
      "source_hash": "49664c13c26b",
      "text": "Kapan paling gampang mabuk?"
    },
    "p187": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar ya!"
    },
    "p188": {
      "source_hash": "88de677d4daa",
      "text": "Cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
