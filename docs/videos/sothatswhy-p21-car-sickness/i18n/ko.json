  },
  "lines": {
    "p001": {
      "source_hash": "5c4beee3def0",
      "text": "할머니 댁 가는 차에서"
    },
    "p002": {
      "source_hash": "6e4dc476716c",
      "text": "만화 보다가"
    },
    "p003": {
      "source_hash": "7e650caf1db2",
      "text": "머리가 핑 돌고 배도 이상했어요."
    },
    "p004": {
      "source_hash": "d798a939e80f",
      "text": "근데 운전한 아빠는"
    },
    "p005": {
      "source_hash": "a1c0c699cc30",
      "text": "멀쩡해요!"
    },
    "p006": {
      "source_hash": "5ee1aa552d1b",
      "text": "같은 차, 같은 길에 너만?"
    },
    "p007": {
      "source_hash": "7567ca07d2f5",
      "text": "더 이상한 거. 눈 가리고 타면 멀미할까?"
    },
    "p008": {
      "source_hash": "5341e2cf534f",
      "text": "소파에 앉아 레이싱 화면만 보면?"
    },
    "p009": {
      "source_hash": "c0153c674d15",
      "text": "다 안 해요!"
    },
    "p010": {
      "source_hash": "0190ad30208e",
      "text": "짐작은 잠깐. 멀미는 너만 하는 게 아냐."
    },
    "p011": {
      "source_hash": "ea1c6043b795",
      "text": "할머니 댁 가는 길로 찾아보자."
    },
    "p012": {
      "source_hash": "90ca0aa398c1",
      "text": "제 머리랑 배,"
    },
    "p013": {
      "source_hash": "c8d6b19858db",
      "text": "왜요?"
    },
    "p014": {
      "source_hash": "27e32fd3ef80",
      "text": "멀미는"
    },
    "p015": {
      "source_hash": "998ca2b0cdf2",
      "text": "귀 속이 안 좋아서래요?"
    },
    "p016": {
      "source_hash": "25756bfb2ddf",
      "text": "그건 속귀야. 꼭 아냐. 멀미 연구자들이 보니,"
    },
    "p017": {
      "source_hash": "71e23299cc8a",
      "text": "속귀 균형 기능이 아예 없는 사람만 전혀 멀미를 안 해."
    },
    "p018": {
      "source_hash": "9e7ad68ab721",
      "text": "속귀가 멀쩡하면 거의 다 멀미할 수 있어."
    },
    "p019": {
      "source_hash": "349e9c3e20b9",
      "text": "그럼 귀가 열심히 일하는 거예요?"
    },
    "p020": {
      "source_hash": "90a7746c2902",
      "text": "그런 셈. 멀미는 귀가 일한단 뜻이야."
    },
    "p021": {
      "source_hash": "f328024742e1",
      "text": "뭘 해요?"
    },
    "p022": {
      "source_hash": "6f9e9698eae2",
      "text": "귀 아주 깊은 곳에 가는 관과 작은 주머니가 있고,"
    },
    "p023": {
      "source_hash": "3dc758a16f0a",
      "text": "액체가 있어."
    },
    "p024": {
      "source_hash": "d42e563dc9c9",
      "text": "물컵으로 보자."
    },
    "p025": {
      "source_hash": "be2507c79251",
      "text": "차가 돌면 컵 물이 쏠리고,"
    },
    "p026": {
      "source_hash": "8203904a575c",
      "text": "서고 출발해도 출렁여."
    },
    "p027": {
      "source_hash": "24200361cd3f",
      "text": "귀 속 액체도 흔들려. 작은 알갱이도 있는데 지구가 아래로 당겨."
    },
    "p028": {
      "source_hash": "563ed675c89c",
      "text": "뇌는 그 흔들림으로 도는지, 빨라지는지, 서는지 알아."
    },
    "p029": {
      "source_hash": "6100567044eb",
      "text": "컵은 비유일 뿐. 진짜 귀 속은 아주아주 작고,"
    },
    "p030": {
      "source_hash": "d29d9d2558f9",
      "text": "도는 걸 느끼는 곳과 빨라지는 걸 느끼는 곳이 달라."
    },
    "p031": {
      "source_hash": "0a11a0675b4f",
      "text": "눈도 뇌한테 알려요?"
    },
    "p032": {
      "source_hash": "b6de6598e2d4",
      "text": "응. 눈은 바깥이 지나가는 걸 보고 움직인다고 알려."
    },
    "p033": {
      "source_hash": "083e4c9d2f9c",
      "text": "발바닥, 근육도 알려."
    },
    "p034": {
      "source_hash": "b6d5cb9490e2",
      "text": "걸을 땐요?"
    },
    "p035": {
      "source_hash": "ca203f2d583d",
      "text": "걸으면 길이 뒤로 가고, 컵 물도 흔들리지."
    },
    "p036": {
      "source_hash": "e12a871d0929",
      "text": "다 같은 말이니 뇌가 안심."
    },
    "p037": {
      "source_hash": "8166a5d5f198",
      "text": "만화 볼 땐"
    },
    "p038": {
      "source_hash": "f9888b0af1b1",
      "text": "누가 거짓말해요?"
    },
    "p039": {
      "source_hash": "f87635bb3768",
      "text": "거짓말은 없어. 본 게 달라."
    },
    "p040": {
      "source_hash": "79dacadf1529",
      "text": "만화만 봤거든요!"
    },
    "p041": {
      "source_hash": "75a9482742bd",
      "text": "만화는 네 손과 같이 흔들려."
    },
    "p042": {
      "source_hash": "c28f498fd9f7",
      "text": "그걸 본 눈은 \"안 움직여\"."
    },
    "p043": {
      "source_hash": "01812e53b9c7",
      "text": "근데 차가 돌면 컵 물이 출렁이지."
    },
    "p044": {
      "source_hash": "3d4edc2ff3a8",
      "text": "속귀는 \"돌고 있어\"."
    },
    "p045": {
      "source_hash": "175d1c25b669",
      "text": "하나는 멈춤,"
    },
    "p046": {
      "source_hash": "2649ca8ccc0e",
      "text": "하나는 회전!"
    },
    "p047": {
      "source_hash": "286b0a1764ac",
      "text": "맞아, 두 보고가 안 맞아."
    },
    "p048": {
      "source_hash": "ae8e9677670f",
      "text": "눈 감으면"
    },
    "p049": {
      "source_hash": "8ca7bd7682b0",
      "text": "안 싸우죠?"
    },
    "p050": {
      "source_hash": "10c53893fa0e",
      "text": "눈 가린 승객도 멀미한다고 한 거 기억나?"
    },
    "p051": {
      "source_hash": "22c11d50bca6",
      "text": "영국 연구에서 승객이 교외를 30분 달렸는데,"
    },
    "p052": {
      "source_hash": "5563d968cc9e",
      "text": "눈 가린 사람과 앞이 안 보인 사람이 거의 똑같이 멀미했어."
    },
    "p053": {
      "source_hash": "23c7c6e7c512",
      "text": "눈 감아도 뇌가 꼭 조용하진 않아."
    },
    "p054": {
      "source_hash": "5196d3c1ea23",
      "text": "누구랑 싸워요?"
    },
    "p055": {
      "source_hash": "53f4a9cb43a4",
      "text": "그게 핵심. 뇌는 보고만 안 듣고 먼저 짐작해."
    },
    "p056": {
      "source_hash": "ee04a1fdfeb9",
      "text": "\"이대로면 곧 이런 느낌이겠지\" 하는 예상이 있어."
    },
    "p057": {
      "source_hash": "fd92f94c2e81",
      "text": "보고가 예상과 안 맞으면 불편해져."
    },
    "p058": {
      "source_hash": "3ebc1e7cc21c",
      "text": "이게 감각 충돌. 멀미 연구에서 가장 인정받는 설명이야."
    },
    "p059": {
      "source_hash": "cb7264e07928",
      "text": "하지만 설명일 뿐, 전부는 아냐."
    },
    "p060": {
      "source_hash": "74aaab34f3d4",
      "text": "창밖 보면 나아요?"
    },
    "p061": {
      "source_hash": "fafdcc697452",
      "text": "진짜 물어봤어. 영국에서 관광버스 승객 3천여 명한테."
    },
    "p062": {
      "source_hash": "e795fa26cf33",
      "text": "앞길이 전혀 안 보인 사람이 불편한 비율은"
    },
    "p063": {
      "source_hash": "ca791a401ff3",
      "text": "잘 보인 사람의 약 세 배."
    },
    "p064": {
      "source_hash": "71f91a52f7fc",
      "text": "눈 가린 승용차 실험에서도, 옆 창문만 보이면"
    },
    "p065": {
      "source_hash": "fad68aab08c4",
      "text": "앞 못 본 거랑 비슷."
    },
    "p066": {
      "source_hash": "7e9f2dcd2af9",
      "text": "앞길이 보여야 덜 멀미해."
    },
    "p067": {
      "source_hash": "7f75c461a226",
      "text": "창문 말고요?"
    },
    "p068": {
      "source_hash": "73c5663e696c",
      "text": "응. 그 실험에선 자리는 뚜렷한 차이가 없었어."
    },
    "p069": {
      "source_hash": "9759e1b7b1ed",
      "text": "내 생각엔, 길이 굽으면 눈이 먼저 보고"
    },
    "p070": {
      "source_hash": "787dd47d1cae",
      "text": "뇌가 컵 물이 흔들릴 걸 알아."
    },
    "p071": {
      "source_hash": "7499c3da7cae",
      "text": "네덜란드에선 차에서 화면으로 뭘 찾는 실험도 했어."
    },
    "p072": {
      "source_hash": "146e090d15bd",
      "text": "화면이 앞 유리만큼 높아 밖이 보이면 낮을 때보다 덜했어."
    },
    "p073": {
      "source_hash": "895468a19115",
      "text": "아빠는?"
    },
    "p074": {
      "source_hash": "19928187b679",
      "text": "멀미 안 해요?"
    },
    "p075": {
      "source_hash": "6e46aa9a60e5",
      "text": "그건 일부야. 운전자가 멀미를 잘 안 하는 것도 알려졌어."
    },
    "p076": {
      "source_hash": "54c6f9273ba0",
      "text": "이스라엘 실험에선 22쌍이 회전 기계에 탔어."
    },
    "p077": {
      "source_hash": "0bfb2704917e",
      "text": "짝끼리 똑같이 돌았는데, 한 명만 조종했어."
    },
    "p078": {
      "source_hash": "6384d4a421ad",
      "text": "조종한 사람이"
    },
    "p079": {
      "source_hash": "2bdd10949861",
      "text": "덜해요?"
    },
    "p080": {
      "source_hash": "dcc4c866d9b1",
      "text": "응, 조종한 쪽이 불편함이 확실히 적었어."
    },
    "p081": {
      "source_hash": "98de71fe889a",
      "text": "연구자들 생각엔, 직접 돌면 뇌가 미리 알아서"
    },
    "p082": {
      "source_hash": "5c93fd895187",
      "text": "컵 물이 흔들려도 짐작과 딱 맞아."
    },
    "p083": {
      "source_hash": "b338f1878c36",
      "text": "언제, 어디로 갈지 소리로 알린 실험도 있어."
    },
    "p084": {
      "source_hash": "3b8afea6420c",
      "text": "알리면 같은 사람도 덜했어."
    },
    "p085": {
      "source_hash": "1a2801fde467",
      "text": "아빠가 먼저"
    },
    "p086": {
      "source_hash": "ae988f4a22d3",
      "text": "\"꺾는다!\"요?"
    },
    "p087": {
      "source_hash": "71e5bfecfdb0",
      "text": "비슷해. 근데 그건 레일 위 차였지, 산길이 아냐."
    },
    "p088": {
      "source_hash": "1ece36879d4a",
      "text": "눈은 움직임,"
    },
    "p089": {
      "source_hash": "eefb469d2204",
      "text": "몸은 가만이면요?"
    },
    "p090": {
      "source_hash": "1cd814630e8a",
      "text": "그게 아까 그 소파 상황이야."
    },
    "p091": {
      "source_hash": "2b4118395067",
      "text": "소파에서 레이싱 게임을 보면 화면 속 길이 막 달려들지."
    },
    "p092": {
      "source_hash": "e20d0e7f58d3",
      "text": "눈은 \"엄청 빨라\"."
    },
    "p093": {
      "source_hash": "45d9502d28a1",
      "text": "근데 탁자 위 물컵은 가만있고,"
    },
    "p094": {
      "source_hash": "8aeae008a9f3",
      "text": "속귀 보고도 \"안 움직여\"."
    },
    "p095": {
      "source_hash": "fd7296c40d32",
      "text": "이번엔 눈이"
    },
    "p096": {
      "source_hash": "2da00e00ccfe",
      "text": "움직인대요!"
    },
    "p097": {
      "source_hash": "f28273145da8",
      "text": "맞아, 만화랑 반대. 이래도 멀미하는 사람이 있어."
    },
    "p098": {
      "source_hash": "bddbba282e8c",
      "text": "연구자들은 시각 유발 멀미라고 해."
    },
    "p099": {
      "source_hash": "6ac0d759ee61",
      "text": "이름 길어요!"
    },
    "p100": {
      "source_hash": "198628494688",
      "text": "\"눈이 만든 멀미\"로 기억해."
    },
    "p101": {
      "source_hash": "7524bc90c44a",
      "text": "영화관 큰 화면, 가상 현실에서도 겪어."
    },
    "p102": {
      "source_hash": "22e35bea5e42",
      "text": "전 가만있는데"
    },
    "p103": {
      "source_hash": "c1d517851e3f",
      "text": "왜 움직이는 느낌이죠?"
    },
    "p104": {
      "source_hash": "374b64d2a9e5",
      "text": "기차 타 봤지? 승강장에서 옆 기차가 떠나면"
    },
    "p105": {
      "source_hash": "34c99b2e0b95",
      "text": "내 기차가 가는 것 같지."
    },
    "p106": {
      "source_hash": "365d6370ff3d",
      "text": "네! 출발한 줄!"
    },
    "p107": {
      "source_hash": "a26790b2f1eb",
      "text": "\"내가 움직인다는 착각\"이야. 눈이 순식간에 뇌를 속인 거지."
    },
    "p108": {
      "source_hash": "1dd78294687d",
      "text": "눈이 만든 멀미는 이 착각과 자주 같이 와."
    },
    "p109": {
      "source_hash": "2729c3b8e20a",
      "text": "그래도 착각한다고 꼭 멀미하진 않아. 둘의 관계는 아직 논쟁 중이야."
    },
    "p110": {
      "source_hash": "651b2fbb3682",
      "text": "그럼 어느 쪽이든"
    },
    "p111": {
      "source_hash": "2b88e3ff7047",
      "text": "안 맞으면 멀미?"
    },
    "p112": {
      "source_hash": "2d0b5bde0369",
      "text": "응, 감각 충돌로 설명되는 부분."
    },
    "p113": {
      "source_hash": "770ea67c07f9",
      "text": "실험 하나 더. 둘이 같은 운전 게임 화면을 보는데,"
    },
    "p114": {
      "source_hash": "1c9c58c58c6f",
      "text": "한 명은 직접 하고, 한 명은 녹화를 봐."
    },
    "p115": {
      "source_hash": "745442d9d200",
      "text": "직접 하면"
    },
    "p116": {
      "source_hash": "2bdd10949861",
      "text": "덜해요?"
    },
    "p117": {
      "source_hash": "13670440dfdb",
      "text": "맞아, 직접 한 쪽이 멀미를 덜 말했어."
    },
    "p118": {
      "source_hash": "9e8feca81b0f",
      "text": "차가 화면 속에만 있어도 조종하면 차이가 나."
    },
    "p119": {
      "source_hash": "5dc86c03e8ea",
      "text": "차에서"
    },
    "p120": {
      "source_hash": "2ffea27f78e3",
      "text": "화면에 앞길을 틀면요?"
    },
    "p121": {
      "source_hash": "22d023c3ad95",
      "text": "그 영국 실험에서 해 봤어."
    },
    "p122": {
      "source_hash": "eb61405a88b9",
      "text": "화면에 앞길을 실시간으로 보여 줘도, 멀미가 줄지 않았어."
    },
    "p123": {
      "source_hash": "6a2a11937545",
      "text": "어, 소용없네요!"
    },
    "p124": {
      "source_hash": "0ba09c6c7455",
      "text": "연구자들도 더 밝혀야 한대."
    },
    "p125": {
      "source_hash": "243d1a7e670d",
      "text": "화면 속 무엇이 멀미를 부르고, 무엇이 막는지."
    },
    "p126": {
      "source_hash": "474872127de4",
      "text": "이게 한계야. 어디가 안 맞는진 말해도,"
    },
    "p127": {
      "source_hash": "b1b1b6302c84",
      "text": "누가 얼마나 멀미할진 매번 정확히 못 맞혀."
    },
    "p128": {
      "source_hash": "84032b8ca726",
      "text": "왜 같은 차에서"
    },
    "p129": {
      "source_hash": "b2086e69908a",
      "text": "누구는 심하고"
    },
    "p130": {
      "source_hash": "65e40b21817d",
      "text": "누구는 멀쩡해요?"
    },
    "p131": {
      "source_hash": "17711739a273",
      "text": "그건 아직 다 못 풀었어."
    },
    "p132": {
      "source_hash": "4c3fb44210de",
      "text": "멀미를 수십 년 연구한 과학자는 가장 심한 사람과 덜한 사람이"
    },
    "p133": {
      "source_hash": "3cd5675b92a0",
      "text": "만 배까지 차이 난대."
    },
    "p134": {
      "source_hash": "ae7d5d8a2219",
      "text": "만 배!"
    },
    "p135": {
      "source_hash": "c2f1ba8aa70b",
      "text": "미국 질병통제예방센터 정리로는 두 살 아래는 보통 잘 안 하고,"
    },
    "p136": {
      "source_hash": "5f81612779bd",
      "text": "점점 늘어 일곱에서 열두 살이 가장 심하고, 다시 줄어."
    },
    "p137": {
      "source_hash": "0555187becf8",
      "text": "저 여덟 살!"
    },
    "p138": {
      "source_hash": "fa2a42b33790",
      "text": "응, 딱 그 나이."
    },
    "p139": {
      "source_hash": "6e1acb846647",
      "text": "쌍둥이 연구에선, 멀미를 얼마나 하는지가 유전과 많이 관련 있었어."
    },
    "p140": {
      "source_hash": "08e99aa0b837",
      "text": "일부 타고나요?"
    },
    "p141": {
      "source_hash": "9c00826471db",
      "text": "일부는. 근데 정확히 뭐가 다른진 아직 몰라."
    },
    "p142": {
      "source_hash": "2fd81eed05c2",
      "text": "그 버스 조사에서도, 나이가 많고 차를 자주 탈수록 덜 멀미했어."
    },
    "p143": {
      "source_hash": "133be0fa6a0c",
      "text": "왜 하필 토할 듯해요?"
    },
    "p144": {
      "source_hash": "1ff74078247d",
      "text": "솔직히 아직 아무도 몰라. 어떻게 생기는진 말해도,"
    },
    "p145": {
      "source_hash": "773bfe9223e2",
      "text": "왜 구역질로 반응하는진 몰라."
    },
    "p146": {
      "source_hash": "4f5c68d54f96",
      "text": "이런 추측도 있어. 어떤 독은 감각을 엉키게 해서"
    },
    "p147": {
      "source_hash": "776c63270afe",
      "text": "토하는 게 안전한데, 멀미는 흔들림이 실수로 그걸 켠 거래."
    },
    "p148": {
      "source_hash": "c4a1fafdc488",
      "text": "제가 잘못 먹은 줄?"
    },
    "p149": {
      "source_hash": "c30155c2ef5a",
      "text": "추측일 뿐이야. 맞는 증거도, 안 맞는 증거도 있어서"
    },
    "p150": {
      "source_hash": "b257840a3921",
      "text": "왜 하필 구역질인지는 여전히 \"모른다\"야."
    },
    "p151": {
      "source_hash": "3085a351cf4c",
      "text": "뇌에"
    },
    "p152": {
      "source_hash": "fe4da1d8dda7",
      "text": "싸움 담당이 있어요?"
    },
    "p153": {
      "source_hash": "1b67eb3749ef",
      "text": "원숭이 뇌엔 남이 움직여 줄 때 크게 반응하는 세포가 있어."
    },
    "p154": {
      "source_hash": "7ce2b1b50b1a",
      "text": "스스로 움직이면 조용하고."
    },
    "p155": {
      "source_hash": "ddf55146a220",
      "text": "연구자들은 뇌가 여기서 비교해 다른 점을 찾는다고 추측해."
    },
    "p156": {
      "source_hash": "968f6e69605b",
      "text": "그게 어떻게 구역질이 되는진 아직 몰라."
    },
    "p157": {
      "source_hash": "1c91ffd9a321",
      "text": "만화 보면 멀미하는 건"
    },
    "p158": {
      "source_hash": "b0c98e99d1e8",
      "text": "대체 왜예요?"
    },
    "p159": {
      "source_hash": "df852825be7f",
      "text": "네가 말해 봐. 만화부터 그 물컵까지."
    },
    "p160": {
      "source_hash": "36d742bcb996",
      "text": "아하!"
    },
    "p161": {
      "source_hash": "1b0fe69fdadc",
      "text": "물컵처럼 눈과 귀가 다르면"
    },
    "p162": {
      "source_hash": "10fef6ec5cf4",
      "text": "뇌가 안 맞아서"
    },
    "p163": {
      "source_hash": "55ba535bc589",
      "text": "멀미 나요!"
    },
    "p164": {
      "source_hash": "cbe2e83044d7",
      "text": "아빠는 꺾을 걸 먼저 아니까"
    },
    "p165": {
      "source_hash": "ffd93200f609",
      "text": "멀미 안 해요!"
    },
    "p166": {
      "source_hash": "aedb0163ce5d",
      "text": "잘했어. 처음에 멀미는 귀가 일한단 뜻이라고 한 거 기억나?"
    },
    "p167": {
      "source_hash": "e340940230a4",
      "text": "제일 재밌는 건, 네 몸이 네 움직임을 늘 열심히 계산한단 거야."
    },
    "p168": {
      "source_hash": "150fbc471bf1",
      "text": "할머니 댁이다!"
    },
    "p169": {
      "source_hash": "5c7c3aeb8f0e",
      "text": "할머니 보러 갈래요!"
    },
    "p170": {
      "source_hash": "49664c13c26b",
      "text": "차나 화면, 언제 제일 멀미 나?"
    },
    "p171": {
      "source_hash": "fe508e80b52e",
      "text": "댓글 줘."
    },
    "p172": {
      "source_hash": "88de677d4daa",
      "text": "생활 속 '왜'를 찾으려면 그래서그랬구나 사무소 구독!"
    }
  }
}
