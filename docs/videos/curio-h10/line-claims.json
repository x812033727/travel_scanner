  "lines": [
    {
      "line_id": "h28b2255",
      "scene_id": "harbor-departure",
      "text": "一八四五年五月，英國格林海斯。兩艘船從碼頭出發，準備尋找穿過北極的航道。",
      "claims": [
        "H10-C01"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h2643cff",
      "scene_id": "supply-return",
      "text": "補給船後來回來了，繼續遠征的一百二十九人，卻沒有再回到英國。",
      "claims": [
        "H10-C02"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h16d9247",
      "scene_id": "tease-note",
      "text": "十四年後，搜索者找到一張被加寫過的紙，開始分辨兩次留下的訊息。",
      "claims": [
        "H10-C08"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hd8ce35d",
      "scene_id": "tease-map",
      "text": "再過十年，一位因紐特人指著海圖，把他知道的沉船位置畫下來。",
      "claims": [
        "H10-C09"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "he5a1f1d",
      "scene_id": "tease-metal",
      "text": "直到二〇一四年，搜索隊又在岸上撿起一塊奇怪的鐵。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h81770de",
      "scene_id": "opening-question",
      "text": "這些相隔很久的動作，能把人帶回那兩艘船嗎？",
      "claims": [
        "H10-E01"
      ],
      "sources": [],
      "kind": "editorial"
    },
    {
      "line_id": "h69b3e42",
      "scene_id": "ships-named",
      "text": "那兩艘船，一艘叫幽冥號，一艘叫恐怖號，由富蘭克林帶隊。",
      "claims": [
        "H10-C01"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3e67f13",
      "scene_id": "starting-count",
      "text": "剛離開英國時，船上合計一百三十四人，還有補給船同行。",
      "claims": [
        "H10-C01"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3017f70",
      "scene_id": "greenland-parting",
      "text": "到了格陵蘭，補給船準備返航，也帶回不再繼續遠征的人。",
      "claims": [
        "H10-C02"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hada9051",
      "scene_id": "remaining-count",
      "text": "開場留下的那支隊伍，就是從這裡繼續往西，尋找西北航道。",
      "claims": [
        "H10-C02"
      ],
      "sources": [
        "H10-S01",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h52abc08",
      "scene_id": "winter-island",
      "text": "第一個冬天，兩船停在比奇島附近。等冰況允許，才又往前走。",
      "claims": [
        "H10-C03"
      ],
      "sources": [
        "H10-S01",
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hd476f23",
      "scene_id": "ice-holds",
      "text": "可是第二年九月，船隊在威廉王島外，被海冰困住了。",
      "claims": [
        "H10-C03"
      ],
      "sources": [
        "H10-S01",
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h159794c",
      "scene_id": "ship-cannot-move",
      "text": "這時候，地圖上還能畫出往前的航線，船卻沒有辦法照那條線開過去。",
      "claims": [
        "H10-C03",
        "H10-E01"
      ],
      "sources": [
        "H10-S01",
        "H10-S02"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h68ff78b",
      "scene_id": "months-pass",
      "text": "直到隔年五月，一支離船行動的小隊，留下了一份狀況報告。",
      "claims": [
        "H10-C03",
        "H10-C04"
      ],
      "sources": [
        "H10-S01",
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h7e65daf",
      "scene_id": "note-form",
      "text": "他們用海軍的制式表單，記下位置和經過的地方，還留下什麼狀況？",
      "claims": [
        "H10-C04"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h1dff7cb",
      "scene_id": "all-well",
      "text": "這一筆寫著：情況良好。日期是一八四七年五月二十八日。",
      "claims": [
        "H10-C04"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h0143711",
      "scene_id": "first-signatures",
      "text": "留下這筆訊息的兩個人，是戈爾和德沃。那時富蘭克林仍在帶隊。",
      "claims": [
        "H10-C04"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h5cac1f4",
      "scene_id": "message-remains",
      "text": "報告停在他們寫字的那一天。以後船上發生什麼，要等後來的補記。",
      "claims": [
        "H10-C04",
        "H10-E01"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "hf598a9d",
      "scene_id": "ice-second-winter",
      "text": "接下來又是一個冬天，船仍然留在冰裡，隊伍的人數卻已經變了。",
      "claims": [
        "H10-C03",
        "H10-C05"
      ],
      "sources": [
        "H10-S01",
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h049dfec",
      "scene_id": "margin-question",
      "text": "等到同一張紙再出現新的字跡，兩艘船的任務，還能繼續嗎？",
      "claims": [
        "H10-C04",
        "H10-C05"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h72b4789",
      "scene_id": "return-to-note",
      "text": "一年後加寫的內容，給出了另一種景況：船隊已經棄船。",
      "claims": [
        "H10-C05"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h851e868",
      "scene_id": "abandon-date",
      "text": "紙條記下的棄船日期，是一八四八年四月二十二日。",
      "claims": [
        "H10-C05"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h323f98d",
      "scene_id": "survivors-count",
      "text": "補記說，一百零五人登岸，接下來由克羅齊帶領。",
      "claims": [
        "H10-C05"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h1d74698",
      "scene_id": "franklin-death",
      "text": "而富蘭克林，早在前一年六月十一日就去世了。",
      "claims": [
        "H10-C06"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h882c0b9",
      "scene_id": "losses-total",
      "text": "紙邊還記下，已經失去九名軍官，以及十五名船員。",
      "claims": [
        "H10-C06"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h421fbee",
      "scene_id": "two-writers",
      "text": "這一次留下名字的，是克羅齊和菲茨詹姆斯。後來的人只能沿著他們的字往下讀。",
      "claims": [
        "H10-C05",
        "H10-C06"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hb624337",
      "scene_id": "plan-written",
      "text": "補記寫在四月二十五日，說他們打算明天，前往巴克河。",
      "claims": [
        "H10-C07"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h8de0bfd",
      "scene_id": "plan-date",
      "text": "所以這個「明天」，是二十六日。紙上記下的是出發計畫。",
      "claims": [
        "H10-C07"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h7ca6f6b",
      "scene_id": "route-limits",
      "text": "紙上記下了計畫，可是他們後來走了多遠，又在哪裡分開？",
      "claims": [
        "H10-C07",
        "H10-E01"
      ],
      "sources": [
        "H10-S02"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "habe3055",
      "scene_id": "search-begins",
      "text": "紙條沒有再往下寫。後來的搜索者進入北極，還得找能接上空白的線索。",
      "claims": [
        "H10-C08"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h1020a89",
      "scene_id": "rae-accounts",
      "text": "一八五四年，探險者約翰雷，從因紐特人那裡聽到南行隊伍的消息。",
      "claims": [
        "H10-C08"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hf9694ad",
      "scene_id": "southward-people",
      "text": "那些口述提到，曾有白人沿岸向南，也有死者被發現。",
      "claims": [
        "H10-C08"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h771e616",
      "scene_id": "oral-and-note",
      "text": "這些消息讓棄船後的搜索有了方向，可是口述之外，還需要更多能對上的東西。",
      "claims": [
        "H10-C08",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "hd7cc62f",
      "scene_id": "paper-found",
      "text": "五年後，搜索者在勝利角附近找到的，就是開場那張加寫過的紙。",
      "claims": [
        "H10-C08"
      ],
      "sources": [
        "H10-S02",
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hfd3d3c2",
      "scene_id": "paper-not-ship",
      "text": "有了這張紙，人們才把船隊的最後階段接起一部分。可船究竟去了哪裡？",
      "claims": [
        "H10-E01"
      ],
      "sources": [],
      "kind": "editorial"
    },
    {
      "line_id": "hef33fec",
      "scene_id": "inuit-knowledge",
      "text": "要找船，搜索者又得向熟悉這片海岸的人問路，追問他們聽過、看過什麼。",
      "claims": [
        "H10-C09",
        "H10-C10"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h2c6f952",
      "scene_id": "hall-meeting",
      "text": "一八六九年，哈爾的調查裡，出現了開場那個指著海圖的人。",
      "claims": [
        "H10-C09"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3a137ee",
      "scene_id": "name-navigator",
      "text": "他叫伊努克普吉朱克。他把沉船的位置指給哈爾看，還另畫了一張圖。",
      "claims": [
        "H10-C09"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "ha4fd3dc",
      "scene_id": "oreilly-location",
      "text": "圖上的位置，靠近奧萊利島。船的線索，從口述變成能拿著找的地理方向。",
      "claims": [
        "H10-C09"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h7290bc7",
      "scene_id": "interpreters",
      "text": "這個過程也靠因紐特翻譯者協助。話能被聽懂，地點才能被記下。",
      "claims": [
        "H10-C09"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hef75ce9",
      "scene_id": "not-exact-point",
      "text": "當時畫的圖，還無法直接變成今天的海底座標，卻保留了往哪裡追問的依據。",
      "claims": [
        "H10-C09",
        "H10-E01"
      ],
      "sources": [
        "H10-S03"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h673bff9",
      "scene_id": "records-preserved",
      "text": "後來有人把這些紀錄重新整理，逐段對照：哪一艘船，出現在哪一片海域。",
      "claims": [
        "H10-C10"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h82e96df",
      "scene_id": "woodman-work",
      "text": "其中，研究者伍德曼在一九九二年出版研究，重新追讀因紐特口述。",
      "claims": [
        "H10-C10"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h2dea45a",
      "scene_id": "local-partnership",
      "text": "地方研究者與嚮導也持續參與，幫搜索隊理解地名、傳聞和現場環境。",
      "claims": [
        "H10-C10"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3369d03",
      "scene_id": "search-uncertainty",
      "text": "一句沉船的描述，怎麼變成下一次海底搜尋的位置？",
      "claims": [
        "H10-C10",
        "H10-E01"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "hc2e7f24",
      "scene_id": "land-and-water",
      "text": "於是搜索不只往水下看，岸上有沒有遠征留下的物件，也成了重要問題。",
      "claims": [
        "H10-C10",
        "H10-C11"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h8be50df",
      "scene_id": "technology-enters",
      "text": "海底的調查，則要讓聲納一次次掃過搜尋區，再檢查值得追的形狀。",
      "claims": [
        "H10-C10",
        "H10-C11"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h69509d0",
      "scene_id": "ice-decisions",
      "text": "但北極的海冰和天氣，也決定當年能把船開到哪裡。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "he8d16a9",
      "scene_id": "south-search",
      "text": "二〇一四年，天候讓更多搜索工作集中到南邊。一個意外，先在岸上出現。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h832761a",
      "scene_id": "metal-recall",
      "text": "還記得開場被撿起來的那塊鐵嗎？九月一日，搜索隊在一座小島上找到它。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hc9c15f2",
      "scene_id": "fork-shape",
      "text": "它的樣子，有點像腳踏車的前叉。但它出現的地方，是北極岸邊。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3630626",
      "scene_id": "ship-fitting",
      "text": "研究人員把它和船圖對照，發現它是船上吊放小艇裝置的一個零件。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h725fbb3",
      "scene_id": "wood-piece",
      "text": "同一帶還找到木製塞件，也是船上的物件。水下搜尋因此調整了位置。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h947eb54",
      "scene_id": "decision-to-scan",
      "text": "岸上的零件指向海裡，可那片水下，真的有船嗎？",
      "claims": [
        "H10-C11",
        "H10-E01"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h852fd2d",
      "scene_id": "next-day",
      "text": "隔天，聲納開始掃描新的區域。沒過多久，螢幕上出現一艘船的輪廓。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3153937",
      "scene_id": "which-ship",
      "text": "可是，只看到船的形狀，還不能立刻說出它的名字。兩艘船都在找。",
      "claims": [
        "H10-C11",
        "H10-E01"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h90ab1e6",
      "scene_id": "robot-inspection",
      "text": "搜索隊讓水下探測器靠近，再安排潛水，查看船體的細節。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h1c226ef",
      "scene_id": "plans-comparison",
      "text": "船的大小、結構和可辨認的部位，要和當年的船圖一一比對。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hbb9c913",
      "scene_id": "erebus-confirmed",
      "text": "這一艘，確認是幽冥號。找了這麼久，終於有一艘能叫出名字。",
      "claims": [
        "H10-C11"
      ],
      "sources": [
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3b4187b",
      "scene_id": "oral-location-payoff",
      "text": "它所在的區域，也接上了那些被保存下來的因紐特見聞。",
      "claims": [
        "H10-C10",
        "H10-C11"
      ],
      "sources": [
        "H10-S03",
        "H10-S04"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h9ce4071",
      "scene_id": "second-ship-question",
      "text": "但海圖上還缺一艘。恐怖號會在附近，還是藏在另一片水裡？",
      "claims": [
        "H10-C11",
        "H10-C12"
      ],
      "sources": [
        "H10-S04",
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h6db9312",
      "scene_id": "new-account",
      "text": "兩年後，搜索船上的一位船員，想起自己幾年前在冰面看到的東西。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h66c7cde",
      "scene_id": "kogvik-memory",
      "text": "他叫薩米科格維克。他說，曾在恐怖灣看過像木頭一樣、伸出冰面的物件。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h7e8bbf3",
      "scene_id": "detour-choice",
      "text": "船上的團隊決定改道，去那片水域查看，沒有照原本的搜索方向一直走。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hdd8be47",
      "scene_id": "foundation-credit",
      "text": "這次出動的是北極研究基金會。九月三日，他們在灣裡找到另一艘沉船。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h1f855c2",
      "scene_id": "upright-hull",
      "text": "聲納顯示，船體正立在海底。接著送下去的探測器，開始往艙內看。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hf83594f",
      "scene_id": "preserved-glass",
      "text": "一些窗戶還留著玻璃，部分艙口是關著的。保存的狀況，比想像中完整。",
      "claims": [
        "H10-C13"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hcc5d7ed",
      "scene_id": "new-question",
      "text": "你看到這樣一艘船，可能會問：裡面的人，是不是曾經把它開到這裡？",
      "claims": [
        "H10-C13",
        "H10-E01"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h83aa802",
      "scene_id": "limit-window",
      "text": "可是窗戶和艙口能告訴我們保存狀況，還不能替船員說出最後的航程。",
      "claims": [
        "H10-C13",
        "H10-E01"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h8533dbb",
      "scene_id": "parks-divers",
      "text": "加拿大公園局接到消息後，安排潛水員到現場確認。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h540a29e",
      "scene_id": "double-wheel",
      "text": "他們檢查雙舵輪、船首包覆的鐵，並和原有船圖比對。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h93d6e3d",
      "scene_id": "terror-confirmed",
      "text": "九月十八日，第二艘船的身分確定了：恐怖號。",
      "claims": [
        "H10-C12"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "he2b2172",
      "scene_id": "no-anchor",
      "text": "恐怖號沒有下錨。它怎麼來到這個海灣，又在什麼時候沉下去，仍待追查。",
      "claims": [
        "H10-C13"
      ],
      "sources": [
        "H10-S05"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h4cb7289",
      "scene_id": "plans-gap",
      "text": "棄船紙條寫過南行的計畫，沉船留下的是最後位置，中間還隔著沒寫完的一段。",
      "claims": [
        "H10-C07",
        "H10-C13",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S05"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h93c7c04",
      "scene_id": "people-question",
      "text": "當兩艘船都能在海圖上標出來，搜索還能往哪裡走？紙條上的人，仍值得繼續找。",
      "claims": [
        "H10-C15",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h2fd7271",
      "scene_id": "signed-person",
      "text": "二〇二四年，一項身分研究，把注意力帶回紙條上的菲茨詹姆斯。",
      "claims": [
        "H10-C15"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "hf310a51",
      "scene_id": "dna-comparison",
      "text": "研究團隊用後代的遺傳資料比對，再結合家譜，確認了遺骸屬於他。",
      "claims": [
        "H10-C15"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h3b3d99c",
      "scene_id": "person-payoff",
      "text": "那位和克羅齊一起留下棄船補記的人，終於接上另一份獨立的證據。",
      "claims": [
        "H10-C15"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced"
    },
    {
      "line_id": "h2a5e43b",
      "scene_id": "identity-scope",
      "text": "知道這份遺骸屬於誰，讓搜索更接近一個具體的人；他的完整遭遇，還要繼續查。",
      "claims": [
        "H10-C15",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "hc9c673f",
      "scene_id": "outro",
      "text": "還記得開場那張加寫過的紙嗎？其中一個簽名，已經能從另一份證據找到人。",
      "claims": [
        "H10-C15",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "he593c8f",
      "scene_id": "outro",
      "text": "哪一條線索最讓你想繼續追？",
      "claims": [
        "H10-C15",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced_with_editorial_bridge"
    },
    {
      "line_id": "h6980aac",
      "scene_id": "outro",
      "text": "訂閱奇聞檔案局，陪我們沿著能核對的紀錄，把怪事查清楚。",
      "claims": [
        "H10-C15",
        "H10-E01"
      ],
      "sources": [
        "H10-S02",
        "H10-S07"
      ],
      "kind": "sourced_with_editorial_bridge"
    }
  ]
}
