  "lines": {
    "ro101": {
      "source_hash": "c4866770425d",
      "text": "1590년 8월 18일, 동틀 무렵."
    },
    "ro102": {
      "source_hash": "7674f5d26d09",
      "text": "지도 제작자, 로어노크섬 귀환."
    },
    "ro103": {
      "source_hash": "2ad0c06eafa9",
      "text": "3년 전 여기 남긴 이들."
    },
    "ro104": {
      "source_hash": "6acef2ddc236",
      "text": "상륙 전 나팔을 불었지만 응답이 없습니다."
    },
    "ro109": {
      "source_hash": "b7d41e204a48",
      "text": "울타리 말뚝에 새겨진 한 단어."
    },
    "ro110": {
      "source_hash": "9b429d0f801a",
      "text": "그 단어는 크로아토안입니다."
    },
    "ro112": {
      "source_hash": "37d1cdb39649",
      "text": "그는 오히려 기뻤다고 썼습니다."
    },
    "ro114": {
      "source_hash": "5672c12d2c17",
      "text": "더 이상한 일이 있습니다."
    },
    "ro115": {
      "source_hash": "2025c600a9c4",
      "text": "1709년, 한 여행자가 해터러스인이 말한 조상을 적었습니다."
    },
    "ro117": {
      "source_hash": "d19b35bffd74",
      "text": "2012년, 지도 제작자의 지도에 붙은 종잇조각 아래엔 무엇이 있었을까요?"
    },
    "ro116": {
      "source_hash": "6bedec56a3d8",
      "text": "2017년, 해터러스섬 출토 반지가 감정을 받습니다."
    },
    "ro118": {
      "source_hash": "20ddbd9a8274",
      "text": "2026년 6월, 한 재단이 무언가를 발표했습니다."
    },
    "ro113": {
      "source_hash": "fd242eb678d6",
      "text": "그 단어는 남겨진 이들을 어디로 데려갔을까요?"
    },
    "ro201": {
      "source_hash": "cc8ed1a435ad",
      "text": "그가 기뻤던 건 직접 정한 약속이었기 때문."
    },
    "ro202": {
      "source_hash": "68da5e2070b3",
      "text": "그의 이름은 존 화이트, 이들의 총독입니다."
    },
    "ro203": {
      "source_hash": "a4a32b38707b",
      "text": "1587년 7월 22일, 아우터뱅크스에 닿았습니다."
    },
    "ro204": {
      "source_hash": "e35f3744c7e3",
      "text": "목적지는 북쪽 체서피크만."
    },
    "ro205": {
      "source_hash": "105d8b3b077e",
      "text": "집과 요새를 지을 곳이었습니다."
    },
    "ro206": {
      "source_hash": "cb1417281228",
      "text": "도선사가 북행을 거부합니다."
    },
    "ro207": {
      "source_hash": "0241bc2753c4",
      "text": "100여 명이 로어노크에 남습니다."
    },
    "ro208": {
      "source_hash": "6266178b16de",
      "text": "명단의 이름은 모두 119명입니다."
    },
    "ro209": {
      "source_hash": "adae3c7f84cc",
      "text": "자료마다 약 100명에서 150명까지 다릅니다."
    },
    "ro210": {
      "source_hash": "ebd77c399839",
      "text": "옛 요새는 헐렸고 빈집엔 멜론이 자라고 안에서 사슴이 먹었습니다."
    },
    "ro211": {
      "source_hash": "4ea13cdead0f",
      "text": "8월 18일, 총독의 외손녀가 태어납니다."
    },
    "ro212": {
      "source_hash": "f493de9eeaa7",
      "text": "상륙한 날이 8월 18일, 기억하십니까?"
    },
    "ro213": {
      "source_hash": "7d5403d48719",
      "text": "빈 섬에 내린 날은 외손녀의 세 살 생일이었습니다."
    },
    "ro214": {
      "source_hash": "a321cec81048",
      "text": "그런데 나흘 뒤, 정착민 전원이 찾아옵니다."
    },
    "ro215": {
      "source_hash": "4fb909b6a500",
      "text": "영국에 가서 보급품을 직접 가져오라고."
    },
    "ro216": {
      "source_hash": "4a9c6414b4e6",
      "text": "처음엔 거절."
    },
    "ro217": {
      "source_hash": "16f28ce0ea21",
      "text": "8월 25일, 연명 증명서를 썼습니다."
    },
    "ro218": {
      "source_hash": "70bf28861454",
      "text": "이틀 뒤 아침, 배에 오릅니다."
    },
    "ro219": {
      "source_hash": "9ca79576ea8e",
      "text": "외손녀는 겨우 생후 9일."
    },
    "ro220": {
      "source_hash": "0611e481206a",
      "text": "떠나며 그들과 신호를 정합니다."
    },
    "ro221": {
      "source_hash": "c9e77ceac930",
      "text": "옮기면 그곳 지명을 새기기로."
    },
    "ro222": {
      "source_hash": "1b28db388e26",
      "text": "위험하면 글자 위에 십자가를 더하기로."
    },
    "ro223": {
      "source_hash": "2b22a1ad89d0",
      "text": "말뚝의 글자 위엔 십자가가 없었습니다."
    },
    "ro224": {
      "source_hash": "d333035a2206",
      "text": "약속상 십자가가 없으면 무사하다는 뜻."
    },
    "ro225": {
      "source_hash": "8e139d1422e8",
      "text": "그는 곧 돌아올 줄 알았습니다."
    },
    "ro301": {
      "source_hash": "5fe882f49100",
      "text": "그 무렵 영국은 전쟁 중이었습니다."
    },
    "ro302": {
      "source_hash": "849c54261cc3",
      "text": "1588년, 스페인 무적함대가 옵니다."
    },
    "ro303": {
      "source_hash": "9466cc1ae29b",
      "text": "여왕은 모든 배에 본국 대기를 명합니다."
    },
    "ro304": {
      "source_hash": "f30582809674",
      "text": "그해 4월 보급선은 프랑스인과 싸워 회항했습니다."
    },
    "ro305": {
      "source_hash": "3bbd8d3ccaa3",
      "text": "보급은 끝내 닿지 못했습니다."
    },
    "ro306": {
      "source_hash": "488c9def6963",
      "text": "재상륙 후 남쪽행을 원합니다."
    },
    "ro307": {
      "source_hash": "615b727ace71",
      "text": "그 지명은 아우터뱅크스 남쪽 섬입니다."
    },
    "ro308": {
      "source_hash": "c96a4c0e2edc",
      "text": "그 섬은 지금의 해터러스섬 일대입니다."
    },
    "ro309": {
      "source_hash": "69861cb1aea8",
      "text": "섬 주민은 크로아토안 사람들."
    },
    "ro310": {
      "source_hash": "a31efb892f50",
      "text": "화이트는 친구라 썼습니다."
    },
    "ro311": {
      "source_hash": "064202f43cfd",
      "text": "상륙한 해 8월, 영국인이 그들을 오인 공격했습니다."
    },
    "ro312": {
      "source_hash": "f9473aa88dd9",
      "text": "왜 가지 않았을까요?"
    },
    "ro313": {
      "source_hash": "c350f9b58139",
      "text": "닻 네 개 중 하나만 남았습니다."
    },
    "ro314": {
      "source_hash": "969f2bdf55bd",
      "text": "날씨가 날마다 나빠졌다고 씁니다."
    },
    "ro315": {
      "source_hash": "f5a649cd5c96",
      "text": "물통은 뭍에 두고 못 실었습니다."
    },
    "ro316": {
      "source_hash": "4950413efdd3",
      "text": "남하해 물을 채우고 월동 후 이듬해 오기로."
    },
    "ro317": {
      "source_hash": "1a0fa83cc38a",
      "text": "8월 28일, 폭풍이 배를 아조레스로 밀어냈습니다."
    },
    "ro318": {
      "source_hash": "2c124b62fa23",
      "text": "그리고 영국으로 돌아갑니다."
    },
    "ro319": {
      "source_hash": "6a4309b65445",
      "text": "그 섬엔 아무도 가지 못했습니다."
    },
    "ro320": {
      "source_hash": "002ea8b72e51",
      "text": "그 뒤 영국인이 그들을 본 기록은 없습니다."
    },
    "ro321": {
      "source_hash": "1102dc41401e",
      "text": "그런데 화이트의 기록엔 모순이 하나 있습니다."
    },
    "ro322": {
      "source_hash": "0a580b13c54f",
      "text": "내륙으로 50마일 옮길 준비를 했다고 그는 씁니다."
    },
    "ro323": {
      "source_hash": "78d8c3242e4f",
      "text": "이 숫자, 다시 나옵니다."
    },
    "ro324": {
      "source_hash": "5fe417031d70",
      "text": "말뚝이 가리킨 건 내륙이 아닙니다."
    },
    "ro401": {
      "source_hash": "2f04e98effce",
      "text": "남쪽 섬 사람들이 훗날 한 이야기."
    },
    "ro402": {
      "source_hash": "d74e9d81ee70",
      "text": "1709년, 그 여행자가 이를 적었습니다."
    },
    "ro403": {
      "source_hash": "cba2a975c56d",
      "text": "해터러스인은 조상 몇 명이 백인이었다고 했습니다."
    },
    "ro404": {
      "source_hash": "1f0efa9473e8",
      "text": "그리고 영국인처럼 책을 향해 말할 수 있었다고."
    },
    "ro405": {
      "source_hash": "2cf6e13acaf9",
      "text": "한참 뒤의 전언이고, 이것 하나뿐입니다."
    },
    "ro406": {
      "source_hash": "ebbf05c8d146",
      "text": "더 끔찍한 설도 있습니다. 내륙 대추장이 죽이라 명했다는 것."
    },
    "ro407": {
      "source_hash": "09bad2c2a88c",
      "text": "이 설을 쓴 사람은 전해 들었습니다."
    },
    "ro408": {
      "source_hash": "75279a2e6c38",
      "text": "오늘 우리가 기억하는 건 다른 말입니다."
    },
    "ro409": {
      "source_hash": "2efd57d459e6",
      "text": "그날 화이트는 나무에 새긴 대문자 셋도 봤습니다."
    },
    "ro410": {
      "source_hash": "adf9f365d251",
      "text": "후에 '나무에 새긴 단어'로 바뀝니다."
    },
    "ro411": {
      "source_hash": "fc3b2f4c116c",
      "text": "누가 먼저 그랬는지 모릅니다."
    },
    "ro412": {
      "source_hash": "88c7b33a99fc",
      "text": "더 이상한 건, 사건 이름도 나중에 생겼다는 것."
    },
    "ro413": {
      "source_hash": "2de3632a2df4",
      "text": "1830년대, 한 책과 잡지 기사가 이렇게 썼습니다."
    },
    "ro414": {
      "source_hash": "4b39615d5cbf",
      "text": "1837년 소설이 이 이름을 처음 쓴 듯."
    },
    "ro415": {
      "source_hash": "7b8294185dfa",
      "text": "잃어버린 식민지."
    },
    "ro416": {
      "source_hash": "9210d0841038",
      "text": "1937년 야외극이 시작됩니다."
    },
    "ro417": {
      "source_hash": "2642d8ad55ed",
      "text": "같은 해, 글자 새긴 첫 돌 등장."
    },
    "ro418": {
      "source_hash": "e75af24c4edb",
      "text": "1940년까지 40여 개가 나왔습니다."
    },
    "ro419": {
      "source_hash": "e18371a2c64b",
      "text": "대부분 훗날 가짜로 판명됩니다."
    },
    "ro420": {
      "source_hash": "a2e8010c194f",
      "text": "첫 돌의 진위는 아무도 모릅니다."
    },
    "ro421": {
      "source_hash": "8e0c8d41caab",
      "text": "그 섬의 흙엔 다른 게 있었습니다."
    },
    "ro501": {
      "source_hash": "7a04c119bf51",
      "text": "1998년, 한 대학이 그 섬의 모래땅을 팠습니다."
    },
    "ro502": {
      "source_hash": "a25330611fc7",
      "text": "반지 출토, 당시엔 금이라 했습니다."
    },
    "ro503": {
      "source_hash": "b0451f13ec3a",
      "text": "같은 해, 다른 곳에선 누군가 나이테를 셉니다."
    },
    "ro504": {
      "source_hash": "44a7b3666362",
      "text": "그 연구는 나이테로 강수량을 봅니다."
    },
    "ro505": {
      "source_hash": "76db1b396f81",
      "text": "1587~1589년이 특히 가물었답니다."
    },
    "ro506": {
      "source_hash": "e43a68dd532f",
      "text": "800년 만의 최악 가뭄이었습니다."
    },
    "ro507": {
      "source_hash": "fab7804fc218",
      "text": "다만 지역 나무를 쟀지, 아우터뱅크스는 아닙니다."
    },
    "ro508": {
      "source_hash": "bbf893afbbb6",
      "text": "논문도 가뭄이 관련됐을 수 있다고만 합니다."
    },
    "ro509": {
      "source_hash": "2173ff9f7a46",
      "text": "하지만 가뭄으론 그 단어를 설명 못 합니다."
    },
    "ro510": {
      "source_hash": "17decfb99e1f",
      "text": "다시 섬을 파게 만든 건 그 반지였습니다."
    },
    "ro511": {
      "source_hash": "2a80e26ef971",
      "text": "2009년, 주민들이 고고학회를 만듭니다."
    },
    "ro512": {
      "source_hash": "c93e1739eb29",
      "text": "후에 영국의 한 대학도 합류했습니다."
    },
    "ro524": {
      "source_hash": "20505a4cd622",
      "text": "다른 팀은 지도 한 장에서 출발."
    },
    "ro601": {
      "source_hash": "dbf208de68ba",
      "text": "2012년 대영박물관에서 화이트 지도를 펼칩니다."
    },
    "ro602": {
      "source_hash": "3a51ebab8237",
      "text": "지도에 붙은 게 그 종잇조각입니다."
    },
    "ro603": {
      "source_hash": "d2875a678709",
      "text": "종잇조각 아래엔 요새 모양의 표시가 있었습니다."
    },
    "ro604": {
      "source_hash": "7b34a77636b2",
      "text": "내륙 50마일, 기억하십니까?"
    },
    "ro605": {
      "source_hash": "c79894a9bb81",
      "text": "종잇조각 아래 표시가 딱 그 거리입니다."
    },
    "ro606": {
      "source_hash": "f511aa617574",
      "text": "위치는 지금의 버티 카운티."
    },
    "ro607": {
      "source_hash": "8d075c2c722f",
      "text": "두 현장에서 유럽인의 물건이 나왔습니다."
    },
    "ro513": {
      "source_hash": "e4f99453219a",
      "text": "2015년 봄, 해터러스섬에서 철 칼자루 일부 출토."
    },
    "ro516": {
      "source_hash": "5dfd4dd2a0e6",
      "text": "2017년, 그 반지가 감정을 받습니다."
    },
    "ro517": {
      "source_hash": "fe3b7c53780d",
      "text": "결과는 전부 황동이었습니다."
    },
    "ro518": {
      "source_hash": "27585055d0bc",
      "text": "함께 나온 유물의 연대는 1670년에서 1720년 사이."
    },
    "ro519": {
      "source_hash": "e8b11611e603",
      "text": "그들보다 한참 뒤입니다."
    },
    "ro520": {
      "source_hash": "9941d462b6be",
      "text": "그곳 유럽 유물은 대개 17세기 중반 것과 섞여 있었습니다."
    },
    "ro521": {
      "source_hash": "c76987cd354d",
      "text": "학계는 정확한 연대 측정이 어렵답니다."
    },
    "ro522": {
      "source_hash": "817343e0ea8f",
      "text": "훗날 교역품일 수도 있습니다."
    },
    "ro608": {
      "source_hash": "17e0cf766af9",
      "text": "2020년 내륙 팀 소속 고고학자가 이렇게 말했습니다."
    },
    "ro609": {
      "source_hash": "68c6f271006e",
      "text": "현장 하나는 일행의 주된 이주지가 아니라고."
    },
    "ro610": {
      "source_hash": "8f34ca7e691f",
      "text": "같은 해, 한 대학 고고학자는 회의적이라고 했습니다."
    },
    "ro514": {
      "source_hash": "934e256ca3fa",
      "text": "2025년 초 해터러스에서 단조 쇳조각 양동이째 출토."
    },
    "ro515": {
      "source_hash": "5935dffd3fa2",
      "text": "지금은 발굴 측의 인터뷰 주장뿐입니다."
    },
    "ro523": {
      "source_hash": "83152717d326",
      "text": "남쪽 갈래는 지금도 결론이 없습니다."
    },
    "ro611": {
      "source_hash": "248248b2e395",
      "text": "그런데 2026년 6월, 내륙 팀의 재단이 말을 바꿨습니다."
    },
    "ro612": {
      "source_hash": "2ef422806689",
      "text": "자기 웹사이트에서 잃어버린 식민지를 찾았다고 발표합니다."
    },
    "ro613": {
      "source_hash": "83e78db82748",
      "text": "발표엔 새 보고서가 없었습니다."
    },
    "ro614": {
      "source_hash": "ba44d40d33d3",
      "text": "제3자 평가도 아직 못 봤습니다."
    },
    "ro615": {
      "source_hash": "4386551d40e6",
      "text": "그들 것으로 확정된 유물은 두 곳 다 없습니다."
    },
    "ro616": {
      "source_hash": "c5441dbc4400",
      "text": "그럼 그들 것이라 확정할 게 있을까요?"
    },
    "ro701": {
      "source_hash": "2ca13abdf559",
      "text": "없습니다."
    },
    "ro702": {
      "source_hash": "7b98d8d59d5a",
      "text": "미국 국립공원관리청은 2025년 설명을 갱신했습니다."
    },
    "ro703": {
      "source_hash": "c2fbec33ce9e",
      "text": "유해도, 무덤도, 집도 그들의 것으로 확정된 건 없습니다."
    },
    "ro704": {
      "source_hash": "1acc2887de2f",
      "text": "크로아토안 합류설은 최고 인기 설 중 하나일 뿐."
    },
    "ro705": {
      "source_hash": "fa99e603ff76",
      "text": "책 한 권을 다 쓴 두 학자는 답이 '모른다'라고 합니다."
    },
    "ro706": {
      "source_hash": "28e9750057e4",
      "text": "제 생각엔 어려운 건 그 단어가 아니라 그 이후입니다."
    },
    "ro707": {
      "source_hash": "42dd6f4d25d2",
      "text": "처음 들은 버전은?"
    },
    "ro708": {
      "source_hash": "adf9a2c6d2b5",
      "text": "이 채널은 기록만 다룹니다. 함께 파일을 열려면 구독하세요."
    }
  }
}
