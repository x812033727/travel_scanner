  "lines": {
    "p001": {
      "source_hash": "35de8739f0cf",
      "text": "Diretora! Fui ao armário,"
    },
    "p002": {
      "source_hash": "aa0fb631417c",
      "text": "e a jaqueta tá gelada!"
    },
    "p003": {
      "source_hash": "ab63b05f6b6f",
      "text": "Ela não é quentinha? Por que tá fria?"
    },
    "p004": {
      "source_hash": "157b9c42b224",
      "text": "Calma. Toca na sua mão. Tá quente, né?"
    },
    "p005": {
      "source_hash": "52bf72c8b1d7",
      "text": "Tá. Mas nem tem tomada,"
    },
    "p006": {
      "source_hash": "6e7f99e7ed0d",
      "text": "Visto e já esquenta. Como?"
    },
    "p007": {
      "source_hash": "95540c857345",
      "text": "De onde vem o calor?"
    },
    "p008": {
      "source_hash": "847355dc2675",
      "text": "Tá mais perto do que você pensa."
    },
    "p009": {
      "source_hash": "efc4423cbfee",
      "text": "Chuta: gelo enrolado na jaqueta"
    },
    "p010": {
      "source_hash": "727d595f57a6",
      "text": "derrete mais rápido ou lento?"
    },
    "p011": {
      "source_hash": "80b6e3f90ea3",
      "text": "E por que a grade de ferro gela mais que o banco de madeira?"
    },
    "p012": {
      "source_hash": "0851bba766b9",
      "text": "E molhada, por que ela para de esquentar?"
    },
    "p013": {
      "source_hash": "7a3b34b7f9e8",
      "text": "Se tá gelada, por que esquenta?"
    },
    "p014": {
      "source_hash": "f7452a734de2",
      "text": "Testa: deixa um termômetro na jaqueta a noite toda."
    },
    "p015": {
      "source_hash": "7c106550f0be",
      "text": "Marca igual ao quarto."
    },
    "p016": {
      "source_hash": "e61e819d9601",
      "text": "Não esquentou nada?"
    },
    "p017": {
      "source_hash": "a719ad7f6a9a",
      "text": "Então é fria como a cadeira?"
    },
    "p018": {
      "source_hash": "a8cab312dafe",
      "text": "Isso. Cadeira, mesa e jaqueta ficam iguais ao quarto."
    },
    "p019": {
      "source_hash": "8142b1ae31c2",
      "text": "Mais frio que a mão: parece gelado."
    },
    "p020": {
      "source_hash": "57f965bd6118",
      "text": "Tem algo quente escondido!"
    },
    "p021": {
      "source_hash": "b937ebaf79e4",
      "text": "Bom palpite. Parece mesmo que aquece."
    },
    "p022": {
      "source_hash": "205a7dd964c8",
      "text": "Mas dentro só tem pluma e tecido."
    },
    "p023": {
      "source_hash": "e2fe7c972444",
      "text": "Se aquecesse, o termômetro teria visto."
    },
    "p024": {
      "source_hash": "fb22c2787266",
      "text": "E cadê o aquecedor?"
    },
    "p025": {
      "source_hash": "7648fa4b4e2d",
      "text": "Você"
    },
    "p026": {
      "source_hash": "a95f28b1870b",
      "text": "Você é o aquecedor."
    },
    "p027": {
      "source_hash": "af0ea9283bc2",
      "text": "Eu? Não tem fogo em mim!"
    },
    "p028": {
      "source_hash": "1aa732a958e2",
      "text": "O corpo usa sua comida."
    },
    "p029": {
      "source_hash": "7348ee7ee798",
      "text": "Comida é lenha no fogo?"
    },
    "p030": {
      "source_hash": "e181305c97b2",
      "text": "Pode ser!"
    },
    "p031": {
      "source_hash": "cc73f6e44abf",
      "text": "Quase toda energia usada vira calor."
    },
    "p032": {
      "source_hash": "f5ad4237e645",
      "text": "Um adulto quieto solta uns 100 watts de calor,"
    },
    "p033": {
      "source_hash": "302020522104",
      "text": "como uma lâmpada antiga."
    },
    "p034": {
      "source_hash": "be2af6309152",
      "text": "Então eu sou uma lâmpada?"
    },
    "p035": {
      "source_hash": "85043d576f26",
      "text": "Criança é menor, solta menos,"
    },
    "p036": {
      "source_hash": "1569e7d5494a",
      "text": "mas solta sempre; dormindo, só solta um pouco menos."
    },
    "p037": {
      "source_hash": "55cf2c030f34",
      "text": "E quando eu tremo de frio?"
    },
    "p038": {
      "source_hash": "2454660ce1f2",
      "text": "O corpo aquece mais."
    },
    "p039": {
      "source_hash": "5eac9b2a5bca",
      "text": "Tremendo, você solta várias vezes mais calor."
    },
    "p040": {
      "source_hash": "c99e8f73420c",
      "text": "Então, ao tremer, pense:"
    },
    "p041": {
      "source_hash": "55d90f088f8e",
      "text": "Aquecedor em hora extra!"
    },
    "p042": {
      "source_hash": "5573a4165213",
      "text": "Mas eu libero calor,"
    },
    "p043": {
      "source_hash": "709f55825d86",
      "text": "por que sinto frio?"
    },
    "p044": {
      "source_hash": "3c547877dcc8",
      "text": "Uma regra:"
    },
    "p045": {
      "source_hash": "3fa22ec1992f",
      "text": "sempre vai do quente pro frio."
    },
    "p046": {
      "source_hash": "5f5f12a4a7e6",
      "text": "Caneca de chocolate quente: o calor vai pra mão."
    },
    "p047": {
      "source_hash": "e081f5d3b3d6",
      "text": "Gelo na mão: a mão gela, o gelo derrete."
    },
    "p048": {
      "source_hash": "4c690a4ca22c",
      "text": "O gelo passa frio pra mim?"
    },
    "p049": {
      "source_hash": "b64a3a9267b3",
      "text": "Ao contrário: seu calor vai pro gelo."
    },
    "p050": {
      "source_hash": "a9237fb2d744",
      "text": "O frio não viaja; o calor sim."
    },
    "p051": {
      "source_hash": "1ecad2f684d2",
      "text": "E o calor não volta?"
    },
    "p052": {
      "source_hash": "136f689a8e37",
      "text": "Sozinho, não. Gelo nunca esquenta sua mão."
    },
    "p053": {
      "source_hash": "1706f52d5f3a",
      "text": "No inverno, descalço, o calor vai do pé pro piso."
    },
    "p054": {
      "source_hash": "ab20a8c70a70",
      "text": "Tapete é de boa,"
    },
    "p055": {
      "source_hash": "91af39340c7d",
      "text": "por que o piso gela?"
    },
    "p056": {
      "source_hash": "b2c85a94f7ba",
      "text": "Guarda essa pro parque."
    },
    "p057": {
      "source_hash": "74bef4111a6f",
      "text": "Então frio é o calor fugindo?"
    },
    "p058": {
      "source_hash": "66ecf0c39b30",
      "text": "Isso. Roupa só atrasa o calor."
    },
    "p059": {
      "source_hash": "42f5d6bcb041",
      "text": "A grade do parque gela!"
    },
    "p060": {
      "source_hash": "16aaaa9648a2",
      "text": "O banco de madeira não."
    },
    "p061": {
      "source_hash": "7f0f9f88eecb",
      "text": "Ferro é mais frio, né?"
    },
    "p062": {
      "source_hash": "d92fbb5391fc",
      "text": "Parece. Mas os dois passaram a noite lá,"
    },
    "p063": {
      "source_hash": "35eecfd8a063",
      "text": "então estão quase iguais."
    },
    "p064": {
      "source_hash": "3fb7ecffe709",
      "text": "Impossível! Parece tão diferente!"
    },
    "p065": {
      "source_hash": "09d37551688b",
      "text": "A mão engana."
    },
    "p066": {
      "source_hash": "6d964de5136f",
      "text": "Ela sente quão rápido o calor sai dela."
    },
    "p067": {
      "source_hash": "fa9850017215",
      "text": "Ferro tira seu calor rápido; madeira, devagar."
    },
    "p068": {
      "source_hash": "4ffcd1cc1d4e",
      "text": "Aço conduz centenas de vezes mais."
    },
    "p069": {
      "source_hash": "6534528b939b",
      "text": "Tapete e piso também: o piso tira o calor do pé mais rápido."
    },
    "p070": {
      "source_hash": "d092ea1aa0ed",
      "text": "O zíper da jaqueta gela mais!"
    },
    "p071": {
      "source_hash": "37094005b023",
      "text": "Segura um pouco e ele esquenta: seu calor entrou."
    },
    "p072": {
      "source_hash": "83012a95b622",
      "text": "Ao tocar algo gelado, pense:"
    },
    "p073": {
      "source_hash": "3882a546dd5e",
      "text": "É mais frio, ou só tira calor rápido?"
    },
    "p074": {
      "source_hash": "a3664ce836a5",
      "text": "E o que segura calor?"
    },
    "p075": {
      "source_hash": "f04c652f3257",
      "text": "Vai te surpreender: o que melhor segura calor é o ar."
    },
    "p076": {
      "source_hash": "a7eaceaa5f8b",
      "text": "Ar? A gente vive mergulhado no ar!"
    },
    "p077": {
      "source_hash": "426180b84633",
      "text": "Ar parado conduz pouco."
    },
    "p078": {
      "source_hash": "48dfd857e8e5",
      "text": "O chato é que o ar não fica parado."
    },
    "p079": {
      "source_hash": "fec59c89a3ec",
      "text": "E por que mexe?"
    },
    "p080": {
      "source_hash": "d360230f8600",
      "text": "O ar em você esquenta e sobe,"
    },
    "p081": {
      "source_hash": "01dc1a352206",
      "text": "vem ar frio, e o calor vai embora."
    },
    "p082": {
      "source_hash": "f4feca1b00e8",
      "text": "Por que o ar quente sobe?"
    },
    "p083": {
      "source_hash": "74e5c9b933ff",
      "text": "É mais leve que o ar frio; sobe."
    },
    "p084": {
      "source_hash": "47d4fdc0380d",
      "text": "Mesmo parado, o calor vai embora."
    },
    "p085": {
      "source_hash": "f0d9e81a2833",
      "text": "Então a pluma é que é quente?"
    },
    "p086": {
      "source_hash": "8acb9a972d7d",
      "text": "Um monte de pluma conduz quase como ar."
    },
    "p087": {
      "source_hash": "1d08d6284b03",
      "text": "Na lupa, uma pluma"
    },
    "p088": {
      "source_hash": "433d5f4415a1",
      "text": "parece fios bem finos, abertos pra todo lado."
    },
    "p089": {
      "source_hash": "441ea9e55a1a",
      "text": "Juntas, elas formam muitos espacinhos."
    },
    "p090": {
      "source_hash": "13b518f8ae73",
      "text": "O ar fica preso lá e não sobe."
    },
    "p091": {
      "source_hash": "c01e5bb26492",
      "text": "E se eu vestir só ar?"
    },
    "p092": {
      "source_hash": "a11df8a2b3c9",
      "text": "Muito ar junto gira e leva o calor."
    },
    "p093": {
      "source_hash": "a579a3db563a",
      "text": "Em espacinhos pequenos, não gira."
    },
    "p094": {
      "source_hash": "61aecc15b0bb",
      "text": "Muitos quartinhos!"
    },
    "p095": {
      "source_hash": "375d1e0837af",
      "text": "A jaqueta? Roupa cheia de ar!"
    },
    "p096": {
      "source_hash": "acbf70fe3323",
      "text": "O truque genial:"
    },
    "p097": {
      "source_hash": "9c6346ac083c",
      "text": "o principal é o ar, que sai de graça."
    },
    "p098": {
      "source_hash": "45db75910d86",
      "text": "Suéter e cobertor fazem igual: prendem ar."
    },
    "p099": {
      "source_hash": "125818ed014b",
      "text": "E o pelo do gato?"
    },
    "p100": {
      "source_hash": "177e1a6868af",
      "text": "Sim, pelo de bicho também prende ar."
    },
    "p101": {
      "source_hash": "c061fbfb96dc",
      "text": "E se eu amassar a jaqueta?"
    },
    "p102": {
      "source_hash": "17bbe2fa8314",
      "text": "Abraça forte e ela fica amassada."
    },
    "p103": {
      "source_hash": "609c04b42f24",
      "text": "Amassou? Guarda menos ar,"
    },
    "p104": {
      "source_hash": "63ca856f068a",
      "text": "aquece menos."
    },
    "p105": {
      "source_hash": "43c5f2da3cb9",
      "text": "E se eu sentar nela?"
    },
    "p106": {
      "source_hash": "44e94d9b8b43",
      "text": "Aí, embaixo do bumbum, amassa mais."
    },
    "p107": {
      "source_hash": "757d0dc31000",
      "text": "Mais pesada e grossa é mais quente?"
    },
    "p108": {
      "source_hash": "b078e7627dbc",
      "text": "O peso? Não."
    },
    "p109": {
      "source_hash": "7e920f1a41cf",
      "text": "Importa quanto ar parado fica dentro."
    },
    "p110": {
      "source_hash": "553ff7d6463d",
      "text": "E se molhar na chuva?"
    },
    "p111": {
      "source_hash": "193362afeb1d",
      "text": "A água entra nos espaços"
    },
    "p112": {
      "source_hash": "f31121f9898b",
      "text": "e expulsa o ar."
    },
    "p113": {
      "source_hash": "78409d429303",
      "text": "Água conduz umas 20 e tantas vezes mais."
    },
    "p114": {
      "source_hash": "57db783667b7",
      "text": "Roupa molhada perde calor rápido e aquece menos."
    },
    "p115": {
      "source_hash": "5f2fd48bddc2",
      "text": "A pluma molhada murcha e achata."
    },
    "p116": {
      "source_hash": "65530c8b3c7c",
      "text": "Lembra da chuva de inverno?"
    },
    "p117": {
      "source_hash": "07e23daf4601",
      "text": "Cabelo molhado dá frio!"
    },
    "p118": {
      "source_hash": "00e1d99cf9bc",
      "text": "Isso. Água secando ainda leva mais calor de você."
    },
    "p119": {
      "source_hash": "c68dae08ad9e",
      "text": "Com vento, por que é tão frio?"
    },
    "p120": {
      "source_hash": "932d1e33ed39",
      "text": "Lembra do ar que sobe?"
    },
    "p121": {
      "source_hash": "7240263f3c67",
      "text": "O vento leva ele antes,"
    },
    "p122": {
      "source_hash": "6d4f135c143d",
      "text": "o ar frio troca e o calor some."
    },
    "p123": {
      "source_hash": "c84a1c745ab5",
      "text": "O vento tira calor bem mais rápido que o toque."
    },
    "p124": {
      "source_hash": "daf303e13ab9",
      "text": "É a sensação térmica: com vento, parece mais frio."
    },
    "p125": {
      "source_hash": "b04124a7e23d",
      "text": "Ela vale pra pele de fora: rosto, orelhas, mãos."
    },
    "p126": {
      "source_hash": "3b18dad59c1a",
      "text": "Por isso dói a orelha!"
    },
    "p127": {
      "source_hash": "c3580bda83e3",
      "text": "O tecido de fora deve parar o vento"
    },
    "p128": {
      "source_hash": "56813a0a3f66",
      "text": "e a chuva também."
    },
    "p129": {
      "source_hash": "04eca901b9d7",
      "text": "Tipo um muro!"
    },
    "p130": {
      "source_hash": "47b158efd98a",
      "text": "E se abrir o zíper?"
    },
    "p131": {
      "source_hash": "f6215b3c5927",
      "text": "O vento entra e leva seu ar quente."
    },
    "p132": {
      "source_hash": "116584699d28",
      "text": "Já sentiu isso, né?"
    },
    "p133": {
      "source_hash": "93c597f64edd",
      "text": "E a garrafa térmica?"
    },
    "p134": {
      "source_hash": "eb3448326e82",
      "text": "Sem tomada, mantém gelado?"
    },
    "p135": {
      "source_hash": "a73d7ba6e236",
      "text": "Ela e a jaqueta fazem o mesmo."
    },
    "p136": {
      "source_hash": "cde1c6cf47a3",
      "text": "Não aquece nem esfria; o calor só não passa fácil."
    },
    "p137": {
      "source_hash": "adf47262605d",
      "text": "Duas paredes, com quase todo o ar tirado do meio."
    },
    "p138": {
      "source_hash": "83fdceec5e09",
      "text": "A jaqueta prende ar,"
    },
    "p139": {
      "source_hash": "fa02a823d460",
      "text": "e ela não quer ar?"
    },
    "p140": {
      "source_hash": "904df071dde0",
      "text": "Isso. Ar parado ainda passa calor devagar;"
    },
    "p141": {
      "source_hash": "54e503bc79d5",
      "text": "na térmica quase não há nada pra passar."
    },
    "p142": {
      "source_hash": "6bdd9d531312",
      "text": "Então é uma jaqueta turbo?"
    },
    "p143": {
      "source_hash": "7dd1cf0d61ce",
      "text": "É, mas não dá pra vestir."
    },
    "p144": {
      "source_hash": "8477ed9420d9",
      "text": "O gargalo é meu zíper aberto?"
    },
    "p145": {
      "source_hash": "da78060ddde1",
      "text": "Isso. Lá não tem vácuo, e muito calor escapa."
    },
    "p146": {
      "source_hash": "7e7b98610704",
      "text": "Então mantém sopa quente e água gelada!"
    },
    "p147": {
      "source_hash": "9eb3cdbc02db",
      "text": "Isso. Lembra da regra? Aonde o calor for, ela barra."
    },
    "p148": {
      "source_hash": "1c5997a13815",
      "text": "E jaqueta no verão?"
    },
    "p149": {
      "source_hash": "ed05c8b5c227",
      "text": "Segura igual."
    },
    "p150": {
      "source_hash": "49a2df7dd130",
      "text": "No verão você não quer: dá calorão!"
    },
    "p151": {
      "source_hash": "8820d86fc27b",
      "text": "E aquele gelo na jaqueta?"
    },
    "p152": {
      "source_hash": "5d18be9d1c6a",
      "text": "Tão quentinha, derrete antes, né?"
    },
    "p153": {
      "source_hash": "a1ef9b2c8a77",
      "text": "Muitos acham. Mas não tem aquecedor,"
    },
    "p154": {
      "source_hash": "526f8ee3a8ff",
      "text": "Lembra do termômetro? Ela não esquentou nada."
    },
    "p155": {
      "source_hash": "c4ea3890723e",
      "text": "Muitas escolas testam: um embrulhado e um não."
    },
    "p156": {
      "source_hash": "e6d5fbcd3fed",
      "text": "O embrulhado demora mais."
    },
    "p157": {
      "source_hash": "3802a77774ea",
      "text": "Embrulhado demora mais?!"
    },
    "p158": {
      "source_hash": "13692b95dc05",
      "text": "Já sei!"
    },
    "p159": {
      "source_hash": "79fd252eaccd",
      "text": "Esquenta porque segura meu calor!"
    },
    "p160": {
      "source_hash": "11dbf3acb18a",
      "text": "Vestiu? Espera,"
    },
    "p161": {
      "source_hash": "9b5564f3ea2e",
      "text": "é seu calor enchendo a jaqueta."
    },
    "p162": {
      "source_hash": "36d742bcb996",
      "text": "Entendi!"
    },
    "p163": {
      "source_hash": "f5739c6c8197",
      "text": "Sorvete na jaqueta derrete rápido ou lento?"
    },
    "p164": {
      "source_hash": "fe3432226366",
      "text": "Deixe sua resposta!"
    },
    "p165": {
      "source_hash": "88de677d4daa",
      "text": "Siga o Escritório do Ah, É Por Isso e ache os porquês!"
    }
  }
}
