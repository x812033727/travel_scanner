  "lines": {
    "p001": {
      "source_hash": "35de8739f0cf",
      "text": "Bu! Aku buka lemari,"
    },
    "p002": {
      "source_hash": "aa0fb631417c",
      "text": "jaketnya dingin banget!"
    },
    "p003": {
      "source_hash": "ab63b05f6b6f",
      "text": "Bukannya jaket itu hangat? Kok dingin?"
    },
    "p004": {
      "source_hash": "157b9c42b224",
      "text": "Tenang dulu. Pegang tanganmu, hangat, kan?"
    },
    "p005": {
      "source_hash": "52bf72c8b1d7",
      "text": "Iya. Tapi tak pakai listrik,"
    },
    "p006": {
      "source_hash": "6e7f99e7ed0d",
      "text": "kok sebentar langsung hangat?"
    },
    "p007": {
      "source_hash": "95540c857345",
      "text": "Panasnya dari mana?"
    },
    "p008": {
      "source_hash": "847355dc2675",
      "text": "Jawabannya lebih dekat dari dugaanmu."
    },
    "p009": {
      "source_hash": "efc4423cbfee",
      "text": "Tebak dulu: es batu dibungkus jaket,"
    },
    "p010": {
      "source_hash": "727d595f57a6",
      "text": "lelehnya lebih cepat atau lambat?"
    },
    "p011": {
      "source_hash": "80b6e3f90ea3",
      "text": "Lalu, kenapa pagar besi taman terasa lebih dingin dari bangku kayu?"
    },
    "p012": {
      "source_hash": "0851bba766b9",
      "text": "Dan kenapa jaket yang basah langsung tak hangat?"
    },
    "p013": {
      "source_hash": "7a3b34b7f9e8",
      "text": "Jaketnya dingin, kok jadi hangat?"
    },
    "p014": {
      "source_hash": "f7452a734de2",
      "text": "Coba deh: taruh termometer di dalam jaket semalaman."
    },
    "p015": {
      "source_hash": "7c106550f0be",
      "text": "Pagi, suhunya sama kamar."
    },
    "p016": {
      "source_hash": "e61e819d9601",
      "text": "Tidak lebih hangat?"
    },
    "p017": {
      "source_hash": "a719ad7f6a9a",
      "text": "Jadi dinginnya sama kayak kursi?"
    },
    "p018": {
      "source_hash": "a8cab312dafe",
      "text": "Ya. Kursi, meja, jaket ini, lama-lama sama dengan kamar."
    },
    "p019": {
      "source_hash": "8142b1ae31c2",
      "text": "Kamarnya lebih dingin dari tanganmu."
    },
    "p020": {
      "source_hash": "57f965bd6118",
      "text": "Pasti ada pemanas di dalamnya!"
    },
    "p021": {
      "source_hash": "b937ebaf79e4",
      "text": "Wajar, rasanya memang seperti memanas."
    },
    "p022": {
      "source_hash": "205a7dd964c8",
      "text": "Tapi isinya cuma bulu angsa dan kain."
    },
    "p023": {
      "source_hash": "e2fe7c972444",
      "text": "Kalau ia pemanas, termometernya pasti naik."
    },
    "p024": {
      "source_hash": "fb22c2787266",
      "text": "Mana pemanasnya?"
    },
    "p025": {
      "source_hash": "7648fa4b4e2d",
      "text": "Kamu."
    },
    "p026": {
      "source_hash": "a95f28b1870b",
      "text": "Kamulah pemanasnya."
    },
    "p027": {
      "source_hash": "af0ea9283bc2",
      "text": "Aku? Tapi tak ada api di badanku."
    },
    "p028": {
      "source_hash": "1aa732a958e2",
      "text": "Tubuh memakai makananmu."
    },
    "p029": {
      "source_hash": "7348ee7ee798",
      "text": "Makan itu menambah kayu bakar?"
    },
    "p030": {
      "source_hash": "e181305c97b2",
      "text": "Kira-kira."
    },
    "p031": {
      "source_hash": "cc73f6e44abf",
      "text": "Energinya sebagian besar jadi panas."
    },
    "p032": {
      "source_hash": "f5ad4237e645",
      "text": "Orang dewasa duduk diam melepas sekitar 100 watt,"
    },
    "p033": {
      "source_hash": "302020522104",
      "text": "seperti bohlam model lama."
    },
    "p034": {
      "source_hash": "be2af6309152",
      "text": "Jadi aku juga bohlam?"
    },
    "p035": {
      "source_hash": "85043d576f26",
      "text": "Anak melepas lebih sedikit,"
    },
    "p036": {
      "source_hash": "1569e7d5494a",
      "text": "tapi terus melepas; saat tidur pun hanya sedikit berkurang."
    },
    "p037": {
      "source_hash": "55cf2c030f34",
      "text": "Kalau aku menggigil kedinginan?"
    },
    "p038": {
      "source_hash": "2454660ce1f2",
      "text": "Tubuh jadi lebih panas."
    },
    "p039": {
      "source_hash": "5eac9b2a5bca",
      "text": "Menggigil bisa melepas panas beberapa kali lipat."
    },
    "p040": {
      "source_hash": "c99e8f73420c",
      "text": "Jadi kalau menggigil, bilang:"
    },
    "p041": {
      "source_hash": "55d90f088f8e",
      "text": "Pemanasku sedang lembur!"
    },
    "p042": {
      "source_hash": "5573a4165213",
      "text": "Panasku keluar terus,"
    },
    "p043": {
      "source_hash": "709f55825d86",
      "text": "kok masih kedinginan?"
    },
    "p044": {
      "source_hash": "3c547877dcc8",
      "text": "Sifat panas:"
    },
    "p045": {
      "source_hash": "3fa22ec1992f",
      "text": "selalu dari yang panas ke yang dingin."
    },
    "p046": {
      "source_hash": "5f5f12a4a7e6",
      "text": "Saat memegang cokelat panas, panas masuk ke tanganmu."
    },
    "p047": {
      "source_hash": "e081f5d3b3d6",
      "text": "Pegang es, tangan jadi dingin, esnya meleleh."
    },
    "p048": {
      "source_hash": "4c690a4ca22c",
      "text": "Esnya mengirim dingin ke aku?"
    },
    "p049": {
      "source_hash": "b64a3a9267b3",
      "text": "Terbalik: panas tanganmu yang masuk ke es."
    },
    "p050": {
      "source_hash": "a9237fb2d744",
      "text": "Yang pindah itu panas, bukan dingin."
    },
    "p051": {
      "source_hash": "1ecad2f684d2",
      "text": "Panas tak bisa balik arah?"
    },
    "p052": {
      "source_hash": "136f689a8e37",
      "text": "Es tak bikin tanganmu hangat."
    },
    "p053": {
      "source_hash": "1706f52d5f3a",
      "text": "Kaki telanjang di keramik: panas kaki pindah ke lantai."
    },
    "p054": {
      "source_hash": "ab20a8c70a70",
      "text": "Di karpet aman,"
    },
    "p055": {
      "source_hash": "91af39340c7d",
      "text": "kok keramik dingin?"
    },
    "p056": {
      "source_hash": "b2c85a94f7ba",
      "text": "Nanti di taman terjawab."
    },
    "p057": {
      "source_hash": "74bef4111a6f",
      "text": "Jadi dingin itu panas yang terus kabur?"
    },
    "p058": {
      "source_hash": "66ecf0c39b30",
      "text": "Ya. Baju cuma memperlambat panas kabur."
    },
    "p059": {
      "source_hash": "42f5d6bcb041",
      "text": "Pagar besinya dingin banget!"
    },
    "p060": {
      "source_hash": "16aaaa9648a2",
      "text": "Bangku kayunya biasa saja."
    },
    "p061": {
      "source_hash": "7f0f9f88eecb",
      "text": "Besi lebih dingin, kan?"
    },
    "p062": {
      "source_hash": "d92fbb5391fc",
      "text": "Kedengarannya benar. Tapi semalaman mereka di sana,"
    },
    "p063": {
      "source_hash": "35eecfd8a063",
      "text": "jadi dinginnya hampir sama."
    },
    "p064": {
      "source_hash": "3fb7ecffe709",
      "text": "Masa? Rasanya beda jauh!"
    },
    "p065": {
      "source_hash": "09d37551688b",
      "text": "Tangan menipu."
    },
    "p066": {
      "source_hash": "6d964de5136f",
      "text": "Ia merasakan secepat apa panas kabur."
    },
    "p067": {
      "source_hash": "fa9850017215",
      "text": "Besi membawa panas tanganmu dengan cepat, kayu lambat."
    },
    "p068": {
      "source_hash": "4ffcd1cc1d4e",
      "text": "Baja ratusan kali lebih cepat dari kayu."
    },
    "p069": {
      "source_hash": "6534528b939b",
      "text": "Karpet dan keramik sama: keramik lebih cepat membawa panas kaki."
    },
    "p070": {
      "source_hash": "d092ea1aa0ed",
      "text": "Ritsletingnya juga lebih dingin!"
    },
    "p071": {
      "source_hash": "37094005b023",
      "text": "Pegang sebentar, sudah tak dingin: panasmu masuk."
    },
    "p072": {
      "source_hash": "83012a95b622",
      "text": "Kalau pegang yang dingin, pikir:"
    },
    "p073": {
      "source_hash": "3882a546dd5e",
      "text": "Memang lebih dingin, atau pandai membawa panas?"
    },
    "p074": {
      "source_hash": "a3664ce836a5",
      "text": "Penahan panas terbaik?"
    },
    "p075": {
      "source_hash": "f04c652f3257",
      "text": "Mungkin kamu kaget: penahan panas terbaik itu udara."
    },
    "p076": {
      "source_hash": "a7eaceaa5f8b",
      "text": "Udara? Kita tiap hari hidup di udara!"
    },
    "p077": {
      "source_hash": "426180b84633",
      "text": "Panas sulit lewat udara diam."
    },
    "p078": {
      "source_hash": "48dfd857e8e5",
      "text": "Masalahnya, udara sulit diam."
    },
    "p079": {
      "source_hash": "fec59c89a3ec",
      "text": "Kenapa bergerak?"
    },
    "p080": {
      "source_hash": "d360230f8600",
      "text": "Udara dekat tubuhmu hangat lalu naik,"
    },
    "p081": {
      "source_hash": "01dc1a352206",
      "text": "udara dingin datang, panas terbawa."
    },
    "p082": {
      "source_hash": "f4feca1b00e8",
      "text": "Kenapa udara hangat naik?"
    },
    "p083": {
      "source_hash": "74e5c9b933ff",
      "text": "Ia lebih ringan dari udara dingin."
    },
    "p084": {
      "source_hash": "47d4fdc0380d",
      "text": "Jadi walau diam, panas terus terbawa."
    },
    "p085": {
      "source_hash": "f0d9e81a2833",
      "text": "Jaket hangat karena bulunya hangat?"
    },
    "p086": {
      "source_hash": "8acb9a972d7d",
      "text": "Bulu angsa menghantar panas mirip udara."
    },
    "p087": {
      "source_hash": "1d08d6284b03",
      "text": "Lihat dengan lup:"
    },
    "p088": {
      "source_hash": "433d5f4415a1",
      "text": "ia seperti benang sangat halus, mekar ke segala arah."
    },
    "p089": {
      "source_hash": "441ea9e55a1a",
      "text": "Bersama-sama, ia membentuk banyak ruang kecil."
    },
    "p090": {
      "source_hash": "13b518f8ae73",
      "text": "Udara terkunci di ruang itu, tak bisa naik."
    },
    "p091": {
      "source_hash": "c01e5bb26492",
      "text": "Jadi pakai udara saja dong?"
    },
    "p092": {
      "source_hash": "a11df8a2b3c9",
      "text": "Udara lepas berputar membawa panas."
    },
    "p093": {
      "source_hash": "a579a3db563a",
      "text": "Dalam kotak kecil, ia tak bisa berputar."
    },
    "p094": {
      "source_hash": "61aecc15b0bb",
      "text": "Banyak kamar mungil!"
    },
    "p095": {
      "source_hash": "375d1e0837af",
      "text": "Jaket bulu angsa itu baju penuh udara!"
    },
    "p096": {
      "source_hash": "acbf70fe3323",
      "text": "Bagian paling cerdik:"
    },
    "p097": {
      "source_hash": "9c6346ac083c",
      "text": "bahan terpentingnya udara yang gratis."
    },
    "p098": {
      "source_hash": "45db75910d86",
      "text": "Sweter dan selimutmu juga begitu: mengurung udara."
    },
    "p099": {
      "source_hash": "125818ed014b",
      "text": "Bulu kucing juga?"
    },
    "p100": {
      "source_hash": "177e1a6868af",
      "text": "Ya, bulu hewan juga mengurung udara."
    },
    "p101": {
      "source_hash": "c061fbfb96dc",
      "text": "Kalau jaketnya kutekan?"
    },
    "p102": {
      "source_hash": "17bbe2fa8314",
      "text": "Peluk erat, bagian itu jadi kempis."
    },
    "p103": {
      "source_hash": "609c04b42f24",
      "text": "Kempis, udaranya berkurang,"
    },
    "p104": {
      "source_hash": "63ca856f068a",
      "text": "kurang hangat."
    },
    "p105": {
      "source_hash": "43c5f2da3cb9",
      "text": "Kalau aku duduki?"
    },
    "p106": {
      "source_hash": "44e94d9b8b43",
      "text": "Bagian di bawah pantat paling kempis."
    },
    "p107": {
      "source_hash": "757d0dc31000",
      "text": "Jadi makin berat dan tebal, makin hangat?"
    },
    "p108": {
      "source_hash": "b078e7627dbc",
      "text": "Bukan berat."
    },
    "p109": {
      "source_hash": "7e920f1a41cf",
      "text": "Yang penting, berapa udara diam di dalam."
    },
    "p110": {
      "source_hash": "553ff7d6463d",
      "text": "Kalau kehujanan dan basah?"
    },
    "p111": {
      "source_hash": "193362afeb1d",
      "text": "Air mengisi ruang kecil itu,"
    },
    "p112": {
      "source_hash": "f31121f9898b",
      "text": "mengusir udaranya."
    },
    "p113": {
      "source_hash": "78409d429303",
      "text": "Air menghantar panas dua puluhan kali udara."
    },
    "p114": {
      "source_hash": "57db783667b7",
      "text": "Begitu basah, panas kabur jauh lebih cepat, kurang hangat."
    },
    "p115": {
      "source_hash": "5f2fd48bddc2",
      "text": "Bulu basah kempis, ruangnya hilang."
    },
    "p116": {
      "source_hash": "65530c8b3c7c",
      "text": "Ingat dinginnya kehujanan, kan?"
    },
    "p117": {
      "source_hash": "07e23daf4601",
      "text": "Rambut basah juga dingin!"
    },
    "p118": {
      "source_hash": "00e1d99cf9bc",
      "text": "Ya, air yang mengering juga membawa panas dari tubuhmu."
    },
    "p119": {
      "source_hash": "c68dae08ad9e",
      "text": "Kalau berangin, kok dingin sekali?"
    },
    "p120": {
      "source_hash": "932d1e33ed39",
      "text": "Ingat udara hangat yang naik?"
    },
    "p121": {
      "source_hash": "7240263f3c67",
      "text": "Angin meniupnya duluan,"
    },
    "p122": {
      "source_hash": "6d4f135c143d",
      "text": "udara dingin berganti, panas kabur."
    },
    "p123": {
      "source_hash": "c84a1c745ab5",
      "text": "Angin sering membawa panas jauh lebih cepat."
    },
    "p124": {
      "source_hash": "daf303e13ab9",
      "text": "Itulah wind chill: suhu sama, berangin terasa lebih dingin."
    },
    "p125": {
      "source_hash": "b04124a7e23d",
      "text": "Itu soal kulit yang terbuka: wajah, telinga, tangan."
    },
    "p126": {
      "source_hash": "3b18dad59c1a",
      "text": "Pantas telingaku sakit!"
    },
    "p127": {
      "source_hash": "c3580bda83e3",
      "text": "Kain luar jaket sebaiknya tahan angin,"
    },
    "p128": {
      "source_hash": "56813a0a3f66",
      "text": "dan tak tembus hujan."
    },
    "p129": {
      "source_hash": "04eca901b9d7",
      "text": "Tembok angin!"
    },
    "p130": {
      "source_hash": "47b158efd98a",
      "text": "Lupa ritsleting?"
    },
    "p131": {
      "source_hash": "f6215b3c5927",
      "text": "Angin masuk, meniup udara hangatmu."
    },
    "p132": {
      "source_hash": "116584699d28",
      "text": "Pasti pernah rasakan."
    },
    "p133": {
      "source_hash": "93c597f64edd",
      "text": "Termos tanpa listrik,"
    },
    "p134": {
      "source_hash": "eb3448326e82",
      "text": "kok air es tetap dingin?"
    },
    "p135": {
      "source_hash": "a73d7ba6e236",
      "text": "Sebab termos dan jaket kerjanya sama."
    },
    "p136": {
      "source_hash": "cde1c6cf47a3",
      "text": "Tak memanaskan, tak mendinginkan, cuma menghambat panas."
    },
    "p137": {
      "source_hash": "adf47262605d",
      "text": "Termos dua lapis, udara di tengahnya hampir habis."
    },
    "p138": {
      "source_hash": "83fdceec5e09",
      "text": "Jaket mengurung udara,"
    },
    "p139": {
      "source_hash": "fa02a823d460",
      "text": "termos tak mau udara?"
    },
    "p140": {
      "source_hash": "904df071dde0",
      "text": "Ya. Di jaket udara diam, panas masih merayap;"
    },
    "p141": {
      "source_hash": "54e503bc79d5",
      "text": "di termos hampir kosong, panas sulit lewat."
    },
    "p142": {
      "source_hash": "6bdd9d531312",
      "text": "Jadi termos jaket super?"
    },
    "p143": {
      "source_hash": "7dd1cf0d61ce",
      "text": "Kira-kira, tapi tak bisa dipakai."
    },
    "p144": {
      "source_hash": "8477ed9420d9",
      "text": "Mulutnya kayak ritsleting terbuka?"
    },
    "p145": {
      "source_hash": "da78060ddde1",
      "text": "Mirip. Mulutnya tak vakum, banyak panas lolos di situ."
    },
    "p146": {
      "source_hash": "7e7b98610704",
      "text": "Jadi sup tetap panas, air es tetap dingin!"
    },
    "p147": {
      "source_hash": "9eb3cdbc02db",
      "text": "Ya. Ingat sifat panas? Ke mana ia lari, termos menghadang."
    },
    "p148": {
      "source_hash": "1c5997a13815",
      "text": "Kalau dipakai saat panas?"
    },
    "p149": {
      "source_hash": "ed05c8b5c227",
      "text": "Tetap menahan."
    },
    "p150": {
      "source_hash": "49a2df7dd130",
      "text": "Cuma saat panas kamu tak mau, jadi gerah."
    },
    "p151": {
      "source_hash": "8820d86fc27b",
      "text": "Lalu es batu di jaket tadi?"
    },
    "p152": {
      "source_hash": "5d18be9d1c6a",
      "text": "Jaket kan hangat, pasti cepat meleleh?"
    },
    "p153": {
      "source_hash": "a1ef9b2c8a77",
      "text": "Banyak yang kira. Tapi tak ada pemanasnya,"
    },
    "p154": {
      "source_hash": "526f8ee3a8ff",
      "text": "Ingat termometer semalam? Jaketnya tak menghangat."
    },
    "p155": {
      "source_hash": "c4ea3890723e",
      "text": "Di kelas sering dicoba: satu dibungkus, satu tidak."
    },
    "p156": {
      "source_hash": "e6d5fbcd3fed",
      "text": "Yang dibungkus lebih awet."
    },
    "p157": {
      "source_hash": "3802a77774ea",
      "text": "Dibungkus malah lebih awet?!"
    },
    "p158": {
      "source_hash": "13692b95dc05",
      "text": "Paham!"
    },
    "p159": {
      "source_hash": "79fd252eaccd",
      "text": "Hangat karena panasku ditahan jaket!"
    },
    "p160": {
      "source_hash": "11dbf3acb18a",
      "text": "Pakai lalu tunggu;"
    },
    "p161": {
      "source_hash": "9b5564f3ea2e",
      "text": "sebentar itu, panasmu sedang mengisinya."
    },
    "p162": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p163": {
      "source_hash": "f5739c6c8197",
      "text": "Es krim di jaket, meleleh lebih cepat atau lambat?"
    },
    "p164": {
      "source_hash": "fe3432226366",
      "text": "Tulis di komentar!"
    },
    "p165": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
