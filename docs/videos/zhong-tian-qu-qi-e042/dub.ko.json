{
  "zq42a01": {
    "text": "누구야?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "아우야,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "시험 같이 봐?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "형님?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "이 밤에?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "좋아요.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "아침에 같이요.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "여기가……",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "주성?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "청주 주성,",
    "emotion": "得意"
  },
  "zq42a11": {
    "text": "현성의 열 배야.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "병사를 피하는 거야?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "가던 길이나 가.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "숙소, 보결, 시험장,",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "세 관문.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "보증인은 구했으니,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "넌 공부만 해.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "좋은 방 두 칸,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "하룻밤 넉 냥!",
    "emotion": "報價"
  },
  "zq42a20": {
    "text": "넉 냥?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "장부 좀 봐요.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "장작값 두 번,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "등잔 기름 세 번?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "하룻밤 두 냥,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "아니면 딴 데요.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "두 냥, 두 냥!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "낭자, 눈이 밝으십니다.",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "손이,",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "길을 잘못 들었네.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "두 제수씨 대단하네!",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "어라,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "쉬 수재 아닌가?",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "그때 파혼한 건,",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "정말 잘한 일이야.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "파혼?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "잘했네요,",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "아니면 내 차례 없죠.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "다음,",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "청수현, 쉬옌.",
    "emotion": "頭也不抬"
  },
  "zq42a40": {
    "text": "쉬옌,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "네 보결이 철회됐다.",
    "emotion": "一字一字"
  },
  "zq42a42": {
    "text": "철회요?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "누가요?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "보증인 없으면,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "시험 못 봐.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "강제 미션: 향시 합격.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq42a47": {
    "text": "시험까지, 이틀 남음.",
    "emotion": "平板電子音"
  }
}
