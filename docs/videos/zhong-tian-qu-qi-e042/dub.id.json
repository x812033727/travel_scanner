{
  "zq42a01": {
    "text": "Siapa itu?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "Sepupu,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "ujian bareng?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "Kakak?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "Selarut ini?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "Baik.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "Besok berangkat.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "Ini…",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "kota besar?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "Prefektur Qingzhou,",
    "emotion": "得意",
    "say": "Ini Qingzhou,"
  },
  "zq42a11": {
    "text": "sepuluh kali lipat.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "Hindari prajurit?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "Jalan saja.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "Penginapan, jaminan, ujian,",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "tiga tahap.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "Penjamin sudah ada,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "kau belajar saja.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "Dua kamar terbaik,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "empat tael semalam!",
    "emotion": "報價"
  },
  "zq42a20": {
    "text": "Empat tael?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "Lihat dulu bukunya.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "Kayu, dua kali,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "minyak lampu, tiga kali?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "Dua tael semalam,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "atau pindah saja.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "Dua tael, dua tael!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "Mata Nona tajam sekali.",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "Tanganmu",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "salah tempat.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "Dua adik iparku hebat!",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "Wah,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "bukankah ini Sarjana Xu?",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "Dulu batal nikah,",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "itu sudah tepat.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "Batal nikah?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "Bagus dibatalkan,",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "kalau tidak, bukan aku.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "Berikutnya,",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "Kabupaten Qingshui, Xu Yan.",
    "emotion": "頭也不抬"
  },
  "zq42a40": {
    "text": "Xu Yan,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "jaminanmu dicabut.",
    "emotion": "一字一字"
  },
  "zq42a42": {
    "text": "Dicabut?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "Siapa yang cabut?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "Tanpa penjamin,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "tak bisa ujian.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "Misi wajib: lulus ujian provinsi.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq42a47": {
    "text": "Dua hari lagi ujian.",
    "emotion": "平板電子音"
  }
}
