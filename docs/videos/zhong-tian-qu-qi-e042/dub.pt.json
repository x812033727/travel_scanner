{
  "zq42a01": {
    "text": "Quem é?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "Primo,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "vamos juntos?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "Primo?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "Tão tarde?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "Certo.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "Vamos de manhã.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "Isso é…",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "a cidade?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "É Qingzhou,",
    "emotion": "得意"
  },
  "zq42a11": {
    "text": "dez vezes maior.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "Evita os soldados?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "Siga seu caminho.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "Pousada, aval, exame:",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "três etapas.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "Já achei seu fiador,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "você só estuda.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "Dois quartos bons,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "quatro taéis a noite!",
    "emotion": "報價",
    "say": "quatro taéis!"
  },
  "zq42a20": {
    "text": "Quatro taéis?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "Me mostra as contas.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "Lenha, duas vezes,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "óleo, três vezes?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "Dois taéis a noite,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "ou vamos embora.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "Dois, dois taéis!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "Que olho bom, senhorita!",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "Essa mão",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "errou de lugar.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "Que cunhadas de talento!",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "Ora,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "não é o Letrado Xu?",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "Romper aquele noivado",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "foi a coisa certa.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "Noivado?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "Ainda bem,",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "senão não seria eu.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "Próximo,",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "Condado de Qingshui, Xu Yan.",
    "emotion": "頭也不抬",
    "say": "Qingshui, Xu Yan."
  },
  "zq42a40": {
    "text": "Xu Yan,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "seu aval foi retirado.",
    "emotion": "一字一字"
  },
  "zq42a42": {
    "text": "Retirado?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "Quem retirou?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "Sem fiador,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "sem exame.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "Missão obrigatória: passar no exame provincial.",
    "emotion": "平板電子音，叮一聲",
    "say": "Missão: passar no exame provincial."
  },
  "zq42a47": {
    "text": "Faltam dois dias pro exame.",
    "emotion": "平板電子音",
    "say": "Faltam dois dias."
  }
}
