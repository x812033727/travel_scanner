{
  "zq42a01": {
    "text": "¿Quién es?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "Primo,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "¿vamos juntos?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "¿Primo?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "¿Tan tarde?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "Bien.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "Vamos al alba.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "Esto es…",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "¿la ciudad?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "Es Qingzhou,",
    "emotion": "得意"
  },
  "zq42a11": {
    "text": "diez veces mayor.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "¿Evitas soldados?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "Sigue tu camino.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "Posada, aval, examen:",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "tres retos.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "Tienes avalista,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "tú solo estudia.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "Dos cuartos buenos,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "¡cuatro taeles la noche!",
    "emotion": "報價",
    "say": "¡cuatro taeles!"
  },
  "zq42a20": {
    "text": "¿Cuatro taeles?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "A ver las cuentas.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "Leña, dos veces,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "¿aceite, tres veces?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "Dos taeles la noche,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "o nos vamos a otra.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "¡Dos, dos taeles!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "¡Qué buen ojo, señorita!",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "Esa mano",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "se equivocó de sitio.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "¡Qué cuñadas tan hábiles!",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "Vaya,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "¿no es el letrado Xu?",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "Romper ese compromiso",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "fue un acierto.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "¿Compromiso?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "Bien hecho,",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "o no me tocaba.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "Siguiente,",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "condado de Qingshui, Xu Yan.",
    "emotion": "頭也不抬",
    "say": "Qingshui, Xu Yan."
  },
  "zq42a40": {
    "text": "Xu Yan,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "tu aval se retiró.",
    "emotion": "一字一字"
  },
  "zq42a42": {
    "text": "¿Retirado?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "¿Quién lo hizo?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "Sin avalista,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "no hay examen.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "Misión obligatoria: aprobar el examen provincial.",
    "emotion": "平板電子音，叮一聲",
    "say": "Misión: aprobar el examen provincial."
  },
  "zq42a47": {
    "text": "Faltan dos días para el examen.",
    "emotion": "平板電子音",
    "say": "Faltan dos días."
  }
}
