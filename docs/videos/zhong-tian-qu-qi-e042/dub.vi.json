{
  "zq42a01": {
    "text": "Ai đó?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "Đường đệ,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "cùng đi thi chứ?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "Đại ca?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "Khuya thế?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "Được.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "Sáng mai cùng đi.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "Đây là…",
    "emotion": "看傻了",
    "say": "Đây…"
  },
  "zq42a09": {
    "text": "châu thành?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "Thanh Châu phủ,",
    "emotion": "得意"
  },
  "zq42a11": {
    "text": "lớn gấp mười lần.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "Nàng đang tránh lính?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "Đi đường của ngươi đi.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "Chỗ ở, bảo kết, trường thi,",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "ba cửa ải.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "Người bảo lãnh có rồi,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "đệ cứ đọc sách đi.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "Hai phòng thượng hạng,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "một đêm bốn lượng!",
    "emotion": "報價"
  },
  "zq42a20": {
    "text": "Bốn lượng?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "Đưa sổ sách ta xem.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "Tiền củi tính hai lần,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "dầu đèn tính ba lần?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "Một đêm hai lượng,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "không thì đi thôi.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "Hai lượng, hai lượng!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "Cô nương tinh mắt thật.",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "Tay này,",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "thò nhầm chỗ rồi.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "Hai vị đệ muội giỏi thật!",
    "emotion": "大笑，誇張",
    "say": "Hai đệ muội giỏi thật!"
  },
  "zq42a31": {
    "text": "Ồ,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "đây chẳng phải Hứa tú tài?",
    "emotion": "假笑",
    "say": "Hứa tú tài đây à?"
  },
  "zq42a33": {
    "text": "Năm đó thoái hôn,",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "thoái đúng thật.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "Thoái hôn?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "Thoái hay lắm,",
    "emotion": "笑得很甜",
    "say": "Thoái hay,"
  },
  "zq42a37": {
    "text": "không thì đâu đến lượt ta.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "Người tiếp theo,",
    "emotion": "不耐煩",
    "say": "Kế tiếp,"
  },
  "zq42a39": {
    "text": "huyện Thanh Thủy, Hứa Nghiên.",
    "emotion": "頭也不抬",
    "say": "Thanh Thủy, Hứa Nghiên."
  },
  "zq42a40": {
    "text": "Hứa Nghiên,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "bảo kết của ngươi bị rút.",
    "emotion": "一字一字"
  },
  "zq42a42": {
    "text": "Rút rồi?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "Ai rút?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "Không người bảo lãnh,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "không được thi.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "Nhiệm vụ bắt buộc: đỗ thi Hương.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq42a47": {
    "text": "Còn hai ngày đến kỳ thi.",
    "emotion": "平板電子音"
  }
}
