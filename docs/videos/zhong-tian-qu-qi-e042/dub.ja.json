{
  "zq42a01": {
    "text": "誰だ？",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "いとこよ、",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "一緒に受ける？",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "兄さん？",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "こんな夜に？",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "ああ。",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "朝、一緒に。",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "ここが……",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "州城？",
    "emotion": "不敢相信",
    "say": "しゅうじょう？"
  },
  "zq42a10": {
    "text": "青州州府、",
    "emotion": "得意",
    "say": "せいしゅう州府、"
  },
  "zq42a11": {
    "text": "県城の十倍よ。",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "兵を避けてる？",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "黙って歩け。",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "宿、保結、試験場、",
    "emotion": "數著手指",
    "say": "宿、ほけつ、試験場、"
  },
  "zq42a15": {
    "text": "関門は三つ。",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "保証人は見つけた、",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "お前は勉強だけだ。",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "上等の部屋二つ、",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "一晩四両！",
    "emotion": "報價"
  },
  "zq42a20": {
    "text": "四両？",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "帳簿を見せて。",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "薪代が二回、",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "灯り油が三回？",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "一晩二両、",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "嫌なら他へ。",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "二両、二両！",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "お嬢さん、お目が高い。",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "その手、",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "伸ばす先が違う。",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "お二人とも大したもんだ！",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "おや、",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "シュー秀才じゃないか？",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "あの婚約破棄、",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "正解だったな。",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "婚約破棄？",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "大正解ね、",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "でなきゃ私の番はない。",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "次、",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "清水県、シュー・イェン。",
    "emotion": "頭也不抬",
    "say": "せいすい県、シュー・イェン。"
  },
  "zq42a40": {
    "text": "シュー・イェン、",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "保結は取り消しだ。",
    "emotion": "一字一字",
    "say": "ほけつは取り消しだ。"
  },
  "zq42a42": {
    "text": "取り消し？",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "誰が？",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "保証人なしでは、",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "受験できん。",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "強制任務：郷試合格。",
    "emotion": "平板電子音，叮一聲",
    "say": "強制任務：きょうし合格。"
  },
  "zq42a47": {
    "text": "試験まで、あと二日。",
    "emotion": "平板電子音"
  }
}
