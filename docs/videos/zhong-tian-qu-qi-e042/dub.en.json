{
  "zq42a01": {
    "text": "Who's there?",
    "emotion": "壓低聲音，一把推開窗"
  },
  "zq42a02": {
    "text": "Cousin,",
    "emotion": "咧嘴笑，親熱"
  },
  "zq42a03": {
    "text": "exam together?",
    "emotion": "笑著"
  },
  "zq42a04": {
    "text": "Dalang?",
    "emotion": "愣住"
  },
  "zq42a05": {
    "text": "This late?",
    "emotion": "鬆一口氣，還有點警覺"
  },
  "zq42a06": {
    "text": "All right.",
    "emotion": "想了一下"
  },
  "zq42a07": {
    "text": "We leave at dawn.",
    "emotion": "點頭"
  },
  "zq42a08": {
    "text": "So this is…",
    "emotion": "看傻了"
  },
  "zq42a09": {
    "text": "the city?",
    "emotion": "不敢相信"
  },
  "zq42a10": {
    "text": "Qingzhou Prefecture,",
    "emotion": "得意",
    "say": "It's Qingzhou,"
  },
  "zq42a11": {
    "text": "ten times the county town.",
    "emotion": "笑"
  },
  "zq42a12": {
    "text": "Dodging soldiers?",
    "emotion": "低聲，看出來了"
  },
  "zq42a13": {
    "text": "Keep walking.",
    "emotion": "冷，壓低聲音"
  },
  "zq42a14": {
    "text": "Lodging, bond, hall:",
    "emotion": "數著手指"
  },
  "zq42a15": {
    "text": "three hurdles.",
    "emotion": "盤算"
  },
  "zq42a16": {
    "text": "Got you a guarantor,",
    "emotion": "拍胸脯"
  },
  "zq42a17": {
    "text": "you just study.",
    "emotion": "笑"
  },
  "zq42a18": {
    "text": "Two best rooms,",
    "emotion": "油滑，拔高嗓門"
  },
  "zq42a19": {
    "text": "four taels a night!",
    "emotion": "報價"
  },
  "zq42a20": {
    "text": "Four taels?",
    "emotion": "甜甜地，眼睛一瞇"
  },
  "zq42a21": {
    "text": "Show me your ledger.",
    "emotion": "伸手"
  },
  "zq42a22": {
    "text": "Firewood billed twice,",
    "emotion": "畫外，邊撥算盤"
  },
  "zq42a23": {
    "text": "lamp oil three times?",
    "emotion": "畫外，笑"
  },
  "zq42a24": {
    "text": "Two taels a night,",
    "emotion": "甜但不讓"
  },
  "zq42a25": {
    "text": "or we go elsewhere.",
    "emotion": "轉身作勢要走"
  },
  "zq42a26": {
    "text": "Two, two taels!",
    "emotion": "連忙"
  },
  "zq42a27": {
    "text": "What a sharp eye, miss!",
    "emotion": "陪笑"
  },
  "zq42a28": {
    "text": "That hand",
    "emotion": "冷"
  },
  "zq42a29": {
    "text": "went the wrong way.",
    "emotion": "嘴角一勾"
  },
  "zq42a30": {
    "text": "Fine sisters-in-law!",
    "emotion": "大笑，誇張"
  },
  "zq42a31": {
    "text": "Well, well,",
    "emotion": "拖長音"
  },
  "zq42a32": {
    "text": "if it isn't Scholar Xu?",
    "emotion": "假笑"
  },
  "zq42a33": {
    "text": "Breaking that engagement",
    "emotion": "慢條斯理"
  },
  "zq42a34": {
    "text": "was the right call.",
    "emotion": "尖酸"
  },
  "zq42a35": {
    "text": "Broken off?",
    "emotion": "轉頭看許硯"
  },
  "zq42a36": {
    "text": "Good thing you did,",
    "emotion": "笑得很甜"
  },
  "zq42a37": {
    "text": "or I'd have missed out.",
    "emotion": "挽住許硯"
  },
  "zq42a38": {
    "text": "Next,",
    "emotion": "不耐煩"
  },
  "zq42a39": {
    "text": "Qingshui County, Xu Yan.",
    "emotion": "頭也不抬"
  },
  "zq42a40": {
    "text": "Xu Yan,",
    "emotion": "冷淡"
  },
  "zq42a41": {
    "text": "your guarantee bond is withdrawn.",
    "emotion": "一字一字",
    "say": "your bond is withdrawn."
  },
  "zq42a42": {
    "text": "Withdrawn?",
    "emotion": "愣住"
  },
  "zq42a43": {
    "text": "By who?",
    "emotion": "急"
  },
  "zq42a44": {
    "text": "No guarantor,",
    "emotion": "頭也不抬"
  },
  "zq42a45": {
    "text": "no exam.",
    "emotion": "冷"
  },
  "zq42a46": {
    "text": "Mandatory mission: pass the provincial exam.",
    "emotion": "平板電子音，叮一聲",
    "say": "Mandatory: pass the provincial exam."
  },
  "zq42a47": {
    "text": "Two days until the exam.",
    "emotion": "平板電子音"
  }
}
