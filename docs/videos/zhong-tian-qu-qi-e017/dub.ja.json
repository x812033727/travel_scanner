{
  "zq17a01": "簾がまだ中だ！",
  "zq17a02": "アーリン！",
  "zq17a03": "入るな、任せて。",
  "zq17a04": "井戸から並べ！",
  "zq17a05": "次々回して！",
  "zq17a06": "水だ！かけろ！",
  "zq17a07": "村中で、水を運べ！",
  "zq17a08": "アーリンがまだ！",
  "zq17a09": "俺が行く——",
  "zq17a10": "簾は、全部ある。",
  "zq17a11": "次は、俺が行く。",
  "zq17a12": "アーリン、プラス一。",
  "zq17a13": "工房……全部燃えた。",
  "zq17a14": "簾ありゃ",
  "zq17a15": "紙は作れる。",
  "zq17a16": "チエンの灯。",
  "zq17a17": "足跡も。",
  "zq17a18": "片方深く、片方浅い、",
  "zq17a19": "足が悪い奴ね。",
  "zq17a20": "ライ・サン！",
  "zq17a21": "足が悪いの！",
  "zq17a22": "捕まえてくる！",
  "zq17a23": "証人なしじゃ",
  "zq17a24": "役所は認めん。",
  "zq17a25": "まず再建だ。",
  "zq17a26": "朝までに",
  "zq17a27": "骨組みは立てる。",
  "zq17a28": "お兄ちゃん、一個！",
  "zq17a29": "四十二人、",
  "zq17a30": "日当、つけてる。",
  "zq17a31": "昨夜、",
  "zq17a32": "背中を見た。",
  "zq17a33": "誰か分かる？",
  "zq17a34": "暗かった、",
  "zq17a35": "足を引きずってた。",
  "zq17a36": "立ったな。",
  "zq17a37": "強制任務。",
  "zq17a38": "七日以内に、放火犯の自白。",
  "zq17a39": "失敗：農業スキルを喪失。"
}
