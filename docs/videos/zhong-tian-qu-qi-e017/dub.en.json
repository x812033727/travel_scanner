{
  "zq17a01": "The screens are still inside!",
  "zq17a02": "A-Ling—!",
  "zq17a03": "Don't. Leave it to me.",
  "zq17a04": "Line up by the well!",
  "zq17a05": "Bucket after bucket!",
  "zq17a06": "Water! Throw it!",
  "zq17a07": "Everyone, bring water!",
  "zq17a08": "A-Ling's still inside!",
  "zq17a09": "I'm going in—",
  "zq17a10": "The screens… all safe.",
  "zq17a11": "Next time, let me go.",
  "zq17a12": "A-Ling affection: plus one.",
  "zq17a13": "The mill… it's all gone.",
  "zq17a14": "We've got the screens,",
  "zq17a15": "we'll have paper.",
  "zq17a16": "A Qian house lantern.",
  "zq17a17": "And footprints.",
  "zq17a18": "One deep, one shallow—",
  "zq17a19": "he limps.",
  "zq17a20": "Lai San!",
  "zq17a21": "Lai San has a limp!",
  "zq17a22": "I'll go grab him!",
  "zq17a23": "Nobody saw it,",
  "zq17a24": "the court won't buy it.",
  "zq17a25": "First, rebuild the mill.",
  "zq17a26": "Before dawn,",
  "zq17a27": "the frame'll be up.",
  "zq17a28": "Brother, eat first!",
  "zq17a29": "Forty-two people,",
  "zq17a30": "I've logged every wage.",
  "zq17a31": "Last night,",
  "zq17a32": "I saw someone's back.",
  "zq17a33": "Know who?",
  "zq17a34": "Too dark.",
  "zq17a35": "Just saw him limping.",
  "zq17a36": "It's standing.",
  "zq17a37": "Mandatory task.",
  "zq17a38": "Within seven days, the arsonist confesses.",
  "zq17a39": "Failure: loss of farming skill."
}
