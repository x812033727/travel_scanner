{
  "zq17a01": "Mành còn ở trong đó!",
  "zq17a02": "A Lệnh—!",
  "zq17a03": "Đừng vào, để ta.",
  "zq17a04": "Xếp hàng ra giếng!",
  "zq17a05": "Chuyền tay từng thùng!",
  "zq17a06": "Nước đây! Tạt!",
  "zq17a07": "Cả thôn, xách nước lại đây!",
  "zq17a08": "A Lệnh chưa ra!",
  "zq17a09": "Để ta vào—",
  "zq17a10": "Mành… còn đủ.",
  "zq17a11": "Lần sau, để ta đi.",
  "zq17a12": "Hảo cảm A Lệnh: cộng một.",
  "zq17a13": "Xưởng giấy… mất hết rồi.",
  "zq17a14": "Còn mành,",
  "zq17a15": "là còn giấy.",
  "zq17a16": "Đèn lồng Tiền phủ.",
  "zq17a17": "Còn dấu chân.",
  "zq17a18": "Một bước sâu, một bước nông,",
  "zq17a19": "là kẻ thọt.",
  "zq17a20": "Lại Tam!",
  "zq17a21": "Lại Tam bị thọt mà!",
  "zq17a22": {
    "text": "Ta tới Tiền phủ bắt hắn!",
    "say": "Ta đi bắt hắn!"
  },
  "zq17a23": "Không ai thấy,",
  "zq17a24": "quan phủ không nhận.",
  "zq17a25": "Xây lại xưởng trước.",
  "zq17a26": "Rạng sáng,",
  "zq17a27": "khung sẽ dựng xong.",
  "zq17a28": "Ca ca, ăn một cái đã!",
  "zq17a29": "Bốn mươi hai người,",
  "zq17a30": "tiền công, ta ghi hết.",
  "zq17a31": "Đêm qua,",
  "zq17a32": "ta thấy bóng lưng.",
  "zq17a33": "Nhận ra à?",
  "zq17a34": "Tối quá,",
  "zq17a35": "chỉ thấy hắn đi khập khiễng.",
  "zq17a36": "Dựng xong rồi.",
  "zq17a37": {
    "text": "Nhiệm vụ bắt buộc.",
    "say": "Nhiệm vụ:"
  },
  "zq17a38": {
    "text": "Trong bảy ngày, kẻ phóng hỏa nhận tội.",
    "say": "bảy ngày, kẻ phóng hỏa nhận tội."
  },
  "zq17a39": "Thất bại: mất kỹ năng làm ruộng."
}
