{
  "zq17a01": "Saringannya masih di dalam!",
  "zq17a02": "A-Ling—!",
  "zq17a03": {
    "text": "Jangan masuk, biar aku.",
    "say": "Jangan, biar aku."
  },
  "zq17a04": "Baris di sumur!",
  "zq17a05": "Oper terus embernya!",
  "zq17a06": {
    "text": "Airnya datang! Siram!",
    "say": "Air! Siram!"
  },
  "zq17a07": "Seluruh desa, bawa air!",
  "zq17a08": "A-Ling belum keluar!",
  "zq17a09": "Aku masuk!",
  "zq17a10": {
    "text": "Saringannya… aman semua.",
    "say": "Saringannya aman."
  },
  "zq17a11": "Lain kali, biar aku.",
  "zq17a12": "Poin suka A-Ling, plus satu.",
  "zq17a13": "Pabrik kertasnya… habis semua.",
  "zq17a14": "Saringannya ada,",
  "zq17a15": {
    "text": "kertas pun ada.",
    "say": "kertas ada."
  },
  "zq17a16": {
    "text": "Lentera keluarga Qian.",
    "say": "Lentera Qian."
  },
  "zq17a17": "Ada jejak kaki.",
  "zq17a18": "Satu dalam, satu dangkal,",
  "zq17a19": "dia pincang.",
  "zq17a20": "Lai San!",
  "zq17a21": "Lai San kan pincang!",
  "zq17a22": {
    "text": "Kutangkap dia di rumah Qian!",
    "say": "Kutangkap!"
  },
  "zq17a23": "Tak ada saksi,",
  "zq17a24": {
    "text": "pejabat tak akan percaya.",
    "say": "hakim menolak."
  },
  "zq17a25": "Bangun lagi pabriknya dulu.",
  "zq17a26": {
    "text": "Sebelum subuh,",
    "say": "Subuh,"
  },
  "zq17a27": "rangkanya kudirikan.",
  "zq17a28": {
    "text": "Kakak, makan satu dulu!",
    "say": "Kak, makan dulu!"
  },
  "zq17a29": "Empat puluh dua orang,",
  "zq17a30": "upahnya aku catat semua.",
  "zq17a31": "Semalam,",
  "zq17a32": {
    "text": "aku melihat seseorang dari belakang.",
    "say": "kulihat sosok orang."
  },
  "zq17a33": {
    "text": "Kamu kenal?",
    "say": "Kenal?"
  },
  "zq17a34": {
    "text": "Terlalu gelap,",
    "say": "Gelap,"
  },
  "zq17a35": "cuma lihat dia jalan pincang.",
  "zq17a36": {
    "text": "Akhirnya berdiri.",
    "say": "Berdiri."
  },
  "zq17a37": "Misi wajib.",
  "zq17a38": {
    "text": "Dalam tujuh hari, pelaku pembakaran harus mengaku.",
    "say": "Tujuh hari, pelakunya mengaku."
  },
  "zq17a39": {
    "text": "Gagal: keahlian bertani hilang.",
    "say": "Gagal: keahlian tani hilang."
  }
}
