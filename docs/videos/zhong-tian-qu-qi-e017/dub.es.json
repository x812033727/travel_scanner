{
  "zq17a01": "¡Los tamices siguen ahí!",
  "zq17a02": "¡A-Ling…!",
  "zq17a03": "No, yo voy.",
  "zq17a04": "¡Hagan fila al pozo!",
  "zq17a05": "¡Cubeta tras cubeta!",
  "zq17a06": "¡Ahí va el agua! ¡Échenla!",
  "zq17a07": "¡Todos, traigan agua!",
  "zq17a08": "¡Falta A-Ling!",
  "zq17a09": "Voy a entrar…",
  "zq17a10": "Los tamices… todos.",
  "zq17a11": "La próxima, voy yo.",
  "zq17a12": "A-Ling: más uno.",
  "zq17a13": "El taller… no queda nada.",
  "zq17a14": "Si hay tamices,",
  "zq17a15": "hay papel.",
  "zq17a16": "Un farol de los Qian.",
  "zq17a17": "Y huellas.",
  "zq17a18": "Una huella honda, otra leve,",
  "zq17a19": "es de un cojo.",
  "zq17a20": "¡Es él!",
  "zq17a21": "¡Lai San es cojo!",
  "zq17a22": {
    "text": "¡Voy por él a la mansión Qian!",
    "say": "¡Voy por él!"
  },
  "zq17a23": "Nadie vio,",
  "zq17a24": "el juez no lo cree.",
  "zq17a25": "Primero, a reconstruir.",
  "zq17a26": "Al alba,",
  "zq17a27": "tendrás el armazón.",
  "zq17a28": "¡Hermano, cómete uno!",
  "zq17a29": "Cuarenta y dos personas,",
  "zq17a30": "tengo anotada cada paga.",
  "zq17a31": "Ayer,",
  "zq17a32": "vi una silueta.",
  "zq17a33": "¿Quién era?",
  "zq17a34": "Muy oscuro.",
  "zq17a35": "Solo vi que cojeaba.",
  "zq17a36": "Ya está en pie.",
  "zq17a37": {
    "text": "Misión obligatoria:",
    "say": "Obligatoria:"
  },
  "zq17a38": "Siete días: el incendiario confiesa.",
  "zq17a39": {
    "text": "Fallo: pierdes la habilidad de sembrar.",
    "say": "Fallo: ya no sabrás sembrar."
  }
}
