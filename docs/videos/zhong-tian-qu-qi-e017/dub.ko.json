{
  "zq17a01": "발이 안에 있어!",
  "zq17a02": "아링—!",
  "zq17a03": "가지 마, 내가 해.",
  "zq17a04": "우물가에 줄 서!",
  "zq17a05": "한 통씩 넘겨!",
  "zq17a06": "물 왔다! 부어!",
  "zq17a07": "온 마을, 물 길어 와라!",
  "zq17a08": "아링 아직 안에!",
  "zq17a09": "내가 간다—",
  "zq17a10": "발, 다 있어.",
  "zq17a11": "다음엔, 내가 갈게.",
  "zq17a12": {"text": "아링 호감, +1.", "say": "아링 호감, 플러스 일."},
  "zq17a13": "공방이… 다 사라졌어.",
  "zq17a14": "발이 있으면,",
  "zq17a15": "종이도 있어.",
  "zq17a16": "첸 가의 등롱.",
  "zq17a17": "발자국도.",
  "zq17a18": "깊고, 얕아.",
  "zq17a19": "절름발이야.",
  "zq17a20": "라이싼!",
  "zq17a21": "라이싼이 절어!",
  "zq17a22": "잡으러 간다!",
  "zq17a23": "본 사람 없으면,",
  "zq17a24": "관아가 안 믿어.",
  "zq17a25": "공방부터 짓자.",
  "zq17a26": "새벽까지,",
  "zq17a27": "뼈대 세워 주지.",
  "zq17a28": "오빠, 하나 먹어!",
  "zq17a29": "마흔두 명,",
  "zq17a30": "품삯, 다 적어 둘게.",
  "zq17a31": "어제,",
  "zq17a32": "뒷모습을 봤어.",
  "zq17a33": "알아보겠어?",
  "zq17a34": "어두웠어,",
  "zq17a35": "절뚝이는 것만.",
  "zq17a36": "세웠다.",
  "zq17a37": "강제 미션.",
  "zq17a38": "이레 안에, 방화범 자백.",
  "zq17a39": "실패 시: 농사 스킬 상실."
}
