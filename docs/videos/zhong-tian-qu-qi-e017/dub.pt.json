{
  "zq17a01": "As telas ficaram lá!",
  "zq17a02": "A-Ling—!",
  "zq17a03": {
    "text": "Não entra. Deixa comigo.",
    "say": "Deixa comigo."
  },
  "zq17a04": "Fila no poço!",
  "zq17a05": "Balde atrás de balde!",
  "zq17a06": "Água! Joga!",
  "zq17a07": "A vila toda, tragam água!",
  "zq17a08": "A-Ling não saiu!",
  "zq17a09": "Eu vou entrar—",
  "zq17a10": "As telas… tão aqui.",
  "zq17a11": "Da próxima, eu vou.",
  "zq17a12": "A-Ling: mais um.",
  "zq17a13": "A oficina… perdemos tudo.",
  "zq17a14": "Temos as telas,",
  "zq17a15": "temos papel.",
  "zq17a16": {
    "text": "Lanterna da casa Qian.",
    "say": "É dos Qian."
  },
  "zq17a17": "E pegadas.",
  "zq17a18": "Uma funda, outra rasa,",
  "zq17a19": "é um manco.",
  "zq17a20": "Lai San!",
  "zq17a21": "O Lai San é manco!",
  "zq17a22": {
    "text": "Vou pegar ele na casa Qian!",
    "say": "Eu pego ele!"
  },
  "zq17a23": "Ninguém viu,",
  "zq17a24": "a lei não aceita.",
  "zq17a25": {
    "text": "Primeiro, refazer a oficina.",
    "say": "Refazer a oficina."
  },
  "zq17a26": {
    "text": "Até de manhã,",
    "say": "De manhã,"
  },
  "zq17a27": "a armação tá de pé.",
  "zq17a28": "Mano, come antes!",
  "zq17a29": "Quarenta e duas pessoas,",
  "zq17a30": "a diária, anotei tudo.",
  "zq17a31": "Ontem,",
  "zq17a32": "vi um vulto.",
  "zq17a33": "Quem era?",
  "zq17a34": {
    "text": "Tava escuro,",
    "say": "Escuro,"
  },
  "zq17a35": "só vi que ele mancava.",
  "zq17a36": "Tá de pé.",
  "zq17a37": {
    "text": "Missão obrigatória.",
    "say": "Missão forçada."
  },
  "zq17a38": {
    "text": "Em sete dias, o incendiário confessa.",
    "say": "Sete dias: o culpado confessa."
  },
  "zq17a39": {
    "text": "Falha: perda da habilidade de plantar.",
    "say": "Falha: adeus à roça."
  }
}
