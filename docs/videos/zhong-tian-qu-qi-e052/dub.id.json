{
  "zq52a01": {
    "text": "Di cap asli, huruf 'Zhou',",
    "emotion": "畫外，很輕，很篤定",
    "say": "Di cap asli, 'Zhou',"
  },
  "zq52a02": {
    "text": "goresan ini,",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "terputus.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "A-Ling, kok kamu bisa…",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "Tak usah tanya.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tak usah."
  },
  "zq52a06": {
    "text": "Aku percaya dia.",
    "emotion": "看著阿令"
  },
  "zq52a07": {
    "text": "Untuk membuktikan ini palsu,",
    "emotion": "想事情",
    "say": "Biar terbukti palsu,"
  },
  "zq52a08": {
    "text": "kita perlu yang asli untuk dibandingkan.",
    "emotion": "低聲",
    "say": "perlu yang asli."
  },
  "zq52a09": {
    "text": "Putri Jenderal Qin,",
    "emotion": "粗啞，急"
  },
  "zq52a10": {
    "text": "benar-benar dipenjara di penjara prefektur?",
    "emotion": "喘著氣",
    "say": "benar dipenjara?"
  },
  "zq52a11": {
    "text": "Siapa berani menyentuhnya,",
    "emotion": "咬牙，快，說完就停",
    "say": "Siapa sentuh dia,"
  },
  "zq52a12": {
    "text": "kuhabisi dia!",
    "emotion": "吼"
  },
  "zq52a13": {
    "text": "Paman Du,",
    "emotion": "按住他"
  },
  "zq52a14": {
    "text": "awasi penjara prefektur untukku.",
    "emotion": "低聲交代",
    "say": "awasi penjaranya."
  },
  "zq52a15": {
    "text": "Soal istri prefek,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "Istri prefek,"
  },
  "zq52a16": {
    "text": "biar aku yang bicara.",
    "emotion": "很有把握",
    "say": "biar aku."
  },
  "zq52a17": {
    "text": "Tuan Prefek sedang tidak ada,",
    "emotion": "低聲，快，說完就停",
    "say": "Prefek pergi,"
  },
  "zq52a18": {
    "text": "ada urusan, bicara dengan saya.",
    "emotion": "倨傲",
    "say": "bicara dengan saya."
  },
  "zq52a19": {
    "text": "Surat penangkapan ini,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Surat ini,"
  },
  "zq52a20": {
    "text": "capnya palsu.",
    "emotion": "一字一字"
  },
  "zq52a21": {
    "text": "Cap besar prefektur,",
    "emotion": "冷冷的，快，說完就停"
  },
  "zq52a22": {
    "text": "saya sendiri yang melihat waktu dicap!",
    "emotion": "拍案",
    "say": "saya lihat sendiri!"
  },
  "zq52a23": {
    "text": "Berarti Anda salah lihat.",
    "emotion": "冷冷的，快，說完就停",
    "say": "Anda keliru."
  },
  "zq52a24": {
    "text": "Lancang!",
    "emotion": "翻臉"
  },
  "zq52a25": {
    "text": "Usir mereka!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "Tunggu.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tahan."
  },
  "zq52a27": {
    "text": "Yang ini?",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ini?"
  },
  "zq52a28": {
    "text": "Surat kabar kelulusan juara pertama ujian provinsi, dari prefektur.",
    "emotion": "畫外，一字一字",
    "say": "Surat kelulusanku."
  },
  "zq52a29": {
    "text": "Dua cap,",
    "emotion": "很穩"
  },
  "zq52a30": {
    "text": "lihat di depan lampu.",
    "emotion": "舉起來",
    "say": "ke lampu."
  },
  "zq52a31": {
    "text": "Beda satu goresan.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "Beda satu goresan,",
    "emotion": "嘴硬",
    "say": "Satu goresan,"
  },
  "zq52a33": {
    "text": "apa artinya?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "Nyonya,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "ada yang memakai cap prefektur untuk menangkap orang.",
    "emotion": "壓低聲音",
    "say": "cap prefektur disalahgunakan."
  },
  "zq52a36": {
    "text": "Kalau terjadi apa-apa,",
    "emotion": "一字一字",
    "say": "Kalau ada apa-apa,"
  },
  "zq52a37": {
    "text": "yang menanggung adalah Tuan Prefek.",
    "emotion": "算盤打得精",
    "say": "Tuan Prefek yang kena."
  },
  "zq52a38": {
    "text": "Pelayan!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a39": {
    "text": "Panggil Tuan pulang.",
    "emotion": "很定"
  },
  "zq52a40": {
    "text": "Capku sendiri,",
    "emotion": "沉穩，快，說完就停",
    "say": "Capku,"
  },
  "zq52a41": {
    "text": "aku sendiri yang menilai.",
    "emotion": "低"
  },
  "zq52a42": {
    "text": "Surat ini,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "siapa yang mengantarnya?",
    "emotion": "盯著通判",
    "say": "siapa pengantarnya?"
  },
  "zq52a44": {
    "text": "Surat perintah penarikan,",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "Perintah penarikan,"
  },
  "zq52a45": {
    "text": "sudah kutandatangani.",
    "emotion": "畫外，落印"
  },
  "zq52a46": {
    "text": "Tuan,",
    "emotion": "作揖"
  },
  "zq52a47": {
    "text": "istri saya yang melihatnya.",
    "emotion": "驕傲"
  },
  "zq52a48": {
    "text": "Poin suka A-Ling, lima puluh delapan.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling, lima puluh delapan."
  },
  "zq52a49": {
    "text": "Tanpa kamu,",
    "emotion": "低聲，快，說完就停",
    "say": "Tanpa kamu"
  },
  "zq52a50": {
    "text": "hari ini kita kalah.",
    "emotion": "認真，快，說完就停",
    "say": "kita pasti kalah."
  },
  "zq52a51": {
    "text": "Poin suka Tang Xiaotang, enam puluh satu.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Tang Xiaotang, enam puluh satu."
  },
  "zq52a52": {
    "text": "Kereta tahanan sebelum fajar",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "sudah keluar Gerbang Utara!",
    "emotion": "急，快，說完就停",
    "say": "keluar Gerbang Utara!"
  },
  "zq52a54": {
    "text": "Pengawalnya,",
    "emotion": "壓低"
  },
  "zq52a55": {
    "text": "bukan orang prefektur!",
    "emotion": "咬牙，快，說完就停"
  },
  "zq52a56": {
    "text": "Begitu keluar kota,",
    "emotion": "畫外，快，說完就停",
    "say": "Keluar kota,"
  },
  "zq52a57": {
    "text": "dia hilang.",
    "emotion": "畫外，一字一字"
  }
}
