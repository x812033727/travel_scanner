{
  "zq52a01": {
    "text": "本物の印の「州」の字、",
    "emotion": "畫外，很輕，很篤定",
    "say": "本物の「州」の字、"
  },
  "zq52a02": {
    "text": "この一画、",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "途切れているの。",
    "emotion": "冷",
    "say": "切れてる。"
  },
  "zq52a04": {
    "text": "アーリン、どうして……",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "聞かなくていい。",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "いい。"
  },
  "zq52a06": {
    "text": "俺は彼女を信じる。",
    "emotion": "看著阿令",
    "say": "信じる。"
  },
  "zq52a07": {
    "text": "偽物だと証明するには、",
    "emotion": "想事情",
    "say": "偽物と示すには、"
  },
  "zq52a08": {
    "text": "本物と比べないと。",
    "emotion": "低聲",
    "say": "本物が要る。"
  },
  "zq52a09": {
    "text": "チン将軍の娘さんが、",
    "emotion": "粗啞，快，說完就停",
    "say": "将軍の娘、"
  },
  "zq52a10": {
    "text": "本当に州の牢に入れられたのか？",
    "emotion": "喘著氣",
    "say": "本当に牢に？"
  },
  "zq52a11": {
    "text": "あの子に手を出す奴は、",
    "emotion": "咬牙",
    "say": "手を出す奴は、"
  },
  "zq52a12": {
    "text": "わしが刺し違えてやる！",
    "emotion": "吼",
    "say": "叩き潰す！"
  },
  "zq52a13": {
    "text": "ドゥおじさん、",
    "emotion": "按住他",
    "say": "ドゥさん、"
  },
  "zq52a14": {
    "text": "州の牢を見張ってくれ。",
    "emotion": "低聲交代",
    "say": "牢を見張ってくれ。"
  },
  "zq52a15": {
    "text": "知府の奥方には、",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "奥方には、"
  },
  "zq52a16": {
    "text": "私が話をつける。",
    "emotion": "很有把握",
    "say": "任せて。"
  },
  "zq52a17": {
    "text": "知府殿は留守だ、",
    "emotion": "頭也不抬，快，說完就停",
    "say": "知府は留守、"
  },
  "zq52a18": {
    "text": "用件は本官に申せ。",
    "emotion": "倨傲",
    "say": "本官に申せ。"
  },
  "zq52a19": {
    "text": "この逮捕状の、",
    "emotion": "作揖，很客氣"
  },
  "zq52a20": {
    "text": "印は偽物です。",
    "emotion": "快，說完就停",
    "say": "印は偽物。"
  },
  "zq52a21": {
    "text": "州府の大印は、",
    "emotion": "冷笑"
  },
  "zq52a22": {
    "text": "本官がこの目で押すのを見た！",
    "emotion": "拍案",
    "say": "この目で見た！"
  },
  "zq52a23": {
    "text": "なら、見間違いね。",
    "emotion": "冷冷的，不客氣",
    "say": "見間違いよ。"
  },
  "zq52a24": {
    "text": "無礼者！",
    "emotion": "翻臉"
  },
  "zq52a25": {
    "text": "つまみ出せ！",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "待て。",
    "emotion": "不慌不忙"
  },
  "zq52a27": {
    "text": "これは？",
    "emotion": "笑"
  },
  "zq52a28": {
    "text": "州府が出した解元の喜報だ。",
    "emotion": "畫外，一字一字",
    "say": "解元の喜報だ。"
  },
  "zq52a29": {
    "text": "二つの印を、",
    "emotion": "很穩，快，說完就停",
    "say": "二つを、"
  },
  "zq52a30": {
    "text": "灯りにかざして見ろ。",
    "emotion": "舉起來",
    "say": "かざして見ろ。"
  },
  "zq52a31": {
    "text": "一画違う。",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "一画の差など、",
    "emotion": "嘴硬，快，說完就停",
    "say": "一画など、"
  },
  "zq52a33": {
    "text": "何だというのだ？",
    "emotion": "結巴",
    "say": "何になる？"
  },
  "zq52a34": {
    "text": "奥様、",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "州府の印を使って人を捕らえた者がいます。",
    "emotion": "壓低聲音",
    "say": "印を騙る者が。"
  },
  "zq52a36": {
    "text": "何かあれば、",
    "emotion": "一字一字"
  },
  "zq52a37": {
    "text": "責めを負うのは知府様です。",
    "emotion": "算盤打得精",
    "say": "罪を被るのは知府様。"
  },
  "zq52a38": {
    "text": "誰か、",
    "emotion": "放下茶碗"
  },
  "zq52a39": {
    "text": "旦那様を呼び戻して。",
    "emotion": "很定",
    "say": "主人を呼んで。"
  },
  "zq52a40": {
    "text": "本府の印は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "我が印、"
  },
  "zq52a41": {
    "text": "本府が自ら確かめる。",
    "emotion": "低",
    "say": "自ら確かめる。"
  },
  "zq52a42": {
    "text": "この公文、",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "誰が届けた？",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "追回令、",
    "emotion": "畫外，極短促，一口氣說完，不拖音"
  },
  "zq52a45": {
    "text": "本府が署名した。",
    "emotion": "畫外，落印",
    "say": "署名した。"
  },
  "zq52a46": {
    "text": "閣下、",
    "emotion": "作揖"
  },
  "zq52a47": {
    "text": "見抜いたのは私の妻です。",
    "emotion": "驕傲",
    "say": "妻が見抜きました。"
  },
  "zq52a48": {
    "text": "アーリン、好感度、五十八。",
    "emotion": "平板電子音，叮一聲",
    "say": "アーリン、五十八。"
  },
  "zq52a49": {
    "text": "君がいなきゃ、",
    "emotion": "低聲，快，說完就停",
    "say": "君なし、"
  },
  "zq52a50": {
    "text": "今日は負けてた。",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "タン・シャオタン、好感度、六十一。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a52": {
    "text": "囚人車が夜明け前に、",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "北門を出た！",
    "emotion": "急"
  },
  "zq52a54": {
    "text": "護送してたのは、",
    "emotion": "壓低，快，說完就停",
    "say": "護送は、"
  },
  "zq52a55": {
    "text": "州府の者じゃねえ！",
    "emotion": "咬牙"
  },
  "zq52a56": {
    "text": "町を出たら、",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "城を出たら、"
  },
  "zq52a57": {
    "text": "もう取り戻せん。",
    "emotion": "畫外，一字一字",
    "say": "もう終わりだ。"
  }
}
