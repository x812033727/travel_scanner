{
  "zq52a01": {
    "text": "No selo verdadeiro, o caractere “Zhou”,",
    "emotion": "畫外，很輕，很篤定",
    "say": "No verdadeiro, o “Zhou”,"
  },
  "zq52a02": {
    "text": "este traço,",
    "emotion": "淡淡的，快，說完就停",
    "say": "o traço,"
  },
  "zq52a03": {
    "text": "está cortado.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "A-Ling, como você…",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "Não pergunte.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Deixa."
  },
  "zq52a06": {
    "text": "Eu confio nela.",
    "emotion": "看著阿令",
    "say": "Confio nela."
  },
  "zq52a07": {
    "text": "Pra provar que é falso,",
    "emotion": "想事情"
  },
  "zq52a08": {
    "text": "precisamos de um verdadeiro pra comparar.",
    "emotion": "低聲",
    "say": "falta um verdadeiro."
  },
  "zq52a09": {
    "text": "A filha do general Qin",
    "emotion": "粗啞，快，說完就停",
    "say": "A filha do Qin"
  },
  "zq52a10": {
    "text": "tá mesmo presa na cadeia da prefeitura?",
    "emotion": "粗啞，快，說完就停",
    "say": "tá presa mesmo?"
  },
  "zq52a11": {
    "text": "Quem tocar nela,",
    "emotion": "咬牙，快，說完就停"
  },
  "zq52a12": {
    "text": "vai se ver comigo!",
    "emotion": "吼"
  },
  "zq52a13": {
    "text": "Tio Du,",
    "emotion": "按住他"
  },
  "zq52a14": {
    "text": "vigia a cadeia da prefeitura pra mim.",
    "emotion": "低聲，快，說完就停",
    "say": "vigia a cadeia."
  },
  "zq52a15": {
    "text": "A esposa do prefeito,",
    "emotion": "眼睛一亮"
  },
  "zq52a16": {
    "text": "deixa comigo.",
    "emotion": "很有把握"
  },
  "zq52a17": {
    "text": "O prefeito não está,",
    "emotion": "頭也不抬，極短促，一口氣說完，不拖音",
    "say": "Prefeito saiu,"
  },
  "zq52a18": {
    "text": "qualquer coisa, falem comigo.",
    "emotion": "倨傲",
    "say": "falem comigo."
  },
  "zq52a19": {
    "text": "Este mandado de prisão",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Este mandado"
  },
  "zq52a20": {
    "text": "tem o selo falso.",
    "emotion": "一字一字"
  },
  "zq52a21": {
    "text": "O grande selo da prefeitura,",
    "emotion": "冷冷的，快，說完就停",
    "say": "O grande selo,"
  },
  "zq52a22": {
    "text": "eu vi carimbarem com meus próprios olhos!",
    "emotion": "拍案",
    "say": "eu vi carimbarem!"
  },
  "zq52a23": {
    "text": "Então viu errado.",
    "emotion": "冷冷的，快，說完就停"
  },
  "zq52a24": {
    "text": "Que insolência!",
    "emotion": "翻臉，極短促，一口氣說完，不拖音",
    "say": "Basta!"
  },
  "zq52a25": {
    "text": "Ponham eles pra fora!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "Esperem.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Calma."
  },
  "zq52a27": {
    "text": "E isto?",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a28": {
    "text": "O aviso oficial de aprovação que a prefeitura me mandou, como primeiro do exame provincial.",
    "emotion": "畫外，快，說完就停",
    "say": "Meu aviso oficial."
  },
  "zq52a29": {
    "text": "Dois selos,",
    "emotion": "很穩"
  },
  "zq52a30": {
    "text": "olhem contra a luz.",
    "emotion": "舉起來",
    "say": "contra a luz."
  },
  "zq52a31": {
    "text": "Um traço diferente.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "Um traço de diferença,",
    "emotion": "嘴硬",
    "say": "Um traço,"
  },
  "zq52a33": {
    "text": "o que isso prova?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "Senhora,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "alguém usa o selo da prefeitura pra prender gente.",
    "emotion": "壓低聲音",
    "say": "usam o selo pra prender."
  },
  "zq52a36": {
    "text": "Se der problema,",
    "emotion": "快，說完就停"
  },
  "zq52a37": {
    "text": "quem leva a culpa é o prefeito.",
    "emotion": "算盤打得精",
    "say": "a culpa é do prefeito."
  },
  "zq52a38": {
    "text": "Alguém venha!",
    "emotion": "放下茶碗",
    "say": "Venham!"
  },
  "zq52a39": {
    "text": "Chamem meu marido pra casa.",
    "emotion": "很定",
    "say": "Chamem meu marido."
  },
  "zq52a40": {
    "text": "Meu selo,",
    "emotion": "沉穩，不怒自威"
  },
  "zq52a41": {
    "text": "eu mesmo confiro.",
    "emotion": "低"
  },
  "zq52a42": {
    "text": "Este mandado,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "quem trouxe?",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "A ordem de retorno do preso,",
    "emotion": "畫外，沉聲",
    "say": "A ordem,"
  },
  "zq52a45": {
    "text": "eu assinei.",
    "emotion": "畫外，落印"
  },
  "zq52a46": {
    "text": "Excelência,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Veja,"
  },
  "zq52a47": {
    "text": "foi minha esposa que percebeu.",
    "emotion": "驕傲，快，說完就停",
    "say": "minha esposa viu."
  },
  "zq52a48": {
    "text": "A-Ling, afeição: cinquenta e oito.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling: cinquenta e oito."
  },
  "zq52a49": {
    "text": "Sem você,",
    "emotion": "低聲，快，說完就停",
    "say": "Sem você"
  },
  "zq52a50": {
    "text": "hoje a gente perdia.",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "Tang Xiaotang, afeição: sessenta e um.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Tang Xiaotang: sessenta e um."
  },
  "zq52a52": {
    "text": "A carroça de presos, antes do amanhecer,",
    "emotion": "喘著吼",
    "say": "A carroça, antes do sol,"
  },
  "zq52a53": {
    "text": "saiu pelo Portão Norte!",
    "emotion": "急"
  },
  "zq52a54": {
    "text": "Quem escolta",
    "emotion": "壓低"
  },
  "zq52a55": {
    "text": "não é da prefeitura!",
    "emotion": "咬牙"
  },
  "zq52a56": {
    "text": "Saiu da cidade,",
    "emotion": "畫外，快，說完就停",
    "say": "Lá fora,"
  },
  "zq52a57": {
    "text": "ela some.",
    "emotion": "畫外，一字一字"
  }
}
