{
  "zq52a01": {
    "text": "Chữ 'Châu' trên ấn thật,",
    "emotion": "畫外，很輕，很篤定"
  },
  "zq52a02": {
    "text": "nét này,",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "bị đứt.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "A Lệnh, sao cô lại…",
    "emotion": "又驚又好奇",
    "say": "A Lệnh, sao cô…"
  },
  "zq52a05": {
    "text": "Không cần hỏi.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a06": {
    "text": "Ta tin nàng.",
    "emotion": "看著阿令"
  },
  "zq52a07": {
    "text": "Muốn chứng minh là giả,",
    "emotion": "想事情"
  },
  "zq52a08": {
    "text": "phải có cái thật để so.",
    "emotion": "低聲"
  },
  "zq52a09": {
    "text": "Con gái Tần tướng quân,",
    "emotion": "粗啞，急"
  },
  "zq52a10": {
    "text": "thật bị giam vào ngục châu rồi sao?",
    "emotion": "喘著氣",
    "say": "thật bị giam rồi sao?"
  },
  "zq52a11": {
    "text": "Kẻ nào dám động đến cô ấy,",
    "emotion": "咬牙"
  },
  "zq52a12": {
    "text": "lão tử liều mạng với hắn!",
    "emotion": "吼",
    "say": "ta liều mạng!"
  },
  "zq52a13": {
    "text": "Đỗ thúc,",
    "emotion": "按住他"
  },
  "zq52a14": {
    "text": "canh ngục châu giúp ta.",
    "emotion": "低聲，快，說完就停",
    "say": "canh ngục giúp ta."
  },
  "zq52a15": {
    "text": "Bên tri phủ phu nhân,",
    "emotion": "眼睛一亮"
  },
  "zq52a16": {
    "text": "để ta nói.",
    "emotion": "很有把握"
  },
  "zq52a17": {
    "text": "Tri phủ đại nhân không có ở đây,",
    "emotion": "拖長音，頭也不抬",
    "say": "Tri phủ đi vắng,"
  },
  "zq52a18": {
    "text": "có việc gì nói với bổn quan.",
    "emotion": "倨傲",
    "say": "nói với bổn quan."
  },
  "zq52a19": {
    "text": "Công văn truy bắt này,",
    "emotion": "作揖，很客氣"
  },
  "zq52a20": {
    "text": "ấn là giả.",
    "emotion": "一字一字"
  },
  "zq52a21": {
    "text": "Đại ấn châu phủ,",
    "emotion": "冷笑"
  },
  "zq52a22": {
    "text": "bổn quan tận mắt nhìn đóng!",
    "emotion": "拍案"
  },
  "zq52a23": {
    "text": "Vậy là ngươi nhìn lầm.",
    "emotion": "冷冷的，不客氣"
  },
  "zq52a24": {
    "text": "Láo xược!",
    "emotion": "翻臉"
  },
  "zq52a25": {
    "text": "Đuổi ra ngoài!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "Khoan đã.",
    "emotion": "低聲，快，說完就停",
    "say": "Đợi."
  },
  "zq52a27": {
    "text": "Cái này thì sao?",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Cái này?"
  },
  "zq52a28": {
    "text": "Hỷ báo giải nguyên châu phủ phát.",
    "emotion": "畫外，快，說完就停",
    "say": "Hỷ báo giải nguyên."
  },
  "zq52a29": {
    "text": "Hai con ấn,",
    "emotion": "很穩，極短促，一口氣說完，不拖音",
    "say": "Hai ấn,"
  },
  "zq52a30": {
    "text": "soi dưới đèn.",
    "emotion": "舉起來"
  },
  "zq52a31": {
    "text": "Lệch một nét.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "Chênh một nét,",
    "emotion": "嘴硬"
  },
  "zq52a33": {
    "text": "thì đã sao?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "Phu nhân,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "có kẻ mượn ấn châu phủ để bắt người.",
    "emotion": "壓低聲音"
  },
  "zq52a36": {
    "text": "Có chuyện gì,",
    "emotion": "一字一字"
  },
  "zq52a37": {
    "text": "người gánh tội là tri phủ đại nhân.",
    "emotion": "算盤打得精",
    "say": "tri phủ gánh tội."
  },
  "zq52a38": {
    "text": "Người đâu,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a39": {
    "text": "mời lão gia về phủ.",
    "emotion": "很定"
  },
  "zq52a40": {
    "text": "Ấn của bổn phủ,",
    "emotion": "沉穩，不怒自威"
  },
  "zq52a41": {
    "text": "bổn phủ tự nhận.",
    "emotion": "低"
  },
  "zq52a42": {
    "text": "Công văn này,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "ai đưa tới?",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "Lệnh truy hồi,",
    "emotion": "畫外，極短促，一口氣說完，不拖音"
  },
  "zq52a45": {
    "text": "bổn phủ đã ký.",
    "emotion": "畫外，落印"
  },
  "zq52a46": {
    "text": "Đại nhân,",
    "emotion": "作揖"
  },
  "zq52a47": {
    "text": "là nương tử của tại hạ nhìn ra.",
    "emotion": "驕傲，快，說完就停",
    "say": "nương tử tại hạ nhìn ra."
  },
  "zq52a48": {
    "text": "A Lệnh hảo cảm, năm mươi tám.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a49": {
    "text": "Không có cô,",
    "emotion": "低聲，快，說完就停",
    "say": "Không có cô"
  },
  "zq52a50": {
    "text": "hôm nay đã thua rồi.",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "Đường Tiểu Đường hảo cảm, sáu mươi mốt.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a52": {
    "text": "Xe tù trời chưa sáng",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "đã ra cửa Bắc!",
    "emotion": "急"
  },
  "zq52a54": {
    "text": "Kẻ áp giải,",
    "emotion": "壓低"
  },
  "zq52a55": {
    "text": "không phải người châu phủ!",
    "emotion": "咬牙"
  },
  "zq52a56": {
    "text": "Ra khỏi thành,",
    "emotion": "畫外，快，說完就停",
    "say": "Ra thành,"
  },
  "zq52a57": {
    "text": "là mất người.",
    "emotion": "畫外，一字一字"
  }
}
