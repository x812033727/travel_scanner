{
  "zq52a01": {
    "text": "On the real seal, the character 'Zhou',",
    "emotion": "畫外，很輕，很篤定",
    "say": "The real seal's 'Zhou',"
  },
  "zq52a02": {
    "text": "this stroke,",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "is broken.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "A-Ling, how did you…",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "No need to ask.",
    "emotion": "抬手攔住，很穩",
    "say": "Don't ask."
  },
  "zq52a06": {
    "text": "I trust her.",
    "emotion": "看著阿令"
  },
  "zq52a07": {
    "text": "To prove it's fake,",
    "emotion": "想事情"
  },
  "zq52a08": {
    "text": "we need a real one to compare.",
    "emotion": "低聲",
    "say": "we need a real one."
  },
  "zq52a09": {
    "text": "General Qin's daughter,",
    "emotion": "粗啞，急"
  },
  "zq52a10": {
    "text": "is she really in the prefecture jail?",
    "emotion": "喘著氣",
    "say": "really in the prefecture jail?"
  },
  "zq52a11": {
    "text": "Whoever touches her,",
    "emotion": "咬牙"
  },
  "zq52a12": {
    "text": "I'll fight him to the death!",
    "emotion": "吼",
    "say": "I'll fight him!"
  },
  "zq52a13": {
    "text": "Uncle Du,",
    "emotion": "按住他"
  },
  "zq52a14": {
    "text": "watch the prefecture jail for me.",
    "emotion": "低聲交代",
    "say": "watch the jail for me."
  },
  "zq52a15": {
    "text": "The prefect's wife,",
    "emotion": "眼睛一亮，快，說完就停",
    "say": "Prefect's wife,"
  },
  "zq52a16": {
    "text": "I'll talk to her.",
    "emotion": "很有把握",
    "say": "I'll go."
  },
  "zq52a17": {
    "text": "His Excellency the prefect is out,",
    "emotion": "頭也不抬，快，說完就停",
    "say": "Prefect's out,"
  },
  "zq52a18": {
    "text": "bring your business to me.",
    "emotion": "倨傲"
  },
  "zq52a19": {
    "text": "This arrest warrant,",
    "emotion": "作揖，快，說完就停",
    "say": "This warrant,"
  },
  "zq52a20": {
    "text": "its seal is forged.",
    "emotion": "一字一字",
    "say": "its seal is fake."
  },
  "zq52a21": {
    "text": "The prefecture's great seal,",
    "emotion": "冷冷的，快，說完就停"
  },
  "zq52a22": {
    "text": "I watched it stamped with my own eyes!",
    "emotion": "拍案",
    "say": "I watched it stamped myself!"
  },
  "zq52a23": {
    "text": "Then you saw wrong.",
    "emotion": "冷冷的，不客氣"
  },
  "zq52a24": {
    "text": "How dare you!",
    "emotion": "翻臉",
    "say": "Insolence!"
  },
  "zq52a25": {
    "text": "Throw them out!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "Wait.",
    "emotion": "不慌不忙"
  },
  "zq52a27": {
    "text": "What about this?",
    "emotion": "低聲，快，說完就停",
    "say": "And this?"
  },
  "zq52a28": {
    "text": "My Jieyuan results notice, issued by the prefecture.",
    "emotion": "畫外，快，說完就停",
    "say": "The prefecture's notice."
  },
  "zq52a29": {
    "text": "Two seals,",
    "emotion": "很穩"
  },
  "zq52a30": {
    "text": "hold them to the light.",
    "emotion": "舉起來",
    "say": "to the light."
  },
  "zq52a31": {
    "text": "One stroke off.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "One stroke's difference,",
    "emotion": "嘴硬",
    "say": "One stroke,"
  },
  "zq52a33": {
    "text": "what does that prove?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "Madam,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "someone is using the prefecture's seal to arrest people.",
    "emotion": "壓低聲音",
    "say": "someone's misusing your seal."
  },
  "zq52a36": {
    "text": "If it goes wrong,",
    "emotion": "一字一字",
    "say": "If it blows up,"
  },
  "zq52a37": {
    "text": "it's His Excellency who takes the blame.",
    "emotion": "算盤打得精",
    "say": "the prefect takes the blame."
  },
  "zq52a38": {
    "text": "Someone!",
    "emotion": "放下茶碗"
  },
  "zq52a39": {
    "text": "Ask the master to come home.",
    "emotion": "很定",
    "say": "fetch my husband."
  },
  "zq52a40": {
    "text": "This prefect's seal,",
    "emotion": "沉穩，不怒自威",
    "say": "My seal,"
  },
  "zq52a41": {
    "text": "I'll judge it myself.",
    "emotion": "低"
  },
  "zq52a42": {
    "text": "This warrant,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "who brought it?",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "The recall order,",
    "emotion": "畫外，沉聲",
    "say": "Recall order,"
  },
  "zq52a45": {
    "text": "I've signed it.",
    "emotion": "畫外，落印"
  },
  "zq52a46": {
    "text": "Your Excellency,",
    "emotion": "作揖",
    "say": "Sir,"
  },
  "zq52a47": {
    "text": "it was my wife who spotted it.",
    "emotion": "驕傲",
    "say": "my wife spotted it."
  },
  "zq52a48": {
    "text": "A-Ling, affection: fifty-eight.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: fifty-eight."
  },
  "zq52a49": {
    "text": "Without you,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Without you"
  },
  "zq52a50": {
    "text": "we'd have lost today.",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "Tang Xiaotang, affection: sixty-one.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a52": {
    "text": "The prison cart, before dawn,",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "went out the North Gate!",
    "emotion": "急，快，說完就停",
    "say": "out the North Gate!"
  },
  "zq52a54": {
    "text": "The escorts",
    "emotion": "壓低"
  },
  "zq52a55": {
    "text": "aren't prefecture men!",
    "emotion": "咬牙"
  },
  "zq52a56": {
    "text": "Once they're out of the city,",
    "emotion": "畫外，啞",
    "say": "Out of the city,"
  },
  "zq52a57": {
    "text": "she's gone.",
    "emotion": "畫外，一字一字"
  }
}
