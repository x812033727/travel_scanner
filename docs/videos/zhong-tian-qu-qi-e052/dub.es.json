{
  "zq52a01": {
    "text": "En el sello verdadero, el carácter «Zhou»,",
    "emotion": "畫外，很輕，很篤定",
    "say": "En el verdadero, «Zhou»,"
  },
  "zq52a02": {
    "text": "este trazo,",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "está cortado.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "A-Ling, ¿cómo supiste…?",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "No preguntes.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "No."
  },
  "zq52a06": {
    "text": "Confío en ella.",
    "emotion": "看著阿令"
  },
  "zq52a07": {
    "text": "Para probar que es falso,",
    "emotion": "想事情"
  },
  "zq52a08": {
    "text": "hay que compararlo con uno verdadero.",
    "emotion": "低聲",
    "say": "falta uno verdadero."
  },
  "zq52a09": {
    "text": "¿La hija del general Qin",
    "emotion": "粗啞，快，說完就停",
    "say": "¿La hija de Qin"
  },
  "zq52a10": {
    "text": "de verdad está presa en la cárcel de la prefectura?",
    "emotion": "喘著氣",
    "say": "de verdad está presa?"
  },
  "zq52a11": {
    "text": "Quien la toque,",
    "emotion": "咬牙"
  },
  "zq52a12": {
    "text": "¡se las ve conmigo!",
    "emotion": "吼",
    "say": "¡lo mato!"
  },
  "zq52a13": {
    "text": "Tío Du,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tío,"
  },
  "zq52a14": {
    "text": "vigila la cárcel de la prefectura por mí.",
    "emotion": "低聲交代",
    "say": "vigila la cárcel."
  },
  "zq52a15": {
    "text": "Con la esposa del prefecto,",
    "emotion": "眼睛一亮"
  },
  "zq52a16": {
    "text": "hablo yo.",
    "emotion": "很有把握"
  },
  "zq52a17": {
    "text": "El señor prefecto no está,",
    "emotion": "拖長音，頭也不抬",
    "say": "El prefecto no está,"
  },
  "zq52a18": {
    "text": "lo que sea, díganmelo a mí.",
    "emotion": "倨傲",
    "say": "díganmelo a mí."
  },
  "zq52a19": {
    "text": "Esta orden de arresto",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Esta orden"
  },
  "zq52a20": {
    "text": "tiene el sello falso.",
    "emotion": "一字一字"
  },
  "zq52a21": {
    "text": "¡El gran sello de la prefectura",
    "emotion": "冷冷的，快，說完就停"
  },
  "zq52a22": {
    "text": "lo vi estampar con mis propios ojos!",
    "emotion": "拍案",
    "say": "lo vi estampar yo mismo!"
  },
  "zq52a23": {
    "text": "Entonces vio mal.",
    "emotion": "冷冷的，不客氣"
  },
  "zq52a24": {
    "text": "¡Insolente!",
    "emotion": "翻臉，極短促，一口氣說完，不拖音",
    "say": "¡Basta!"
  },
  "zq52a25": {
    "text": "¡Sáquenlos de aquí!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "Un momento.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Alto."
  },
  "zq52a27": {
    "text": "¿Y esto?",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a28": {
    "text": "La notificación oficial de mi aprobado como primero del examen provincial, de la prefectura.",
    "emotion": "畫外，快，說完就停",
    "say": "Mi aviso oficial."
  },
  "zq52a29": {
    "text": "Dos sellos,",
    "emotion": "很穩"
  },
  "zq52a30": {
    "text": "mírenlos a contraluz.",
    "emotion": "舉起來",
    "say": "a contraluz."
  },
  "zq52a31": {
    "text": "Un trazo distinto.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "Un trazo de diferencia,",
    "emotion": "嘴硬",
    "say": "Un trazo,"
  },
  "zq52a33": {
    "text": "¿qué importa?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "Señora,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "alguien usa el sello de la prefectura para arrestar gente.",
    "emotion": "壓低聲音",
    "say": "usan su sello para arrestar."
  },
  "zq52a36": {
    "text": "Si algo sale mal,",
    "emotion": "快，說完就停",
    "say": "Si sale mal,"
  },
  "zq52a37": {
    "text": "quien paga es el señor prefecto.",
    "emotion": "算盤打得精",
    "say": "lo paga el prefecto."
  },
  "zq52a38": {
    "text": "¡Que venga alguien!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡Oigan!"
  },
  "zq52a39": {
    "text": "Llamen a mi esposo a casa.",
    "emotion": "很定",
    "say": "Traigan a mi esposo."
  },
  "zq52a40": {
    "text": "Mi propio sello,",
    "emotion": "沉穩，快，說完就停",
    "say": "Mi sello,"
  },
  "zq52a41": {
    "text": "lo reconozco yo.",
    "emotion": "低"
  },
  "zq52a42": {
    "text": "Esta orden,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "¿quién la trajo?",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "La orden de devolución del preso,",
    "emotion": "畫外，沉聲",
    "say": "La orden,"
  },
  "zq52a45": {
    "text": "la he firmado.",
    "emotion": "畫外，落印",
    "say": "firmada."
  },
  "zq52a46": {
    "text": "Señor,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Mire,"
  },
  "zq52a47": {
    "text": "fue mi esposa quien lo vio.",
    "emotion": "驕傲",
    "say": "lo vio mi esposa."
  },
  "zq52a48": {
    "text": "A-Ling, afecto: cincuenta y ocho.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a49": {
    "text": "Sin ti,",
    "emotion": "認真"
  },
  "zq52a50": {
    "text": "hoy habríamos perdido.",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "Tang Xiaotang, afecto: sesenta y uno.",
    "emotion": "平板電子音，叮一聲",
    "say": "Tang Xiaotang: sesenta y uno."
  },
  "zq52a52": {
    "text": "¡El carro de presos, antes del alba,",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "salió por la Puerta Norte!",
    "emotion": "急，快，說完就停",
    "say": "¡por la Puerta Norte!"
  },
  "zq52a54": {
    "text": "¡Los que lo escoltan",
    "emotion": "壓低，快，說完就停",
    "say": "¡Los escoltas"
  },
  "zq52a55": {
    "text": "no son de la prefectura!",
    "emotion": "咬牙，快，說完就停",
    "say": "¡no son guardias!"
  },
  "zq52a56": {
    "text": "Fuera de la ciudad,",
    "emotion": "畫外，快，說完就停",
    "say": "Ya fuera,"
  },
  "zq52a57": {
    "text": "la perdemos para siempre.",
    "emotion": "畫外，一字一字",
    "say": "la perdemos."
  }
}
