{
  "zq52a01": {
    "text": "진짜 인장의 '주' 자,",
    "emotion": "畫外，很輕，很篤定",
    "say": "진짜 '주' 자,"
  },
  "zq52a02": {
    "text": "이 획이,",
    "emotion": "淡淡的"
  },
  "zq52a03": {
    "text": "끊겨 있어.",
    "emotion": "冷"
  },
  "zq52a04": {
    "text": "아링, 어떻게……",
    "emotion": "又驚又好奇"
  },
  "zq52a05": {
    "text": "묻지 마.",
    "emotion": "抬手攔住，很穩"
  },
  "zq52a06": {
    "text": "난 저 사람 믿어.",
    "emotion": "看著阿令",
    "say": "믿어."
  },
  "zq52a07": {
    "text": "가짜라는 걸 증명하려면,",
    "emotion": "想事情",
    "say": "가짜란 걸 밝히려면,"
  },
  "zq52a08": {
    "text": "진짜와 비교해야 해.",
    "emotion": "低聲",
    "say": "진짜가 있어야 해."
  },
  "zq52a09": {
    "text": "친 장군의 따님이,",
    "emotion": "粗啞，急"
  },
  "zq52a10": {
    "text": "정말 주 감옥에 갇혔소?",
    "emotion": "喘著氣",
    "say": "정말 갇혔소?"
  },
  "zq52a11": {
    "text": "누구든 손대면,",
    "emotion": "咬牙"
  },
  "zq52a12": {
    "text": "내가 끝장을 본다!",
    "emotion": "吼",
    "say": "가만 안 둬!"
  },
  "zq52a13": {
    "text": "두 아저씨,",
    "emotion": "按住他，快，說完就停",
    "say": "아저씨,"
  },
  "zq52a14": {
    "text": "주 감옥을 지켜봐 주세요.",
    "emotion": "低聲交代",
    "say": "감옥 좀 봐 주세요."
  },
  "zq52a15": {
    "text": "지부 부인 쪽은,",
    "emotion": "眼睛一亮"
  },
  "zq52a16": {
    "text": "내가 갈게.",
    "emotion": "很有把握"
  },
  "zq52a17": {
    "text": "지부 대인은 안 계시니,",
    "emotion": "頭也不抬，快，說完就停",
    "say": "지부는 출타,"
  },
  "zq52a18": {
    "text": "일이 있으면 본관에게 말하라.",
    "emotion": "倨傲",
    "say": "본관에게 말하라."
  },
  "zq52a19": {
    "text": "이 체포 공문,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "이 공문,"
  },
  "zq52a20": {
    "text": "인장이 가짜입니다.",
    "emotion": "快，說完就停",
    "say": "인장이 가짭니다."
  },
  "zq52a21": {
    "text": "주 관아의 관인은,",
    "emotion": "冷笑"
  },
  "zq52a22": {
    "text": "본관이 직접 찍는 걸 봤다!",
    "emotion": "拍案",
    "say": "내가 똑똑히 봤다!"
  },
  "zq52a23": {
    "text": "그럼 잘못 본 거야.",
    "emotion": "冷冷的，不客氣"
  },
  "zq52a24": {
    "text": "무엄하다!",
    "emotion": "翻臉"
  },
  "zq52a25": {
    "text": "끌어내라!",
    "emotion": "吼"
  },
  "zq52a26": {
    "text": "잠깐.",
    "emotion": "不慌不忙"
  },
  "zq52a27": {
    "text": "이건요?",
    "emotion": "笑"
  },
  "zq52a28": {
    "text": "주 관아가 보낸 해원 희보입니다.",
    "emotion": "畫外，快，說完就停",
    "say": "해원 희보입니다."
  },
  "zq52a29": {
    "text": "두 인장을,",
    "emotion": "很穩，極短促，一口氣說完，不拖音",
    "say": "두 인장,"
  },
  "zq52a30": {
    "text": "불빛에 비춰 보시죠.",
    "emotion": "舉起來",
    "say": "불에 비춰 보죠."
  },
  "zq52a31": {
    "text": "한 획 달라.",
    "emotion": "很輕，篤定"
  },
  "zq52a32": {
    "text": "한 획 차이가,",
    "emotion": "嘴硬"
  },
  "zq52a33": {
    "text": "뭐가 대수냐?",
    "emotion": "結巴"
  },
  "zq52a34": {
    "text": "부인,",
    "emotion": "恭敬"
  },
  "zq52a35": {
    "text": "누가 주 관아 인장을 빌려 사람을 잡았어요.",
    "emotion": "壓低聲音",
    "say": "인장을 도용했어요."
  },
  "zq52a36": {
    "text": "일이 터지면,",
    "emotion": "一字一字"
  },
  "zq52a37": {
    "text": "덤터기는 지부 대인이 써요.",
    "emotion": "算盤打得精",
    "say": "책임은 대인 몫이죠."
  },
  "zq52a38": {
    "text": "여봐라,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq52a39": {
    "text": "대감을 모셔 와라.",
    "emotion": "很定",
    "say": "대감 모셔 와라."
  },
  "zq52a40": {
    "text": "내 관인은,",
    "emotion": "沉穩，快，說完就停",
    "say": "내 관인,"
  },
  "zq52a41": {
    "text": "내가 직접 가린다.",
    "emotion": "低，快，說完就停",
    "say": "직접 가린다."
  },
  "zq52a42": {
    "text": "이 공문,",
    "emotion": "壓低聲音"
  },
  "zq52a43": {
    "text": "누가 가져왔나?",
    "emotion": "盯著通判"
  },
  "zq52a44": {
    "text": "추회령,",
    "emotion": "畫外，沉聲"
  },
  "zq52a45": {
    "text": "내가 서명했다.",
    "emotion": "畫外，落印"
  },
  "zq52a46": {
    "text": "대인,",
    "emotion": "作揖"
  },
  "zq52a47": {
    "text": "제 아내가 알아봤습니다.",
    "emotion": "驕傲",
    "say": "아내가 봤습니다."
  },
  "zq52a48": {
    "text": "아링 호감도, 오십팔.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a49": {
    "text": "너 없었으면,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "너 없인,"
  },
  "zq52a50": {
    "text": "오늘 졌을 거야.",
    "emotion": "笑"
  },
  "zq52a51": {
    "text": "탕샤오탕 호감도, 육십일.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq52a52": {
    "text": "호송 수레가 날 새기 전에,",
    "emotion": "喘著吼"
  },
  "zq52a53": {
    "text": "북문을 나갔습니다!",
    "emotion": "急",
    "say": "북문 나갔소!"
  },
  "zq52a54": {
    "text": "호송하는 놈들이,",
    "emotion": "壓低，快，說完就停",
    "say": "호송꾼들,"
  },
  "zq52a55": {
    "text": "주 관아 사람이 아닙니다!",
    "emotion": "咬牙",
    "say": "관아 놈들이 아닙니다!"
  },
  "zq52a56": {
    "text": "성을 나가면,",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "나가면,"
  },
  "zq52a57": {
    "text": "사람은 그걸로 끝입니다.",
    "emotion": "畫外，一字一字",
    "say": "끝입니다."
  }
}
