  "lines": {
    "p001": {
      "source_hash": "cd5ce196215d",
      "text": "Bu! Kemarin ke pantai,"
    },
    "p002": {
      "source_hash": "d67850b62da5",
      "text": "aku kena ombak, minum air laut!"
    },
    "p003": {
      "source_hash": "272b879781a8",
      "text": "Asinnya minta ampun!"
    },
    "p004": {
      "source_hash": "b5bcb90b3b2e",
      "text": "Aku juga pernah,"
    },
    "p005": {
      "source_hash": "13d973705344",
      "text": "mukaku sampai mengerut."
    },
    "p006": {
      "source_hash": "fe4ed8048350",
      "text": "Pas pulang, aku lihat sungai"
    },
    "p007": {
      "source_hash": "098f86ba8a9a",
      "text": "terus masuk ke laut."
    },
    "p008": {
      "source_hash": "30fd04e96bca",
      "text": "Sungai tawar,"
    },
    "p009": {
      "source_hash": "8e3336ea2135",
      "text": "kok laut tak jadi tawar?"
    },
    "p010": {
      "source_hash": "60d7d66374cb",
      "text": "Bagus! Tiap hari sungai sedunia menuang air tawar,"
    },
    "p011": {
      "source_hash": "32043e11a1ae",
      "text": "tapi lautnya tak pernah jadi tawar."
    },
    "p012": {
      "source_hash": "9fb86b4ff153",
      "text": "Tahu!"
    },
    "p013": {
      "source_hash": "a44197e54d36",
      "text": "Gunung garam di dasar menyembur!"
    },
    "p014": {
      "source_hash": "dcd0e28d9715",
      "text": "Gunung garam? Masuk akal."
    },
    "p015": {
      "source_hash": "fbfbc558cddd",
      "text": "Tapi ada rahasia di dasar. Nanti ya."
    },
    "p016": {
      "source_hash": "a2170542e958",
      "text": "Katamu sungai tawar,"
    },
    "p017": {
      "source_hash": "e5a4c422f785",
      "text": "benar tak bergaram?"
    },
    "p018": {
      "source_hash": "20b89c24e5ec",
      "text": "Laut ibarat sup terus direbus."
    },
    "p019": {
      "source_hash": "aa20f1c35e09",
      "text": "Diberi air terus, kok tetap asin?"
    },
    "p020": {
      "source_hash": "01d491f45b77",
      "text": "Air sungai diam-diam membawa garam."
    },
    "p021": {
      "source_hash": "c55844f8466c",
      "text": "Tapi rasanya tawar, kok!"
    },
    "p022": {
      "source_hash": "52770e32db76",
      "text": "Sedikit sekali,"
    },
    "p023": {
      "source_hash": "58372e92a51b",
      "text": "sampai tak terasa."
    },
    "p024": {
      "source_hash": "4a2deb18e48f",
      "text": "Garamnya dari batu gunung."
    },
    "p025": {
      "source_hash": "918a764b36b9",
      "text": "Hujan agak asam, bertahun-tahun pelan-pelan menggigit batu."
    },
    "p026": {
      "source_hash": "3e4d51bb9036",
      "text": "Hujan bisa gigit batu?"
    },
    "p027": {
      "source_hash": "6a3ea68e0de4",
      "text": "Ya, pelan sekali, bertahun-tahun."
    },
    "p028": {
      "source_hash": "000e9236fdfa",
      "text": "Benda-benda kecil di batu pun larut ke air."
    },
    "p029": {
      "source_hash": "7f2369e1a9e2",
      "text": "Yang tak terlihat ini ikut sungai turun gunung."
    },
    "p030": {
      "source_hash": "89c028f518ce",
      "text": "Kayak gula,"
    },
    "p031": {
      "source_hash": "aa65f18ebfa4",
      "text": "hilang di air?"
    },
    "p032": {
      "source_hash": "a70940fc6c69",
      "text": "Ya, nyaris tak terasa."
    },
    "p033": {
      "source_hash": "b05c8534b323",
      "text": "Sebagian adalah bahan garam dapur."
    },
    "p034": {
      "source_hash": "c99c2bf93c15",
      "text": "Garamnya tak numpuk di sungai?"
    },
    "p035": {
      "source_hash": "38d8eb24a7a2",
      "text": "Air sungai terus diganti hujan,"
    },
    "p036": {
      "source_hash": "d8103784611b",
      "text": "garam keburu terbawa ke laut."
    },
    "p037": {
      "source_hash": "94e30595496a",
      "text": "Yang disebut air tawar,"
    },
    "p038": {
      "source_hash": "0c5e032e1536",
      "text": "garamnya tak sampai 1/30 laut."
    },
    "p039": {
      "source_hash": "020e0766f6f1",
      "text": "Cuma sedikit,"
    },
    "p040": {
      "source_hash": "c0e6101f36d3",
      "text": "kok bisa bikin laut jadi asin?"
    },
    "p041": {
      "source_hash": "553a357fc1a7",
      "text": "Tapi pikir, semua sungai sedunia,"
    },
    "p042": {
      "source_hash": "52efa69d58bb",
      "text": "setahun bawa sekitar 4 miliar ton garam ke laut."
    },
    "p043": {
      "source_hash": "99c70032b04a",
      "text": "4 miliar ton!"
    },
    "p044": {
      "source_hash": "4bbce78c06f9",
      "text": "Sedikit, dikali banyak sungai dan banyak tahun,"
    },
    "p045": {
      "source_hash": "8fe7efabd6d2",
      "text": "jadi tak sedikit."
    },
    "p046": {
      "source_hash": "3ac46165f371",
      "text": "Kalau semua garam laut dihampar di daratan,"
    },
    "p047": {
      "source_hash": "5f7b4ee35632",
      "text": "setebal sekitar 40 lantai."
    },
    "p048": {
      "source_hash": "d0662c70e672",
      "text": "40 lantai!"
    },
    "p049": {
      "source_hash": "12ee69066351",
      "text": "Tapi air terus masuk,"
    },
    "p050": {
      "source_hash": "79d9de6e20b1",
      "text": "laut harusnya makin penuh, makin tawar?"
    },
    "p051": {
      "source_hash": "4a695b0268c2",
      "text": "Memang benar,"
    },
    "p052": {
      "source_hash": "5836375aadd6",
      "text": "tapi laut tak meluap."
    },
    "p053": {
      "source_hash": "1b271d0cfff4",
      "text": "Ada lubang buangan di dasar?"
    },
    "p054": {
      "source_hash": "21565f692cc7",
      "text": "Bukan di dasar, tapi di langit."
    },
    "p055": {
      "source_hash": "45616f9834cb",
      "text": "Dijemur matahari, air laut"
    },
    "p056": {
      "source_hash": "bb20f76295f9",
      "text": "jadi uap tak terlihat dan naik ke langit."
    },
    "p057": {
      "source_hash": "4fe6b2f95ab3",
      "text": "Uap jadi awan dan hujan, ada yang ke laut,"
    },
    "p058": {
      "source_hash": "06338e18c824",
      "text": "ada yang ke gunung, lalu sungai."
    },
    "p059": {
      "source_hash": "ef73a5d20083",
      "text": "Airnya keliling!"
    },
    "p060": {
      "source_hash": "27179ff5aa17",
      "text": "Garam ikut terbang juga?"
    },
    "p061": {
      "source_hash": "928a3d9ff0c7",
      "text": "Tidak. Air terangkat,"
    },
    "p062": {
      "source_hash": "6e60960aa1e1",
      "text": "garam tidak."
    },
    "p063": {
      "source_hash": "113e1df2de56",
      "text": "Makanya hujan tak asin!"
    },
    "p064": {
      "source_hash": "5fe17081fe14",
      "text": "Ya, hujan nyaris air tawar rebusan matahari."
    },
    "p065": {
      "source_hash": "ccad44e74727",
      "text": "Bisa jemur air asin di rumah?"
    },
    "p066": {
      "source_hash": "903ab4d77c27",
      "text": "Bisa, beberapa hari,"
    },
    "p067": {
      "source_hash": "8f26a25c8b21",
      "text": "airnya hilang, tersisa lingkaran garam di piring."
    },
    "p068": {
      "source_hash": "51972b8ba0a3",
      "text": "Kayak sup Ibu!"
    },
    "p069": {
      "source_hash": "93cea636a533",
      "text": "Makin susut, makin asin!"
    },
    "p070": {
      "source_hash": "8f71dd7918a9",
      "text": "Ya, laut itu supnya."
    },
    "p071": {
      "source_hash": "d68635adee53",
      "text": "Sungai menuang air sedikit asin,"
    },
    "p072": {
      "source_hash": "d13a9cfda5c2",
      "text": "apinya matahari."
    },
    "p073": {
      "source_hash": "d6aad411e0f3",
      "text": "Terus direbus,"
    },
    "p074": {
      "source_hash": "c033f8c7b14f",
      "text": "nanti laut jadi garam semua?"
    },
    "p075": {
      "source_hash": "e4f8bbd7a815",
      "text": "Sabar. Bandingkan dulu lama air dan garam tinggal di sup."
    },
    "p076": {
      "source_hash": "c248769c5e1c",
      "text": "Air tinggal sekitar 3.000 tahun,"
    },
    "p077": {
      "source_hash": "43fa9fb4aee8",
      "text": "lalu menguap."
    },
    "p078": {
      "source_hash": "d76fb9c50fe5",
      "text": "Garam bertahan puluhan juta tahun."
    },
    "p079": {
      "source_hash": "b1a382d50ca4",
      "text": "3.000 tahun itu sudah lama!"
    },
    "p080": {
      "source_hash": "12375aee73b6",
      "text": "Dibanding garam, air cuma lewat."
    },
    "p081": {
      "source_hash": "eb037701aad6",
      "text": "Tapi garam pun tak selamanya."
    },
    "p082": {
      "source_hash": "603f7f8b50c2",
      "text": "Garamnya ke mana?"
    },
    "p083": {
      "source_hash": "8da2ba289567",
      "text": "Keluarnya di dasar dan tepi panci."
    },
    "p084": {
      "source_hash": "dd806d44d314",
      "text": "Dasar panci itu rahasia yang tadi."
    },
    "p085": {
      "source_hash": "9eea06a3242d",
      "text": "Sebagian pelan-pelan mengendap,"
    },
    "p086": {
      "source_hash": "40a1aa01fefe",
      "text": "bersama pasir jadi lapisan lumpur dan batu."
    },
    "p087": {
      "source_hash": "38d40c082312",
      "text": "Kayak kerak panci!"
    },
    "p088": {
      "source_hash": "eadf4f587dc0",
      "text": "Ya, sup ini pun berkerak."
    },
    "p089": {
      "source_hash": "418802fd35d8",
      "text": "Kerang dan karang"
    },
    "p090": {
      "source_hash": "b6689e3189fe",
      "text": "ambil bahan cangkang di air buat rumah."
    },
    "p091": {
      "source_hash": "65c2ec3ecc7e",
      "text": "Rumah kerang dari air laut?"
    },
    "p092": {
      "source_hash": "0171ef973c9c",
      "text": "Saat mati, cangkang di dasar,"
    },
    "p093": {
      "source_hash": "b98659fd4d18",
      "text": "bahannya lepas dari laut."
    },
    "p094": {
      "source_hash": "3ec0d180890a",
      "text": "Kerang bantu laut!"
    },
    "p095": {
      "source_hash": "42ec30483789",
      "text": "Sungai banyak bawa bahan itu,"
    },
    "p096": {
      "source_hash": "7d1da1282510",
      "text": "habis lebih cepat dari garam."
    },
    "p097": {
      "source_hash": "7c26d9cbe5fe",
      "text": "Kenapa garam tak diambil?"
    },
    "p098": {
      "source_hash": "38a1f5e6ef3a",
      "text": "Kerang tak pakai garam dapur."
    },
    "p099": {
      "source_hash": "c88af16a40dc",
      "text": "Makanya ia terbanyak di laut."
    },
    "p100": {
      "source_hash": "d13c6d2664bb",
      "text": "Dari 100 bagian zat larut,"
    },
    "p101": {
      "source_hash": "680f2c319f46",
      "text": "sekitar 85 adalah bahan garam dapur."
    },
    "p102": {
      "source_hash": "a5ca2febbf90",
      "text": "Dasar panci punya mata air panas."
    },
    "p103": {
      "source_hash": "08b74eefd167",
      "text": "Air menyusup ke batu, panas, lalu menyembur."
    },
    "p104": {
      "source_hash": "98ab5a6c0b61",
      "text": "Kata ilmuwan, tiap 10 sampai 20 juta tahun,"
    },
    "p105": {
      "source_hash": "97be3bc10956",
      "text": "seluruh laut sekali lewat sumber panas."
    },
    "p106": {
      "source_hash": "801cfcad5839",
      "text": "Ada yang keluar dari situ?"
    },
    "p107": {
      "source_hash": "2ea7652df744",
      "text": "Ada. Gunung garam tak ada, tapi ada yang keluar."
    },
    "p108": {
      "source_hash": "c48b22c7065d",
      "text": "Keluar logam dari batu,"
    },
    "p109": {
      "source_hash": "540b3b8d6301",
      "text": "zat laut pun tertinggal di batu."
    },
    "p110": {
      "source_hash": "8b8455effc64",
      "text": "Lalu garam dapur keluarnya lewat mana?"
    },
    "p111": {
      "source_hash": "b08e75271027",
      "text": "Lewat tepi, seperti lingkaran garam sup kering."
    },
    "p112": {
      "source_hash": "7853789d58c4",
      "text": "Dalam waktu lama, ada teluk terpisah dari laut,"
    },
    "p113": {
      "source_hash": "a5affd3b6c23",
      "text": "airnya mengering, lapisan garam tebal terkubur."
    },
    "p114": {
      "source_hash": "ef925ffe83fa",
      "text": "Jadi garam dari sungai,"
    },
    "p115": {
      "source_hash": "a1e80589d33e",
      "text": "laut juga ambil?"
    },
    "p116": {
      "source_hash": "c7b6ebdd4c7f",
      "text": "Ya, keluar-masuk seimbang. Ingat lubang buangan?"
    },
    "p117": {
      "source_hash": "6a250406ec89",
      "text": "Air keluar ke langit; garam ke dasar dan tepi panci."
    },
    "p118": {
      "source_hash": "ed230929a1ef",
      "text": "Garam masuk; jadi kerak di dasar dan cincin di tepi."
    },
    "p119": {
      "source_hash": "ee36e1549afc",
      "text": "Jadi, laut bakal jadi garam semua?"
    },
    "p120": {
      "source_hash": "2dad99320b39",
      "text": "Kata ahli kelautan, laut kini tak makin asin."
    },
    "p121": {
      "source_hash": "04a9c2fa4fe5",
      "text": "Lalu laut sedunia,"
    },
    "p122": {
      "source_hash": "a5e3367a1042",
      "text": "asinnya sama?"
    },
    "p123": {
      "source_hash": "00b562d654ff",
      "text": "Tak persis. Rata-rata seluruh laut,"
    },
    "p124": {
      "source_hash": "d537ab424d12",
      "text": "sekilo ada sekitar 35 gram garam."
    },
    "p125": {
      "source_hash": "33b271d372d6",
      "text": "Laut nyambung,"
    },
    "p126": {
      "source_hash": "90d65d74e8ea",
      "text": "asinnya pasti sama!"
    },
    "p127": {
      "source_hash": "9c11e85731f5",
      "text": "Tersambung, tapi api dan air tiap tempat beda."
    },
    "p128": {
      "source_hash": "3f39b43418a5",
      "text": "Ada yang mendidih, ada yang diisi."
    },
    "p129": {
      "source_hash": "1478c034c44c",
      "text": "Coba tebak, laut dekat Taiwan mirip yang mana?"
    },
    "p130": {
      "source_hash": "698a2efab260",
      "text": "Yang mendidih?"
    },
    "p131": {
      "source_hash": "7bef54cfc68a",
      "text": "Nanti dijawab. Kita ke laut yang panas dulu."
    },
    "p132": {
      "source_hash": "fe2e20102a65",
      "text": "Contohnya Laut Merah: gurun, terik,"
    },
    "p133": {
      "source_hash": "2b95960dc8e3",
      "text": "jarang hujan, hampir tanpa sungai."
    },
    "p134": {
      "source_hash": "c6a1211d4998",
      "text": "Api gede, tak tambah air!"
    },
    "p135": {
      "source_hash": "6d43e3611ec7",
      "text": "Jadi lebih asin:"
    },
    "p136": {
      "source_hash": "823f43ad4664",
      "text": "sekitar 5 gram per kilo di atas rata-rata."
    },
    "p137": {
      "source_hash": "819afa8af847",
      "text": "Ada laut yang tawar banget?"
    },
    "p138": {
      "source_hash": "ba36dbf12c63",
      "text": "Baltik sebaliknya:"
    },
    "p139": {
      "source_hash": "2ca93fc011c7",
      "text": "sungai banyak, hujan melebihi uap."
    },
    "p140": {
      "source_hash": "6a5a941bbc88",
      "text": "Air terus masuk, supnya tawar!"
    },
    "p141": {
      "source_hash": "a74badf7cace",
      "text": "Di utara, sekilo cuma beberapa gram,"
    },
    "p142": {
      "source_hash": "adca759cbdf2",
      "text": "rasanya tawar."
    },
    "p143": {
      "source_hash": "9c8bc092426c",
      "text": "Di muara sungai yang kamu lihat,"
    },
    "p144": {
      "source_hash": "c7f410f72cea",
      "text": "air lautnya agak lebih tawar."
    },
    "p145": {
      "source_hash": "bf03e8c87f1c",
      "text": "Sungai itu!"
    },
    "p146": {
      "source_hash": "d442e8fd1db6",
      "text": "Kalau laut Taiwan?"
    },
    "p147": {
      "source_hash": "4bfd0d14257d",
      "text": "Dua-duanya bukan."
    },
    "p148": {
      "source_hash": "d906fe53af82",
      "text": "Laut Taiwan biasanya sedikit di atas 34 gram per kilo,"
    },
    "p149": {
      "source_hash": "18617dd298ed",
      "text": "mirip rata-rata."
    },
    "p150": {
      "source_hash": "6017b66b5501",
      "text": "Tapi musim panas hujan deras,"
    },
    "p151": {
      "source_hash": "4e255d76268c",
      "text": "pantai agak tawar."
    },
    "p152": {
      "source_hash": "07f4a858d7fe",
      "text": "Jadi, asin tidaknya laut ditentukan apa?"
    },
    "p153": {
      "source_hash": "f228e358af11",
      "text": "Berapa masuk, berapa direbus!"
    },
    "p154": {
      "source_hash": "ed307f31e03a",
      "text": "Coba pikirkan di pantai."
    },
    "p155": {
      "source_hash": "84a8617256f5",
      "text": "Ingat tadi? Coba kamu jelaskan."
    },
    "p156": {
      "source_hash": "d3c47d6c399f",
      "text": "Sungai bawa secuil garam,"
    },
    "p157": {
      "source_hash": "029683f4ab87",
      "text": "matahari cuma rebus air,"
    },
    "p158": {
      "source_hash": "bd543f5a6222",
      "text": "dasar laut dan tepi ambil garam!"
    },
    "p159": {
      "source_hash": "c87b6a41087f",
      "text": "Tepat! Oh ya, air laut kemarin itu,"
    },
    "p160": {
      "source_hash": "5a5c1b90b754",
      "text": "jangan buat pelepas dahaga: buang garam butuh air, makin haus."
    },
    "p161": {
      "source_hash": "077f6f82ee0b",
      "text": "Nanti kalau kena ombak asin,"
    },
    "p162": {
      "source_hash": "37f434d6da18",
      "text": "itu rasa sisa puluhan juta tahun."
    },
    "p163": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p164": {
      "source_hash": "ece75cc2abb3",
      "text": "Laut yang kamu datangi asin?"
    },
    "p165": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar, ya!"
    },
    "p166": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
