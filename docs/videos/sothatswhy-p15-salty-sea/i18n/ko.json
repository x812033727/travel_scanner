    "thumbnail": "8f3413ae11d3"
  },
  "lines": {
    "p001": {
      "source_hash": "cd5ce196215d",
      "text": "소장님! 어제 바다에서"
    },
    "p002": {
      "source_hash": "d67850b62da5",
      "text": "파도에 맞아서 바닷물을 먹었어요!"
    },
    "p003": {
      "source_hash": "272b879781a8",
      "text": "너무너무 짰어요!"
    },
    "p004": {
      "source_hash": "b5bcb90b3b2e",
      "text": "나도 먹어 봤어."
    },
    "p005": {
      "source_hash": "13d973705344",
      "text": "얼굴이 다 찡그려지지."
    },
    "p006": {
      "source_hash": "fe4ed8048350",
      "text": "근데 오는 길에 강을 봤어요,"
    },
    "p007": {
      "source_hash": "098f86ba8a9a",
      "text": "계속 바다로 흘러가요."
    },
    "p008": {
      "source_hash": "30fd04e96bca",
      "text": "강은 안 짠데,"
    },
    "p009": {
      "source_hash": "8e3336ea2135",
      "text": "바다는 왜 안 싱거워요?"
    },
    "p010": {
      "source_hash": "60d7d66374cb",
      "text": "좋은 질문. 세계의 강이 매일 민물을 잔뜩 붓는데,"
    },
    "p011": {
      "source_hash": "32043e11a1ae",
      "text": "바다는 한 번도 싱거워진 적이 없어."
    },
    "p012": {
      "source_hash": "9fb86b4ff153",
      "text": "알아요!"
    },
    "p013": {
      "source_hash": "a44197e54d36",
      "text": "바다 밑 소금산에서 소금이 나와요!"
    },
    "p014": {
      "source_hash": "dcd0e28d9715",
      "text": "소금산? 그럴듯한 추측이야."
    },
    "p015": {
      "source_hash": "fbfbc558cddd",
      "text": "바다 밑 진짜 비밀은 이따 알려 줄게."
    },
    "p016": {
      "source_hash": "a2170542e958",
      "text": "강물이 안 짜다고 했지?"
    },
    "p017": {
      "source_hash": "e5a4c422f785",
      "text": "정말 소금이 없을까?"
    },
    "p018": {
      "source_hash": "20b89c24e5ec",
      "text": "바다를 끓고 있는 국 한 솥이라 치자."
    },
    "p019": {
      "source_hash": "aa20f1c35e09",
      "text": "맹물을 계속 넣는데 왜 짤까?"
    },
    "p020": {
      "source_hash": "01d491f45b77",
      "text": "사실 강물에도 소금이 몰래 들어 있어."
    },
    "p021": {
      "source_hash": "c55844f8466c",
      "text": "근데 맛은 안 짜잖아요!"
    },
    "p022": {
      "source_hash": "52770e32db76",
      "text": "아주아주 조금이라,"
    },
    "p023": {
      "source_hash": "58372e92a51b",
      "text": "혀가 모를 만큼."
    },
    "p024": {
      "source_hash": "4a2deb18e48f",
      "text": "그 소금은 산의 돌에서 와."
    },
    "p025": {
      "source_hash": "918a764b36b9",
      "text": "빗물은 살짝 시큼해서, 해마다 조금씩 돌을 갉아 먹어."
    },
    "p026": {
      "source_hash": "3e4d51bb9036",
      "text": "비가 돌을 갉아요?"
    },
    "p027": {
      "source_hash": "6a3ea68e0de4",
      "text": "응, 아주 천천히. 아주 오래 걸려."
    },
    "p028": {
      "source_hash": "000e9236fdfa",
      "text": "돌 속의 아주 작은 것들이 그렇게 물에 녹아."
    },
    "p029": {
      "source_hash": "7f2369e1a9e2",
      "text": "안 보이는 그것들이 강물 따라 산을 내려가."
    },
    "p030": {
      "source_hash": "89c028f518ce",
      "text": "설탕 녹듯이"
    },
    "p031": {
      "source_hash": "aa65f18ebfa4",
      "text": "안 보여요?"
    },
    "p032": {
      "source_hash": "a70940fc6c69",
      "text": "응, 보이지도 맛도 안 나."
    },
    "p033": {
      "source_hash": "b05c8534b323",
      "text": "그중 일부가 부엌 소금의 재료야."
    },
    "p034": {
      "source_hash": "c99c2bf93c15",
      "text": "그럼 강에 소금이 쌓이지 않아요?"
    },
    "p035": {
      "source_hash": "38d8eb24a7a2",
      "text": "비가 와서 강물이 늘 바뀌니까,"
    },
    "p036": {
      "source_hash": "d8103784611b",
      "text": "소금이 쌓이기 전에 바다로 가."
    },
    "p037": {
      "source_hash": "94e30595496a",
      "text": "민물이라 부르는 물에 든 소금은"
    },
    "p038": {
      "source_hash": "0c5e032e1536",
      "text": "바다의 30분의 1도 안 돼."
    },
    "p039": {
      "source_hash": "020e0766f6f1",
      "text": "이렇게 조금으로"
    },
    "p040": {
      "source_hash": "c0e6101f36d3",
      "text": "어떻게 바다 전체가 짜져요?"
    },
    "p041": {
      "source_hash": "553a357fc1a7",
      "text": "그런데 세상의 모든 강이 함께 부으면"
    },
    "p042": {
      "source_hash": "52efa69d58bb",
      "text": "1년에 녹은 소금 약 40억 톤이 바다로 가."
    },
    "p043": {
      "source_hash": "99c70032b04a",
      "text": "40억 톤이요!"
    },
    "p044": {
      "source_hash": "4bbce78c06f9",
      "text": "조금이라도, 수많은 강과 수많은 해를 곱하면"
    },
    "p045": {
      "source_hash": "8fe7efabd6d2",
      "text": "조금이 아니지."
    },
    "p046": {
      "source_hash": "3ac46165f371",
      "text": "지금 바다의 소금을 다 건져 땅에 깔면,"
    },
    "p047": {
      "source_hash": "5f7b4ee35632",
      "text": "두께가 40층 높이쯤 돼."
    },
    "p048": {
      "source_hash": "d0662c70e672",
      "text": "40층이요!"
    },
    "p049": {
      "source_hash": "12ee69066351",
      "text": "강물이 계속 오면"
    },
    "p050": {
      "source_hash": "79d9de6e20b1",
      "text": "바다가 점점 차고 싱거워지지 않아요?"
    },
    "p051": {
      "source_hash": "4a695b0268c2",
      "text": "붓는 건 맞아,"
    },
    "p052": {
      "source_hash": "5836375aadd6",
      "text": "근데 바다는 안 넘쳐."
    },
    "p053": {
      "source_hash": "1b271d0cfff4",
      "text": "바다 밑에 배수구가 있어요?"
    },
    "p054": {
      "source_hash": "21565f692cc7",
      "text": "물의 출구는 바다 밑 말고 하늘이야."
    },
    "p055": {
      "source_hash": "45616f9834cb",
      "text": "햇볕이 쬐면 바다 위의 물이"
    },
    "p056": {
      "source_hash": "bb20f76295f9",
      "text": "안 보이는 수증기가 돼 하늘로 날아가."
    },
    "p057": {
      "source_hash": "4fe6b2f95ab3",
      "text": "구름과 비가 돼서 일부는 바다로 바로 내리고,"
    },
    "p058": {
      "source_hash": "06338e18c824",
      "text": "일부는 산에 내려 강 따라 돌아와."
    },
    "p059": {
      "source_hash": "ef73a5d20083",
      "text": "물이 빙글빙글!"
    },
    "p060": {
      "source_hash": "27179ff5aa17",
      "text": "소금도 하늘로 날아가요?"
    },
    "p061": {
      "source_hash": "928a3d9ff0c7",
      "text": "아니. 해는 물만 옮기고,"
    },
    "p062": {
      "source_hash": "6e60960aa1e1",
      "text": "소금은 못 옮겨."
    },
    "p063": {
      "source_hash": "113e1df2de56",
      "text": "그래서 비가 안 짜구나!"
    },
    "p064": {
      "source_hash": "5fe17081fe14",
      "text": "응, 비는 거의 해가 끓여 올린 민물이야."
    },
    "p065": {
      "source_hash": "ccad44e74727",
      "text": "집에서 소금물 말려 볼까요?"
    },
    "p066": {
      "source_hash": "903ab4d77c27",
      "text": "응. 햇볕에 며칠 두면"
    },
    "p067": {
      "source_hash": "8f26a25c8b21",
      "text": "물은 사라지고 접시에 소금 테두리만 남아."
    },
    "p068": {
      "source_hash": "51972b8ba0a3",
      "text": "엄마 국처럼!"
    },
    "p069": {
      "source_hash": "93cea636a533",
      "text": "끓일수록 줄고 더 짜져요!"
    },
    "p070": {
      "source_hash": "8f71dd7918a9",
      "text": "응, 바다가 그 국이야."
    },
    "p071": {
      "source_hash": "d68635adee53",
      "text": "강물은 소금 조금 든 물이고,"
    },
    "p072": {
      "source_hash": "d13a9cfda5c2",
      "text": "해는 불이야."
    },
    "p073": {
      "source_hash": "d6aad411e0f3",
      "text": "바다를 매일 끓이면"
    },
    "p074": {
      "source_hash": "c033f8c7b14f",
      "text": "결국 큰 소금밭이 되잖아요?"
    },
    "p075": {
      "source_hash": "e4f8bbd7a815",
      "text": "잠깐. 물과 소금이 이 국에 얼마나 있는지 비교해 보자."
    },
    "p076": {
      "source_hash": "c248769c5e1c",
      "text": "물 한 방울은 바다에 평균 3천 년쯤"
    },
    "p077": {
      "source_hash": "43fa9fb4aee8",
      "text": "머물다 끓어 나가."
    },
    "p078": {
      "source_hash": "d76fb9c50fe5",
      "text": "소금은 국 속에 수천만 년도 있어."
    },
    "p079": {
      "source_hash": "b1a382d50ca4",
      "text": "3천 년도 엄청 긴데요!"
    },
    "p080": {
      "source_hash": "12375aee73b6",
      "text": "소금에 비하면 물은 한 바퀴 돌 뿐."
    },
    "p081": {
      "source_hash": "eb037701aad6",
      "text": "소금도 국에 영원히 있진 않아."
    },
    "p082": {
      "source_hash": "603f7f8b50c2",
      "text": "소금은 결국 어디 가요?"
    },
    "p083": {
      "source_hash": "8da2ba289567",
      "text": "녹은 것의 출구는 냄비 바닥과 가장자리야."
    },
    "p084": {
      "source_hash": "dd806d44d314",
      "text": "냄비 바닥이 아까 말한 바다 밑 비밀이야."
    },
    "p085": {
      "source_hash": "9eea06a3242d",
      "text": "녹은 것 일부는 천천히 가라앉아"
    },
    "p086": {
      "source_hash": "40a1aa01fefe",
      "text": "흙모래와 함께 바다 밑 진흙과 돌이 겹겹이 돼."
    },
    "p087": {
      "source_hash": "38d40c082312",
      "text": "누룽지처럼요!"
    },
    "p088": {
      "source_hash": "eadf4f587dc0",
      "text": "응, 이 국도 누룽지가 생겨."
    },
    "p089": {
      "source_hash": "418802fd35d8",
      "text": "조개랑 산호는"
    },
    "p090": {
      "source_hash": "b6689e3189fe",
      "text": "물속의 껍데기 재료로 자기 집을 지어."
    },
    "p091": {
      "source_hash": "65c2ec3ecc7e",
      "text": "조개 집을 바닷물로 지어요?"
    },
    "p092": {
      "source_hash": "0171ef973c9c",
      "text": "응. 죽으면 껍데기는 바닥에 남고,"
    },
    "p093": {
      "source_hash": "b98659fd4d18",
      "text": "그 재료도 바닷물을 떠나."
    },
    "p094": {
      "source_hash": "3ec0d180890a",
      "text": "조개가 짐을 날라 줘요!"
    },
    "p095": {
      "source_hash": "42ec30483789",
      "text": "강물엔 껍데기 재료가 많아서,"
    },
    "p096": {
      "source_hash": "7d1da1282510",
      "text": "소금보다 훨씬 빨리 빠져."
    },
    "p097": {
      "source_hash": "7c26d9cbe5fe",
      "text": "소금은 왜 안 빠져요?"
    },
    "p098": {
      "source_hash": "38a1f5e6ef3a",
      "text": "껍데기엔 소금이 안 들어가."
    },
    "p099": {
      "source_hash": "c88af16a40dc",
      "text": "그래서 짠 바닷물엔 소금이 제일 많아."
    },
    "p100": {
      "source_hash": "d13c6d2664bb",
      "text": "바닷물에 녹은 것 100개 중"
    },
    "p101": {
      "source_hash": "680f2c319f46",
      "text": "약 85개는 부엌 소금의 재료야."
    },
    "p102": {
      "source_hash": "a5ca2febbf90",
      "text": "바닥엔 뽀글대는 뜨거운 샘도 있어."
    },
    "p103": {
      "source_hash": "08b74eefd167",
      "text": "바닷물이 돌 틈에 스며 뜨거워져서 뿜어 나와."
    },
    "p104": {
      "source_hash": "98ab5a6c0b61",
      "text": "과학자들은 세계 바닷물이 약 1천만에서 2천만 년이면"
    },
    "p105": {
      "source_hash": "97be3bc10956",
      "text": "뜨거운 샘의 돌 틈을 한 번 다 지난대."
    },
    "p106": {
      "source_hash": "801cfcad5839",
      "text": "뜨거운 샘에서 뭐가 나와요?"
    },
    "p107": {
      "source_hash": "2ea7652df744",
      "text": "응. 소금산은 없지만, 바다 밑에서 진짜 뭔가 나와."
    },
    "p108": {
      "source_hash": "c48b22c7065d",
      "text": "돌 속 금속을 끌어내고,"
    },
    "p109": {
      "source_hash": "540b3b8d6301",
      "text": "바닷물 속 것을 돌에 남기기도 해."
    },
    "p110": {
      "source_hash": "8b8455effc64",
      "text": "그럼 부엌 소금은 어디로 나가요?"
    },
    "p111": {
      "source_hash": "b08e75271027",
      "text": "하나는 가장자리야. 졸아든 국의 소금 테두리처럼."
    },
    "p112": {
      "source_hash": "7853789d58c4",
      "text": "아주 오랜 시간 동안, 어떤 만은 바다와 갈라졌어."
    },
    "p113": {
      "source_hash": "a5affd3b6c23",
      "text": "그 물이 말라 두꺼운 소금층이 남아 땅속에 묻혔어."
    },
    "p114": {
      "source_hash": "ef925ffe83fa",
      "text": "강이 넣은 소금을"
    },
    "p115": {
      "source_hash": "a1e80589d33e",
      "text": "바다도 계속 치워요?"
    },
    "p116": {
      "source_hash": "c7b6ebdd4c7f",
      "text": "응, 오는 만큼 치워. 배수구 기억나?"
    },
    "p117": {
      "source_hash": "6a250406ec89",
      "text": "물의 출구는 하늘, 소금의 출구는 냄비 바닥과 가장자리."
    },
    "p118": {
      "source_hash": "ed230929a1ef",
      "text": "소금이 들어오면서, 바닥엔 누룽지, 가장자리엔 소금 테두리."
    },
    "p119": {
      "source_hash": "ee36e1549afc",
      "text": "그래서 바다가 소금밭이 되냐고?"
    },
    "p120": {
      "source_hash": "2dad99320b39",
      "text": "해양학자들은 지금 바다가 더는 짜지지 않는다고 봐."
    },
    "p121": {
      "source_hash": "04a9c2fa4fe5",
      "text": "그럼 세계 바다는"
    },
    "p122": {
      "source_hash": "a5e3367a1042",
      "text": "다 똑같이 짜요?"
    },
    "p123": {
      "source_hash": "00b562d654ff",
      "text": "조금씩 달라. 바다 전체 평균은"
    },
    "p124": {
      "source_hash": "d537ab424d12",
      "text": "바닷물 1킬로에 소금 약 35그램."
    },
    "p125": {
      "source_hash": "33b271d372d6",
      "text": "다 이어졌으니"
    },
    "p126": {
      "source_hash": "90d65d74e8ea",
      "text": "다 똑같이 짜겠죠!"
    },
    "p127": {
      "source_hash": "9c11e85731f5",
      "text": "이어져도, 곳마다 불과 물이 달라."
    },
    "p128": {
      "source_hash": "3f39b43418a5",
      "text": "어딘 세게 끓고 어딘 물을 부어."
    },
    "p129": {
      "source_hash": "1478c034c44c",
      "text": "맞혀 봐. 대만 근처 바다는 어느 쪽일까?"
    },
    "p130": {
      "source_hash": "698a2efab260",
      "text": "세게 끓는 쪽?"
    },
    "p131": {
      "source_hash": "7bef54cfc68a",
      "text": "이따 알려 줄게. 먼저 아주 더운 바다로 가 보자."
    },
    "p132": {
      "source_hash": "fe2e20102a65",
      "text": "홍해는 사막에 둘러싸여 햇볕이 세."
    },
    "p133": {
      "source_hash": "2b95960dc8e3",
      "text": "비도 적고 들어오는 강도 거의 없어."
    },
    "p134": {
      "source_hash": "c6a1211d4998",
      "text": "불은 세고 물은 안 붓고!"
    },
    "p135": {
      "source_hash": "6d43e3611ec7",
      "text": "많이 졸아 더 짜,"
    },
    "p136": {
      "source_hash": "823f43ad4664",
      "text": "1킬로에 소금이 평균보다 약 5그램 많아."
    },
    "p137": {
      "source_hash": "819afa8af847",
      "text": "아주아주 싱거운 바다도 있어요?"
    },
    "p138": {
      "source_hash": "ba36dbf12c63",
      "text": "북쪽 발트해는 반대,"
    },
    "p139": {
      "source_hash": "2ca93fc011c7",
      "text": "강물이 많고, 비가 증발보다 많아."
    },
    "p140": {
      "source_hash": "6a5a941bbc88",
      "text": "물을 계속 부으면 싱거워져요!"
    },
    "p141": {
      "source_hash": "a74badf7cace",
      "text": "맨 북쪽은 1킬로에 소금 몇 그램뿐이라"
    },
    "p142": {
      "source_hash": "adca759cbdf2",
      "text": "맛이 싱거워."
    },
    "p143": {
      "source_hash": "9c8bc092426c",
      "text": "네가 본 강이 바다로 가는 곳도"
    },
    "p144": {
      "source_hash": "c7f410f72cea",
      "text": "근처 바닷물이 좀 싱거워."
    },
    "p145": {
      "source_hash": "bf03e8c87f1c",
      "text": "내가 본 강!"
    },
    "p146": {
      "source_hash": "d442e8fd1db6",
      "text": "대만 근처 바다는요?"
    },
    "p147": {
      "source_hash": "4bfd0d14257d",
      "text": "정답은, 둘 다 아냐."
    },
    "p148": {
      "source_hash": "d906fe53af82",
      "text": "대만 근처 바닷물은 보통 1킬로에 34그램 남짓으로"
    },
    "p149": {
      "source_hash": "18617dd298ed",
      "text": "평균과 비슷해."
    },
    "p150": {
      "source_hash": "6017b66b5501",
      "text": "여름엔 비도 강물도 많아"
    },
    "p151": {
      "source_hash": "4e255d76268c",
      "text": "바닷가는 덜 짜."
    },
    "p152": {
      "source_hash": "07f4a858d7fe",
      "text": "그럼 바다가 짠지 아닌지는 뭐에 달렸을까?"
    },
    "p153": {
      "source_hash": "f228e358af11",
      "text": "붓는 물과 끓어 나가는 물!"
    },
    "p154": {
      "source_hash": "ed307f31e03a",
      "text": "바다 가면 생각해 봐."
    },
    "p155": {
      "source_hash": "84a8617256f5",
      "text": "처음 질문 기억나? 네가 말해 봐."
    },
    "p156": {
      "source_hash": "d3c47d6c399f",
      "text": "강이 소금 조금 넣고,"
    },
    "p157": {
      "source_hash": "029683f4ab87",
      "text": "해는 물만 끓여 날리고,"
    },
    "p158": {
      "source_hash": "bd543f5a6222",
      "text": "바다 밑과 가장자리가 소금을 치워요!"
    },
    "p159": {
      "source_hash": "c87b6a41087f",
      "text": "정답! 참, 어제 마신 그 바닷물은"
    },
    "p160": {
      "source_hash": "5a5c1b90b754",
      "text": "갈증엔 절대 안 돼. 소금 빼느라 물이 더 들어 더 목말라."
    },
    "p161": {
      "source_hash": "077f6f82ee0b",
      "text": "다음에 파도 맞고 짠맛을 보면,"
    },
    "p162": {
      "source_hash": "37f434d6da18",
      "text": "수천만 년이 남긴 맛이란 걸 알 거야."
    },
    "p163": {
      "source_hash": "36d742bcb996",
      "text": "그래서 그랬구나!"
    },
    "p164": {
      "source_hash": "ece75cc2abb3",
      "text": "보는 너는? 가 본 바다는 짰니?"
    },
    "p165": {
      "source_hash": "fe508e80b52e",
      "text": "댓글로 알려 줘."
    },
    "p166": {
      "source_hash": "88de677d4daa",
      "text": "생활 속 '왜'를 찾는다면 그래서그랬구나 사무소 구독!"
    }
  }
}
