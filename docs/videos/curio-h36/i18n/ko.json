  },
  "lines": {
    "89rb": {
      "source_hash": "18c394973ae7",
      "text": "이 기괴한 사건에 대해 들어보셨나요?"
    },
    "dw8a": {
      "source_hash": "8ef589a1c39a",
      "text": "1869년 가을의 일입니다."
    },
    "uz9i": {
      "source_hash": "83b26b9d4804",
      "text": "뉴욕주의 한 한적한 농장 땅속에서,"
    },
    "smrr": {
      "source_hash": "bcc63ec28e68",
      "text": "무려 3미터 길이의 거대한 돌 사람이 발굴되었습니다!"
    },
    "uqqw": {
      "source_hash": "4ad1051a2be7",
      "text": "3미터나요?"
    },
    "zbz8": {
      "source_hash": "e1085b10f647",
      "text": "2층 건물 높이에 달하는 엄청난 크기였죠!"
    },
    "32tb": {
      "source_hash": "6492949221d4",
      "text": "정말로 선사 시대의 거인일까요?"
    },
    "bkes": {
      "source_hash": "2cad65cb000e",
      "text": "아니면 고대 신화가 현실로 나타난 걸까요?"
    },
    "gi2a": {
      "source_hash": "2fc4cea50ecf",
      "text": "당시 전미가 이 발견에 열광했고,"
    },
    "8n6c": {
      "source_hash": "b9067b801f45",
      "text": "수만 명의 인파가 줄을 지어 몰려들었습니다!"
    },
    "pgn8": {
      "source_hash": "d6c3b316c4ad",
      "text": "농장주는 텐트를 치고 입장료를 날마다 올렸습니다!"
    },
    "uqug": {
      "source_hash": "857ec379b9f4",
      "text": "온 마을 사람들이 오직 이 거인 이야기만 나눴죠!"
    },
    "y89n": {
      "source_hash": "423579de0fd3",
      "text": "하지만 불과 두 달 뒤,"
    },
    "wivm": {
      "source_hash": "b6d07a71c75f",
      "text": "예일대 과학자가 현장에서 가짜임을 단번에 폭로했습니다!"
    },
    "8uh9": {
      "source_hash": "f34cf102135c",
      "text": "이 돌의 출신 성분까지 낱낱이 밝혀냈죠!"
    },
    "8vrw": {
      "source_hash": "e9781d7a411c",
      "text": "고대 화석 따위가 전혀 아니었습니다!"
    },
    "qqey": {
      "source_hash": "9970cfff812f",
      "text": "완전한 가짜로 들통났다고요?"
    },
    "n4dd": {
      "source_hash": "d79a565245bd",
      "text": "그럼 관람객들이 다 흩어져 집으로 돌아갔나요?"
    },
    "j56w": {
      "source_hash": "13858dab1d5b",
      "text": "오늘 우리는 이 기상천외한 이야기,"
    },
    "gwa9": {
      "source_hash": "bb19a9f341a0",
      "text": "브로드웨이 두 거인의 입장권 대전을 파헤쳐 봅니다!"
    },
    "siju": {
      "source_hash": "ddc2543f4953",
      "text": "시간은 1869년 가을로 거슬러 올라갑니다."
    },
    "pbhr": {
      "source_hash": "d7c257f78e14",
      "text": "뉴욕주 카디프라는 작은 마을의 농장이었죠."
    },
    "4wng": {
      "source_hash": "985342af576c",
      "text": "농가 바로 옆에는 이미 맑은 천연 샘물이 흐르고 있었습니다!"
    },
    "7exf": {
      "source_hash": "3bcdd6cf13ed",
      "text": "그런데 굳이 돈을 들여 우물을 새로 팔 이유가 있나요?"
    },
    "cy2c": {
      "source_hash": "97cecdede24c",
      "text": "하지만 농장주는 갑자기 우물을 파겠다고 고집을 부렸습니다."
    },
    "3j9g": {
      "source_hash": "b0c1045950c7",
      "text": "그는 일꾼 두 명을 고용해 우물을 파게 했죠."
    },
    "4s6v": {
      "source_hash": "d9e0397e7edc",
      "text": "게다가 헛간 뒤편의 특정 지점을 정확히 짚어주었습니다!"
    },
    "c2mb": {
      "source_hash": "faad172fcaf1",
      "text": "땅을 겨우 1미터쯤 팠을 때,"
    },
    "3pey": {
      "source_hash": "35a49eec18fc",
      "text": "삽날이 무언가 단단한 것에 부딪히며 맑은 소리를 냈습니다!"
    },
    "cdma": {
      "source_hash": "6faf68d4882d",
      "text": "흙더미 사이로 거대한 엄지발가락이 드러났습니다!"
    },
    "qmmb": {
      "source_hash": "a55726c492ca",
      "text": "몇 시간 뒤 거대한 석상의 온몸이 드러났습니다,"
    },
    "efwi": {
      "source_hash": "21d21c2fe8e6",
      "text": "길이 3미터에 무게는 무려 1.4톤에 달했습니다!"
    },
    "qvw4": {
      "source_hash": "84aa9a9fbcd8",
      "text": "약 1.4톤이라니! 정말 엄청난 크기네요!"
    },
    "gkx5": {
      "source_hash": "b3af4016aa60",
      "text": "소식은 반나절 만에 뉴욕 전역으로 퍼졌습니다!"
    },
    "yiim": {
      "source_hash": "739869fbde48",
      "text": "주요 일간지들이 1면 머리기사로 대서특필했죠!"
    },
    "27vp": {
      "source_hash": "d72d93deba23",
      "text": "농장주는 즉시 하얀 대형 텐트를 세웠습니다!"
    },
    "3wna": {
      "source_hash": "154fd6320566",
      "text": "관람객의 마차 행렬이 수 킬로미터나 이어졌습니다!"
    },
    "m9wm": {
      "source_hash": "850fc4b686e0",
      "text": "입장료는 25센트에서 50센트로 껑충 뛰었습니다!"
    },
    "nf3z": {
      "source_hash": "b3248a32ee01",
      "text": "불과 몇 주 만에 수만 달러를 쓸어 담았습니다!"
    },
    "aw4u": {
      "source_hash": "0dd21c475137",
      "text": "시러큐스의 부호 조합이 3만 7천 달러를 제시하며,"
    },
    "fcfi": {
      "source_hash": "db65c9e1e318",
      "text": "거인의 지분 4분의 3을 통째로 사들였습니다!"
    },
    "9rii": {
      "source_hash": "9026f9784fe1",
      "text": "임시 열차를 투입한 철도 회사도 큰돈을 벌었죠!"
    },
    "9v8a": {
      "source_hash": "a0e371aabd69",
      "text": "인근 호텔들은 연일 만실로 방을 구할 수 없었습니다!"
    },
    "w6s4": {
      "source_hash": "c96c9fdc8a7c",
      "text": "3만 7천 달러라니! 당시로선 천문학적인 액수예요!"
    },
    "5tt3": {
      "source_hash": "d90c5a326784",
      "text": "하지만 학자들의 진위 감정은 없었나요?"
    },
    "323g": {
      "source_hash": "6573ed98f8aa",
      "text": "당연히 있었죠! 학자들도 현장으로 달려왔습니다."
    },
    "hg84": {
      "source_hash": "4cf22d07b1ac",
      "text": "많은 사람들이 성경 속 거인의 증거라고 확신했습니다!"
    },
    "x2sq": {
      "source_hash": "9b6225ecf221",
      "text": "성직자들도 먼 길을 달려와 경건하게 참배했죠!"
    },
    "ujs4": {
      "source_hash": "26da13ebe9b6",
      "text": "전 뉴욕주 주지사까지 공개 지지를 표명했습니다!"
    },
    "smri": {
      "source_hash": "7cf23b495179",
      "text": "11월 초 예일대의 저명한 전문가가 등장하기 전까지는요!"
    },
    "tayy": {
      "source_hash": "ac49838ebd02",
      "text": "예일대 교수도 그 말을 믿었을까요?"
    },
    "xpb9": {
      "source_hash": "4b5688a753eb",
      "text": "유명한 마시 교수가 직접 현장을 찾았습니다."
    },
    "e8bz": {
      "source_hash": "fc824456a0b1",
      "text": "그는 몇 분간 석상을 살펴보더니 비웃음을 터뜨렸습니다!"
    },
    "q7ht": {
      "source_hash": "e8f54b1594fd",
      "text": "표면에 신선한 정 자국이 선명하게 남아있었던 것이죠!"
    },
    "ewya": {
      "source_hash": "db0eb5a24575",
      "text": "조각가의 칼자국을 숨기려는 시도조차 없었습니다!"
    },
    "nkbh": {
      "source_hash": "00180aac17b6",
      "text": "고대 화석에 방금 깎은 정 자국이 있을 리가 없죠!"
    },
    "yi6z": {
      "source_hash": "ec4565228e04",
      "text": "게다가 돌의 재질은 무른 석고였고,"
    },
    "xvhr": {
      "source_hash": "460d030e72a9",
      "text": "보존성이 뛰어난 대리석이 전혀 아니었습니다!"
    },
    "tc2p": {
      "source_hash": "88fd29f26b0a",
      "text": "축축한 흙탕물 속에서 석고는 금방 녹아버립니다!"
    },
    "gyye": {
      "source_hash": "44a66d31875b",
      "text": "기초적인 지질학 상식만 있어도 알아챌 수 있었죠!"
    },
    "ktm8": {
      "source_hash": "0c1f8764e1c5",
      "text": "마시 교수는 즉시 신문에 기고문을 보냈습니다:"
    },
    "r6eq": {
      "source_hash": "825fea44dd96",
      "text": "이것은 처음부터 끝까지 완전한 사기극이라고요!"
    },
    "8mpj": {
      "source_hash": "6a058f2bdb8f",
      "text": "예일대 교수가 직접 사기극을 폭로했군요!"
    },
    "xrmi": {
      "source_hash": "2d7d8fbbcbb9",
      "text": "그럼 이 돌 거인은 대체 누가 만든 건가요?"
    },
    "x5qb": {
      "source_hash": "35d0369f2673",
      "text": "기자들이 철도 운송장을 끝까지 추적했습니다!"
    },
    "7kkg": {
      "source_hash": "3e884bed06fc",
      "text": "3톤짜리 거대한 나무 상자가 곳곳에 흔적을 남겼고,"
    },
    "rpaj": {
      "source_hash": "6b69d7202d23",
      "text": "철도 직원들도 그 거대한 화물을 똑똑히 기억하고 있었습니다!"
    },
    "676q": {
      "source_hash": "568959ac9768",
      "text": "배후의 주동자는 조지 헐이라는 인물이었습니다."
    },
    "dthr": {
      "source_hash": "a7eb8535c51e",
      "text": "시가 담배를 팔던 상인이라고요?"
    },
    "879i": {
      "source_hash": "351675acc476",
      "text": "그는 왜 그토록 큰돈을 들여 가짜 거인을 만들었을까요?"
    },
    "qgnn": {
      "source_hash": "b8d2ca1391a4",
      "text": "발단은 2년 전 한 목사와의 격렬한 신학 논쟁이었습니다,"
    },
    "6s5d": {
      "source_hash": "13e6482c4205",
      "text": "상대 목사는 성경 구절이 한 글자도 틀림없는 사실이라 주장했죠!"
    },
    "55iw": {
      "source_hash": "bc68d44bb1c8",
      "text": "고대에 진짜 거인이 땅 위에 살았다고 우겼던 것입니다!"
    },
    "xmnr": {
      "source_hash": "f802b31f061f",
      "text": "무신론자였던 그가 어떻게 반격을 꾸민 건가요?"
    },
    "99d6": {
      "source_hash": "75cc28ad1932",
      "text": "무신론자였던 헐은 화가 나서 잠을 이룰 수 없었습니다."
    },
    "88f6": {
      "source_hash": "4fb16fb69b4a",
      "text": "대중의 맹목적인 믿음을 조롱하기 위해 가짜 거인을 만들기로 결심했죠!"
    },
    "b4au": {
      "source_hash": "8284f44c6041",
      "text": "그는 전년도에 아이오와주에서 거대한 석고를 구입해,"
    },
    "3hbe": {
      "source_hash": "275f6ab8c944",
      "text": "5톤짜리 석고 덩어리를 기차에 실었습니다,"
    },
    "j6r8": {
      "source_hash": "d03e78825bf0",
      "text": "헐 자신이 직접 동승해 철저히 호송했죠!"
    },
    "gwgf": {
      "source_hash": "01ba4b4f7838",
      "text": "링컨 대통령의 기념상을 조각할 재료라고 거짓말하여,"
    },
    "85es": {
      "source_hash": "cd07e03afc2d",
      "text": "철도 회사를 속이고 시카고로 운송했습니다!"
    },
    "dj5y": {
      "source_hash": "3b746ab37e40",
      "text": "링컨 대통령의 이름까지 핑계로 써먹다니요!"
    },
    "9j93": {
      "source_hash": "5b708143f88a",
      "text": "그는 시카고의 한 헛간에 비밀 공방을 차렸습니다,"
    },
    "y8gw": {
      "source_hash": "72ddc0f95f78",
      "text": "그 은밀한 작업장의 모습을 한번 들여다보죠!"
    },
    "zruy": {
      "source_hash": "b6b678767d74",
      "text": "5톤짜리 석고를 아무도 의심하지 않았군요!"
    },
    "qjc6": {
      "source_hash": "8bdd145f7ba9",
      "text": "모두가 링컨의 조각상을 만드는 줄로만 알았습니다!"
    },
    "3ygp": {
      "source_hash": "88665ea6bf26",
      "text": "헐은 시카고 외딴곳의 작업실을 빌리고,"
    },
    "mfg8": {
      "source_hash": "fd2cef39f81f",
      "text": "독일인 조각가 두 명을 고용해 극비리에 작업했습니다!"
    },
    "2auk": {
      "source_hash": "e98b10b100fb",
      "text": "조각가들은 헐 자신의 나체를 모델 삼아,"
    },
    "yy39": {
      "source_hash": "69ad9fb985a5",
      "text": "무려 14주 동안 쉼 없이 깎아냈습니다!"
    },
    "nnaz": {
      "source_hash": "8b50180f6ced",
      "text": "헛간 안에서 벌어진 비밀 조각 현장입니다,"
    },
    "nrhk": {
      "source_hash": "17caa09c60b9",
      "text": "헐은 매일 헛간에서 직접 작업을 감독했습니다!"
    },
    "txxk": {
      "source_hash": "c1afafee0af6",
      "text": "고대 화석 같은 피부 질감은 어떻게 만들었나요?"
    },
    "8za7": {
      "source_hash": "af4b205f583a",
      "text": "갓 깎아낸 돌 표면은 너무 매끄러웠을 텐데요!"
    },
    "vevb": {
      "source_hash": "f01b31e73836",
      "text": "바로 거기에 헐의 기발한 묘수가 숨어 있었습니다!"
    },
    "7zvv": {
      "source_hash": "0e80026a0136",
      "text": "쇠바늘을 촘촘히 박은 특제 납 망치를 만들어,"
    },
    "rsmh": {
      "source_hash": "a5ecc4350012",
      "text": "바늘로 일일이 두들겨 10만 개의 모공을 새겨 넣었습니다!"
    },
    "jxu5": {
      "source_hash": "780355b89b8b",
      "text": "사람 피부의 미세한 땀구멍 질감을 완벽하게 흉내 낸 것이죠!"
    },
    "ay5a": {
      "source_hash": "ea13dd9c24cf",
      "text": "10만 개의 땀구멍을 일일이 두들겨 파다니! 정말 놀랍네요!"
    },
    "fc3r": {
      "source_hash": "711282ec385d",
      "text": "이어서 조각상 표면에 황산과 잉크를 붓고 문질러,"
    },
    "8ktw": {
      "source_hash": "90e4d701ae06",
      "text": "수천 년 동안 풍화된 듯한 누런 얼룩을 만들어냈습니다,"
    },
    "8prg": {
      "source_hash": "c7c7b2092887",
      "text": "마치 땅속에서 수천 년 동안 잠들어 있던 것처럼 보이게요!"
    },
    "ywcq": {
      "source_hash": "6c4b9ae3311d",
      "text": "헐은 친척 농장 땅속 깊은 곳에 몰래 묻었습니다."
    },
    "sz43": {
      "source_hash": "1d2c648c91e0",
      "text": "꼬박 1년을 묻어둔 뒤에야 우연히 발견한 척 연기를 한 것이죠!"
    },
    "4wp7": {
      "source_hash": "cc98dcc404b6",
      "text": "이 정교한 사기극에 든 총비용은 2,200달러였습니다."
    },
    "iyam": {
      "source_hash": "658aa449f54c",
      "text": "2,200달러를 들여 수만 달러의 입장료를 챙겼다니요!"
    },
    "q7rs": {
      "source_hash": "2d03b9aff49e",
      "text": "그런데 어떻게 두 번째 거인이 나타나게 된 건가요?"
    },
    "y2s6": {
      "source_hash": "ff6cc2a49b4f",
      "text": "여기서부터 이 사건의 가장 황당한 절정이 시작됩니다!"
    },
    "nccy": {
      "source_hash": "1d8152b0d036",
      "text": "쇼 비즈니스의 제왕 바넘이 직접 찾아왔습니다!"
    },
    "p88i": {
      "source_hash": "2d5cdd39f2a5",
      "text": "거물 흥행사가 엄청난 돈 냄새를 맡은 것이죠!"
    },
    "5tcx": {
      "source_hash": "688b644dec39",
      "text": "그는 5만에서 6만 달러에 빌려달라고 제안했습니다!"
    },
    "st29": {
      "source_hash": "153c00afdebd",
      "text": "하지만 조합 소유주들은 그 자리에서 단칼에 거절했습니다!"
    },
    "n8uw": {
      "source_hash": "7caf377aa1c6",
      "text": "바넘이 거절당했다고 그냥 물러설 리가 없잖아요?"
    },
    "sck2": {
      "source_hash": "06e2649c25a1",
      "text": "바넘의 사전에는 포기라는 단어가 없었습니다!"
    },
    "9zxh": {
      "source_hash": "7d4451b00475",
      "text": "빌려주지 않는다면 내가 직접 만들면 그만이다!"
    },
    "z55y": {
      "source_hash": "c3124146ce45",
      "text": "그는 첩자를 보내 치수를 재고 석고 본을 떴습니다!"
    },
    "p7vf": {
      "source_hash": "e03e9341266b",
      "text": "불과 며칠 만에 똑같이 생긴 복제품을 찍어냈죠!"
    },
    "6dw4": {
      "source_hash": "69cc5cf33e5f",
      "text": "바넘은 한발 앞서 브로드웨이에서 공개 전시를 열었습니다!"
    },
    "efnu": {
      "source_hash": "a3afc041ee4b",
      "text": "브로드웨이에 두 거인이 동시에 등장하게 되었고,"
    },
    "yqdg": {
      "source_hash": "9ffb697229e8",
      "text": "원조 거인도 길 건너 아폴로 홀로 급히 운반되었습니다!"
    },
    "xuab": {
      "source_hash": "0d0b4b1fe016",
      "text": "불과 수백 미터 떨어진 두 전시장에서 정면승부가 펼쳐졌습니다!"
    },
    "rswm": {
      "source_hash": "f5b7e213e0a0",
      "text": "브로드웨이에서는 날마다 관객 쟁탈전이 벌어졌습니다!"
    },
    "kydw": {
      "source_hash": "896e53740d98",
      "text": "같은 길거리에서 두 거인이 손님을 끌다니요!"
    },
    "459w": {
      "source_hash": "20f10aae577e",
      "text": "바넘은 건너편이야말로 진짜 가짜라고 대대적으로 선전했습니다!"
    },
    "kv97": {
      "source_hash": "d7715277e856",
      "text": "가짜가 다른 가짜를 보고 가짜라고 비난하다니요!"
    },
    "nzev": {
      "source_hash": "19f1a3cd3d58",
      "text": "관객들은 가짜인 줄 뻔히 알면서도 앞다퉈 표를 샀습니다!"
    },
    "bwwb": {
      "source_hash": "406606f4a410",
      "text": "어느 쪽 가짜가 더 진짜 같은지 직접 비교해보고 싶었던 것이죠!"
    },
    "ubpf": {
      "source_hash": "fe7a701b703a",
      "text": "바넘의 말솜씨는 정말 당해낼 재간이 없군요!"
    },
    "ftam": {
      "source_hash": "ffe93ce5d649",
      "text": "양측은 신문사를 동원해 격렬한 여론전을 펼쳤습니다!"
    },
    "8bzd": {
      "source_hash": "f8f0866720ce",
      "text": "결과적으로 바넘은 원조보다 훨씬 더 많은 돈을 벌어들였습니다!"
    },
    "c23e": {
      "source_hash": "95d5614db715",
      "text": "격분한 원조 조합은 바넘을 법원에 고소했습니다!"
    },
    "gg67": {
      "source_hash": "97f723760cb0",
      "text": "바넘을 파렴치한 해적판 도둑이라고 맹비난했죠!"
    },
    "6k4x": {
      "source_hash": "a2d9d1620f07",
      "text": "권리 침해로 고소하고 전시 금지 가처분을 신청했습니다!"
    },
    "eujd": {
      "source_hash": "7e2a8e667f7e",
      "text": "이런 소송이 법원에서 통할 리가 있나요?"
    },
    "9esz": {
      "source_hash": "5cef42d140af",
      "text": "원조 자체도 날조된 가짜 석고상에 불과하잖아요!"
    },
    "xkxx": {
      "source_hash": "d0ac0b36748c",
      "text": "재판은 도시 전체의 최고의 웃음거리가 되었고,"
    },
    "eb8t": {
      "source_hash": "cb7781f2d60f",
      "text": "신문들은 연일 희극 같은 재판 과정을 대서특필했습니다!"
    },
    "pibm": {
      "source_hash": "d67548f1106f",
      "text": "판사는 원고 측 변호인에게 전설적인 한마디를 남겼습니다:"
    },
    "h2vb": {
      "source_hash": "68c68ba1bdef",
      "text": "당신네 거인을 직접 법정에 데려와 선서하게 하시오!"
    },
    "fdfr": {
      "source_hash": "1886162728f3",
      "text": "석고상 보고 손을 들고 선서하라니요!"
    },
    "xnph": {
      "source_hash": "b33feca90c43",
      "text": "법원은 원고의 소송을 즉각 기각해버렸습니다!"
    },
    "kkr3": {
      "source_hash": "193b3ef1c053",
      "text": "법률은 사기 행위의 독점권을 보호해주지 않습니다."
    },
    "qri7": {
      "source_hash": "c75724725e10",
      "text": "스스로가 사기극인 이상 모방을 막을 권리가 없다는 것이었죠!"
    },
    "d9yh": {
      "source_hash": "c8bd95b45ec9",
      "text": "시카고 조각가들은 신문에 대놓고 광고까지 냈습니다,"
    },
    "tgzw": {
      "source_hash": "296a395969eb",
      "text": "돈만 주면 어떤 고대 신상도 조각해 주겠다고요!"
    },
    "3chd": {
      "source_hash": "804f051f4358",
      "text": "원하시는 고대 석인을 맞춤 주문받습니다, 네요!"
    },
    "2pxk": {
      "source_hash": "2a30ce3d11db",
      "text": "누구나 집 마당에서 거인을 캐낼 수 있는 시대가 된 것이죠!"
    },
    "2p23": {
      "source_hash": "065270ef63e6",
      "text": "사기가 또 다른 사기를 무너뜨린 통쾌한 판결이었습니다!"
    },
    "qbp9": {
      "source_hash": "14c4c18e9367",
      "text": "가짜가 가짜를 고소하다니 정말 전무후무한 일입니다!"
    },
    "ceue": {
      "source_hash": "b1fe03a9df94",
      "text": "판사의 판결은 법학 역사에 길이 남을 명언이 되었습니다!"
    },
    "2unw": {
      "source_hash": "40d5a6d15eb8",
      "text": "소동극은 막을 내리고 열풍은 점차 가라앉았습니다."
    },
    "iscb": {
      "source_hash": "346526cdfad0",
      "text": "주동자 헐도 결국 모든 진실을 대중 앞에 털어놓았죠."
    },
    "2a5y": {
      "source_hash": "8a1ad65916ad",
      "text": "원조 돌 거인은 부서지거나 버려지지 않고,"
    },
    "4j9u": {
      "source_hash": "17122a4bca5e",
      "text": "대중문화의 불멸의 전설로 남았습니다!"
    },
    "9iex": {
      "source_hash": "a778c6bde375",
      "text": "1947년 쿠퍼스타운의 농부 박물관에 영구 안치되었습니다."
    },
    "zeaw": {
      "source_hash": "b8d338447a0f",
      "text": "지금도 전시관에 누워 관람객들을 맞이하고 있죠!"
    },
    "hasc": {
      "source_hash": "0200ecbb86dc",
      "text": "100년이 지난 지금까지도 사람들이 보러 가는군요."
    },
    "44k3": {
      "source_hash": "4c7dae47fc4b",
      "text": "도대체 이유가 무엇일까요?"
    },
    "gfgf": {
      "source_hash": "4f11b7832dc7",
      "text": "사람들이 사는 것은 고대 유적의 입장권이 아니라,"
    },
    "xywb": {
      "source_hash": "cb16d04ed9d4",
      "text": "기적을 사랑하는 인류의 유쾌한 웃음소리이기 때문입니다!"
    },
    "cyfv": {
      "source_hash": "c9ab4ba87d9b",
      "text": "언제나 사람들은 기적에 가슴 뛰고 싶어 하는 법,"
    },
    "9d24": {
      "source_hash": "87b9926322dd",
      "text": "그것이야말로 카디프 거인이 가진 진정한 마력입니다!"
    },
    "2a4t": {
      "source_hash": "0028004390a8",
      "text": "기문파일국 제183호 사건 종결!"
    },
    "mfyz": {
      "source_hash": "a63407c18cf0",
      "text": "정말 흥미진진하고 멋진 대규모 사기극이었어요!"
    },
    "z2h5": {
      "source_hash": "85f9bbc6088a",
      "text": "입장료 수익만으로 당시 지방 은행의 준비금을 뛰어넘었을 정도였죠!"
    },
    "6ys5": {
      "source_hash": "c4c33878a780",
      "text": "이 가짜 연극은 실제 역사보다 훨씬 생생했습니다!"
    },
    "tizp": {
      "source_hash": "07e46ad7b0f1",
      "text": "바넘은 복제 거인을 이끌고 전미 순회공연에 나섰습니다!"
    },
    "gx84": {
      "source_hash": "4c62922f1a7a",
      "text": "가는 도시마다 구름 관중을 끌어모았죠!"
    },
    "582y": {
      "source_hash": "dd4566741e04",
      "text": "가짜 순회공연이 원조보다 더 큰 인기를 누렸다니요!"
    },
    "tnbn": {
      "source_hash": "dd99ed81af2b",
      "text": "그야말로 대중심리학의 가장 선명한 명강의였습니다!"
    },
    "zert": {
      "source_hash": "9cea43da740c",
      "text": "사람들은 때로 아름다운 환상을 더 믿고 싶어 합니다!"
    },
    "6x6q": {
      "source_hash": "721f9daf694d",
      "text": "평범한 현실보다 환상이 훨씬 더 흥미진진하니까요!"
    },
    "4gd9": {
      "source_hash": "f177fbb178c1",
      "text": "역사의 기이한 사건은 소설보다 훨씬 더 극적입니다!"
    },
    "rteq": {
      "source_hash": "99e9a464abd4",
      "text": "진실은 밝혀졌지만 이야기는 영원히 전해집니다!"
    },
    "2epz": {
      "source_hash": "5beeae8ab2af",
      "text": "호기심은 언제나 진실보다 더 큰 마력을 품고 있으니까요."
    },
    "sbrx": {
      "source_hash": "cc3bb8eb44b0",
      "text": "여러분이라면 이 유명한 가짜 거인을 보러 표를 사실 건가요?"
    },
    "5g8i": {
      "source_hash": "3882c32be6a3",
      "text": "댓글로 여러분의 생각을 남겨주시고 기문파일국을 구독해 주세요!"
    }
  }
}