  },
  "lines": {
    "cl1a": {
      "source_hash": "b7b07d5b841b",
      "text": "1970년대 후반, 잉글랜드 남부의 금요일 저녁."
    },
    "cl1c": {
      "source_hash": "aa0fe3587e10",
      "text": "풍경화가 더그와 데이브가 막잔을 비웁니다."
    },
    "cl1e": {
      "source_hash": "88a0668e6042",
      "text": "관계자 기록상, 쇠막대를 든 더그가 밀밭에 갔습니다."
    },
    "cl1g": {
      "source_hash": "bfe45af79853",
      "text": "약 9미터 원을 눌러 UFO 착륙처럼 꾸몄습니다."
    },
    "cl1k": {
      "source_hash": "d0d7324047b0",
      "text": "첫 3년간 아무도 몰랐습니다."
    },
    "cl1m": {
      "source_hash": "e841988db08a",
      "text": "하지만 뒤가 더 이상합니다."
    },
    "cl1n": {
      "source_hash": "4bb8794d657f",
      "text": "10여 년 뒤 켄트주, 연구자가 둘의 원을 응시합니다."
    },
    "cl1o": {
      "source_hash": "928d008bf93d",
      "text": "그 후, 전설 속 한 의사가 경비행기로"
    },
    "cl1o2": {
      "source_hash": "760620bf524c",
      "text": "약 45분 새 스톤헨지 옆 밭을 두 번 지났습니다."
    },
    "cl1p": {
      "source_hash": "28d1cc041a12",
      "text": "그날 밤의 더그는 말년에 후회하는 게 하나 있다고 했습니다."
    },
    "cl1l": {
      "source_hash": "127c07a14505",
      "text": "그럼 왜 1991년에 스스로 털어놓았을까요?"
    },
    "cl2a": {
      "source_hash": "bb1bf3d56ed9",
      "text": "둘은 멈추지 않고 해마다 다시 밭에 갔습니다."
    },
    "cl2j": {
      "source_hash": "29c0f0aabb9d",
      "text": "더그의 쇠막대는 나무판으로 바뀌었습니다. 1미터 남짓."
    },
    "cl2k": {
      "source_hash": "d2ee5e3401e0",
      "text": "더그는 중심에서 끈을 잡고,"
    },
    "cl2l": {
      "source_hash": "558bb2a847ed",
      "text": "데이브는 판을 무릎께 들고,"
    },
    "cl2m": {
      "source_hash": "9c3612abe9d8",
      "text": "돌면 밀이 눕습니다."
    },
    "cl2n": {
      "source_hash": "dee28f49acc7",
      "text": "야구모자 챙의 철사 고리로 조준했습니다."
    },
    "cl2o": {
      "source_hash": "58660410cb7b",
      "text": "도구는 이뿐입니다. 하룻밤, 둘."
    },
    "cl2p": {
      "source_hash": "9551e711fd09",
      "text": "밭은 그들 것이 아니었고, 망친 건 남의 작물입니다."
    },
    "cl2q": {
      "source_hash": "6b57bd8e891f",
      "text": "이 셈은 끝에 치르겠습니다."
    },
    "cl2r": {
      "source_hash": "28def7241119",
      "text": "결국 아내가 먼저 알아챘고,"
    },
    "cl2r2": {
      "source_hash": "c5e8e94cc818",
      "text": "더그 본인 말로는, 차의 주행거리로 들통났습니다."
    },
    "cl2s": {
      "source_hash": "a8c13b71b2f2",
      "text": "스크랩북을 보이고 밭에도 데려갔습니다."
    },
    "cl2t": {
      "source_hash": "902c0618dce0",
      "text": "그제야 그 원이 남편 짓임을 믿었습니다."
    },
    "cl2u": {
      "source_hash": "6e55616b3db8",
      "text": "1980년경 드디어 한 신문이 썼습니다."
    },
    "cl2v": {
      "source_hash": "48f7c6330cd5",
      "text": "제목은 훗날 부고가 전합니다."
    },
    "cl2w": {
      "source_hash": "2138b2821e47",
      "text": "그것이 다시 돌아왔다."
    },
    "cl3a": {
      "source_hash": "77be78866bf9",
      "text": "보도 뒤 원을 본격 연구하는 이가 생겼습니다."
    },
    "cl3a2": {
      "source_hash": "c50cbfee0e7d",
      "text": "UFO 팬은 착륙 흔적이라 했고, 처음 의도대로였습니다."
    },
    "cl3b": {
      "source_hash": "d7cd1bdb58ba",
      "text": "한 기상학자가 날씨로 설명했습니다."
    },
    "cl3c": {
      "source_hash": "f3c60e62a94d",
      "text": "대기 중 회전 기류가 작물을 누른다고 주장했습니다."
    },
    "cl3d": {
      "source_hash": "ce048bd6f724",
      "text": "기류가 전기 띤 물질을 싣고 밀을 누릅니다."
    },
    "cl3e": {
      "source_hash": "138decf6f0b2",
      "text": "그가 붙인 이름은 플라스마 소용돌이입니다."
    },
    "cl3f": {
      "source_hash": "11acbc84c6e1",
      "text": "은퇴한 기술자는 다른 길을 갔습니다."
    },
    "cl3g": {
      "source_hash": "20d65fc90a99",
      "text": "동료와 본 서클을 책으로 냈습니다."
    },
    "cl3h": {
      "source_hash": "d5cd8b37ffee",
      "text": "5만 부 넘게 팔렸습니다."
    },
    "cl3i": {
      "source_hash": "051e554b972e",
      "text": "탈이 납니다."
    },
    "cl3j": {
      "source_hash": "5dab21e2cf1e",
      "text": "둘은 날씨와 무관함을 증명하고 싶었습니다."
    },
    "cl3k": {
      "source_hash": "45e201442862",
      "text": "원 하나를 여러 개짜리 한 세트로 늘렸습니다."
    },
    "cl3l": {
      "source_hash": "ce59273ec737",
      "text": "이후 도형에 곧은 선이 나타났습니다."
    },
    "cl3m": {
      "source_hash": "d1a726a0613d",
      "text": "기상학자도 직선은 인공이라 인정했습니다."
    },
    "cl3n": {
      "source_hash": "b8136ce0f4da",
      "text": "단순 원은 대기 현상일 수 있다고 했습니다."
    },
    "cl3o": {
      "source_hash": "26f400579eb8",
      "text": "1991년, 한 물리학자도 한마디 했습니다."
    },
    "cl3p": {
      "source_hash": "b80fef760355",
      "text": "미스터리 서클은 장난이거나 공기 소용돌이랍니다."
    },
    "cl3r": {
      "source_hash": "ce458b5094f4",
      "text": "몇 개나? 브리태니커엔 200여 개입니다."
    },
    "cl3s": {
      "source_hash": "7fa52fab5846",
      "text": "물리 잡지는 250개를 자백했다고 씁니다."
    },
    "cl3t": {
      "source_hash": "5bee02d58666",
      "text": "타임지는 철마다 최대 25에서 30개랍니다."
    },
    "cl3u": {
      "source_hash": "e029b8e5d3a2",
      "text": "애호가들은 정부 연구비까지 청했습니다."
    },
    "cl3v": {
      "source_hash": "274eb377b34b",
      "text": "기억해 두십시오, 다시 나옵니다."
    },
    "cl4a": {
      "source_hash": "6dbf7c044388",
      "text": "그해 9월, 둘은 털어놓기로 했습니다."
    },
    "cl4e": {
      "source_hash": "f1437f512033",
      "text": "그해 더그는 67세, 데이브는 62세였습니다."
    },
    "cl4f": {
      "source_hash": "cda4fddaa197",
      "text": "기자를 따라 켄트로 갔고,"
    },
    "cl4g": {
      "source_hash": "d4b60f30b7b7",
      "text": "둘은 기자 앞에서 서클 하나를 만들었습니다."
    },
    "cl4h": {
      "source_hash": "f9c9582d7295",
      "text": "사람을 부릅니다."
    },
    "cl4h2": {
      "source_hash": "b4673955771c",
      "text": "누구를 불러 보여 줄까요?"
    },
    "cl4i": {
      "source_hash": "ac5fd939b3fa",
      "text": "그 책을 쓴 연구자가 왔습니다."
    },
    "cl4j": {
      "source_hash": "330736c6a921",
      "text": "쓰러진 밀을 응시합니다."
    },
    "cl4k": {
      "source_hash": "b5f5d3009c98",
      "text": "앞의 그 연구자는 밭에 서서 인간은 못 만든다고 했습니다."
    },
    "cl4l": {
      "source_hash": "6e4fae0fa363",
      "text": "서클을 만든 둘은 바로 뒤에 있었습니다."
    },
    "cl4m": {
      "source_hash": "ffca0ccb9c4b",
      "text": "더그는 미안하지만 줄곧 장난이었다고 했습니다."
    },
    "cl4n": {
      "source_hash": "79c1ab7f8ff4",
      "text": "연구자는 우리 다 속았다고 했습니다."
    },
    "cl4d": {
      "source_hash": "47f38ce89b56",
      "text": "9월 9일 영국 대중지에 실렸습니다."
    },
    "cl4q": {
      "source_hash": "9214d27c7bf0",
      "text": "제목은 세상을 속인 사람들입니다."
    },
    "cl4r": {
      "source_hash": "d62c8ae9eb28",
      "text": "이후 햄프셔 밭에서 기자들에게 재연했습니다."
    },
    "cl4s": {
      "source_hash": "82847bb3f58b",
      "text": "다른 연구자: 여긴 별것 없습니다,"
    },
    "cl4t": {
      "source_hash": "41b99d4123eb",
      "text": "아주 정정한 60세 노인 둘 말고는."
    },
    "cl4u": {
      "source_hash": "64fa2b8160b9",
      "text": "첫 연구자는 물러서,"
    },
    "cl4v": {
      "source_hash": "ee7b2a54798f",
      "text": "일부는 그들 짓이나 현상은 여전하다 했습니다."
    },
    "cl4w": {
      "source_hash": "e1ae4a8a474f",
      "text": "또 캐나다에도 서클이 있다고 반문했습니다."
    },
    "cl4x": {
      "source_hash": "cb1b5d75e18d",
      "text": "그럼 만든 이는 정말 둘뿐이었을까요?"
    },
    "cl5b": {
      "source_hash": "78d829e51c6e",
      "text": "둘뿐이 아니었고, 밭엔 이미 다른 이들이 있었습니다."
    },
    "cl5c": {
      "source_hash": "a01eddcb43b4",
      "text": "그해 여름엔 둘이 못 할 도형이 나왔습니다."
    },
    "cl5d": {
      "source_hash": "bd3ff98b796d",
      "text": "훗날 한 제작자는 그 여름에 첫 서클을 만들었다 했습니다."
    },
    "cl5e": {
      "source_hash": "5594c385827e",
      "text": "둘의 도형은 2세대 창작자를 낳았습니다."
    },
    "cl5f": {
      "source_hash": "dc305ccac2b3",
      "text": "이듬해, 두 노신사는 이그노벨상을 받았습니다."
    },
    "cl5g": {
      "source_hash": "20194f294084",
      "text": "수상 이유는 기하학적 영국 작물 파괴였습니다."
    },
    "cl5h": {
      "source_hash": "6004b39a04ac",
      "text": "밭의 일은 이미 둘과 무관했습니다."
    },
    "cl5i": {
      "source_hash": "1bdee7d475de",
      "text": "아직 제일 이상한 건 아닙니다."
    },
    "cl5j": {
      "source_hash": "c837ad18fb14",
      "text": "1996년 7월, 스톤헨지 옆에 도형이 나타났습니다."
    },
    "cl5l": {
      "source_hash": "d0061e329af1",
      "text": "퍼진 얘기론 저녁 5시 반, 밭은 아직 비었습니다."
    },
    "cl5n": {
      "source_hash": "1d5fc51f2745",
      "text": "앞의 그 의사가 45분 뒤 다시 지나자, 도형이 있었습니다."
    },
    "cl5o": {
      "source_hash": "e767e56a6db4",
      "text": "이 속도면 사람 짓일 리 없다고들 합니다."
    },
    "cl5q": {
      "source_hash": "8b588847ef28",
      "text": "인터뷰에서 서클 제작자가 다른 버전을 말했습니다."
    },
    "cl5r": {
      "source_hash": "89f37e1aeafa",
      "text": "전날 밤 셋이서 약 2시간 45분 만에 만들었답니다."
    },
    "cl5s": {
      "source_hash": "77745aae1939",
      "text": "의사가 처음엔 못 봤을 뿐이랍니다."
    },
    "cl5t": {
      "source_hash": "25c10a99be36",
      "text": "그는 제작자라곤 안 했습니다."
    },
    "cl5p": {
      "source_hash": "6ef37213e7ea",
      "text": "둘 다 한 인터뷰에서 나왔습니다."
    },
    "cl5u": {
      "source_hash": "ca1be2a54dd0",
      "text": "녹음도 없었고, 둘 다 일방적 주장입니다."
    },
    "cl5v": {
      "source_hash": "0a284097a07a",
      "text": "같은 달, 다른 도형에는 원이 194개 있었습니다."
    },
    "cl6a": {
      "source_hash": "115ff581afaf",
      "text": "점점 어려워지자 돈 내는 이가 생겼습니다."
    },
    "cl6b": {
      "source_hash": "09d9bb04e81a",
      "text": "한 예술 단체가 광고용 서클을 공개 수주했습니다."
    },
    "cl6c": {
      "source_hash": "9bc07d5adb87",
      "text": "고객은 시리얼 회사, 통신사, TV 프로였습니다."
    },
    "cl6d": {
      "source_hash": "5c3c72a7c32d",
      "text": "제작자 말론 신문사가 농부에게 6천 파운드."
    },
    "cl6e": {
      "source_hash": "3b4844f08ce6",
      "text": "눌린 작물 값은 그 60분의 1 정도였습니다."
    },
    "cl6f": {
      "source_hash": "b2decf665d1b",
      "text": "1998년 방송국이 작업을 찍었습니다."
    },
    "cl6g": {
      "source_hash": "fb796f20e596",
      "text": "한 팀이 원 100개를 눌렀습니다."
    },
    "cl6h": {
      "source_hash": "e5f1986d5cd9",
      "text": "약 1분에 원 하나 속도였습니다."
    },
    "cl6i": {
      "source_hash": "25acd01b2615",
      "text": "복잡한 도형은 형태가 최대 2,000개였습니다."
    },
    "cl6j": {
      "source_hash": "a05b1f2c73a8",
      "text": "다른 원인을 찾는 이도 있었습니다."
    },
    "cl6k": {
      "source_hash": "186eed8b6147",
      "text": "한 연구자는 서클 속 줄기 마디가 길어졌다 했습니다."
    },
    "cl6l": {
      "source_hash": "70fa58d180dc",
      "text": "그는 전자기파 가열 탓이라 추측했습니다."
    },
    "cl6m": {
      "source_hash": "170b153156e0",
      "text": "비판자들은 통계도 표본도 문제라 지적했습니다."
    },
    "cl6n": {
      "source_hash": "a298c3aa455f",
      "text": "쓰러진 밀은 원래 다르게 자란다는 겁니다."
    },
    "cl6o": {
      "source_hash": "604a5fd75085",
      "text": "제일 솔직한 건 물리학자:"
    },
    "cl6p": {
      "source_hash": "e9947ceb633b",
      "text": "이 연구는 입증도 반박도 안 됐습니다."
    },
    "cl6q": {
      "source_hash": "a8a2a880987f",
      "text": "수년간 아무도 셈하지 않은 게 있습니다."
    },
    "cl7o": {
      "source_hash": "d8532ffc7f57",
      "text": "그 셈은 2000년, 먼저 법정에 올랐습니다."
    },
    "cl7o2": {
      "source_hash": "39552a07efb3",
      "text": "제작자가 유죄를 인정, 벌금 100파운드."
    },
    "cl7m": {
      "source_hash": "93c17e467d5e",
      "text": "법적으론 분명합니다."
    },
    "cl7n": {
      "source_hash": "6d335edeef92",
      "text": "윌트셔 경찰은 재물손괴라고 말합니다."
    },
    "cl7q": {
      "source_hash": "ecf171121d99",
      "text": "나무판 얘기는 기록이지 권유가 아닙니다."
    },
    "cl7j": {
      "source_hash": "69db6eb430eb",
      "text": "밭에 서클이 생기면, 마을엔 손님이 늡니다."
    },
    "cl7k": {
      "source_hash": "dc47676f079e",
      "text": "2004년 안내소 직원 말로는,"
    },
    "cl7l": {
      "source_hash": "05198af26694",
      "text": "여름 매출 85에서 90%가 서클과 관련 있답니다."
    },
    "cl7a": {
      "source_hash": "1768cc920709",
      "text": "끝으로 미룬 셈, 기억하십니까?"
    },
    "cl7c": {
      "source_hash": "3eefff115fda",
      "text": "2017년 폭 약 60미터 서클이 밀 2에이커를 눕혔습니다."
    },
    "cl7e": {
      "source_hash": "0d69c09ec942",
      "text": "농부는 밭에 모금 양동이를 뒀습니다."
    },
    "cl7g": {
      "source_hash": "886d7500eeb3",
      "text": "가디언 집계로는 2018에서 2022년 92개."
    },
    "cl7h": {
      "source_hash": "075c664e3b23",
      "text": "농가 수입 3만 파운드 줄고"
    },
    "cl7i": {
      "source_hash": "71a52fe20e32",
      "text": "눌린 경작지는 축구장 40개가 넘습니다."
    },
    "cl7r": {
      "source_hash": "89bb997c2f75",
      "text": "두 노신사는 어떻게 됐을까요?"
    },
    "cl7s": {
      "source_hash": "98b6c5144a43",
      "text": "더그는 2018년, 94세까지 살았습니다."
    },
    "cl7t": {
      "source_hash": "9ea1a5eedd34",
      "text": "앞서 말한 말년의 후회는 모두에게 알린 것입니다."
    },
    "cl7u": {
      "source_hash": "c308e8c95e48",
      "text": "관계자 상상 속 그는 그저 눌린 밀이라 합니다."
    },
    "cl7v": {
      "source_hash": "da1040700e11",
      "text": "제겐 제일 흥미로운 게 범인이 아닙니다."
    },
    "cl7w": {
      "source_hash": "02942903f8b9",
      "text": "답이 공개돼도 왜 다들 안 믿느냐입니다."
    },
    "cl7za": {
      "source_hash": "204231c143a9",
      "text": "이 기록은 보관되지만, 주인 없는 서클도 있습니다."
    },
    "cl7x": {
      "source_hash": "dcb3e17dfbcd",
      "text": "연구비 기억하십니까?"
    },
    "cl7y": {
      "source_hash": "bf832d624c6c",
      "text": "왜 밝혔는지, 타임지는 연구비가 계기랍니다."
    },
    "cl7z": {
      "source_hash": "9218b7c00b34",
      "text": "부고는 공개가 데이브 뜻이었다고 씁니다."
    },
    "cl7zb": {
      "source_hash": "22fc5ba5cee6",
      "text": "결국 기록엔 결론이 없습니다."
    },
    "cl7zc": {
      "source_hash": "ad15e4f98f7b",
      "text": "어릴 적 짐작한 범인은? 댓글로"
    },
    "cl7zd": {
      "source_hash": "39b488d05f27",
      "text": "이 채널은 기록에 있는 것만 말합니다. 함께 보려면 구독을."
    }
  }
}
