  },
  "lines": {
    "p001": {
      "source_hash": "81a2b7b6f3ec",
      "text": "소장님! 어제 아침밥 때"
    },
    "p002": {
      "source_hash": "17bc60a8723c",
      "text": "엄마 폰이 갑자기 울렸어요!"
    },
    "p003": {
      "source_hash": "689c6152967b",
      "text": "아빠 폰도 같이,"
    },
    "p004": {
      "source_hash": "5d8ddcc7d163",
      "text": "너무 커서 무서웠어요!"
    },
    "p005": {
      "source_hash": "baef95dd4b31",
      "text": "몇 초 뒤 집이 흔들렸어요!"
    },
    "p006": {
      "source_hash": "ad0eaa184a6d",
      "text": "처음엔 살살, 곧 쾅!"
    },
    "p007": {
      "source_hash": "c0db77ba6503",
      "text": "우유가 다 쏟아졌어요!"
    },
    "p008": {
      "source_hash": "2eda3a59494d",
      "text": "폰이 지진보다 먼저 알아요?"
    },
    "p009": {
      "source_hash": "a11cceaa8601",
      "text": "나도 처음 듣고 놀랐어."
    },
    "p010": {
      "source_hash": "92d8fe13b619",
      "text": "지진 경보야."
    },
    "p011": {
      "source_hash": "f92597aa5db2",
      "text": "근데 울릴 땐 지진이 벌써 시작됐어."
    },
    "p012": {
      "source_hash": "4de2dee4d04b",
      "text": "지진 예측이 아니에요?"
    },
    "p013": {
      "source_hash": "a1e65ec49c41",
      "text": "아니. 예측은 미리 짐작하는 거,"
    },
    "p014": {
      "source_hash": "722ffbb31dc0",
      "text": "경보는 시작된 뒤에 얼른 알리는 거야."
    },
    "p015": {
      "source_hash": "a53ef71d92c6",
      "text": "시작됐는데,"
    },
    "p016": {
      "source_hash": "ac5cfcb5d805",
      "text": "집은 왜 아직 안 흔들렸어요?"
    },
    "p017": {
      "source_hash": "8cea578f07e4",
      "text": "좋은 질문. 거기가 제일 이상해."
    },
    "p018": {
      "source_hash": "d95a91a75a84",
      "text": "지진은 시작, 집은 그대로, 폰이 먼저 울렸지."
    },
    "p019": {
      "source_hash": "c8ed94f5a56a",
      "text": "근데 어떤 집엔 큰 흔들림이 경보보다 먼저 와."
    },
    "p020": {
      "source_hash": "afe13bd0fd7c",
      "text": "큰 지진 때 타이베이가 크게 흔들렸는데,"
    },
    "p021": {
      "source_hash": "bee52878298d",
      "text": "많은 폰이 한 번도 안 울렸어."
    },
    "p022": {
      "source_hash": "42bc468e3752",
      "text": "그 몇 초를 찾아보자."
    },
    "p023": {
      "source_hash": "a47c55498dbd",
      "text": "지진이 시작됐는데,"
    },
    "p024": {
      "source_hash": "97eb5859ae35",
      "text": "경보는 어떻게 큰 흔들림을 앞설까?"
    },
    "p025": {
      "source_hash": "b342cd03e088",
      "text": "시작부터 달리기 시합이거든."
    },
    "p026": {
      "source_hash": "8cda5f93f3e6",
      "text": "출발선은 땅속, 지진이 시작된 곳."
    },
    "p027": {
      "source_hash": "17739d53b118",
      "text": "출발선이 우리 집 밑이에요?"
    },
    "p028": {
      "source_hash": "8d9c627de4a4",
      "text": "매번 달라. 집에서 멀 때가 많아."
    },
    "p029": {
      "source_hash": "fdfaec03b6c4",
      "text": "출발선 바로 위, 땅 위의 그 점을 진앙이라고 해."
    },
    "p030": {
      "source_hash": "2d184ca60d1d",
      "text": "진앙은 출발선 바로 위!"
    },
    "p031": {
      "source_hash": "f6a1e63a0003",
      "text": "맞아!"
    },
    "p032": {
      "source_hash": "690d83e8d348",
      "text": "그럼 지진이 시작되면,"
    },
    "p033": {
      "source_hash": "3e749d3b8c82",
      "text": "대만 전체가 같이 흔들려요?"
    },
    "p034": {
      "source_hash": "fb8c63db93c8",
      "text": "아니. 흔들림은 출발선에서 밖으로 달려 나가."
    },
    "p035": {
      "source_hash": "940227e743cf",
      "text": "진앙에서 멀수록 늦게 와."
    },
    "p036": {
      "source_hash": "5ec6ce01a476",
      "text": "달리는 게 하나가 아니야."
    },
    "p037": {
      "source_hash": "bf0c5d83f9d2",
      "text": "또 누가 달려요? 누구요?"
    },
    "p038": {
      "source_hash": "8caecd6bbdce",
      "text": "맨 앞은 발 빠른 꼬마 전령."
    },
    "p039": {
      "source_hash": "0ba472f63811",
      "text": "살짝, 주로 위아래로 톡톡 흔들어."
    },
    "p040": {
      "source_hash": "84f4eb6bc995",
      "text": "바닥이 툭 올라오듯이요?"
    },
    "p041": {
      "source_hash": "a40ee4120f43",
      "text": "응, 살짝. 과학자들은 P파라고 해."
    },
    "p042": {
      "source_hash": "d63558e8c11f",
      "text": "뒤엔 덩치가 와. S파야."
    },
    "p043": {
      "source_hash": "6b8bfc258765",
      "text": "앞뒤 좌우로 세게, 훨씬 사나워."
    },
    "p044": {
      "source_hash": "e7bab2c0e9ed",
      "text": "물건 쓰러뜨리는 건,"
    },
    "p045": {
      "source_hash": "dcc9f17fbdd2",
      "text": "덩치예요?"
    },
    "p046": {
      "source_hash": "8f22616067a4",
      "text": "보통은. 꼬마 전령은 훨씬 순해."
    },
    "p047": {
      "source_hash": "2d64385783ba",
      "text": "그래서 처음엔 살살,"
    },
    "p048": {
      "source_hash": "9298bd5c4cce",
      "text": "전령이 먼저 왔어요!"
    },
    "p049": {
      "source_hash": "2d6fccf39f0a",
      "text": "맞아, 뒤의 큰 흔들림은 덩치야."
    },
    "p050": {
      "source_hash": "081c95471184",
      "text": "둘이 얼마나 빨리 달려요?"
    },
    "p051": {
      "source_hash": "fae8e5d88ce8",
      "text": "꼬마 전령은 1초에 약 6.5km 달려."
    },
    "p052": {
      "source_hash": "94dabbc200e6",
      "text": "덩치는 느려서 1초에 약 4km."
    },
    "p053": {
      "source_hash": "6574fdb34138",
      "text": "전령이 계속 달리면,"
    },
    "p054": {
      "source_hash": "a7560569a579",
      "text": "점점 더 앞서요?"
    },
    "p055": {
      "source_hash": "590d69e2bd96",
      "text": "응. 하나, 둘 세면 덩치는 약 8km,"
    },
    "p056": {
      "source_hash": "5ceff676b13d",
      "text": "전령은 약 13km, 벌써 약 5km 앞서."
    },
    "p057": {
      "source_hash": "42377e224ac8",
      "text": "잠깐 먼저 오는데,"
    },
    "p058": {
      "source_hash": "7ea07b2c7130",
      "text": "제가 어떻게 제때 숨어요?"
    },
    "p059": {
      "source_hash": "7a2a40b83ef9",
      "text": "집에서 느낀 전령만으론 늦을 때가 많아."
    },
    "p060": {
      "source_hash": "12c716035d0b",
      "text": "그래서 진앙 옆 관측소가 필요해."
    },
    "p061": {
      "source_hash": "c8adb3dc13c9",
      "text": "관측소? 그게 뭐예요?"
    },
    "p062": {
      "source_hash": "9de9afe70d29",
      "text": "땅의 움직임을 계속 듣는 기계야."
    },
    "p063": {
      "source_hash": "87da032ba2ab",
      "text": "대만 곳곳에 아주 많이 있어."
    },
    "p064": {
      "source_hash": "dc3a4640cf87",
      "text": "트랙 옆 심판이지."
    },
    "p065": {
      "source_hash": "b7723030c5f5",
      "text": "촘촘할수록 진앙 바로 옆에 하나 있기 쉬워."
    },
    "p066": {
      "source_hash": "5bd8be6ec512",
      "text": "시작되면 진앙에 제일 가까운 관측소들이"
    },
    "p067": {
      "source_hash": "080d324ef3da",
      "text": "전령을 제일 먼저 들어."
    },
    "p068": {
      "source_hash": "b52939deeae1",
      "text": "관측소가 빨리 숨으라고 외쳐요?"
    },
    "p069": {
      "source_hash": "8351963141c6",
      "text": "듣기만 해, 심판처럼."
    },
    "p070": {
      "source_hash": "7b156f54668d",
      "text": "전령의 모습을 바로 기상청 컴퓨터로 보내."
    },
    "p071": {
      "source_hash": "d25af3d8672f",
      "text": "기상청이요? 날씨 알려 주는 데요?"
    },
    "p072": {
      "source_hash": "2e22a15d040a",
      "text": "응, 지진도 봐."
    },
    "p073": {
      "source_hash": "387a8bc4cd31",
      "text": "컴퓨터는 다 기다리지 않고,"
    },
    "p074": {
      "source_hash": "ef4103cb9d19",
      "text": "먼저 들은 몇 대로 계산해."
    },
    "p075": {
      "source_hash": "f629cf806fa2",
      "text": "급하네요! 안 기다려요?"
    },
    "p076": {
      "source_hash": "67ee8d5f57d0",
      "text": "안 기다려. 1초마다 덩치가 달리거든."
    },
    "p077": {
      "source_hash": "c176aa02a10a",
      "text": "꼬마 전령을 보면 뭘 알아요?"
    },
    "p078": {
      "source_hash": "9cc866c44799",
      "text": "출발선과 지진 크기를 알고,"
    },
    "p079": {
      "source_hash": "ccc24584b85c",
      "text": "덩치가 어디에 얼마나 세게 갈지 짐작해."
    },
    "p080": {
      "source_hash": "a08d24655dce",
      "text": "컴퓨터는 금방 계산하죠?"
    },
    "p081": {
      "source_hash": "81bf822a0eab",
      "text": "시간이 걸려. 2016년 메이눙 지진 땐,"
    },
    "p082": {
      "source_hash": "b170b5914891",
      "text": "컴퓨터가 약 12초 만에 첫 답을 냈어."
    },
    "p083": {
      "source_hash": "dbd586b076cf",
      "text": "12초면,"
    },
    "p084": {
      "source_hash": "2ce84ebd5c00",
      "text": "덩치가 멀리 갔겠네요?"
    },
    "p085": {
      "source_hash": "cf554a7a4e39",
      "text": "응, 벌써 40km 넘게 달렸어."
    },
    "p086": {
      "source_hash": "96bdffa437a6",
      "text": "게다가 지진의 첫 부분만 봤어."
    },
    "p087": {
      "source_hash": "088b6004f939",
      "text": "그럼 틀릴 수도 있어요?"
    },
    "p088": {
      "source_hash": "cca91dca8247",
      "text": "짐작이라 빗나갈 때도 있어."
    },
    "p089": {
      "source_hash": "ff2e97049ff4",
      "text": "기억해 둬, 나중에 나와."
    },
    "p090": {
      "source_hash": "36c532ab430d",
      "text": "경보는 어떻게 덩치를 따라잡아요?"
    },
    "p091": {
      "source_hash": "b37536b8d635",
      "text": "경보는 안 달려. 전기로 보내."
    },
    "p092": {
      "source_hash": "f77490ae44be",
      "text": "전기는 덩치보다 훨씬훨씬 빨라."
    },
    "p093": {
      "source_hash": "50b52bc2c798",
      "text": "경보가 전기 타고 덩치를 이겨요!"
    },
    "p094": {
      "source_hash": "5eab0293c35e",
      "text": "응. 계산이 끝나면 바로 나가."
    },
    "p095": {
      "source_hash": "e5c9507f1bec",
      "text": "좀 먼 곳엔 덩치보다 경보가 먼저 도착해."
    },
    "p096": {
      "source_hash": "e6644f51be71",
      "text": "덩치도 그렇게 빠르면요?"
    },
    "p097": {
      "source_hash": "d73c57f6538c",
      "text": "절대 못 따라잡지."
    },
    "p098": {
      "source_hash": "d2929922483d",
      "text": "경보가 앞서는 건 덩치가 느린 덕분이야."
    },
    "p099": {
      "source_hash": "baafe60de2dc",
      "text": "전기가 폰까지 어떻게 와요?"
    },
    "p100": {
      "source_hash": "d7937e643bba",
      "text": "근처 기지국, 폰 신호 받는 안테나로 가서,"
    },
    "p101": {
      "source_hash": "78bd4fc26ecd",
      "text": "거기서 근처 모든 폰으로 가."
    },
    "p102": {
      "source_hash": "c8f2e4c3dd05",
      "text": "하나하나 전화 안 해요?"
    },
    "p103": {
      "source_hash": "11f0e4fc4c42",
      "text": "응. 한 번에 방송해서 근처 폰이 동시에 받아."
    },
    "p104": {
      "source_hash": "2cacb71871f4",
      "text": "근데 그 소리,"
    },
    "p105": {
      "source_hash": "d1e2bca37967",
      "text": "왜 그렇게 커요?"
    },
    "p106": {
      "source_hash": "225d9adfaf4f",
      "text": "몇 초 만에 모두를 깨워야 하거든."
    },
    "p107": {
      "source_hash": "89b41312278f",
      "text": "폰은 기본으로 특별한 경보음을 내고,"
    },
    "p108": {
      "source_hash": "3eb13dbc8c78",
      "text": "수신도 못 꺼."
    },
    "p109": {
      "source_hash": "132626a6da5a",
      "text": "그래서 가족 폰이 다 같이 울렸지."
    },
    "p110": {
      "source_hash": "ddfe355fb4cf",
      "text": "그래서 폰이 먼저,"
    },
    "p111": {
      "source_hash": "8e606510f7f5",
      "text": "집은 몇 초 뒤 흔들렸구나!"
    },
    "p112": {
      "source_hash": "b81fa54f4d75",
      "text": "맞아, 너희 집이 번 게 그 몇 초야."
    },
    "p113": {
      "source_hash": "b3c13456e527",
      "text": "지진 때마다 폰이 울려요?"
    },
    "p114": {
      "source_hash": "f2a862a6f105",
      "text": "아니. 지진이 크고,"
    },
    "p115": {
      "source_hash": "cae4d2fe90b6",
      "text": "너희 동네도 세게 흔들린다고 계산될 때만 울려."
    },
    "p116": {
      "source_hash": "a40e02bb6a3e",
      "text": "우리 집은 몇 초 벌어요?"
    },
    "p117": {
      "source_hash": "157b0ad92e8b",
      "text": "진앙과의 거리에 달렸어."
    },
    "p118": {
      "source_hash": "1ae3853786cc",
      "text": "덩치가 1초에 얼마나 가지?"
    },
    "p119": {
      "source_hash": "e7d882693970",
      "text": "1초에 약 4km!"
    },
    "p120": {
      "source_hash": "db371c7484d2",
      "text": "응. 우리 어림셈으론, 진앙에서 4km 멀어질 때마다"
    },
    "p121": {
      "source_hash": "ba0739664681",
      "text": "덩치는 약 1초 늦게 와."
    },
    "p122": {
      "source_hash": "a1ee5285acbc",
      "text": "멀수록 시간 많아요!"
    },
    "p123": {
      "source_hash": "a1e01378a682",
      "text": "그럼 메이눙 지진 때 타이베이는요?"
    },
    "p124": {
      "source_hash": "9f37e5a14d89",
      "text": "타이베이는 아주 멀어서,"
    },
    "p125": {
      "source_hash": "86c6a0168a78",
      "text": "경보가 큰 흔들림보다 약 49초 빠를 수 있었어."
    },
    "p126": {
      "source_hash": "932d4e50ad0f",
      "text": "그럼 가까울수록,"
    },
    "p127": {
      "source_hash": "b9570b011951",
      "text": "시간이 적어요?"
    },
    "p128": {
      "source_hash": "9cd8c2dcb4f9",
      "text": "응, 같은 지진도 곳마다 버는 시간이 달라."
    },
    "p129": {
      "source_hash": "f8922e447c0f",
      "text": "진앙 옆에 사는 사람은,"
    },
    "p130": {
      "source_hash": "65441408e66d",
      "text": "제일 먼저 받겠죠?"
    },
    "p131": {
      "source_hash": "3f7783db4333",
      "text": "꼭 먼저 받진 않고, 시간 벌기도 제일 어려워."
    },
    "p132": {
      "source_hash": "0225aa8c4474",
      "text": "계산하는 동안 덩치가 벌써 와 있곤 해."
    },
    "p133": {
      "source_hash": "e88b12a3876b",
      "text": "처음에 말한, 흔들린 뒤 경보 받은 집이야."
    },
    "p134": {
      "source_hash": "4aa50f7390b1",
      "text": "경보가 못 따라가는 곳, 사각지대야."
    },
    "p135": {
      "source_hash": "a7525f8168e1",
      "text": "사각지대, 안 보이는 데요?"
    },
    "p136": {
      "source_hash": "20c1ea691d21",
      "text": "비슷해. 경보가 아직 못 챙기는 곳이야."
    },
    "p137": {
      "source_hash": "1b6bada6fd7f",
      "text": "거기도 저 그날처럼,"
    },
    "p138": {
      "source_hash": "4c2558a5a5be",
      "text": "처음엔 살살 흔들려요?"
    },
    "p139": {
      "source_hash": "24b488ae87c8",
      "text": "응, 덩치가 바로 뒤일 수 있어."
    },
    "p140": {
      "source_hash": "14f3629536ce",
      "text": "그래서 거기선 흔들림 자체가 경보야."
    },
    "p141": {
      "source_hash": "142329f8025d",
      "text": "멀리 사는 사람은,"
    },
    "p142": {
      "source_hash": "69b4a45687a1",
      "text": "꼭 받아요?"
    },
    "p143": {
      "source_hash": "95c80d8d2707",
      "text": "꼭은 아냐. 계산은 짐작이라 했지?"
    },
    "p144": {
      "source_hash": "758327c0d904",
      "text": "처음 말한 타이베이 일은 2024년 4월,"
    },
    "p145": {
      "source_hash": "f23ff48dd74e",
      "text": "화롄 대지진이야. 시작 약 9초 뒤,"
    },
    "p146": {
      "source_hash": "f8b63e7b0ae6",
      "text": "첫 경보가 나갔어."
    },
    "p147": {
      "source_hash": "103c3881943a",
      "text": "9초! 화롄 사람들은"
    },
    "p148": {
      "source_hash": "a0c7a12c8738",
      "text": "다 잘 숨었겠죠?"
    },
    "p149": {
      "source_hash": "43ae41b421e3",
      "text": "근데 화롄은 진앙과 아주 가까워서,"
    },
    "p150": {
      "source_hash": "2f64b89a3e07",
      "text": "측정한 몇 곳은 약 5초에서 10초만 벌었어."
    },
    "p151": {
      "source_hash": "7f6881e65964",
      "text": "겨우 몇 초, 정말 쓸모 있어요?"
    },
    "p152": {
      "source_hash": "f4a8bf0cd9cc",
      "text": "있어. 몇 초면 몸을 지킬 수 있어."
    },
    "p153": {
      "source_hash": "6a5be3945218",
      "text": "그럼 타이베이는 더 머니까,"
    },
    "p154": {
      "source_hash": "2d37d861c61c",
      "text": "더 많이 벌었겠죠?"
    },
    "p155": {
      "source_hash": "93e8e57a4e9b",
      "text": "우리 어림셈으론 화롄에서 타이베이까지 약 140km,"
    },
    "p156": {
      "source_hash": "e4638bd4a707",
      "text": "덩치는 약 35초 걸려."
    },
    "p157": {
      "source_hash": "db3a5a71551c",
      "text": "9초보다 훨씬 길어요,"
    },
    "p158": {
      "source_hash": "ef8781505afa",
      "text": "타이베이는 늦지 않았죠!"
    },
    "p159": {
      "source_hash": "0f1597292177",
      "text": "그럴 수도 있었지. 근데 첫 계산이 지진을 너무 작게 봤어."
    },
    "p160": {
      "source_hash": "fde004cca28a",
      "text": "그래서 타이베이엔 안 보냈어."
    },
    "p161": {
      "source_hash": "77dc6138c2ef",
      "text": "타이베이 폰은 안 울렸어요?"
    },
    "p162": {
      "source_hash": "617a90b6a2da",
      "text": "경보는 없었는데, 타이베이는 정말 크게 흔들렸어."
    },
    "p163": {
      "source_hash": "3d9518e420d5",
      "text": "다들 엄청 놀랐겠다!"
    },
    "p164": {
      "source_hash": "6b212ffb36d4",
      "text": "응, 많은 사람이 흔들림으로 지진을 알았어."
    },
    "p165": {
      "source_hash": "9be8dabeba1b",
      "text": "나중엔 고쳤어요?"
    },
    "p166": {
      "source_hash": "9dfee2bb695c",
      "text": "응. 약 15초쯤 다시 한번 계산해서,"
    },
    "p167": {
      "source_hash": "9d927a98035c",
      "text": "더 크게 봤지만, 타이베이는 아슬아슬하게 또 못 받았어."
    },
    "p168": {
      "source_hash": "6886db97c6f6",
      "text": "왜 더 기다렸다가,"
    },
    "p169": {
      "source_hash": "a52f40391aa5",
      "text": "정확히 계산해서 안 보내요?"
    },
    "p170": {
      "source_hash": "e743ab4b38b7",
      "text": "오래 기다리면 덩치는 더 가고,"
    },
    "p171": {
      "source_hash": "9383555566b7",
      "text": "모두가 벌 시간이 줄어."
    },
    "p172": {
      "source_hash": "e01053dabad7",
      "text": "그래서 기상청도 규칙을 바꿨어. 아주 큰 지진엔,"
    },
    "p173": {
      "source_hash": "06254521e388",
      "text": "덜 흔들리는 곳도 경보를 받아."
    },
    "p174": {
      "source_hash": "d21b0303c679",
      "text": "경보도 놓칠 때가 있구나……"
    },
    "p175": {
      "source_hash": "ee158229f812",
      "text": "경보는 좋은 도우미지만, 짐작한 거야."
    },
    "p176": {
      "source_hash": "9bac3df5c13d",
      "text": "폰은 조용한데 흔들리는 것 같으면,"
    },
    "p177": {
      "source_hash": "ade941a6e57f",
      "text": "어떻게 해요?"
    },
    "p178": {
      "source_hash": "b5e87e8fbce5",
      "text": "폰 기다리지 마. 경보를 듣거나 흔들린다 싶으면,"
    },
    "p179": {
      "source_hash": "2656fa318ec6",
      "text": "바로 엎드리고, 가리고, 버티기."
    },
    "p180": {
      "source_hash": "27bfc268be86",
      "text": "엎드려야 안 넘어지고, 가리기는 머리와 목 보호,"
    },
    "p181": {
      "source_hash": "e37590297742",
      "text": "버티기는 꽉 잡고 흔들림이 멈추길 기다리기."
    },
    "p182": {
      "source_hash": "b1d19743d253",
      "text": "엎드리고, 가리고, 버티기!"
    },
    "p183": {
      "source_hash": "3477adb6f2d8",
      "text": "응, 급하게 밖으로 뛰지 마."
    },
    "p184": {
      "source_hash": "5f3b178de111",
      "text": "침대 위라면 그대로 침대에서 몸을 돌려 엎드려."
    },
    "p185": {
      "source_hash": "84a8617256f5",
      "text": "처음 질문 기억나? 네가 말해 봐."
    },
    "p186": {
      "source_hash": "414302f9d1ae",
      "text": "지진이 시작되면,"
    },
    "p187": {
      "source_hash": "1cc76bcbedf7",
      "text": "관측소가 전령을 먼저 듣고,"
    },
    "p188": {
      "source_hash": "0071591f3c80",
      "text": "계산되면 경보가 전기 타고,"
    },
    "p189": {
      "source_hash": "c8e2d3cbdd4d",
      "text": "덩치를 이겨요!"
    },
    "p190": {
      "source_hash": "471ba32e7bdb",
      "text": "근데 진앙 옆은 늦을 수 있고,"
    },
    "p191": {
      "source_hash": "ba9a471ecb67",
      "text": "컴퓨터도 틀릴 수 있어요!"
    },
    "p192": {
      "source_hash": "ca1bf0e594ca",
      "text": "맞아! 다음에 폰이 크게 울리면,"
    },
    "p193": {
      "source_hash": "3fef2a85a7bd",
      "text": "덩치가 오는 중일 수 있어. 바로 몸을 지켜."
    },
    "p194": {
      "source_hash": "36d742bcb996",
      "text": "그래서 그랬구나!"
    },
    "p195": {
      "source_hash": "61c19564f535",
      "text": "너는? 지진 경보에 놀란 적 있니?"
    },
    "p196": {
      "source_hash": "fe508e80b52e",
      "text": "댓글로 알려 줘."
    },
    "p197": {
      "source_hash": "88de677d4daa",
      "text": "생활 속 '왜'를 같이 찾으려면 그래서그랬구나 사무소 구독!"
    }
  }
}
