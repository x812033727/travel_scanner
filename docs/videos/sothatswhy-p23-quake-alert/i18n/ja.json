    "chief-gap": "観測点が先にちび伝令を聞く",
    "wires": "警報は電気に乗って大男を追い越す",
    "chief-near": "警報が間に合わない、ずれるとき",
    "kid-drop": "ハテナが自分で謎を解く"
  },
  "source_hashes": {
    "chapters": {
      "kid-phone-blare": "77594e05c8ef",
      "ground-start": "c35ae42ec6f1",
