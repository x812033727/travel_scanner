  "lines": {
    "p001": {
      "source_hash": "81a2b7b6f3ec",
      "text": "Bu! Kemarin pas sarapan,"
    },
    "p002": {
      "source_hash": "17bc60a8723c",
      "text": "HP Mama tiba-tiba menjerit!"
    },
    "p003": {
      "source_hash": "689c6152967b",
      "text": "HP Papa juga ikut,"
    },
    "p004": {
      "source_hash": "5d8ddcc7d163",
      "text": "Keras banget, seram!"
    },
    "p005": {
      "source_hash": "baef95dd4b31",
      "text": "Beberapa detik kemudian,"
    },
    "p006": {
      "source_hash": "ad0eaa184a6d",
      "text": "goyang pelan, lalu kencang!"
    },
    "p007": {
      "source_hash": "c0db77ba6503",
      "text": "Susunya sampai tumpah!"
    },
    "p008": {
      "source_hash": "2eda3a59494d",
      "text": "Kok HP tahu duluan dari gempa?"
    },
    "p009": {
      "source_hash": "a11cceaa8601",
      "text": "Aku pun kaget pertama kali."
    },
    "p010": {
      "source_hash": "92d8fe13b619",
      "text": "Peringatan gempa."
    },
    "p011": {
      "source_hash": "f92597aa5db2",
      "text": "Tapi saat bunyi, gempanya sudah mulai."
    },
    "p012": {
      "source_hash": "4de2dee4d04b",
      "text": "Jadi bukan ramalan gempa?"
    },
    "p013": {
      "source_hash": "a1e65ec49c41",
      "text": "Bukan. Ramalan itu menebak sebelum gempa."
    },
    "p014": {
      "source_hash": "722ffbb31dc0",
      "text": "Peringatan dikirim begitu gempa mulai."
    },
    "p015": {
      "source_hash": "a53ef71d92c6",
      "text": "Sudah mulai,"
    },
    "p016": {
      "source_hash": "ac5cfcb5d805",
      "text": "kok rumahku belum goyang?"
    },
    "p017": {
      "source_hash": "8cea578f07e4",
      "text": "Bagus, ini bagian anehnya."
    },
    "p018": {
      "source_hash": "d95a91a75a84",
      "text": "Gempa mulai, rumahmu diam, tapi HP sudah bunyi."
    },
    "p019": {
      "source_hash": "c8ed94f5a56a",
      "text": "Tahu? Ada rumah yang diguncang sebelum peringatan."
    },
    "p020": {
      "source_hash": "afe13bd0fd7c",
      "text": "Pernah Taipei diguncang keras,"
    },
    "p021": {
      "source_hash": "bee52878298d",
      "text": "tapi HP banyak orang tak bunyi."
    },
    "p022": {
      "source_hash": "42bc468e3752",
      "text": "Kita cari detiknya."
    },
    "p023": {
      "source_hash": "a47c55498dbd",
      "text": "Gempanya mulai,"
    },
    "p024": {
      "source_hash": "97eb5859ae35",
      "text": "kok peringatan bisa menyalip?"
    },
    "p025": {
      "source_hash": "b342cd03e088",
      "text": "Sebab gempa itu balapan."
    },
    "p026": {
      "source_hash": "8cda5f93f3e6",
      "text": "Start di bawah tanah, tempat gempa mulai."
    },
    "p027": {
      "source_hash": "17739d53b118",
      "text": "Startnya di bawah rumahku?"
    },
    "p028": {
      "source_hash": "8d9c627de4a4",
      "text": "Selalu beda, sering jauh darimu."
    },
    "p029": {
      "source_hash": "fdfaec03b6c4",
      "text": "Titik di permukaan tepat di atas start itu disebut episentrum."
    },
    "p030": {
      "source_hash": "2d184ca60d1d",
      "text": "Episentrum, tepat di atas start!"
    },
    "p031": {
      "source_hash": "f6a1e63a0003",
      "text": "Betul!"
    },
    "p032": {
      "source_hash": "690d83e8d348",
      "text": "Begitu gempa mulai,"
    },
    "p033": {
      "source_hash": "3e749d3b8c82",
      "text": "seluruh Taiwan goyang bareng?"
    },
    "p034": {
      "source_hash": "fb8c63db93c8",
      "text": "Bukan. Guncangan lari dari start ke segala arah,"
    },
    "p035": {
      "source_hash": "940227e743cf",
      "text": "Makin jauh, makin telat."
    },
    "p036": {
      "source_hash": "5ec6ce01a476",
      "text": "Yang lari bukan cuma satu."
    },
    "p037": {
      "source_hash": "bf0c5d83f9d2",
      "text": "Ada pelari lain? Siapa?"
    },
    "p038": {
      "source_hash": "8caecd6bbdce",
      "text": "Di depan, Si Kurir yang gesit."
    },
    "p039": {
      "source_hash": "0ba472f63811",
      "text": "Goyangnya pelan, kebanyakan naik-turun."
    },
    "p040": {
      "source_hash": "84f4eb6bc995",
      "text": "Kayak lantai melonjak?"
    },
    "p041": {
      "source_hash": "a40ee4120f43",
      "text": "Ya, pelan. Ilmuwan menyebut Si Kurir gelombang P."
    },
    "p042": {
      "source_hash": "d63558e8c11f",
      "text": "Lalu Si Besar, gelombang S"
    },
    "p043": {
      "source_hash": "6b8bfc258765",
      "text": "Ia mengguncang ke segala arah, jauh lebih keras."
    },
    "p044": {
      "source_hash": "e7bab2c0e9ed",
      "text": "Yang bikin jatuh,"
    },
    "p045": {
      "source_hash": "dcc9f17fbdd2",
      "text": "itu Si Besar?"
    },
    "p046": {
      "source_hash": "8f22616067a4",
      "text": "Biasanya. Si Kurir jauh lebih lembut."
    },
    "p047": {
      "source_hash": "2d64385783ba",
      "text": "Jadi goyangan pelan duluan"
    },
    "p048": {
      "source_hash": "9298bd5c4cce",
      "text": "itu Si Kurir datang!"
    },
    "p049": {
      "source_hash": "2d6fccf39f0a",
      "text": "Ya, guncangan besar itu Si Besar tiba."
    },
    "p050": {
      "source_hash": "081c95471184",
      "text": "Seberapa cepat mereka?"
    },
    "p051": {
      "source_hash": "fae8e5d88ce8",
      "text": "Si Kurir sekitar 6,5 km per detik."
    },
    "p052": {
      "source_hash": "94dabbc200e6",
      "text": "Si Besar sekitar 4 km per detik."
    },
    "p053": {
      "source_hash": "6574fdb34138",
      "text": "Kalau Si Kurir"
    },
    "p054": {
      "source_hash": "a7560569a579",
      "text": "terus makin unggul?"
    },
    "p055": {
      "source_hash": "590d69e2bd96",
      "text": "Ya. Hitung satu, dua: Si Besar lari sekitar 8 km,"
    },
    "p056": {
      "source_hash": "5ceff676b13d",
      "text": "Si Kurir sekitar 13 km, unggul sekitar 5 km."
    },
    "p057": {
      "source_hash": "42377e224ac8",
      "text": "Bedanya sebentar,"
    },
    "p058": {
      "source_hash": "7ea07b2c7130",
      "text": "mana sempat sembunyi?"
    },
    "p059": {
      "source_hash": "7a2a40b83ef9",
      "text": "Cuma dari rasa di rumah, sering tak sempat."
    },
    "p060": {
      "source_hash": "12c716035d0b",
      "text": "Maka perlu stasiun di dekatnya."
    },
    "p061": {
      "source_hash": "c8adb3dc13c9",
      "text": "Stasiun? Apa itu?"
    },
    "p062": {
      "source_hash": "9de9afe70d29",
      "text": "Mesin di tanah yang terus mendengar bumi."
    },
    "p063": {
      "source_hash": "87da032ba2ab",
      "text": "Di Taiwan ada banyak sekali."
    },
    "p064": {
      "source_hash": "dc3a4640cf87",
      "text": "Wasit lintasan."
    },
    "p065": {
      "source_hash": "b7723030c5f5",
      "text": "Makin rapat, makin mungkin ada di episentrum."
    },
    "p066": {
      "source_hash": "5bd8be6ec512",
      "text": "Saat mulai, stasiun terdekat"
    },
    "p067": {
      "source_hash": "080d324ef3da",
      "text": "dengar Si Kurir dulu"
    },
    "p068": {
      "source_hash": "b52939deeae1",
      "text": "Stasiun teriak \"sembunyi\"?"
    },
    "p069": {
      "source_hash": "8351963141c6",
      "text": "Cuma dengar, ala wasit"
    },
    "p070": {
      "source_hash": "7b156f54668d",
      "text": "Lalu kirim data Si Kurir ke komputer badan cuaca."
    },
    "p071": {
      "source_hash": "d25af3d8672f",
      "text": "Badan cuaca? Yang ramal cuaca itu?"
    },
    "p072": {
      "source_hash": "2e22a15d040a",
      "text": "Ya, gempa juga."
    },
    "p073": {
      "source_hash": "387a8bc4cd31",
      "text": "Tak tunggu semuanya,"
    },
    "p074": {
      "source_hash": "ef4103cb9d19",
      "text": "pakai yang awal, langsung hitung."
    },
    "p075": {
      "source_hash": "f629cf806fa2",
      "text": "Buru-buru amat, tak tunggu?"
    },
    "p076": {
      "source_hash": "67ee8d5f57d0",
      "text": "Tidak. Tiap detik, Si Besar terus maju."
    },
    "p077": {
      "source_hash": "c176aa02a10a",
      "text": "Dari Si Kurir, terlihat apa?"
    },
    "p078": {
      "source_hash": "9cc866c44799",
      "text": "Lokasi start, besarnya,"
    },
    "p079": {
      "source_hash": "ccc24584b85c",
      "text": "lalu Si Besar sampai mana, sekeras apa."
    },
    "p080": {
      "source_hash": "a08d24655dce",
      "text": "Komputer pasti kilat!"
    },
    "p081": {
      "source_hash": "81bf822a0eab",
      "text": "Hitung pun butuh waktu. Gempa Meinong 2016,"
    },
    "p082": {
      "source_hash": "b170b5914891",
      "text": "jawaban pertama butuh sekitar 12 detik."
    },
    "p083": {
      "source_hash": "dbd586b076cf",
      "text": "12 detik,"
    },
    "p084": {
      "source_hash": "2ce84ebd5c00",
      "text": "Si Besar sudah jauh dong?"
    },
    "p085": {
      "source_hash": "cf554a7a4e39",
      "text": "Ya, sudah lari lebih dari 40 km."
    },
    "p086": {
      "source_hash": "96bdffa437a6",
      "text": "Dan komputer baru lihat awal gempanya."
    },
    "p087": {
      "source_hash": "088b6004f939",
      "text": "Bisa salah hitung?"
    },
    "p088": {
      "source_hash": "cca91dca8247",
      "text": "Perkiraan, kadang meleset."
    },
    "p089": {
      "source_hash": "ff2e97049ff4",
      "text": "Ingat ini, nanti terpakai."
    },
    "p090": {
      "source_hash": "36c532ab430d",
      "text": "Gimana peringatan kejar Si Besar?"
    },
    "p091": {
      "source_hash": "b37536b8d635",
      "text": "Ia tak lari; ia naik listrik."
    },
    "p092": {
      "source_hash": "f77490ae44be",
      "text": "Listrik jauh lebih cepat dari Si Besar."
    },
    "p093": {
      "source_hash": "50b52bc2c798",
      "text": "Naik listrik, kalahkan Si Besar!"
    },
    "p094": {
      "source_hash": "5eab0293c35e",
      "text": "Ya. Selesai hitung, langsung dikirim."
    },
    "p095": {
      "source_hash": "e5c9507f1bec",
      "text": "Di tempat jauh, Si Besar belum tiba, peringatan sudah."
    },
    "p096": {
      "source_hash": "e6644f51be71",
      "text": "Kalau Si Besar secepat itu?"
    },
    "p097": {
      "source_hash": "d73c57f6538c",
      "text": "Tak terkejar."
    },
    "p098": {
      "source_hash": "d2929922483d",
      "text": "Peringatan bisa menang karena Si Besar lambat."
    },
    "p099": {
      "source_hash": "baafe60de2dc",
      "text": "Listriknya masuk HP gimana?"
    },
    "p100": {
      "source_hash": "d7937e643bba",
      "text": "Dikirim ke BTS terdekat, antena sinyal HP,"
    },
    "p101": {
      "source_hash": "78bd4fc26ecd",
      "text": "lalu ke semua HP di sekitarnya."
    },
    "p102": {
      "source_hash": "c8f2e4c3dd05",
      "text": "Tak ditelepon satu-satu?"
    },
    "p103": {
      "source_hash": "11f0e4fc4c42",
      "text": "Tidak. Sekali siar, semua HP sekitar terima bareng."
    },
    "p104": {
      "source_hash": "2cacb71871f4",
      "text": "Tapi suaranya,"
    },
    "p105": {
      "source_hash": "d1e2bca37967",
      "text": "kenapa keras sekali?"
    },
    "p106": {
      "source_hash": "225d9adfaf4f",
      "text": "Agar semua bangun dalam sekejap."
    },
    "p107": {
      "source_hash": "89b41312278f",
      "text": "HP otomatis membunyikan suara khusus,"
    },
    "p108": {
      "source_hash": "3eb13dbc8c78",
      "text": "tak bisa dimatikan."
    },
    "p109": {
      "source_hash": "132626a6da5a",
      "text": "Makanya HP sekeluargamu bunyi bareng."
    },
    "p110": {
      "source_hash": "ddfe355fb4cf",
      "text": "Pantas HP dulu,"
    },
    "p111": {
      "source_hash": "8e606510f7f5",
      "text": "rumah goyang belakangan!"
    },
    "p112": {
      "source_hash": "b81fa54f4d75",
      "text": "Ya, detik-detik itulah yang kamu dapat."
    },
    "p113": {
      "source_hash": "b3c13456e527",
      "text": "Tiap gempa, HP selalu bunyi?"
    },
    "p114": {
      "source_hash": "f2a862a6f105",
      "text": "Tidak. Harus diduga besar,"
    },
    "p115": {
      "source_hash": "cae4d2fe90b6",
      "text": "dan tempatmu bakal goyang keras, baru bunyi."
    },
    "p116": {
      "source_hash": "a40e02bb6a3e",
      "text": "Rumahku dapat berapa detik?"
    },
    "p117": {
      "source_hash": "157b0ad92e8b",
      "text": "Lihat jaraknya."
    },
    "p118": {
      "source_hash": "1ae3853786cc",
      "text": "Ingat laju Si Besar?"
    },
    "p119": {
      "source_hash": "e7d882693970",
      "text": "Sekitar 4 km!"
    },
    "p120": {
      "source_hash": "db371c7484d2",
      "text": "Ya. Hitung kasar: tiap 4 km lebih jauh,"
    },
    "p121": {
      "source_hash": "ba0739664681",
      "text": "telat sekitar 1 detik."
    },
    "p122": {
      "source_hash": "a1ee5285acbc",
      "text": "Jauh, makin lama!"
    },
    "p123": {
      "source_hash": "a1e01378a682",
      "text": "Waktu gempa Meinong, Taipei gimana?"
    },
    "p124": {
      "source_hash": "9f37e5a14d89",
      "text": "Taipei jauh sekali,"
    },
    "p125": {
      "source_hash": "86c6a0168a78",
      "text": "peringatan sekitar 49 detik lebih dulu."
    },
    "p126": {
      "source_hash": "932d4e50ad0f",
      "text": "Kalau makin dekat,"
    },
    "p127": {
      "source_hash": "b9570b011951",
      "text": "waktunya sedikit?"
    },
    "p128": {
      "source_hash": "9cd8c2dcb4f9",
      "text": "Ya, satu gempa, tiap tempat dapat waktu beda."
    },
    "p129": {
      "source_hash": "f8922e447c0f",
      "text": "Yang dekat episentrum,"
    },
    "p130": {
      "source_hash": "65441408e66d",
      "text": "pasti terima duluan?"
    },
    "p131": {
      "source_hash": "3f7783db4333",
      "text": "Belum tentu; di sana paling sulit dapat waktu."
    },
    "p132": {
      "source_hash": "0225aa8c4474",
      "text": "Selagi dihitung, Si Besar sering tiba."
    },
    "p133": {
      "source_hash": "e88b12a3876b",
      "text": "Rumah yang goyang duluan tadi, ya di sini."
    },
    "p134": {
      "source_hash": "4aa50f7390b1",
      "text": "Area ini disebut zona buta."
    },
    "p135": {
      "source_hash": "a7525f8168e1",
      "text": "Zona buta, tak kelihatan?"
    },
    "p136": {
      "source_hash": "20c1ea691d21",
      "text": "Ya, tempat peringatan belum keburu."
    },
    "p137": {
      "source_hash": "1b6bada6fd7f",
      "text": "Di sana, kayak aku,"
    },
    "p138": {
      "source_hash": "4c2558a5a5be",
      "text": "pelan dulu?"
    },
    "p139": {
      "source_hash": "24b488ae87c8",
      "text": "Si Besar bisa menyusul."
    },
    "p140": {
      "source_hash": "14f3629536ce",
      "text": "Jadi di sana, guncangan itu sendiri peringatannya."
    },
    "p141": {
      "source_hash": "142329f8025d",
      "text": "Yang tinggal jauh,"
    },
    "p142": {
      "source_hash": "69b4a45687a1",
      "text": "pasti dapat?"
    },
    "p143": {
      "source_hash": "95c80d8d2707",
      "text": "Belum tentu. Ingat, itu perkiraan?"
    },
    "p144": {
      "source_hash": "758327c0d904",
      "text": "Kejadian Taipei tadi itu April 2024,"
    },
    "p145": {
      "source_hash": "f23ff48dd74e",
      "text": "di Hualien. Sekitar 9 detik kemudian,"
    },
    "p146": {
      "source_hash": "f8b63e7b0ae6",
      "text": "peringatan pertama keluar."
    },
    "p147": {
      "source_hash": "103c3881943a",
      "text": "9 detik! Hualien"
    },
    "p148": {
      "source_hash": "a0c7a12c8738",
      "text": "pasti sudah aman?"
    },
    "p149": {
      "source_hash": "43ae41b421e3",
      "text": "Tapi Hualien dekat,"
    },
    "p150": {
      "source_hash": "2f64b89a3e07",
      "text": "tempat yang terukur cuma dapat sekitar 5 sampai 10 detik."
    },
    "p151": {
      "source_hash": "7f6881e65964",
      "text": "Cuma beberapa detik, berguna?"
    },
    "p152": {
      "source_hash": "f4a8bf0cd9cc",
      "text": "Ya. Beberapa detik pun bisa lindungi diri."
    },
    "p153": {
      "source_hash": "6a5be3945218",
      "text": "Taipei lebih jauh,"
    },
    "p154": {
      "source_hash": "2d37d861c61c",
      "text": "pasti dapat lebih?"
    },
    "p155": {
      "source_hash": "93e8e57a4e9b",
      "text": "Kasarnya Hualien ke Taipei sekitar 140 km,"
    },
    "p156": {
      "source_hash": "e4638bd4a707",
      "text": "Si Besar butuh sekitar 35 detik."
    },
    "p157": {
      "source_hash": "db3a5a71551c",
      "text": "Jauh lebih dari 9,"
    },
    "p158": {
      "source_hash": "ef8781505afa",
      "text": "Taipei pasti sempat!"
    },
    "p159": {
      "source_hash": "0f1597292177",
      "text": "Mestinya. Tapi hitungan pertama hari itu terlalu kecil,"
    },
    "p160": {
      "source_hash": "fde004cca28a",
      "text": "Taipei tak dikirimi."
    },
    "p161": {
      "source_hash": "77dc6138c2ef",
      "text": "HP di Taipei tak bunyi?"
    },
    "p162": {
      "source_hash": "617a90b6a2da",
      "text": "Tak ada. Tapi Taipei goyang keras sekali."
    },
    "p163": {
      "source_hash": "3d9518e420d5",
      "text": "Orang Taipei pasti kaget!"
    },
    "p164": {
      "source_hash": "6b212ffb36d4",
      "text": "Ya, banyak yang baru tahu setelah merasa goyang."
    },
    "p165": {
      "source_hash": "9be8dabeba1b",
      "text": "Lalu dihitung ulang?"
    },
    "p166": {
      "source_hash": "9dfee2bb695c",
      "text": "Ya. Sekitar detik ke-15, ia hitung lagi,"
    },
    "p167": {
      "source_hash": "9d927a98035c",
      "text": "gempa dinaikkan; Taipei nyaris, tapi tetap tidak."
    },
    "p168": {
      "source_hash": "6886db97c6f6",
      "text": "Kok tak tunggu lama,"
    },
    "p169": {
      "source_hash": "a52f40391aa5",
      "text": "biar hitungannya tepat?"
    },
    "p170": {
      "source_hash": "e743ab4b38b7",
      "text": "Makin lama tunggu,"
    },
    "p171": {
      "source_hash": "9383555566b7",
      "text": "Si Besar makin jauh, waktu makin sedikit."
    },
    "p172": {
      "source_hash": "e01053dabad7",
      "text": "Lalu aturan diubah: gempa sangat besar,"
    },
    "p173": {
      "source_hash": "06254521e388",
      "text": "yang goyangnya ringan pun dapat."
    },
    "p174": {
      "source_hash": "d21b0303c679",
      "text": "Ternyata peringatan bisa luput…"
    },
    "p175": {
      "source_hash": "ee158229f812",
      "text": "Peringatan itu teman baik, tapi hasilnya perkiraan."
    },
    "p176": {
      "source_hash": "9bac3df5c13d",
      "text": "HP diam, tapi terasa goyang,"
    },
    "p177": {
      "source_hash": "ade941a6e57f",
      "text": "aku harus apa?"
    },
    "p178": {
      "source_hash": "b5e87e8fbce5",
      "text": "Tak usah tunggu HP. Peringatan atau goyang,"
    },
    "p179": {
      "source_hash": "2656fa318ec6",
      "text": "segera Merunduk, Berlindung, Bertahan."
    },
    "p180": {
      "source_hash": "27bfc268be86",
      "text": "Merunduk agar tak jatuh; lindungi kepala dan leher;"
    },
    "p181": {
      "source_hash": "e37590297742",
      "text": "Bertahan: pegang erat sampai berhenti."
    },
    "p182": {
      "source_hash": "b1d19743d253",
      "text": "Merunduk, Berlindung, Bertahan!"
    },
    "p183": {
      "source_hash": "3477adb6f2d8",
      "text": "Jangan lari keluar."
    },
    "p184": {
      "source_hash": "5f3b178de111",
      "text": "Kalau di kasur, tetap di kasur, berbalik tengkurap."
    },
    "p185": {
      "source_hash": "84a8617256f5",
      "text": "Ingat pertanyaanmu tadi? Coba jelaskan."
    },
    "p186": {
      "source_hash": "414302f9d1ae",
      "text": "Gempa mulai,"
    },
    "p187": {
      "source_hash": "1cc76bcbedf7",
      "text": "stasiun dengar Si Kurir,"
    },
    "p188": {
      "source_hash": "0071591f3c80",
      "text": "hitung, naik listrik,"
    },
    "p189": {
      "source_hash": "c8e2d3cbdd4d",
      "text": "kalahkan Si Besar!"
    },
    "p190": {
      "source_hash": "471ba32e7bdb",
      "text": "Di episentrum bisa telat,"
    },
    "p191": {
      "source_hash": "ba9a471ecb67",
      "text": "komputer bisa salah!"
    },
    "p192": {
      "source_hash": "ca1bf0e594ca",
      "text": "Betul! Lain kali HP menjerit,"
    },
    "p193": {
      "source_hash": "3fef2a85a7bd",
      "text": "Si Besar di jalan? Lindungi diri!"
    },
    "p194": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p195": {
      "source_hash": "61c19564f535",
      "text": "Pernah kaget karena alarm?"
    },
    "p196": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar, ya!"
    },
    "p197": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
