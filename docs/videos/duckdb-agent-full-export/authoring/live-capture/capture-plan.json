  "steps": [
    {
      "index": 0,
      "title": "確認同一個執行工具",
      "args": [
        "--version"
      ],
      "display": "./duckdb --version",
      "note": "先確認使用的 DuckDB CLI 版本。",
      "hold_ms": 7000
    },
    {
      "index": 1,
      "title": "一般模式：預覽不是完整檔案",
      "args": [
        "-no-init",
        "-no-agent",
        ":memory:",
        "-f",
        "demo/preview.sql"
      ],
      "display": "./duckdb -no-init -no-agent :memory: -f demo/preview.sql",
      "note": "原始資料有 1,200 筆，畫面只顯示其中一部分。",
      "hold_ms": 7000
    },
    {
      "index": 2,
      "title": "agent 模式：明示省略了多少資料",
      "args": [
        "-no-init",
        "-agent",
        ":memory:",
        "-f",
        "demo/preview.sql"
      ],
      "display": "./duckdb -no-init -agent :memory: -f demo/preview.sql",
      "note": "同一個查詢：前後共 40 筆，中間 1,160 筆被省略。",
      "hold_ms": 9000
    },
    {
      "index": 3,
      "title": "完整匯出：只取已送達且真正晚到",
      "args": [
        "-no-init",
        "-agent",
        ":memory:",
        "-f",
        "demo/followup.sql"
      ],
      "display": "./duckdb -no-init -agent :memory: -f demo/followup.sql",
      "note": "完整條件：status='delivered' AND actual_days > promised_days",
      "hold_ms": 10000
    },
    {
      "index": 4,
      "title": "Parquet 讀回：確認完整檔案內容",
      "args": [
        "-no-init",
        "-no-agent",
        ":memory:",
        "-f",
        "demo/readback.sql"
      ],
      "display": "./duckdb -no-init -no-agent :memory: -f demo/readback.sql",
      "note": "將剛匯出的 Parquet 讀回 CSV，對照前一步的完整內容。",
      "hold_ms": 8000
    },
    {
      "index": 5,
      "title": "改需求：把剛好準時也列入",
      "args": [
        "-no-init",
        "-agent",
        ":memory:",
        "-f",
        "demo/variant.sql"
      ],
      "display": "./duckdb -no-init -agent :memory: -f demo/variant.sql",
      "note": "條件改為 actual_days >= promised_days，加入 240 筆剛好準時，共 720 筆。",
      "hold_ms": 10000
    }
