{
  "e3a01": "Solta.",
  "e3a02": "A próxima não erra.",
  "e3a03": "Tira a mão imunda!",
  "e3a04": "Que pimentinha.",
  "e3a05": "Vamos conversar!",
  "e3a06": "Vinte taéis. Passa pra cá.",
  "e3a07": "Mano, não temos dinheiro…",
  "e3a08": "Só uma tigela de arroz.",
  "e3a09": "Sem dinheiro? Levo gente!",
  "e3a10": "As três: escreve aí!",
  "e3a11": "Se atreve?",
  "e3a12": "Calma.",
  "e3a13": "Código Daheng, casamentos.",
  "e3a14": {
    "text": "Os nomes delas",
    "say": "Elas"
  },
  "e3a15": "tão no registro oficial.",
  "e3a16": "Tomá-las é roubar do governo.",
  "e3a17": "Isso, tá na lei.",
  "e3a18": "Tá. Sem gente.",
  "e3a19": "Casa, terra… e você!",
  "e3a20": {
    "text": "Três dias. Vinte taéis.",
    "say": "Em três dias, eu pago."
  },
  "e3a21": "Em três dias, a casa é minha!",
  "e3a22": {
    "text": "Três dias. Vinte taéis.",
    "say": "Em três dias, eu pago."
  },
  "e3a23": "Ding.",
  "e3a24": "Pacote inicial.",
  "e3a25": "Receita de sabão.",
  "e3a26": "Sem material nem ferramenta.",
  "e3a27": "Só isso?",
  "e3a28": "Afeição: ativada.",
  "e3a29": {
    "text": "Comigo aqui,",
    "say": "Comigo"
  },
  "e3a30": "ninguém te leva.",
  "e3a31": {
    "text": "Veredito: lorota.",
    "say": "Só lorota."
  },
  "e3a32": "A-Ling: menos cinco.",
  "e3a33": "Levou um raio?",
  "e3a34": "Bem feito.",
  "e3a35": "Não dá pra fingir…",
  "e3a36": "Acordada?",
  "e3a37": "Faca afiada…",
  "e3a38": "Aquilo de hoje foi lorota.",
  "e3a39": "Não devia ter dito.",
  "e3a40": "Por que não nos entregou?",
  "e3a41": "Eu…"
