{
  "e3a01": "Suelta.",
  "e3a02": "La próxima no falla.",
  "e3a03": "¡Quita tus manos sucias!",
  "e3a04": "¡Qué fiera!",
  "e3a05": "¡Hablemos con calma!",
  "e3a06": "Veinte taeles. A pagar.",
  "e3a07": "Hermano, no tenemos dinero…",
  "e3a08": "Solo queda un tazón de arroz.",
  "e3a09": "¿Sin dinero? ¡Me llevo gente!",
  "e3a10": {
    "text": "¡Anota a las tres!",
    "say": "¡Anótalas!"
  },
  "e3a11": "¿Te atreves?",
  "e3a12": "Espere.",
  "e3a13": {
    "text": "Código Daheng, sobre bodas.",
    "say": "Código Daheng:"
  },
  "e3a14": "Sus nombres",
  "e3a15": "están en el registro oficial.",
  "e3a16": "Llevárselas es robarle al gobierno.",
  "e3a17": "Sí, lo dice la ley.",
  "e3a18": "Bien. Sin gente.",
  "e3a19": "¡La casa, la tierra… y tú!",
  "e3a20": {
    "text": "En tres días, le pago veinte taeles.",
    "say": "Tres días: veinte taeles."
  },
  "e3a21": {
    "text": "¡En tres días, la casa es mía!",
    "say": "¡En tres días, es mía!"
  },
  "e3a22": "¿Tres días? ¿Veinte taeles?",
  "e3a23": "Ding.",
  "e3a24": "Paquete de inicio.",
  "e3a25": "Una receta de jabón.",
  "e3a26": "Materiales y herramientas: tuyos.",
  "e3a27": "¿Eso es todo?",
  "e3a28": {
    "text": "Medidor de afecto: activado.",
    "say": "Afecto: activado."
  },
  "e3a29": "Conmigo aquí,",
  "e3a30": "nadie te llevará.",
  "e3a31": {
    "text": "Veredicto: puro cuento.",
    "say": "Puro cuento."
  },
  "e3a32": {
    "text": "A-Ling: menos cinco.",
    "say": "Menos cinco."
  },
  "e3a33": "¿Le cayó un rayo?",
  "e3a34": "Merecido.",
  "e3a35": {
    "text": "No se puede fingir…",
    "say": "Ni modo."
  },
  "e3a36": "¿Despierta?",
  "e3a37": "Qué filo le sacas…",
  "e3a38": "Lo de hoy fue puro cuento.",
  "e3a39": "No debí decirlo.",
  "e3a40": "¿Por qué no nos entregaste?",
  "e3a41": "Yo…"
}
