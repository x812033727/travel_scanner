{
  "e3a01": "放しな。",
  "e3a02": "次は外さない。",
  "e3a03": "触らないで！",
  "e3a04": "とんだじゃじゃ馬だ。",
  "e3a05": "まあまあ！",
  "e3a06": "二十両、出してもらおう。",
  "e3a07": "お兄ちゃん、お金ないよ……",
  "e3a08": "お米一杯だけ。",
  "e3a09": "金がなけりゃ、人で払え！",
  "e3a10": "三人とも書いとけ！",
  "e3a11": "書く気？",
  "e3a12": "待て。",
  "e3a13": {
    "text": "大衡律、配婚篇。",
    "say": "律の配婚篇。"
  },
  "e3a14": "三人の名は、",
  "e3a15": "官府の名簿にある。",
  "e3a16": "勝手に連れたら、お上への盗みだ。",
  "e3a17": "そう、律にあるわ。",
  "e3a18": "よかろう、人は取らん。",
  "e3a19": "家と畑、それにお前だ！",
  "e3a20": "三日で二十両返す。",
  "e3a21": "三日後、家はもらう！",
  "e3a22": "三日で？二十両？",
  "e3a23": "ピコン。",
  "e3a24": "初心者パック。",
  "e3a25": "石鹸のレシピ。",
  "e3a26": "材料も道具も、自前で用意。",
  "e3a27": "それだけ？",
  "e3a28": "好感度、解放。",
  "e3a29": "俺がいる、",
  "e3a30": "渡さない。",
  "e3a31": "判定：虚言。",
  "e3a32": "アーリン、マイナス五。",
  "e3a33": "雷に打たれた？",
  "e3a34": "いい気味。",
  "e3a35": "甘くないか……",
  "e3a36": "起きてた？",
  "e3a37": "よく研いでるな……",
  "e3a38": "昼間のは、口先だけだった。",
  "e3a39": "悪かった。",
  "e3a40": "なぜ売らない？",
  "e3a41": "俺は……"
}
