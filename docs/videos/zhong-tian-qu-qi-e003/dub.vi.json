{
  "e3a01": "Buông tay.",
  "e3a02": "Đao sau, không trượt.",
  "e3a03": "Bỏ tay bẩn ra!",
  "e3a04": "Đúng là đồ đanh đá.",
  "e3a05": "Có gì từ từ nói!",
  "e3a06": "Đưa hai mươi lượng đây.",
  "e3a07": "Ca, nhà mình hết tiền…",
  "e3a08": "Chỉ còn một bát gạo.",
  "e3a09": "Không tiền thì lấy người gán!",
  "e3a10": "Cả ba, ghi hết vào!",
  "e3a11": "Ngươi dám ghi?",
  "e3a12": "Khoan.",
  "e3a13": "Đại Hành luật, thiên phối hôn.",
  "e3a14": "Tên của các nàng,",
  "e3a15": "nằm trong sổ quan phủ.",
  "e3a16": "Tự ý bắt, là cướp người của quan phủ.",
  "e3a17": "Đúng vậy, luật có ghi.",
  "e3a18": "Được, không bắt người.",
  "e3a19": "Nhà, đất, cộng thêm ngươi!",
  "e3a20": "Ba ngày, trả hai mươi lượng.",
  "e3a21": "Ba ngày sau, ta lấy nhà!",
  "e3a22": "Ba ngày? Hai mươi lượng?",
  "e3a23": "Đinh.",
  "e3a24": "Gói quà tân thủ.",
  "e3a25": "Một công thức xà phòng.",
  "e3a26": "Nguyên liệu tự lo, dụng cụ tự lo.",
  "e3a27": "Vậy thôi á?",
  "e3a28": "Độ hảo cảm: mở.",
  "e3a29": "Có ta ở đây,",
  "e3a30": "chẳng ai mang nàng đi.",
  "e3a31": {
    "text": "Phán định: nói suông.",
    "say": "Phán: nói suông."
  },
  "e3a32": "A Lệnh: âm năm.",
  "e3a33": "Hắn bị sét đánh à?",
  "e3a34": "Đáng đời.",
  "e3a35": "Không lừa được rồi…",
  "e3a36": "Chưa ngủ à?",
  "e3a37": "Dao mài sắc thế…",
  "e3a38": "Câu ban ngày là nói suông.",
  "e3a39": "Ta nói sai rồi.",
  "e3a40": "Sao ngươi không gán bọn ta?",
  "e3a41": "Ta…"
