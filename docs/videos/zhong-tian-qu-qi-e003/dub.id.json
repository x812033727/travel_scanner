{
  "e3a01": "Lepas.",
  "e3a02": "Berikutnya nggak meleset.",
  "e3a03": "Jauhkan tangan kotormu!",
  "e3a04": {
    "text": "Dasar perempuan galak.",
    "say": "Galak, ya."
  },
  "e3a05": "Sabar, sabar!",
  "e3a06": "Dua puluh tael, serahkan.",
  "e3a07": {
    "text": "Kak, kita nggak punya uang…",
    "say": "Kak, kita nggak ada uang"
  },
  "e3a08": "Cuma sisa semangkuk beras.",
  "e3a09": "Tak ada uang, ganti orang!",
  "e3a10": "Tiga-tiganya, tulis!",
  "e3a11": "Berani tulis?",
  "e3a12": "Tunggu.",
  "e3a13": "Hukum Daheng, bab perjodohan.",
  "e3a14": "Nama mereka",
  "e3a15": "ada di daftar resmi.",
  "e3a16": "Ambil mereka, berarti merampok milik negara.",
  "e3a17": "Betul, ada di hukum.",
  "e3a18": "Oke, orangnya nggak kuambil.",
  "e3a19": {
    "text": "Rumah, tanah, dan kamu!",
    "say": "Rumah, tanah, kamu!"
  },
  "e3a20": "Tiga hari, dua puluh tael.",
  "e3a21": {
    "text": "Tiga hari lagi, rumahnya kusita!",
    "say": "Tiga hari, kusita!"
  },
  "e3a22": "Tiga hari, dua puluh tael?",
  "e3a23": "Ding.",
  "e3a24": "Paket pemula.",
  "e3a25": "Satu resep sabun.",
  "e3a26": "Bahan dan alat, cari sendiri.",
  "e3a27": "Cuma ini?",
  "e3a28": "Poin suka, aktif.",
  "e3a29": {
    "text": "Ada aku,",
    "say": "Ada aku"
  },
  "e3a30": "nggak ada yang bawa kamu.",
  "e3a31": "Vonis: omong kosong.",
  "e3a32": {
    "text": "A-Ling: minus lima.",
    "say": "A-Ling minus lima."
  },
  "e3a33": "Kesambar petir?",
  "e3a34": "Rasain.",
  "e3a35": "Nggak bisa dibohongin, ya…",
  "e3a36": "Belum tidur?",
  "e3a37": "Pisaunya tajam banget…",
  "e3a38": "Omonganku tadi siang itu omong kosong.",
  "e3a39": "Aku salah ngomong.",
  "e3a40": "Kenapa tak serahkan kami?",
  "e3a41": {
    "text": "Aku…",
    "say": "Aku"
  }
}
