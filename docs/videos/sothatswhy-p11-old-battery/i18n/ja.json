    "spout": "注ぎ口がせまく、一気に出せない",
    "chief-good-news": "スマホはまず80%で止める",
    "chief-back": "ハテナが自分で謎を解く"
  },
  "source_hashes": {
    "chapters": {
      "kid-park": "fd6bf970f8d9",
