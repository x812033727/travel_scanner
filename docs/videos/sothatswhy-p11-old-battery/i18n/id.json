    "thumbnail": "e5930cd6e199"
  },
  "lines": {
    "p001": {
      "source_hash": "26a3755add34",
      "text": "Bu! Hari ini dingin,"
    },
    "p002": {
      "source_hash": "eb195bc4799b",
      "text": "aku foto tupai di taman,"
    },
    "p003": {
      "source_hash": "b4f6220048fb",
      "text": "pakai HP lama Mama,"
    },
    "p004": {
      "source_hash": "481060d1c472",
      "text": "pas kupotret, langsung mati!"
    },
    "p005": {
      "source_hash": "0462adc811b3",
      "text": "Padahal baterainya masih 20 persen!"
    },
    "p006": {
      "source_hash": "bf72fc018cd7",
      "text": "Kata Mama, waktu baru,"
    },
    "p007": {
      "source_hash": "4e6e9ad9e504",
      "text": "tahan seharian!"
    },
    "p008": {
      "source_hash": "e4da082216de",
      "text": "Apa HP-nya rusak?"
    },
    "p009": {
      "source_hash": "7d5411b1395b",
      "text": "Tenang dulu. Banyak HP lama bisa tiba-tiba mati."
    },
    "p010": {
      "source_hash": "94ad99be016a",
      "text": "Kenapa cuma HP lama begitu?"
    },
    "p011": {
      "source_hash": "cf3b55a5cc1f",
      "text": "Baterainya sudah tua."
    },
    "p012": {
      "source_hash": "2b35496eabe5",
      "text": "Tapi daya masih ada,"
    },
    "p013": {
      "source_hash": "b19c1a052749",
      "text": "kok baterai bisa tua?"
    },
    "p014": {
      "source_hash": "2fe77ec5f24e",
      "text": "Banyak yang kira daya banyak, baterai sehat."
    },
    "p015": {
      "source_hash": "87dd195656d3",
      "text": "Ada sebab tak terduga HP mati mendadak."
    },
    "p016": {
      "source_hash": "97739086fafd",
      "text": "Di dalamnya, diam-diam tumbuh lapisan."
    },
    "p017": {
      "source_hash": "b99dde9c6209",
      "text": "Sebab tak terduga? Ada yang tumbuh?"
    },
    "p018": {
      "source_hash": "850750382368",
      "text": "Aneh, ya? Ayo masuk ke baterai tua ini."
    },
    "p019": {
      "source_hash": "940f429ca9d9",
      "text": "Daya masih ada, kenapa baterai tua,"
    },
    "p020": {
      "source_hash": "855521726fab",
      "text": "dan mati mendadak?"
    },
    "p021": {
      "source_hash": "901cfb2a9e38",
      "text": "Untuk itu, ingat botol minummu."
    },
    "p022": {
      "source_hash": "b287878e37ec",
      "text": "Baterai ibarat botol listrik."
    },
    "p023": {
      "source_hash": "a51492fa849f",
      "text": "Botolku?"
    },
    "p024": {
      "source_hash": "90f3ef353704",
      "text": "Listrik bisa di botol?"
    },
    "p025": {
      "source_hash": "ae1a7f35aee1",
      "text": "Anggap listrik itu airnya."
    },
    "p026": {
      "source_hash": "a6997f9fd365",
      "text": "Persen di layar artinya seberapa penuh botolnya."
    },
    "p027": {
      "source_hash": "477df1283cd7",
      "text": "Jadi HP-ku tadi,"
    },
    "p028": {
      "source_hash": "2401952a1ab0",
      "text": "airnya tinggal sedikit?"
    },
    "p029": {
      "source_hash": "5322ec017432",
      "text": "Ya. Pakai listrik itu minum air;"
    },
    "p030": {
      "source_hash": "7880979793c1",
      "text": "mengecas itu mengisi botol lagi."
    },
    "p031": {
      "source_hash": "81ec511516ec",
      "text": "Kalau cas 100 persen,"
    },
    "p032": {
      "source_hash": "d940e544c812",
      "text": "isinya sama HP baru, kan?"
    },
    "p033": {
      "source_hash": "771f9f2e611f",
      "text": "Belum tentu. 100 persen cuma botol penuh."
    },
    "p034": {
      "source_hash": "81c473f98c86",
      "text": "Persen tak bilang besar botol."
    },
    "p035": {
      "source_hash": "33db6a361a85",
      "text": "Botol tua sudah menyusut."
    },
    "p036": {
      "source_hash": "07c1d5483d52",
      "text": "Penuh pun, airnya lebih sedikit."
    },
    "p037": {
      "source_hash": "84eed8f75d9b",
      "text": "Pantas HP lama, walau penuh,"
    },
    "p038": {
      "source_hash": "eb93712a87d7",
      "text": "tak kuat seharian!"
    },
    "p039": {
      "source_hash": "d84298451177",
      "text": "Minta orang dewasa buka Pengaturan HP."
    },
    "p040": {
      "source_hash": "2fcf7611a561",
      "text": "Ada “Kapasitas Maksimum” atau “Kesehatan Baterai”,"
    },
    "p041": {
      "source_hash": "f7d1ea8a2400",
      "text": "itulah besar botol sekarang."
    },
    "p042": {
      "source_hash": "8caa346c25e8",
      "text": "Kusuruh Mama cek!"
    },
    "p043": {
      "source_hash": "556a8ebb810b",
      "text": "Kok HP tahu besar botolnya?"
    },
    "p044": {
      "source_hash": "77c8cd824048",
      "text": "Ditaksir dari saat baru,"
    },
    "p045": {
      "source_hash": "c79bcdad7ea1",
      "text": "jadi bisa meleset."
    },
    "p046": {
      "source_hash": "e7d65396f613",
      "text": "Jadi persen juga taksiran?"
    },
    "p047": {
      "source_hash": "e73921a4ca7b",
      "text": "Ya. HP lihat kuatnya air mengalir,"
    },
    "p048": {
      "source_hash": "4433d0a70a72",
      "text": "dan hitung air keluar, lalu taksir."
    },
    "p049": {
      "source_hash": "4971c8908eab",
      "text": "Tapi kenapa botolnya"
    },
    "p050": {
      "source_hash": "1429e6ebe2cc",
      "text": "mengecil sendiri?"
    },
    "p051": {
      "source_hash": "e07c43702eb6",
      "text": "Karena perlahan tumbuh kerak di dalam."
    },
    "p052": {
      "source_hash": "26836cf95d2a",
      "text": "Seperti ketel di rumah, lama-lama ada lapisan putih keras,"
    },
    "p053": {
      "source_hash": "c785da8d7c10",
      "text": "itulah kerak."
    },
    "p054": {
      "source_hash": "c2d0d4e6ac82",
      "text": "Di baterai ada kerak?"
    },
    "p055": {
      "source_hash": "994d399b4995",
      "text": "Bukan kerak asli, tapi lapisan tipis mirip kerak."
    },
    "p056": {
      "source_hash": "006226d62fcd",
      "text": "Makin lama dipakai, makin tebal."
    },
    "p057": {
      "source_hash": "7c466cd66eeb",
      "text": "Baterai tua,"
    },
    "p058": {
      "source_hash": "01012a10c854",
      "text": "cuma karena kerak?"
    },
    "p059": {
      "source_hash": "068f03974968",
      "text": "Ada lagi. Ilmuwan temukan beberapa penyebabnya,"
    },
    "p060": {
      "source_hash": "5c9f8184a1c6",
      "text": "kerak salah satu sebab utama yang sering disebut."
    },
    "p061": {
      "source_hash": "eb53a2ba7b7e",
      "text": "Kerak menjebak benda kecil penyimpan listrik."
    },
    "p062": {
      "source_hash": "fa3bf06c6e23",
      "text": "Makin tebal, makin sedikit listrik yang muat."
    },
    "p063": {
      "source_hash": "48abcaf6d1c8",
      "text": "Kalau disikat,"
    },
    "p064": {
      "source_hash": "50acc8058979",
      "text": "beres, kan?"
    },
    "p065": {
      "source_hash": "8d5ab25a7c65",
      "text": "Tak bisa. Letaknya terdalam,"
    },
    "p066": {
      "source_hash": "264ae45f5a50",
      "text": "dan tak bisa hilang lagi."
    },
    "p067": {
      "source_hash": "19de73d6531a",
      "text": "Tiap cas,"
    },
    "p068": {
      "source_hash": "7495362b92b6",
      "text": "kerak tumbuh sekali?"
    },
    "p069": {
      "source_hash": "a12789279674",
      "text": "Kira-kira. Tapi HP menghitung “satu siklus”."
    },
    "p070": {
      "source_hash": "f33705f0dd35",
      "text": "Satu siklus itu sebotol penuh. Hari ini setengah,"
    },
    "p071": {
      "source_hash": "d93cea781805",
      "text": "besok setengah, genap sebotol: satu siklus."
    },
    "p072": {
      "source_hash": "b3ce3c9ce02c",
      "text": "Kalau sudah banyak sekali siklus?"
    },
    "p073": {
      "source_hash": "051d2516f4f6",
      "text": "Satu pembuat HP bilang, baterai model barunya,"
    },
    "p074": {
      "source_hash": "81421487e061",
      "text": "dalam kondisi sangat ideal,"
    },
    "p075": {
      "source_hash": "5b1d22cdcf95",
      "text": "dirancang tetap sekitar 80 persen setelah sekitar seribu siklus."
    },
    "p076": {
      "source_hash": "f44ea9e6fee2",
      "text": "Sebanyak itu,"
    },
    "p077": {
      "source_hash": "c17d533de479",
      "text": "pasti bertahun-tahun, ya?"
    },
    "p078": {
      "source_hash": "97c960fe77ea",
      "text": "Hitung kasar: kalau tiap hari habis sebotol,"
    },
    "p079": {
      "source_hash": "90742e3266d2",
      "text": "kira-kira hampir tiga tahun."
    },
    "p080": {
      "source_hash": "4921517983ef",
      "text": "Lama!"
    },
    "p081": {
      "source_hash": "04f8f339cfc8",
      "text": "baru susut sekitar 20 persen!"
    },
    "p082": {
      "source_hash": "7bf72cdbe627",
      "text": "Itu kalau ideal. Kenyataannya,"
    },
    "p083": {
      "source_hash": "b34b1ff7d7f9",
      "text": "tergantung cara dan tempat."
    },
    "p084": {
      "source_hash": "d8d10ea5206c",
      "text": "Tak kucas,"
    },
    "p085": {
      "source_hash": "1456cbfa74f6",
      "text": "tak ada kerak, kan?"
    },
    "p086": {
      "source_hash": "eb6d9969dd0a",
      "text": "Tidak. Didiamkan di laci, kerak tetap tumbuh pelan."
    },
    "p087": {
      "source_hash": "2b8d4e311826",
      "text": "Di tempat panas, kerak makin cepat,"
    },
    "p088": {
      "source_hash": "77b008c951cb",
      "text": "seperti mobil yang dijemur terik."
    },
    "p089": {
      "source_hash": "69f7e8167cc7",
      "text": "Sepanas apa itu terlalu panas?"
    },
    "p090": {
      "source_hash": "9689b8ad5f30",
      "text": "Kata pembuat HP, di atas sekitar 35 derajat, kepanasan."
    },
    "p091": {
      "source_hash": "cc8929847b5f",
      "text": "Kalau masuk freezer,"
    },
    "p092": {
      "source_hash": "37073b1c61b7",
      "text": "tak bakal tua, kan?"
    },
    "p093": {
      "source_hash": "d7e9f1479a06",
      "text": "Jangan! Beku pun tetap tua."
    },
    "p094": {
      "source_hash": "ab67fea3e17d",
      "text": "Kata pembuat HP, pakailah di atas sekitar 0 derajat."
    },
    "p095": {
      "source_hash": "82e4f98399af",
      "text": "Botol kecil cuma cepat habis,"
    },
    "p096": {
      "source_hash": "8c56e2c49839",
      "text": "kok bisa langsung mati?"
    },
    "p097": {
      "source_hash": "2e459a124aa6",
      "text": "Kerak tak cuma mengecilkan botol, mulutnya ikut sempit."
    },
    "p098": {
      "source_hash": "2c5750e11e70",
      "text": "Air keluar dari mulut botol; lebarnya menentukan derasnya."
    },
    "p099": {
      "source_hash": "a20875e49bfc",
      "text": "HP pakai listrik: menuang air dari mulut botol."
    },
    "p100": {
      "source_hash": "38287b395262",
      "text": "Bayangkan, segelas besar lewat mulut sempit,"
    },
    "p101": {
      "source_hash": "afa7fec6837b",
      "text": "lama sekali, kan?"
    },
    "p102": {
      "source_hash": "ce32541e20ac",
      "text": "Iya! Kalau minum sedikit-sedikit,"
    },
    "p103": {
      "source_hash": "c50b1e58692e",
      "text": "mulut sempit tak apa?"
    },
    "p104": {
      "source_hash": "298c8432e834",
      "text": "Ya. Pakai pelan, mulut sempit pun cukup."
    },
    "p105": {
      "source_hash": "fe41f5675cb7",
      "text": "Lalu kapan"
    },
    "p106": {
      "source_hash": "45e304ab828a",
      "text": "minum banyak sekaligus?"
    },
    "p107": {
      "source_hash": "5e7f6cad1c74",
      "text": "Buka kamera, main game berat,"
    },
    "p108": {
      "source_hash": "5a0f6652ff31",
      "text": "HP butuh banyak sekaligus."
    },
    "p109": {
      "source_hash": "6441e40a1068",
      "text": "Mulut sempit, air tak cukup,"
    },
    "p110": {
      "source_hash": "4f01b2a87e0b",
      "text": "lalu kenapa?"
    },
    "p111": {
      "source_hash": "415d5e9ba88e",
      "text": "Komponen HP mendadak kurang listrik,"
    },
    "p112": {
      "source_hash": "905636a8e375",
      "text": "tak bisa bekerja."
    },
    "p113": {
      "source_hash": "da2f4f6d6432",
      "text": "Jadi HP-nya rusak?"
    },
    "p114": {
      "source_hash": "e9542fa485ce",
      "text": "Bukan. HP mati sendiri lebih dulu,"
    },
    "p115": {
      "source_hash": "be12a4b3fe0a",
      "text": "jaga komponennya."
    },
    "p116": {
      "source_hash": "995384902b56",
      "text": "Jadi ini sebab tak terduganya!"
    },
    "p117": {
      "source_hash": "6d8845aae60f",
      "text": "Jadi, biasanya tak rusak."
    },
    "p118": {
      "source_hash": "f972ecc7e574",
      "text": "Tapi HP-ku masih ada daya,"
    },
    "p119": {
      "source_hash": "f33c73c39017",
      "text": "persennya bohong, ya?"
    },
    "p120": {
      "source_hash": "d0236112d5a7",
      "text": "Persen itu taksiran, bisa meleset."
    },
    "p121": {
      "source_hash": "31b95f01c0af",
      "text": "Tapi tak bohong, air masih ada,"
    },
    "p122": {
      "source_hash": "7b5a42b4d959",
      "text": "cuma mulut sempit, tak deras."
    },
    "p123": {
      "source_hash": "43a81ecbfc91",
      "text": "Isi botol, besar botol,"
    },
    "p124": {
      "source_hash": "130dd40a54e1",
      "text": "dan lebar mulut: tiga hal beda!"
    },
    "p125": {
      "source_hash": "eecb3f924643",
      "text": "Ya! Benar sekali."
    },
    "p126": {
      "source_hash": "e1f6ad9cfc0a",
      "text": "Kalau daya banyak,"
    },
    "p127": {
      "source_hash": "f1e1103f8f53",
      "text": "kok tak mati?"
    },
    "p128": {
      "source_hash": "4cd259966565",
      "text": "Air banyak, lebih deras;"
    },
    "p129": {
      "source_hash": "c415a8d49c38",
      "text": "tapi air sedikit, mulut sempit, gampang kurang."
    },
    "p130": {
      "source_hash": "fe8a83a23d21",
      "text": "Hari ini dingin,"
    },
    "p131": {
      "source_hash": "66574f436596",
      "text": "berpengaruh juga?"
    },
    "p132": {
      "source_hash": "cf399eecbf63",
      "text": "Ya. Dingin bikin mulut sempit sesaat,"
    },
    "p133": {
      "source_hash": "5d37521e5366",
      "text": "di tempat hangat, membaik lagi."
    },
    "p134": {
      "source_hash": "0e254a3914b4",
      "text": "Tadi kan dingin…"
    },
    "p135": {
      "source_hash": "d0f66280b39e",
      "text": "Aku hampir paham! Nanti,"
    },
    "p136": {
      "source_hash": "bdbf24dce1c6",
      "text": "aku mau tahu caranya dulu,"
    },
    "p137": {
      "source_hash": "1798c2d08e8c",
      "text": "agar baterai tak cepat tua?"
    },
    "p138": {
      "source_hash": "c6e4ddd4e248",
      "text": "Kabar baik: HP sudah banyak bantu."
    },
    "p139": {
      "source_hash": "b8ffd116ffcd",
      "text": "HP lama Mama nanti ada caranya."
    },
    "p140": {
      "source_hash": "59308359f1cb",
      "text": "HP membantuku? Bantu apa?"
    },
    "p141": {
      "source_hash": "b1bd98cde7e1",
      "text": "Baterai tak suka lama-lama penuh,"
    },
    "p142": {
      "source_hash": "32df4535f94a",
      "text": "kerak tumbuh lebih cepat."
    },
    "p143": {
      "source_hash": "3a62fb67bef9",
      "text": "HP belajar kebiasaanmu:"
    },
    "p144": {
      "source_hash": "fb269d4531a4",
      "text": "isi sekitar 80 persen,"
    },
    "p145": {
      "source_hash": "e147c17aa64c",
      "text": "jelang bangun, baru penuh."
    },
    "p146": {
      "source_hash": "ddef3305e5c3",
      "text": "Ia tahu jam bangunku?"
    },
    "p147": {
      "source_hash": "6bf1372c9b74",
      "text": "Ia ingat kapan kamu cabut kabel cas."
    },
    "p148": {
      "source_hash": "80f41eda7fd4",
      "text": "Ada pembuat HP bilang, sekitar dua minggu."
    },
    "p149": {
      "source_hash": "9bf5dd311123",
      "text": "Kujaga sendiri,"
    },
    "p150": {
      "source_hash": "c39e598e6892",
      "text": "cabut di 80 persen?"
    },
    "p151": {
      "source_hash": "171485649373",
      "text": "Tak usah, biar HP saja."
    },
    "p152": {
      "source_hash": "d1f2af9e9cd8",
      "text": "Sebagian HP bisa diatur, maksimal cas 80 persen."
    },
    "p153": {
      "source_hash": "6e73abf9f774",
      "text": "Harus habis dulu,"
    },
    "p154": {
      "source_hash": "ec773ca622e0",
      "text": "baru dicas, kan?"
    },
    "p155": {
      "source_hash": "744e37af15ff",
      "text": "Tidak. HP kini bisa dicas kapan saja,"
    },
    "p156": {
      "source_hash": "c957d8237883",
      "text": "tak perlu habis dulu baru penuh."
    },
    "p157": {
      "source_hash": "f4f1e87675d3",
      "text": "Hangat saat dicas,"
    },
    "p158": {
      "source_hash": "a338ab336b5b",
      "text": "harus bagaimana?"
    },
    "p159": {
      "source_hash": "e154bcf7a628",
      "text": "Panas percepat kerak, ingat?"
    },
    "p160": {
      "source_hash": "4a3925e215d0",
      "text": "Jadi saat dicas, lepas casing, dan jangan di bawah terik."
    },
    "p161": {
      "source_hash": "f1b48f19a405",
      "text": "Lalu HP lama Mama,"
    },
    "p162": {
      "source_hash": "0db2695f0920",
      "text": "ada caranya?"
    },
    "p163": {
      "source_hash": "6abb83b69cd1",
      "text": "Kerak tak hilang, kan?"
    },
    "p164": {
      "source_hash": "5a96dbecc749",
      "text": "jadi botol tak besar lagi."
    },
    "p165": {
      "source_hash": "ea2744fe8475",
      "text": "Terlalu tua? Ajak orang dewasa"
    },
    "p166": {
      "source_hash": "322691d93b25",
      "text": "ke servis, ganti baterai."
    },
    "p167": {
      "source_hash": "2b1f4987e2b2",
      "text": "Gembung, panas? Jangan pakai dan cas, lapor orang dewasa."
    },
    "p168": {
      "source_hash": "6de605f99574",
      "text": "Jadi tadi di taman,"
    },
    "p169": {
      "source_hash": "3232f3a3d895",
      "text": "HP-ku sebenarnya kenapa?"
    },
    "p170": {
      "source_hash": "343ac37c94d1",
      "text": "Kamu sudah tahu. Coba jelaskan."
    },
    "p171": {
      "source_hash": "97649651314a",
      "text": "Waktu kupotret, HP butuh minum banyak sekaligus,"
    },
    "p172": {
      "source_hash": "4477365ae731",
      "text": "mulut botol tua sempit, dingin pula,"
    },
    "p173": {
      "source_hash": "c217d7c03c74",
      "text": "jadi HP mati dulu, jaga diri!"
    },
    "p174": {
      "source_hash": "25d776eb3d96",
      "text": "Ya, tepat! Lain kali HP mati saat dingin,"
    },
    "p175": {
      "source_hash": "a643b25bb3b2",
      "text": "jangan salahkan, hangatkan dulu, coba nyalakan."
    },
    "p176": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p177": {
      "source_hash": "e45214931278",
      "text": "HP-mu pernah mati mendadak?"
    },
    "p178": {
      "source_hash": "fe508e80b52e",
      "text": "Tulis komentar!"
    },
    "p179": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
