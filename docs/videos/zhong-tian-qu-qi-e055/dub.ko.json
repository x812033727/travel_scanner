{
  "zq55a01": {
    "text": "거기 내가 원하는 게 있어.",
    "emotion": "看著火，很輕",
    "say": "원하는 게 있어."
  },
  "zq55a02": {
    "text": "가족.",
    "emotion": "笑"
  },
  "zq55a03": {
    "text": "아링 호감도, 육십일.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a04": {
    "text": "그게 무슨 대답이야……",
    "emotion": "睏，嘟囔",
    "say": "무슨 대답이야……"
  },
  "zq55a05": {
    "text": "세 부인의 호감도,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "모두 육십 돌파.",
    "emotion": "平板電子音"
  },
  "zq55a07": {
    "text": "대상 잠금 해제.",
    "emotion": "平板電子音"
  },
  "zq55a08": {
    "text": "대상: 화약 제조법.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq55a09": {
    "text": "화약……",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "이게 있으면,",
    "emotion": "低聲，咬牙，極短促，一口氣說完，不拖音",
    "say": "이거면,"
  },
  "zq55a11": {
    "text": "누가 감히 내 가족을 잡아가.",
    "emotion": "狠",
    "say": "누가 내 가족을 건드려."
  },
  "zq55a12": {
    "text": "하지만 이건,",
    "emotion": "低聲，快，說完就停",
    "say": "근데 이건,"
  },
  "zq55a13": {
    "text": "많은 사람을 죽일 수 있어.",
    "emotion": "很輕",
    "say": "많이 죽일 수 있어."
  },
  "zq55a14": {
    "text": "봉인.",
    "emotion": "很定"
  },
  "zq55a15": {
    "text": "나조차 열지 않아.",
    "emotion": "一字一字",
    "say": "나도 안 열어."
  },
  "zq55a16": {
    "text": "봉인 확인.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "무슨 생각 해?",
    "emotion": "很輕"
  },
  "zq55a18": {
    "text": "많은 사람을 죽일 수 있는 것.",
    "emotion": "很低",
    "say": "사람을 많이 죽일 물건."
  },
  "zq55a19": {
    "text": "일단 잠가 둘게.",
    "emotion": "淡淡的笑",
    "say": "잠가 둘게."
  },
  "zq55a20": {
    "text": "잘 잠가.",
    "emotion": "很輕，像答應"
  },
  "zq55a21": {
    "text": "이 난리,",
    "emotion": "挑眉"
  },
  "zq55a22": {
    "text": "주성보다 더 떠들썩하네.",
    "emotion": "笑",
    "say": "주성보다 요란하네."
  },
  "zq55a23": {
    "text": "우리 류시에서,",
    "emotion": "激動，快，說完就停",
    "say": "우리 류시,"
  },
  "zq55a24": {
    "text": "해원이 났다!",
    "emotion": "笑得鬍子抖"
  },
  "zq55a25": {
    "text": "오빠!",
    "emotion": "奶聲奶氣，大喊"
  },
  "zq55a26": {
    "text": "아링 언니가 그랬어,",
    "emotion": "得意，快，說完就停",
    "say": "아링 언니가,"
  },
  "zq55a27": {
    "text": "오빠 꼭 돌아온다고!",
    "emotion": "笑",
    "say": "꼭 돌아온다고!"
  },
  "zq55a28": {
    "text": "아링 언니!",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "해, 해원 나리……",
    "emotion": "陪笑，結巴"
  },
  "zq55a30": {
    "text": "첸 나리,",
    "emotion": "笑"
  },
  "zq55a31": {
    "text": "약속한 절은——",
    "emotion": "拖長音"
  },
  "zq55a32": {
    "text": "저, 저는……",
    "emotion": "快哭了"
  },
  "zq55a33": {
    "text": "됐소.",
    "emotion": "大方，極短促，一口氣說完，不拖音",
    "say": "됐어."
  },
  "zq55a34": {
    "text": "읍이나 한 번 하쇼.",
    "emotion": "笑",
    "say": "읍만 하쇼."
  },
  "zq55a35": {
    "text": "이 장부,",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "드디어 다 맞췄네.",
    "emotion": "得意",
    "say": "드디어 끝났네."
  },
  "zq55a37": {
    "text": "오빠,",
    "emotion": "奶聲奶氣"
  },
  "zq55a38": {
    "text": "해원이 뭐야?",
    "emotion": "好奇"
  },
  "zq55a39": {
    "text": "앞으로는,",
    "emotion": "低聲，快，說完就停",
    "say": "앞으론,"
  },
  "zq55a40": {
    "text": "아무도 널 못 괴롭힌다는 거야.",
    "emotion": "摸她的頭",
    "say": "아무도 널 못 괴롭혀."
  },
  "zq55a41": {
    "text": "탕 아가씨!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "도성에서 급한 서신입니다!",
    "emotion": "急",
    "say": "도성 급보입니다!"
  },
  "zq55a43": {
    "text": "웨이사오칭이……",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "초상화 한 폭을 들고,",
    "emotion": "畫外，聲音低下去",
    "say": "초상화를 들고,"
  },
  "zq55a45": {
    "text": "상부에 들어갔대.",
    "emotion": "停住"
  }
}
