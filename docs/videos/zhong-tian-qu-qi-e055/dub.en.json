{
  "zq55a01": {
    "text": "What I want is there.",
    "emotion": "看著火，很輕，快，說完就停",
    "say": "What I want."
  },
  "zq55a02": {
    "text": "A home.",
    "emotion": "笑"
  },
  "zq55a03": {
    "text": "A-Ling, affection: sixty-one.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: sixty-one."
  },
  "zq55a04": {
    "text": "What kind of answer is that…",
    "emotion": "睏，嘟囔",
    "say": "Some answer…"
  },
  "zq55a05": {
    "text": "All three wives' affection",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "has passed sixty.",
    "emotion": "平板電子音"
  },
  "zq55a07": {
    "text": "Grand prize unlocked.",
    "emotion": "平板電子音"
  },
  "zq55a08": {
    "text": "Grand prize: the gunpowder formula.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq55a09": {
    "text": "Gunpowder…",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "With this,",
    "emotion": "低聲，咬牙"
  },
  "zq55a11": {
    "text": "who'd dare take my family?",
    "emotion": "狠"
  },
  "zq55a12": {
    "text": "But it can also",
    "emotion": "聲音沉下來",
    "say": "But it can"
  },
  "zq55a13": {
    "text": "kill a lot of people.",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "Seal it.",
    "emotion": "很定"
  },
  "zq55a15": {
    "text": "Not even I will open it.",
    "emotion": "一字一字",
    "say": "Even I won't open it."
  },
  "zq55a16": {
    "text": "Seal confirmed.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "What are you thinking?",
    "emotion": "很輕"
  },
  "zq55a18": {
    "text": "Something that could kill a lot of people.",
    "emotion": "很低",
    "say": "Something that kills many."
  },
  "zq55a19": {
    "text": "Locked, for now.",
    "emotion": "淡淡的笑",
    "say": "Locked for now."
  },
  "zq55a20": {
    "text": "Keep it locked.",
    "emotion": "很輕，像答應",
    "say": "Lock it."
  },
  "zq55a21": {
    "text": "What a welcome,",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "Wow,"
  },
  "zq55a22": {
    "text": "livelier than the prefecture city!",
    "emotion": "笑",
    "say": "livelier than the city!"
  },
  "zq55a23": {
    "text": "Our Liuxi",
    "emotion": "蒼老，激動"
  },
  "zq55a24": {
    "text": "has produced a Jieyuan!",
    "emotion": "笑得鬍子抖",
    "say": "has a Jieyuan!"
  },
  "zq55a25": {
    "text": "Brother!",
    "emotion": "奶聲奶氣，大喊"
  },
  "zq55a26": {
    "text": "Sister A-Ling said",
    "emotion": "得意"
  },
  "zq55a27": {
    "text": "you'd come back for sure!",
    "emotion": "笑",
    "say": "you'd come back!"
  },
  "zq55a28": {
    "text": "Sister A-Ling!",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "H-Honored Jieyuan…",
    "emotion": "陪笑，結巴"
  },
  "zq55a30": {
    "text": "Squire Qian,",
    "emotion": "笑"
  },
  "zq55a31": {
    "text": "that kowtow you promised—",
    "emotion": "拖長音",
    "say": "that kowtow—"
  },
  "zq55a32": {
    "text": "I-I…",
    "emotion": "快哭了"
  },
  "zq55a33": {
    "text": "Forget it.",
    "emotion": "大方，極短促，一口氣說完，不拖音",
    "say": "No need."
  },
  "zq55a34": {
    "text": "A bow will do.",
    "emotion": "笑"
  },
  "zq55a35": {
    "text": "This account,",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "is finally settled.",
    "emotion": "得意"
  },
  "zq55a37": {
    "text": "Brother,",
    "emotion": "奶聲奶氣"
  },
  "zq55a38": {
    "text": "what's a Jieyuan?",
    "emotion": "好奇"
  },
  "zq55a39": {
    "text": "It means from now on,",
    "emotion": "低聲，快，說完就停",
    "say": "It means"
  },
  "zq55a40": {
    "text": "no one will dare pick on you.",
    "emotion": "摸她的頭",
    "say": "no one picks on you."
  },
  "zq55a41": {
    "text": "Miss Tang!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "Urgent letter from the capital!",
    "emotion": "急"
  },
  "zq55a43": {
    "text": "Wei Shaoqing…",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "took a portrait",
    "emotion": "畫外，聲音低下去"
  },
  "zq55a45": {
    "text": "into the chancellor's mansion.",
    "emotion": "停住",
    "say": "to the chancellor's."
  }
}
