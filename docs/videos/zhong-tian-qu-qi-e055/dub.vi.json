{
  "zq55a01": {
    "text": "Ở đó có thứ ta muốn.",
    "emotion": "看著火，很輕，快，說完就停",
    "say": "Có thứ ta muốn."
  },
  "zq55a02": {
    "text": "Một mái nhà.",
    "emotion": "低聲，快，說完就停"
  },
  "zq55a03": {
    "text": "A Lệnh hảo cảm, sáu mươi mốt.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a04": {
    "text": "Trả lời gì kỳ vậy…",
    "emotion": "睏，嘟囔",
    "say": "Đáp gì vậy…"
  },
  "zq55a05": {
    "text": "Hảo cảm ba vị thê tử,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "toàn bộ vượt sáu mươi.",
    "emotion": "平板電子音"
  },
  "zq55a07": {
    "text": "Mở khóa đại thưởng.",
    "emotion": "平板電子音"
  },
  "zq55a08": {
    "text": "Đại thưởng: công thức thuốc súng.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq55a09": {
    "text": "Thuốc súng…",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "Có nó rồi,",
    "emotion": "低聲，咬牙，極短促，一口氣說完，不拖音"
  },
  "zq55a11": {
    "text": "ai còn dám bắt người nhà ta.",
    "emotion": "狠"
  },
  "zq55a12": {
    "text": "Nhưng nó cũng có thể",
    "emotion": "低聲，快，說完就停",
    "say": "Nhưng nó cũng"
  },
  "zq55a13": {
    "text": "khiến rất nhiều người chết.",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "Niêm phong.",
    "emotion": "很定"
  },
  "zq55a15": {
    "text": "Đến chính ta cũng không mở.",
    "emotion": "一字一字",
    "say": "Ta cũng không mở."
  },
  "zq55a16": {
    "text": "Xác nhận niêm phong.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "Ngươi đang nghĩ gì?",
    "emotion": "很輕"
  },
  "zq55a18": {
    "text": "Thứ có thể giết rất nhiều người.",
    "emotion": "很低"
  },
  "zq55a19": {
    "text": "Tạm khóa lại đã.",
    "emotion": "淡淡的笑"
  },
  "zq55a20": {
    "text": "Khóa kỹ vào.",
    "emotion": "很輕，像答應"
  },
  "zq55a21": {
    "text": "Khí thế này,",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "Ghê thật,"
  },
  "zq55a22": {
    "text": "còn náo nhiệt hơn châu thành.",
    "emotion": "笑"
  },
  "zq55a23": {
    "text": "Liễu Khê chúng ta,",
    "emotion": "激動，極短促，一口氣說完，不拖音"
  },
  "zq55a24": {
    "text": "có giải nguyên rồi!",
    "emotion": "笑得鬍子抖"
  },
  "zq55a25": {
    "text": "Ca!",
    "emotion": "奶聲奶氣，大喊"
  },
  "zq55a26": {
    "text": "A Lệnh tỷ tỷ nói,",
    "emotion": "得意"
  },
  "zq55a27": {
    "text": "ca nhất định sẽ về!",
    "emotion": "笑"
  },
  "zq55a28": {
    "text": "A Lệnh tỷ tỷ!",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "Giải, giải nguyên lão gia…",
    "emotion": "陪笑，結巴，快，說完就停"
  },
  "zq55a30": {
    "text": "Tiền lão gia,",
    "emotion": "低聲，快，說完就停"
  },
  "zq55a31": {
    "text": "cái dập đầu đã hứa——",
    "emotion": "拖長音"
  },
  "zq55a32": {
    "text": "Tôi, tôi…",
    "emotion": "快哭了"
  },
  "zq55a33": {
    "text": "Miễn đi.",
    "emotion": "大方，極短促，一口氣說完，不拖音"
  },
  "zq55a34": {
    "text": "Vái một cái là được.",
    "emotion": "笑"
  },
  "zq55a35": {
    "text": "Món nợ này,",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "cuối cùng cũng tính xong.",
    "emotion": "得意"
  },
  "zq55a37": {
    "text": "Ca,",
    "emotion": "奶聲奶氣，極短促，一口氣說完，不拖音"
  },
  "zq55a38": {
    "text": "giải nguyên là gì?",
    "emotion": "好奇"
  },
  "zq55a39": {
    "text": "Là từ nay về sau,",
    "emotion": "低聲，快，說完就停",
    "say": "Là từ nay,"
  },
  "zq55a40": {
    "text": "không ai dám bắt nạt muội.",
    "emotion": "摸她的頭"
  },
  "zq55a41": {
    "text": "Đường tiểu thư!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "Thư khẩn từ kinh thành!",
    "emotion": "急"
  },
  "zq55a43": {
    "text": "Ngụy Thiếu Khanh…",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "mang theo một bức họa,",
    "emotion": "畫外，聲音低下去"
  },
  "zq55a45": {
    "text": "vào tướng phủ.",
    "emotion": "停住"
  }
}
