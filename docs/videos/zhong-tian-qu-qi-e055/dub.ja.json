{
  "zq55a01": {
    "text": "そこに、欲しいものがある。",
    "emotion": "看著火，很輕",
    "say": "欲しいものがある。"
  },
  "zq55a02": {
    "text": "家族だ。",
    "emotion": "低聲，快，說完就停",
    "say": "家族。"
  },
  "zq55a03": {
    "text": "アーリン、好感度、六十一。",
    "emotion": "平板電子音，快，說完就停",
    "say": "アーリン、六十一。"
  },
  "zq55a04": {
    "text": "何よ、その答え……",
    "emotion": "睏，嘟囔",
    "say": "何それ……"
  },
  "zq55a05": {
    "text": "三人の妻の好感度、",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "全員、六十を突破。",
    "emotion": "平板電子音"
  },
  "zq55a07": {
    "text": "大賞、解放。",
    "emotion": "平板電子音"
  },
  "zq55a08": {
    "text": "大賞：火薬の調合法。",
    "emotion": "平板電子音，快，說完就停",
    "say": "大賞：火薬の製法。"
  },
  "zq55a09": {
    "text": "火薬……",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "これがあれば、",
    "emotion": "低聲，咬牙",
    "say": "これで、"
  },
  "zq55a11": {
    "text": "誰も家族に手を出せない。",
    "emotion": "狠",
    "say": "家族に手は出させない。"
  },
  "zq55a12": {
    "text": "でもこれは、",
    "emotion": "低聲，快，說完就停",
    "say": "でもこれ、"
  },
  "zq55a13": {
    "text": "大勢を殺せる。",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "封印。",
    "emotion": "很定"
  },
  "zq55a15": {
    "text": "俺自身も開けない。",
    "emotion": "一字一字",
    "say": "俺も開けない。"
  },
  "zq55a16": {
    "text": "封印を確認。",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "何を考えてるの？",
    "emotion": "很輕",
    "say": "何考えてるの？"
  },
  "zq55a18": {
    "text": "大勢を殺せるもの。",
    "emotion": "很低"
  },
  "zq55a19": {
    "text": "しばらく、しまっとく。",
    "emotion": "淡淡的笑",
    "say": "しまっとく。"
  },
  "zq55a20": {
    "text": "固く封じて。",
    "emotion": "很輕，像答應",
    "say": "封じて。"
  },
  "zq55a21": {
    "text": "この騒ぎ、",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "すごい、"
  },
  "zq55a22": {
    "text": "州城よりにぎやかね。",
    "emotion": "笑",
    "say": "州城より派手ね。"
  },
  "zq55a23": {
    "text": "わしらの柳渓から、",
    "emotion": "激動，快，說完就停",
    "say": "柳渓から、"
  },
  "zq55a24": {
    "text": "解元が出たぞ！",
    "emotion": "笑得鬍子抖"
  },
  "zq55a25": {
    "text": "お兄ちゃん！",
    "emotion": "奶聲奶氣，大喊"
  },
  "zq55a26": {
    "text": "アーリンお姉ちゃんがね、",
    "emotion": "得意"
  },
  "zq55a27": {
    "text": "絶対帰ってくるって！",
    "emotion": "笑"
  },
  "zq55a28": {
    "text": "アーリンお姉ちゃん！",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "か、解元様……",
    "emotion": "陪笑，結巴"
  },
  "zq55a30": {
    "text": "チエン旦那、",
    "emotion": "低聲，快，說完就停",
    "say": "旦那、"
  },
  "zq55a31": {
    "text": "約束の土下座は——",
    "emotion": "拖長音"
  },
  "zq55a32": {
    "text": "わ、わしは……",
    "emotion": "快哭了"
  },
  "zq55a33": {
    "text": "いいさ。",
    "emotion": "大方"
  },
  "zq55a34": {
    "text": "お辞儀で十分だ。",
    "emotion": "笑",
    "say": "礼だけでいい。"
  },
  "zq55a35": {
    "text": "この勘定、",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "やっと片付いた。",
    "emotion": "得意"
  },
  "zq55a37": {
    "text": "お兄ちゃん、",
    "emotion": "奶聲奶氣，極短促，一口氣說完，不拖音",
    "say": "兄ちゃん、"
  },
  "zq55a38": {
    "text": "解元ってなに？",
    "emotion": "好奇"
  },
  "zq55a39": {
    "text": "これからはね、",
    "emotion": "低聲，快，說完就停",
    "say": "これから、"
  },
  "zq55a40": {
    "text": "誰にもいじめさせないってこと。",
    "emotion": "摸她的頭",
    "say": "誰にもいじめさせない。"
  },
  "zq55a41": {
    "text": "タンお嬢様！",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "都から急ぎの手紙です！",
    "emotion": "急",
    "say": "都から急ぎの文！"
  },
  "zq55a43": {
    "text": "ウェイ・シャオチンが……",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "一枚の肖像画を持って、",
    "emotion": "畫外，聲音低下去",
    "say": "肖像画を持って、"
  },
  "zq55a45": {
    "text": "相府に入った。",
    "emotion": "停住"
  }
}
