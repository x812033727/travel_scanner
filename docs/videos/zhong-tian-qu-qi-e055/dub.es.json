{
  "zq55a01": {
    "text": "Ahí está lo que quiero.",
    "emotion": "看著火，很輕，快，說完就停",
    "say": "Lo que quiero."
  },
  "zq55a02": {
    "text": "Un hogar.",
    "emotion": "低聲，快，說完就停"
  },
  "zq55a03": {
    "text": "A-Ling, afecto: sesenta y uno.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling: sesenta y uno."
  },
  "zq55a04": {
    "text": "Vaya respuesta…",
    "emotion": "睏，嘟囔"
  },
  "zq55a05": {
    "text": "Afecto de las tres esposas:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "todas pasan de sesenta.",
    "emotion": "平板電子音"
  },
  "zq55a07": {
    "text": "Gran premio desbloqueado.",
    "emotion": "平板電子音"
  },
  "zq55a08": {
    "text": "Gran premio: la fórmula de la pólvora.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Gran premio: la pólvora."
  },
  "zq55a09": {
    "text": "Pólvora…",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "Con esto,",
    "emotion": "低聲，咬牙，極短促，一口氣說完，不拖音"
  },
  "zq55a11": {
    "text": "¿quién se atreverá a llevarse a mi familia?",
    "emotion": "狠",
    "say": "¿quién toca a mi familia?"
  },
  "zq55a12": {
    "text": "Pero también puede",
    "emotion": "聲音沉下來"
  },
  "zq55a13": {
    "text": "matar a mucha gente.",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "Sellar.",
    "emotion": "很定，極短促，一口氣說完，不拖音",
    "say": "Sella."
  },
  "zq55a15": {
    "text": "Ni yo mismo lo abriré.",
    "emotion": "一字一字",
    "say": "Ni yo lo abro."
  },
  "zq55a16": {
    "text": "Sellado confirmado.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "¿En qué piensas?",
    "emotion": "很輕"
  },
  "zq55a18": {
    "text": "En algo que puede matar a mucha gente.",
    "emotion": "很低",
    "say": "Algo que mata a muchos."
  },
  "zq55a19": {
    "text": "Por ahora, bajo llave.",
    "emotion": "淡淡的笑",
    "say": "Bajo llave."
  },
  "zq55a20": {
    "text": "Ciérralo bien.",
    "emotion": "很輕，像答應",
    "say": "Ciérralo."
  },
  "zq55a21": {
    "text": "Este recibimiento,",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "Vaya,"
  },
  "zq55a22": {
    "text": "¡más animado que la ciudad de la prefectura!",
    "emotion": "笑",
    "say": "¡más que en la ciudad!"
  },
  "zq55a23": {
    "text": "¡Nuestro Liuxi",
    "emotion": "激動，快，說完就停",
    "say": "¡Liuxi"
  },
  "zq55a24": {
    "text": "tiene al primero del examen provincial!",
    "emotion": "笑得鬍子抖",
    "say": "tiene al primero del examen!"
  },
  "zq55a25": {
    "text": "¡Hermano!",
    "emotion": "奶聲奶氣，大喊，極短促，一口氣說完，不拖音",
    "say": "¡Mano!"
  },
  "zq55a26": {
    "text": "La hermana A-Ling dijo",
    "emotion": "得意"
  },
  "zq55a27": {
    "text": "¡que seguro volverías!",
    "emotion": "笑",
    "say": "¡que volverías!"
  },
  "zq55a28": {
    "text": "¡Hermana A-Ling!",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "I-ilustre primero del examen…",
    "emotion": "陪笑，結巴",
    "say": "E-excelencia…"
  },
  "zq55a30": {
    "text": "Don Qian,",
    "emotion": "笑"
  },
  "zq55a31": {
    "text": "lo de arrodillarse que prometió…",
    "emotion": "拖長音",
    "say": "¿y lo de arrodillarse?"
  },
  "zq55a32": {
    "text": "Y-yo…",
    "emotion": "快哭了"
  },
  "zq55a33": {
    "text": "Olvídelo.",
    "emotion": "大方，極短促，一口氣說完，不拖音",
    "say": "No, no."
  },
  "zq55a34": {
    "text": "Con una reverencia basta.",
    "emotion": "笑",
    "say": "Basta una reverencia."
  },
  "zq55a35": {
    "text": "Esta cuenta,",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "por fin quedó saldada.",
    "emotion": "得意"
  },
  "zq55a37": {
    "text": "Hermano,",
    "emotion": "奶聲奶氣，極短促，一口氣說完，不拖音",
    "say": "Mano,"
  },
  "zq55a38": {
    "text": "¿qué es el primero del examen provincial?",
    "emotion": "好奇",
    "say": "¿qué es ser el primero?"
  },
  "zq55a39": {
    "text": "Significa que, de ahora en adelante,",
    "emotion": "笑",
    "say": "Que ahora"
  },
  "zq55a40": {
    "text": "nadie se atreverá a molestarte.",
    "emotion": "摸她的頭",
    "say": "nadie te molesta."
  },
  "zq55a41": {
    "text": "¡Señorita Tang!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "¡Carta urgente de la capital!",
    "emotion": "急"
  },
  "zq55a43": {
    "text": "Wei Shaoqing…",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "llevó un retrato",
    "emotion": "畫外，聲音低下去"
  },
  "zq55a45": {
    "text": "a la mansión del canciller.",
    "emotion": "停住"
  }
}
