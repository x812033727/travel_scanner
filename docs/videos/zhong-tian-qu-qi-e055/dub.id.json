{
  "zq55a01": {
    "text": "Di sana ada yang kuinginkan.",
    "emotion": "看著火，很輕，快，說完就停",
    "say": "Ada yang kuinginkan."
  },
  "zq55a02": {
    "text": "Sebuah keluarga.",
    "emotion": "低聲，快，說完就停",
    "say": "Keluarga."
  },
  "zq55a03": {
    "text": "Poin suka A-Ling, enam puluh satu.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling, enam puluh satu."
  },
  "zq55a04": {
    "text": "Jawaban macam apa itu…",
    "emotion": "睏，嘟囔",
    "say": "Jawaban apa itu…"
  },
  "zq55a05": {
    "text": "Poin suka ketiga istri",
    "emotion": "平板電子音，叮一聲"
  },
  "zq55a06": {
    "text": "semuanya tembus enam puluh.",
    "emotion": "平板電子音",
    "say": "tembus enam puluh."
  },
  "zq55a07": {
    "text": "Hadiah utama terbuka.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Hadiah utama dibuka."
  },
  "zq55a08": {
    "text": "Hadiah utama: resep mesiu.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq55a09": {
    "text": "Mesiu…",
    "emotion": "幾乎沒聲音"
  },
  "zq55a10": {
    "text": "Dengan ini,",
    "emotion": "低聲，咬牙，極短促，一口氣說完，不拖音"
  },
  "zq55a11": {
    "text": "siapa berani menangkap keluargaku?",
    "emotion": "狠",
    "say": "siapa berani tangkap keluargaku?"
  },
  "zq55a12": {
    "text": "Tapi ini juga bisa",
    "emotion": "低聲，快，說完就停",
    "say": "Tapi ini bisa"
  },
  "zq55a13": {
    "text": "membunuh banyak orang.",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "Segel.",
    "emotion": "很定"
  },
  "zq55a15": {
    "text": "Aku sendiri pun tak akan membukanya.",
    "emotion": "一字一字",
    "say": "Aku pun tak buka."
  },
  "zq55a16": {
    "text": "Segel dikonfirmasi.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "Kau memikirkan apa?",
    "emotion": "很輕",
    "say": "Mikir apa?"
  },
  "zq55a18": {
    "text": "Sesuatu yang bisa membunuh banyak orang.",
    "emotion": "很低",
    "say": "Yang bisa bunuh banyak orang."
  },
  "zq55a19": {
    "text": "Kukunci dulu.",
    "emotion": "淡淡的笑"
  },
  "zq55a20": {
    "text": "Kunci baik-baik.",
    "emotion": "很輕，像答應",
    "say": "Kunci rapat."
  },
  "zq55a21": {
    "text": "Meriah begini,",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "Wah,"
  },
  "zq55a22": {
    "text": "lebih ramai dari kota prefektur.",
    "emotion": "笑",
    "say": "lebih ramai dari kota."
  },
  "zq55a23": {
    "text": "Liuxi kita",
    "emotion": "激動，極短促，一口氣說完，不拖音"
  },
  "zq55a24": {
    "text": "punya juara pertama ujian provinsi!",
    "emotion": "激動，快，說完就停",
    "say": "punya juara pertama!"
  },
  "zq55a25": {
    "text": "Kakak!",
    "emotion": "奶聲奶氣，大喊"
  },
  "zq55a26": {
    "text": "Kak A-Ling bilang,",
    "emotion": "得意"
  },
  "zq55a27": {
    "text": "Kakak pasti pulang!",
    "emotion": "笑"
  },
  "zq55a28": {
    "text": "Kak A-Ling!",
    "emotion": "撲過去"
  },
  "zq55a29": {
    "text": "Tu-Tuan Juara…",
    "emotion": "陪笑，結巴"
  },
  "zq55a30": {
    "text": "Tuan Qian,",
    "emotion": "低聲，快，說完就停"
  },
  "zq55a31": {
    "text": "sujud yang dijanjikan—",
    "emotion": "拖長音",
    "say": "sujudnya—"
  },
  "zq55a32": {
    "text": "Sa-saya…",
    "emotion": "結巴，快，說完就停"
  },
  "zq55a33": {
    "text": "Tak usah.",
    "emotion": "大方，極短促，一口氣說完，不拖音"
  },
  "zq55a34": {
    "text": "Membungkuk saja cukup.",
    "emotion": "笑",
    "say": "Cukup membungkuk."
  },
  "zq55a35": {
    "text": "Hitungan ini,",
    "emotion": "甜甜的"
  },
  "zq55a36": {
    "text": "akhirnya lunas juga.",
    "emotion": "得意",
    "say": "akhirnya lunas."
  },
  "zq55a37": {
    "text": "Kakak,",
    "emotion": "奶聲奶氣，極短促，一口氣說完，不拖音",
    "say": "Kak,"
  },
  "zq55a38": {
    "text": "juara pertama ujian provinsi itu apa?",
    "emotion": "好奇",
    "say": "juara pertama itu apa?"
  },
  "zq55a39": {
    "text": "Artinya mulai sekarang,",
    "emotion": "低聲，快，說完就停",
    "say": "Artinya,"
  },
  "zq55a40": {
    "text": "tak ada yang berani menindasmu.",
    "emotion": "摸她的頭",
    "say": "tak ada yang berani ganggu."
  },
  "zq55a41": {
    "text": "Nona Tang!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "Surat kilat dari ibu kota!",
    "emotion": "急"
  },
  "zq55a43": {
    "text": "Wei Shaoqing…",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "membawa sebuah potret,",
    "emotion": "畫外，聲音低下去"
  },
  "zq55a45": {
    "text": "masuk ke kediaman perdana menteri.",
    "emotion": "停住",
    "say": "ke rumah perdana menteri."
  }
}
