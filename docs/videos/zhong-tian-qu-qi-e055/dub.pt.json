  "zq55a21": {
    "text": "Que recepção,",
    "emotion": "挑眉，極短促，一口氣說完，不拖音",
    "say": "Nossa,"
  },
  "zq55a22": {
    "text": "mais animada que a cidade da província!",
    "emotion": "笑",
    "say": "mais que na cidade!"
  },
  "zq55a23": {
    "text": "Nossa Liuxi",
    "emotion": "激動，快，說完就停",
