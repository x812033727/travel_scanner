  "zq55a13": {
    "text": "matar muita gente.",
    "emotion": "很輕"
  },
  "zq55a14": {
    "text": "Lacrar.",
    "emotion": "很定，極短促，一口氣說完，不拖音",
    "say": "Lacre."
  },
  "zq55a15": {
    "text": "Nem eu mesmo vou abrir.",
    "emotion": "一字一字",
    "say": "Nem eu abro."
  },
  "zq55a16": {
    "text": "Lacre confirmado.",
    "emotion": "平板電子音，喀一聲"
  },
  "zq55a17": {
    "text": "No que está pensando?",
    "emotion": "很輕",
    "say": "Pensando em quê?"
  },
  "zq55a18": {
    "text": "Numa coisa que mata muita gente.",
    "emotion": "很低",
    "say": "Algo que mata muitos."
  },
  "zq55a19": {
    "text": "Por ora, trancado.",
    "emotion": "淡淡的，快，說完就停",
    "say": "Trancado."
  },
  "zq55a20": {
    "text": "Tranque bem.",
    "emotion": "很輕，像答應"
