  "zq55a41": {
    "text": "Senhorita Tang!",
    "emotion": "喘"
  },
  "zq55a42": {
    "text": "Carta urgente da capital!",
    "emotion": "急"
  },
  "zq55a43": {
    "text": "Wei Shaoqing…",
    "emotion": "唸，愣住"
  },
  "zq55a44": {
    "text": "levou um retrato",
