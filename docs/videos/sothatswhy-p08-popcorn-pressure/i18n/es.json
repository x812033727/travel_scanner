  },
  "lines": {
    "p001": {
      "source_hash": "27e073618546",
      "text": "¡Directora! En la montaña,"
    },
    "p002": {
      "source_hash": "c81545066678",
      "text": "el agua hervía y hervía,"
    },
    "p003": {
      "source_hash": "cf14c74108eb",
      "text": "¡pero los fideos seguían duros!"
    },
    "p004": {
      "source_hash": "9745f3bebd53",
      "text": "Creí que el gas"
    },
    "p005": {
      "source_hash": "67dd4e607d53",
      "text": "¡era débil!"
    },
    "p006": {
      "source_hash": "3e98bd2973ad",
      "text": "Pero en el microondas,"
    },
    "p007": {
      "source_hash": "8deafb923220",
      "text": "¡las palomitas estallan de golpe!"
    },
    "p008": {
      "source_hash": "735854b7ae55",
      "text": "Un solo travieso hizo ambas: el agua."
    },
    "p009": {
      "source_hash": "0480d1648f77",
      "text": "Piénsalo: en las dos se calienta agua."
    },
    "p010": {
      "source_hash": "9c50cf208954",
      "text": "¿Por qué arriba hierve y no cuece,"
    },
    "p011": {
      "source_hash": "b8ef047a9450",
      "text": "pero el agua del maíz lo hace estallar?"
    },
    "p012": {
      "source_hash": "3507021695e8",
      "text": "¡Si hierve, son 100 grados!"
    },
    "p013": {
      "source_hash": "af4beabcaff8",
      "text": "Adivina: tu olla en el monte,"
    },
    "p014": {
      "source_hash": "fcc2756c3c94",
      "text": "¿llegaba a 100?"
    },
    "p015": {
      "source_hash": "cd6f1bc15477",
      "text": "Y al fondo de tu tazón,"
    },
    "p016": {
      "source_hash": "1cadb9020d03",
      "text": "¿no quedan unos que nunca revientan?"
    },
    "p017": {
      "source_hash": "c9bc6ec074ff",
      "text": "Sí,"
    },
    "p018": {
      "source_hash": "1aa95cba91bc",
      "text": "¿será que son flojos?"
    },
    "p019": {
      "source_hash": "2a5a8da6cce3",
      "text": "Todo está en el agua."
    },
    "p020": {
      "source_hash": "cc23a5381847",
      "text": "¿La dejan libre, o la encierran?"
    },
    "p021": {
      "source_hash": "26c7c73004d7",
      "text": "La olla hirviendo del monte era igual a la de casa."
    },
    "p022": {
      "source_hash": "f294bcc404a2",
      "text": "Con burbujas, junto al mar,"
    },
    "p023": {
      "source_hash": "70ccd4714b47",
      "text": "unos 100 grados."
    },
    "p024": {
      "source_hash": "dc53258cb96f",
      "text": "En lo bajo, donde vives, hierve así."
    },
    "p025": {
      "source_hash": "eeae8f7da232",
      "text": "¿Y"
    },
    "p026": {
      "source_hash": "f9278e208c46",
      "text": "por qué hace burbujas?"
    },
    "p027": {
      "source_hash": "9f00a2ff5958",
      "text": "Cuanto más caliente, más vapor."
    },
    "p028": {
      "source_hash": "1bf202e5a2a9",
      "text": "Ya bien caliente, se inflan burbujas de vapor."
    },
    "p029": {
      "source_hash": "406bbef17816",
      "text": "¿Más fuego,"
    },
    "p030": {
      "source_hash": "040d5dfe62dd",
      "text": "y se calienta más?"
    },
    "p031": {
      "source_hash": "9dd1454a5756",
      "text": "No. Al hervir, deja de subir."
    },
    "p032": {
      "source_hash": "c4164308a527",
      "text": "Más fuego solo hace burbujas más bravas."
    },
    "p033": {
      "source_hash": "52685942ed93",
      "text": "¿El fuego extra,"
    },
    "p034": {
      "source_hash": "831f2dd1874d",
      "text": "a dónde va?"
    },
    "p035": {
      "source_hash": "b5415d0d727f",
      "text": "Hace vapor, y se va."
    },
    "p036": {
      "source_hash": "13d0b9380b06",
      "text": "El agua hirviendo tiene un techo."
    },
    "p037": {
      "source_hash": "289b5ec1e0f2",
      "text": "¿Ese techo"
    },
    "p038": {
      "source_hash": "57053affef58",
      "text": "es igual donde sea?"
    },
    "p039": {
      "source_hash": "897abe53c250",
      "text": "No siempre. Depende de cuánto aire empuje sobre el agua."
    },
    "p040": {
      "source_hash": "8d5b49d92e80",
      "text": "¿Aire?"
    },
    "p041": {
      "source_hash": "971e2caca830",
      "text": "Tan ligero,"
    },
    "p042": {
      "source_hash": "c412ee39f772",
      "text": "¿y aplasta cosas?"
    },
    "p043": {
      "source_hash": "c2f171adcb10",
      "text": "Sí. Sobre ti hay una gran capa de aire,"
    },
    "p044": {
      "source_hash": "a4af5e5a0a00",
      "text": "que empuja suave a ti y a la olla."
    },
    "p045": {
      "source_hash": "610354f1f7f4",
      "text": "Como una cobija gruesa."
    },
    "p046": {
      "source_hash": "e281228e76f3",
      "text": "Para salir, la burbuja empuja la cobija."
    },
    "p047": {
      "source_hash": "25ebe0099e31",
      "text": "¿Las burbujas empujan fuerte?"
    },
    "p048": {
      "source_hash": "f2a38306f1c7",
      "text": "Sí: con agua bien caliente, el vapor la empuja."
    },
    "p049": {
      "source_hash": "c58b5966a28a",
      "text": "Junto al mar la cobija es más gruesa: más calor."
    },
    "p050": {
      "source_hash": "0fa426d12efd",
      "text": "¿Y en la montaña?"
    },
    "p051": {
      "source_hash": "2acb495b3bce",
      "text": "Al subir, hay menos aire,"
    },
    "p052": {
      "source_hash": "cdbc5843363b",
      "text": "y la cobija se vuelve fina y ligera."
    },
    "p053": {
      "source_hash": "84c8c9633202",
      "text": "Cobija fina: salen con menos calor."
    },
    "p054": {
      "source_hash": "29d7f18fa964",
      "text": "¿O sea que arriba"
    },
    "p055": {
      "source_hash": "0b3894e6cb72",
      "text": "hierve más fría?"
    },
    "p056": {
      "source_hash": "b5a371dc00c9",
      "text": "Sí. A unos 3000 metros,"
    },
    "p057": {
      "source_hash": "d9f8bc1c165f",
      "text": "hierve a unos 90 grados."
    },
    "p058": {
      "source_hash": "e73dcd739d6a",
      "text": "Yushan, en Taiwán, casi 4000 metros:"
    },
    "p059": {
      "source_hash": "9192baec5f45",
      "text": "en la cima hierve a menos de 90."
    },
    "p060": {
      "source_hash": "da16dd86cc2a",
      "text": "Arriba, fideos, huevos y arroz"
    },
    "p061": {
      "source_hash": "3a0769d57273",
      "text": "tardan más que en casa."
    },
    "p062": {
      "source_hash": "b2655bbc22b3",
      "text": "¡El agua hierve a 80 y pico!"
    },
    "p063": {
      "source_hash": "88d2c0d4aea8",
      "text": "Pero igual burbujea,"
    },
    "p064": {
      "source_hash": "53021ceed4ba",
      "text": "¿por qué siguen duros?"
    },
    "p065": {
      "source_hash": "409756de54c6",
      "text": "Cuece el calor, no las burbujas."
    },
    "p066": {
      "source_hash": "ccd8316b34d6",
      "text": "Con menos calor, entra más lento al fideo."
    },
    "p067": {
      "source_hash": "fb7cd5b1069d",
      "text": "No es que falte gas,"
    },
    "p068": {
      "source_hash": "943db42b2eed",
      "text": "es agua menos caliente."
    },
    "p069": {
      "source_hash": "f833f27e4e64",
      "text": "¡Pues fuego al máximo!"
    },
    "p070": {
      "source_hash": "e24896bc2415",
      "text": "¿Y el techo? Más fuego,"
    },
    "p071": {
      "source_hash": "db9b6c7c6e6a",
      "text": "sigue a esa temperatura, solo más fuerte."
    },
    "p072": {
      "source_hash": "e307a2e141af",
      "text": "¡Pues solo queda esperar!"
    },
    "p073": {
      "source_hash": "35da92098c8b",
      "text": "Sí. Hay quien pensó al revés:"
    },
    "p074": {
      "source_hash": "c79d562a4e7a",
      "text": "¿tapar fuerte y no dejar salir vapor?"
    },
    "p075": {
      "source_hash": "c495ca1a718e",
      "text": "¿Tapada,"
    },
    "p076": {
      "source_hash": "901153ed3de9",
      "text": "el agua se calienta más?"
    },
    "p077": {
      "source_hash": "160df1e23311",
      "text": "Sí. Con tapa trabada se llama olla a presión."
    },
    "p078": {
      "source_hash": "90ec462e2a7a",
      "text": "En lo alto la usan para el arroz."
    },
    "p079": {
      "source_hash": "da0a6c8959f0",
      "text": "Solo adultos, según el manual;"
    },
    "p080": {
      "source_hash": "a21ba0255949",
      "text": "y en casa no hacemos esa prueba."
    },
    "p081": {
      "source_hash": "d725cbb1ea20",
      "text": "Hay una natural, chiquita:"
    },
    "p082": {
      "source_hash": "27442fe58ac4",
      "text": "el grano al fondo del tazón."
    },
    "p083": {
      "source_hash": "a1872457708c",
      "text": "Este maíz tiene cáscara dura y brillante,"
    },
    "p084": {
      "source_hash": "f9485afb34e9",
      "text": "y el vapor casi no puede salir."
    },
    "p085": {
      "source_hash": "e6eb0ce0681f",
      "text": "¿Y el elote,"
    },
    "p086": {
      "source_hash": "3855627d571b",
      "text": "revienta igual?"
    },
    "p087": {
      "source_hash": "e69a828f94ca",
      "text": "Usan un maíz especial,"
    },
    "p088": {
      "source_hash": "9c98ac9ea2f3",
      "text": "cáscara dura, casi impermeable: no como otros granos."
    },
    "p089": {
      "source_hash": "87dadfd0e030",
      "text": "Pero es seco y duro,"
    },
    "p090": {
      "source_hash": "70f7ba3b8c27",
      "text": "¿dónde está el agua?"
    },
    "p091": {
      "source_hash": "3990b80196db",
      "text": "Sí. Dentro hay almidón blando,"
    },
    "p092": {
      "source_hash": "b87647cc1898",
      "text": "y en medio se esconde una gotita de agua."
    },
    "p093": {
      "source_hash": "7d013b5b1d88",
      "text": "Un buen grano: de 100 partes,"
    },
    "p094": {
      "source_hash": "f181bd9b4fe1",
      "text": "unas 14 son agua."
    },
    "p095": {
      "source_hash": "8fd89503ec8b",
      "text": "Parece tan seco,"
    },
    "p096": {
      "source_hash": "c571424f486c",
      "text": "¡y esconde agua!"
    },
    "p097": {
      "source_hash": "85386c78f369",
      "text": "La gota quiere volverse vapor,"
    },
    "p098": {
      "source_hash": "ff5122590ed5",
      "text": "pero la cáscara la deja encerrada."
    },
    "p099": {
      "source_hash": "99b749c73bf3",
      "text": "El vapor atrapado se acumula."
    },
    "p100": {
      "source_hash": "c5eccf152c6e",
      "text": "El grano es como un globo cada vez más tenso."
    },
    "p101": {
      "source_hash": "a94306fdfa25",
      "text": "Pero antes:"
    },
    "p102": {
      "source_hash": "45e77f218b8d",
      "text": "¿el agua no pasa del techo?"
    },
    "p103": {
      "source_hash": "592424b6cb95",
      "text": "¿Recuerdas la cobija?"
    },
    "p104": {
      "source_hash": "f745daf4c431",
      "text": "En el grano no aprieta una cobija, sino el vapor acumulado."
    },
    "p105": {
      "source_hash": "b8c41b13694b",
      "text": "Más presión, más cuesta,"
    },
    "p106": {
      "source_hash": "9356020d5668",
      "text": "y el agua supera el hervor normal; el techo sube."
    },
    "p107": {
      "source_hash": "8afd1b9c6816",
      "text": "¡Al revés que arriba!"
    },
    "p108": {
      "source_hash": "d686093461c4",
      "text": "Sí. Midieron que casi todos revientan a unos 180 grados,"
    },
    "p109": {
      "source_hash": "91a0b1c686f2",
      "text": "con una presión de 9 a 10 veces la del aire de afuera."
    },
    "p110": {
      "source_hash": "abb5341e5086",
      "text": "¡La cáscara va a reventar!"
    },
    "p111": {
      "source_hash": "375da67ee606",
      "text": "Algo raro: según cálculos, antes de romperse,"
    },
    "p112": {
      "source_hash": "05bf553da9f4",
      "text": "casi toda el agua de adentro sigue siendo líquida."
    },
    "p113": {
      "source_hash": "2e764b9e4237",
      "text": "¿Tan caliente,"
    },
    "p114": {
      "source_hash": "fef4423a0784",
      "text": "y todavía no es vapor?"
    },
    "p115": {
      "source_hash": "872dba315059",
      "text": "Sí: la presión la mantiene líquida."
    },
    "p116": {
      "source_hash": "27b30e64ca1b",
      "text": "Al romperse y bajar la presión, se hace vapor."
    },
    "p117": {
      "source_hash": "bb3e9aa2b845",
      "text": "El almidón queda blando y pegajoso,"
    },
    "p118": {
      "source_hash": "c6587db471c9",
      "text": "como una masa lista."
    },
    "p119": {
      "source_hash": "3a863c5510c5",
      "text": "¿Y fuego alto,"
    },
    "p120": {
      "source_hash": "d38690666d1d",
      "text": "revientan más rápido?"
    },
    "p121": {
      "source_hash": "6a78ca2c071f",
      "text": "Tampoco: el vapor la rompe antes,"
    },
    "p122": {
      "source_hash": "ba21d5a4bd86",
      "text": "y el almidón queda crudo: medio grano duro."
    },
    "p123": {
      "source_hash": "14022848fbce",
      "text": "¿Y los del fondo,"
    },
    "p124": {
      "source_hash": "e0f3b699338b",
      "text": "nunca revientan?"
    },
    "p125": {
      "source_hash": "c42ef055e794",
      "text": "Suelen estar muy secos."
    },
    "p126": {
      "source_hash": "0e44fa9c37af",
      "text": "Poca agua no da fuerza para romper la cáscara."
    },
    "p127": {
      "source_hash": "c57052dfdccf",
      "text": "Y la punta de la mazorca"
    },
    "p128": {
      "source_hash": "c86a3dac6d7e",
      "text": "no retiene bien el vapor; si calientas lento, se escapa."
    },
    "p129": {
      "source_hash": "d2fd59be8d77",
      "text": "Fuga,"
    },
    "p130": {
      "source_hash": "a94a0c808aab",
      "text": "¡y ya no revienta!"
    },
    "p131": {
      "source_hash": "7c31f3f73e00",
      "text": "Y cuando por fin se rompe,"
    },
    "p132": {
      "source_hash": "935c23df9851",
      "text": "¿por qué salta?"
    },
    "p133": {
      "source_hash": "0e125d729cad",
      "text": "¿Sale vapor por la grieta"
    },
    "p134": {
      "source_hash": "f6881a6bafe3",
      "text": "y lo lanza como cohete?"
    },
    "p135": {
      "source_hash": "72d7be01f699",
      "text": "Muchos lo creen. En 2015, dos investigadores en Francia"
    },
    "p136": {
      "source_hash": "36d3c23527aa",
      "text": "quisieron verlo bien."
    },
    "p137": {
      "source_hash": "202f34418b9c",
      "text": "Granos en hierro caliente,"
    },
    "p138": {
      "source_hash": "3180a1bb0209",
      "text": "y una cámara de casi 3000 fotos por segundo."
    },
    "p139": {
      "source_hash": "bbbbaf8255a0",
      "text": "¡3000 fotos!"
    },
    "p140": {
      "source_hash": "006e4c902857",
      "text": "¿Y qué vieron?"
    },
    "p141": {
      "source_hash": "cb1439c831f1",
      "text": "Primero, una grieta; el almidón blando"
    },
    "p142": {
      "source_hash": "dc7c35643a9a",
      "text": "sale de golpe por la grieta."
    },
    "p143": {
      "source_hash": "7b2db362a610",
      "text": "El vapor encerrado se suelta"
    },
    "p144": {
      "source_hash": "f64a6a914af4",
      "text": "e infla el almidón: una gran espuma blanca."
    },
    "p145": {
      "source_hash": "0958debafb41",
      "text": "¿Por eso un granito amarillo"
    },
    "p146": {
      "source_hash": "084973eedb00",
      "text": "se vuelve una nube blanca?"
    },
    "p147": {
      "source_hash": "7310c632f279",
      "text": "Lo amarillo es la cáscara;"
    },
    "p148": {
      "source_hash": "d65db721061c",
      "text": "el almidón ya era blanco."
    },
    "p149": {
      "source_hash": "c99fc7850000",
      "text": "Lejos de la olla, se enfría,"
    },
    "p150": {
      "source_hash": "388b0cbb261c",
      "text": "se endurece, y eso es lo crujiente."
    },
    "p151": {
      "source_hash": "030578056b6e",
      "text": "¿Y cuándo salta?"
    },
    "p152": {
      "source_hash": "d4aea451ec3b",
      "text": "El almidón empuja la olla,"
    },
    "p153": {
      "source_hash": "35c3f7378373",
      "text": "como una patita corta."
    },
    "p154": {
      "source_hash": "b8a84a218b76",
      "text": "¿Palomitas con patas?"
    },
    "p155": {
      "source_hash": "b917fa32e5a1",
      "text": "Se aplasta y rebota como resorte,"
    },
    "p156": {
      "source_hash": "d999a58cac49",
      "text": "y patea el grano hacia arriba."
    },
    "p157": {
      "source_hash": "17ad2339d6b2",
      "text": "Lo hace saltar la pata de almidón,"
    },
    "p158": {
      "source_hash": "b10f86e08d63",
      "text": "no el vapor saliendo como cohete."
    },
    "p159": {
      "source_hash": "4134eb43ee6e",
      "text": "¡Como yo,"
    },
    "p160": {
      "source_hash": "7dfa9891ea45",
      "text": "me agacho y salto!"
    },
    "p161": {
      "source_hash": "c2f314a36f58",
      "text": "Dicen que salta un poco como una pulga,"
    },
    "p162": {
      "source_hash": "bdb9b2d9af36",
      "text": "y un poco como plantas que disparan semillas."
    },
    "p163": {
      "source_hash": "f569eda61dbe",
      "text": "¿Una pulga?"
    },
    "p164": {
      "source_hash": "b7af2e1f9756",
      "text": "¿Y qué tan rápido?"
    },
    "p165": {
      "source_hash": "b03c15545d15",
      "text": "De grieta a salto: centésimas de segundo,"
    },
    "p166": {
      "source_hash": "c9bb21a79606",
      "text": "solo ves un destello."
    },
    "p167": {
      "source_hash": "606d4cf6e48d",
      "text": "¡Parpadeas y ya!"
    },
    "p168": {
      "source_hash": "7a11070fe55e",
      "text": "Solo con esa patada,"
    },
    "p169": {
      "source_hash": "845ce3a56d8d",
      "text": "estimaron como 1 centímetro."
    },
    "p170": {
      "source_hash": "8a391dfe4a61",
      "text": "¿Solo 1?"
    },
    "p171": {
      "source_hash": "c0eccbaa8715",
      "text": "¡Creí que volaba altísimo!"
    },
    "p172": {
      "source_hash": "558f7e92e74c",
      "text": "Los saltos que vieron"
    },
    "p173": {
      "source_hash": "4f20a0f75000",
      "text": "eran más o menos de ese tamaño."
    },
    "p174": {
      "source_hash": "20d3d543dd05",
      "text": "¿Y el «pop»"
    },
    "p175": {
      "source_hash": "bcee8c5c404c",
      "text": "es el ruido de la grieta?"
    },
    "p176": {
      "source_hash": "c5410ab6b5e8",
      "text": "Lo mismo pensaron: un micrófono,"
    },
    "p177": {
      "source_hash": "9686d26f8875",
      "text": "sonido y video a la vez."
    },
    "p178": {
      "source_hash": "74797e9c436b",
      "text": "Juntándolos, se sabe qué paso es cada ruido."
    },
    "p179": {
      "source_hash": "c6264cb70463",
      "text": "¿El pop"
    },
    "p180": {
      "source_hash": "b5987e0e8173",
      "text": "cuánto dura?"
    },
    "p181": {
      "source_hash": "5e55c89d789e",
      "text": "Grabaron como una vigésima de segundo."
    },
    "p182": {
      "source_hash": "1bc75461d6bd",
      "text": "¡Seguro es"
    },
    "p183": {
      "source_hash": "95cb258939fa",
      "text": "cuando se agrieta!"
    },
    "p184": {
      "source_hash": "6ce77ec4458a",
      "text": "No suena justo al agrietarse,"
    },
    "p185": {
      "source_hash": "49b93f511b28",
      "text": "sino unas milésimas después."
    },
    "p186": {
      "source_hash": "8bd370ce42ff",
      "text": "¿Es la patada de la patita?"
    },
    "p187": {
      "source_hash": "824c5d4dc78b",
      "text": "Tampoco. Suponen que, al salir el vapor,"
    },
    "p188": {
      "source_hash": "ebe038bf06cc",
      "text": "hace sonar los huequitos del grano."
    },
    "p189": {
      "source_hash": "fb0a52a58cb4",
      "text": "¿Como al soplar"
    },
    "p190": {
      "source_hash": "efc254605515",
      "text": "por una botella?"
    },
    "p191": {
      "source_hash": "9cc683cc8702",
      "text": "Algo así: aire en un hueco"
    },
    "p192": {
      "source_hash": "a3769859682f",
      "text": "movido de golpe, que suena."
    },
    "p193": {
      "source_hash": "870c83a2fc55",
      "text": "Así, grieta, pop y salto"
    },
    "p194": {
      "source_hash": "001b3c1cdc9e",
      "text": "son tres cosas, tan rápidas que se juntan."
    },
    "p195": {
      "source_hash": "56a6fa65be4d",
      "text": "Los pops que oyes"
    },
    "p196": {
      "source_hash": "817f8b5a6553",
      "text": "son muchos granos, cada uno con sus tres pasos."
    },
    "p197": {
      "source_hash": "e01f78de3570",
      "text": "¡Eran tres cosas!"
    },
    "p198": {
      "source_hash": "b277532d793e",
      "text": "¿Y la olla del monte? Junto a este grano:"
    },
    "p199": {
      "source_hash": "95fe3067bb91",
      "text": "uno abierto, uno cerrado."
    },
    "p200": {
      "source_hash": "9824b8a0edd1",
      "text": "Solo cambia cuánto aprietan el agua."
    },
    "p201": {
      "source_hash": "a657e3b1be2e",
      "text": "¿Pero la regla es la misma?"
    },
    "p202": {
      "source_hash": "d8ede68e6d69",
      "text": "Sí, la regla del techo,"
    },
    "p203": {
      "source_hash": "0fe44f028815",
      "text": "uno aprieta poco y otro mucho."
    },
    "p204": {
      "source_hash": "7415fd0b4453",
      "text": "¿El que"
    },
    "p205": {
      "source_hash": "353f59014563",
      "text": "aprieta es aire o vapor?"
    },
    "p206": {
      "source_hash": "ef09a1e44f58",
      "text": "Sí, da igual."
    },
    "p207": {
      "source_hash": "008d1fa2b163",
      "text": "La misma regla deja fideos duros y hace estallar el maíz."
    },
    "p208": {
      "source_hash": "34e3bbef03ca",
      "text": "Lo que engaña son las burbujas:"
    },
    "p209": {
      "source_hash": "97339330e53d",
      "text": "dicen que hierve, no cuán caliente está."
    },
    "p210": {
      "source_hash": "12982bf1859c",
      "text": "¡Me engañaron!"
    },
    "p211": {
      "source_hash": "d8e549bd59fe",
      "text": "¿Tus dos preguntas? Ahora explícalas tú."
    },
    "p212": {
      "source_hash": "f4f1db2c1dc6",
      "text": "¡Cobija fina!"
    },
    "p213": {
      "source_hash": "7e374e7ea7b6",
      "text": "Hierve antes de 100,"
    },
    "p214": {
      "source_hash": "b212a4545ed4",
      "text": "¡fideos lentos!"
    },
    "p215": {
      "source_hash": "cf02d66fe310",
      "text": "Y la cáscara del maíz"
    },
    "p216": {
      "source_hash": "947350c0b378",
      "text": "¡encierra el agua hasta estallar!"
    },
    "p217": {
      "source_hash": "318266a94482",
      "text": "Con palomitas, escucha bien:"
    },
    "p218": {
      "source_hash": "3348a0c6de97",
      "text": "cada pop: un grano acabó sus tres pasos."
    },
    "p219": {
      "source_hash": "9cbbac4a0c7f",
      "text": "La bolsa sale hirviendo:"
    },
    "p220": {
      "source_hash": "a890868a04d5",
      "text": "que abra un adulto; cara lejos."
    },
    "p221": {
      "source_hash": "36d742bcb996",
      "text": "¡Ah, por eso!"
    },
    "p222": {
      "source_hash": "1078aa9ddddf",
      "text": "¿Cuántos no reventaron?"
    },
    "p223": {
      "source_hash": "fe508e80b52e",
      "text": "Dinos abajo."
    },
    "p224": {
      "source_hash": "88de677d4daa",
      "text": "Para más porqués, suscríbete a La Oficina del Por Eso."
    }
  }
}
