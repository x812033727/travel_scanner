  "lines": {
    "p001": {
      "source_hash": "27e073618546",
      "text": "Bu! Aku kemah di gunung,"
    },
    "p002": {
      "source_hash": "c81545066678",
      "text": "air sudah mendidih,"
    },
    "p003": {
      "source_hash": "cf14c74108eb",
      "text": "tapi mi lama sekali, tetap keras!"
    },
    "p004": {
      "source_hash": "9745f3bebd53",
      "text": "Kukira kompornya"
    },
    "p005": {
      "source_hash": "67dd4e607d53",
      "text": "lemah!"
    },
    "p006": {
      "source_hash": "3e98bd2973ad",
      "text": "Tapi popcorn microwave"
    },
    "p007": {
      "source_hash": "8deafb923220",
      "text": "langsung meletup pop-pop-pop!"
    },
    "p008": {
      "source_hash": "735854b7ae55",
      "text": "Dua hal ini ulah satu tokoh: air."
    },
    "p009": {
      "source_hash": "0480d1648f77",
      "text": "Coba pikir: sama-sama air dipanaskan,"
    },
    "p010": {
      "source_hash": "9c50cf208954",
      "text": "kenapa di gunung mi tak matang,"
    },
    "p011": {
      "source_hash": "b8ef047a9450",
      "text": "tapi air di jagung bisa meledakkannya?"
    },
    "p012": {
      "source_hash": "3507021695e8",
      "text": "Mendidih ya 100 derajat!"
    },
    "p013": {
      "source_hash": "af4beabcaff8",
      "text": "Tebak, air mendidih di gunung"
    },
    "p014": {
      "source_hash": "fcc2756c3c94",
      "text": "apa 100 derajat?"
    },
    "p015": {
      "source_hash": "cd6f1bc15477",
      "text": "Lalu di dasar mangkuk,"
    },
    "p016": {
      "source_hash": "1cadb9020d03",
      "text": "selalu ada yang tak mau meletup, kan?"
    },
    "p017": {
      "source_hash": "c9bc6ec074ff",
      "text": "Iya,"
    },
    "p018": {
      "source_hash": "1aa95cba91bc",
      "text": "apa mereka malas?"
    },
    "p019": {
      "source_hash": "2a5a8da6cce3",
      "text": "Jawabannya di air:"
    },
    "p020": {
      "source_hash": "cc23a5381847",
      "text": "dilepas, atau dikurung."
    },
    "p021": {
      "source_hash": "26c7c73004d7",
      "text": "Air mendidih di gunung tampak sama dengan di rumah."
    },
    "p022": {
      "source_hash": "f294bcc404a2",
      "text": "Gelembung besar, dekat laut,"
    },
    "p023": {
      "source_hash": "70ccd4714b47",
      "text": "ya 100 derajat."
    },
    "p024": {
      "source_hash": "dc53258cb96f",
      "text": "Di dataran, air mendidih di rumah begitu."
    },
    "p025": {
      "source_hash": "eeae8f7da232",
      "text": "Kok"
    },
    "p026": {
      "source_hash": "f9278e208c46",
      "text": "bisa bergelembung?"
    },
    "p027": {
      "source_hash": "9f00a2ff5958",
      "text": "Makin panas, makin banyak uap."
    },
    "p028": {
      "source_hash": "1bf202e5a2a9",
      "text": "Cukup panas, muncul gelembung uap di air."
    },
    "p029": {
      "source_hash": "406bbef17816",
      "text": "Api besar,"
    },
    "p030": {
      "source_hash": "040d5dfe62dd",
      "text": "air makin panas?"
    },
    "p031": {
      "source_hash": "9dd1454a5756",
      "text": "Tidak. Mendidih, suhu berhenti."
    },
    "p032": {
      "source_hash": "c4164308a527",
      "text": "Api besar cuma bikin gelembung makin heboh."
    },
    "p033": {
      "source_hash": "52685942ed93",
      "text": "Sisa apinya"
    },
    "p034": {
      "source_hash": "831f2dd1874d",
      "text": "ke mana?"
    },
    "p035": {
      "source_hash": "b5415d0d727f",
      "text": "Mengubah air jadi uap."
    },
    "p036": {
      "source_hash": "13d0b9380b06",
      "text": "Jadi air mendidih punya plafon suhu."
    },
    "p037": {
      "source_hash": "289b5ec1e0f2",
      "text": "Plafonnya"
    },
    "p038": {
      "source_hash": "57053affef58",
      "text": "sama di mana-mana?"
    },
    "p039": {
      "source_hash": "897abe53c250",
      "text": "Tidak. Tergantung berapa banyak udara menekan air."
    },
    "p040": {
      "source_hash": "8d5b49d92e80",
      "text": "Udara?"
    },
    "p041": {
      "source_hash": "971e2caca830",
      "text": "Udara ringan,"
    },
    "p042": {
      "source_hash": "c412ee39f772",
      "text": "bisa menekan?"
    },
    "p043": {
      "source_hash": "c2f171adcb10",
      "text": "Bisa. Di atasmu ada udara yang tebal,"
    },
    "p044": {
      "source_hash": "a4af5e5a0a00",
      "text": "menekanmu pelan, juga menekan panci."
    },
    "p045": {
      "source_hash": "610354f1f7f4",
      "text": "Seperti selimut udara."
    },
    "p046": {
      "source_hash": "e281228e76f3",
      "text": "Gelembung harus mendorong selimut itu dulu."
    },
    "p047": {
      "source_hash": "25ebe0099e31",
      "text": "Gelembung harus mendorong?"
    },
    "p048": {
      "source_hash": "f2a38306f1c7",
      "text": "Ya, air harus cukup panas agar uapnya kuat."
    },
    "p049": {
      "source_hash": "c58b5966a28a",
      "text": "Di tepi laut selimut paling tebal, perlu paling panas."
    },
    "p050": {
      "source_hash": "0fa426d12efd",
      "text": "Kalau di gunung?"
    },
    "p051": {
      "source_hash": "2acb495b3bce",
      "text": "Naik, udaranya berkurang,"
    },
    "p052": {
      "source_hash": "cdbc5843363b",
      "text": "selimutnya tipis dan ringan."
    },
    "p053": {
      "source_hash": "84c8c9633202",
      "text": "Tipis, tak perlu terlalu panas."
    },
    "p054": {
      "source_hash": "29d7f18fa964",
      "text": "Jadi di gunung"
    },
    "p055": {
      "source_hash": "0b3894e6cb72",
      "text": "air cepat mendidih?"
    },
    "p056": {
      "source_hash": "b5a371dc00c9",
      "text": "Ya. Di gunung 3.000 meter,"
    },
    "p057": {
      "source_hash": "d9f8bc1c165f",
      "text": "mendidih sekitar 90 derajat."
    },
    "p058": {
      "source_hash": "e73dcd739d6a",
      "text": "Yushan di Taiwan hampir 4.000 meter,"
    },
    "p059": {
      "source_hash": "9192baec5f45",
      "text": "di puncaknya bahkan di bawah 90."
    },
    "p060": {
      "source_hash": "da16dd86cc2a",
      "text": "Masak mi, telur, nasi di gunung"
    },
    "p061": {
      "source_hash": "3a0769d57273",
      "text": "sering perlu lebih lama."
    },
    "p062": {
      "source_hash": "b2655bbc22b3",
      "text": "Cuma delapan puluhan derajat!"
    },
    "p063": {
      "source_hash": "88d2c0d4aea8",
      "text": "Tapi tetap bergelembung,"
    },
    "p064": {
      "source_hash": "53021ceed4ba",
      "text": "kenapa mi masih keras?"
    },
    "p065": {
      "source_hash": "409756de54c6",
      "text": "Panas yang memasak, bukan buih."
    },
    "p066": {
      "source_hash": "ccd8316b34d6",
      "text": "Air kurang panas, panas masuk ke mi pelan."
    },
    "p067": {
      "source_hash": "fb7cd5b1069d",
      "text": "Bukan kompornya yang lemah,"
    },
    "p068": {
      "source_hash": "943db42b2eed",
      "text": "airnya yang kurang panas."
    },
    "p069": {
      "source_hash": "f833f27e4e64",
      "text": "Apinya kubesarkan!"
    },
    "p070": {
      "source_hash": "e24896bc2415",
      "text": "Ingat plafon? Api besar,"
    },
    "p071": {
      "source_hash": "db9b6c7c6e6a",
      "text": "air tetap di suhu tadi, cuma makin bergolak."
    },
    "p072": {
      "source_hash": "e307a2e141af",
      "text": "Jadi harus lebih lama!"
    },
    "p073": {
      "source_hash": "35da92098c8b",
      "text": "Ya. Ada ide: kalau dibalik,"
    },
    "p074": {
      "source_hash": "c79d562a4e7a",
      "text": "tutup dikunci rapat, uap tak keluar?"
    },
    "p075": {
      "source_hash": "c495ca1a718e",
      "text": "Ditutup,"
    },
    "p076": {
      "source_hash": "901153ed3de9",
      "text": "air makin panas?"
    },
    "p077": {
      "source_hash": "160df1e23311",
      "text": "Ya. Panci bertutup kunci itu panci presto,"
    },
    "p078": {
      "source_hash": "90ec462e2a7a",
      "text": "sering untuk masak nasi di gunung."
    },
    "p079": {
      "source_hash": "da0a6c8959f0",
      "text": "Presto itu urusan orang dewasa,"
    },
    "p080": {
      "source_hash": "a21ba0255949",
      "text": "jangan coba kurung uap di rumah."
    },
    "p081": {
      "source_hash": "d725cbb1ea20",
      "text": "Lihat presto mini alam:"
    },
    "p082": {
      "source_hash": "27442fe58ac4",
      "text": "jagung di dasar mangkukmu."
    },
    "p083": {
      "source_hash": "a1872457708c",
      "text": "Jagung popcorn berkulit keras dan mengilap,"
    },
    "p084": {
      "source_hash": "f9485afb34e9",
      "text": "uap hampir tak bisa keluar."
    },
    "p085": {
      "source_hash": "e6eb0ce0681f",
      "text": "Jagung rebusku,"
    },
    "p086": {
      "source_hash": "3855627d571b",
      "text": "bisa meletup?"
    },
    "p087": {
      "source_hash": "e69a828f94ca",
      "text": "Jagungnya jenis khusus,"
    },
    "p088": {
      "source_hash": "9c98ac9ea2f3",
      "text": "kulit sangat keras, sulit tembus air, beda biji lain."
    },
    "p089": {
      "source_hash": "87dadfd0e030",
      "text": "Tapi jagung kering,"
    },
    "p090": {
      "source_hash": "70f7ba3b8c27",
      "text": "mana airnya?"
    },
    "p091": {
      "source_hash": "3990b80196db",
      "text": "Ada. Di dalam ada pati lembut,"
    },
    "p092": {
      "source_hash": "b87647cc1898",
      "text": "di tengahnya tersimpan setetes air."
    },
    "p093": {
      "source_hash": "7d013b5b1d88",
      "text": "Dari 100 bagian jagung bagus,"
    },
    "p094": {
      "source_hash": "f181bd9b4fe1",
      "text": "sekitar 14 bagian air."
    },
    "p095": {
      "source_hash": "8fd89503ec8b",
      "text": "Kelihatan kering,"
    },
    "p096": {
      "source_hash": "c571424f486c",
      "text": "ternyata simpan air!"
    },
    "p097": {
      "source_hash": "85386c78f369",
      "text": "Panas, air itu ingin jadi uap,"
    },
    "p098": {
      "source_hash": "ff5122590ed5",
      "text": "tapi kulit jagung mengurungnya di dalam."
    },
    "p099": {
      "source_hash": "99b749c73bf3",
      "text": "Uap tak keluar, makin menumpuk."
    },
    "p100": {
      "source_hash": "c5eccf152c6e",
      "text": "Jagung seperti balon yang makin kencang."
    },
    "p101": {
      "source_hash": "a94306fdfa25",
      "text": "Kata Ibu,"
    },
    "p102": {
      "source_hash": "45e77f218b8d",
      "text": "air tak bisa lewat plafon?"
    },
    "p103": {
      "source_hash": "592424b6cb95",
      "text": "Ingat selimut udara?"
    },
    "p104": {
      "source_hash": "f745daf4c431",
      "text": "Di jagung, yang menekan air bukan selimut, tapi tumpukan uap."
    },
    "p105": {
      "source_hash": "b8c41b13694b",
      "text": "Makin kuat menekan,"
    },
    "p106": {
      "source_hash": "9356020d5668",
      "text": "air harus lebih panas dari 100, plafonnya naik."
    },
    "p107": {
      "source_hash": "8afd1b9c6816",
      "text": "Kebalikan gunung!"
    },
    "p108": {
      "source_hash": "d686093461c4",
      "text": "Ya. Diukur, jagung umumnya meletup di sekitar 180 derajat,"
    },
    "p109": {
      "source_hash": "91a0b1c686f2",
      "text": "tekanannya 9 sampai 10 kali udara luar."
    },
    "p110": {
      "source_hash": "abb5341e5086",
      "text": "Kulitnya hampir jebol!"
    },
    "p111": {
      "source_hash": "375da67ee606",
      "text": "Anehnya lagi: menurut hitungan, sebelum pecah,"
    },
    "p112": {
      "source_hash": "05bf553da9f4",
      "text": "sebagian besar airnya masih cair."
    },
    "p113": {
      "source_hash": "2e764b9e4237",
      "text": "Sepanas itu,"
    },
    "p114": {
      "source_hash": "fef4423a0784",
      "text": "belum jadi uap?"
    },
    "p115": {
      "source_hash": "872dba315059",
      "text": "Ya, tekanannya besar, jadi tetap cair."
    },
    "p116": {
      "source_hash": "27b30e64ca1b",
      "text": "Begitu kulit pecah, tekanan turun, jadi uap."
    },
    "p117": {
      "source_hash": "bb3e9aa2b845",
      "text": "Sementara itu, pati lunak dan lengket,"
    },
    "p118": {
      "source_hash": "c6587db471c9",
      "text": "seperti adonan siap."
    },
    "p119": {
      "source_hash": "3a863c5510c5",
      "text": "Api maksimal,"
    },
    "p120": {
      "source_hash": "d38690666d1d",
      "text": "meletup lebih cepat?"
    },
    "p121": {
      "source_hash": "6a78ca2c071f",
      "text": "Terlalu cepat tak baik. Pecah dini,"
    },
    "p122": {
      "source_hash": "ba21d5a4bd86",
      "text": "pati belum lunak, jadi setengah biji keras."
    },
    "p123": {
      "source_hash": "14022848fbce",
      "text": "Yang di dasar,"
    },
    "p124": {
      "source_hash": "e0f3b699338b",
      "text": "kenapa tak meletup?"
    },
    "p125": {
      "source_hash": "c42ef055e794",
      "text": "Umumnya terlalu kering."
    },
    "p126": {
      "source_hash": "0e44fa9c37af",
      "text": "Air sedikit, tenaganya tak cukup memecah kulit."
    },
    "p127": {
      "source_hash": "c57052dfdccf",
      "text": "Ujung yang dekat tongkol"
    },
    "p128": {
      "source_hash": "c86a3dac6d7e",
      "text": "kurang menahan uap; kalau lambat panas, uapnya bocor."
    },
    "p129": {
      "source_hash": "d2fd59be8d77",
      "text": "Bocor"
    },
    "p130": {
      "source_hash": "a94a0c808aab",
      "text": "jadi tak meletup!"
    },
    "p131": {
      "source_hash": "7c31f3f73e00",
      "text": "Saat kulitnya pecah,"
    },
    "p132": {
      "source_hash": "935c23df9851",
      "text": "kenapa jagung melompat?"
    },
    "p133": {
      "source_hash": "0e125d729cad",
      "text": "Uap menyembur dari celah,"
    },
    "p134": {
      "source_hash": "f6881a6bafe3",
      "text": "mendorongnya seperti roket?"
    },
    "p135": {
      "source_hash": "72d7be01f699",
      "text": "Banyak yang menduga. Tahun 2015, dua peneliti Prancis"
    },
    "p136": {
      "source_hash": "36d3c23527aa",
      "text": "ingin melihat jelas."
    },
    "p137": {
      "source_hash": "202f34418b9c",
      "text": "Jagung di pelat besi panas,"
    },
    "p138": {
      "source_hash": "3180a1bb0209",
      "text": "direkam hampir 3.000 bingkai per detik, pelan-pelan."
    },
    "p139": {
      "source_hash": "bbbbaf8255a0",
      "text": "Tiga ribu!"
    },
    "p140": {
      "source_hash": "006e4c902857",
      "text": "Terlihat apa?"
    },
    "p141": {
      "source_hash": "cb1439c831f1",
      "text": "Mula-mula kulit retak, pati lembut"
    },
    "p142": {
      "source_hash": "dc7c35643a9a",
      "text": "langsung menggembung dari retakan."
    },
    "p143": {
      "source_hash": "7b2db362a610",
      "text": "Uap terkurung lepas sekaligus,"
    },
    "p144": {
      "source_hash": "f64a6a914af4",
      "text": "meniup pati itu jadi busa putih besar."
    },
    "p145": {
      "source_hash": "0958debafb41",
      "text": "Pantas biji kuning kecil"
    },
    "p146": {
      "source_hash": "084973eedb00",
      "text": "jadi bunga putih besar?"
    },
    "p147": {
      "source_hash": "7310c632f279",
      "text": "Ya. Kuning cuma di kulit,"
    },
    "p148": {
      "source_hash": "d65db721061c",
      "text": "pati di dalam memang putih."
    },
    "p149": {
      "source_hash": "c99fc7850000",
      "text": "Busa putih lepas panci, dingin,"
    },
    "p150": {
      "source_hash": "388b0cbb261c",
      "text": "langsung keras: bagian renyah itu."
    },
    "p151": {
      "source_hash": "030578056b6e",
      "text": "Kapan melompat?"
    },
    "p152": {
      "source_hash": "d4aea451ec3b",
      "text": "Pati itu menekan panci,"
    },
    "p153": {
      "source_hash": "35c3f7378373",
      "text": "seperti tumbuh kaki pendek."
    },
    "p154": {
      "source_hash": "b8a84a218b76",
      "text": "Popcorn punya kaki?"
    },
    "p155": {
      "source_hash": "b917fa32e5a1",
      "text": "Kaki itu tertekan, memantul bak pegas,"
    },
    "p156": {
      "source_hash": "d999a58cac49",
      "text": "menendang jagung dari panci."
    },
    "p157": {
      "source_hash": "17ad2339d6b2",
      "text": "Yang bikin melompat itu kaki pati,"
    },
    "p158": {
      "source_hash": "b10f86e08d63",
      "text": "bukan uap menyembur bak roket."
    },
    "p159": {
      "source_hash": "4134eb43ee6e",
      "text": "Kayak aku"
    },
    "p160": {
      "source_hash": "7dfa9891ea45",
      "text": "jongkok, lompat!"
    },
    "p161": {
      "source_hash": "c2f314a36f58",
      "text": "Kata peneliti, lompatannya mirip kutu,"
    },
    "p162": {
      "source_hash": "bdb9b2d9af36",
      "text": "juga mirip tanaman yang melontarkan biji."
    },
    "p163": {
      "source_hash": "f569eda61dbe",
      "text": "Kutu?"
    },
    "p164": {
      "source_hash": "b7af2e1f9756",
      "text": "Secepat apa?"
    },
    "p165": {
      "source_hash": "b03c15545d15",
      "text": "Dari retak ke lompat, sepersekian detik,"
    },
    "p166": {
      "source_hash": "c9bb21a79606",
      "text": "mata cuma lihat sekilas."
    },
    "p167": {
      "source_hash": "606d4cf6e48d",
      "text": "Kedip, terlewat!"
    },
    "p168": {
      "source_hash": "7a11070fe55e",
      "text": "Hanya dari tendangan,"
    },
    "p169": {
      "source_hash": "845ce3a56d8d",
      "text": "diperkirakan lompat 1 cm."
    },
    "p170": {
      "source_hash": "8a391dfe4a61",
      "text": "Cuma 1 cm?"
    },
    "p171": {
      "source_hash": "c0eccbaa8715",
      "text": "Kukira terbang tinggi sekali!"
    },
    "p172": {
      "source_hash": "558f7e92e74c",
      "text": "Lompatan yang mereka lihat"
    },
    "p173": {
      "source_hash": "4f20a0f75000",
      "text": "kira-kira sebesar perkiraan itu."
    },
    "p174": {
      "source_hash": "20d3d543dd05",
      "text": "Bunyi pop,"
    },
    "p175": {
      "source_hash": "bcee8c5c404c",
      "text": "itu kulit pecah?"
    },
    "p176": {
      "source_hash": "c5410ab6b5e8",
      "text": "Mereka pun memasang mikrofon,"
    },
    "p177": {
      "source_hash": "9686d26f8875",
      "text": "merekam suara dan gambar."
    },
    "p178": {
      "source_hash": "74797e9c436b",
      "text": "Dicocokkan, tiap bunyi ketahuan tahapnya."
    },
    "p179": {
      "source_hash": "c6264cb70463",
      "text": "Pop itu"
    },
    "p180": {
      "source_hash": "b5987e0e8173",
      "text": "berapa lama?"
    },
    "p181": {
      "source_hash": "5e55c89d789e",
      "text": "Yang terekam cuma sekitar 1/20 detik."
    },
    "p182": {
      "source_hash": "1bc75461d6bd",
      "text": "Pasti kulit"
    },
    "p183": {
      "source_hash": "95cb258939fa",
      "text": "yang retak!"
    },
    "p184": {
      "source_hash": "6ce77ec4458a",
      "text": "Bunyi tak muncul saat kulit retak,"
    },
    "p185": {
      "source_hash": "49b93f511b28",
      "text": "tapi telat beberapa milidetik."
    },
    "p186": {
      "source_hash": "8bd370ce42ff",
      "text": "Suara kaki menendang panci?"
    },
    "p187": {
      "source_hash": "824c5d4dc78b",
      "text": "Bukan juga. Dugaan peneliti, saat uap menyembur,"
    },
    "p188": {
      "source_hash": "ebe038bf06cc",
      "text": "rongga di jagung bergetar berbunyi."
    },
    "p189": {
      "source_hash": "fb0a52a58cb4",
      "text": "Kayak tiup botol"
    },
    "p190": {
      "source_hash": "efc254605515",
      "text": "yang bunyi huuu?"
    },
    "p191": {
      "source_hash": "9cc683cc8702",
      "text": "Agak mirip. Udara di rongga"
    },
    "p192": {
      "source_hash": "a3769859682f",
      "text": "mendadak didorong, berbunyi."
    },
    "p193": {
      "source_hash": "870c83a2fc55",
      "text": "Jadi retak, pop, lompat"
    },
    "p194": {
      "source_hash": "001b3c1cdc9e",
      "text": "tiga hal beda, cuma begitu cepat menyatu."
    },
    "p195": {
      "source_hash": "56a6fa65be4d",
      "text": "Bunyi pop-pop-pop"
    },
    "p196": {
      "source_hash": "817f8b5a6553",
      "text": "banyak jagung, masing-masing menjalani tiga tahap."
    },
    "p197": {
      "source_hash": "e01f78de3570",
      "text": "Ternyata tiga hal!"
    },
    "p198": {
      "source_hash": "b277532d793e",
      "text": "Ingat air gunung? Taruh di samping jagung ini:"
    },
    "p199": {
      "source_hash": "95fe3067bb91",
      "text": "satu terbuka, satu rapat."
    },
    "p200": {
      "source_hash": "9824b8a0edd1",
      "text": "Bedanya seberapa kuat air ditekan."
    },
    "p201": {
      "source_hash": "a657e3b1be2e",
      "text": "Tapi aturannya sama?"
    },
    "p202": {
      "source_hash": "d8ede68e6d69",
      "text": "Ya, aturan plafon tadi,"
    },
    "p203": {
      "source_hash": "0fe44f028815",
      "text": "satu menekan ringan, satu berat."
    },
    "p204": {
      "source_hash": "7415fd0b4453",
      "text": "Penekan"
    },
    "p205": {
      "source_hash": "353f59014563",
      "text": "bisa udara, bisa juga uap?"
    },
    "p206": {
      "source_hash": "ef09a1e44f58",
      "text": "Ya, siapa saja."
    },
    "p207": {
      "source_hash": "008d1fa2b163",
      "text": "Jadi satu aturan bisa membuat mi tak matang dan jagung meletup."
    },
    "p208": {
      "source_hash": "34e3bbef03ca",
      "text": "Paling menipu itu gelembung:"
    },
    "p209": {
      "source_hash": "97339330e53d",
      "text": "bilang air mendidih, bukan sepanas apa."
    },
    "p210": {
      "source_hash": "12982bf1859c",
      "text": "Gelembung menipu!"
    },
    "p211": {
      "source_hash": "d8e549bd59fe",
      "text": "Ingat dua pertanyaanmu? Coba jelaskan sendiri."
    },
    "p212": {
      "source_hash": "f4f1db2c1dc6",
      "text": "Selimut tipis"
    },
    "p213": {
      "source_hash": "7e374e7ea7b6",
      "text": "mendidih di bawah 100,"
    },
    "p214": {
      "source_hash": "b212a4545ed4",
      "text": "mi jadi lambat!"
    },
    "p215": {
      "source_hash": "cf02d66fe310",
      "text": "Lalu kulit jagung"
    },
    "p216": {
      "source_hash": "947350c0b378",
      "text": "mengurung air sampai meletup!"
    },
    "p217": {
      "source_hash": "318266a94482",
      "text": "Nanti makan popcorn, dengar:"
    },
    "p218": {
      "source_hash": "3348a0c6de97",
      "text": "tiap pop, satu jagung selesai tiga tahap."
    },
    "p219": {
      "source_hash": "9cbbac4a0c7f",
      "text": "Kantong popcorn panas,"
    },
    "p220": {
      "source_hash": "a890868a04d5",
      "text": "Dewasa membuka, jauhkan wajah."
    },
    "p221": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p222": {
      "source_hash": "1078aa9ddddf",
      "text": "Berapa yang tak meletup?"
    },
    "p223": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar ya!"
    },
    "p224": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
