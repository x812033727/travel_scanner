    "chief-cooker": "水をトウモロコシの皮に閉じこめる",
    "kid-rocket": "皮が割れて、それから跳ぶ",
    "chief-mic": "「ポン」は少し遅れて鳴る",
    "chief-back-camp": "ハテナが自分で謎を解く"
  },
  "source_hashes": {
    "chapters": {
      "kid-camp-pot": "99f33b458cac",
      "camp-wide": "775a91c71c6d",
