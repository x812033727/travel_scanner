      "chief-mic": "619ba4e6f942",
      "chief-back-camp": "d839bbdce18f"
    },
    "title": "a89a4f7beaeb",
    "description": "40f5c6ef34a7",
    "tags": "aee12c530bd5",
    "thumbnail": "6ef5c18ce789"
  },
  "lines": {
    "p001": {
      "source_hash": "27e073618546",
      "text": "Diretora! Na montanha,"
    },
    "p002": {
      "source_hash": "c81545066678",
      "text": "a água já borbulhava,"
    },
    "p003": {
      "source_hash": "cf14c74108eb",
      "text": "mas o macarrão seguia duro!"
    },
    "p004": {
      "source_hash": "9745f3bebd53",
      "text": "Achei que o gás"
    },
    "p005": {
      "source_hash": "67dd4e607d53",
      "text": "era fraco!"
    },
    "p006": {
      "source_hash": "3e98bd2973ad",
      "text": "Mas no micro-ondas,"
    },
    "p007": {
      "source_hash": "8deafb923220",
      "text": "a pipoca estourou rapidinho!"
    },
    "p008": {
      "source_hash": "735854b7ae55",
      "text": "As duas têm o mesmo culpado: a água."
    },
    "p009": {
      "source_hash": "0480d1648f77",
      "text": "Pense: é sempre água esquentando."
    },
    "p010": {
      "source_hash": "9c50cf208954",
      "text": "Por que na serra não cozinha,"
    },
    "p011": {
      "source_hash": "b8ef047a9450",
      "text": "e no milho faz o grão explodir?"
    },
    "p012": {
      "source_hash": "3507021695e8",
      "text": "Ferveu, é cem graus!"
    },
    "p013": {
      "source_hash": "af4beabcaff8",
      "text": "Chuta: a água da serra,"
    },
    "p014": {
      "source_hash": "fcc2756c3c94",
      "text": "dava 100 graus?"
    },
    "p015": {
      "source_hash": "cd6f1bc15477",
      "text": "E no fundo da tigela"
    },
    "p016": {
      "source_hash": "1cadb9020d03",
      "text": "não sobram uns que nunca estouram?"
    },
    "p017": {
      "source_hash": "c9bc6ec074ff",
      "text": "É,"
    },
    "p018": {
      "source_hash": "1aa95cba91bc",
      "text": "são grãos preguiçosos?"
    },
    "p019": {
      "source_hash": "2a5a8da6cce3",
      "text": "A chave é a água,"
    },
    "p020": {
      "source_hash": "cc23a5381847",
      "text": "se ela está solta ou presa."
    },
    "p021": {
      "source_hash": "26c7c73004d7",
      "text": "A água fervendo na serra parece igual à de casa."
    },
    "p022": {
      "source_hash": "f294bcc404a2",
      "text": "Fervendo, perto do mar,"
    },
    "p023": {
      "source_hash": "70ccd4714b47",
      "text": "uns 100 graus."
    },
    "p024": {
      "source_hash": "dc53258cb96f",
      "text": "Em casa, lá embaixo, é quase isso."
    },
    "p025": {
      "source_hash": "eeae8f7da232",
      "text": "E aí,"
    },
    "p026": {
      "source_hash": "f9278e208c46",
      "text": "por que faz bolhas?"
    },
    "p027": {
      "source_hash": "9f00a2ff5958",
      "text": "Mais quente, mais vapor."
    },
    "p028": {
      "source_hash": "1bf202e5a2a9",
      "text": "Bem quente, surgem bolhas de vapor na água."
    },
    "p029": {
      "source_hash": "406bbef17816",
      "text": "Fogo alto,"
    },
    "p030": {
      "source_hash": "040d5dfe62dd",
      "text": "não esquenta mais?"
    },
    "p031": {
      "source_hash": "9dd1454a5756",
      "text": "Não. Ferveu, não sobe mais."
    },
    "p032": {
      "source_hash": "c4164308a527",
      "text": "Fogo alto só faz borbulhar mais forte."
    },
    "p033": {
      "source_hash": "52685942ed93",
      "text": "E o fogo a mais,"
    },
    "p034": {
      "source_hash": "831f2dd1874d",
      "text": "vai pra onde?"
    },
    "p035": {
      "source_hash": "b5415d0d727f",
      "text": "Vira vapor e vai embora."
    },
    "p036": {
      "source_hash": "13d0b9380b06",
      "text": "Então a água fervendo tem um teto."
    },
    "p037": {
      "source_hash": "289b5ec1e0f2",
      "text": "Esse teto"
    },
    "p038": {
      "source_hash": "57053affef58",
      "text": "é sempre igual?"
    },
    "p039": {
      "source_hash": "897abe53c250",
      "text": "Não. Depende de quanto ar pressiona a água."
    },
    "p040": {
      "source_hash": "8d5b49d92e80",
      "text": "Ar?"
    },
    "p041": {
      "source_hash": "971e2caca830",
      "text": "Ar é leve,"
    },
    "p042": {
      "source_hash": "c412ee39f772",
      "text": "e aperta coisas?"
    },
    "p043": {
      "source_hash": "c2f171adcb10",
      "text": "Sim. Tem um montão de ar sobre você,"
    },
    "p044": {
      "source_hash": "a4af5e5a0a00",
      "text": "apertando você e a panela também."
    },
    "p045": {
      "source_hash": "610354f1f7f4",
      "text": "É um cobertor de ar."
    },
    "p046": {
      "source_hash": "e281228e76f3",
      "text": "Para sair, a bolha tem que empurrá-lo."
    },
    "p047": {
      "source_hash": "25ebe0099e31",
      "text": "A bolha precisa empurrar?"
    },
    "p048": {
      "source_hash": "f2a38306f1c7",
      "text": "Sim, só bem quente a bolha consegue."
    },
    "p049": {
      "source_hash": "c58b5966a28a",
      "text": "Perto do mar ele é mais grosso: pede mais calor."
    },
    "p050": {
      "source_hash": "0fa426d12efd",
      "text": "E na montanha?"
    },
    "p051": {
      "source_hash": "2acb495b3bce",
      "text": "Subindo, há menos ar,"
    },
    "p052": {
      "source_hash": "cdbc5843363b",
      "text": "e o cobertor fica fino e leve."
    },
    "p053": {
      "source_hash": "84c8c9633202",
      "text": "Fino, nem precisa de tanto calor."
    },
    "p054": {
      "source_hash": "29d7f18fa964",
      "text": "Então lá em cima"
    },
    "p055": {
      "source_hash": "0b3894e6cb72",
      "text": "ferve mais fria?"
    },
    "p056": {
      "source_hash": "b5a371dc00c9",
      "text": "Sim. A uns 3.000 metros,"
    },
    "p057": {
      "source_hash": "d9f8bc1c165f",
      "text": "ferve a uns 90 graus."
    },
    "p058": {
      "source_hash": "e73dcd739d6a",
      "text": "O Yushan tem quase 4.000 metros:"
    },
    "p059": {
      "source_hash": "9192baec5f45",
      "text": "no topo, ferve abaixo de 90."
    },
    "p060": {
      "source_hash": "da16dd86cc2a",
      "text": "Massa, ovo e arroz na serra"
    },
    "p061": {
      "source_hash": "3a0769d57273",
      "text": "demoram mais que em casa."
    },
    "p062": {
      "source_hash": "b2655bbc22b3",
      "text": "Só oitenta e poucos graus!"
    },
    "p063": {
      "source_hash": "88d2c0d4aea8",
      "text": "Mas borbulha igual,"
    },
    "p064": {
      "source_hash": "53021ceed4ba",
      "text": "por que segue duro?"
    },
    "p065": {
      "source_hash": "409756de54c6",
      "text": "O calor cozinha, não bolhas."
    },
    "p066": {
      "source_hash": "ccd8316b34d6",
      "text": "Menos quente, o calor entra devagar."
    },
    "p067": {
      "source_hash": "fb7cd5b1069d",
      "text": "Não é o gás que é fraco,"
    },
    "p068": {
      "source_hash": "943db42b2eed",
      "text": "a água é menos quente."
    },
    "p069": {
      "source_hash": "f833f27e4e64",
      "text": "Então fogo máximo!"
    },
    "p070": {
      "source_hash": "e24896bc2415",
      "text": "E o teto? Fogo alto,"
    },
    "p071": {
      "source_hash": "db9b6c7c6e6a",
      "text": "fica na mesma temperatura, só ferve mais."
    },
    "p072": {
      "source_hash": "e307a2e141af",
      "text": "Então é cozinhar mais!"
    },
    "p073": {
      "source_hash": "35da92098c8b",
      "text": "É. E se for ao contrário:"
    },
    "p074": {
      "source_hash": "c79d562a4e7a",
      "text": "tampa bem presa, sem vapor sair?"
    },
    "p075": {
      "source_hash": "c495ca1a718e",
      "text": "Tampada,"
    },
    "p076": {
      "source_hash": "901153ed3de9",
      "text": "a água fica mais quente?"
    },
    "p077": {
      "source_hash": "160df1e23311",
      "text": "Fica. Isso é a panela de pressão,"
    },
    "p078": {
      "source_hash": "90ec462e2a7a",
      "text": "usada no alto pra fazer arroz."
    },
    "p079": {
      "source_hash": "da0a6c8959f0",
      "text": "Só adultos usam, com manual."
    },
    "p080": {
      "source_hash": "a21ba0255949",
      "text": "Nada de prender vapor em casa."
    },
    "p081": {
      "source_hash": "d725cbb1ea20",
      "text": "Veja a da natureza:"
    },
    "p082": {
      "source_hash": "27442fe58ac4",
      "text": "o milho da sua tigela."
    },
    "p083": {
      "source_hash": "a1872457708c",
      "text": "Ele tem uma casca dura e brilhante,"
    },
    "p084": {
      "source_hash": "f9485afb34e9",
      "text": "e o vapor quase não passa."
    },
    "p085": {
      "source_hash": "e6eb0ce0681f",
      "text": "E o da espiga,"
    },
    "p086": {
      "source_hash": "3855627d571b",
      "text": "estoura?"
    },
    "p087": {
      "source_hash": "e69a828f94ca",
      "text": "É um milho especial,"
    },
    "p088": {
      "source_hash": "9c98ac9ea2f3",
      "text": "Casca dura, quase impermeável: raro entre grãos."
    },
    "p089": {
      "source_hash": "87dadfd0e030",
      "text": "Mas ele é sequinho,"
    },
    "p090": {
      "source_hash": "70f7ba3b8c27",
      "text": "cadê a água?"
    },
    "p091": {
      "source_hash": "3990b80196db",
      "text": "Tem. Dentro há amido macio,"
    },
    "p092": {
      "source_hash": "b87647cc1898",
      "text": "e no meio, escondida, uma gotinha de água."
    },
    "p093": {
      "source_hash": "7d013b5b1d88",
      "text": "Num grão que estoura bem,"
    },
    "p094": {
      "source_hash": "f181bd9b4fe1",
      "text": "uns 14 por cento é água."
    },
    "p095": {
      "source_hash": "8fd89503ec8b",
      "text": "Parece seco,"
    },
    "p096": {
      "source_hash": "c571424f486c",
      "text": "mas esconde água!"
    },
    "p097": {
      "source_hash": "85386c78f369",
      "text": "Esquenta: quer virar vapor,"
    },
    "p098": {
      "source_hash": "ff5122590ed5",
      "text": "mas a casca a prende lá dentro."
    },
    "p099": {
      "source_hash": "99b749c73bf3",
      "text": "Preso, o vapor se acumula."
    },
    "p100": {
      "source_hash": "c5eccf152c6e",
      "text": "O grão vira um balão cada vez mais cheio."
    },
    "p101": {
      "source_hash": "a94306fdfa25",
      "text": "Mas espera,"
    },
    "p102": {
      "source_hash": "45e77f218b8d",
      "text": "a água não passa do teto?"
    },
    "p103": {
      "source_hash": "592424b6cb95",
      "text": "Lembra o cobertor?"
    },
    "p104": {
      "source_hash": "f745daf4c431",
      "text": "No grão, o que aperta a água é o vapor acumulado."
    },
    "p105": {
      "source_hash": "b8c41b13694b",
      "text": "Quanto mais aperta,"
    },
    "p106": {
      "source_hash": "9356020d5668",
      "text": "mais a água passa de 100 graus: o teto sobe."
    },
    "p107": {
      "source_hash": "8afd1b9c6816",
      "text": "O oposto da serra!"
    },
    "p108": {
      "source_hash": "d686093461c4",
      "text": "Isso. Mediram: a maioria estoura perto de 180 graus,"
    },
    "p109": {
      "source_hash": "91a0b1c686f2",
      "text": "com a pressão uns 9 a 10 vezes a do ar lá fora."
    },
    "p110": {
      "source_hash": "abb5341e5086",
      "text": "A casca quase arrebenta!"
    },
    "p111": {
      "source_hash": "375da67ee606",
      "text": "E mais: pelas contas, antes de rachar,"
    },
    "p112": {
      "source_hash": "05bf553da9f4",
      "text": "quase toda a água ainda está líquida."
    },
    "p113": {
      "source_hash": "2e764b9e4237",
      "text": "Tão quente,"
    },
    "p114": {
      "source_hash": "fef4423a0784",
      "text": "e ainda não virou vapor?"
    },
    "p115": {
      "source_hash": "872dba315059",
      "text": "É. Com tanta pressão, segue líquida."
    },
    "p116": {
      "source_hash": "27b30e64ca1b",
      "text": "Rachou, a pressão cai: vira vapor na hora."
    },
    "p117": {
      "source_hash": "bb3e9aa2b845",
      "text": "Nisso, o amido amolece e gruda,"
    },
    "p118": {
      "source_hash": "c6587db471c9",
      "text": "feito uma massa pronta."
    },
    "p119": {
      "source_hash": "3a863c5510c5",
      "text": "Fogo altão,"
    },
    "p120": {
      "source_hash": "d38690666d1d",
      "text": "pipoca mais rápido?"
    },
    "p121": {
      "source_hash": "6a78ca2c071f",
      "text": "Rápido demais é ruim. Racha cedo,"
    },
    "p122": {
      "source_hash": "ba21d5a4bd86",
      "text": "o amido não amolece e fica meio grão duro."
    },
    "p123": {
      "source_hash": "14022848fbce",
      "text": "E os do fundo,"
    },
    "p124": {
      "source_hash": "e0f3b699338b",
      "text": "nunca estouram?"
    },
    "p125": {
      "source_hash": "c42ef055e794",
      "text": "Costumam estar secos."
    },
    "p126": {
      "source_hash": "0e44fa9c37af",
      "text": "Com pouca água, falta força pra rachar."
    },
    "p127": {
      "source_hash": "c57052dfdccf",
      "text": "E a ponta presa à espiga"
    },
    "p128": {
      "source_hash": "c86a3dac6d7e",
      "text": "segura mal o vapor: aquecendo devagar, ele escapa."
    },
    "p129": {
      "source_hash": "d2fd59be8d77",
      "text": "Ah,"
    },
    "p130": {
      "source_hash": "a94a0c808aab",
      "text": "vazou e não estoura!"
    },
    "p131": {
      "source_hash": "7c31f3f73e00",
      "text": "E quando a casca racha,"
    },
    "p132": {
      "source_hash": "935c23df9851",
      "text": "por que ele pula?"
    },
    "p133": {
      "source_hash": "0e125d729cad",
      "text": "O vapor sai pela fresta"
    },
    "p134": {
      "source_hash": "f6881a6bafe3",
      "text": "e empurra feito foguete?"
    },
    "p135": {
      "source_hash": "72d7be01f699",
      "text": "Muitos acham. Em 2015, dois cientistas franceses"
    },
    "p136": {
      "source_hash": "36d3c23527aa",
      "text": "quiseram ver direito."
    },
    "p137": {
      "source_hash": "202f34418b9c",
      "text": "Grãos numa chapa quente,"
    },
    "p138": {
      "source_hash": "3180a1bb0209",
      "text": "filmados a quase 3.000 quadros por segundo."
    },
    "p139": {
      "source_hash": "bbbbaf8255a0",
      "text": "Três mil!"
    },
    "p140": {
      "source_hash": "006e4c902857",
      "text": "O que viram?"
    },
    "p141": {
      "source_hash": "cb1439c831f1",
      "text": "Primeiro a casca racha, e o amido mole"
    },
    "p142": {
      "source_hash": "dc7c35643a9a",
      "text": "sai de repente pela fresta."
    },
    "p143": {
      "source_hash": "7b2db362a610",
      "text": "O vapor preso escapa de vez"
    },
    "p144": {
      "source_hash": "f64a6a914af4",
      "text": "e sopra o amido numa espuma branca."
    },
    "p145": {
      "source_hash": "0958debafb41",
      "text": "Por isso o grãozinho amarelo"
    },
    "p146": {
      "source_hash": "084973eedb00",
      "text": "vira um floco branco?"
    },
    "p147": {
      "source_hash": "7310c632f279",
      "text": "Só a casca é amarela;"
    },
    "p148": {
      "source_hash": "d65db721061c",
      "text": "o amido já era branco."
    },
    "p149": {
      "source_hash": "c99fc7850000",
      "text": "A espuma esfria fora da panela"
    },
    "p150": {
      "source_hash": "388b0cbb261c",
      "text": "e endurece: é a parte crocante."
    },
    "p151": {
      "source_hash": "030578056b6e",
      "text": "E quando ele pula?"
    },
    "p152": {
      "source_hash": "d4aea451ec3b",
      "text": "O amido toca a panela,"
    },
    "p153": {
      "source_hash": "35c3f7378373",
      "text": "como uma perninha curta."
    },
    "p154": {
      "source_hash": "b8a84a218b76",
      "text": "Pipoca tem perna?"
    },
    "p155": {
      "source_hash": "b917fa32e5a1",
      "text": "A perna amassa e volta feito mola,"
    },
    "p156": {
      "source_hash": "d999a58cac49",
      "text": "chutando o grão pra cima."
    },
    "p157": {
      "source_hash": "17ad2339d6b2",
      "text": "O pulo vem da perna de amido,"
    },
    "p158": {
      "source_hash": "b10f86e08d63",
      "text": "não do vapor feito foguete."
    },
    "p159": {
      "source_hash": "4134eb43ee6e",
      "text": "Como eu,"
    },
    "p160": {
      "source_hash": "7dfa9891ea45",
      "text": "agacho e pulo!"
    },
    "p161": {
      "source_hash": "c2f314a36f58",
      "text": "Eles dizem que pula meio como pulga,"
    },
    "p162": {
      "source_hash": "bdb9b2d9af36",
      "text": "e como plantas que lançam sementes."
    },
    "p163": {
      "source_hash": "f569eda61dbe",
      "text": "Pulga?"
    },
    "p164": {
      "source_hash": "b7af2e1f9756",
      "text": "Quão rápido?"
    },
    "p165": {
      "source_hash": "b03c15545d15",
      "text": "Racha e pula: centésimos de segundo,"
    },
    "p166": {
      "source_hash": "c9bb21a79606",
      "text": "o olho mal percebe."
    },
    "p167": {
      "source_hash": "606d4cf6e48d",
      "text": "Piscou, perdeu!"
    },
    "p168": {
      "source_hash": "7a11070fe55e",
      "text": "Só o chute, estimam,"
    },
    "p169": {
      "source_hash": "845ce3a56d8d",
      "text": "pularia um centímetro."
    },
    "p170": {
      "source_hash": "8a391dfe4a61",
      "text": "Só isso?"
    },
    "p171": {
      "source_hash": "c0eccbaa8715",
      "text": "Achei que voava bem alto!"
    },
    "p172": {
      "source_hash": "558f7e92e74c",
      "text": "Os pulos que eles viram"
    },
    "p173": {
      "source_hash": "4f20a0f75000",
      "text": "batem com essa estimativa."
    },
    "p174": {
      "source_hash": "20d3d543dd05",
      "text": "E o pop,"
    },
    "p175": {
      "source_hash": "bcee8c5c404c",
      "text": "é a casca quebrando?"
    },
    "p176": {
      "source_hash": "c5410ab6b5e8",
      "text": "Então usaram um microfone,"
    },
    "p177": {
      "source_hash": "9686d26f8875",
      "text": "gravando som e imagem."
    },
    "p178": {
      "source_hash": "74797e9c436b",
      "text": "Juntos, mostram de que passo é cada som."
    },
    "p179": {
      "source_hash": "c6264cb70463",
      "text": "E o pop"
    },
    "p180": {
      "source_hash": "b5987e0e8173",
      "text": "dura quanto?"
    },
    "p181": {
      "source_hash": "5e55c89d789e",
      "text": "Cerca de um vigésimo de segundo."
    },
    "p182": {
      "source_hash": "1bc75461d6bd",
      "text": "É a casca"
    },
    "p183": {
      "source_hash": "95cb258939fa",
      "text": "rachando, certeza!"
    },
    "p184": {
      "source_hash": "6ce77ec4458a",
      "text": "O som não sai quando racha,"
    },
    "p185": {
      "source_hash": "49b93f511b28",
      "text": "vem uns milésimos depois."
    },
    "p186": {
      "source_hash": "8bd370ce42ff",
      "text": "É o chute da perninha?"
    },
    "p187": {
      "source_hash": "824c5d4dc78b",
      "text": "Também não. O palpite deles: o vapor escapa"
    },
    "p188": {
      "source_hash": "ebe038bf06cc",
      "text": "e faz ressoar os ocos do grão."
    },
    "p189": {
      "source_hash": "fb0a52a58cb4",
      "text": "Tipo soprar"
    },
    "p190": {
      "source_hash": "efc254605515",
      "text": "numa garrafa, uuu?"
    },
    "p191": {
      "source_hash": "9cc683cc8702",
      "text": "Um pouco. O ar no oco,"
    },
    "p192": {
      "source_hash": "a3769859682f",
      "text": "se mexe de repente e soa."
    },
    "p193": {
      "source_hash": "870c83a2fc55",
      "text": "Rachar, pop e pular"
    },
    "p194": {
      "source_hash": "001b3c1cdc9e",
      "text": "são três coisas, coladas de tão rápido."
    },
    "p195": {
      "source_hash": "56a6fa65be4d",
      "text": "Esse pop-pop-pop"
    },
    "p196": {
      "source_hash": "817f8b5a6553",
      "text": "são muitos grãos, cada um com os três passos."
    },
    "p197": {
      "source_hash": "e01f78de3570",
      "text": "São três coisas!"
    },
    "p198": {
      "source_hash": "b277532d793e",
      "text": "E a água da serra? Ponha ao lado do grão:"
    },
    "p199": {
      "source_hash": "95fe3067bb91",
      "text": "Um aberto, um fechado."
    },
    "p200": {
      "source_hash": "9824b8a0edd1",
      "text": "Só muda o quanto aperta a água."
    },
    "p201": {
      "source_hash": "a657e3b1be2e",
      "text": "Mas a regra é a mesma?"
    },
    "p202": {
      "source_hash": "d8ede68e6d69",
      "text": "É, a regra do teto,"
    },
    "p203": {
      "source_hash": "0fe44f028815",
      "text": "um aperta pouco, outro muito."
    },
    "p204": {
      "source_hash": "7415fd0b4453",
      "text": "Então,"
    },
    "p205": {
      "source_hash": "353f59014563",
      "text": "quem aperta é ar ou vapor?"
    },
    "p206": {
      "source_hash": "ef09a1e44f58",
      "text": "É, tanto faz."
    },
    "p207": {
      "source_hash": "008d1fa2b163",
      "text": "A mesma regra deixa a massa crua e estoura o milho."
    },
    "p208": {
      "source_hash": "34e3bbef03ca",
      "text": "O que engana são as bolhas:"
    },
    "p209": {
      "source_hash": "97339330e53d",
      "text": "dizem que ferveu, não o quão quente."
    },
    "p210": {
      "source_hash": "12982bf1859c",
      "text": "Bolha enganosa!"
    },
    "p211": {
      "source_hash": "d8e549bd59fe",
      "text": "Lembra as duas perguntas? Explica você."
    },
    "p212": {
      "source_hash": "f4f1db2c1dc6",
      "text": "O cobertor!"
    },
    "p213": {
      "source_hash": "7e374e7ea7b6",
      "text": "ferve antes de 100,"
    },
    "p214": {
      "source_hash": "b212a4545ed4",
      "text": "e demora mais!"
    },
    "p215": {
      "source_hash": "cf02d66fe310",
      "text": "E a casca do milho"
    },
    "p216": {
      "source_hash": "947350c0b378",
      "text": "prende a água até estourar!"
    },
    "p217": {
      "source_hash": "318266a94482",
      "text": "Na próxima pipoca, ouça:"
    },
    "p218": {
      "source_hash": "3348a0c6de97",
      "text": "cada pop, um grão fez os três passos."
    },
    "p219": {
      "source_hash": "9cbbac4a0c7f",
      "text": "O saquinho sai pelando,"
    },
    "p220": {
      "source_hash": "a890868a04d5",
      "text": "um adulto abre, rosto longe."
    },
    "p221": {
      "source_hash": "36d742bcb996",
      "text": "Entendi!"
    },
    "p222": {
      "source_hash": "1078aa9ddddf",
      "text": "Quantos sobram no fundo?"
    },
    "p223": {
      "source_hash": "fe508e80b52e",
      "text": "Comenta aí!"
    },
    "p224": {
      "source_hash": "88de677d4daa",
      "text": "Siga o Escritório do Ah, É Por Isso e ache os porquês!"
    }
  }
}
