{
  "zq39a01": {
    "text": "Turunkan!",
    "emotion": "披著外衫衝出來，一聲喝住"
  },
  "zq39a02": {
    "text": "Dia datang cari tabib!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "Adikku demam semalaman,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "Tabib, tolong dia.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "Liuxi? Itu sejam,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "aku tak bisa naik kuda.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "Tak perlu bisa.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "Pegangan.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "Mereka mengejar!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "Ada prajurit di belakang!",
    "emotion": "畫外",
    "say": "Prajurit di belakang!"
  },
  "zq39a11": {
    "text": "Pe-pelan sedikit!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "Tutup mata,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "hitung sampai seratus.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "Sembilan puluh delapan,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "Sembilan puluh sembilan…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "Xiaohe, tahan sebentar lagi.",
    "emotion": "整夜沒睡，聲音啞"
  },
  "zq39a17": {
    "text": "A-Ling?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "Mana pasiennya?",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "Demamnya terlalu lama,",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "turunkan dulu panasnya.",
    "emotion": "句句有把握",
    "say": "turunkan dulu."
  },
  "zq39a21": {
    "text": "Minumkan sekaligus.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "Pintar, minum biar nggak panas.",
    "emotion": "哄著"
  },
  "zq39a23": {
    "text": "Sebelum subuh, kita lihat turun atau tidak.",
    "emotion": "慢而清楚",
    "say": "Kita lihat sebelum subuh."
  },
  "zq39a24": {
    "text": "Aku yang jaga.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "A-Ling, poin suka plus dua belas.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling, plus dua belas."
  },
  "zq39a26": {
    "text": "Poin suka lima puluh, peti hadiah terbuka.",
    "emotion": "平板電子音，叮一聲",
    "say": "Lima puluh, peti hadiah terbuka."
  },
  "zq39a27": {
    "text": "Didapat: teknik membuat kaca.",
    "emotion": "平板電子音",
    "say": "Didapat: teknik kaca."
  },
  "zq39a28": {
    "text": "Pasir kuarsa, tungku panas…",
    "emotion": "壓低聲音嘀咕"
  },
  "zq39a29": {
    "text": "Simpan dulu saja.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "Kak…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "Turun!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "Nggak panas lagi!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "Turun?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "Kalau sudah turun, aman.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "Hari Kakak jatuh ke air,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "aku lihat ada yang dorong.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "Siapa?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "Topi jerami, tali merah,",
    "emotion": "比著自己的頭"
  },
  "zq39a39": {
    "text": "mukanya nggak kelihatan.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "Tali merah…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "Pintu samping rumah Qian.",
    "emotion": "畫外，低聲"
  },
  "zq39a42": {
    "text": "Xu Yan, di lumbung,",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "sudah nggak tertahan.",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "Diao Qi?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "Tunggu Sarjana Xu!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "Kalau berani, lakukan.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "Hentikan!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "Aku yang menangkapnya,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "bukan hak kalian.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "Sarjana Xu dari Liuxi?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "Desa minta jawaban darinya.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "Biarkan, atau serahkan ke mereka?",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "Sarjana, kau putuskan.",
    "emotion": "畫外，挑釁"
  }
}
