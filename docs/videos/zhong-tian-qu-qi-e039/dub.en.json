{
  "zq39a01": {
    "text": "Put them down!",
    "emotion": "披著外衫衝出來，一聲喝住",
    "say": "Hold!"
  },
  "zq39a02": {
    "text": "She's here for help!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "My sister's fevered all night,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "Doctor, save her.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "Liuxi? An hour away,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "this old man can't ride.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "You don't have to.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "Hold on tight.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "They're gaining!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "Soldiers behind us!",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "S-slow down!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "Eyes shut,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "count to a hundred.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "Ninety-eight,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "Ninety-nine…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "Xiaohe, hold on a bit.",
    "emotion": "整夜沒睡，聲音啞"
  },
  "zq39a17": {
    "text": "A-Ling?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "Where's the patient?",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "The fever's gone on too long,",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "bring it down first.",
    "emotion": "句句有把握"
  },
  "zq39a21": {
    "text": "All of it, in one go.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "Good girl, drink and you'll cool down.",
    "emotion": "哄著",
    "say": "Drink up, you'll cool down."
  },
  "zq39a23": {
    "text": "We'll know by dawn if it breaks.",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "I'll keep watch.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "A-Ling affection: plus twelve.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq39a26": {
    "text": "Affection fifty, reward chest unlocked.",
    "emotion": "平板電子音，叮一聲",
    "say": "Fifty. Reward chest unlocked."
  },
  "zq39a27": {
    "text": "Acquired: glassmaking method.",
    "emotion": "平板電子音",
    "say": "Acquired: glassmaking."
  },
  "zq39a28": {
    "text": "Quartz sand, a high-heat kiln…",
    "emotion": "壓低聲音嘀咕",
    "say": "Quartz sand, a kiln…"
  },
  "zq39a29": {
    "text": "Shelve it for now.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "Brother…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "It's gone!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "She's cool!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "Gone?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "Once it breaks, she's safe.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "The day Brother fell in,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "I saw someone push.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "Who?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "Straw hat, red string,",
    "emotion": "比著自己的頭"
  },
  "zq39a39": {
    "text": "I didn't see a face.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "Red string…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "The Qian side gate.",
    "emotion": "畫外，低聲"
  },
  "zq39a42": {
    "text": "Xu Yan, the granary—",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "it's out of hand.",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "Diao Qi?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "Wait for Scholar Xu!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "Do it, if you dare.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "Stop!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "I caught him,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "he's not yours to touch.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "Liuxi's Scholar Xu?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "The village wants his answer.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "Keep him, or give him to them.",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "Your call, Scholar.",
    "emotion": "畫外，挑釁"
  }
}
