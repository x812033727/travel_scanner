{
  "zq39a01": {
    "text": "내려놔!",
    "emotion": "披著外衫衝出來，一聲喝住"
  },
  "zq39a02": {
    "text": "치료받으러 온 거다!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "동생이 밤새 열이 나서,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "의원님, 살려 줘요.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "류시? 반 시진인데,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "늙은이가 말을 못 타.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "탈 줄 몰라도 돼.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "꽉 잡아.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "쫓아온다!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "뒤에 병사다!",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "처, 천천히!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "눈 감아,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "백까지 세.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "아흔여덟,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "아흔아홉…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "샤오허, 조금만 버텨.",
    "emotion": "整夜沒睡，聲音啞"
  },
  "zq39a17": {
    "text": "아링?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "환자는 어디 있나?",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "열이 너무 오래갔군,",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "먼저 열부터 내리지.",
    "emotion": "句句有把握"
  },
  "zq39a21": {
    "text": "단숨에 다 먹여.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "착하지, 마시면 안 뜨거워.",
    "emotion": "哄著"
  },
  "zq39a23": {
    "text": "동트기 전에 내리는지 보세.",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "내가 지킬게.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "아링 호감, +12.",
    "emotion": "平板電子音，叮一聲",
    "say": "아링 호감, 플러스 십이."
  },
  "zq39a26": {
    "text": "호감 50, 보상 상자 개봉.",
    "emotion": "平板電子音，叮一聲",
    "say": "호감 오십, 보상 상자 개봉."
  },
  "zq39a27": {
    "text": "획득: 유리 제조법.",
    "emotion": "平板電子音"
  },
  "zq39a28": {
    "text": "석영 모래, 고온 가마…",
    "emotion": "壓低聲音嘀咕",
    "say": "석영 모래, 가마…"
  },
  "zq39a29": {
    "text": "일단 넣어 두자.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "오빠…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "내렸다!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "안 뜨거워!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "내렸어?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "내렸으면 이제 괜찮네.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "오빠 물에 빠진 날,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "누가 미는 거 봤어.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "누구?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "밀짚모자에, 빨간 끈,",
    "emotion": "比著自己的頭"
  },
  "zq39a39": {
    "text": "얼굴은 못 봤어.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "빨간 끈…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "첸 가 옆문.",
    "emotion": "畫外，低聲"
  },
  "zq39a42": {
    "text": "쉬옌, 곳간 쪽이,",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "더는 못 막아.",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "댜오치?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "쉬 수재를 기다려!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "할 거면 해 봐.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "멈춰라!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "잡은 건 나야,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "너희가 손댈 일 아니야.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "류시의 쉬 수재?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "마을이 그의 답을 기다리네.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "살릴지, 넘길지.",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "수재, 말해 봐.",
    "emotion": "畫外，挑釁"
  }
}
