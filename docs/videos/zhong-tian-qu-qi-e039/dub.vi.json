{
  "zq39a01": {
    "text": "Hạ xuống!",
    "emotion": "披著外衫衝出來，一聲喝住"
  },
  "zq39a02": {
    "text": "Người ta đến cầu y!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "Tiểu muội sốt suốt đêm,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "Đại phu, cứu con bé.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "Liễu Khê? Nửa canh giờ,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "lão phu không biết cưỡi ngựa.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "Không cần ông biết.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "Ôm chặt ta.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "Đuổi tới rồi!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "Phía sau có lính!",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "Chậ-chậm thôi!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "Nhắm mắt,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "đếm tới một trăm.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "Chín mươi tám,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "Chín mươi chín…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "Tiểu Hòa, gắng thêm chút nữa.",
    "emotion": "整夜沒睡，聲音啞"
  },
  "zq39a17": {
    "text": "A Lệnh?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "Bệnh nhân đâu?",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "Sốt lâu quá rồi,",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "hạ sốt trước.",
    "emotion": "句句有把握"
  },
  "zq39a21": {
    "text": "Cho uống một hơi hết.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "Ngoan, uống rồi sẽ hết nóng.",
    "emotion": "哄著"
  },
  "zq39a23": {
    "text": "Trước bình minh xem có hạ không.",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "Ta canh.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "A Lệnh, hảo cảm cộng mười hai.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq39a26": {
    "text": "Hảo cảm năm mươi, mở rương thưởng.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq39a27": {
    "text": "Nhận được: phép nung thủy tinh.",
    "emotion": "平板電子音"
  },
  "zq39a28": {
    "text": "Cát thạch anh, lò nung nhiệt cao…",
    "emotion": "壓低聲音嘀咕",
    "say": "Cát thạch anh, lò nhiệt cao…"
  },
  "zq39a29": {
    "text": "Cứ cất đã.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "Ca…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "Hạ rồi!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "Hết nóng rồi!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "Hạ rồi?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "Hạ sốt rồi thì không sao.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "Hôm ca rơi xuống nước,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "muội thấy có người đẩy.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "Ai?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "Đội nón rơm, buộc dây đỏ,",
    "emotion": "比著自己的頭"
  },
  "zq39a39": {
    "text": "muội không thấy mặt.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "Dây đỏ…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "Cửa hông Tiền phủ.",
    "emotion": "畫外，低聲"
  },
  "zq39a42": {
    "text": "Hứa Nghiên, bên kho thóc,",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "không giữ nổi nữa.",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "Điêu Thất?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "Đợi Hứa tú tài tới!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "Có gan thì ra tay.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "Dừng tay!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "Người là ta bắt,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "không tới lượt các ngươi.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "Hứa tú tài thôn Liễu Khê?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "Cả thôn chờ tú tài một lời.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "Giữ lại, hay giao cho bọn họ.",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "Tú tài, ngươi nói đi.",
    "emotion": "畫外，挑釁"
  }
}
