{
  "zq39a01": {
    "text": "Abaixem isso!",
    "emotion": "披著外衫衝出來，一聲喝住",
    "say": "Alto!"
  },
  "zq39a02": {
    "text": "Ela veio atrás de médico!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "Minha irmã ardeu a noite toda,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "Doutor, salva ela.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "Liuxi? Uma hora,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "este velho não monta.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "Não precisa.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "Segura firme.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "Estão chegando!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "Soldados atrás!",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "De-devagar!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "Fecha os olhos,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "conta até cem.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "Noventa e oito,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "Noventa e nove…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "Xiaohe, aguenta mais um pouco.",
    "emotion": "整夜沒睡，聲音啞",
    "say": "Aguenta, Xiaohe."
  },
  "zq39a17": {
    "text": "A-Ling?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "Cadê a doente?",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "Febre há tempo demais,",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "primeiro, baixar a febre.",
    "emotion": "句句有把握",
    "say": "primeiro, a febre."
  },
  "zq39a21": {
    "text": "Tudo de uma vez.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "Boazinha, toma que passa.",
    "emotion": "哄著"
  },
  "zq39a23": {
    "text": "Ao raiar, veremos se baixou.",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "Eu vigio.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "A-Ling: afeição, mais doze.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: mais doze."
  },
  "zq39a26": {
    "text": "Afeição cinquenta: baú de recompensa aberto.",
    "emotion": "平板電子音，叮一聲",
    "say": "Cinquenta: baú aberto."
  },
  "zq39a27": {
    "text": "Ganho: fabricação de vidro.",
    "emotion": "平板電子音",
    "say": "Ganho: vidro."
  },
  "zq39a28": {
    "text": "Areia de quartzo, forno bem quente…",
    "emotion": "壓低聲音嘀咕",
    "say": "Quartzo, forno quente…"
  },
  "zq39a29": {
    "text": "Guardo por enquanto.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "Mano…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "Baixou!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "Não tá quente!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "Baixou?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "Baixou, já não tem perigo.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "No dia que o mano caiu,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "eu vi alguém empurrar.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "Quem?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "Chapéu de palha, fita vermelha,",
    "emotion": "比著自己的頭",
    "say": "Chapéu, fita vermelha,"
  },
  "zq39a39": {
    "text": "não vi o rosto.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "Fita vermelha…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "O portão lateral dos Qian.",
    "emotion": "畫外，低聲",
    "say": "O portão dos Qian."
  },
  "zq39a42": {
    "text": "Xu Yan, lá no celeiro,",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "não dá mais pra segurar.",
    "emotion": "急",
    "say": "não segura mais."
  },
  "zq39a44": {
    "text": "Diao Qi?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "Esperem o Letrado Xu!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "Se tem coragem, faz.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "Parem!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "Fui eu que peguei,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "não cabe a vocês.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "O Letrado Xu de Liuxi?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "A vila quer uma resposta dele.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "Fica, ou entrego pra eles?",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "Fala, letrado.",
    "emotion": "畫外，挑釁"
  }
}
