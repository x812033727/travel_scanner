{
  "zq39a01": {
    "text": "下ろせ！",
    "emotion": "披著外衫衝出來，一聲喝住"
  },
  "zq39a02": {
    "text": "診てもらいに来たんだ！",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "妹が一晩中、熱で、",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "先生、助けて。",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "柳渓？一時間か、",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "わしは馬に乗れん。",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "乗れなくていい。",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "つかまって。",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "追ってくる！",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "後ろに兵が！",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "ゆ、ゆっくり！",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "目を閉じて、",
    "emotion": "淡淡的",
    "say": "閉じて、"
  },
  "zq39a13": {
    "text": "百まで数えて。",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "九十八、",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "九十九……",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "シャオホー、もう少しだ。",
    "emotion": "整夜沒睡，聲音啞"
  },
  "zq39a17": {
    "text": "アーリン？",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "病人はどこだ？",
    "emotion": "一進門就問，喘"
  },
  "zq39a19": {
    "text": "熱が続きすぎた、",
    "emotion": "搭著脈，眉頭緊"
  },
  "zq39a20": {
    "text": "まず熱を下げる。",
    "emotion": "句句有把握"
  },
  "zq39a21": {
    "text": "一気に飲ませろ。",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "いい子だ、飲めば楽になる。",
    "emotion": "哄著",
    "say": "飲めば楽になる。"
  },
  "zq39a23": {
    "text": "夜明けまでに下がるか見よう。",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "私が見てる。",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "アーリン、好感プラス十二。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq39a26": {
    "text": "好感五十、報酬箱、開封。",
    "emotion": "平板電子音，叮一聲",
    "say": "五十、報酬箱開封。"
  },
  "zq39a27": {
    "text": "獲得：ガラス製法。",
    "emotion": "平板電子音"
  },
  "zq39a28": {
    "text": "石英砂、高温の窯……",
    "emotion": "壓低聲音嘀咕",
    "say": "石英砂、窯……"
  },
  "zq39a29": {
    "text": "しまっておくか。",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "お兄ちゃん……",
    "emotion": "奶聲奶氣，剛醒",
    "say": "兄ちゃん……"
  },
  "zq39a31": {
    "text": "下がった！",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "熱くない！",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "下がった？",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "下がれば、もう大丈夫じゃ。",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "お兄ちゃんが落ちた日、",
    "emotion": "小小聲",
    "say": "兄ちゃんが落ちた日、"
  },
  "zq39a36": {
    "text": "誰かが押すのを見た。",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "誰？",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "麦わら帽、赤い紐、",
    "emotion": "比著自己的頭"
  },
  "zq39a39": {
    "text": "顔は見てない。",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "赤い紐……",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "チエン家の通用門。",
    "emotion": "畫外，低聲"
  },
  "zq39a42": {
    "text": "シュー・イェン、穀倉が、",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "もう抑えきれない。",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "ディアオ・チー？",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "シュー秀才を待て！",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "やれるならやってみろ。",
    "emotion": "粗啞兇狠",
    "say": "やってみろ。"
  },
  "zq39a47": {
    "text": "やめろ！",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "捕らえたのは私だ、",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "勝手に手を出すな。",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "柳渓のシュー秀才か？",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "村は秀才の答えを待っとる。",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "生かすか、引き渡すか。",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "秀才、決めな。",
    "emotion": "畫外，挑釁"
  }
}
