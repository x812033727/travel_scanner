{
  "zq39a01": {
    "text": "¡Bajen las armas!",
    "emotion": "披著外衫衝出來，一聲喝住",
    "say": "¡Alto!"
  },
  "zq39a02": {
    "text": "¡Viene por un médico!",
    "emotion": "老大夫，句句有把握"
  },
  "zq39a03": {
    "text": "Mi hermana arde desde anoche,",
    "emotion": "喘著，聲音很輕"
  },
  "zq39a04": {
    "text": "Doctor, sálvela.",
    "emotion": "一字一字"
  },
  "zq39a05": {
    "text": "¿Liuxi? Una hora,",
    "emotion": "皺眉"
  },
  "zq39a06": {
    "text": "y yo no sé montar.",
    "emotion": "拍著自己的腿"
  },
  "zq39a07": {
    "text": "No hace falta.",
    "emotion": "冷得像井水"
  },
  "zq39a08": {
    "text": "Agárrese.",
    "emotion": "畫外，短短一句"
  },
  "zq39a09": {
    "text": "¡Nos alcanzan!",
    "emotion": "畫外，喊得發抖"
  },
  "zq39a10": {
    "text": "¡Soldados atrás!",
    "emotion": "畫外"
  },
  "zq39a11": {
    "text": "¡Más, más despacio!",
    "emotion": "眼睛閉著，聲音抖"
  },
  "zq39a12": {
    "text": "Cierre los ojos,",
    "emotion": "淡淡的"
  },
  "zq39a13": {
    "text": "cuente hasta cien.",
    "emotion": "一夾馬腹"
  },
  "zq39a14": {
    "text": "Noventa y ocho,",
    "emotion": "閉著眼數"
  },
  "zq39a15": {
    "text": "Noventa y nueve…",
    "emotion": "睜開一隻眼，數不下去"
  },
  "zq39a16": {
    "text": "Xiaohe, aguanta un poco más.",
    "emotion": "整夜沒睡，聲音啞",
    "say": "Aguanta, Xiaohe."
  },
  "zq39a17": {
    "text": "¿A-Ling?",
    "emotion": "聽見馬蹄聲，猛地抬頭"
  },
  "zq39a18": {
    "text": "¿Dónde está la enferma?",
    "emotion": "一進門就問，喘",
    "say": "¿Y la enferma?"
  },
  "zq39a19": {
    "text": "Ardió demasiado tiempo,",
    "emotion": "搭著脈，眉頭緊",
    "say": "Ardió demasiado,"
  },
  "zq39a20": {
    "text": "primero, la fiebre.",
    "emotion": "句句有把握"
  },
  "zq39a21": {
    "text": "Que se lo tome todo.",
    "emotion": "畫外"
  },
  "zq39a22": {
    "text": "Anda, tómatelo y se te pasa.",
    "emotion": "哄著",
    "say": "Tómatelo y se pasa."
  },
  "zq39a23": {
    "text": "Al alba veremos si baja.",
    "emotion": "慢而清楚"
  },
  "zq39a24": {
    "text": "Yo vigilo.",
    "emotion": "說完就睡著了"
  },
  "zq39a25": {
    "text": "A-Ling: afecto más doce.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling, más doce."
  },
  "zq39a26": {
    "text": "Afecto cincuenta: caja de recompensa abierta.",
    "emotion": "平板電子音，叮一聲",
    "say": "Cincuenta. Caja abierta."
  },
  "zq39a27": {
    "text": "Obtenido: técnica del vidrio.",
    "emotion": "平板電子音",
    "say": "Obtenido: vidrio."
  },
  "zq39a28": {
    "text": "Arena de cuarzo, horno de alta temperatura…",
    "emotion": "壓低聲音嘀咕",
    "say": "Cuarzo, un horno caliente…"
  },
  "zq39a29": {
    "text": "Lo guardo por ahora.",
    "emotion": "無奈地笑"
  },
  "zq39a30": {
    "text": "Hermano…",
    "emotion": "奶聲奶氣，剛醒"
  },
  "zq39a31": {
    "text": "¡Bajó!",
    "emotion": "一摸額頭，笑開"
  },
  "zq39a32": {
    "text": "¡Ya no quema!",
    "emotion": "抱起來"
  },
  "zq39a33": {
    "text": "¿Bajó?",
    "emotion": "剛醒，手摸到肩上的外衫"
  },
  "zq39a34": {
    "text": "Si bajó, ya no hay peligro.",
    "emotion": "蒼老清癯，有把握"
  },
  "zq39a35": {
    "text": "Cuando caíste al río,",
    "emotion": "小小聲"
  },
  "zq39a36": {
    "text": "vi que alguien te empujó.",
    "emotion": "抓著草兔子"
  },
  "zq39a37": {
    "text": "¿Quién?",
    "emotion": "笑容沒了"
  },
  "zq39a38": {
    "text": "Sombrero de paja, cordón rojo,",
    "emotion": "比著自己的頭",
    "say": "Sombrero, cordón rojo,"
  },
  "zq39a39": {
    "text": "no le vi la cara.",
    "emotion": "小聲"
  },
  "zq39a40": {
    "text": "Cordón rojo…",
    "emotion": "想起來了"
  },
  "zq39a41": {
    "text": "La puerta lateral de los Qian.",
    "emotion": "畫外，低聲",
    "say": "La puerta de los Qian."
  },
  "zq39a42": {
    "text": "Xu Yan, en el granero,",
    "emotion": "颯爽，直"
  },
  "zq39a43": {
    "text": "ya no los paramos.",
    "emotion": "急"
  },
  "zq39a44": {
    "text": "¿Diao Qi?",
    "emotion": "一下站直"
  },
  "zq39a45": {
    "text": "¡Esperen al letrado Xu!",
    "emotion": "蒼老但有分量"
  },
  "zq39a46": {
    "text": "Háganlo, si se atreven.",
    "emotion": "粗啞兇狠"
  },
  "zq39a47": {
    "text": "¡Alto!",
    "emotion": "畫外，喝"
  },
  "zq39a48": {
    "text": "Yo lo atrapé,",
    "emotion": "明亮的女聲，不屑"
  },
  "zq39a49": {
    "text": "no les toca a ustedes.",
    "emotion": "手按在刀上"
  },
  "zq39a50": {
    "text": "¿El letrado Xu de Liuxi?",
    "emotion": "冷笑"
  },
  "zq39a51": {
    "text": "El pueblo quiere que responda.",
    "emotion": "慢、篤定"
  },
  "zq39a52": {
    "text": "¿Lo dejamos, o se lo damos?",
    "emotion": "直，等他一句話"
  },
  "zq39a53": {
    "text": "Tú dirás, letrado.",
    "emotion": "畫外，挑釁"
  }
}
