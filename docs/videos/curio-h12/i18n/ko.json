  "lines": {
    "jjr5": {
      "source_hash": "2c7098e7b781",
      "text": "1900년 12월 26일, 플래넌 제도."
    },
    "ht63": {
      "source_hash": "8452c8853a81",
      "text": "교대자 무어가 보급선으로 왔다. 평소 깃발은 없었다."
    },
    "a2ec": {
      "source_hash": "fbea0313748f",
      "text": "뱃고동을 몇 번 울려도 답은 없었다."
    },
    "xng2": {
      "source_hash": "2e1d8a258414",
      "text": "선장이 로켓도 쐈지만 등대는 조용했다."
    },
    "3nwg": {
      "source_hash": "928f89bf5d6d",
      "text": "이틀 뒤 무어는 상륙 과정을 편지로 썼다."
    },
    "q7ay": {
      "source_hash": "b23e5cb716fc",
      "text": "사흘 뒤 감독관은 서쪽 선착장을 살폈다."
    },
    "i73f": {
      "source_hash": "99ec8a85f812",
      "text": "훗날 다른 글엔 등대 안 식탁이 나왔다."
    },
    "kxdb": {
      "source_hash": "eebfebceba86",
      "text": "무어는 뭘 봤나? 그 장면은 누가 썼나?"
    },
    "xf7d": {
      "source_hash": "14244bf75516",
      "text": "동쪽 선착장에 무어가 먼저 내렸다."
    },
    "874p": {
      "source_hash": "2d687cba9b6a",
      "text": "동료들은 배에 남아 무어의 보고를 기다렸다."
    },
    "448s": {
      "source_hash": "b144d412154e",
      "text": "무어는 등대 밖에서도 근무자를 못 봤다고 썼다."
    },
    "sspt": {
      "source_hash": "da18e0c79ec0",
      "text": "뜰문과 바깥문은 닫혀 있었다. 안에서 잠겼단 말은 없다."
    },
    "4pa4": {
      "source_hash": "45f431f8471d",
      "text": "안쪽 부엌문은 열려 있었다."
    },
    "5udf": {
      "source_hash": "f7cf1ff02b14",
      "text": "무어는 난로가 며칠째 꺼졌다고 봤다."
    },
    "pec2": {
      "source_hash": "bb56242ecbe4",
      "text": "방마다 살폈지만 침대엔 아무도 없었다."
    },
    "iima": {
      "source_hash": "187028e858d0",
      "text": "그는 곧장 몸을 돌려 선착장으로 뛰었다."
    },
    "t4yn": {
      "source_hash": "d9d795a589ce",
      "text": "배로 돌아온 그는 동료에게 숙소가 텅 비었다고 알렸다."
    },
    "ek7h": {
      "source_hash": "609bf4c2fdc8",
      "text": "동료 한 명이 그와 다시 올라가 집을 살폈다."
    },
    "fkmm": {
      "source_hash": "ce5f9ba33db8",
      "text": "그럼 등실에는 무엇이 남아 있었을까?"
    },
    "cyaq": {
      "source_hash": "0fff9b9e44bd",
      "text": "등은 손질됐고 기름통도 가득 찼다."
    },
    "anms": {
      "source_hash": "4626c2e0fa17",
      "text": "실종자는 듀컷, 마셜, 맥아더였다."
    },
    "v7kk": {
      "source_hash": "f070aed1fe55",
      "text": "한 근무자가 병가 중이라 맥아더가 대신 왔다."
    },
    "c8s2": {
      "source_hash": "fbb5e1a95b5f",
      "text": "소식을 들은 선장은 섬에 남겠다는 사람을 구했다."
    },
    "bkys": {
      "source_hash": "f853c4f55961",
      "text": "그날 밤 무어와 동료가 다시 불을 밝혔다."
    },
    "njtt": {
      "source_hash": "3963bdaa5b85",
      "text": "섬을 뒤졌지만 세 사람은 못 찾았다."
    },
    "z4u3": {
      "source_hash": "13cda4779621",
      "text": "무어는 맥아더의 외투가 숙소에 남았다고 썼다. 이 외투로 누가 먼저 나갔는지 알 수 있을까?"
    },
    "7tig": {
      "source_hash": "5e2747b8f906",
      "text": "다른 두 사람의 장화와 방수 외투는 없었다."
    },
    "phjr": {
      "source_hash": "2add0cde6ff7",
      "text": "무어는 동료들의 외출 복장을 알아서 이 점이 중요했다."
    },
    "m6gi": {
      "source_hash": "77ee9bfc7231",
      "text": "그 장비는 부두 근처에 갈 때만 입는다고 했다."
    },
    "3w38": {
      "source_hash": "6558a4c36e94",
      "text": "맥아더가 외투를 안 입은 이유도, 세 사람의 외출 순서도 기록엔 없다."
    },
    "h8mk": {
      "source_hash": "3e035ec657bb",
      "text": "무어의 편지는 마친 일을 적었다. 보고서는 시간을 이을까?"
    },
    "cuxc": {
      "source_hash": "f9883147c8fc",
      "text": "보고서엔 편지에 없는 석판과 미처 옮기지 않은 관측이 나온다."
    },
    "s7pw": {
      "source_hash": "e29b675e0b21",
      "text": "일지의 마지막 기록은 12월 13일."
    },
    "s4hn": {
      "source_hash": "34c3f0e24347",
      "text": "시계가 멈췄다는 보고도 있지만 날짜는 알 수 없다."
    },
    "fgbf": {
      "source_hash": "fa38cc3b7dcc",
      "text": "하지만 이후의 수치는 석판에 남아 있었다."
    },
    "ey9a": {
      "source_hash": "b5f78a442dbd",
      "text": "15일 오전 9시의 기압, 기온, 바람도 적혀 있다."
    },
    "yt2k": {
      "source_hash": "f9d271c30608",
      "text": "등을 끈 아침 시각도 남았다."
    },
    "37tf": {
      "source_hash": "6f76ee04c4fa",
      "text": "솥은 씻겼고 부엌도 정돈됐다."
    },
    "igw7": {
      "source_hash": "66261d8bd880",
      "text": "이 일로 실종은 그날 오후라고 추정했다."
    },
    "7zvf": {
      "source_hash": "1506deb5316b",
      "text": "일의 흔적으로 추론했을 뿐, 마지막 목격자는 없다."
    },
    "x5ik": {
      "source_hash": "c1b7e292cbdf",
      "text": "지나던 배도 15일 자정에 불을 못 봤다고 했다."
    },
    "ds8v": {
      "source_hash": "991f84adc87d",
      "text": "뮤어헤드는 보고서에 실종 발견 뒤에야 등대국에 소식이 왔다고 썼다."
    },
    "3tt3": {
      "source_hash": "d48789dd7143",
      "text": "육지에서도 매일 밤 등불 가시성을 적었다."
    },
    "nxpd": {
      "source_hash": "a268d623a468",
      "text": "바다 너머 불이 안 보이면 꺼진 걸까?"
    },
    "k8sw": {
      "source_hash": "b5533d831e4a",
      "text": "감독관은 육지에서 망보던 두 소년에게 뭘 봤는지 물었다."
    },
    "szic": {
      "source_hash": "ef7fa0e2d460",
      "text": "육지 기록엔 불이 안 보인 밤이 이미 있었다."
    },
    "s9zp": {
      "source_hash": "bf951578683f",
      "text": "악천후로 4~5일 연속 못 본 적도 있었다."
    },
    "ufsf": {
      "source_hash": "6e11a8d42a04",
      "text": "배의 통보와 육지 기록은 따로 봐야 한다."
    },
    "r3ds": {
      "source_hash": "3183b2f66155",
      "text": "시간은 좁혀졌다. 세 사람은 섬 어디로 갔을까?"
    },
    "s7g4": {
      "source_hash": "6648167d5b3a",
      "text": "29일 뮤어헤드가 직접 섬에 올라 조사했다."
    },
    "qj6q": {
      "source_hash": "ea6660220638",
      "text": "동쪽 밧줄 모두 지난 교대 때 그대로였다."
    },
    "8hj7": {
      "source_hash": "fad09349924f",
      "text": "서쪽의 피해는 동쪽과 전혀 달랐다."
    },
    "ijjn": {
      "source_hash": "06d47ead572b",
      "text": "파도에 부두로 못 가 기중기 발판까지만 갔다."
    },
    "y4ag": {
      "source_hash": "9ce255673813",
      "text": "그 발판은 해수면 위 70피트였다."
    },
    "tvjn": {
      "source_hash": "d17c319c3265",
      "text": "밧줄 상자는 더 높은 바위틈에 있었다."
    },
    "dwtd": {
      "source_hash": "e8a6344f9640",
      "text": "상자엔 계류·상륙용 밧줄과 기중기 손잡이가 있었다."
    },
    "madp": {
      "source_hash": "84aefd1c2f6b",
      "text": "상자는 해수면 약 110피트 위였다."
    },
    "efzu": {
      "source_hash": "22a535f757fe",
      "text": "그건 시설 높이지, 측정된 파고가 아니다."
    },
    "dfa9": {
      "source_hash": "9f8eabec8036",
      "text": "상자는 없고 밧줄은 바위틈과 기중기 곁에 있었다."
    },
    "gqqh": {
      "source_hash": "c896aefca704",
      "text": "실종 당일 그 밧줄을 썼을까?"
    },
    "a83d": {
      "source_hash": "3b5918eb794d",
      "text": "조사 때 밧줄은 모두 감겨 있었고 풀린 묶음도 없었다. 그건 조사 때 상태일 뿐 실종 당일 누가 썼는지는 모른다."
    },
    "vn6y": {
      "source_hash": "19b2e5aabd6b",
      "text": "지난겨울 옛 기중기가 쓸려갔다."
    },
    "eskw": {
      "source_hash": "2a597e9b976a",
      "text": "이번 기중기는 멀쩡했고 팔은 내려 바위에 고정됐다."
    },
    "dvmg": {
      "source_hash": "dc168adeb71d",
      "text": "드럼 덮개도 묶여 있어 조작 중인 모습은 아니었다."
    },
    "wc2e": {
      "source_hash": "b1ffe2b4cd9a",
      "text": "그러나 발판과 통로의 철제 난간은 뒤틀렸다."
    },
    "anru": {
      "source_hash": "d79af4265c90",
      "text": "높은 곳의 큰 바위까지 아래 통로로 옮겨졌다."
    },
    "2d4b": {
      "source_hash": "78674232b5a9",
      "text": "영국식 20헌드레드웨이트 초과, 약 1톤."
    },
    "rvc2": {
      "source_hash": "b9a1f84dddca",
      "text": "난간에 묶인 구명환도 없었다. 구조에 썼을까?"
    },
    "cbd8": {
      "source_hash": "75f87b977a37",
      "text": "구명환 난간은 상자가 있던 바위틈쯤 높이였다."
    },
    "q5ct": {
      "source_hash": "985d1af2951f",
      "text": "뮤어헤드는 매듭이 안 풀렸고 캔버스 조각이 붙은 걸 봤다."
    },
    "i3cg": {
      "source_hash": "69e43bfa32d6",
      "text": "그래서 바다가 구명환을 뜯어냈다고 판단했다."
    },
    "7nu6": {
      "source_hash": "d8bdcf4c62a6",
      "text": "서쪽 피해가 최후를 설명할까?"
    },
    "ecsy": {
      "source_hash": "2a744eedb8de",
      "text": "1901년 1월 8일, 그는 가장 그럴듯한 설명을 썼다."
    },
    "e5pv": {
      "source_hash": "009c5aa548bc",
      "text": "그는 세 사람이 밧줄 상자 등 장비를 지키러 서쪽에 갔다고 봤다."
    },
    "ek4w": {
      "source_hash": "d3726877f4e2",
      "text": "그때 갑자기 큰 파도가 서 있던 곳을 덮쳤다."
    },
    "9jra": {
      "source_hash": "abdc1e217b1a",
      "text": "빠지는 물이 셋을 휩쓸었다고 봤다."
    },
    "6xq2": {
      "source_hash": "cf07311e9418",
      "text": "이는 피해에 근거한 사고 추정이다. 그 순간은 입증할 수 없다."
    },
    "v7k5": {
      "source_hash": "a2e83fd41508",
      "text": "강풍에 사람이 날아갔을지도 풍향으로 살폈다."
    },
    "e8ux": {
      "source_hash": "d7154afa12e9",
      "text": "서풍이면 섬의 높은 쪽으로 밀린다."
    },
    "33cn": {
      "source_hash": "bf55538ccde8",
      "text": "그 경우엔 절벽 전에 엎드릴 수 있다고 봤다."
    },
    "hpye": {
      "source_hash": "245144f4880b",
      "text": "그 풍향은 바다로 날아갔다는 설과 안 맞았다."
    },
    "e2rt": {
      "source_hash": "c79841711a48",
      "text": "훗날 다른 작가가 빈집에 새 세부를 보탰다."
    },
    "i9ud": {
      "source_hash": "5fca928ae510",
      "text": "도입부의 글은 1912년 출판된 깁슨 시집의 등대시다."
    },
    "jreq": {
      "source_hash": "516312302076",
      "text": "시의 식탁엔 손대지 않은 음식."
    },
    "uedh": {
      "source_hash": "10e8b89f4f68",
      "text": "같은 대목엔 넘어진 의자도 있다."
    },
    "tbuz": {
      "source_hash": "3dbe023b272e",
      "text": "시는 급히 떠난 장면을 떠올리게 한다. 당시 기록도 그랬을까?"
    },
    "wdik": {
      "source_hash": "b250510609f0",
      "text": "무어의 편지엔 음식도 뒤집힌 의자도 없다."
    },
    "dt4e": {
      "source_hash": "b1bb87166343",
      "text": "부엌이 정돈됐다는 기록으로 마지막 식사를 알 순 없다."
    },
    "2kc7": {
      "source_hash": "314cc5cd7032",
      "text": "무어의 원본 편지가 남아 후대 시와 나란히 볼 수 있다."
    },
    "3ncp": {
      "source_hash": "4482c11a7e97",
      "text": "2026년 스코틀랜드 국립기록원, 무어 원본 첫 전시."
    },
    "qv4y": {
      "source_hash": "ea66b045a7a0",
      "text": "미해결은 세 사람의 최후다. 이후 세부는 일부 확인됐다."
    },
    "r5bz": {
      "source_hash": "d92510c0f9a7",
      "text": "들은 얘긴 뭘 더했나?"
    },
    "wpvq": {
      "source_hash": "03b0e4351b99",
