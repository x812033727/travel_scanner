{
  "zq49a01": {
    "text": "第八十位——",
    "emotion": "大聲，快，說完就停",
    "say": "八十位——"
  },
  "zq49a02": {
    "text": "青州、チェン・ダーヨウ！",
    "emotion": "唱名"
  },
  "zq49a03": {
    "text": "最下位から",
    "emotion": "踮腳"
  },
  "zq49a04": {
    "text": "読み上げるの？",
    "emotion": "急",
    "say": "読むの？"
  },
  "zq49a05": {
    "text": "八十人分、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "八十人、"
  },
  "zq49a06": {
    "text": "気長に待とう。",
    "emotion": "吞口水",
    "say": "待とう。"
  },
  "zq49a07": {
    "text": "おや、",
    "emotion": "拖長音"
  },
  "zq49a08": {
    "text": "シュー秀才も合格発表の見物かね？",
    "emotion": "假笑",
    "say": "シュー秀才も見物かね？"
  },
  "zq49a09": {
    "text": "あいつが受かったら、",
    "emotion": "大聲，讓人都聽見",
    "say": "受かったら、"
  },
  "zq49a10": {
    "text": "後ろ向きに歩いてやる！",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "後ろ歩きだ！"
  },
  "zq49a11": {
    "text": "旦那、",
    "emotion": "笑嘻嘻"
  },
  "zq49a12": {
    "text": "先に靴紐を締めときな。",
    "emotion": "指他的鞋",
    "say": "紐締めな。"
  },
  "zq49a13": {
    "text": "約束ね、",
    "emotion": "甜甜一笑",
    "say": "約束、"
  },
  "zq49a14": {
    "text": "通り一本、後ろ向きでね。",
    "emotion": "眨眼",
    "say": "通り一本ね。"
  },
  "zq49a15": {
    "text": "みんな聞いたわよ。",
    "emotion": "冷，嘴角一勾",
    "say": "聞いたわよ。"
  },
  "zq49a16": {
    "text": "消されたのは……",
    "emotion": "瞇眼看",
    "say": "消したのは……"
  },
  "zq49a17": {
    "text": "フォン学正！",
    "emotion": "笑出來"
  },
  "zq49a18": {
    "text": "か、考官を一人消したくらい、",
    "emotion": "笑僵了",
    "say": "か、一人消えたくらい、"
  },
  "zq49a19": {
    "text": "何だってんだ。",
    "emotion": "嘴硬",
    "say": "何だ。"
  },
  "zq49a20": {
    "text": "考官は消えた、",
    "emotion": "低聲，快，說完就停",
    "say": "消えた、"
  },
  "zq49a21": {
    "text": "名簿は？",
    "emotion": "笑收起來"
  },
  "zq49a22": {
    "text": "第十位——",
    "emotion": "拖長"
  },
  "zq49a23": {
    "text": "州城、リン・シーアン！",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "第三位——",
    "emotion": "更響"
  },
  "zq49a25": {
    "text": "青州、リー・ショウジョン！",
    "emotion": "唱名"
  },
  "zq49a26": {
    "text": "第二位——",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "第二！"
  },
  "zq49a27": {
    "text": "州城、チャオ・ウェンユエン！",
    "emotion": "唱名"
  },
  "zq49a28": {
    "text": "はっはっは！",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "三位以内にもいないぞ！",
    "emotion": "得意忘形",
    "say": "三位にもいない！"
  },
  "zq49a30": {
    "text": "早く読んでよ……",
    "emotion": "小小聲，快哭了",
    "say": "早く……"
  },
  "zq49a31": {
    "text": "緊張しないの？",
    "emotion": "壓低聲音",
    "say": "平気？"
  },
  "zq49a32": {
    "text": "してる。",
    "emotion": "老實",
    "say": "うん。"
  },
  "zq49a33": {
    "text": "手のひら、汗だくだ。",
    "emotion": "苦笑",
    "say": "汗だくだ。"
  },
  "zq49a34": {
    "text": "解元——",
    "emotion": "停一拍，最響"
  },
  "zq49a35": {
    "text": "清水県柳渓、",
    "emotion": "畫外，一字一字"
  },
  "zq49a36": {
    "text": "シュー・イェン！",
    "emotion": "畫外，炸開"
  },
  "zq49a37": {
    "text": "……俺？",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "受かった！",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "やった！"
  },
  "zq49a39": {
    "text": "解元よ！",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "解元！"
  },
  "zq49a40": {
    "text": "わかってた。",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "郷試ミッション完了。",
    "emotion": "平板電子音，快，說完就停",
    "say": "郷試、完了。"
  },
  "zq49a42": {
    "text": "報酬：活字印刷。",
    "emotion": "平板電子音"
  },
  "zq49a43": {
    "text": "活字か……",
    "emotion": "自言自語"
  },
  "zq49a44": {
    "text": "彫り師を探さないと。",
    "emotion": "撓頭",
    "say": "彫り師が要る。"
  },
  "zq49a45": {
    "text": "通して……",
    "emotion": "低聲，快，說完就停",
    "say": "失礼"
  },
  "zq49a46": {
    "text": "通して……",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "まだ半分よ、",
    "emotion": "甜，快，說完就停",
    "say": "まだ半分、"
  },
  "zq49a48": {
    "text": "旦那、がんばって！",
    "emotion": "揮手",
    "say": "がんばって！"
  },
  "zq49a49": {
    "text": "わ、わしは……",
    "emotion": "漲紅臉",
    "say": "わしは……"
  },
  "zq49a50": {
    "text": "歩けばいいんだろ！",
    "emotion": "咬牙"
  },
  "zq49a51": {
    "text": "通り一本、",
    "emotion": "冷，快，說完就停",
    "say": "端まで、"
  },
  "zq49a52": {
    "text": "一歩も欠かさずにね。",
    "emotion": "冷冷地笑",
    "say": "一歩も欠かさず。"
  },
  "zq49a53": {
    "text": "皆さん、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "皆、"
  },
  "zq49a54": {
    "text": "めでたい、めでたい！",
    "emotion": "拱手",
    "say": "めでたい！"
  },
  "zq49a55": {
    "text": "シュー・イェン——",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "こっち！",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "どうした？",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "今夜、",
    "emotion": "仰頭，聲音很輕"
  },
  "zq49a59": {
    "text": "話があるの。",
    "emotion": "眼睛濕了"
  }
}
