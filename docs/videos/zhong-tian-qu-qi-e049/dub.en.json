{
  "zq49a01": {
    "text": "Eightieth place—",
    "emotion": "宏亮，拖長音"
  },
  "zq49a02": {
    "text": "Chen Dayou, of Qingzhou!",
    "emotion": "唱名"
  },
  "zq49a03": {
    "text": "Starting from last place",
    "emotion": "踮腳",
    "say": "From the bottom"
  },
  "zq49a04": {
    "text": "and reading up?",
    "emotion": "急",
    "say": "up?"
  },
  "zq49a05": {
    "text": "Eighty names,",
    "emotion": "故作輕鬆"
  },
  "zq49a06": {
    "text": "we just wait it out.",
    "emotion": "吞口水",
    "say": "we wait it out."
  },
  "zq49a07": {
    "text": "Well,",
    "emotion": "拖長音"
  },
  "zq49a08": {
    "text": "Scholar Xu came to see the list too?",
    "emotion": "假笑"
  },
  "zq49a09": {
    "text": "If he passes,",
    "emotion": "大聲，讓人都聽見"
  },
  "zq49a10": {
    "text": "I'll walk backwards!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "I walk backward!"
  },
  "zq49a11": {
    "text": "Squire,",
    "emotion": "笑嘻嘻"
  },
  "zq49a12": {
    "text": "lace your shoes up tight first.",
    "emotion": "指他的鞋",
    "say": "lace up tight."
  },
  "zq49a13": {
    "text": "It's a deal,",
    "emotion": "甜甜一笑",
    "say": "Deal,"
  },
  "zq49a14": {
    "text": "backwards down a whole street.",
    "emotion": "眨眼",
    "say": "a whole street, backwards."
  },
  "zq49a15": {
    "text": "Everyone heard that.",
    "emotion": "冷，嘴角一勾"
  },
  "zq49a16": {
    "text": "The name struck out is…",
    "emotion": "瞇眼看",
    "say": "They struck…"
  },
  "zq49a17": {
    "text": "Examiner Feng!",
    "emotion": "笑出來"
  },
  "zq49a18": {
    "text": "S-so they struck off one examiner,",
    "emotion": "笑僵了"
  },
  "zq49a19": {
    "text": "so what.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "The examiner's struck off,",
    "emotion": "低聲，快，說完就停",
    "say": "Feng's out,"
  },
  "zq49a21": {
    "text": "but the list?",
    "emotion": "笑收起來"
  },
  "zq49a22": {
    "text": "Tenth place—",
    "emotion": "拖長"
  },
  "zq49a23": {
    "text": "Lin Shi'an, of the city!",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "Third place—",
    "emotion": "更響"
  },
  "zq49a25": {
    "text": "Li Shouzheng, of Qingzhou!",
    "emotion": "唱名"
  },
  "zq49a26": {
    "text": "Second place—",
    "emotion": "拖長"
  },
  "zq49a27": {
    "text": "Zhao Wenyuan, of the city!",
    "emotion": "唱名"
  },
  "zq49a28": {
    "text": "Ha ha ha!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "He's not even in the top three!",
    "emotion": "得意忘形"
  },
  "zq49a30": {
    "text": "Hurry up and read…",
    "emotion": "小小聲，快哭了"
  },
  "zq49a31": {
    "text": "Aren't you nervous?",
    "emotion": "壓低聲音",
    "say": "Not nervous?"
  },
  "zq49a32": {
    "text": "I am.",
    "emotion": "老實"
  },
  "zq49a33": {
    "text": "My palms are soaked.",
    "emotion": "苦笑"
  },
  "zq49a34": {
    "text": "Jieyuan—",
    "emotion": "停一拍，最響"
  },
  "zq49a35": {
    "text": "Liuxi, Qingshui County,",
    "emotion": "畫外，一字一字"
  },
  "zq49a36": {
    "text": "Xu Yan!",
    "emotion": "畫外，炸開"
  },
  "zq49a37": {
    "text": "…Me?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "You passed!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Passed!"
  },
  "zq49a39": {
    "text": "Jieyuan! First place!",
    "emotion": "抱住他手臂跳",
    "say": "Jieyuan!"
  },
  "zq49a40": {
    "text": "I knew it.",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "Provincial exam mission complete.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Exam mission complete."
  },
  "zq49a42": {
    "text": "Reward: movable-type printing.",
    "emotion": "平板電子音"
  },
  "zq49a43": {
    "text": "Movable type…",
    "emotion": "自言自語"
  },
  "zq49a44": {
    "text": "I'll have to find a type carver.",
    "emotion": "撓頭",
    "say": "Need a type carver."
  },
  "zq49a45": {
    "text": "Excuse me…",
    "emotion": "低聲，快，說完就停",
    "say": "Sorry…"
  },
  "zq49a46": {
    "text": "Excuse me…",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "Only halfway there,",
    "emotion": "笑得很甜",
    "say": "Just halfway,"
  },
  "zq49a48": {
    "text": "keep going, Squire!",
    "emotion": "揮手",
    "say": "go, Squire!"
  },
  "zq49a49": {
    "text": "I…",
    "emotion": "漲紅臉"
  },
  "zq49a50": {
    "text": "I'll walk it, all right!",
    "emotion": "咬牙"
  },
  "zq49a51": {
    "text": "The whole street,",
    "emotion": "抱胸",
    "say": "Whole street,"
  },
  "zq49a52": {
    "text": "not one step short.",
    "emotion": "冷冷地笑"
  },
  "zq49a53": {
    "text": "Everyone,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Folks,"
  },
  "zq49a54": {
    "text": "share the joy!",
    "emotion": "拱手"
  },
  "zq49a55": {
    "text": "Xu Yan!",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "Over here!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "What is it?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "Tonight,",
    "emotion": "仰頭，聲音很輕"
  },
  "zq49a59": {
    "text": "I have something to tell you.",
    "emotion": "眼睛濕了",
    "say": "We need to talk."
  }
}
