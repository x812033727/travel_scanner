{
  "zq49a01": {
    "text": "팔십 등——",
    "emotion": "宏亮，拖長音"
  },
  "zq49a02": {
    "text": "청주, 천다유!",
    "emotion": "唱名"
  },
  "zq49a03": {
    "text": "꼴찌부터",
    "emotion": "踮腳"
  },
  "zq49a04": {
    "text": "읽는 거야?",
    "emotion": "急",
    "say": "읽어?"
  },
  "zq49a05": {
    "text": "이름이 팔십 개,",
    "emotion": "故作輕鬆",
    "say": "팔십 명,"
  },
  "zq49a06": {
    "text": "천천히 기다리지 뭐.",
    "emotion": "吞口水",
    "say": "기다리지 뭐."
  },
  "zq49a07": {
    "text": "어이,",
    "emotion": "拖長音"
  },
  "zq49a08": {
    "text": "쉬 수재도 방 보러 왔나?",
    "emotion": "假笑"
  },
  "zq49a09": {
    "text": "저놈이 붙으면,",
    "emotion": "大聲，讓人都聽見",
    "say": "붙으면,"
  },
  "zq49a10": {
    "text": "내가 거꾸로 걷겠네!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "거꾸로 걷지!"
  },
  "zq49a11": {
    "text": "나리,",
    "emotion": "笑嘻嘻"
  },
  "zq49a12": {
    "text": "신발 끈부터 꽉 매시죠.",
    "emotion": "指他的鞋",
    "say": "끈부터 매요."
  },
  "zq49a13": {
    "text": "약속했어요,",
    "emotion": "甜甜一笑",
    "say": "약속,"
  },
  "zq49a14": {
    "text": "거리 하나를 거꾸로요.",
    "emotion": "眨眼",
    "say": "거리 하나요."
  },
  "zq49a15": {
    "text": "다들 들었어.",
    "emotion": "冷，嘴角一勾"
  },
  "zq49a16": {
    "text": "그어진 건……",
    "emotion": "瞇眼看",
    "say": "지운 건……"
  },
  "zq49a17": {
    "text": "펑 학정!",
    "emotion": "笑出來"
  },
  "zq49a18": {
    "text": "시, 시험관 하나 지웠다고,",
    "emotion": "僵硬，快，說完就停",
    "say": "하, 하나 지운 걸로,"
  },
  "zq49a19": {
    "text": "뭐 어때서.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "시험관은 지워졌고,",
    "emotion": "低聲，快，說完就停",
    "say": "지웠고,"
  },
  "zq49a21": {
    "text": "방은?",
    "emotion": "笑收起來"
  },
  "zq49a22": {
    "text": "십 등——",
    "emotion": "拖長"
  },
  "zq49a23": {
    "text": "주성, 린스안!",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "삼 등——",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "삼등!"
  },
  "zq49a25": {
    "text": "청주, 리서우정!",
    "emotion": "唱名"
  },
  "zq49a26": {
    "text": "이 등——",
    "emotion": "大聲，快，說完就停",
    "say": "이 등!"
  },
  "zq49a27": {
    "text": "주성, 자오원위안!",
    "emotion": "唱名"
  },
  "zq49a28": {
    "text": "하하하!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "삼 등 안에도 없잖아!",
    "emotion": "得意忘形"
  },
  "zq49a30": {
    "text": "빨리 읽어요……",
    "emotion": "小小聲，快哭了",
    "say": "빨리……"
  },
  "zq49a31": {
    "text": "안 떨려?",
    "emotion": "壓低聲音"
  },
  "zq49a32": {
    "text": "떨려.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "응."
  },
  "zq49a33": {
    "text": "손바닥이 땀범벅이야.",
    "emotion": "苦笑",
    "say": "손이 땀범벅이야."
  },
  "zq49a34": {
    "text": "해원——",
    "emotion": "停一拍，最響"
  },
  "zq49a35": {
    "text": "청수현 류시,",
    "emotion": "畫外，一字一字"
  },
  "zq49a36": {
    "text": "쉬옌!",
    "emotion": "畫外，炸開"
  },
  "zq49a37": {
    "text": "……나?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "붙었어!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "됐다!"
  },
  "zq49a39": {
    "text": "해원이야!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "해원!"
  },
  "zq49a40": {
    "text": "알고 있었어.",
    "emotion": "嘴角翹起來",
    "say": "알았어."
  },
  "zq49a41": {
    "text": "향시 임무 완료.",
    "emotion": "平板電子音，快，說完就停",
    "say": "향시 완료."
  },
  "zq49a42": {
    "text": "보상: 활자 인쇄.",
    "emotion": "平板電子音"
  },
  "zq49a43": {
    "text": "활자라……",
    "emotion": "自言自語"
  },
  "zq49a44": {
    "text": "각수를 찾아야겠네.",
    "emotion": "撓頭",
    "say": "각수가 필요해."
  },
  "zq49a45": {
    "text": "좀 지나갑시다……",
    "emotion": "低聲，快，說完就停",
    "say": "실례"
  },
  "zq49a46": {
    "text": "좀 지나갑시다……",
    "emotion": "小聲",
    "say": "실례……"
  },
  "zq49a47": {
    "text": "아직 반이에요,",
    "emotion": "甜，快，說完就停",
    "say": "반이에요,"
  },
  "zq49a48": {
    "text": "나리, 힘내요!",
    "emotion": "揮手",
    "say": "힘내요!"
  },
  "zq49a49": {
    "text": "나, 나는……",
    "emotion": "低聲，快，說完就停",
    "say": "나"
  },
  "zq49a50": {
    "text": "걸으면 될 거 아냐!",
    "emotion": "咬牙"
  },
  "zq49a51": {
    "text": "거리 하나,",
    "emotion": "冷，快，說完就停",
    "say": "끝까지,"
  },
  "zq49a52": {
    "text": "한 걸음도 빼지 말고.",
    "emotion": "冷冷地笑",
    "say": "한 걸음도 빼지 마."
  },
  "zq49a53": {
    "text": "여러분,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "다들,"
  },
  "zq49a54": {
    "text": "다 같이 기뻐합시다!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "경사요!"
  },
  "zq49a55": {
    "text": "쉬옌——",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "여기!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "왜 그래?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "오늘 밤,",
    "emotion": "輕聲，快，說完就停",
    "say": "오늘 밤,"
  },
  "zq49a59": {
    "text": "할 말이 있어.",
    "emotion": "眼睛濕了"
  }
}
