{
  "zq49a01": {
    "text": "Octogésimo lugar—",
    "emotion": "大聲，快，說完就停",
    "say": "Oitenta!"
  },
  "zq49a02": {
    "text": "Chen Dayou, de Qingzhou!",
    "emotion": "大聲，快，說完就停",
    "say": "Chen Dayou, Qingzhou!"
  },
  "zq49a03": {
    "text": "Começando do último",
    "emotion": "踮腳",
    "say": "Do último"
  },
  "zq49a04": {
    "text": "para cima?",
    "emotion": "急",
    "say": "pra cima?"
  },
  "zq49a05": {
    "text": "Oitenta nomes,",
    "emotion": "故作輕鬆",
    "say": "Oitenta,"
  },
  "zq49a06": {
    "text": "é só esperar.",
    "emotion": "吞口水",
    "say": "é esperar."
  },
  "zq49a07": {
    "text": "Ora,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ora,"
  },
  "zq49a08": {
    "text": "O letrado Xu também veio ver a lista?",
    "emotion": "假笑"
  },
  "zq49a09": {
    "text": "Se ele passar,",
    "emotion": "大聲，讓人都聽見",
    "say": "Se passar,"
  },
  "zq49a10": {
    "text": "eu ando de costas!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ando de costas!"
  },
  "zq49a11": {
    "text": "Senhor Zhou,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Senhor,"
  },
  "zq49a12": {
    "text": "amarre bem os sapatos.",
    "emotion": "指他的鞋",
    "say": "amarre bem."
  },
  "zq49a13": {
    "text": "Combinado,",
    "emotion": "甜甜一笑",
    "say": "Fechado,"
  },
  "zq49a14": {
    "text": "de costas, a rua inteira.",
    "emotion": "眨眼",
    "say": "a rua inteira!"
  },
  "zq49a15": {
    "text": "Todo mundo ouviu.",
    "emotion": "冷，嘴角一勾"
  },
  "zq49a16": {
    "text": "O riscado é…",
    "emotion": "瞇眼看",
    "say": "Riscaram…"
  },
  "zq49a17": {
    "text": "o Examinador Feng!",
    "emotion": "笑出來",
    "say": "o Feng!"
  },
  "zq49a18": {
    "text": "R-riscar um examinador,",
    "emotion": "笑僵了"
  },
  "zq49a19": {
    "text": "não é nada.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "Riscaram o examinador,",
    "emotion": "低聲，快，說完就停",
    "say": "Feng caiu,"
  },
  "zq49a21": {
    "text": "e a lista?",
    "emotion": "笑收起來"
  },
  "zq49a22": {
    "text": "Décimo lugar—",
    "emotion": "拖長",
    "say": "Décimo!"
  },
  "zq49a23": {
    "text": "Lin Shi'an, da cidade!",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "Terceiro lugar—",
    "emotion": "大聲，快，說完就停",
    "say": "Terceiro!"
  },
  "zq49a25": {
    "text": "Li Shouzheng, de Qingzhou!",
    "emotion": "大聲，快，說完就停",
    "say": "Li Shouzheng, Qingzhou!"
  },
  "zq49a26": {
    "text": "Segundo lugar—",
    "emotion": "大聲，快，說完就停",
    "say": "Segundo!"
  },
  "zq49a27": {
    "text": "Zhao Wenyuan, da cidade!",
    "emotion": "唱名"
  },
  "zq49a28": {
    "text": "Ha ha ha!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "Nem entre os três primeiros!",
    "emotion": "得意忘形",
    "say": "Nem nos três!"
  },
  "zq49a30": {
    "text": "Lê logo, anda…",
    "emotion": "小小聲，快哭了",
    "say": "Lê logo…"
  },
  "zq49a31": {
    "text": "Não está nervoso?",
    "emotion": "壓低聲音",
    "say": "Nervoso?"
  },
  "zq49a32": {
    "text": "Estou.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tô."
  },
  "zq49a33": {
    "text": "Minhas mãos estão suando.",
    "emotion": "苦笑",
    "say": "Mãos suando."
  },
  "zq49a34": {
    "text": "O primeiro do exame—",
    "emotion": "大聲，快，說完就停",
    "say": "O primeiro—"
  },
  "zq49a35": {
    "text": "Liuxi, condado de Qingshui,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Liuxi, Qingshui,"
  },
  "zq49a36": {
    "text": "Xu Yan!",
    "emotion": "畫外，大聲，快，說完就停",
    "say": "Xu Yan!"
  },
  "zq49a37": {
    "text": "…Eu?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "Passou!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Passou!"
  },
  "zq49a39": {
    "text": "O primeiro!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Primeiro!"
  },
  "zq49a40": {
    "text": "Eu sabia.",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "Missão do exame provincial concluída.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Missão concluída."
  },
  "zq49a42": {
    "text": "Recompensa: impressão com tipos móveis.",
    "emotion": "平板電子音",
    "say": "Recompensa: tipos móveis."
  },
  "zq49a43": {
    "text": "Tipos móveis…",
    "emotion": "低聲，快，說完就停",
    "say": "Tipos móveis…"
  },
  "zq49a44": {
    "text": "preciso achar um gravador.",
    "emotion": "撓頭",
    "say": "falta um gravador."
  },
  "zq49a45": {
    "text": "Licença…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Licença"
  },
  "zq49a46": {
    "text": "Licença…",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "Só na metade,",
    "emotion": "甜，快，說完就停",
    "say": "Metade,"
  },
  "zq49a48": {
    "text": "força, Senhor Zhou!",
    "emotion": "揮手",
    "say": "força!"
  },
  "zq49a49": {
    "text": "Eu…",
    "emotion": "低聲，快，說完就停",
    "say": "Eu"
  },
  "zq49a50": {
    "text": "Tá bom, eu ando!",
    "emotion": "咬牙",
    "say": "Tá, eu ando!"
  },
  "zq49a51": {
    "text": "A rua toda,",
    "emotion": "冷，快，說完就停",
    "say": "Toda,"
  },
  "zq49a52": {
    "text": "nem um passo a menos.",
    "emotion": "冷冷地笑"
  },
  "zq49a53": {
    "text": "Pessoal,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Gente!"
  },
  "zq49a54": {
    "text": "alegria pra todos!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "que alegria!"
  },
  "zq49a55": {
    "text": "Xu Yan!",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "Aqui!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "O que foi?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "Esta noite,",
    "emotion": "輕聲，快，說完就停",
    "say": "Hoje,"
  },
  "zq49a59": {
    "text": "tenho algo pra te dizer.",
    "emotion": "眼睛濕了",
    "say": "quero te falar."
  }
}
