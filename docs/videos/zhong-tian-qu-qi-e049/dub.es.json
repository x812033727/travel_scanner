{
  "zq49a01": {
    "text": "Puesto ochenta—",
    "emotion": "大聲，快，說完就停",
    "say": "¡Ochenta!"
  },
  "zq49a02": {
    "text": "¡Chen Dayou, de Qingzhou!",
    "emotion": "唱名"
  },
  "zq49a03": {
    "text": "¿Desde el último",
    "emotion": "踮腳",
    "say": "¿Del último"
  },
  "zq49a04": {
    "text": "hacia arriba?",
    "emotion": "急",
    "say": "arriba?"
  },
  "zq49a05": {
    "text": "Ochenta nombres,",
    "emotion": "故作輕鬆",
    "say": "Ochenta,"
  },
  "zq49a06": {
    "text": "a esperar con calma.",
    "emotion": "吞口水",
    "say": "a esperar."
  },
  "zq49a07": {
    "text": "Vaya,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Vaya,"
  },
  "zq49a08": {
    "text": "¿El letrado Xu también vino a ver la lista?",
    "emotion": "假笑"
  },
  "zq49a09": {
    "text": "Si él aprueba,",
    "emotion": "大聲，讓人都聽見",
    "say": "Si aprueba,"
  },
  "zq49a10": {
    "text": "¡camino de espaldas!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡camino al revés!"
  },
  "zq49a11": {
    "text": "Don Zhou,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Don Zhou,"
  },
  "zq49a12": {
    "text": "amárrese bien los zapatos.",
    "emotion": "指他的鞋",
    "say": "amárrese."
  },
  "zq49a13": {
    "text": "Trato hecho,",
    "emotion": "甜甜一笑",
    "say": "Trato,"
  },
  "zq49a14": {
    "text": "de espaldas, toda una calle.",
    "emotion": "眨眼",
    "say": "¡toda una calle!"
  },
  "zq49a15": {
    "text": "Todos lo oyeron.",
    "emotion": "冷，嘴角一勾"
  },
  "zq49a16": {
    "text": "El tachado es…",
    "emotion": "瞇眼看",
    "say": "Tacharon…"
  },
  "zq49a17": {
    "text": "¡el examinador Feng!",
    "emotion": "笑出來",
    "say": "¡a Feng!"
  },
  "zq49a18": {
    "text": "T-tachar a un examinador,",
    "emotion": "笑僵了"
  },
  "zq49a19": {
    "text": "no es nada.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "Tacharon al examinador,",
    "emotion": "低聲，快，說完就停",
    "say": "Feng cayó,"
  },
  "zq49a21": {
    "text": "¿y la lista?",
    "emotion": "笑收起來"
  },
  "zq49a22": {
    "text": "Puesto diez—",
    "emotion": "拖長"
  },
  "zq49a23": {
    "text": "¡Lin Shi'an, de la ciudad!",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "Puesto tres—",
    "emotion": "大聲，快，說完就停",
    "say": "¡Tres!"
  },
  "zq49a25": {
    "text": "¡Li Shouzheng, de Qingzhou!",
    "emotion": "大聲，快，說完就停",
    "say": "¡Li Shouzheng, Qingzhou!"
  },
  "zq49a26": {
    "text": "Puesto dos—",
    "emotion": "大聲，快，說完就停",
    "say": "¡Dos!"
  },
  "zq49a27": {
    "text": "¡Zhao Wenyuan, de la ciudad!",
    "emotion": "唱名"
  },
  "zq49a28": {
    "text": "¡Ja, ja, ja!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "¡Ni entre los tres primeros!",
    "emotion": "得意忘形",
    "say": "¡Ni en los tres!"
  },
  "zq49a30": {
    "text": "Léalo ya, rápido…",
    "emotion": "小小聲，快哭了",
    "say": "Léalo ya…"
  },
  "zq49a31": {
    "text": "¿No estás nervioso?",
    "emotion": "壓低聲音",
    "say": "¿Nervioso?"
  },
  "zq49a32": {
    "text": "Sí.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Sí."
  },
  "zq49a33": {
    "text": "Me sudan las manos.",
    "emotion": "苦笑"
  },
  "zq49a34": {
    "text": "El primero del examen—",
    "emotion": "停一拍，最響",
    "say": "El primero—"
  },
  "zq49a35": {
    "text": "Liuxi, condado de Qingshui,",
    "emotion": "大聲，快，說完就停",
    "say": "Liuxi, Qingshui,"
  },
  "zq49a36": {
    "text": "¡Xu Yan!",
    "emotion": "畫外，大聲，快，說完就停",
    "say": "¡Xu Yan!"
  },
  "zq49a37": {
    "text": "…¿Yo?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "¡Aprobaste!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡Pasaste!"
  },
  "zq49a39": {
    "text": "¡El primero!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡Primero!"
  },
  "zq49a40": {
    "text": "Lo sabía.",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "Misión del examen provincial completada.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misión cumplida."
  },
  "zq49a42": {
    "text": "Recompensa: imprenta de tipos móviles.",
    "emotion": "平板電子音",
    "say": "Recompensa: tipos móviles."
  },
  "zq49a43": {
    "text": "Tipos móviles…",
    "emotion": "低聲，快，說完就停",
    "say": "Tipos móviles…"
  },
  "zq49a44": {
    "text": "hay que hallar un grabador.",
    "emotion": "撓頭",
    "say": "falta un grabador."
  },
  "zq49a45": {
    "text": "Permiso…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Paso"
  },
  "zq49a46": {
    "text": "Permiso…",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "Va a la mitad,",
    "emotion": "甜，快，說完就停",
    "say": "A la mitad,"
  },
  "zq49a48": {
    "text": "¡ánimo, don Zhou!",
    "emotion": "揮手",
    "say": "¡ánimo!"
  },
  "zq49a49": {
    "text": "Yo…",
    "emotion": "低聲，快，說完就停",
    "say": "Yo"
  },
  "zq49a50": {
    "text": "¡Está bien, camino!",
    "emotion": "咬牙",
    "say": "¡Ya, camino!"
  },
  "zq49a51": {
    "text": "Toda la calle,",
    "emotion": "冷，快，說完就停",
    "say": "Toda,"
  },
  "zq49a52": {
    "text": "ni un paso menos.",
    "emotion": "冷冷地笑"
  },
  "zq49a53": {
    "text": "Amigos,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡Todos!"
  },
  "zq49a54": {
    "text": "¡compartan la alegría!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡a celebrar!"
  },
  "zq49a55": {
    "text": "¡Xu Yan!",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "¡Aquí!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "¿Qué pasa?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "Esta noche,",
    "emotion": "輕聲，快，說完就停",
    "say": "Hoy,"
  },
  "zq49a59": {
    "text": "tengo algo que decirte.",
    "emotion": "眼睛濕了",
    "say": "debo decirte algo."
  }
}
