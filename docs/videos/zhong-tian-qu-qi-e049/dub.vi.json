{
  "zq49a01": {
    "text": "Hạng tám mươi—",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tám mươi!"
  },
  "zq49a02": {
    "text": "Thanh Châu, Trần Đại Hữu!",
    "emotion": "唱名"
  },
  "zq49a03": {
    "text": "Đọc từ người cuối",
    "emotion": "踮腳",
    "say": "Từ cuối"
  },
  "zq49a04": {
    "text": "lên sao?",
    "emotion": "急",
    "say": "lên à?"
  },
  "zq49a05": {
    "text": "Tám mươi cái tên,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tám mươi tên,"
  },
  "zq49a06": {
    "text": "cứ từ từ chờ.",
    "emotion": "吞口水",
    "say": "cứ chờ."
  },
  "zq49a07": {
    "text": "Ồ,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ồ,"
  },
  "zq49a08": {
    "text": "Hứa tú tài cũng đến xem bảng à?",
    "emotion": "假笑"
  },
  "zq49a09": {
    "text": "Hắn mà đỗ,",
    "emotion": "大聲，讓人都聽見"
  },
  "zq49a10": {
    "text": "ta đi giật lùi!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ta đi giật lùi!"
  },
  "zq49a11": {
    "text": "Viên ngoại,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Viên ngoại,"
  },
  "zq49a12": {
    "text": "buộc chặt dây giày trước đi.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "buộc giày đi."
  },
  "zq49a13": {
    "text": "Hứa rồi nhé,",
    "emotion": "甜甜一笑",
    "say": "Hứa rồi,"
  },
  "zq49a14": {
    "text": "đi giật lùi hết một con phố.",
    "emotion": "眨眼",
    "say": "lùi hết một phố."
  },
  "zq49a15": {
    "text": "Mọi người đều nghe rồi.",
    "emotion": "冷，嘴角一勾",
    "say": "Ai cũng nghe rồi."
  },
  "zq49a16": {
    "text": "Bị gạch là…",
    "emotion": "瞇眼看",
    "say": "Gạch tên…"
  },
  "zq49a17": {
    "text": "Phùng học chính!",
    "emotion": "笑出來"
  },
  "zq49a18": {
    "text": "G-gạch một khảo quan,",
    "emotion": "笑僵了"
  },
  "zq49a19": {
    "text": "thì đã sao.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "Khảo quan bị gạch rồi,",
    "emotion": "低聲，快，說完就停",
    "say": "Gạch rồi,"
  },
  "zq49a21": {
    "text": "còn bảng?",
    "emotion": "低聲，快，說完就停",
    "say": "còn bảng?"
  },
  "zq49a22": {
    "text": "Hạng mười—",
    "emotion": "大聲，快，說完就停",
    "say": "Hạng mười!"
  },
  "zq49a23": {
    "text": "Châu thành, Lâm Thế An!",
    "emotion": "唱名"
  },
  "zq49a24": {
    "text": "Hạng ba—",
    "emotion": "大聲，快，說完就停",
    "say": "Hạng ba!"
  },
  "zq49a25": {
    "text": "Thanh Châu, Lý Thủ Chính!",
    "emotion": "大聲，快，說完就停",
    "say": "Thanh Châu, Lý Thủ Chính!"
  },
  "zq49a26": {
    "text": "Hạng nhì—",
    "emotion": "大聲，快，說完就停",
    "say": "Hạng nhì!"
  },
  "zq49a27": {
    "text": "Châu thành, Triệu Văn Viễn!",
    "emotion": "大聲，快，說完就停",
    "say": "Châu thành, Triệu Văn Viễn!"
  },
  "zq49a28": {
    "text": "Ha ha ha!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "Ba hạng đầu không có hắn!",
    "emotion": "大聲，快，說完就停",
    "say": "Ba hạng đầu chẳng có!"
  },
  "zq49a30": {
    "text": "Đọc nhanh lên…",
    "emotion": "小小聲，快哭了",
    "say": "Nhanh lên…"
  },
  "zq49a31": {
    "text": "Chàng không lo à?",
    "emotion": "壓低聲音",
    "say": "Không lo à?"
  },
  "zq49a32": {
    "text": "Lo.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lo."
  },
  "zq49a33": {
    "text": "Tay ướt đẫm mồ hôi.",
    "emotion": "苦笑",
    "say": "Tay đẫm mồ hôi."
  },
  "zq49a34": {
    "text": "Giải nguyên—",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Giải nguyên!"
  },
  "zq49a35": {
    "text": "Liễu Khê, huyện Thanh Thủy,",
    "emotion": "大聲，快，說完就停",
    "say": "Liễu Khê, Thanh Thủy,"
  },
  "zq49a36": {
    "text": "Hứa Nghiên!",
    "emotion": "畫外，大聲，快，說完就停",
    "say": "Hứa Nghiên!"
  },
  "zq49a37": {
    "text": "…Tôi?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "Đỗ rồi!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Đỗ rồi!"
  },
  "zq49a39": {
    "text": "Giải nguyên!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Giải nguyên!"
  },
  "zq49a40": {
    "text": "Ta biết mà.",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "Nhiệm vụ thi Hương hoàn thành.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Thi Hương hoàn thành."
  },
  "zq49a42": {
    "text": "Phần thưởng: in chữ rời.",
    "emotion": "平板電子音"
  },
  "zq49a43": {
    "text": "Chữ rời…",
    "emotion": "低聲，快，說完就停",
    "say": "Chữ rời…"
  },
  "zq49a44": {
    "text": "phải tìm thợ khắc chữ.",
    "emotion": "撓頭",
    "say": "cần thợ khắc chữ."
  },
  "zq49a45": {
    "text": "Xin nhường…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Nhường"
  },
  "zq49a46": {
    "text": "Xin nhường…",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "Mới nửa đường,",
    "emotion": "甜，快，說完就停",
    "say": "Mới nửa,"
  },
  "zq49a48": {
    "text": "viên ngoại cố lên!",
    "emotion": "揮手",
    "say": "cố lên!"
  },
  "zq49a49": {
    "text": "Ta…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ta"
  },
  "zq49a50": {
    "text": "Ta đi là được chứ gì!",
    "emotion": "咬牙",
    "say": "Ta đi là được!"
  },
  "zq49a51": {
    "text": "Một con phố,",
    "emotion": "冷，快，說完就停",
    "say": "Cả phố,"
  },
  "zq49a52": {
    "text": "không thiếu một bước.",
    "emotion": "冷冷地笑"
  },
  "zq49a53": {
    "text": "Chư vị,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Chư vị!"
  },
  "zq49a54": {
    "text": "cùng vui cùng vui!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "cùng vui!"
  },
  "zq49a55": {
    "text": "Hứa Nghiên—",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "Bên này!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "Sao vậy?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "Tối nay,",
    "emotion": "輕聲，快，說完就停",
    "say": "Tối nay,"
  },
  "zq49a59": {
    "text": "ta có chuyện muốn nói với chàng.",
    "emotion": "眼睛濕了",
    "say": "có chuyện muốn nói."
  }
}
