{
  "zq49a01": {
    "text": "Peringkat delapan puluh—",
    "emotion": "大聲，極快，一口氣說完，不拖音",
    "say": "Delapan puluh!"
  },
  "zq49a02": {
    "text": "Chen Dayou, dari Qingzhou!",
    "emotion": "大聲，快，說完就停",
    "say": "Chen Dayou, Qingzhou!"
  },
  "zq49a03": {
    "text": "Mulai dari yang terakhir",
    "emotion": "踮腳",
    "say": "Dari terakhir"
  },
  "zq49a04": {
    "text": "dibaca ke atas?",
    "emotion": "急",
    "say": "ke atas?"
  },
  "zq49a05": {
    "text": "Delapan puluh nama,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Delapan puluh,"
  },
  "zq49a06": {
    "text": "sabar saja.",
    "emotion": "吞口水",
    "say": "sabar."
  },
  "zq49a07": {
    "text": "Wah,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Wah,"
  },
  "zq49a08": {
    "text": "Sarjana Xu juga datang lihat pengumuman?",
    "emotion": "假笑",
    "say": "Sarjana Xu juga lihat pengumuman?"
  },
  "zq49a09": {
    "text": "Kalau dia lulus,",
    "emotion": "大聲，讓人都聽見",
    "say": "Kalau lulus,"
  },
  "zq49a10": {
    "text": "aku jalan mundur!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "aku jalan mundur!"
  },
  "zq49a11": {
    "text": "Tuan Zhou,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tuan,"
  },
  "zq49a12": {
    "text": "ikat tali sepatu dulu.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ikat sepatu."
  },
  "zq49a13": {
    "text": "Janji, ya,",
    "emotion": "甜甜一笑",
    "say": "Janji,"
  },
  "zq49a14": {
    "text": "jalan mundur satu jalan penuh.",
    "emotion": "眨眼",
    "say": "satu jalan penuh!"
  },
  "zq49a15": {
    "text": "Semua sudah dengar.",
    "emotion": "冷，嘴角一勾",
    "say": "Semua dengar."
  },
  "zq49a16": {
    "text": "Yang dicoret…",
    "emotion": "瞇眼看",
    "say": "Dicoret…"
  },
  "zq49a17": {
    "text": "Penguji Feng!",
    "emotion": "笑出來"
  },
  "zq49a18": {
    "text": "P-penguji dicoret satu,",
    "emotion": "笑僵了",
    "say": "P-coret satu penguji,"
  },
  "zq49a19": {
    "text": "apa artinya.",
    "emotion": "嘴硬"
  },
  "zq49a20": {
    "text": "Pengujinya dicoret,",
    "emotion": "低聲，快，說完就停",
    "say": "Feng jatuh,"
  },
  "zq49a21": {
    "text": "lalu daftarnya?",
    "emotion": "低聲，快，說完就停",
    "say": "daftarnya?"
  },
  "zq49a22": {
    "text": "Peringkat sepuluh—",
    "emotion": "大聲，快，說完就停",
    "say": "Sepuluh!"
  },
  "zq49a23": {
    "text": "Lin Shi'an, dari kota!",
    "emotion": "唱名",
    "say": "Lin Shi'an, kota!"
  },
  "zq49a24": {
    "text": "Peringkat tiga—",
    "emotion": "大聲，快，說完就停",
    "say": "Tiga!"
  },
  "zq49a25": {
    "text": "Li Shouzheng, dari Qingzhou!",
    "emotion": "大聲，快，說完就停",
    "say": "Li Shouzheng, Qingzhou!"
  },
  "zq49a26": {
    "text": "Peringkat dua—",
    "emotion": "大聲，快，說完就停",
    "say": "Dua!"
  },
  "zq49a27": {
    "text": "Zhao Wenyuan, dari kota!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Zhao Wenyuan, kota!"
  },
  "zq49a28": {
    "text": "Ha ha ha!",
    "emotion": "放聲大笑"
  },
  "zq49a29": {
    "text": "Tiga besar pun tak ada dia!",
    "emotion": "大聲，快，說完就停",
    "say": "Tiga besar tak ada!"
  },
  "zq49a30": {
    "text": "Cepat baca…",
    "emotion": "小小聲，快哭了",
    "say": "Cepat…"
  },
  "zq49a31": {
    "text": "Kamu tidak tegang?",
    "emotion": "壓低聲音",
    "say": "Tak tegang?"
  },
  "zq49a32": {
    "text": "Tegang.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Iya."
  },
  "zq49a33": {
    "text": "Telapak tanganku basah keringat.",
    "emotion": "苦笑",
    "say": "Tanganku basah."
  },
  "zq49a34": {
    "text": "Juara pertama—",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Juara satu!"
  },
  "zq49a35": {
    "text": "Liuxi, Kabupaten Qingshui,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Liuxi, Qingshui,"
  },
  "zq49a36": {
    "text": "Xu Yan!",
    "emotion": "畫外，大聲，快，說完就停",
    "say": "Xu Yan!"
  },
  "zq49a37": {
    "text": "…Aku?",
    "emotion": "不敢相信"
  },
  "zq49a38": {
    "text": "Lulus!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lulus!"
  },
  "zq49a39": {
    "text": "Juara pertama!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Juara satu!"
  },
  "zq49a40": {
    "text": "Sudah kuduga.",
    "emotion": "嘴角翹起來"
  },
  "zq49a41": {
    "text": "Misi ujian provinsi selesai.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misi selesai."
  },
  "zq49a42": {
    "text": "Hadiah: cetak huruf lepas.",
    "emotion": "平板電子音"
  },
  "zq49a43": {
    "text": "Huruf lepas…",
    "emotion": "低聲，快，說完就停",
    "say": "Huruf lepas…"
  },
  "zq49a44": {
    "text": "harus cari tukang ukir.",
    "emotion": "撓頭",
    "say": "cari tukang ukir."
  },
  "zq49a45": {
    "text": "Permisi…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Permisi"
  },
  "zq49a46": {
    "text": "Permisi…",
    "emotion": "小聲"
  },
  "zq49a47": {
    "text": "Baru setengah,",
    "emotion": "甜，快，說完就停",
    "say": "Setengah,"
  },
  "zq49a48": {
    "text": "semangat, Tuan Zhou!",
    "emotion": "揮手",
    "say": "semangat!"
  },
  "zq49a49": {
    "text": "Aku…",
    "emotion": "低聲，快，說完就停",
    "say": "Aku"
  },
  "zq49a50": {
    "text": "Iya, aku jalan!",
    "emotion": "咬牙",
    "say": "Ya, aku jalan!"
  },
  "zq49a51": {
    "text": "Satu jalan,",
    "emotion": "冷，快，說完就停",
    "say": "Semua,"
  },
  "zq49a52": {
    "text": "kurang selangkah pun tak boleh.",
    "emotion": "冷冷地笑",
    "say": "tak kurang selangkah."
  },
  "zq49a53": {
    "text": "Semua,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Semua!"
  },
  "zq49a54": {
    "text": "mari bergembira bersama!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "bergembira!"
  },
  "zq49a55": {
    "text": "Xu Yan!",
    "emotion": "跳著喊"
  },
  "zq49a56": {
    "text": "Sini!",
    "emotion": "揮手"
  },
  "zq49a57": {
    "text": "Ada apa?",
    "emotion": "低頭，笑還沒收"
  },
  "zq49a58": {
    "text": "Malam ini,",
    "emotion": "輕聲，快，說完就停",
    "say": "Nanti,"
  },
  "zq49a59": {
    "text": "ada yang ingin kukatakan.",
    "emotion": "眼睛濕了",
    "say": "mau bicara."
  }
