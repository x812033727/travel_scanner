  "lines": {
    "hh101": {
      "source_hash": "9043cfe50a62",
      "text": "분세이 4년 11월 17일, 밤."
    },
    "hh102": {
      "source_hash": "e41ecd383e52",
      "text": "히라도 전 번주 마쓰라 세이잔에게 손님이."
    },
    "hh103": {
      "source_hash": "b9c789c99e75",
      "text": "막부 학두 하야시 줏사이, 칼 단련 보며 밤늦게 담소."
    },
    "hh104": {
      "source_hash": "0363dceb9757",
      "text": "그날 밤, 그는 필기를 시작합니다."
    },
    "hh105": {
      "source_hash": "fa48129dbc84",
      "text": "그날이 갑자일이라 책 이름은 『갑자야화』."
    },
    "hh106": {
      "source_hash": "b0f3587e2e74",
      "text": "누가 두견새를 보냈습니다. 꽃 아닌 새요."
    },
    "hh107": {
      "source_hash": "76af1143191d",
      "text": "그런데 한 번도 안 웁니다."
    },
    "hh108": {
      "source_hash": "18b408e766a4",
      "text": "오늘날 세 영웅이 이 새에게 한마디씩 했다죠."
    },
    "hh109": {
      "source_hash": "0eb7dacbf264",
      "text": "세이잔은 세 구절 앞에 남의 말을 적었습니다."
    },
    "hh110": {
      "source_hash": "5748c531feb0",
      "text": "다른 막부 관리의 기록에도 이 셋과 새가 나옵니다."
    },
    "hh111": {
      "source_hash": "904c02174e84",
      "text": "거기서 이에야스는 뭐라고?"
    },
    "hh112": {
      "source_hash": "e658ed0e3071",
      "text": "쇼와 10년엔 중학 수신 수업까지 됐습니다."
    },
    "hh113": {
      "source_hash": "bd724405dd1f",
      "text": "정말 노부나가·히데요시·이에야스가 썼을까?"
    },
    "hh201": {
      "source_hash": "d6cb7b7fa2ff",
      "text": "53권 7장, 세 구절 앞에서 이미 누가 답했습니다."
    },
    "hh202": {
      "source_hash": "5638f9cd51c1",
      "text": "남의 가탁이겠지만, 세 사람 성품에 맞는다."
    },
    "hh203": {
      "source_hash": "bac8672bf7c8",
      "text": "가탁은 남의 이름을 빌린 창작."
    },
    "hh204": {
      "source_hash": "5a6565ffed4a",
      "text": "말한 사람은 세이잔?"
    },
    "hh205": {
      "source_hash": "a6a8bcbdf1e8",
      "text": "아닙니다. 책엔 '혹인', 어떤 사람이라고만."
    },
    "hh206": {
      "source_hash": "a43efe61527a",
      "text": "우리가 읽은 건 메이지 33년 마쓰라 가문이 직접 펴낸 정편 100권입니다."
    },
    "hh207": {
      "source_hash": "9cbabac164c4",
      "text": "그 말 뒤에 새와 세 구절이 옵니다."
    },
    "hh208": {
      "source_hash": "b709f97f5447",
      "text": "누구에게?"
    },
    "hh209": {
      "source_hash": "eaac00a18b91",
      "text": "누구에게, 언제 보냈는지 책엔 없습니다."
    },
    "hh210": {
      "source_hash": "53b2459793a4",
      "text": "서명은 노부나가·히데요시·이에야스가 아닙니다."
    },
    "hh211": {
      "source_hash": "d2e731dfb748",
      "text": "그럼 뭘까?"
    },
    "hh212": {
      "source_hash": "f0acec56f123",
      "text": "관직명입니다. 오다 우후: 울지 않으면 죽여라."
    },
    "hh213": {
      "source_hash": "d4323a4090aa",
      "text": "호 다이코: 울려 보이겠다."
    },
    "hh214": {
      "source_hash": "92b41d7c6534",
      "text": "다이곤겐사마: 안 울면 울 때까지 기다려라."
    },
    "hh215": {
      "source_hash": "957a4e5bcb0a",
      "text": "우후는 우대신, 다이곤겐은 이에야스가 죽은 뒤 신으로 모셔진 칭호."
    },
    "hh216": {
      "source_hash": "bb8eda3fa1c4",
      "text": "새 이름도 제각각. 자주 인용되는 다른 본엔 세 구절에 한자 셋;"
    },
    "hh217": {
      "source_hash": "1a17e06342ea",
      "text": "우리가 읽은 메이지본은 셋 다 같은 글자."
    },
    "hh218": {
      "source_hash": "5d487ca618b9",
      "text": "교정자의 발문: 사본에 의심스런 글자가 있어, 원문 대조와 벗의 도움으로 고쳤다."
    },
    "hh219": {
      "source_hash": "db45e8661f58",
      "text": "그런데 끝이 아닙니다. 두 구절이 더."
    },
    "hh220": {
      "source_hash": "83bcd40ca740",
      "text": "하나는 안 울면 새 가게로, 또 하나는 안 울면 그냥 받아 둬라."
    },
    "hh221": {
      "source_hash": "4a5599bb60ca",
      "text": "책은 말합니다. 꺼리는 데다 원래 가탁이라 작자는 안 적는다고."
    },
    "hh222": {
      "source_hash": "76017421cf25",
      "text": "누구 얘기?"
    },
    "hh223": {
      "source_hash": "549a40f20c96",
      "text": "한 글자도 없습니다."
    },
    "hh224": {
      "source_hash": "5997846dde55",
      "text": "앞뒤 두 편은 세 영웅과 무관한 잡문입니다."
    },
    "hh225": {
      "source_hash": "299227c8d217",
      "text": "그럼 이 셋과 새를 처음 적은 건 세이잔일까?"
    },
    "hh301": {
      "source_hash": "17b4fad6258d",
      "text": "아닙니다. 더 이른 건 그 막부 관리, 네기시 야스모리."
    },
    "hh302": {
      "source_hash": "1f9455fc83d8",
      "text": "분카 12년 사망. 세이잔의 야화는 아직 시작 전."
    },
    "hh303": {
      "source_hash": "7376514959ab",
      "text": "사도 부교 시절부터 30년쯤 견문을 적은 『미미부쿠로』."
    },
    "hh304": {
      "source_hash": "7d577ba0ac5e",
      "text": "이 항목 제목은: 렌가 자리에선 본심이 절로 드러난다."
    },
    "hh305": {
      "source_hash": "6122076c4059",
      "text": "네기시는 믿었나?"
    },
    "hh306": {
      "source_hash": "2055fd9891e9",
      "text": "첫머리에 먼저 한마디."
    },
    "hh307": {
      "source_hash": "5d560b73e6dd",
      "text": "옛이야기인지 지어낸 건지 나는 모르겠다."
    },
    "hh308": {
      "source_hash": "8321963a1b34",
      "text": "처음 보낸 새 기억나요? 여기선 아무도 안 보냅니다."
    },
    "hh309": {
      "source_hash": "6158a0ca512e",
      "text": "셋이 모여, 4월인데 두견새 소리를 못 들었다고."
    },
    "hh310": {
      "source_hash": "25c6722c87d4",
      "text": "음력 4월은 지금의 5월쯤, 두견새가 올 때입니다."
    },
    "hh311": {
      "source_hash": "15b07b0e000b",
      "text": "노부나가 구는 세이잔 것과 같은 뜻."
    },
    "hh312": {
      "source_hash": "7d450de8f0f3",
      "text": "히데요시: 안 울면 울게 해서 듣자."
    },
    "hh313": {
      "source_hash": "0d3bf8890751",
      "text": "이에야스 앞을 한 칸 비워 경의를 표함."
    },
    "hh314": {
      "source_hash": "5eab8a702a62",
      "text": "이에야스는?"
    },
    "hh315": {
      "source_hash": "ccbc5b146d91",
      "text": "안 울면, 울 때 듣자."
    },
    "hh316": {
      "source_hash": "8e2ff9e2f0fd",
      "text": "여기엔 '기다린다'가 없습니다. 그건 세이잔 기록에만."
    },
    "hh317": {
      "source_hash": "e1e4dae99e78",
      "text": "당대 제일의 렌가 시인 조하도 있어, 넷째 구를:"
    },
    "hh318": {
      "source_hash": "f88ce14a4b89",
      "text": "안 울어도 좋다."
    },
    "hh319": {
      "source_hash": "0f9766251ea5",
      "text": "네기시는 세 구절이 성품을 드러낸다고: 이에야스는 온순, 히데요시는 도량, 노부나가는 급함."
    },
    "hh320": {
      "source_hash": "424df40af5c6",
      "text": "등장인물이 더 많은 판도."
    },
    "hh321": {
      "source_hash": "dc14deb516c8",
      "text": "메이지 10년대, 옛 수필을 베낀 원고엔 마에다 도시이에까지;"
    },
    "hh322": {
      "source_hash": "2f6311d65883",
      "text": "장소는 아즈치성 노부나가의 연회."
    },
    "hh323": {
      "source_hash": "6c698ea1ed0f",
      "text": "농담거리도 됐죠. 다이쇼 때 센류 연구가는 한 센류를 분카 연간으로:"
    },
    "hh324": {
      "source_hash": "ba7f04072823",
      "text": "두견새 한 마리로 지·인·용 세 구가 나왔다고."
    },
    "hh325": {
      "source_hash": "6e186fb13159",
      "text": "연대가 맞다면 세이잔 이전에 이미 서민 센류에 들어간 셈."
    },
    "hh326": {
      "source_hash": "952613714765",
      "text": "『미미부쿠로』와 선후는 불명."
    },
    "hh327": {
      "source_hash": "c1ef700ba1dc",
      "text": "메이지에도 지어낸 거라 했을까?"
    },
    "hh401": {
      "source_hash": "6dc574a5f668",
      "text": "그렇습니다. 메이지 34년 수양서: 아마 누군가 지어낸 이야기일 것."
    },
    "hh402": {
      "source_hash": "a624b8ab82ce",
      "text": "하지만 세 구절로 세 사람 인격을 상상할 수 있다고."
    },
    "hh403": {
      "source_hash": "d68b726f0020",
      "text": "새 '울 명'을 '울 읍'으로 바꿔 썼고,"
    },
    "hh404": {
      "source_hash": "8e192abc3290",
      "text": "서명도 본명으로."
    },
    "hh405": {
      "source_hash": "5a9de7e9aff1",
      "text": "메이지 37년 교재 사전은 '노부나가 평' '히데요시 평' '이에야스 평'이라 달았습니다: 평어."
    },
    "hh406": {
      "source_hash": "070d4cc66c6e",
      "text": "바로 뒤에 '이에야스 유훈'을:"
    },
    "hh407": {
      "source_hash": "1ed6784060ca",
      "text": "인생은 무거운 짐 지고 먼 길, 서두르지 마라."
    },
    "hh408": {
      "source_hash": "eec3ca23a0b3",
      "text": "이건 누가 썼을까?"
    },
    "hh409": {
      "source_hash": "31601192822f",
      "text": "메이지 42년 청년 수양서도 후대 창작이라 했습니다."
    },
    "hh410": {
      "source_hash": "506984c4ac1f",
      "text": "그런데 장면이 또 바뀝니다. 셋이 모여 오래 기다려도 새가 안 웁니다."
    },
    "hh411": {
      "source_hash": "62682b599c59",
      "text": "이에야스 구는 이미 지금의 '울 때까지 기다리자'."
    },
    "hh412": {
      "source_hash": "d8c2dc8cba38",
      "text": "나머지 둘은?"
    },
    "hh413": {
      "source_hash": "c8b77df6cda5",
      "text": "메이지 43년, 소학 독본용 말하기·작문 참고서의 세 구절은"
    },
    "hh414": {
      "source_hash": "539e41d44ec4",
      "text": "지금과 거의 같습니다."
    },
    "hh415": {
      "source_hash": "5e7f70b01585",
      "text": "이 책도 세상에 셋의 작이라 전한다고만."
    },
    "hh416": {
      "source_hash": "d889f5bbded2",
      "text": "다이쇼 15년, 그 센류 연구가도 한 설을 적었습니다."
    },
    "hh417": {
      "source_hash": "02227cfd064d",
      "text": "후대가 두견새로 세 장수 성격을 그린 듯."
    },
    "hh418": {
      "source_hash": "db42a3f422fe",
      "text": "그의 판에선 장면이 미리 제목을 낸 노래 모임으로."
    },
    "hh419": {
      "source_hash": "c75bc3d9a8d1",
      "text": "우리가 보기에 가장 이상한 건, 지어냈다면서 성격 교재로 쓴 것."
    },
    "hh420": {
      "source_hash": "b4ae207b00da",
      "text": "지금 판은 어느 책이 정했을까?"
    },
    "hh501": {
      "source_hash": "9aafebc6ef62",
      "text": "그런 책은 못 찾았습니다. 쇼와 10년에도 구절은 바뀌었죠."
    },
    "hh502": {
      "source_hash": "75168d55dc59",
      "text": "그 수신 수업 기억나죠? 과 이름은 '기다리는 마음'."
    },
    "hh503": {
      "source_hash": "830575516187",
      "text": "1절: 어떤 이가 노부나가·히데요시·이에야스의 심사를 말하다."
    },
    "hh504": {
      "source_hash": "0c07b84bc16f",
      "text": "또 '어떤 이'."
    },
    "hh505": {
      "source_hash": "fda1ab80a27f",
      "text": "교사용 참고서는 출전을 『갑자야화』로,"
    },
    "hh506": {
      "source_hash": "d2ef1d96ee30",
      "text": "뒤의 두 구와 '작자 안 적음'까지 함께 인용."
    },
    "hh507": {
      "source_hash": "047bdfc269d6",
      "text": "그대로 옮겼나?"
    },
    "hh508": {
      "source_hash": "6f846fa99174",
      "text": "아니요. '기다릴 대'가 과 이름의 '기다릴 사'로."
    },
    "hh509": {
      "source_hash": "8d1f5ca1cdbe",
      "text": "메이지 교정자 기억나죠? 이번엔 바로잡기가 아니라 과 이름에 맞춘 것."
    },
    "hh510": {
      "source_hash": "a7bb0c132d6d",
      "text": "5년 뒤 국사책은 더 직설적: 전국의 세 영웅이 사이좋게 모여 한 새를 읊었을 리 없다."
    },
    "hh511": {
      "source_hash": "eae25a8e8160",
      "text": "분명 후대의 부회라고."
    },
    "hh512": {
      "source_hash": "a60972e17cf5",
      "text": "그럼 메이지 37년, 세 구절 옆의 '무거운 짐 지고 먼 길'은?"
    },
    "hh513": {
      "source_hash": "ede6cec4f381",
      "text": "연구자들은 에도 후기에 이에야스 이름이 붙었다 봅니다."
    },
    "hh514": {
      "source_hash": "af5b26996f6b",
      "text": "그럼 처음 질문. 이 세 구절은 그들이 썼을까?"
    },
    "hh515": {
      "source_hash": "0b51c16c862f",
      "text": "노부나가, 히데요시, 이에야스는 1582, 1598, 1616년에 사망;"
    },
    "hh516": {
      "source_hash": "200c0460b53c",
      "text": "지금 찾은 에도 기록 두 권은 모두 200년쯤 뒤."
    },
    "hh517": {
      "source_hash": "c5181e7bf3a6",
      "text": "동시대 기록엔 이 세 구절이 한 줄도 없습니다."
    },
    "hh518": {
      "source_hash": "20c194728fe1",
      "text": "진짜 작자는 지금도 모릅니다."
    },
    "hh519": {
      "source_hash": "fbdba3f6e1e2",
      "text": "'세 사람 성품에 맞는다' 기억나요?"
    },
    "hh520": {
      "source_hash": "6229f3f6bb67",
      "text": "세 구절이 200년 간 건 이 '닮음' 덕이라 봅니다."
    },
    "hh521": {
      "source_hash": "68886ac1df04",
      "text": "셋 다 그들이 안 썼습니다. 파일 보관."
    },
    "hh522": {
      "source_hash": "8bf1c28ab103",
      "text": "당신이라면 이 새에게 뭐라고 할까요?"
    },
    "hh523": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 다룹니다. 함께 파일을 열려면 구독을."
    }
  }
}
