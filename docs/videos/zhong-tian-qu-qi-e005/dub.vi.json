{
  "zq5a01": "Dừng tay!",
  "zq5a02": "Ai? Ai ném đấy?",
  "zq5a03": "A Lệnh?",
  "zq5a04": "Dội nồi ta?",
  "zq5a05": "Tiểu nhân đi ngang…",
  "zq5a06": "Đi ngang mang xô nước?",
  "zq5a07": "Dám động vào mỡ lợn của ta?",
  "zq5a08": "Đừng đánh!",
  "zq5a09": "Dựa vào gì?",
  "zq5a10": "Tiền viên ngoại sai hả?",
  "zq5a11": "Phải, phải Tiền viên ngoại…",
  "zq5a12": "sai tiểu nhân đến phá nồi.",
  "zq5a13": "Đánh hắn, lão ta có cớ kiện.",
  "zq5a14": "Cứ thế bỏ qua sao?",
  "zq5a15": "Phạt ngươi khuấy,",
  "zq5a16": "khuấy nồi đến sáng.",
  "zq5a17": "Hời cho ngươi.",
  "zq5a18": "Hảo cảm cộng ba.",
  "zq5a19": "Tay tiểu nhân sắp gãy rồi…",
  "zq5a20": "Khuấy tiếp.",
  "zq5a21": "Sáng là xong.",
  "zq5a22": "Không ngủ à?",
  "zq5a23": "Phải canh nồi.",
  "zq5a24": "Hảo cảm cộng năm.",
  "zq5a25": "Ca, mở nhanh!",
  "zq5a26": "Nhanh lên, ta muốn xem!",
  "zq5a27": "Ca, có bọt kìa!",
  "zq5a28": "Một bánh, ba trăm văn.",
  "zq5a29": "Đắt quá!",
  "zq5a30": "Bán lên huyện thành!",
  "zq5a31": "Biếu lão gia nhà ngươi,",
  "zq5a32": "rửa tay cho sạch.",
  "zq5a33": "Bốn mươi tám, bốn chín…",
  "zq5a34": "Nhiệm vụ bắt buộc: thành hôn.",
  "zq5a35": "Còn mười hai canh giờ.",
  "zq5a36": "Thành thân… quên mất!",
  "zq5a37": "Đăng ký ở huyện nha, giờ Ngọ đóng cửa!",
  "zq5a38": "Mười hai canh giờ…",
  "zq5a39": "Cưới cả ba?"
}
