{
  "zq5a01": "Stop!",
  "zq5a02": "Siapa? Siapa yang lempar?",
  "zq5a03": "A-Ling?",
  "zq5a04": "Nyiram pancikku?",
  "zq5a05": {
    "text": "A… aku cuma lewat…",
    "say": "Le… lewat."
  },
  "zq5a06": "Lewat bawa ember?",
  "zq5a07": "Berani sentuh lemakku?",
  "zq5a08": {
    "text": "Jangan pukul!",
    "say": "Jangan!"
  },
  "zq5a09": "Emang kenapa?",
  "zq5a10": "Disuruh Tuan Qian, kan?",
  "zq5a11": "I… iya, Tuan Qian…",
  "zq5a12": "nyuruh aku rusak pancimu.",
  "zq5a13": "Dipukul, dia bisa lapor.",
  "zq5a14": "Gitu aja dilepas?",
  "zq5a15": {
    "text": "Hukumanmu: aduk panci,",
    "say": "Kamu aduk,"
  },
  "zq5a16": "sampai matahari terbit.",
  "zq5a17": "Untung kamu.",
  "zq5a18": {
    "text": "Poin suka, plus tiga.",
    "say": "Poin suka plus tiga."
  },
  "zq5a19": "Tanganku mau copot…",
  "zq5a20": "Aduk terus.",
  "zq5a21": "Pagi nanti jadi.",
  "zq5a22": "Kamu nggak tidur?",
  "zq5a23": "Harus jaga panci.",
  "zq5a24": "Poin suka, plus lima.",
  "zq5a25": "Buka, Kak!",
  "zq5a26": "Cepetan, aku mau lihat!",
  "zq5a27": "Berbusa, Kak!",
  "zq5a28": "Satu batang, tiga ratus koin.",
  "zq5a29": "Mahal banget!",
  "zq5a30": "Kita jual ke kota!",
  "zq5a31": "Buat tuanmu,",
  "zq5a32": "biar cuci tangan.",
  "zq5a33": "Empat puluh delapan, empat puluh sembilan…",
  "zq5a34": "Misi wajib: menikah.",
  "zq5a35": {
    "text": "Sisa dua puluh empat jam.",
    "say": "Sisa satu hari."
  },
  "zq5a36": "Nikahnya… aku lupa!",
  "zq5a37": "Kantor bupati tutup tengah hari!",
  "zq5a38": "Dua puluh empat jam…",
  "zq5a39": "Nikahi tiga?"
}
