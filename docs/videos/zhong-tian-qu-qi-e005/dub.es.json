{
  "zq5a01": "¡Alto!",
  "zq5a02": "¿Quién? ¿Quién lo lanzó?",
  "zq5a03": "¿A-Ling?",
  "zq5a04": "¿Echándole agua a mi olla?",
  "zq5a05": "Solo pasaba.",
  "zq5a06": "¿Con una cubeta?",
  "zq5a07": "¿Te atreves con mi manteca?",
  "zq5a08": "¡No le pegues!",
  "zq5a09": "¿Por qué no?",
  "zq5a10": "Te mandó don Qian, ¿no?",
  "zq5a11": "S… sí, don Qian…",
  "zq5a12": "me mandó a arruinar su olla.",
  "zq5a13": "Si lo golpeas, Qian nos demanda.",
  "zq5a14": "¿Y así nada más?",
  "zq5a15": "Tú,",
  "zq5a16": "a menear hasta el alba.",
  "zq5a17": "Te salió barato.",
  "zq5a18": "Afecto: más tres.",
  "zq5a19": {
    "text": "Ya no siento los brazos…",
    "say": "¡Mis brazos…!"
  },
  "zq5a20": "Menea. No pares.",
  "zq5a21": "¡Ya casi!",
  "zq5a22": "¿No vas a dormir?",
  "zq5a23": "La olla no para.",
  "zq5a24": "Afecto: más cinco.",
  "zq5a25": "¡Hermano, ábrelo!",
  "zq5a26": "¡Rápido, quiero ver!",
  "zq5a27": "¡Hermano, hace espuma!",
  "zq5a28": "Trescientos cobres cada uno.",
  "zq5a29": "¡Carísimo!",
  "zq5a30": "¡A venderlo en la ciudad!",
  "zq5a31": {
    "text": "Para tu amo,",
    "say": "Ten,"
  },
  "zq5a32": "que se lave las manos.",
  "zq5a33": "Cuarenta y ocho, cuarenta y nueve…",
  "zq5a34": "Misión obligatoria: boda.",
  "zq5a35": "Quedan veinticuatro horas.",
  "zq5a36": "¡La boda… se me olvidó!",
  "zq5a37": "¡El registro cierra a mediodía!",
  "zq5a38": "Veinticuatro horas…",
  "zq5a39": "¿Casarme con tres?"
}
