{
  "zq5a01": "Stop!",
  "zq5a02": "Who? Who threw that?",
  "zq5a03": "A-Ling?",
  "zq5a04": "Dousing my pot?",
  "zq5a05": "Just passing…",
  "zq5a06": "With a bucket?",
  "zq5a07": "Touch my lard, will you?",
  "zq5a08": "Don't!",
  "zq5a09": "Why not?",
  "zq5a10": "Squire Qian sent you?",
  "zq5a11": "Y-yes, Squire Qian…",
  "zq5a12": "said to ruin your pot.",
  "zq5a13": "Hit him, and Qian sues.",
  "zq5a14": "We just let it go?",
  "zq5a15": "You'll stir,",
  "zq5a16": "till sunrise.",
  "zq5a17": "Lucky you.",
  "zq5a18": "Affection: plus three.",
  "zq5a19": "My arms are falling off…",
  "zq5a20": "Stir. Don't stop.",
  "zq5a21": "Done by dawn.",
  "zq5a22": "No sleep?",
  "zq5a23": "Can't leave the pot.",
  "zq5a24": "Affection: plus five.",
  "zq5a25": "Brother, open it!",
  "zq5a26": "Hurry, I want to see!",
  "zq5a27": "Brother, it bubbles!",
  "zq5a28": "Three hundred coppers a bar.",
  "zq5a29": "Pricey!",
  "zq5a30": "We sell it in town!",
  "zq5a31": "For your master,",
  "zq5a32": "to wash his hands.",
  "zq5a33": "Forty-eight, forty-nine…",
  "zq5a34": "Mandatory mission: marriage.",
  "zq5a35": "Twenty-four hours left.",
  "zq5a36": "The wedding… I forgot!",
  "zq5a37": "The county office closes at noon!",
  "zq5a38": "Twenty-four hours…",
  "zq5a39": "To marry three?"
}
