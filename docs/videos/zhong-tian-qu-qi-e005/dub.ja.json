{
  "zq5a01": "やめろ！",
  "zq5a02": "だ、誰だ？",
  "zq5a03": "アーリン？",
  "zq5a04": "鍋に水？",
  "zq5a05": "た、たまたま……",
  "zq5a06": "桶持ってか？",
  "zq5a07": "あたしの脂に！",
  "zq5a08": "よせ！",
  "zq5a09": "なんでよ？",
  "zq5a10": "チエンの手先か？",
  "zq5a11": "チ、チエン旦那が……",
  "zq5a12": "鍋を壊せって。",
  "zq5a13": "殴れば訴えられる。",
  "zq5a14": "このまま許すの？",
  "zq5a15": "罰として、",
  "zq5a16": "朝までかき混ぜろ。",
  "zq5a17": "運がいい。",
  "zq5a18": {
    "text": "好感度、プラス三。",
    "say": "好感プラス三。"
  },
  "zq5a19": "腕がちぎれる……",
  "zq5a20": "止めるなよ。",
  "zq5a21": "朝には完成。",
  "zq5a22": "寝ないの？",
  "zq5a23": "鍋が先だ。",
  "zq5a24": "好感度、プラス五。",
  "zq5a25": "開けて！",
  "zq5a26": "早く、見たい！",
  "zq5a27": "泡が立った！",
  "zq5a28": "一個、三銭。",
  "zq5a29": "高っ！",
  "zq5a30": "町で売るの！",
  "zq5a31": "旦那に、",
  "zq5a32": "手を洗えって。",
  "zq5a33": "四十八、四十九……",
  "zq5a34": "強制任務：結婚。",
  "zq5a35": "残り、一日。",
  "zq5a36": "結婚……忘れてた！",
  "zq5a37": "役所の届け出、昼までよ！",
  "zq5a38": "一日で……",
  "zq5a39": "三人と？"
}
