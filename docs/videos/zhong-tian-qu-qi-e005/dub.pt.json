{
  "zq5a01": "Para!",
  "zq5a02": "Quem? Quem jogou?",
  "zq5a03": "A-Ling?",
  "zq5a04": "Minha panela?",
  "zq5a05": "Só… só passando…",
  "zq5a06": "Com um balde?",
  "zq5a07": "Mexeu na minha banha?",
  "zq5a08": "Não bate!",
  "zq5a09": "Por quê?",
  "zq5a10": "O Senhor Qian mandou, né?",
  "zq5a11": "F… foi o Senhor Qian…",
  "zq5a12": "pra estragar a panela.",
  "zq5a13": "Se bater, ele dá queixa.",
  "zq5a14": "Vai deixar barato?",
  "zq5a15": "Vai mexer,",
  "zq5a16": "até amanhecer.",
  "zq5a17": "Saiu barato.",
  "zq5a18": "Afeição: mais três.",
  "zq5a19": "Meus braços vão cair…",
  "zq5a20": {
    "text": "Mexe. Não para.",
    "say": "Não para."
  },
  "zq5a21": "Pronto de manhã.",
  "zq5a22": "Não dorme?",
  "zq5a23": "A panela não para.",
  "zq5a24": {
    "text": "Afeição: mais cinco.",
    "say": "Mais cinco."
  },
  "zq5a25": {
    "text": "Mano, abre logo!",
    "say": "Abre logo!"
  },
  "zq5a26": "Anda, quero ver!",
  "zq5a27": "Mano, faz espuma!",
  "zq5a28": "Trezentas moedas a barra.",
  "zq5a29": "Que caro!",
  "zq5a30": "Vender na cidade!",
  "zq5a31": {
    "text": "Pro seu patrão",
    "say": "Pro Qian"
  },
  "zq5a32": "lavar as mãos.",
  "zq5a33": "Quarenta e oito, quarenta e nove…",
  "zq5a34": "Missão obrigatória: casamento.",
  "zq5a35": {
    "text": "Faltam vinte e quatro horas.",
    "say": "Vinte e quatro horas."
  },
  "zq5a36": "O casamento… esqueci!",
  "zq5a37": "O cartório fecha ao meio-dia!",
  "zq5a38": "Vinte e quatro horas…",
  "zq5a39": "Três noivas?"
}
