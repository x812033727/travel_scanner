{
  "zq38a01": {
    "text": "หมวกฟาง… เชือกแดง…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "อย่าผลักพี่…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "ผลักพี่?",
    "emotion": "愣住，手停在半空"
  },
  "zq38a04": {
    "text": "ใครผลัก?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "ยาได้แล้ว!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "ไข้สูงเกินไป",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "ยาเอาไม่อยู่",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "หมู่บ้านไม่มีหมอ",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "ในเมืองปิดแล้ว",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "ประตูไม่เปิด",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "ทางครึ่งชั่วยาม",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "นางรอไม่ไหว",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "ภารกิจฉุกเฉิน:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "ก่อนเช้า เสี่ยวเหอไข้ลด",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "เอาม้ามา",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "เชื่อเจ้า",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "พี่อาลิ่งขี่ม้าเป็น?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "นั่นท่าทหารม้า",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "นางเป็นใครกันแน่?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "ถนนตะวันออก หมอไป๋!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "ปิดเมือง!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "มีโจร กลับไป!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "ผู้หญิงขี่ม้าอะไรกัน!",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "หลีกไป",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "เข้ามาอีกจะจับ!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "หน้าไม้!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "ตาม!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "พี่…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "กินแล้ว!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "พี่อยู่นี่",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "ทนไว้จนอาลิ่งกลับมา",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "หมอไป๋!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "เปิดประตู!",
    "say": "เปิด!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "มาแล้ว มาแล้ว",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "ทุบอะไรนักหนา",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "อย่าขยับ!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "หน้าไม้ เล็งนาง",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "ยิง—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
