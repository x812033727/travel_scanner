{
  "zq38a01": {
    "text": "Nón rơm… dây đỏ…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "Đừng đẩy ca ca…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "Đẩy ca ca?",
    "emotion": "愣住，手停在半空"
  },
  "zq38a04": {
    "text": "Ai đẩy?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "Thuốc xong rồi!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "Sốt cao quá,",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "thuốc không hạ nổi.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "Trong thôn không có đại phu.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "Huyện thành giới nghiêm,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "cổng thành không mở.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "Nửa canh giờ đường đi,",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "nó không chờ nổi.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "Nhiệm vụ khẩn cấp:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "trước bình minh, Tiểu Hòa hạ sốt.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "Đưa ngựa đây.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "Ta tin nàng.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "A Lệnh tỷ biết cưỡi ngựa?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "Đó là kiểu lên ngựa kỵ binh.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "Rốt cuộc nàng ta là ai?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "Phố Đông, Bạch đại phu!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "Giới nghiêm!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "Có giặc cướp, quay về!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "Đàn bà cưỡi ngựa gì chứ!",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "Tránh ra.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "Tiến thêm là bắt!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "Nỏ thủ!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "Đuổi!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "Ca…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "Uống được rồi!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "Ca đây.",
    "emotion": "一口氣，短促",
    "say": "Ca đây"
  },
  "zq38a31": {
    "text": "Gắng đợi A Lệnh về.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "Bạch đại phu!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "Mở cửa!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "Tới đây, tới đây,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "đập cửa gì mà đập.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "Đứng yên!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "Nỏ thủ, nhắm vào ả.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "Bắn—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
