{
  "zq38a01": {
    "text": "Straw hat… red string…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "Don't push Brother…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "Push Brother?",
    "emotion": "愣住，短促",
    "say": "Pushed me?"
  },
  "zq38a04": {
    "text": "Who pushed?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "Medicine's ready!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "The fever's too high,",
    "emotion": "急，快",
    "say": "Fever's too high,"
  },
  "zq38a07": {
    "text": "it's not working.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "No doctor in the village.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "The town's under curfew,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "the gates stay shut.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "An hour's ride,",
    "emotion": "冷靜，快"
  },
  "zq38a12": {
    "text": "she can't wait.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "Urgent mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "break Xiaohe's fever by dawn.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "Give me the horse.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "I trust you.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "A-Ling can ride?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "That's a cavalry mount.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "Who is she, really?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "East Street, Doctor Bai!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "Curfew!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "Bandits about, turn back!",
    "emotion": "大聲，不耐煩"
  },
  "zq38a23": {
    "text": "Women don't ride horses!",
    "emotion": "嘲笑，一口氣",
    "say": "Women don't ride!"
  },
  "zq38a24": {
    "text": "Move.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "One more step and we take you!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "Crossbows!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "After her!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "Brother…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "She drank it!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "I'm here.",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "Hold on till A-Ling's back.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "Doctor Bai!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "Open up!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "Coming, coming,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "quit that banging.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "Freeze!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "Crossbows, aim at her.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "Loose—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
