{
  "zq38a01": {
    "text": "밀짚모자… 빨간 끈…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "오빠 밀지 마…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "날 밀었다고?",
    "emotion": "愣住，手停在半空"
  },
  "zq38a04": {
    "text": "누가?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "약 다 됐어!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "열이 너무 높아,",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "약이 안 들어.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "마을엔 의원이 없어.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "읍내는 통금이야,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "성문이 안 열려.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "반 시진 거리야,",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "못 버텨.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "긴급 미션:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "동트기 전, 샤오허 해열.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "말 줘.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "널 믿어.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "아링 언니가 말을 타?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "저건 기병 타는 법이야.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "대체 누구야?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "동쪽 길, 바이 의원!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "통금이다!",
    "say": "통금!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "도적 떼다, 돌아가!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "여자가 무슨 말을 타!",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "비켜.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "더 오면 잡는다!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "쇠뇌수!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "쫓아!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "오빠…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "마셨어!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "오빠 여기 있어.",
    "say": "여기 있어.",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "아링 올 때까지 버텨.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "바이 의원!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "열어!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "간다, 간다,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "그만 두드려.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "꼼짝 마!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "쇠뇌수, 겨눠라.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "쏴—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
