{
  "zq38a01": {
    "text": "Sombrero… cordón rojo…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "No empujes a Hermano…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "¿Empujarme?",
    "emotion": "愣住，手停在半空"
  },
  "zq38a04": {
    "text": "¿Quién?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "¡Ya está la medicina!",
    "say": "¡Ya está!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "Arde demasiado,",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "no le hace nada.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "Aquí no hay médico.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "Hay toque de queda,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "no abren las puertas.",
    "say": "no abren.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "Una hora de camino,",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "no aguanta.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "Misión urgente:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "al alba, Xiaohe sin fiebre.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "Dame el caballo.",
    "say": "El caballo.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "Confío en ti.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "¡¿A-Ling sabe montar?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "Eso es de caballería.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "¿Quién es ella?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "¡Calle Este, doctor Bai!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "¡Toque de queda!",
    "say": "¡Alto!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "¡Bandidos! ¡Vuelve!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "¡Una mujer a caballo!",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "Apártense.",
    "say": "Paso.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "¡Otro paso y te detengo!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "¡Arqueros!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "¡Síganla!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "Hermano…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "¡Se lo tomó!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "Aquí estoy.",
    "say": "Aquí.",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "Aguanta hasta que vuelva A-Ling.",
    "say": "Aguanta, ya viene A-Ling.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "¡Doctor Bai!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "¡Abra!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "Ya voy, ya voy,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "qué escándalo.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "¡Quieta!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "Arqueros, apunten.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "Fuego—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
