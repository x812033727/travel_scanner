{
  "zq38a01": {
    "text": "Topi jerami… tali merah…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "Jangan dorong Kakak…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "Dorong Kakak?",
    "emotion": "愣住，短促"
  },
  "zq38a04": {
    "text": "Siapa?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "Obatnya jadi!",
    "emotion": "急，快"
  },
  "zq38a06": {
    "text": "Demamnya parah,",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "nggak mempan.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "Di desa tak ada tabib.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "Kota lagi jam malam,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "gerbang tutup.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "Sejam perjalanan,",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "dia nggak kuat.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "Misi darurat:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "sebelum fajar, demam Xiaohe turun.",
    "say": "sebelum subuh, demam turun.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "Kasih aku kudanya.",
    "say": "Kudanya.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "Aku percaya kamu.",
    "say": "Aku percaya.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "Kak A-Ling bisa berkuda?!",
    "say": "A-Ling bisa berkuda?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "Itu gaya kavaleri.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "Siapa dia sebenarnya?",
    "say": "Dia siapa, sih?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "Jalan Timur, Tabib Bai!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "Jam malam!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "Ada perampok, balik!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "Cewek kok naik kuda!",
    "emotion": "一口氣，快",
    "say": "Cewek naik kuda!"
  },
  "zq38a24": {
    "text": "Minggir.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "Maju lagi, kutangkap!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "Pemanah!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "Kejar!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "Kak…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "Diminum!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "Kakak di sini.",
    "say": "Di sini.",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "Bertahan sampai A-Ling pulang.",
    "say": "Tahan, tunggu A-Ling.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "Tabib Bai!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "Buka!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "Iya, iya,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "berisik amat.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "Diam!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "Pemanah, bidik dia.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "Tembak—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
