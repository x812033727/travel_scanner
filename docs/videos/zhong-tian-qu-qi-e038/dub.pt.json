{
  "zq38a01": {
    "text": "Chapéu… fita vermelha…",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "Não empurra o mano…",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "Me empurrar?",
    "emotion": "愣住，手停在半空"
  },
  "zq38a04": {
    "text": "Quem?",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "O remédio tá pronto!",
    "say": "Tá pronto!",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "Febre alta demais,",
    "emotion": "聲音發抖"
  },
  "zq38a07": {
    "text": "não adianta.",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "Aqui não tem médico.",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "Toque de recolher,",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "portão fechado.",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "Uma hora de estrada,",
    "emotion": "算著時間"
  },
  "zq38a12": {
    "text": "não aguenta.",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "Missão urgente:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "ao raiar, Xiaohe sem febre.",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "Me dá o cavalo.",
    "say": "O cavalo.",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "Confio em você.",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "A-Ling sabe montar?!",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "Isso é de cavalaria.",
    "emotion": "看出來了，很輕"
  },
  "zq38a19": {
    "text": "Quem é ela, afinal?",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "Rua Leste, Doutor Bai!",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "Toque de recolher!",
    "say": "Alto!",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "Tem bandido, volta!",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "Mulher a cavalo, é?",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "Saiam.",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "Avança e te prendo!",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "Arqueiros!",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "Atrás dela!",
    "say": "Peguem!",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "Mano…",
    "emotion": "半醒，奶聲很弱"
  },
  "zq38a29": {
    "text": "Ela tomou!",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "O mano tá aqui.",
    "say": "Tô aqui.",
    "emotion": "貼著她的手說"
  },
  "zq38a31": {
    "text": "Aguenta até a A-Ling voltar.",
    "say": "Aguenta, a A-Ling já vem.",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "Doutor Bai!",
    "emotion": "拍門，聲音第一次這麼大"
  },
  "zq38a33": {
    "text": "Abre!",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "Já vai, já vai,",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "que barulho.",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "Parada!",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "Arqueiros, mirem.",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "Fogo—",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
