{
  "zq38a01": {
    "text": "麦わら帽……赤い紐……",
    "emotion": "燒糊塗了，眼睛半閉，迷迷糊糊"
  },
  "zq38a02": {
    "text": "お兄ちゃんを押さないで……",
    "say": "お兄ちゃん、押さないで……",
    "emotion": "說胡話，帶著哭腔"
  },
  "zq38a03": {
    "text": "俺を押した？",
    "emotion": "愣住，短促",
    "say": "押した？"
  },
  "zq38a04": {
    "text": "誰が？",
    "emotion": "追問，但她沒再答"
  },
  "zq38a05": {
    "text": "薬できた！",
    "emotion": "急，被熱氣燙到"
  },
  "zq38a06": {
    "text": "熱が高すぎる、",
    "emotion": "急，快",
    "say": "熱が高い、"
  },
  "zq38a07": {
    "text": "薬が効かない。",
    "emotion": "快哭了"
  },
  "zq38a08": {
    "text": "村に医者はいない。",
    "emotion": "說給自己聽，很低"
  },
  "zq38a09": {
    "text": "県城は外出禁止、",
    "emotion": "剛從穀倉趕來，喘"
  },
  "zq38a10": {
    "text": "門は開かない。",
    "emotion": "直說，不留餘地"
  },
  "zq38a11": {
    "text": "一時間の道のり、",
    "emotion": "冷靜，快",
    "say": "一時間の道、"
  },
  "zq38a12": {
    "text": "待てない。",
    "emotion": "咬牙"
  },
  "zq38a13": {
    "text": "緊急任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq38a14": {
    "text": "夜明け前、シャオホー解熱。",
    "emotion": "平板電子音，一字一頓"
  },
  "zq38a15": {
    "text": "馬を貸して。",
    "say": "馬を。",
    "emotion": "冷，三個字，不解釋"
  },
  "zq38a16": {
    "text": "信じる。",
    "emotion": "什麼都不問，很穩"
  },
  "zq38a17": {
    "text": "アーリン姉さん、馬に乗れるの？！",
    "say": "姉さん、乗れるの？！",
    "emotion": "畫外，驚呼"
  },
  "zq38a18": {
    "text": "あれは騎兵の乗り方。",
    "emotion": "輕，快",
    "say": "騎兵の乗り方。"
  },
  "zq38a19": {
    "text": "一体、何者？",
    "emotion": "自言自語"
  },
  "zq38a20": {
    "text": "東通り、バイ先生！",
    "emotion": "追到門口大喊"
  },
  "zq38a21": {
    "text": "外出禁止だ！",
    "say": "止まれ！",
    "emotion": "吼"
  },
  "zq38a22": {
    "text": "流賊が出る、帰れ！",
    "emotion": "吼，不耐煩"
  },
  "zq38a23": {
    "text": "女が馬かよ！",
    "emotion": "起鬨，笑得很賤"
  },
  "zq38a24": {
    "text": "どいて。",
    "emotion": "冷到底，兩個字"
  },
  "zq38a25": {
    "text": "近づけば捕らえる！",
    "emotion": "喝令"
  },
  "zq38a26": {
    "text": "弩兵！",
    "emotion": "畫外，吼"
  },
  "zq38a27": {
    "text": "追え！",
    "emotion": "畫外，吼"
  },
  "zq38a28": {
    "text": "お兄ちゃん……",
    "say": "兄ちゃん…",
    "emotion": "奶聲，輕"
  },
  "zq38a29": {
    "text": "飲んだ！",
    "emotion": "畫外，鬆一口氣"
  },
  "zq38a30": {
    "text": "ここにいるぞ。",
    "say": "いるぞ。",
    "emotion": "輕，短促"
  },
  "zq38a31": {
    "text": "アーリンが戻るまで頑張れ。",
    "say": "アーリンが戻るまで。",
    "emotion": "低，像在求她"
  },
  "zq38a32": {
    "text": "バイ先生！",
    "emotion": "大聲，短促"
  },
  "zq38a33": {
    "text": "開けて！",
    "emotion": "急"
  },
  "zq38a34": {
    "text": "はいはい、今行く、",
    "emotion": "被拍門聲吵醒，慢，不慌"
  },
  "zq38a35": {
    "text": "そう叩くな。",
    "emotion": "嘟囔"
  },
  "zq38a36": {
    "text": "動くな！",
    "emotion": "畫外，吼"
  },
  "zq38a37": {
    "text": "弩兵、女を狙え。",
    "emotion": "低，狠"
  },
  "zq38a38": {
    "text": "放て——",
    "emotion": "舉起的手往下落，切在最高點"
  }
}
