  "lines": {
    "lz101": {
      "source_hash": "b2326797f9a3",
      "text": "생각했습니까? 리치 한입에 수천 리. 송 지방지는 사람·말의 사상도 적었습니다."
    },
    "lz102": {
      "source_hash": "f94586bb691a",
      "text": "만당의 두목은 화청궁을 돌아보며 시에 남깁니다."
    },
    "lz103": {
      "source_hash": "cc9c9f0b86d2",
      "text": "한 기수 붉은 먼지, 귀비 웃네. 리치인 줄 아무도 몰랐네."
    },
    "lz104": {
      "source_hash": "f881972bb31e",
      "text": "『신당서』는 도성에 와도 맛이 그대로였답니다."
    },
    "lz105": {
      "source_hash": "607f7a05c03e",
      "text": "백거이는 딴 지 사흘이면 맛이 변한다고 씁니다."
    },
    "lz105p2": {
      "source_hash": "6fd33d7dc8f2",
      "text": "저는 이상했습니다."
    },
    "lz106": {
      "source_hash": "a321f120040c",
      "text": "당 조서가 남긴, 길을 재촉한 압박;"
    },
    "lz108": {
      "source_hash": "136791e6c819",
      "text": "한 송나라 학자는 같은 책에서 두 번 썼습니다."
    },
    "v2a0011": {
      "source_hash": "849248872c91",
      "text": "리치 한 바구니로 당송 수백 년 기록을 좇습니다."
    },
    "lz110": {
      "source_hash": "caea9a4d71a7",
      "text": "양귀비 리치는 어떻게 장안에 왔습니까?"
    },
    "lz201": {
      "source_hash": "9c883a101006",
      "text": "『신당서』의 네 글자, ‘치기전송’입니다."
    },
    "lz201p2": {
      "source_hash": "5e4376257d13",
      "text": "기마 인원이 역마다 이어 나릅니다."
    },
    "v2a0021": {
      "source_hash": "6e567078a0bb",
      "text": "명을 받으면 말의 속도만 물을 순 없습니다."
    },
    "v2a0031": {
      "source_hash": "323258e6f843",
      "text": "역별 인계와 지체가 압박입니다."
    },
    "lz202": {
      "source_hash": "61f9c62a3c5d",
      "text": "당의 역참은 약 30리마다, 전국 1,600여 곳."
    },
    "lz203": {
      "source_hash": "552c336508cf",
      "text": "기수는 하루 몇 역을 갑니까?"
    },
    "v2a0041": {
      "source_hash": "fe5e31333379",
      "text": "역참엔 조정 규칙이 있습니다."
    },
    "lz204": {
      "source_hash": "daa2b682443a",
      "text": "급하지 않은 공무는 하루 네 역을 못 넘습니다."
    },
    "lz205": {
      "source_hash": "6b3f1a7fe620",
      "text": "급무는 통행증에 하루 역 수를 씁니다."
    },
    "lz206": {
      "source_hash": "6d3741264e70",
      "text": "하루 지연, 곤장 80대."
    },
    "v2a0072": {
      "source_hash": "c36ae5a034e7",
      "text": "규칙은 사람을 재촉해도 부패를 이깁니까?"
    },
    "lz207": {
      "source_hash": "e08b6015edf6",
      "text": "앞의 조서는 천보 5년 7월에 내려옵니다."
    },
    "lz208": {
      "source_hash": "60aaab0bdaa4",
      "text": "좌천 관리가 길을 지체하자, 그 뒤 죄가 무거우면,"
    },
    "lz208p2": {
      "source_hash": "4e41ffccf09f",
      "text": "하루 열 역 이상 갑니다."
    },
    "v2a0081": {
      "source_hash": "b1b4eb3d199d",
      "text": "리치도 꼭 그 속도로 보냈습니까?"
    },
    "v2a0091": {
      "source_hash": "a862d684f17f",
      "text": "재촉 대상은 좌천 관리. 누가 급히 갈지도 조건이 있습니다."
    },
    "lz209": {
      "source_hash": "aa15ce2f7d85",
      "text": "열 역은 약 300리입니다."
    },
    "lz210": {
      "source_hash": "5a000b568e7a",
      "text": "『자치통감』 같은 권 인접 기록은:"
    },
    "lz211": {
      "source_hash": "474cf5b6d8ed",
      "text": "그 뒤 좌천된 이들 중 여럿이 도착 전 죽었습니다."
    },
    "v2a0101": {
      "source_hash": "ebb667a31524",
      "text": "저는 이때 시 속 먼지의 무게를 느꼈습니다."
    },
    "lz212": {
      "source_hash": "0319c66de7d7",
      "text": "리치는 며칠 버팁니까?"
    },
    "v2a0121": {
      "source_hash": "8374be2bf1b6",
      "text": "더 빨리? 싶지만,"
    },
    "v2a0122": {
      "source_hash": "d7d7174b57bd",
      "text": "리치는 황명을 받아도 며칠 더 못 기다립니다."
    },
    "v2a0131": {
      "source_hash": "b05bb5c5c724",
      "text": "당인 스스로 남긴 난제입니다."
    },
    "lz213": {
      "source_hash": "3472270187f9",
      "text": "당 이조 『당국사보』: 리치는 한여름에 익고,"
    },
    "lz213p2": {
      "source_hash": "ff20938b70d7",
      "text": "밤새 상합니다."
    },
    "lz214": {
      "source_hash": "348d439d4db2",
      "text": "앞의 백거이 글은 과일 변화도 이어 씁니다."
    },
    "lz215": {
      "source_hash": "481e0e7833a2",
      "text": "따면 하루에 색, 이틀에 향이 변하고, 나흘 닷새면 색향미가 사라집니다."
    },
    "v2a0141": {
      "source_hash": "9b1c6613be19",
      "text": "색·향·맛을 따로 썼지, 사흘째 갑자기 상한단 뜻은 아닙니다."
    },
    "v2a0151": {
      "source_hash": "d5b051df57e5",
      "text": "멀쩡해 보여도 겉모양만으로 신선하다고 판단할 수 없습니다."
    },
    "lz216": {
      "source_hash": "4d1925521ddc",
      "text": "충주 관리 때 리치 그림을 그리게 했습니다. 누구에게 보여주려 했습니까?"
    },
    "lz217": {
      "source_hash": "7c65e923e733",
      "text": "생리치 못 본 이들에게."
    },
    "lz218": {
      "source_hash": "607360364565",
      "text": "장안 고관은 봤습니까?"
    },
    "lz219": {
      "source_hash": "429cfe440eb9",
      "text": "개원 때 영남 장구령은 장안에서 리치 맛을 칭찬합니다."
    },
    "lz220": {
      "source_hash": "2564b616c304",
      "text": "대개 모르고 안 믿었습니다."
    },
    "lz221": {
      "source_hash": "40d3395f7f17",
      "text": "장안서 오래 관리였던 백거이도 충주서야,"
    },
    "lz221p2": {
      "source_hash": "8ea8a1dc4352",
      "text": "처음 따 먹었습니다."
    },
    "lz222": {
      "source_hash": "1131aeae8341",
      "text": "장안행 역마의 리치는 어디서 옵니까?"
    },
    "lz301": {
      "source_hash": "a78f9e661656",
      "text": "두보는 방향을 줍니다. 상원 2년 시는 옛 사신을 그립니다."
    },
    "v2a0221": {
      "source_hash": "c88b98d3c0bc",
      "text": "현대 지도는 잠시 잊습니다."
    },
    "v2a0222": {
      "source_hash": "b5efa79729eb",
      "text": "두보는 사신이 어디서 왔는지 썼지,"
    },
    "v2a0231": {
      "source_hash": "3f316643a27f",
      "text": "역참을 하나하나 열거하진 않습니다."
    },
    "lz302": {
      "source_hash": "fe03ad4257d5",
      "text": "그 옛날 남해 사신이 리치를 바치러 내달렸다고."
    },
    "lz303": {
      "source_hash": "effe823f0370",
      "text": "여기서 찾은 당시 중 이 시가 천보에 가장 가깝습니다."
    },
    "v2a0241": {
      "source_hash": "1dd01edca6d6",
      "text": "더 이상한 점도 있습니다. 귀비의 입맛만으로 역로가 설명됩니까?"
    },
    "lz304": {
      "source_hash": "a02cc4088e41",
      "text": "몇 년 뒤엔 현종과 귀비 사후에도,"
    },
    "lz304p2": {
      "source_hash": "a25519b2a1e2",
      "text": "리치는 장안에 간다고 씁니다."
    },
    "lz305": {
      "source_hash": "ec733517e2d0",
      "text": "또 다른 당 시인 포방은 더 과장합니다."
    },
    "lz306": {
      "source_hash": "77026f798352",
      "text": "5월 리치가 익어 아침에 영남 상군을 떠나,"
    },
    "lz306p2": {
      "source_hash": "1137627e8f27",
      "text": "저녁엔 함곡관에 닿습니다."
    },
    "v2a0261": {
      "source_hash": "40f671e55e3d",
      "text": "통쾌한 구절에 말이 스쳐 가는 듯합니다."
    },
    "v2a0271": {
      "source_hash": "6a234e2ab7ca",
      "text": "시의 하루를 일정표에 옮기면 문제가 생깁니다."
    },
    "lz307": {
      "source_hash": "e601c7ddb0c7",
      "text": "제겐 시적 과장, 속도 기록으론 못 씁니다."
    },
    "lz308": {
      "source_hash": "eb8adc11e34b",
      "text": "영남에서 장안은 얼마나 멉니까?"
    },
    "lz309": {
      "source_hash": "d2c00c2a6fb2",
      "text": "당 지지는 영남 광주에서 장안까지 4,200여 리,"
    },
    "lz309p2": {
      "source_hash": "dfd77e43ac09",
      "text": "다른 길은 5,000여 리."
    },
    "v2a0281": {
      "source_hash": "5b0f60916a6f",
      "text": "아침 출발·저녁 도착을 믿으면 수천 리가 시 두 줄로 사라집니다."
    },
    "v2a0291": {
      "source_hash": "ba11cad7ab64",
      "text": "당 사람도 영남에만 리치가 난다 봤습니까?"
    },
    "lz310": {
      "source_hash": "191bf06d7a6b",
      "text": "이조의 밤새 상함, 기억합니까?"
    },
    "lz310p2": {
      "source_hash": "e1e10a538b43",
      "text": "같은 기록 앞부분엔:"
    },
    "lz311": {
      "source_hash": "eb04cf442878",
      "text": "촉 태생 귀비는 리치를 즐겨, 남해산이 촉산보다 좋아,"
    },
    "lz311p2": {
      "source_hash": "6a991ef8f8a0",
      "text": "해마다 급히 보냈답니다."
    },
    "lz312": {
      "source_hash": "4e408c4101f4",
      "text": "이조의 촉은 또 다른 실마리가 됩니다."
    },
    "v2a0321": {
      "source_hash": "a4a2fe31a5e1",
      "text": "태어난 곳이 곧 리치 출발지입니까?"
    },
    "v2a0331": {
      "source_hash": "ea90f0094557",
      "text": "출신·입맛·산지를 한데 엮으면,"
    },
    "v2a0332": {
      "source_hash": "240571cb2b35",
      "text": "스스로 그린 길."
    },
    "lz313": {
      "source_hash": "69e56f327ad0",
      "text": "만당 소설 『감택요』의 여산 한 장면:"
    },
    "lz314": {
      "source_hash": "df6e5203c2b2",
      "text": "귀비 생일, 현종은 장생전서 신곡을 듣자 마침 남해 리치가 옵니다."
    },
    "lz315": {
      "source_hash": "652b4074670c",
      "text": "곡명은 「여지향」입니다."
    },
    "v2a0341": {
      "source_hash": "12b8131b7ec0",
      "text": "생일·신곡·갓 온 리치까지 장면이 온전합니다."
    },
    "v2a0351": {
      "source_hash": "78d70ce8cf6d",
      "text": "소설 속 장면. 날짜가 자세해도,"
    },
    "v2a0352": {
      "source_hash": "6cade3c4ca45",
      "text": "꼭 있었던 일입니까?"
    },
    "lz316": {
      "source_hash": "9919ef0fa479",
      "text": "송 사마광의 『자치통감』은 직설적입니다."
    },
    "lz317": {
      "source_hash": "29b50e5772b3",
      "text": "이조의 남해를 이 책은 영남이라 씁니다. 해마다 역마로 보냈다고."
    },
    "lz318": {
      "source_hash": "01b0234b0cdd",
      "text": "이번 조사에서 살핀 사서 중 영남을 명시한 건 이 대목뿐입니다."
    },
    "lz319": {
      "source_hash": "3d7801439f26",
      "text": "단, 천보에서 이삼백 년 뒤입니다."
    },
    "lz320": {
      "source_hash": "999de42684e6",
      "text": "같은 송나라에 다른 곳을 댄 이도 있습니다. 어디입니까?"
    },
    "lz401": {
      "source_hash": "9e9bea48d931",
      "text": "쓰촨 부주. 북송 채양은 『여지보』에 씁니다."
    },
    "lz402": {
      "source_hash": "34a1c12e5ce5",
      "text": "천보 부주는 매년 역마로 보냈답니다."
    },
    "v2a0361": {
      "source_hash": "6442d6b6d2d8",
      "text": "남해 사신을 좇다 송인은 바구니를 쓰촨에 옮깁니다."
    },
    "v2a0371": {
      "source_hash": "2ae41bed8277",
      "text": "가까우면 꼭 신선합니까?"
    },
    "lz403": {
      "source_hash": "3b2e3fd335c0",
      "text": "이 자료에서 가장 이른 부주 명시 글"
    },
    "lz404": {
      "source_hash": "a30bafdc8ff9",
      "text": "그는 아무리 빨라도 도착하면 색향미는 거의 안 남는답니다."
    },
    "lz405": {
      "source_hash": "3d4fbdf3815d",
      "text": "이조의 촉이 돌아옵니다. 부주는 쓰촨입니다."
    },
    "lz406": {
      "source_hash": "95eecb153768",
      "text": "소동파도 시에 단 자주에서 말합니다."
    },
    "lz407": {
      "source_hash": "6e6461cf8556",
      "text": "천보 때 아마 부주 리치를 자오곡 길로 보내,"
    },
    "lz407p2": {
      "source_hash": "364c98b735b4",
      "text": "장안으로."
    },
    "lz408": {
      "source_hash": "c1449ca3dd4a",
      "text": "그 길은 몇 리?"
    },
    "v2a0401": {
      "source_hash": "3021970863c7",
      "text": "자주의 한 글자, 개는 아마라는 뜻. 놓치면 안 됩니다."
    },
    "v2a0411": {
      "source_hash": "839862c738b7",
      "text": "저는 후대 길 단정보다 이 유보가,"
    },
    "v2a0412": {
      "source_hash": "4e06182f7c0d",
      "text": "더 경청할 말입니다"
    },
    "lz409": {
      "source_hash": "98a1c4eee3cb",
      "text": "당송 지지: 부주~장안 2,200~2,300여 리,"
    },
    "lz410": {
      "source_hash": "5fc612a8e954",
      "text": "영남 길 절반쯤입니다."
    },
    "lz411": {
      "source_hash": "5bf841e12bdf",
      "text": "충주 백거이 기억합니까?"
    },
    "lz411p2": {
      "source_hash": "e096d3409e2b",
      "text": "충주는 부주 바로 하류."
    },
    "lz412": {
      "source_hash": "fa4e169e434c",
      "text": "그곳 리치도 도성에 갔습니까?"
    },
    "lz413": {
      "source_hash": "d48aa0abfaaf",
      "text": "아닙니다. 이곳 리치는 공물이 못 돼 도성에 못 간다고 썼습니다."
    },
    "lz414": {
      "source_hash": "5fa608747220",
      "text": "백거이 때 일로 천보 때도 없었다고 증명할 순 없습니다."
    },
    "v2a0421": {
      "source_hash": "5d6bec23eb46",
      "text": "백거이 때 한 구절로,"
    },
    "v2a0422": {
      "source_hash": "f1992a7d2757",
      "text": "앞선 귀비 때를 판결할 순 없습니다. 세월이 달라,"
    },
    "v2a0431": {
      "source_hash": "3e33a4e740f7",
      "text": "공납도 달랐을 수 있습니다. 시는 그때만 말합니다."
    },
    "v2a0441": {
      "source_hash": "f3143cd66301",
      "text": "공물 목록의 리치는 꼭 생과입니까?"
    },
    "v2a0451": {
      "source_hash": "446cd5fb79ec",
      "text": "당엔 여지전도 있었습니다. 채양은 껍질을 벗기고 즙을 빼 꿀로 끓인다고 씁니다."
    },
    "v2a0461": {
      "source_hash": "22c1d46ebad1",
      "text": "제겐 유용한 지적. 사서가 리치 운송을 썼다면,"
    },
    "v2a0462": {
      "source_hash": "f62c3de903fd",
      "text": "어떤 리치인지도 물어야 합니다. 가공 보존식은,"
    },
    "v2a0471": {
      "source_hash": "b111ee9244cb",
      "text": "생과 운송법을 설명하진 못합니다. 그럼 부주설의 근거는 무엇입니까?"
    },
    "lz415": {
      "source_hash": "e5a8e01d2366",
      "text": "그 근거는 앞서 두 번 쓴 학자 오증도 찾았습니다."
    },
    "v2a0481": {
      "source_hash": "49776991cb7a",
      "text": "자료 속 한 사람의 전후 말이 다르면,"
    },
    "v2a0482": {
      "source_hash": "2e1a7141c258",
      "text": "먼저 어느 쪽을 믿습니까?"
    },
    "v2a0491": {
      "source_hash": "7568e9847eb8",
      "text": "학자 오증이 남긴 글은 답이 어떻게 만들어지는지 보여 줍니다."
    },
    "lz416": {
      "source_hash": "744f12311a95",
      "text": "먼저 사서·두보 시는 남쪽이라며,"
    },
    "lz416p2": {
      "source_hash": "319396f96590",
      "text": "명황의 리치는 영남산, 명백하답니다."
    },
    "v2a0501": {
      "source_hash": "7c1fd87a5dd9",
      "text": "명백하다, 더없이 뚜렷하다는 뜻입니다. 이토록 단언하니,"
    },
    "v2a0511": {
      "source_hash": "ad949da14799",
      "text": "저는 그 뒤 뭘 봤기에,"
    },
    "v2a0512": {
      "source_hash": "2aa2fe3ee2af",
      "text": "원래 말을 바꿨을지 궁금합니다."
    },
    "lz417": {
      "source_hash": "74525a3abd5e",
      "text": "그런데 같은 책 뒤쪽에선 말을 바꿉니다."
    },
    "lz418": {
      "source_hash": "7de68cf85a0f",
      "text": "『부주도경』을 읽고 현지에 묻습니다."
    },
    "lz419": {
      "source_hash": "2a9478425c9e",
      "text": "부주엔 비자원, 장안행 지름길도 있어,"
    },
    "lz419p2": {
      "source_hash": "6e2e0e1adad9",
      "text": "7일도 안 걸려,"
    },
    "lz420": {
      "source_hash": "393ce65e6800",
      "text": "동파도 쓰촨 사람이라 실정을 안답니다."
    },
    "v2a0521": {
      "source_hash": "f52b68fc9915",
      "text": "익숙한 이유입니다. 현지인이니 알 거라는 겁니다."
    },
    "v2a0522": {
      "source_hash": "1c9b7590ea3b",
      "text": "고향 길을 알면,"
    },
    "v2a0531": {
      "source_hash": "aa54e8b8e721",
      "text": "수백 년 전 그 여정도 압니까?"
    },
    "lz421": {
      "source_hash": "ef82b992a75e",
      "text": "제겐 지방지·현지인 말로 번복한 게 의아합니다"
    },
    "lz421p2": {
      "source_hash": "56fee3980789",
      "text": "당 운송 문서 없이."
    },
    "v2a0541": {
      "source_hash": "64d667337858",
      "text": "과수원이 과일을 기르는 데서 이야기의 증거가 됩니다."
    },
    "v2a0551": {
      "source_hash": "e975930399d8",
      "text": "그 과수원과 귀비를 정말 어떻게 잇습니까?"
    },
    "lz422": {
      "source_hash": "d4bfcf51a0e2",
      "text": "비자원은 훗날 어떻게 쓰입니까?"
    },
    "lz423": {
      "source_hash": "51de09a23cc7",
      "text": "남송 지방지 『여지기승』은 비자원을 부주 고적에 넣습니다."
    },
    "lz424": {
      "source_hash": "53f2e4fe3ceb",
      "text": "일곱 낮과 일곱 밤 만에 수도에 전달됐고,"
    },
    "lz424p2": {
      "source_hash": "d648952e9a94",
      "text": "앞의 사람과 말 사상은 이 송 지방지에 나옵니다."
    },
    "lz425": {
      "source_hash": "c2aa11aaeac7",
      "text": "앞의 두목 시 기억합니까?"
    },
    "lz425p2": {
      "source_hash": "e298b4ad9705",
      "text": "지방지는 비자원 항목에 그 시를 옮겨 이곳 얘기라 합니다."
    },
    "v2a0561": {
      "source_hash": "5b8bc7b148f4",
      "text": "흥미롭게 돌아옵니다"
    },
    "v2a0562": {
      "source_hash": "011ed726fe64",
      "text": "과수원으로 두목 시를 풀려 했는데,"
    },
    "v2a0571": {
      "source_hash": "bec8a4e9dad7",
      "text": "지방지는 두목 시로 과수원·귀비 관계를 입증합니다."
    },
    "lz426": {
      "source_hash": "1bc105a297cf",
      "text": "후대 『방여승람』은 앞에 네 글자를 더해 베낍니다."
    },
    "lz426p2": {
      "source_hash": "f7b6936ae38b",
      "text": "도경에 전해진다."
    },
    "v2a0581": {
      "source_hash": "42b17b7fef4d",
      "text": "저는 그 두 글자, '전해진다'가 중요합니다."
    },
    "v2a0582": {
      "source_hash": "3db007101acf",
      "text": "후대 독자가 일수만 남기고 그 어투를 빼면,"
    },
    "v2a0591": {
      "source_hash": "a831d6838ece",
      "text": "지역 설이 직접 인계한 기록처럼 보입니다."
    },
    "lz427": {
      "source_hash": "aa54d59813f0",
      "text": "송인 말인 7일 밤낮으로 세면 하루 몇 리입니까?"
    },
    "lz428": {
      "source_hash": "6d2323dea2ee",
      "text": "300여 리. 천보 5년 조서가 재촉한 속도와 비슷합니다."
    },
    "v2a0601": {
      "source_hash": "224227443ba5",
      "text": "이 속도는 송인의 일수로,"
    },
    "v2a0611": {
      "source_hash": "46db83a72481",
      "text": "당 지지의 거리를 나눈 값입니다. 압박은 보이지만,"
    },
    "v2a0621": {
      "source_hash": "30552915993a",
      "text": "당의 인수증을 찾은 건 아닙니다."
    },
    "lz429": {
      "source_hash": "bcc76b6a32a8",
      "text": "그곳 리치 품질은?"
    },
    "lz430": {
      "source_hash": "fdb5bc6e30c9",
      "text": "순희 4년 7월, 범성대는 부주를 지나,"
    },
    "lz431": {
      "source_hash": "d6c6b2355466",
      "text": "품질이 낮다고 씁니다."
    },
    "lz432": {
      "source_hash": "d8aa055f2892",
      "text": "지방지도 부주 리치는 귀비 덕에 유명할 뿐,"
    },
    "lz432p2": {
      "source_hash": "cf47f3e6c204",
      "text": "노주·서주만 못하답니다."
    },
    "lz433": {
      "source_hash": "b4d58784cc26",
      "text": "도착 철도 의문입니다."
    },
    "lz433p2": {
      "source_hash": "e2bcec799d61",
      "text": "당시 귀비는 화청궁에 있었습니까?"
    },
    "lz501": {
      "source_hash": "1fe46eb6ec4b",
      "text": "북송 진정민은 숭녕·대관 때 이 의문을 제기합니다."
    },
    "lz502": {
      "source_hash": "8f24b5bcaf31",
      "text": "현종은 늘 10월 여산행, 봄엔 환궁한다며,"
    },
    "lz502p2": {
      "source_hash": "8a538d8e2bfa",
      "text": "이조의 익는 철, 기억합니까?"
    },
    "v2a0651": {
      "source_hash": "bc79d38fa577",
      "text": "과일을 기다리기 전 수령자 위치부터 알아야 합니다."
    },
    "v2a0661": {
      "source_hash": "67bc8956a26f",
      "text": "제겐 송 문인이 달력을 맞추는 듯합니다. 익을 때,"
    },
    "v2a0662": {
      "source_hash": "832ada7c925b",
      "text": "이미 떠났습니까?"
    },
    "lz503": {
      "source_hash": "052f474a3c80",
      "text": "그의 결론은 시는 좋아도 사실과 다르답니다."
    },
    "lz504": {
      "source_hash": "f3916ad14ff1",
      "text": "또 다른 송인 왕관국도 진정민 편에 섭니다."
    },
    "v2a0671": {
      "source_hash": "4541114fc1ac",
      "text": "당에 리치 운송이 없단 말은 아닙니다. 두목의 장면이,"
    },
    "v2a0681": {
      "source_hash": "242e977e4b90",
      "text": "화청궁에서 가능했는지 묻습니다. 가장 익숙한 장면이,"
    },
    "v2a0682": {
      "source_hash": "48460a4f94c5",
      "text": "갑자기 대조가 가장 어렵습니다."
    },
    "lz505": {
      "source_hash": "abf91c756320",
      "text": "두목을 변호한 이도 있습니다. 정대창."
    },
    "lz506": {
      "source_hash": "82cb4ecb4466",
      "text": "『감택요』 여산 장면, 기억합니까?"
    },
    "lz506p2": {
      "source_hash": "18b2f9c007ff",
      "text": "정대창은 그 날짜를 꺼냅니다."
    },
    "lz507": {
      "source_hash": "08feef2f08c9",
      "text": "천보 14년 6월 1일, 귀비 생일, 현종은 여산에 있습니다."
    },
    "lz508": {
      "source_hash": "acbb7a7e001e",
      "text": "또 다른 필기는 매년 7월 7일 밤에,"
    },
    "lz508p2": {
      "source_hash": "b778dc3ea19a",
      "text": "현종·귀비는 화청궁서 노닐며 연회했답니다."
    },
    "lz509": {
      "source_hash": "2257ce6909d1",
      "text": "백거이 「장한가」도: 7월 7일 장생전."
    },
    "lz510": {
      "source_hash": "ad0b2198842e",
      "text": "그는 두목이 당시 전해진 실화를 썼다고 말합니다."
    },
    "v2a0691": {
      "source_hash": "d34889eaff4c",
      "text": "이야기의 날짜로 거꾸로 시를 입증합니다."
    },
    "v2a0701": {
      "source_hash": "daf7d7774cfc",
      "text": "소설에 날짜가 있으면 시를 입증합니까?"
    },
    "v2a0711": {
      "source_hash": "dbbdc6c555b8",
      "text": "이젠 어떤 글을 믿을지 겨룹니다."
    },
    "lz511": {
      "source_hash": "a5c1404c420d",
      "text": "제겐 변호의 핵심은 소설·필기·시로,"
    },
    "lz511p2": {
      "source_hash": "42fbce5ced9e",
      "text": "날짜를 대조할 수 있느냐입니다."
    },
    "lz512": {
      "source_hash": "5d7aab46dc39",
      "text": "사서는 어떻습니까?"
    },
    "lz513": {
      "source_hash": "cbb354cce770",
      "text": "사서는 여산행 수십 번을 적는데, 대개 겨울입니다."
    },
    "lz514": {
      "source_hash": "7c7710a1d0f3",
      "text": "『구당서』 현종 본기는 천보 8년 여름 4월에:"
    },
    "lz515": {
      "source_hash": "3c754a95f730",
      "text": "화청궁 관풍루 행차. 한 줄뿐, 체류 기간은 없습니다"
    },
    "lz516": {
      "source_hash": "bb5431653e17",
      "text": "『신당서』 본기와 『자치통감』은 이 일을 안 적었습니다."
    },
    "v2a0721": {
      "source_hash": "1c14684813e4",
      "text": "한 줄에 전혀 안 갔단 건 과장입니다. 이 예외가,"
    },
    "v2a0722": {
      "source_hash": "ce0eaf96fdec",
      "text": "리치도 그날 도착했음을 증명할 수 있습니까?"
    },
    "v2a0731": {
      "source_hash": "be0e1b01c604",
      "text": "저는 아직 아니라고 봅니다. 그 기록엔 리치도 그날 왔다는 말이 없습니다."
    },
    "lz517": {
      "source_hash": "9043c5024776",
      "text": "두목의 장시도 화청궁을 8월에 씁니다."
    },
    "lz517p2": {
      "source_hash": "01587e9afe67",
      "text": "8월 누대는 서늘하다."
    },
    "v2a0741": {
      "source_hash": "de68295dfa0f",
      "text": "두목 시를 모두 황제 달력에 넣을 필요는 없습니다."
    },
    "v2a0751": {
      "source_hash": "03b8f76775ca",
      "text": "그 붉은 먼지 속 기수가 남긴 건 여정입니까, 한 장면입니까?"
    },
    "v2a0752": {
      "source_hash": "33080089e6ee",
      "text": "그는 성세와 황폐를 돌아보며 썼습니다."
    },
    "lz518": {
      "source_hash": "b5c980514904",
      "text": "앞의 붉은 먼지 속 기수, 기억합니까?"
    },
    "lz518p2": {
      "source_hash": "410cfed20612",
      "text": "같은 장시의 황폐한 화청궁엔 흩어진 리치 바구니뿐입니다."
    },
    "v2a0791": {
      "source_hash": "7a82fa879192",
      "text": "맛 그대로와 백거이의 사흘 뒤 변한 맛, 기억합니까?"
    },
    "v2a0801": {
      "source_hash": "d35f59a8f1cb",
      "text": "송대 편찬 『신당서』는 귀비를 되짚고,"
    },
    "v2a0811": {
      "source_hash": "c86d7d2607a9",
      "text": "백거이는 당인의 과일 관찰을 적습니다."
    },
    "v2a0821": {
      "source_hash": "b5670ebd9ae3",
      "text": "같은 한 묶음의 과일 검수표가 아니니 보존 성공 실험으로 엮을 순 없습니다."
    },
    "lz519": {
      "source_hash": "24e6ae4c1ee9",
      "text": "앞의 리치, 사서는 운송법을 줍니다"
    },
    "lz519p2": {
      "source_hash": "d11cfe4ea0d9",
      "text": "산지·일수·신선도는 미해결 기록에 남습니다."
    },
    "lz520": {
      "source_hash": "b3a858093483",
      "text": "장안서 이 리치를 기다리면 먼저 산지입니까,"
    },
    "lz520p2": {
      "source_hash": "7ac01730d2da",
      "text": "도착 날짜입니까?"
    },
    "lz520p3": {
      "source_hash": "5d05af678eb6",
      "text": "댓글로 알려 주십시오."
    },
    "lz521": {
      "source_hash": "11d548ae57a2",
      "text": "익숙한 이야기의 새 질문을 함께 찾으려면 기문당안국 구독하십시오."
    }
  }
}
