  "rows": [
    {
      "id": "v2a0281",
      "wav_sha256": "18c996e5a2bd92cc394d780708680be33bbe23df7e117066613ea07277715ffe",
      "old_wav_sha256": "dabcf2d3cc29c58643fac7c90e0b43c19eefe927ee1407a0dc1b9a007f588d34",
      "actual_whisper_text": "如果把招離席致當成答案,幾千里就被兩句詩抹掉了。"
    },
    {
      "id": "lz310",
      "wav_sha256": "d66aa86a451cbfa8eddd9cf9317751edbbde5394af32abf4060c026f2c81350e",
      "old_wav_sha256": "78851d5fb2fe5b634a51e44cbe0e9398834de9932e9b49a9a1e6cc66a125de57",
      "actual_whisper_text": "還記得李肇那句過一夜就壞嗎?"
    },
    {
      "id": "lz318",
      "wav_sha256": "51e4e9f83953e6bc4bb98d68956a7113a82e88697626fb5251131cf7e7f5c9d6",
      "old_wav_sha256": "502c17311a2b86608412ced26ba27615f8d3e4805e1676063b8911e2a061a9fe",
      "actual_whisper_text": "這份檔案刊過的史書裡,只有這一條顯明《嶺南》。"
    },
    {
      "id": "v2a0461",
      "wav_sha256": "5deecb6064583299f1ec3dca3bab406d04846da1c0c2d697e771fbc81c830dcd",
      "old_wav_sha256": "c9d14eed9f66b585c29bf5ed381f4e273ca7faf269f666cfbeb08f191fb9eb85",
      "actual_whisper_text": "我覺得這提醒很實在。史書寫宋立之。"
    },
    {
      "id": "v2a0471",
      "wav_sha256": "8de2d53cbc7e8bccb091d0f624f50f9de1a8518b8f14af0b03bf98e5a89d62d3",
      "old_wav_sha256": "ea86a5bb44f85a2b1afc36fb5c7c8bd879940d95178defc31e17b1df6134f08c",
      "actual_whisper_text": "不能補充鮮果的送法。那說福州的人,憑什麼?"
    },
    {
      "id": "v2a0491",
      "wav_sha256": "26e361039d9f23e22d894fd265efc329c7d51252bda7a609b1b6da7a66c2ce19",
      "old_wav_sha256": "cc227808a90613e6fdd7eb8c462fcc40f8fccdb3a7f2de0a544adf4e55a445b4",
      "actual_whisper_text": "無增的變化偏偏讓我們看到答案是怎麼形成的。"
    },
    {
      "id": "lz422",
      "wav_sha256": "42fc4f5dccf04cb3f0278e808286d36219ce224d3ba8c016c9aea83f979d447d",
      "old_wav_sha256": "6e656934ddadd89a7f7bd1d854f2edec4b52c666f4fe379e51b882903048a803",
      "actual_whisper_text": "那座非紫園後來被寫成什麼樣子?"
    },
    {
      "id": "v2a0611",
      "wav_sha256": "fa593a7a4b49497400a895b095dceafd9cea5139b483dcf3cf97781bfc15e6f2",
      "old_wav_sha256": "ba80dd41f248b2c982cefd3a936b867ad1fdcbddf2904d7c720708bcee299deb",
      "actual_whisper_text": "去除唐代帝制的里程,這樣能看出壓力有多大。"
    },
    {
      "id": "lz506",
      "wav_sha256": "90f0205ad509a102696b02088fcfac95a175041abfc768cf67a4a65a5ae42989",
      "old_wav_sha256": "e711c34917cf1be9b4c236095335cb785f3d209af35a6eb50f55f88916579d20",
      "actual_whisper_text": "還記得甘澤堯離山上那一幕嗎?"
    },
    {
      "id": "lz511",
      "wav_sha256": "a7b8e9ad529a3b30f2ef0f313fffd73e9446d1d2a96dcba89189729ac9bda005",
      "old_wav_sha256": "07c6926b486956e6e8e21f8cf904c8f971be35cf931996c7fe6a44a091293003",
      "actual_whisper_text": "我覺得這場辯護的關鍵是小說、筆記和詩。"
    },
    {
      "id": "v2a0722",
      "wav_sha256": "439ba2649521cfd4a4f9a820dd6c7c97ed520e8c06372c3b64b5a8d5b9f707ad",
      "old_wav_sha256": "639812dd44addb1142e64e392bd12fba6b4be9b590de016ec5f9f540f425c534",
      "actual_whisper_text": "能聽得來立志簽收嗎?"
    },
    {
      "id": "v2a0731",
      "wav_sha256": "e30f4f2b11430509d940a8467d33f75d9a3e7744143ce27707a5945efe6188bf",
      "old_wav_sha256": "60a214e566dd8f3ee71bba7feb42144209dbf3ff8db3d749998722d2fef3af4f",
      "actual_whisper_text": "我覺得還不行,他沒有記下,勵之當天也到了。"
    },
    {
      "id": "lz519",
      "wav_sha256": "6f84639972965cc4a490929ae7ebd5dd8697a48942833bca63a82fef59147c4a",
      "old_wav_sha256": "cdf992c23fed5f3b4616e175f1bb6b9a8c0064ec794e23d950aeba608aa83aee",
      "actual_whisper_text": "開頭內蘭立之,史書給了宋法。"
    }
