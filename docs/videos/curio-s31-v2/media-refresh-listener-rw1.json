  "five_changed_subtitle_strips": [
    {
      "line": "lz318",
      "start_frame": 11367,
      "end_frame": 11510,
      "text": "這份檔案查過的史書裡，\n只有這一條寫明嶺南",
      "file": "frames/sub-a342eddb754886c0.png",
