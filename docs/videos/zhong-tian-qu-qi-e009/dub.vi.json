{
  "zq9a01": "Ca, chọn một đi.",
  "zq9a02": "Đinh.",
  "zq9a03": "Nhiệm vụ ẩn: động phòng hoa chúc.",
  "zq9a04": {
    "text": "Đêm nay, một người vợ bất kỳ, hảo cảm cộng mười.",
    "say": "Đêm nay, một vợ cộng mười."
  },
  "zq9a05": "Thất bại: trừ kỹ năng làm ruộng.",
  "zq9a06": "Một đêm mười điểm?",
  "zq9a07": "Đòi mạng ta à.",
  "zq9a08": "Các tẩu tẩu đang chờ đó!",
  "zq9a09": "Đến đây!",
  "zq9a10": {
    "text": "Đối xong ba quyển sổ này trước đã.",
    "say": "Ba quyển sổ trước."
  },
  "zq9a11": "Sai một khoản, phạt huynh.",
  "zq9a12": "Đêm động phòng… đối sổ?",
  "zq9a13": "Bốn trăm hai mươi bảy lượng ba trăm văn.",
  "zq9a14": "Huynh… không dùng bàn tính?",
  "zq9a15": "Tính nhẩm.",
  "zq9a16": "Trang ba, sai một khoản.",
  "zq9a17": "Tướng công biết tính sổ?",
  "zq9a18": "Hảo cảm cộng hai.",
  "zq9a19": "Còn mười quyển!",
  "zq9a20": "Trước sáng phải xong!",
  "zq9a21": "Ca, đối sổ xong rồi à?",
  "zq9a22": "Tần Sương?",
  "zq9a23": "Ngủ chưa?",
  "zq9a24": "Cửa sổ mở…",
  "zq9a25": "Nửa đêm đi đâu?",
  "zq9a26": "Liều vậy.",
  "zq9a27": "Đứng im.",
  "zq9a28": "Chạm ta, ngươi chết.",
  "zq9a29": "Không chạm!",
  "zq9a30": "Cổ tay… sao bị thương?",
  "zq9a31": "Trèo tường xước.",
  "zq9a32": "Tường rất cao.",
  "zq9a33": "Ta ngoài cửa,",
  "zq9a34": "nàng ngủ giường.",
  "zq9a35": "Ai đến, phải qua ta.",
  "zq9a36": "…Đồ ngốc.",
  "zq9a37": "A Lệnh: hảo cảm cộng mười.",
  "zq9a38": "Nhiệm vụ hoàn thành.",
  "zq9a39": "Hứa Nghiên.",
  "zq9a40": "Ngày mai, có lẽ ta phải đi."
}
