{
  "zq9a01": "兄さん、選んで。",
  "zq9a02": "ピコン。",
  "zq9a03": "隠し任務：新婚初夜。",
  "zq9a04": "今夜、妻に好感プラス十。",
  "zq9a05": "失敗時、農業スキルを没収。",
  "zq9a06": "一晩で十？",
  "zq9a07": "殺す気かよ。",
  "zq9a08": "みんな待ってるよ！",
  "zq9a09": "来た！",
  "zq9a10": "まずこの三冊。",
  "zq9a11": "間違えたら罰ね。",
  "zq9a12": "初夜に……帳簿？",
  "zq9a13": "四百二十七両三銭。",
  "zq9a14": "そ……算盤なしで？",
  "zq9a15": {
    "text": "暗算だ。",
    "say": "頭。"
  },
  "zq9a16": "三頁目に誤り。",
  "zq9a17": "計算できるの？",
  "zq9a18": "好感度、プラス二。",
  "zq9a19": "あと十冊！",
  "zq9a20": "朝までにね！",
  "zq9a21": "帳簿終わった？",
  "zq9a22": "シュアン？",
  "zq9a23": "寝た？",
  "zq9a24": "窓が開いてる……",
  "zq9a25": "夜中、どこ？",
  "zq9a26": "いくぞ。",
  "zq9a27": "動くな。",
  "zq9a28": "触れたら死ぬ。",
  "zq9a29": "触らない！",
  "zq9a30": "その手首……どうした？",
  "zq9a31": "塀で擦った。",
  "zq9a32": "高い塀。",
  "zq9a33": {
    "text": "俺は戸口で寝る、",
    "say": "俺は外。"
  },
  "zq9a34": {
    "text": "君はベッドで。",
    "say": "君は中。"
  },
  "zq9a35": "まず俺を倒せ。",
  "zq9a36": "……バカ。",
  "zq9a37": "アーリン、好感度プラス十。",
  "zq9a38": "任務完了。",
  "zq9a39": "イェン。",
  "zq9a40": "明日、行くかもしれない。"
}
