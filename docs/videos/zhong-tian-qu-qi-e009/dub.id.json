{
  "zq9a01": "Kak, pilih satu.",
  "zq9a02": "Ding.",
  "zq9a03": "Misi rahasia: malam pertama.",
  "zq9a04": {
    "text": "Malam ini, satu istri, poin suka plus sepuluh.",
    "say": "Malam ini, satu istri, plus sepuluh."
  },
  "zq9a05": "Gagal: keahlian bertani dicabut.",
  "zq9a06": "Sepuluh semalam?",
  "zq9a07": "Ini mau bunuh aku.",
  "zq9a08": "Kakak ipar nunggu!",
  "zq9a09": "Datang!",
  "zq9a10": "Tiga buku ini dulu.",
  "zq9a11": "Salah, dihukum.",
  "zq9a12": "Malam pertama… pembukuan?",
  "zq9a13": {
    "text": "Empat ratus dua puluh tujuh tael tiga ratus koin.",
    "say": "Empat ratus dua tujuh, koma tiga."
  },
  "zq9a14": "Kamu… nggak pakai sempoa?",
  "zq9a15": {
    "text": "Di kepala.",
    "say": "Di otak."
  },
  "zq9a16": "Halaman tiga, salah satu.",
  "zq9a17": "Suami bisa hitung?",
  "zq9a18": "Poin suka plus dua.",
  "zq9a19": "Masih sepuluh lagi!",
  "zq9a20": "Selesai sebelum pagi!",
  "zq9a21": {
    "text": "Kak, pembukuannya udah selesai?",
    "say": "Kak, udah selesai?"
  },
  "zq9a22": "Shuang?",
  "zq9a23": "Udah tidur?",
  "zq9a24": "Jendela terbuka…",
  "zq9a25": "Malam-malam ke mana?",
  "zq9a26": "Nekatlah.",
  "zq9a27": "Diam.",
  "zq9a28": "Sentuh aku, kamu mati.",
  "zq9a29": "Nggak, nggak!",
  "zq9a30": "Tanganmu… kenapa luka?",
  "zq9a31": "Kegores tembok.",
  "zq9a32": "Tembok tinggi.",
  "zq9a33": {
    "text": "Aku di pintu,",
    "say": "Aku jaga,"
  },
  "zq9a34": "kamu di kasur.",
  "zq9a35": {
    "text": "Siapa pun, lewati aku dulu.",
    "say": "Lewati aku dulu."
  },
  "zq9a36": "…Bodoh.",
  "zq9a37": {
    "text": "A-Ling, poin suka plus sepuluh.",
    "say": "A-Ling, plus sepuluh."
  },
  "zq9a38": "Misi selesai.",
  "zq9a39": "Xu Yan.",
  "zq9a40": "Besok, mungkin aku harus pergi."
}
