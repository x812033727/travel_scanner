{
  "zq9a01": "Hermano, elige.",
  "zq9a02": "Ding.",
  "zq9a03": "Misión oculta: noche de bodas.",
  "zq9a04": "Hoy, una esposa: más diez.",
  "zq9a05": "Fallo: pierdes la siembra.",
  "zq9a06": "¿Diez en una noche?",
  "zq9a07": "Esto me mata.",
  "zq9a08": {
    "text": "¡Las cuñadas te esperan!",
    "say": "¡Te esperan!"
  },
  "zq9a09": "¡Voy!",
  "zq9a10": {
    "text": "Primero, estos tres libros.",
    "say": "Tres libros."
  },
  "zq9a11": "Un error, y te castigo.",
  "zq9a12": "¿Noche de bodas… y cuentas?",
  "zq9a13": {
    "text": "Cuatrocientos veintisiete taeles y trescientos cobres.",
    "say": "Cuatrocientos veintisiete con tres."
  },
  "zq9a14": "¿Tú… sin ábaco?",
  "zq9a15": "Mental.",
  "zq9a16": "Página tres, un error.",
  "zq9a17": "¿Sabes de cuentas?",
  "zq9a18": "Afecto: más dos.",
  "zq9a19": "¡Faltan diez!",
  "zq9a20": "¡Antes del amanecer!",
  "zq9a21": {
    "text": "Hermano, ¿ya acabaste las cuentas?",
    "say": "¿Ya acabaste?"
  },
  "zq9a22": "¿Shuang?",
  "zq9a23": "¿Duermes?",
  "zq9a24": "Ventana abierta…",
  "zq9a25": "¿A dónde fue?",
  "zq9a26": "Va.",
  "zq9a27": "¡Quieto!",
  "zq9a28": "Tócame y mueres.",
  "zq9a29": "¡No te toco!",
  "zq9a30": "Tu muñeca… ¿qué te pasó?",
  "zq9a31": {
    "text": "Trepé un muro.",
    "say": "Un muro."
  },
  "zq9a32": {
    "text": "Un muro muy alto.",
    "say": "Muy alto."
  },
  "zq9a33": {
    "text": "Yo duermo en la puerta,",
    "say": "Yo,"
  },
  "zq9a34": {
    "text": "tú en la cama.",
    "say": "tú, la cama."
  },
  "zq9a35": {
    "text": "Quien venga, primero pasa sobre mí.",
    "say": "Primero, sobre mí."
  },
  "zq9a36": "…Tonto.",
  "zq9a37": "A-Ling: afecto más diez.",
  "zq9a38": "Misión cumplida.",
  "zq9a39": "Xu Yan…",
  "zq9a40": "Mañana quizá tenga que irme."
}
