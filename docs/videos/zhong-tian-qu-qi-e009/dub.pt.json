{
  "zq9a01": "Mano, escolhe uma.",
  "zq9a02": {
    "text": "Ding.",
    "say": "Ding!"
  },
  "zq9a03": {
    "text": "Missão oculta: noite de núpcias.",
    "say": "Missão oculta: núpcias."
  },
  "zq9a04": {
    "text": "Esta noite, qualquer esposa: afeição mais dez.",
    "say": "Uma esposa: mais dez."
  },
  "zq9a05": {
    "text": "Falha: perde a habilidade de plantar.",
    "say": "Falha: adeus, roça."
  },
  "zq9a06": "Dez numa noite?",
  "zq9a07": "Isso vai me matar.",
  "zq9a08": "As cunhadas esperam!",
  "zq9a09": "Já vou!",
  "zq9a10": "Três primeiro.",
  "zq9a11": "Errou uma, castigo.",
  "zq9a12": "Noite de núpcias… contas?",
  "zq9a13": {
    "text": "427 taéis e 300 moedas.",
    "say": "Quatrocentos e vinte e sete taéis."
  },
  "zq9a14": "Você… sem ábaco?",
  "zq9a15": {
    "text": "De cabeça.",
    "say": "Na cuca."
  },
  "zq9a16": "Página três, um erro.",
  "zq9a17": "Sabe fazer conta?",
  "zq9a18": "Afeição: mais dois.",
  "zq9a19": "Mais dez livros!",
  "zq9a20": "Até de manhã!",
  "zq9a21": {
    "text": "Mano, terminou as contas?",
    "say": "Mano, acabou?"
  },
  "zq9a22": "Shuang?",
  "zq9a23": "Dormindo?",
  "zq9a24": "Janela aberta…",
  "zq9a25": "Aonde ela foi?",
  "zq9a26": {
    "text": "Lá vai.",
    "say": "Vai."
  },
  "zq9a27": "Para.",
  "zq9a28": "Me toca e morre.",
  "zq9a29": "Não toco!",
  "zq9a30": "O pulso… como machucou?",
  "zq9a31": {
    "text": "Pulando um muro.",
    "say": "Num muro."
  },
  "zq9a32": "Muro alto.",
  "zq9a33": {
    "text": "Durmo na porta,",
    "say": "Durmo ali,"
  },
  "zq9a34": {
    "text": "a cama é sua.",
    "say": "cama é sua."
  },
  "zq9a35": "Quem vier, passa por mim.",
  "zq9a36": "…Bobo.",
  "zq9a37": "A-Ling: afeição mais dez.",
  "zq9a38": "Missão cumprida.",
  "zq9a39": "Xu Yan.",
  "zq9a40": "Amanhã, talvez eu tenha que ir."
}
