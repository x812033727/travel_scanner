{
  "zq9a01": "오빠, 하나 골라.",
  "zq9a02": "딩.",
  "zq9a03": "히든 미션: 첫날밤.",
  "zq9a04": {"text": "오늘 밤, 아내 호감 +10.", "say": "오늘 밤, 아내 호감 플러스 십."},
  "zq9a05": "실패 시, 농사 스킬 삭제.",
  "zq9a06": {"text": "하룻밤에 10점?", "say": "하룻밤에 십 점?"},
  "zq9a07": "날 죽이려고.",
  "zq9a08": "다들 기다려!",
  "zq9a09": "왔어!",
  "zq9a10": "장부 셋 맞춰.",
  "zq9a11": "틀리면, 벌이야.",
  "zq9a12": "첫날밤에… 장부?",
  "zq9a13": "사백이십칠 냥 삼 전.",
  "zq9a14": "너… 주판도 없이?",
  "zq9a15": "암산.",
  "zq9a16": "삼 쪽, 틀렸어.",
  "zq9a17": "셈도 해요?",
  "zq9a18": {"text": "호감, +2.", "say": "호감, 플러스 이."},
  "zq9a19": "열 권 더!",
  "zq9a20": "날 새기 전에!",
  "zq9a21": "오빠, 장부 다 했어?",
  "zq9a22": "친솽?",
  "zq9a23": "자?",
  "zq9a24": "창문이 열렸네…",
  "zq9a25": "밤중에 어딜?",
  "zq9a26": "가자.",
  "zq9a27": "쉿.",
  "zq9a28": "건드리면, 죽어.",
  "zq9a29": "안 건드려!",
  "zq9a30": "손목… 왜 다쳤어?",
  "zq9a31": "담 넘다가.",
  "zq9a32": "높은 담.",
  "zq9a33": "난 문가,",
  "zq9a34": "침대 써.",
  "zq9a35": "누가 와도 나부터.",
  "zq9a36": "…바보.",
  "zq9a37": {"text": "아링, 호감 +10.", "say": "아링, 호감 플러스 십."},
  "zq9a38": "미션 완료.",
  "zq9a39": "쉬옌.",
  "zq9a40": "내일, 떠나야 할지도."
}
