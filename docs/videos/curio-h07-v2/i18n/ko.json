    "tags": "596570ca9650",
    "thumbnail": "194c4f068b04"
  },
  "lines": {
    "14595114": {
      "source_hash": "ef696c172a94",
      "text": "1698년 7월 생마르가 또 이감령을 받습니다."
    },
    "27294032": {
      "source_hash": "c19e63caaa56",
      "text": "첫 입감 기록을 기억하나요?"
    },
    "43592117": {
      "source_hash": "8290c1ff5a08",
      "text": "한 전사는 Marchioly로 읽습니다."
    },
    "67729286": {
      "source_hash": "8c8d7825ed2b",
      "text": "오류는 작가의 글이 감옥 기록을 대신 못함을 보여 줍니다."
    },
    "83845803": {
      "source_hash": "cd3827c15670",
      "text": "그 '오랜 죄수'가 도제인지는 빠집니다."
    },
    "f882011e": {
      "source_hash": "73f9f4105d04",
      "text": "1703년, 바스티유 부관이 복면 죄수의 죽음을 장부에 적습니다."
    },
    "780680cf": {
      "source_hash": "8c0040acdadf",
      "text": "그는 사망 시각과 가면을 적었지만 신원을 확인할 이름은 남기지 않습니다."
    },
    "036c0187": {
      "source_hash": "eb65bae91639",
      "text": "1669년의 공문에는 엄중히 감시할 죄수의 이름이 적힙니다."
    },
    "bb259d67": {
      "source_hash": "2e232ad852d3",
      "text": "그 이름이 부관의 기록에 빠진 답일까요?"
    },
    "dfc7a42b": {
      "source_hash": "8caff71d0098",
      "text": "1698년, 소장은 오랜 죄수와 바스티유에 들어갑니다."
    },
    "db81d592": {
      "source_hash": "9e787a04de17",
      "text": "입감 장부는 이 죄수를 뭐라고 불렀을까요?"
    },
    "bdea9e04": {
      "source_hash": "1f5b65b81990",
      "text": "1738년, 볼테르는 편지에서 이야기를 새로 부릅니다."
    },
    "4bc41163": {
      "source_hash": "332726686097",
      "text": "그 표현은 가면을 어떻게 바꾸었을까요?"
    },
    "27099bdc": {
      "source_hash": "5a99a30ca58d",
      "text": "묻힌 사람은 누구이며, 가면은 정말 철이었을까요?"
    },
    "48ba5712": {
      "source_hash": "07e89b56d61b",
      "text": "부관은 '복면'에서 멈추지 않습니다."
    },
    "bced8458": {
      "source_hash": "e1dc62c943ac",
      "text": "사망 기록의 가면은 검은 벨벳입니다."
    },
    "45164df0": {
      "source_hash": "54cb12d6361b",
      "text": "그는 죄수가 그날 밤 10시쯤 숨졌다고 기록했습니다."
    },
    "349f207c": {
      "source_hash": "1459fd180648",
      "text": "다음 날 오후 4시, 성 바오로 교구 묘지에 묻힙니다."
    },
    "30d6e64a": {
      "source_hash": "c6f8a3fd699b",
      "text": "매장 기록이 신원을 밝힐 것 같죠."
    },
    "d9c5bfdb": {
      "source_hash": "2d56fc87ebd0",
      "text": "하지만 남은 이름은 철자조차 일치하지 않습니다."
    },
    "18bcd1aa": {
      "source_hash": "402d3a3c421a",
      "text": "다른 복제본은 Marchialy, 부관 주석은 또 다른 철자입니다."
    },
    "97c8ed9d": {
      "source_hash": "923591968458",
      "text": "모두 같은 매장 기록이지만 본명임을 입증하지는 못합니다."
    },
    "172c4b5f": {
      "source_hash": "477e4c726cec",
      "text": "소장이 받은 옛 공문엔 누구일까요?"
    },
    "446cb5b5": {
      "source_hash": "781de42316b6",
      "text": "1669년 7월 19일 공문에는 외스타슈 도제라는 이름이 나옵니다."
    },
    "067878ed": {
      "source_hash": "62d777b61dcd",
      "text": "발신자는 루부아, 수신자는 교도소장 생마르입니다."
    },
    "0b26481a": {
      "source_hash": "d5d59d8ec51d",
      "text": "왕은 피네롤에 가두라고 합니다."
    },
    "712867ca": {
      "source_hash": "b8f04ed5dd15",
      "text": "이 편지엔 죄목이 없습니다."
    },
    "a7a7e3bb": {
      "source_hash": "209d420dec8a",
      "text": "관리들은 배식할 사람까지 정합니다."
    },
    "22215fc5": {
      "source_hash": "51762ff74fff",
      "text": "생마르만 배식하고 보초는 말을 못 듣게 합니다."
    },
    "adbdfb65": {
      "source_hash": "6692cbd2d83d",
      "text": "밖으로 소식도 못 전합니다."
    },
    "836e3743": {
      "source_hash": "0ba963d31c59",
      "text": "뭘 말할까 두려웠을까요?"
    },
    "6e0e8bfb": {
      "source_hash": "6cce23596e7e",
      "text": "편지에는 답 대신 더 알쏭달쏭한 호칭만 나옵니다."
    },
    "1f2116f6": {
      "source_hash": "7bcee55266ce",
      "text": "루부아는 그를 '하인'이라 합니다."
    },
    "4770a975": {
      "source_hash": "6842345c2277",
      "text": "일부는 문자 그대로, 연구자는 말장난으로 봅니다."
    },
    "68932c43": {
      "source_hash": "ffd608814ce7",
      "text": "어느 쪽도 이력은 못 밝힙니다."
    },
    "e6345955": {
      "source_hash": "41cfd2fb01cf",
      "text": "더 중요한 건 편지에 가면이 없다는 겁니다."
    },
    "8dffdb67": {
      "source_hash": "3263314cada6",
      "text": "도제가 훗날 바스티유의 무명 죄수라는 말도 없습니다."
    },
    "7c22ba05": {
      "source_hash": "841425f691de",
      "text": "앞의 장부엔 이름이 없지만, 이 밀명엔 이름이 있습니다."
    },
    "6e55055d": {
      "source_hash": "a40b5c836c9a",
      "text": "두 기록을 잇는 단서는 있을까요?"
    },
    "ec1ee0f4": {
      "source_hash": "e419c11f46e6",
      "text": "'오랜 죄수'를 생트마르그리트섬에서 바스티유로 옮겨도 됩니다."
    },
    "e690a274": {
      "source_hash": "2c0d4056e1db",
      "text": "명령은 남들이 죄수를 보거나 알아보지 못하게 하라고 합니다."
    },
    "5bc42258": {
      "source_hash": "56b5d8c9e292",
      "text": "이송만 다루며 앞선 감옥들의 경비는 빠집니다."
    },
    "7355e817": {
      "source_hash": "e86ea6c21c8f",
      "text": "그해 9월 18일 입감 기록이 이 경로를 잇습니다."
    },
    "300c617e": {
      "source_hash": "29db2fcae034",
      "text": "입감 기록엔 이름·재질이 없고, 검은 벨벳은 사망 기록에 있습니다."
    },
    "4ee87957": {
      "source_hash": "9b04e50fb431",
      "text": "부관은 생마르가 피네롤에서 지켰다고 적습니다."
    },
    "e1f6363c": {
      "source_hash": "bba419034726",
      "text": "같은 소장과 옛 감옥이 두 기록을 이을 여지를 줍니다."
    },
    "e99ebdf1": {
      "source_hash": "36a6dd5ca1ab",
      "text": "추적의 단서지만 추정을 확증으로 만들진 못합니다."
    },
    "1ccb3806": {
      "source_hash": "1ba8c737795e",
      "text": "훗날 편지가 가면의 이름을 바꿉니다."
    },
    "f8262028": {
      "source_hash": "f41980382da4",
      "text": "편지 속 단어가 정말 가면의 재질일까요?"
    },
    "4d151adf": {
      "source_hash": "5177827f3521",
      "text": "1738년 볼테르는 '철가면'이라 부르나 검증 근거는 없습니다."
    },
    "3282e1f7": {
      "source_hash": "aa2f4f5b03e8",
      "text": "시종에게 물었다고 합니다."
    },
    "08402cf6": {
      "source_hash": "7fbf169d6cd7",
      "text": "그 문답의 축어록은 없습니다."
    },
    "5df72cd6": {
      "source_hash": "4535583ffd35",
      "text": "시종이 직접 본 가면이 무엇인진 알 수 없습니다."
    },
    "a35852ed": {
      "source_hash": "533f51d6d631",
      "text": "볼테르가 처음 '철'이라 했다고도 단정할 수 없습니다."
    },
    "22c31821": {
      "source_hash": "e5316f2913c4",
      "text": "사망 기록의 검은 벨벳, 왜 '철'에 밀렸을까요?"
    },
    "a2e86117": {
      "source_hash": "a13b75fef5fc",
      "text": "1751년 책 《루이 14세의 시대》로 퍼집니다."
    },
    "1778513e": {
      "source_hash": "19f664a95be6",
      "text": "새 묘사도 나옵니다."
    },
    "a0b99b19": {
      "source_hash": "754ac8e75d5c",
      "text": "볼테르는 턱의 강철 용수철 덕에 가면을 쓰고 식사했다고 씁니다."
    },
    "a1d34f98": {
      "source_hash": "713598fdab78",
      "text": "강철인 건 용수철뿐, 가면 전체가 철이란 증거는 아닙니다."
    },
    "f010cca9": {
      "source_hash": "ba40ad6bf897",
      "text": "책의 세부 묘사로 무명 죄수가 생생해집니다."
    },
    "458d1f68": {
      "source_hash": "feb46f2ffdea",
      "text": "하지만 바스티유 이감 연도를 1690년으로 씁니다."
    },
    "42fdf9fe": {
      "source_hash": "1f688cf1b929",
      "text": "장부 기록은 그보다 8년 뒤입니다."
    },
    "3a052062": {
      "source_hash": "7ae69eee8f4c",
      "text": "전해질수록 가면 재질은 단단해지고 출신도 고귀해집니다."
    },
    "19cabd14": {
      "source_hash": "e3589aa9c668",
      "text": "왕족 이야기는 언제 등장했을까요?"
    },
    "1648d74e": {
      "source_hash": "946d94d4ae45",
      "text": "1771년 판의 글은 죄수가 왕의 형이라고 추측합니다."
    },
    "7e41df5a": {
      "source_hash": "bd0936e359dc",
      "text": "'편집자 추가'라 적혀, 볼테르가 썼는지는 논란입니다."
    },
    "59982a41": {
      "source_hash": "b42ced163ad6",
      "text": "후대 추측일 뿐, 교도소는 신원을 안 밝혔습니다."
    },
    "d357e078": {
      "source_hash": "6759722dcdf6",
      "text": "18세기 말, 형 이야기에서 쌍둥이설이 나옵니다."
    },
    "065e2185": {
      "source_hash": "d54971fe1452",
      "text": "같은 얼굴 둘 중 하나를 가리면 이야기엔 개연성이 생깁니다."
    },
    "4ecf1ae5": {
      "source_hash": "6ffdba53d88f",
      "text": "뒤마가 쌍둥이를 소설에 쓰면서 가면과 왕실은 더 얽힙니다."
    },
    "85100ec0": {
      "source_hash": "257f4579b102",
      "text": "하지만 초기 문서에 왕족 신분은 한 줄도 없습니다."
    },
    "22b75408": {
      "source_hash": "60136ad60b3d",
      "text": "금속 가면과 쌍둥이는 전설의 유행을 설명해도 신원은 못 밝힙니다."
    },
    "143be677": {
      "source_hash": "877986d832cd",
      "text": "이름에 다가갈 단서는 밀명과 매장부 복제본입니다."
    },
    "baeadea2": {
      "source_hash": "fba2b18f8db1",
      "text": "두 문서를 대조하면 핵심적인 차이가 이름에서 드러납니다."
    },
    "029cafbf": {
      "source_hash": "c180ccbf1e3f",
      "text": "매장 기록 사본의 철자는 밀명에 적힌 도제와 다릅니다."
    },
    "ec47a1b6": {
      "source_hash": "d544ea599126",
      "text": "도제가 복면 죄수라면 같은 소장의 이동 경로가 이어집니다."
    },
    "5d60fd05": {
      "source_hash": "d840d72516cc",
      "text": "피네롤, 엑실, 생트마르그리트섬, 바스티유 순입니다."
    },
    "f5c35d28": {
      "source_hash": "fb6b8cfb0c8a",
      "text": "네 감옥과 약 34년은 신원 추정이 맞아야 성립합니다."
    },
    "ca6f2073": {
      "source_hash": "24c901af0bc9",
      "text": "34년은 수감이지 가면 쓴 기간이 아닙니다."
    },
    "b99ebbb9": {
      "source_hash": "fd9e01c15917",
      "text": "첫 밀명의 이름 기억하나요?"
    },
    "63748dc9": {
      "source_hash": "88c955ccd3a7",
      "text": "사망 기록엔 도제가 없어 추정이 필요합니다."
    },
    "e8d89ffb": {
      "source_hash": "77d891c1548a",
      "text": "역사학자 소니노는 입막음 이유도 듭니다."
    },
    "40285df9": {
      "source_hash": "17e6735a0b1d",
      "text": "도제가 마자랭 추기경의 재무관을 섬겼다고 봅니다."
    },
    "f409b936": {
      "source_hash": "f383a6df16b9",
      "text": "마자랭의 영국 전왕·왕비 재산 횡령을 도제가 알았을 수 있습니다."
    },
    "6c44c3b1": {
      "source_hash": "e7a99bc0b1f2",
      "text": "프랑스 왕의 영국 왕 참전 요청에 비밀이 문제일 수 있습니다."
    },
    "5438f7da": {
      "source_hash": "408bdd129f34",
      "text": "이는 소니노의 재구성이지 구금 밀명에 적힌 죄목이 아닙니다."
    },
    "d50d4573": {
      "source_hash": "028d7f113da7",
      "text": "비밀의 이유를 설명하는 한 설일 뿐, 본명은 못 밝힙니다."
    },
    "ef2940a1": {
      "source_hash": "be637b4942e3",
      "text": "그럼 매장 이름이 다른 사람을 가리킨다면 도제의 경로는 성립할까요?"
    },
    "13f0cb04": {
      "source_hash": "f3fee9086064",
      "text": "다른 단서는 앞서 본 매장 이름입니다."
    },
    "87ab87c4": {
      "source_hash": "c8c8c1b6e829",
      "text": "교구 원본은 소실, 19세기 간행본은 남았습니다."
    },
    "5c6e9a3e": {
      "source_hash": "d5e1016c0af4",
      "text": "간행본과 전사본을 대조해도 본명인지는 모릅니다."
    },
    "14d8d94f": {
      "source_hash": "126d2c02b700",
      "text": "19세기 펑크브렌타노는 그 이름이 마티올리라 봅니다."
    },
    "168efb94": {
      "source_hash": "7b96f2296e1c",
      "text": "마티올리는 후보가 됐지만 논란은 끝나지 않았습니다."
    },
    "30fb8aac": {
      "source_hash": "1cc9f894781b",
      "text": "사망자가 마티올리면 도제의 수감 경로는 그와 무관합니다."
    },
    "ceb3f543": {
      "source_hash": "7f87ba7efcb6",
      "text": "두 설 모두 단서가 있지만 섞으면 문서에 없는 인물을 만들게 됩니다."
    },
    "c7a67f2d": {
      "source_hash": "07a3220364d9",
      "text": "칸 철가면 박물관도 현재 신원은 불명이라고 합니다."
    },
    "1fb84766": {
      "source_hash": "d419df90dcb9",
      "text": "'철'을 검증할 가면 실물이 있기는 할까요?"
    },
    "926246b2": {
      "source_hash": "2bbf92299b62",
      "text": "가면 실물이 없어 볼테르가 말한 '철'인지 확인할 수 없습니다. 신원을 둘러싼 해석도 엇갈립니다."
    },
    "9fda69c0": {
      "source_hash": "7022abe45406",
      "text": "기록과 쌍둥이 전설 중 뭘 들으셨나요?"
    },
    "7bd9eb2a": {
      "source_hash": "6643ebfb4f4c",
      "text": "기록 속 미스터리를 좋아한다면 奇聞檔案局을 구독해 주세요."
    }
  }
}
