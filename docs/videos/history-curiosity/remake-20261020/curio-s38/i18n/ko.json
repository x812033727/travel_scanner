  "lines": {
    "pf001": {
      "source_hash": "d0fe0f6ba05f",
      "text": "1666년 9월 4일 저녁, 런던 한 마당. 피프스는 윌리엄 펜 경과 그날 둘째 구덩이를 파죠."
    },
    "pf002": {
      "source_hash": "3750422da38d",
      "text": "와인을 넣고, 그는 파르메산 치즈도 넣었죠."
    },
    "pf003": {
      "source_hash": "6c16be343c3a",
      "text": "불이 어디까지 왔기에 마당 흙을 택했을까요?"
    },
    "pf004": {
      "source_hash": "21c5f44f70f3",
      "text": "불은 집까지 닿았을까요?"
    },
    "pf005": {
      "source_hash": "7be48b951446",
      "text": "그의 일기는 그 치즈의 행방을 적었을까요?"
    },
    "pf006": {
      "source_hash": "a70fba14b031",
      "text": "이틀 전, 9월 2일 새벽. 하녀 제인이 시내의 불을 봅니다."
    },
    "pf007": {
      "source_hash": "3a62d7ba3c4f",
      "text": "깨어난 피프스는 잠옷 차림으로 창가에 갑니다."
    },
    "pf008": {
      "source_hash": "3159d58abd63",
      "text": "불은 마크 레인 뒤쪽, 집에선 아직 멀다고 봤죠."
    },
    "pf009": {
      "source_hash": "4466406295c7",
      "text": "그래서 정말 다시 잠자리에 들었습니다."
    },
    "pf010": {
      "source_hash": "c8f048b9544f",
      "text": "아침엔 불이 더 작아 보였죠. 시내는 정말 무사했을까요?"
    },
    "pf011": {
      "source_hash": "47d74417dd01",
      "text": "그런데 제인이 300채 넘게 탔다는 말을 듣고 와요."
    },
    "pf012": {
      "source_hash": "feadc8be6435",
      "text": "그것도 소문. 피프스가 직접 보러 가죠."
    },
    "pf013": {
      "source_hash": "8b9b97d4b067",
      "text": "런던탑 높은 곳에서, 다리 옆 집들이 타는 걸 봅니다."
    },
    "pf014": {
      "source_hash": "7a7907aaed08",
      "text": "다리의 불에 그곳 지인의 집이 걱정됐죠."
    },
    "pf015": {
      "source_hash": "e18ea70805b0",
      "text": "먼 붉은 빛에 이젠 거리와 사람이 있습니다. 어디로 피할까요?"
    },
    "pf016": {
      "source_hash": "5ce12faa5fa4",
      "text": "탑 관리 말로는, 푸딩 레인 왕실 제빵사 집이 발화점."
    },
    "pf017": {
      "source_hash": "c3174c2088ab",
      "text": "피프스는 들었을 뿐, 발화 순간은 못 봤습니다."
    },
    "pf018": {
      "source_hash": "35066131c977",
      "text": "배로 강을 가니, 사람들이 짐을 거룻배에 싣습니다."
    },
    "pf019": {
      "source_hash": "a8cd443c0024",
      "text": "배 위에서 그 지인의 집이 이미 탄 걸 압니다."
    },
    "pf020": {
      "source_hash": "f13f4b3187fd",
      "text": "못 옮긴 짐을 강에 던지는 이도 있었죠."
    },
    "pf021": {
      "source_hash": "39dfa30243f6",
      "text": "불이 문앞에 와서야 배로 뛰는 주민도 있었습니다."
    },
    "pf022": {
      "source_hash": "6aebef29a087",
      "text": "바람이 불을 시내로 밉니다. 누가 막을까요?"
    },
    "pf023": {
      "source_hash": "f177995811ed",
      "text": "피프스는 화이트홀로 서둘러 갑니다."
    },
    "pf024": {
      "source_hash": "6c82f4b8a5cc",
      "text": "국왕과 요크 공작 앞에서, 강에서 본 걸 보고하죠."
    },
    "pf025": {
      "source_hash": "aca827d9895b",
      "text": "불 앞의 집을 헐어야 막을 수 있다고 말합니다."
    },
    "pf026": {
      "source_hash": "28b6f87b5a68",
      "text": "국왕: 시장은 주저 말고 헐라."
    },
    "pf027": {
      "source_hash": "27dc3375026b",
      "text": "요크 공작은 병사가 필요하면 보낸다고 하죠."
    },
    "pf028": {
      "source_hash": "d98dd98bbda5",
      "text": "만난 시장은 녹초. 철거를 이끌 수 있을까요?"
    },
    "pf029": {
      "source_hash": "dbe734d9362d",
      "text": "일기 속 시장의 불평: 말 안 듣고, 불은 빠르다."
    },
    "pf030": {
      "source_hash": "68c976810b13",
      "text": "밤을 새워 쉬어야 한다고 했죠."
    },
    "pf031": {
      "source_hash": "87cc3a70819a",
      "text": "병사는 더 필요 없다며 떠났습니다."
    },
    "pf032": {
      "source_hash": "b3a590bd74eb",
      "text": "교회에도 주민들이 맡긴 짐이 가득했죠."
    },
    "pf033": {
      "source_hash": "1849a50720a4",
      "text": "거리엔 짐 진 사람들, 짐을 가득 실은 수레."
    },
    "pf034": {
      "source_hash": "848ce48547b3",
      "text": "피프스는 템스 스트리트의 타르, 창고의 기름과 와인을 적습니다. 그의 와인은요?"
    },
    "pf035": {
      "source_hash": "e1d426e21215",
      "text": "그래도 낮엔 약속한 손님을 대접했죠."
    },
    "pf036": {
      "source_hash": "aeb7e9e20a81",
      "text": "식사는 푸짐했지만, 모두 불 걱정이었죠."
    },
    "pf037": {
      "source_hash": "7c4a297acb9d",
      "text": "식사 중 배틀리어 부인이 친척 둘 안부를 묻죠. 그 집들은 탔다고 적고요."
    },
    "pf038": {
      "source_hash": "447db450cf99",
      "text": "식후엔 아침에 들인 짐을 더 멀리 옮기고 있었죠."
    },
    "pf039": {
      "source_hash": "9a610892a8b6",
      "text": "다시 배로. 불길은 어디까지?"
    },
    "pf040": {
      "source_hash": "5c378bf72a60",
      "text": "배에서 보니 다리 위아래로 불이 더 번졌습니다."
    },
    "pf041": {
      "source_hash": "e5203e705e84",
      "text": "강엔 짐 실은 배가 가득."
    },
    "pf042": {
      "source_hash": "a10b5f6a258d",
      "text": "많은 배에 가정용 건반악기 버지널까지 실렸습니다."
    },
    "pf043": {
      "source_hash": "9c7f9f1fceec",
      "text": "바람을 안고 다가가니 불똥에 오래 못 섰죠."
    },
    "pf044": {
      "source_hash": "0da0ba1da8c2",
      "text": "불똥은 몇 집 건너 집들까지 차례로 태웠습니다."
    },
    "pf045": {
      "source_hash": "2db8f53853cf",
      "text": "해 질 녘 맞은편에서 본 불은 긴 활 같았죠."
    },
    "pf046": {
      "source_hash": "83ddba5e081d",
      "text": "그 광경에 울었다고 썼습니다."
    },
    "pf047": {
      "source_hash": "6b58386d2e5b",
      "text": "집에 오니, 집 잃은 지인 톰이 남은 짐을 들고 왔죠."
    },
    "pf048": {
      "source_hash": "f5ca60a82338",
      "text": "불 소식이 이어져 짐을 쌉니다. 먼저 어디로 옮길까요?"
    },
    "pf049": {
      "source_hash": "b7ddac38b76d",
      "text": "달빛 아래 짐을 먼저 정원으로. 다 들어갈까요?"
    },
    "pf050": {
      "source_hash": "91e1f07e1cc4",
      "text": "톰과 돈, 쇠 상자를 지하실로. 어수선해 잠을 설쳤죠."
    },
    "pf051": {
      "source_hash": "872bdb6ab348",
      "text": "새벽에 또 옮긴다면 무엇부터?"
    },
    "pf052": {
      "source_hash": "08e3efd0ba70",
      "text": "9월 3일 새벽, 이웃이 수레를 보냅니다."
    },
    "pf053": {
      "source_hash": "6bb4feb9b3c8",
      "text": "피프스는 잠옷 바람에 돈과 은그릇을 직접 호송."
    },
    "pf054": {
      "source_hash": "d87c3350343f",
      "text": "베스널 그린의 친구 집으로요."
    },
    "pf055": {
      "source_hash": "e68f23d86b73",
      "text": "그 집도 남의 짐으로 가득했죠."
    },
    "pf056": {
      "source_hash": "07aa27d54642",
      "text": "돌아와선 아내와 남은 짐을 옮깁니다."
    },
    "pf057": {
      "source_hash": "a4bcdbb9c82c",
      "text": "짐 나를 거룻배가 생겼죠. 누구 짐까지 실었을까요?"
    },
    "pf058": {
      "source_hash": "ff5c3edb70d3",
      "text": "상자는 타워 힐 넘어 부두로."
    },
    "pf059": {
      "source_hash": "730517fc1fba",
      "text": "붐벼서 쪽문도 지나기 힘들죠."
    },
    "pf060": {
      "source_hash": "0ecbc1dff121",
      "text": "아이 딸린 이웃도 배에 짐을 좀 실었죠."
    },
    "pf061": {
      "source_hash": "9253dbef8d16",
      "text": "피프스도 지시만 않고 짐을 졌습니다."
    },
    "pf062": {
      "source_hash": "706daec6d8e6",
      "text": "밤엔 부부가 사무실에 이불을 깔고 잤죠."
    },
    "pf063": {
      "source_hash": "992bce240534",
      "text": "조리도구가 없어 전날 남은 걸 먹었죠."
    },
    "pf064": {
      "source_hash": "e921d098159f",
      "text": "수레, 배, 정원 다 썼습니다. 옮기기 힘든 건?"
    },
    "pf065": {
      "source_hash": "8f506f71f620",
      "text": "9월 4일 아침, 짐은 계속 배로 갔지만 마당엔 와인이 남았죠."
    },
    "pf066": {
      "source_hash": "1f635c86b826",
      "text": "오후, 타워 스트리트의 불이 집들에 닥치죠."
    },
    "pf067": {
      "source_hash": "6eb390ae5ecf",
      "text": "이웃 배튼 경은 와인을 못 옮겨 다른 수를 냈죠."
    },
    "pf068": {
      "source_hash": "b0cd8acf48c2",
      "text": "배튼이 첫 구덩이를 파 와인을 묻었죠."
    },
    "pf069": {
      "source_hash": "7efa85934393",
      "text": "피프스는 그 틈에 사무실 서류도 넣었습니다."
    },
    "pf070": {
      "source_hash": "ef9b82b97098",
      "text": "이건 첫 구덩이. 피프스 자신의 와인은요?"
    },
    "pf071": {
      "source_hash": "e1ef0e0aeeec",
      "text": "저녁엔 펜 경과 자기 와인용 두 번째 구덩이를 팝니다."
    },
    "pf072": {
      "source_hash": "f6a41cdee859",
      "text": "와인을 넣고, 처음의 그 치즈도 같은 구덩이에 넣었죠."
    },
    "pf073": {
      "source_hash": "7c3b57977123",
      "text": "그날 일기엔 치즈의 크기도 값도 없습니다."
    },
    "pf074": {
      "source_hash": "3b6d8cea4433",
      "text": "치즈는 숨겼죠. 그런데 사무실은 무사할까요?"
    },
    "pf075": {
      "source_hash": "ab7a2d8fe12c",
      "text": "밤에 펜 경은 조선소 일꾼이 아침에 사무실을 구하러 오게 했죠."
    },
    "pf076": {
      "source_hash": "fca9e832360c",
      "text": "코번트리 경에게는 철거 허가를 편지로 청했죠."
    },
    "pf077": {
      "source_hash": "545773614b42",
      "text": "답은 없었습니다. 거리에서 누가 먼저 나설까요?"
    },
    "pf078": {
      "source_hash": "e2a180da715d",
      "text": "아내, 손님과 양 어깨살을 먹었죠. 냅킨도 없이."
    },
    "pf079": {
      "source_hash": "3ac68ddb6107",
      "text": "저녁 내내 정원에 나가 불타는 하늘을 올려다봤죠."
    },
    "pf080": {
      "source_hash": "e1101c45733e",
      "text": "밤, 타워 스트리트선 불 앞 집들을 폭파."
    },
    "pf081": {
      "source_hash": "746ae7ed5ada",
      "text": "폭파한 곳에서 불이 멈췄다고 적었습니다."
    },
    "pf082": {
      "source_hash": "6a1428714f0a",
      "text": "그의 골목은 내일 버틸까요?"
    },
    "pf083": {
      "source_hash": "aa795135df37",
      "text": "9월 5일 새벽 2시쯤, 아내가 또 깨웁니다."
    },
    "pf084": {
      "source_hash": "6c780ff4504e",
      "text": "골목 어귀 교회 근처서 또 불이야 소리."
    },
    "pf085": {
      "source_hash": "8414fe3af1b3",
      "text": "이번엔 곧장 아내와 돈을 배에 싣고 강을 내려갑니다."
    },
    "pf086": {
      "source_hash": "2b87a682c347",
      "text": "달빛 속 돌아보니 런던은 온통 불. 그는 돌아갈까요?"
    },
    "pf087": {
      "source_hash": "195b227847cf",
      "text": "돈은 친구 집에 잠가 두고 아내 일행이 교대로 지키게."
    },
    "pf088": {
      "source_hash": "3ce2802fedc1",
      "text": "그리고 혼자 배로 돌아옵니다."
    },
    "pf089": {
      "source_hash": "f12c47c08f87",
      "text": "돌아오며 뎃퍼드를 지나니, 짐은 배에서 지켜지고 있었죠."
    },
    "pf090": {
      "source_hash": "d8dce4f8096b",
      "text": "탄 줄 알았던 집은 그대로 서 있었죠."
    },
    "pf091": {
      "source_hash": "128c86fc0420",
      "text": "사무실도 무사. 다가가서야 확신했죠."
    },
    "pf092": {
      "source_hash": "d588d3a2936a",
      "text": "어귀 교회의 시계판과 현관이 타고서야 불이 멈췄습니다."
    },
    "pf093": {
      "source_hash": "e5181cedc936",
      "text": "일기는 폭파와 달려온 일꾼들 덕분이라고 합니다."
    },
    "pf094": {
      "source_hash": "c2788b6c94ec",
      "text": "어귀 교회로. 탑에선 어떤 런던이 보일까요?"
    },
    "pf095": {
      "source_hash": "2785ac3e0657",
      "text": "교회 탑에 오르니 온통 폐허였습니다."
    },
    "pf096": {
      "source_hash": "2c8f90a75fc8",
      "text": "먼 곳은 아직 타서 오래 못 있죠."
    },
    "pf097": {
      "source_hash": "0f885a69f8ed",
      "text": "잔불에 발이 뜨거운 채 거리를 걸었죠."
    },
    "pf098": {
      "source_hash": "13784f040dfb",
      "text": "무어필즈엔 짐을 지키는 피란민이 가득했죠."
    },
    "pf099": {
      "source_hash": "4dccf534495b",
      "text": "피프스는 열에 휜 유리 조각을 주웠죠."
    },
    "pf100": {
      "source_hash": "6d307de4ec59",
      "text": "밤엔 사무실에 일꾼 불침번을 세웠죠."
    },
    "pf101": {
      "source_hash": "4a420fd991f5",
      "text": "자정에야 누워, 좀 편히 잤습니다."
    },
    "pf102": {
      "source_hash": "0122594bdd56",
      "text": "날이 밝으면, 불은 정말 꺼졌을까요?"
    },
    "pf103": {
      "source_hash": "626f81f3347f",
      "text": "9월 6일 아침, 시내 다른 곳에 또 불."
    },
    "pf104": {
      "source_hash": "bfd5fc1df0c1",
      "text": "피프스와 일꾼들이 달려가 곧 껐습니다."
    },
    "pf105": {
      "source_hash": "5a2d48a487e9",
      "text": "강변의 집과 교회는 크게 사라졌습니다."
    },
    "pf106": {
      "source_hash": "793b4f75d210",
      "text": "전날부터 배에서 지킨 짐은 아직 배 위였죠."
    },
    "pf107": {
      "source_hash": "b2bc250095ff",
      "text": "뎃퍼드에서 짐을 카터렛 경 쪽에 내렸습니다."
    },
    "pf108": {
      "source_hash": "28a381b4492f",
      "text": "내려 보니 잃거나 상한 건 없었다고."
    },
    "pf109": {
      "source_hash": "320aa5b959af",
      "text": "9월 6일 일기엔 이렇게 썼죠. '두려움은 지나갔다.'"
    },
    "pf110": {
      "source_hash": "9d4f58772777",
      "text": "치즈는 파냈을까요? 이 며칠 기록엔 없죠."
    },
    "pf111": {
      "source_hash": "b363781fa398",
      "text": "그 마당이라면, 두 번째 구덩이에 뭘 넣을래요?"
    },
    "pf112": {
      "source_hash": "d633a0f6fece",
      "text": "원본 기록에서 출발하는 이야기, 더 듣고 싶다면 구독을."
    }
  }
}
