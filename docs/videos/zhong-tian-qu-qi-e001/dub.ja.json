{
  "zt1a01": "農業？",
  "zt1a02": "農学の修士なんですが……",
  "zt1a03": "次の方。",
  "zt1a04": "農業の何が悪いんだよ……",
  "zt1a05": "良縁システム、起動。",
  "zt1a06": "起きろ！",
  "zt1a07": "引き上げたぞ！息がある！",
  "zt1a08": "ここ……どこだ？",
  "zt1a09": "アーニウだよ！",
  "zt1a10": {
    "text": "秀才、ビビったか？",
    "say": "秀才ビビったか？"
  },
  "zt1a11": "宿主：シュー・イェン。秀才。",
  "zt1a12": "負債：二十両。",
  "zt1a13": "いきなり借金スタート？",
  "zt1a14": "夜中に川に落ちてさ、",
  "zt1a15": "お兄ちゃん！",
  "zt1a16": "お兄ちゃん、生きてた！",
  "zt1a17": "俺……妹がいるのか？",
  "zt1a18": "チエン旦那がまた取り立てに来たの。",
  "zt1a19": "転生特典が妹で、",
  "zt1a20": "借金付き？",
  "zt1a21": {
    "text": "お粥、まだあるよ。",
    "say": "お粥まだあるよ。"
  },
  "zt1a22": "シュー・イェン！",
  "zt1a23": "県令様のお達しだ！",
  "zt1a24": "シュー・イェン、二十五歳、未婚！",
  "zt1a25": "嫁を三人！",
  "zt1a26": "今日、祝言だ！",
  "zt1a27": "待ってくれ！",
  "zt1a28": "外に花嫁が三人も！",
  "zt1a29": "さ……三人？",
  "zt1a30": "軍戸の孤児、チン・シュアン。",
  "zt1a31": "このヒョロいのが？",
  "zt1a32": "罪人の奴婢、アーリン。",
  "zt1a33": "彼女の罪は？",
  "zt1a34": "選べる立場か？",
  "zt1a35": {
    "text": "法では、",
    "say": "法では"
  },
  "zt1a36": {
    "text": "大衡律、第七条——",
    "say": "大衡律第七条。"
  },
  "zt1a37": "猶予は三日、",
  "zt1a38": "婚礼の強制は禁ず。",
  "zt1a39": "なっ……",
  "zt1a40": "へえ、条文が言えるんだ。",
  "zt1a41": "ふん、三人目は？",
  "zt1a42": "籠にもう一人！",
  "zt1a43": "どいてどいて！",
  "zt1a44": "シャオタンです！",
  "zt1a45": "お嬢様まで数合わせ？",
  "zt1a46": "絹の服で配婚に？",
  "zt1a47": "大当たりだ！",
  "zt1a48": "ピコン。",
  "zt1a49": {
    "text": "任務：三日で三人と結婚せよ。",
    "say": "三日で三人と結婚せよ。"
  },
  "zt1a50": "失敗——抹殺。",
  "zt1a51": "ま……抹殺？"
}
