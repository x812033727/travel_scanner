{
  "zt1a01": "Jurusan tani?",
  "zt1a02": {
    "text": "Saya S2 pertanian…",
    "say": "Aku S2 pertanian"
  },
  "zt1a03": "Berikutnya.",
  "zt1a04": "Memangnya petani kenapa…",
  "zt1a05": "Sistem Jodoh, terhubung.",
  "zt1a06": "Bangun!",
  "zt1a07": "Ketemu! Masih bernapas!",
  "zt1a08": "Ini… di mana?",
  "zt1a09": {
    "text": "Ini aku, Erniu!",
    "say": "Erniu!"
  },
  "zt1a10": "Sarjana Xu, bengong?",
  "zt1a11": "Host: Xu Yan. Sarjana.",
  "zt1a12": {
    "text": "Utang: dua puluh tael.",
    "say": "Utang dua puluh tael."
  },
  "zt1a13": "Baru mulai udah ngutang?",
  "zt1a14": "Tengah malam kamu kecebur sungai,",
  "zt1a15": "Kakak!",
  "zt1a16": "Kakak masih hidup!",
  "zt1a17": "Aku… punya adik?",
  "zt1a18": "Tuan Qian datang nagih utang lagi.",
  "zt1a19": "Pindah zaman dapat bonus adik,",
  "zt1a20": {
    "text": "plus bonus utang?",
    "say": "plus utang?"
  },
  "zt1a21": {
    "text": "Kak, bubur masih ada setengah mangkuk.",
    "say": "Kak, bubur masih ada."
  },
  "zt1a22": "Mana Xu Yan?!",
  "zt1a23": "Atas perintah Tuan Bupati!",
  "zt1a24": "Xu Yan, dua puluh lima, bujang!",
  "zt1a25": "Tiga istri resmi!",
  "zt1a26": "Nikah hari ini!",
  "zt1a27": "Tunggu, aku nggak…",
  "zt1a28": "Kak, ada tiga pengantin di luar!",
  "zt1a29": "Ti… tiga?",
  "zt1a30": "Yatim prajurit, Qin Shuang.",
  "zt1a31": "Badan kerempeng gini?",
  "zt1a32": "Budak terhukum, A-Ling.",
  "zt1a33": "Salahnya apa?",
  "zt1a34": "Miskin, masih mau milih?",
  "zt1a35": "Hukum Daheng,",
  "zt1a36": "soal jodoh, pasal tujuh—",
  "zt1a37": "batasnya tiga hari,",
  "zt1a38": "dilarang paksa menikah.",
  "zt1a39": {
    "text": "Kau…",
    "say": "Kau"
  },
  "zt1a40": "Wah, hafal hukum.",
  "zt1a41": "Hmph, yang ketiga mana?",
  "zt1a42": {
    "text": "Satu lagi di tandu!",
    "say": "Satu lagi!"
  },
  "zt1a43": "Permisi, permisi!",
  "zt1a44": "Aku Xiaotang.",
  "zt1a45": "Nona kaya juga ikut-ikutan?",
  "zt1a46": "Pakai sutra ke perjodohan?",
  "zt1a47": {
    "text": "Sarjana, kamu untung besar!",
    "say": "Kaya, kamu!"
  },
  "zt1a48": "Ding.",
  "zt1a49": "Misi: tiga hari, nikahi ketiganya.",
  "zt1a50": "Gagal: dihapus.",
  "zt1a51": "Di… hapus?"
}
