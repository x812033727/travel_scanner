{
  "zt1a01": "농사꾼?",
  "zt1a02": "농학 석사인데요…",
  "zt1a03": "다음.",
  "zt1a04": "농사가 뭐 어때서…",
  "zt1a05": "인연 시스템, 바인딩 완료.",
  "zt1a06": "일어나!",
  "zt1a07": "건졌다! 숨 쉰다!",
  "zt1a08": "여기… 어디지?",
  "zt1a09": "나야, 얼뉴!",
  "zt1a10": "쉬 수재, 놀랐냐?",
  "zt1a11": "호스트: 쉬옌, 수재.",
  "zt1a12": "부채: 스무 냥.",
  "zt1a13": "시작부터 빚이야?",
  "zt1a14": "한밤중에 강에 빠져서,",
  "zt1a15": "오빠!",
  "zt1a16": "오빠 살아 있어!",
  "zt1a17": "나한테… 여동생이?",
  "zt1a18": "첸 나리가 또 빚 받으러 왔어.",
  "zt1a19": "환생했더니 여동생에,",
  "zt1a20": "빚까지 덤?",
  "zt1a21": "오빠, 죽 반 그릇 남았어.",
  "zt1a22": "쉬옌 있나!",
  "zt1a23": "현령 나리의 명이다!",
  "zt1a24": "쉬옌, 스물다섯 미혼!",
  "zt1a25": "신부 셋 배정!",
  "zt1a26": "오늘 혼인한다!",
  "zt1a27": "잠깐, 난…",
  "zt1a28": "오빠, 밖에 신부가 셋이야!",
  "zt1a29": "세… 셋?",
  "zt1a30": "군관 집 고아, 친솽.",
  "zt1a31": "고작 이 몸뚱이?",
  "zt1a32": "죄인 노비, 아링.",
  "zt1a33": "무슨 죄를 지었죠?",
  "zt1a34": "가난뱅이가 고르기까지?",
  "zt1a35": "대형률,",
  "zt1a36": "혼인편 제7조—",
  "zt1a37": "기한은 사흘,",
  "zt1a38": "강제 혼인 불가.",
  "zt1a39": "너…",
  "zt1a40": "오, 법 좀 아네.",
  "zt1a41": "흥, 세 번째는?",
  "zt1a42": "가마에 하나 더!",
  "zt1a43": "비켜요!",
  "zt1a44": "샤오탕이에요!",
  "zt1a45": "부잣집 아씨까지 끼어?",
  "zt1a46": "비단 입고 혼인하러?",
  "zt1a47": "대박이네!",
  "zt1a48": "딩.",
  "zt1a49": "미션: 사흘 안에 세 명과 혼인.",
  "zt1a50": "실패 시— 말살.",
  "zt1a51": "말… 살?"
}
