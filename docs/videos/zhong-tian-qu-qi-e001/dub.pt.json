{
  "zt1a01": "Da roça?",
  "zt1a02": "Sou mestre em agronomia…",
  "zt1a03": "Próximo.",
  "zt1a04": "Qual o problema da roça…",
  "zt1a05": "Sistema Casamenteiro: ativo.",
  "zt1a06": "Vem!",
  "zt1a07": "Peguei! Tá respirando!",
  "zt1a08": "Onde tô?",
  "zt1a09": {
    "text": "Sou eu, o Erniu!",
    "say": "É o Erniu!"
  },
  "zt1a10": {
    "text": "Letrado Xu, ficou bobo?",
    "say": "Ficou bobo, Xu?"
  },
  "zt1a11": "Hospedeiro Xu Yan, letrado.",
  "zt1a12": "Dívida: vinte taéis.",
  "zt1a13": "Já começo devendo?",
  "zt1a14": "Você caiu no rio de noite,",
  "zt1a15": "Mano!",
  "zt1a16": "Você tá vivo, mano!",
  "zt1a17": "Eu… tenho irmã?",
  "zt1a18": "O Senhor Qian veio cobrar.",
  "zt1a19": "Ganhei uma irmã de brinde,",
  "zt1a20": "e uma dívida também?",
  "zt1a21": {
    "text": "Mano, sobrou meia tigela de mingau.",
    "say": "Mano, ainda tem mingau."
  },
  "zt1a22": "Cadê o Xu Yan?!",
  "zt1a23": "Ordem do magistrado!",
  "zt1a24": "Xu Yan, vinte e cinco, solteiro!",
  "zt1a25": "Três noivas!",
  "zt1a26": "Casamento hoje!",
  "zt1a27": "Peraí, eu não…",
  "zt1a28": "Mano, tem três noivas!",
  "zt1a29": "Tr… três?",
  "zt1a30": "Órfã de soldado, Qin Shuang.",
  "zt1a31": "Esse magrelo?",
  "zt1a32": "Serva condenada, A-Ling.",
  "zt1a33": "Qual foi o crime dela?",
  "zt1a34": "Pobretão e ainda escolhe?",
  "zt1a35": {
    "text": "Pelo Código Daheng,",
    "say": "Pela lei,"
  },
  "zt1a36": "casamentos, artigo sete—",
  "zt1a37": "três dias de prazo;",
  "zt1a38": "ninguém casa à força.",
  "zt1a39": "Seu…",
  "zt1a40": "Opa, ele sabe a lei.",
  "zt1a41": "Hunf. E a terceira?",
  "zt1a42": {
    "text": "Mais uma na liteira!",
    "say": "Tem mais uma!"
  },
  "zt1a43": "Licença!",
  "zt1a44": "Sou a Xiaotang!",
  "zt1a45": "Até a riquinha veio?",
  "zt1a46": "De seda, aqui?",
  "zt1a47": {
    "text": "Letrado, você se deu bem!",
    "say": "Você se deu bem!"
  },
  "zt1a48": "Ding.",
  "zt1a49": "Missão: casar com as três em três dias.",
  "zt1a50": "Falha: eliminação.",
  "zt1a51": "E… eliminação?"
}
