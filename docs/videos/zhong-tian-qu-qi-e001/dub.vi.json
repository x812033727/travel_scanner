{
  "zt1a01": "Làm ruộng à?",
  "zt1a02": "Tôi là thạc sĩ nông nghiệp…",
  "zt1a03": "Tiếp theo.",
  "zt1a04": "Làm ruộng thì sao chứ…",
  "zt1a05": "Hệ thống Lương Duyên, đã liên kết.",
  "zt1a06": "Dậy đi!",
  "zt1a07": "Vớt được rồi! Còn thở!",
  "zt1a08": "Đây… là đâu?",
  "zt1a09": "Ta, Nhị Ngưu đây!",
  "zt1a10": "Hứa tú tài, sợ ngốc rồi à?",
  "zt1a11": "Ký chủ: Hứa Nghiên, tú tài.",
  "zt1a12": "Nợ: hai mươi lượng.",
  "zt1a13": "Vừa vào game đã mắc nợ?",
  "zt1a14": "Nửa đêm huynh rơi xuống sông,",
  "zt1a15": "Ca ca!",
  "zt1a16": "Ca ca chưa chết!",
  "zt1a17": "Mình… có em gái á?",
  "zt1a18": "Tiền viên ngoại lại đến đòi nợ.",
  "zt1a19": "Xuyên không tặng em gái,",
  "zt1a20": "tặng kèm cả món nợ?",
  "zt1a21": "Ca, cháo còn nửa bát.",
  "zt1a22": "Hứa Nghiên đâu!",
  "zt1a23": "Phụng lệnh quan huyện!",
  "zt1a24": "Hứa Nghiên, hai mươi lăm chưa vợ!",
  "zt1a25": "Quan phủ gả ba người!",
  "zt1a26": "Hôm nay thành thân!",
  "zt1a27": "Khoan đã, ta không…",
  "zt1a28": "Ca, ngoài kia ba tân nương!",
  "zt1a29": "Ba… ba người?",
  "zt1a30": "Cô nữ quân hộ, Tần Sương.",
  "zt1a31": "Cái thân gầy này?",
  "zt1a32": "Tội nô, A Lệnh.",
  "zt1a33": "Nàng phạm tội gì?",
  "zt1a34": "Nghèo kiết xác còn đòi chọn?",
  "zt1a35": "Đại Hành luật,",
  "zt1a36": "phối hôn, điều thứ bảy—",
  "zt1a37": "hạn trong ba ngày,",
  "zt1a38": "không được ép thành thân.",
  "zt1a39": "Ngươi!",
  "zt1a40": "Ồ, thuộc luật cơ đấy.",
  "zt1a41": "Hừ, người thứ ba đâu?",
  "zt1a42": "Trong kiệu còn nữa!",
  "zt1a43": "Tránh ra nào!",
  "zt1a44": "Gọi ta Tiểu Đường!",
  "zt1a45": "Thiên kim tiểu thư cũng góp mặt?",
  "zt1a46": "Mặc gấm đi phối hôn?",
  "zt1a47": "Tú tài, huynh phát tài rồi!",
  "zt1a48": "Đinh.",
  "zt1a49": "Nhiệm vụ: trong ba ngày, cưới cả ba người.",
  "zt1a50": "Thất bại: xóa sổ.",
  "zt1a51": "Xóa… sổ?"
}
