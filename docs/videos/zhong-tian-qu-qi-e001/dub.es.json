{
  "zt1a01": "¿Agricultor?",
  "zt1a02": {
    "text": "Tengo maestría en agronomía…",
    "say": "Maestría en agronomía…"
  },
  "zt1a03": "Siguiente.",
  "zt1a04": {
    "text": "¿Qué tiene de malo sembrar…?",
    "say": "¿Qué tiene de malo…?"
  },
  "zt1a05": {
    "text": "Sistema Casamentero: vinculación exitosa.",
    "say": "Sistema Casamentero: vinculado."
  },
  "zt1a06": "¡Arriba!",
  "zt1a07": "¡Lo tengo, vive!",
  "zt1a08": "¿Dónde… estoy?",
  "zt1a09": "¡Soy Erniu!",
  "zt1a10": "Letrado Xu, ¿te asustaste?",
  "zt1a11": "Anfitrión: Xu Yan. Letrado.",
  "zt1a12": "Deuda: veinte taeles.",
  "zt1a13": "¿Empiezo endeudado?",
  "zt1a14": "Te caíste al río de noche…",
  "zt1a15": {
    "text": "¡Hermano!",
    "say": "Hermano!"
  },
  "zt1a16": "¡Hermano, vives!",
  "zt1a17": "¿Tengo… una hermana?",
  "zt1a18": "Don Qian volvió a cobrar.",
  "zt1a19": "Otra vida, hermana gratis,",
  "zt1a20": "¿y deuda gratis?",
  "zt1a21": "Hermano, queda medio tazón de gachas.",
  "zt1a22": "¡¿Está Xu Yan?!",
  "zt1a23": "¡Orden del magistrado!",
  "zt1a24": {
    "text": "¡Xu Yan, veinticinco años, soltero!",
    "say": "¡Xu Yan, soltero de veinticinco!"
  },
  "zt1a25": "¡Tres novias!",
  "zt1a26": "¡Boda hoy mismo!",
  "zt1a27": "Espere, yo no…",
  "zt1a28": "¡Hermano, hay tres novias afuera!",
  "zt1a29": "¿Tr… tres?",
  "zt1a30": {
    "text": "Huérfana de soldado, Qin Shuang.",
    "say": "Huérfana, Qin Shuang."
  },
  "zt1a31": "¿Este flaco?",
  "zt1a32": "Convicta, A-Ling.",
  "zt1a33": "¿Qué delito cometió?",
  "zt1a34": "¿Pobretón y quisquilloso?",
  "zt1a35": "Je.",
  "zt1a36": "por ley, artículo siete:",
  "zt1a37": {
    "text": "tres días de plazo;",
    "say": "tres días;"
  },
  "zt1a38": "sin bodas forzadas.",
  "zt1a39": "Tú…",
  "zt1a40": "Vaya, se sabe la ley.",
  "zt1a41": "Hmph. ¿Y la tercera?",
  "zt1a42": "¡Viene otra!",
  "zt1a43": "¡Permiso!",
  "zt1a44": {
    "text": "¡Soy Xiaotang!",
    "say": "¡Xiaotang!"
  },
  "zt1a45": "¿Hasta una niña rica se apunta?",
  "zt1a46": "¿Vestida de seda, aquí?",
  "zt1a47": "¡Ganaste, letrado!",
  "zt1a48": "Ding.",
  "zt1a49": "Misión: tres bodas en tres días.",
  "zt1a50": "Fallo: eliminación.",
  "zt1a51": "¿Eli… minación?"
}
