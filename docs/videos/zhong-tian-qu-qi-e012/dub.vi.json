{
  "zq12a01": "Không đổi.",
  "zq12a02": "Đinh. Hảo cảm tăng.",
  "zq12a03": "Được, có khí phách.",
  "zq12a04": "Sáng mai sổ gửi châu phủ!",
  "zq12a05": "Gửi châu phủ…",
  "zq12a06": "Cả ba đều không giấu nổi.",
  "zq12a07": "Hắn dám tra,",
  "zq12a08": "ta khiến hắn hết dám.",
  "zq12a09": "Sáng mai, gặp ở châu phủ!",
  "zq12a10": "Tiểu Hòa, quay lại!",
  "zq12a11": "Bá bá đánh rơi!",
  "zq12a12": "Nặng quá à!",
  "zq12a13": "Trẻ con nghịch ngợm,",
  "zq12a14": "đưa đây!",
  "zq12a15": "Đại nhân đừng vội,",
  "zq12a16": "đếm ngay tại đây.",
  "zq12a17": "Ngân hiệu Tiền Ký,",
  "zq12a18": "năm mươi lượng chẵn.",
  "zq12a19": "Tiền Ký?",
  "zq12a20": "Của nhà Tiền viên ngoại!",
  "zq12a21": "Trong túi:",
  "zq12a22": "còn một mảnh giấy.",
  "zq12a23": "Xong việc,",
  "zq12a24": "trả tiếp.",
  "zq12a25": {
    "text": "Tiền viên ngoại,",
    "say": "Lão Tiền,"
  },
  "zq12a26": "vội đi đâu thế?",
  "zq12a27": "Đại nhân,",
  "zq12a28": "sổ này, còn tra không?",
  "zq12a29": "Không, không tra nữa.",
  "zq12a30": "Rút, rút về!",
  "zq12a31": "Tiền là hắn đưa,",
  "zq12a32": "nhưng chủ ý thì không…",
  "zq12a33": {
    "text": "Đinh. Nhận được: kỹ thuật làm giấy cải tiến.",
    "say": "Đinh. Nhận: kỹ thuật làm giấy cải tiến."
  },
  "zq12a34": "Cuối cùng cũng có đồ tốt.",
  "zq12a35": "Nhiệm vụ bắt buộc: trong mười ngày, một trăm tờ giấy trắng.",
  "zq12a36": "Một trăm tờ?",
  "zq12a37": "Ta còn chẳng có xưởng giấy!",
  "zq12a38": "Thất bại: mất khả năng đọc viết."
}
