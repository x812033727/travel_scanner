{
  "zq12a01": "断る。",
  "zq12a02": "ピコン、好感度上昇。",
  "zq12a03": "よかろう、骨のある奴だ。",
  "zq12a04": "名簿は明朝、州府へ送る！",
  "zq12a05": "州府へ……",
  "zq12a06": "全員バレる。",
  "zq12a07": "調べる気なら、",
  "zq12a08": "調べさせない。",
  "zq12a09": "明朝、州府でな！",
  "zq12a10": "シャオホー、戻って！",
  "zq12a11": "落とし物だよ！",
  "zq12a12": "重たーい！",
  "zq12a13": "戯れだ、",
  "zq12a14": "よこせ！",
  "zq12a15": "閣下、慌てずに、",
  "zq12a16": "皆で数えよう。",
  "zq12a17": "チエン記銀号、",
  "zq12a18": "五十両ちょうど。",
  "zq12a19": "チエン？",
  "zq12a20": "チエン旦那のだ！",
  "zq12a21": "中に、",
  "zq12a22": "書付がある。",
  "zq12a23": "事成れば、",
  "zq12a24": "残りを払う。",
  "zq12a25": "おや、",
  "zq12a26": "どちらへ？",
  "zq12a27": "さて、",
  "zq12a28": "名簿、まだ調べます？",
  "zq12a29": "し、調べぬ。",
  "zq12a30": "て、撤収！",
  "zq12a31": "金は奴、",
  "zq12a32": "知恵は別の……",
  "zq12a33": "ピコン。製紙術の改良を獲得。",
  "zq12a34": "やっとまともな物が。",
  "zq12a35": "強制任務：十日以内に、白紙百枚。",
  "zq12a36": "百枚？",
  "zq12a37": "紙すき場もないのに！",
  "zq12a38": "失敗：読み書き喪失。"
}
