{
  "zq12a01": "No deal.",
  "zq12a02": "Ding. Affection rising.",
  "zq12a03": "Fine. Bold.",
  "zq12a04": "The register goes to the prefecture!",
  "zq12a05": "The prefecture…",
  "zq12a06": "none of us can hide.",
  "zq12a07": "If he wants to check,",
  "zq12a08": "we make him afraid.",
  "zq12a09": "Tomorrow, at the prefecture!",
  "zq12a10": "Xiaohe, come back!",
  "zq12a11": "You dropped this!",
  "zq12a12": "It's so heavy!",
  "zq12a13": "Kids' games,",
  "zq12a14": "give it here!",
  "zq12a15": "No rush, Your Honor,",
  "zq12a16": "let's count it here.",
  "zq12a17": "Qian's Bank,",
  "zq12a18": "fifty, even.",
  "zq12a19": "Qian's?",
  "zq12a20": "That's Squire Qian's!",
  "zq12a21": "Look—",
  "zq12a22": "there's a note, too.",
  "zq12a23": "When it's done,",
  "zq12a24": "more to come.",
  "zq12a25": "Ha!",
  "zq12a26": "where you off to?",
  "zq12a27": "Your Honor,",
  "zq12a28": "still checking the register?",
  "zq12a29": "N-no, no need.",
  "zq12a30": "F-fall back!",
  "zq12a31": "The money was his,",
  "zq12a32": "but the idea wasn't…",
  "zq12a33": "Ding. Acquired: improved papermaking.",
  "zq12a34": "Finally, something useful.",
  "zq12a35": "Mandatory mission: one hundred sheets of white paper in ten days.",
  "zq12a36": "A hundred?",
  "zq12a37": "I don't even have a paper mill!",
  "zq12a38": "Failure: loss of literacy."
}
