{
  "zq12a01": "Não troco.",
  "zq12a02": "Ding. Afeição subindo.",
  "zq12a03": "Muito bem. Corajoso.",
  "zq12a04": "O registro vai pra província amanhã!",
  "zq12a05": "Pra província…",
  "zq12a06": "nenhuma de nós escapa.",
  "zq12a07": "Se ele quer conferir,",
  "zq12a08": "vai desistir.",
  "zq12a09": "Amanhã, na província!",
  "zq12a10": "Xiaohe, volta aqui!",
  "zq12a11": "Caiu, tio!",
  "zq12a12": "Que pesado!",
  "zq12a13": "Coisa de criança,",
  "zq12a14": "me dá isso!",
  "zq12a15": "Calma, Excelência,",
  "zq12a16": "vamos contar aqui.",
  "zq12a17": "Banco Qian,",
  "zq12a18": {
    "text": "cinquenta certinho.",
    "say": "cinquenta!"
  },
  "zq12a19": "Qian?",
  "zq12a20": "É do Senhor Qian!",
  "zq12a21": "Olha,",
  "zq12a22": "tem um bilhete.",
  "zq12a23": {
    "text": "Serviço feito,",
    "say": "Feito,"
  },
  "zq12a24": "pago o resto.",
  "zq12a25": {
    "text": "Senhor Qian,",
    "say": "Ei!"
  },
  "zq12a26": "vai aonde?",
  "zq12a27": {
    "text": "Senhor,",
    "say": "Então,"
  },
  "zq12a28": "ainda vai conferir o registro?",
  "zq12a29": {
    "text": "N… não precisa.",
    "say": "Não… não."
  },
  "zq12a30": "Re… recuar!",
  "zq12a31": "O dinheiro era dele,",
  "zq12a32": "mas a ideia não…",
  "zq12a33": {
    "text": "Ding. Ganho: fabricação de papel aprimorada.",
    "say": "Ding. Ganho: papel aprimorado."
  },
  "zq12a34": "Enfim, algo útil.",
  "zq12a35": {
    "text": "Missão obrigatória: cem folhas de papel branco em dez dias.",
    "say": "Missão obrigatória: cem folhas brancas em dez dias."
  },
  "zq12a36": {
    "text": "Cem folhas?",
    "say": "Cem?"
  },
  "zq12a37": "Eu nem tenho oficina!",
  "zq12a38": {
    "text": "Falha: perda da leitura e da escrita.",
    "say": "Falha: perda da leitura."
  }
}
