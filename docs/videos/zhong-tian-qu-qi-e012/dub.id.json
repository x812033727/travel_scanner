{
  "zq12a01": "Nggak tukar.",
  "zq12a02": "Ding, poin suka naik.",
  "zq12a03": "Baik, punya nyali.",
  "zq12a04": "Besok pagi, daftar ke provinsi!",
  "zq12a05": "Ke provinsi…",
  "zq12a06": "kami bertiga ketahuan.",
  "zq12a07": "Dia berani periksa,",
  "zq12a08": "kita bikin dia takut.",
  "zq12a09": "Besok pagi, di provinsi!",
  "zq12a10": "Xiaohe, balik!",
  "zq12a11": {
    "text": "Ini jatuh!",
    "say": "Jatuh!"
  },
  "zq12a12": "Berat banget!",
  "zq12a13": "Anak kecil iseng,",
  "zq12a14": "Berikan!",
  "zq12a15": "Sabar, Tuan,",
  "zq12a16": "kita hitung di sini.",
  "zq12a17": "Bank Qian,",
  "zq12a18": "lima puluh pas.",
  "zq12a19": {
    "text": "Bank Qian?",
    "say": "Qian?"
  },
  "zq12a20": "Punya Tuan Qian!",
  "zq12a21": "Lihat—",
  "zq12a22": "ada secarik surat.",
  "zq12a23": "Beres:",
  "zq12a24": "dibayar lagi.",
  "zq12a25": {
    "text": "Tuan Qian,",
    "say": "Eits!"
  },
  "zq12a26": "mau ke mana?",
  "zq12a27": "Tuan.",
  "zq12a28": "daftarnya masih mau diperiksa?",
  "zq12a29": "Ti… tidak usah.",
  "zq12a30": "Bu… bubar!",
  "zq12a31": "Uangnya dari dia,",
  "zq12a32": "tapi idenya bukan…",
  "zq12a33": "Ding. Didapat: teknik kertas yang lebih baik.",
  "zq12a34": "Akhirnya, yang berguna.",
  "zq12a35": "Misi wajib: dalam sepuluh hari, seratus lembar kertas putih.",
  "zq12a36": "Seratus?",
  "zq12a37": "Pabrik kertas pun nggak ada!",
  "zq12a38": {
    "text": "Gagal: kehilangan kemampuan baca tulis.",
    "say": "Gagal: buta huruf."
  }
}
