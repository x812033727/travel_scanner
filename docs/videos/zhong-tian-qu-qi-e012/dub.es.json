{
  "zq12a01": "No acepto.",
  "zq12a02": "Ding. El afecto sube.",
  "zq12a03": "Bien. Qué agallas.",
  "zq12a04": {
    "text": "¡Mañana el registro va a la prefectura!",
    "say": "¡Mañana, a la prefectura!"
  },
  "zq12a05": "A la prefectura…",
  "zq12a06": "caemos las tres.",
  "zq12a07": "Si quiere revisar,",
  "zq12a08": "lo asustamos.",
  "zq12a09": "¡Mañana, en la prefectura!",
  "zq12a10": "¡Xiaohe, ven acá!",
  "zq12a11": {
    "text": "¡Señor, se le cayó!",
    "say": "¡Se le cayó!"
  },
  "zq12a12": "¡Pesa mucho!",
  "zq12a13": "Juegos de niños,",
  "zq12a14": "¡dámelo!",
  "zq12a15": "Calma, Su Señoría,",
  "zq12a16": "contémoslo aquí.",
  "zq12a17": "Banco Qian,",
  "zq12a18": {
    "text": "cincuenta taeles exactos.",
    "say": "cincuenta."
  },
  "zq12a19": "¿De Qian?",
  "zq12a20": "¡Es de don Qian!",
  "zq12a21": "Hay",
  "zq12a22": "una nota también.",
  "zq12a23": "«Hecho,",
  "zq12a24": "pago el resto».",
  "zq12a25": "¡Ja!",
  "zq12a26": {
    "text": "¿Ya se va, don Qian?",
    "say": "¿Ya se va?"
  },
  "zq12a27": {
    "text": "Señor,",
    "say": "Oiga,"
  },
  "zq12a28": "¿todavía revisa el registro?",
  "zq12a29": {
    "text": "No… ya no.",
    "say": "No, no."
  },
  "zq12a30": "¡Retirada!",
  "zq12a31": "El dinero fue de él,",
  "zq12a32": "pero la idea no…",
  "zq12a33": {
    "text": "Ding. Obtenido: técnica de papel mejorada.",
    "say": "Ding. Obtenido: papel mejorado."
  },
  "zq12a34": "Por fin, algo útil.",
  "zq12a35": {
    "text": "Misión obligatoria: cien hojas de papel blanco en diez días.",
    "say": "Misión obligatoria: cien hojas en diez días."
  },
  "zq12a36": "¿Cien…?",
  "zq12a37": "¡Ni siquiera tengo taller!",
  "zq12a38": {
    "text": "Fallo: pierdes la lectura y la escritura.",
    "say": "Fallo: analfabetismo."
  }
}
