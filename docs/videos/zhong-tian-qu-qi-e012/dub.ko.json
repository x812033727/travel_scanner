{
  "zq12a01": "안 바꿔.",
  "zq12a02": "딩, 호감 상승.",
  "zq12a03": "좋아, 기개가 있군.",
  "zq12a04": "명부는 내일 주 관아로!",
  "zq12a05": "주 관아로…",
  "zq12a06": "셋 다 못 숨겨.",
  "zq12a07": "조사하겠다면,",
  "zq12a08": "못 하게 해야지.",
  "zq12a09": "내일 아침, 주 관아에서!",
  "zq12a10": "샤오허, 돌아와!",
  "zq12a11": "아저씨 거야!",
  "zq12a12": "엄청 무거워!",
  "zq12a13": "장난이다,",
  "zq12a14": "이리 내!",
  "zq12a15": "진정하시죠,",
  "zq12a16": "같이 세 보죠.",
  "zq12a17": "첸기 전장,",
  "zq12a18": "딱 쉰 냥.",
  "zq12a19": "첸기?",
  "zq12a20": "첸 나리네 거잖아!",
  "zq12a21": "어,",
  "zq12a22": "쪽지도 있네.",
  "zq12a23": "되면,",
  "zq12a24": "잔금 지급.",
  "zq12a25": "거기,",
  "zq12a26": "어디 가셔?",
  "zq12a27": "자,",
  "zq12a28": "명부, 계속 조사하시죠?",
  "zq12a29": "안 해.",
  "zq12a30": "철, 철수!",
  "zq12a31": "돈은 저자가,",
  "zq12a32": "계획은 따로…",
  "zq12a33": "딩. 획득: 제지술 개량.",
  "zq12a34": "드디어 쓸 만하네.",
  "zq12a35": "강제 미션: 열흘 안에, 흰 종이 백 장.",
  "zq12a36": "백 장?",
  "zq12a37": "종이 공방도 없는데!",
  "zq12a38": "실패 시: 문맹."
}
