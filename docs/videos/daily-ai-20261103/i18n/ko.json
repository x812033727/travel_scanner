  "lines": {
    "eius": {
      "source_hash": "ea7a437e6aa6",
      "text": "오늘은 11월 3일 화요일."
    },
    "f00v": {
      "source_hash": "70acdd04953e",
      "text": "여기는 Tech Signal, 잡음 속에서 오늘 정말 중요한 신호를 골라요."
    },
    "v99s": {
      "source_hash": "97e2115b9cf9",
      "text": "Sola예요."
    },
    "pnuf": {
      "source_hash": "cf9f8841a94f",
      "text": "Kai예요."
    },
    "mrgu": {
      "source_hash": "0e5d9894fa7c",
      "text": "오늘 주제는 900여 정부 기관의 사이트 인증서, 이번 금요일 11월 6일 전 교체예요."
    },
    "mzc4": {
      "source_hash": "730cef2339e7",
      "text": "잠깐, 금요일 지나면 그 사이트 열 때 어떻게 돼요?"
    },
    "v7on": {
      "source_hash": "9b50c6f7e607",
      "text": "매일 여는 사이트엔 문제, 쓰는 AI도 변화. 먼저 어제 11월 2일 뉴스."
    },
    "dlmd": {
      "source_hash": "a585a70ad3c7",
      "text": "제일 많이 쓰는 것부터요."
    },
    "nzz5": {
      "source_hash": "f98d66788fdf",
      "text": "TechCrunch: OpenAI 공지"
    },
    "o214": {
      "source_hash": "8d679b9c0f36",
      "text": "ChatGPT 데스크톱 Chat·Work 탭이 합쳐져요."
    },
    "ukeq": {
      "source_hash": "afa2798b3de1",
      "text": "탭이 많으면 어디인지 헷갈리죠?"
    },
    "mzba": {
      "source_hash": "fb44041b4730",
      "text": "TechCrunch도 같은 해석. 합치면 내 파일·플러그인도."
    },
    "514p": {
      "source_hash": "f1b7aa3d442a",
      "text": "단, 코딩용 Codex는 따로 남아요."
    },
    "ka6r": {
      "source_hash": "7f4c3bf462a3",
      "text": "OpenAI 예시는 사이트·슬라이드 제작,"
    },
    "zrrd": {
      "source_hash": "3128b3849739",
      "text": "웹 일 대행, 옆에서 보며 수시로 수정."
    },
    "i0kh": {
      "source_hash": "3830ad2d9565",
      "text": "다른 데도요?"
    },
    "kpvy": {
      "source_hash": "c99eb0dccd4f",
      "text": "TechCrunch: Claude는 9월 채팅·Cowork 한 화면."
    },
    "s2w2": {
      "source_hash": "6a0b5d8f934b",
      "text": "핵심은 한도예요. 이제 ChatGPT와 Codex가 같은 토큰 한도를 써요."
    },
    "a0s2": {
      "source_hash": "097f2516864b",
      "text": "토큰은 AI 사용량 단위죠?"
    },
    "zndh": {
      "source_hash": "853b8836baf0",
      "text": "OpenAI는 대부분 괜찮대요."
    },
    "l28k": {
      "source_hash": "08ca66479f09",
      "text": "다만 많이 쓰면 리셋 대기가 늘 수도."
    },
    "ikue": {
      "source_hash": "8c61e4ffecfb",
      "text": "처음엔 일부만요?"
    },
    "m0j4": {
      "source_hash": "7f210665af6a",
      "text": "네, 의견을 모은 뒤 전면 출시해요."
    },
    "4woq": {
      "source_hash": "a9e46a7ffc36",
      "text": "쓰는 AI에서, AI가 쓰는 콘텐츠로."
    },
    "nf8a": {
      "source_hash": "607f6c39656c",
      "text": "The Verge에 따르면 뉴욕타임스 등이 Brave 개발사를 고소."
    },
    "zpf8": {
      "source_hash": "980004dc0a6d",
      "text": "브라우저도 고소돼요? 왜요?"
    },
    "m29b": {
      "source_hash": "0019e4e4c905",
      "text": "신문 3곳 소장: 첫째, 허가 없이 뉴스 사이트 대량 크롤링."
    },
    "viek": {
      "source_hash": "9033b0378d49",
      "text": "둘째, 정리한 색인을 AI 기업에 유료 제공."
    },
    "toml": {
      "source_hash": "0629e8e3e95f",
      "text": "셋째, 페이월을 우회해 유료 기사를 무료로."
    },
    "tfvh": {
      "source_hash": "4af21be82f0d",
      "text": "받은 AI 기업은요?"
    },
    "rlmd": {
      "source_hash": "d2aab51e0b79",
      "text": "소장엔 Anthropic, Perplexity 등."
    },
    "cx7r": {
      "source_hash": "3a362f5c1b4f",
      "text": "Brave에 페이월 우회가?"
    },
    "v9cr": {
      "source_hash": "dbed910ed1c6",
      "text": "The Verge: Brave가 페이월 차단 홍보."
    },
    "y95p": {
      "source_hash": "5dda44f5b349",
      "text": "혐의와의 관계는 보도에 없어요."
    },
    "5hvj": {
      "source_hash": "b6f3ab24c864",
      "text": "뉴욕타임스 측은 Brave가 저작권법을 무시하고,"
    },
    "fdd7": {
      "source_hash": "e1add52d6094",
      "text": "중단 요청도 계속 무시했대요."
    },
    "qe3k": {
      "source_hash": "3164501ddde0",
      "text": "센 말이네요. 지목된 AI 기업은요?"
    },
    "80c1": {
      "source_hash": "6cf72ba49f94",
      "text": "대부분 무응답, Perplexity 홍보 담당만 한마디."
    },
    "257x": {
      "source_hash": "5d17c89b59fd",
      "text": "뉴욕타임스는 변호사엔 후하고 기자엔 박하대요."
    },
    "x79m": {
      "source_hash": "5b5ae0968855",
      "text": "모두 원고 주장이고, 판결 보도는 없어요."
    },
    "v1jl": {
      "source_hash": "d4fb8bf9af2a",
      "text": "Brave 유저는?"
    },
    "4nj9": {
      "source_hash": "9990f1e55086",
      "text": "일단 Brave 대응을 봐요."
    },
    "b2bl": {
      "source_hash": "8a9a8c03cbc7",
      "text": "그사이 Google 모델은 한발 더."
    },
    "taej": {
      "source_hash": "3d66a66d5ab5",
      "text": "DeepMind 10월 27일 월드 모델 Genie 4, 어제 Google도."
    },
    "rt0d": {
      "source_hash": "707ee6e3f098",
      "text": "월드 모델? 좀 추상적인데요."
    },
    "1ixa": {
      "source_hash": "4f1770bb6367",
      "text": "쉽게 말해, 글을 치면 영상·소리 장면이 나와요."
    },
    "rmb4": {
      "source_hash": "d07a5021a926",
      "text": "키로 걷고 시점 회전."
    },
    "c7xv": {
      "source_hash": "7b992a5cbf33",
      "text": "입력하면 날씨·인물도 즉석 변경."
    },
    "vm0i": {
      "source_hash": "894745e621a5",
      "text": "타이핑으로 바꾸는 게임 세계네요?"
    },
    "4hqo": {
      "source_hash": "53a43ee78746",
      "text": "그렇죠. 단 지금은 신뢰 테스터용 연구 프리뷰."
    },
    "kh8c": {
      "source_hash": "c6aa6b3d9361",
      "text": "이후 Google AI Ultra 구독자와 초기 파트너 개발자에게 공개."
    },
    "d6uj": {
      "source_hash": "46c48655af90",
      "text": "대만에선 아직 못 쓰네요."
    },
    "24id": {
      "source_hash": "74edfd27867e",
      "text": "네, DeepMind도 장시간엔 세부가 무너질 수 있대요."
    },
    "gbk6": {
      "source_hash": "266063a43dce",
      "text": "Genie 4 결과물엔 SynthID 워터마크."
    },
    "1wn0": {
      "source_hash": "4bd780f40848",
      "text": "워터마크? 보여요?"
    },
    "wbhp": {
      "source_hash": "c3189e3b525e",
      "text": "육안 불가, Google 도구로 탐지."
    },
    "qzzy": {
      "source_hash": "bdcf1592fd78",
      "text": "자, ChatGPT는 일반인용, 이건 개발자용 소식이죠."
    },
    "iuqx": {
      "source_hash": "3c58ff334019",
      "text": "Anthropic, 어제 메시지 스레드 공개 베타. Claude 에이전트 개발용."
    },
    "2w31": {
      "source_hash": "b571c3fc9d4c",
      "text": "스레드? 앱 채팅과 관련 있어요?"
    },
    "r7p9": {
      "source_hash": "84bd1ed5435c",
      "text": "주로 개발자 얘기예요. 전엔 에이전트가 매 턴 대화 전체를 다시 보냈어요."
    },
    "vkiq": {
      "source_hash": "1ed66367e629",
      "text": "길수록 더 많이 보내죠."
    },
    "nxiw": {
      "source_hash": "9640ff040913",
      "text": "이제 대화는 서버에 두고 새 메시지만 보내요."
    },
    "tq4k": {
      "source_hash": "cc1c0de63de8",
      "text": "효과요? Anthropic은 50만~100만 토큰에서,"
    },
    "g7ke": {
      "source_hash": "3c607048f6a1",
      "text": "첫 응답까지 중앙값 약 35% 단축."
    },
    "wg35": {
      "source_hash": "4fb1312413cd",
      "text": "돈도요?"
    },
    "7j9q": {
      "source_hash": "6eb3c6bd4b0a",
      "text": "아뇨. 매 턴 전체를 읽어 토큰·요금은 그대로."
    },
    "jrm6": {
      "source_hash": "744788f4c305",
      "text": "게다가 5분 쉬면 만료돼 전체를 다시 보내야 해요."
    },
    "9y58": {
      "source_hash": "349790f26a10",
      "text": "서버에 두면 안전해요?"
    },
    "qzhk": {
      "source_hash": "b6d633bd0192",
      "text": "턴 사이엔 암호화해 메모리에, 디스크엔 안 쓴대요."
    },
    "1pe4": {
      "source_hash": "c1f8d1dcb186",
      "text": "늦어도 마지막 사용 1시간 내 삭제."
    },
    "lg3m": {
      "source_hash": "ccba576229e3",
      "text": "Google Cloud, Antigravity에 공식 플러그인."
    },
    "4t7p": {
      "source_hash": "01a4b0805475",
      "text": "플러그인은 뭘 도와요?"
    },
    "hiuy": {
      "source_hash": "05b6f96d363b",
      "text": "첫째, 최신 공식 문서로 낡은 코드를 줄여요."
    },
    "ubrh": {
      "source_hash": "65f5971c9afe",
      "text": "둘째, 유료 기능·설정 변경 전에 물어요."
    },
    "pq8y": {
      "source_hash": "2f0795f89528",
      "text": "중요해요. AI가 유료 서비스 켜면 요금 폭탄."
    },
    "fr7o": {
      "source_hash": "7a292a494316",
      "text": "셋째, 필요한 권한만 받아요."
    },
    "53j2": {
      "source_hash": "d09c0819f3e7",
      "text": "설치는 이 명령 한 줄."
    },
    "14xe": {
      "source_hash": "e28b8d51a89b",
      "text": "Google: 내장 문서 서버 사전 인증, API 키 불필요."
    },
    "hh94": {
      "source_hash": "92542ca1ffc1",
      "text": "인증 설정이 없으니 초보자에게 좋네요."
    },
    "kj6x": {
      "source_hash": "512afa99b55a",
      "text": "다 Google 주장, 독립 검증 없음."
    },
    "kwp3": {
      "source_hash": "b60aaca515ac",
      "text": "쓴다면 처음 몇 번은 직접 지켜봐요."
    },
    "9uxd": {
      "source_hash": "92f5e8e9ed30",
      "text": "클라우드가 바쁠수록 전기. 오늘의 숫자: 1,000메가와트."
    },
    "en9v": {
      "source_hash": "6fc695b49d8f",
      "text": "1,000…… 메가와트? 그게 얼마나 돼요?"
    },
    "pb84": {
      "source_hash": "6a64dc754db4",
      "text": "The Verge: 약 70만 가구 냉방분."
    },
    "d7ja": {
      "source_hash": "eba100595f90",
      "text": "OpenAI는 조지아주 신설 데이터센터에서 시범."
    },
    "hnnd": {
      "source_hash": "274566ac4ff8",
      "text": "극한 날씨나 비상시 최대 이만큼 전력을 내놔요."
    },
    "0l0g": {
      "source_hash": "10f38fec97f4",
      "text": "이웃 달래기죠?"
    },
    "47c4": {
      "source_hash": "f05512f6f1cd",
      "text": "배경엔 미국 곳곳의 데이터센터 반대 여론. 다만 효과·일정은 보도가 없어요."
    },
    "r5yp": {
      "source_hash": "80698c5a53fc",
      "text": "OpenAI는 이 발전소를 지역이 가장 필요할 때 전력회사가 쓸 자원이라고."
    },
    "dma7": {
      "source_hash": "99e701288a1b",
      "text": "말은 좋은데, 두고 봐야죠."
    },
    "wc9b": {
      "source_hash": "cb16981d9791",
      "text": "The Verge 예로 유타주 승인 데이터센터는"
    },
    "qr0z": {
      "source_hash": "9a463d7d4222",
      "text": "주 2025년 피크의 2배 이상 예상."
    },
    "zft1": {
      "source_hash": "6f52ddfe05df",
      "text": "2배? 반발할 만하네요."
    },
    "pfbg": {
      "source_hash": "676e0f01b829",
      "text": "테네시·플로리다 등도 AI 기업의 에너지 비용 전가를 막는 법을 만들었어요."
    },
    "r4hb": {
      "source_hash": "b98d925d7bfc",
      "text": "그러니까 전력과 전기요금이 이웃의 최대 관심사네요."
    },
    "z43j": {
      "source_hash": "73ce376767d9",
      "text": "대만엔 무슨 상관?"
    },
    "mfkj": {
      "source_hash": "ee79f1052b65",
      "text": "미국 시범이라 직접 영향 없어요."
    },
    "z60w": {
      "source_hash": "df077c77f396",
      "text": "볼 건, AI 전력을 누가 부담하냐가 데이터센터가 답해야 할 질문이 됐다는 점."
    },
    "az7e": {
      "source_hash": "f7669cbac03a",
      "text": "데이터센터는 이웃에, 대만은 정부 사이트가 책임."
    },
    "knly": {
      "source_hash": "115d8958f501",
      "text": "오늘 주제, 정부 사이트 인증서요?"
    },
    "4ozf": {
      "source_hash": "ed1c3881d8e4",
      "text": "네, 메일 한 통부터."
    },
    "0kvh": {
      "source_hash": "75a3a62c29bb",
      "text": "정부기관 IT 담당자라고 상상해 봐요."
    },
    "lfuc": {
      "source_hash": "ad10f1107cd2",
      "text": "11월 초, 시스템 메일이 왔는데 첨부는 새 사이트 인증서예요."
    },
    "ebui": {
      "source_hash": "0857cd2bd80e",
      "text": "신청 안 했는데?"
    },
    "3ul9": {
      "source_hash": "5360bdbaf4d4",
      "text": "원래 것이 문제라 TWCA가 재발급."
    },
    "br47": {
      "source_hash": "8a2e6a36133a",
      "text": "기한 전에 바꾸는 게 할 일이에요."
    },
    "32bl": {
      "source_hash": "ad3006171aa3",
      "text": "그럼 이 메일은 기한 있는 작업 지시서네요?"
    },
    "pdxn": {
      "source_hash": "474b1f5fede3",
      "text": "그렇죠. 같은 메일이 각 기관 담당자들에게 갔어요."
    },
    "x933": {
      "source_hash": "4989b81bc638",
      "text": "나만요?"
    },
    "jpt3": {
      "source_hash": "aeff14d5ff09",
      "text": "아뇨. 대만 900여 기관이 이번 집계에."
    },
    "yxr4": {
      "source_hash": "214e2587045e",
      "text": "인증서는 모두 9,772장이에요."
    },
    "icuv": {
      "source_hash": "e9acac42318a",
      "text": "평균 한 기관당 약 10장이에요."
    },
    "mif0": {
      "source_hash": "1900917d478b",
      "text": "잠깐, 되감기. 인증서가 뭐예요?"
    },
    "qfgy": {
      "source_hash": "f4ce0832804f",
      "text": "쉽게 말해, 안전한 통신용 사이트 전자 인증서예요."
    },
    "uqqs": {
      "source_hash": "60b4dd333882",
      "text": "화면의 TLS는요?"
    },
    "mdc4": {
      "source_hash": "0f96c3c9be2a",
      "text": "전송 계층 보안의 약자로, 이런 안전한 통신의 규격이에요."
    },
    "2ttq": {
      "source_hash": "c9ef63fd2377",
      "text": "나와 사이트 사이 통로의 자물쇠."
    },
    "meem": {
      "source_hash": "200d4f40b0fd",
      "text": "신청도 검색도 이 통로죠."
    },
    "qlp6": {
      "source_hash": "201ac00f9ac8",
      "text": "네, 그래서 세계 공통 표준이 있어요."
    },
    "erw0": {
      "source_hash": "b451cec6d901",
      "text": "인증서마다 일련번호가."
    },
    "gtvb": {
      "source_hash": "0c2177aef268",
      "text": "국제 표준: 일련번호에 최소 64비트, 추측 불가한 암호학적 난수."
    },
    "a9ri": {
      "source_hash": "4adc57a6061a",
      "text": "암호학적이면 뭐가 달라요?"
    },
    "hbcd": {
      "source_hash": "84638f446881",
      "text": "전용 방법으로 만들어 아무도 추측 못 하는 난수예요."
    },
    "2i1z": {
      "source_hash": "a93838d25d77",
      "text": "길이보다 추측 불가가 핵심이네요."
    },
    "ic4d": {
      "source_hash": "1425e7db53bf",
      "text": "TWCA 일련번호는 총 128비트로, 길이만 보면 64보다 길어요."
    },
    "gmw9": {
      "source_hash": "ac358757e543",
      "text": "충분하죠?"
    },
    "dik4": {
      "source_hash": "1e0c4609446d",
      "text": "문제는 가운데. 중간 대부분이 고정값이었어요."
    },
    "l0zw": {
      "source_hash": "e12496d1ebd4",
      "text": "진짜 무작위는 앞뒤 12비트씩, 합쳐 24비트뿐."
    },
    "ynnq": {
      "source_hash": "258627360fca",
      "text": "128칸 번호 자물쇠 같네요."
    },
    "3qyc": {
      "source_hash": "e940d6ced46f",
      "text": "네, 근데 도는 건 24칸, 가운데 104칸은 용접됐어요."
    },
    "ec2u": {
      "source_hash": "77733d46aede",
      "text": "길면 안전할 것 같지만, 진짜 추측 불가한 양이 중요해요."
    },
    "1kw3": {
      "source_hash": "83d35b27ea0e",
      "text": "24와 64, 차이는 40뿐?"
    },
    "c7a9": {
      "source_hash": "8af24d05b8f4",
      "text": "40 차이가 아니라, 1비트마다 2배예요."
    },
    "y0sv": {
      "source_hash": "7cbbd4fe6c2f",
      "text": "24비트는 약 1,600만여 가지."
    },
    "np4m": {
      "source_hash": "ae8e68f206b1",
      "text": "64비트는 그 1조 배 이상."
    },
    "748c": {
      "source_hash": "34876473fcc1",
      "text": "2배가 무슨 뜻?"
    },
    "j1tm": {
      "source_hash": "e1eacd654cd0",
      "text": "1비트는 경우가 2개."
    },
    "9a4v": {
      "source_hash": "38af564198da",
      "text": "2비트면 4개, 3비트면 8개."
    },
    "cjx3": {
      "source_hash": "359b5cb8c469",
      "text": "계속 2배씩이면 엄청 커지네요."
    },
    "e8o9": {
      "source_hash": "871200448e6a",
      "text": "누가 신고했어요?"
    },
    "23j0": {
      "source_hash": "824c412765e4",
      "text": "10월 30일 Bugzilla에 신고, 국제 신고 플랫폼."
    },
    "6qux": {
      "source_hash": "67a297ba503c",
      "text": "당일요?"
    },
    "li4w": {
      "source_hash": "41cf019e2dd2",
      "text": "네, 디지털부 말로 당일."
    },
    "kti4": {
      "source_hash": "01e2fbf3dd34",
      "text": "시간순으로. 신고 당일,"
    },
    "kr7t": {
      "source_hash": "15f479c01f2d",
      "text": "디지털부는 이틀 안에 표준 새 인증서를 요구."
    },
    "elqz": {
      "source_hash": "eff61aab0fc0",
      "text": "이틀, 촉박하네요."
    },
    "vtyu": {
      "source_hash": "759d267f96d0",
      "text": "이틀 뒤 TWCA가 전부 다시 만들었어요."
    },
    "0dp1": {
      "source_hash": "a7d04b3e0acf",
      "text": "어려운 건 기관별 설치."
    },
    "6be6": {
      "source_hash": "c2953c9d5c3a",
      "text": "이어 새 인증서가 기관들로."
    },
    "eu50": {
      "source_hash": "9e4eae0e93f5",
      "text": "기관 IT 책임자에게도 독촉 부탁."
    },
    "i8fd": {
      "source_hash": "937211813762",
      "text": "상사까지."
    },
    "x50d": {
      "source_hash": "9ea012e0e87a",
      "text": "11월 2일 밤까지 926장 교체 완료."
    },
    "jrr2": {
      "source_hash": "e34e0b4bb76e",
      "text": "기한은 이번 금요일."
    },
    "u9zu": {
      "source_hash": "6d3a80bc36f6",
      "text": "겨우 900여 장?"
    },
    "mbdm": {
      "source_hash": "1bbc1885f0ae",
      "text": "네, 10% 미만."
    },
    "rcyb": {
      "source_hash": "560917204967",
      "text": "다르게 계산해 보면, 남은 건 8,846장,"
    },
    "2a2u": {
      "source_hash": "c3cf034a3a13",
      "text": "4일 만에?"
    },
    "dtn9": {
      "source_hash": "cac6b0bd22a4",
      "text": "하루 평균 약 2,200장이에요."
    },
    "2efb": {
      "source_hash": "e2b2668f57dd",
      "text": "결국 누가 떠안죠?"
    },
    "06jg": {
      "source_hash": "f511bc080f21",
      "text": "먼저 기관 IT 담당자, 야근하는 분들."
    },
    "fbk7": {
      "source_hash": "9a1450c37f42",
      "text": "다음은 TWCA. 디지털부는 독립 제3자에게 정밀 검사를 맡겼어요."
    },
    "zlqp": {
      "source_hash": "b6740c8ffeb9",
      "text": "검사로 끝나요?"
    },
    "n7o2": {
      "source_hash": "5dd4688cc6c9",
      "text": "이후 위약 조사, 계약대로 벌금·배상."
    },
    "p3w3": {
      "source_hash": "65d123d69328",
      "text": "왜 다 같은 회사죠?"
    },
    "iopm": {
      "source_hash": "7395ec204290",
      "text": "디지털부가 구매해 각 기관이 신청해 쓰는 인증서라서요."
    },
    "lu8h": {
      "source_hash": "aac0aa7eb448",
      "text": "잠깐, 사 놓고 벌금?"
    },
    "4hnr": {
      "source_hash": "44ffded2085b",
      "text": "네, 구매자이자 개선을 요구하는 쪽이죠."
    },
    "bkhe": {
      "source_hash": "b993dc3368b4",
      "text": "계약 세부는 보도자료에 없어요."
    },
    "k4s2": {
      "source_hash": "c34598a89b4d",
      "text": "TWCA는 민간 사이트에도 팔아요."
    },
    "urli": {
      "source_hash": "df4c793ca927",
      "text": "민간도 같은 문제?"
    },
    "ds3a": {
      "source_hash": "c2de1f2dc0a6",
      "text": "디지털부는 다른 TWCA 사용자에게도 기한 내 갱신을 요청해요."
    },
    "mip7": {
      "source_hash": "345e7fe1f22d",
      "text": "민간 사이트는요?"
    },
    "lvsq": {
      "source_hash": "84135ab2bf8b",
      "text": "집계는 정부 쪽뿐, 민간 수치는 미공개."
    },
    "q27j": {
      "source_hash": "91145d3dff65",
      "text": "오늘 주제는 대만 직결."
    },
    "391w": {
      "source_hash": "f4d73564d0f6",
      "text": "이 기관도 인증서도 모두 대만에 있어요."
    },
    "zt0i": {
      "source_hash": "a08509de33c8",
      "text": "어느 기관들이에요?"
    },
    "ebou": {
      "source_hash": "7c45ee2376b0",
      "text": "보도자료엔 총수뿐, 기관명은 없어요."
    },
    "7onc": {
      "source_hash": "19d0efbd74e6",
      "text": "디지털부는 서두르는 이유가 정상 접속 유지래요."
    },
    "m5le": {
      "source_hash": "7a53177329b4",
      "text": "열자마자 경고에 놀라지 않게요."
    },
    "j00d": {
      "source_hash": "27144cf44736",
      "text": "내 정보, 다 보였어요?"
    },
    "nwek": {
      "source_hash": "e146609dced2",
      "text": "디지털부는 기한 내 미교체 사이트에서 보안 경고가 뜰 수 있대요."
    },
    "d76o": {
      "source_hash": "8636d3cf2269",
      "text": "다만 지금까지 구체적 보안 피해는 없다고 해요."
    },
    "0i6m": {
      "source_hash": "34240bd2460b",
      "text": "금요일 지나면 꼭 경고 떠요?"
    },
    "jkvv": {
      "source_hash": "d4f25c91e0d1",
      "text": "아뇨. 디지털부 말은 뜰 수 있다예요."
    },
    "wn21": {
      "source_hash": "08ef7939c3ac",
      "text": "다른 아시아 지역도요?"
    },
    "nf95": {
      "source_hash": "99e827aa16d1",
      "text": "대만 자료뿐, 추측은 생략."
    },
    "iq7a": {
      "source_hash": "6b27407096fb",
      "text": "할 일이 달라요. 기관은 말했고, 우리는?"
    },
    "w72t": {
      "source_hash": "7f8824b30d08",
      "text": "일반인은?"
    },
    "1mxe": {
      "source_hash": "1c9f66bb19d2",
      "text": "설치할 건 없어요. 다음 코너대로 하면 돼요."
    },
    "pd36": {
      "source_hash": "29e744072d82",
      "text": "볼 건 세 가지."
    },
    "x0sf": {
      "source_hash": "f561bdfae825",
      "text": "첫째, 다 교체될지."
    },
    "2drw": {
      "source_hash": "50a2fd59de3a",
      "text": "둘째, 제3자 검사가 TWCA 발급·관리를 어떻게 볼지."
    },
    "4kwt": {
      "source_hash": "a33f0ef95c7c",
      "text": "결과로 TWCA 개선점이 정해져요."
    },
    "t2k4": {
      "source_hash": "52ae846d2dce",
      "text": "셋째, 위약 조사 후 벌금·배상액."
    },
    "mkuf": {
      "source_hash": "baacf9c48542",
      "text": "벌금은요?"
    },
    "i4rz": {
      "source_hash": "69488f8a3d01",
      "text": "아직 몰라요, 계약대로라고만."
    },
    "x127": {
      "source_hash": "a5e3fbe0e25e",
      "text": "또 기한 후 최종 교체 수를 공개할지도 봐야죠."
    },
    "wfv6": {
      "source_hash": "016b52bd7a04",
      "text": "계속 추적?"
    },
    "dnyh": {
      "source_hash": "3c62cde200af",
      "text": "네, 디지털부는 모든 기관이 빨리 바꾸도록 계속 추적한대요."
    },
    "wf3r": {
      "source_hash": "236f916e4177",
      "text": "일련번호에 빠진 난수를 1주일 안에 채워야 해요."
    },
    "byh4": {
      "source_hash": "26405ca09671",
      "text": "다 바꾸면 명단에서 빠져요."
    },
    "ewcf": {
      "source_hash": "40496ed7d8da",
      "text": "자, 실전. 금요일 후 정부 사이트에 경고 뜨면요?"
    },
    "ovsd": {
      "source_hash": "296e5049baf1",
      "text": "공식 지시 아닌 제 제안이에요."
    },
    "k6k9": {
      "source_hash": "de8cc0f2fa4a",
      "text": "첫째, 멈춰 확인, '계속'을 급히 누르지 마요."
    },
    "bdwl": {
      "source_hash": "e7c35dc22a5a",
      "text": "둘째, 경고 무시 말고 비밀번호·신분증 번호 입력 금지."
    },
    "x3pb": {
      "source_hash": "cca6d9eb6037",
      "text": "정부 사이트 같아도요?"
    },
    "z0vl": {
      "source_hash": "3e945eb933b7",
      "text": "네. 셋째, 주소가 그 기관인지 확인."
    },
    "8ed8": {
      "source_hash": "e69f37fa1770",
      "text": "넷째, 나중에 재시도, 급하면 기관 공식 번호로."
    },
    "ss4z": {
      "source_hash": "5e43c0eb0c51",
      "text": "회사 사이트 인증서도 TWCA 거면요?"
    },
    "wynu": {
      "source_hash": "8cab3310ef3f",
      "text": "주소창 아이콘으로 발급처 확인."
    },
    "pn0t": {
      "source_hash": "6d7d0a5b580a",
      "text": "TWCA면 이번 주 교체 목록에."
    },
    "0ye4": {
      "source_hash": "ffad6be1b157",
      "text": "정부 말고 회사도 점검이네요."
    },
    "nd6o": {
      "source_hash": "2b86f320d384",
      "text": "네, 관리자에게 교체 여부 확인."
    },
    "21da": {
      "source_hash": "f19131259def",
      "text": "인증서 문제면 경고 정도, 거래소 문제면 돈을 못 빼요."
    },
    "j8my": {
      "source_hash": "d200ab1790e7",
      "text": "브라질 최대 코인 거래소 Mercado Bitcoin, 11월 2일 새벽 보안 사고."
    },
    "akcz": {
      "source_hash": "868cba78fb52",
      "text": "거래소는 예방 차원에서 입출금을 일시 중단했대요."
    },
    "3kdf": {
      "source_hash": "82c2c7caf6dc",
      "text": "그럼 맡긴 돈을 못 빼요?"
    },
    "dgf6": {
      "source_hash": "8b9bd8ce1b03",
      "text": "네, 재개 날짜도 아직."
    },
    "asze": {
      "source_hash": "d7cacf271da6",
      "text": "피해액은 주장이 엇갈려요."
    },
    "m2kz": {
      "source_hash": "615bd7850d34",
      "text": "거래소는 고객 손실도 유출도 없대요."
    },
    "jxuj": {
      "source_hash": "0a6def7e81f5",
      "text": "다른 쪽은요?"
    },
    "bn9b": {
      "source_hash": "a00a8a78d91d",
      "text": "분석사 Chainalysis: 약 4,900만 달러 도난."
    },
    "ntpo": {
      "source_hash": "6bf6a02315f9",
      "text": "돈은 되찾나요?"
    },
    "jc2x": {
      "source_hash": "b5c3bb30c73f",
      "text": "Chainalysis는 1천만 달러 동결 도왔대요."
    },
    "zkf5": {
      "source_hash": "4da3c047e0e4",
      "text": "대부분은 Tether가 동결한 USDT래요."
    },
    "acj7": {
      "source_hash": "6abab2e0b17f",
      "text": "스테이블코인은 발행사가 도난분 동결 가능."
    },
    "hior": {
      "source_hash": "e10748315002",
      "text": "동결이면 돌려받나요?"
    },
    "xv6u": {
      "source_hash": "72b54233a024",
      "text": "아뇨. 못 움직일 뿐, 원래 주인에게 자동 반환은 안 돼요."
    },
    "7rdp": {
      "source_hash": "a6578ffc3d01",
      "text": "기억할 건, 거래소 자산은 하룻밤 새 못 뺄 수 있다는 것."
    },
    "173g": {
      "source_hash": "3bd5956ea866",
      "text": "재개 시점도 내가 못 정하죠."
    },
    "co9z": {
      "source_hash": "c5bed798e8ec",
      "text": "다음 돈 얘기는 일자리."
    },
    "rdwc": {
      "source_hash": "d7bb2f4e353e",
      "text": "웹사이트 빌더 Squarespace, 직원 약 19%·약 300명 감원 확인."
    },
    "8u6s": {
      "source_hash": "89b9890dd402",
      "text": "The Verge: 해고자에 기본급 16주분."
    },
    "4wc0": {
      "source_hash": "e0d38c57fd88",
      "text": "의료 혜택은 2027년 5월까지."
    },
    "fyza": {
      "source_hash": "f5bb5cb56792",
      "text": "AI 때문이에요?"
    },
    "n3sb": {
      "source_hash": "bffdfaabae5a",
      "text": "회사는 운영 간소화와 우선순위 집중이라 해요."
    },
    "am2z": {
      "source_hash": "d3a9922cc595",
      "text": "TechCrunch는 한 문장으로 사이트 만드는 AI가 업계를 크게 바꾼다고."
    },
    "nbtr": {
      "source_hash": "6424391324d4",
      "text": "다만 AI가 직접 원인이란 증명은 없어요."
    },
    "gker": {
      "source_hash": "c660b09cd0c5",
      "text": "동시에 일어나도 인과는 아니죠."
    },
    "jqh2": {
      "source_hash": "fa7c68b7fde4",
      "text": "Squarespace 쓰면 걱정?"
    },
    "iu33": {
      "source_hash": "928dd8c6477d",
      "text": "기존 고객 영향은 보도에 없으니 공식 공지만 지켜봐요."
    },
    "cacu": {
      "source_hash": "0add18855570",
      "text": "끝으로, 돈이 들어온 쪽."
    },
    "6m6k": {
      "source_hash": "af83b636a2bf",
      "text": "TechCrunch: Trajectory 4,500만 달러, 세쿼이아·엔비디아 투자."
    },
    "04e4": {
      "source_hash": "44d88477557a",
      "text": "뭐 하는 곳?"
    },
    "9tno": {
      "source_hash": "d4ed26f2115f",
      "text": "오픈소스 모델에서 출발해 사용 피드백으로 계속 재학습."
    },
    "v5cm": {
      "source_hash": "4754867c0cf9",
      "text": "회사는 변호사·의사도 거의 혼자 조정한대요."
    },
    "cvl4": {
      "source_hash": "9e7bbdce407c",
      "text": "한쪽은 해고, 한쪽은 AI에 전문성 가르치는 투자, 묘하네요."
    },
    "h79x": {
      "source_hash": "1be74f86c0d7",
      "text": "다만 더 빠르고 싼지는, 보도에 회사 주장뿐, 제3자 평가는 없어요."
    },
    "7jdw": {
      "source_hash": "6e42c457e451",
      "text": "기업용 도구라 대만 일반인은 당장 쓸 일 없어요."
    },
    "14f4": {
      "source_hash": "de9731512f97",
      "text": "사무소나 병원 다니면 업무로 만날지도."
    },
    "hlkn": {
      "source_hash": "1832be94cac2",
      "text": "거래소는 보안 사고, 오늘 잡음은 딱 반대."
    },
    "tewn": {
      "source_hash": "c976e334ef8e",
      "text": "개인정보 중시 Proton, CEO 말에 역풍."
    },
    "4vux": {
      "source_hash": "432ff87c2755",
      "text": "Decrypt가 전한 보도: 8월, 직원이 며칠 더 침투 테스트 요청."
    },
    "mhti": {
      "source_hash": "a8aadc92cde2",
      "text": "CEO 답은 패배자 사고, 빠르고 안전 다 된다."
    },
    "e9h1": {
      "source_hash": "fb155e94f1e7",
      "text": "프라이버시를 파는 회사가 보안 테스트를 패배자 사고라고요?"
    },
    "tidx": {
      "source_hash": "9fa4003f4d8e",
      "text": "사용자들은 해지 선언, 포럼의 퇴진 제안엔 2,020표."
    },
    "lac2": {
      "source_hash": "2f688c775be8",
      "text": "Decrypt: 이건 분노지 확인된 해지 수가 아니다."
    },
    "mx20": {
      "source_hash": "5bb3626fd800",
      "text": "물러섰어요?"
    },
    "rpad": {
      "source_hash": "9be546b20f80",
      "text": "조금요. 지난 금요일 직원 AI 재면담을 취소했어요."
    },
    "yi3b": {
      "source_hash": "b721e5266d62",
      "text": "노선은요?"
    },
    "vj4e": {
      "source_hash": "1dd9e9698e15",
      "text": "그대로. CTO 선언문: 여러분 일은 대형 언어 모델이 더 좋은 코드를 더 빨리 쓰게 돕기."
    },
    "amx5": {
      "source_hash": "2b5927956b33",
      "text": "Proton 쓴다면: 사내 개발 방식 논란, 유출 보도는 없어요."
    },
    "6b7x": {
      "source_hash": "e8138cf1822f",
      "text": "자, 이 잡음은 흘려들어요."
    },
    "bmdl": {
      "source_hash": "3384990360fd",
      "text": "제 생각에 오늘 뉴스는 다 물어요. 믿는 걸 누가 정말 검증했나."
    },
    "g0su": {
      "source_hash": "12fd9dc3c16d",
      "text": "인증서 난수, Brave 콘텐츠, 거래소 돈, Proton 테스트."
    },
    "fsiy": {
      "source_hash": "004b504049ce",
      "text": "가장 중요한 건 TWCA 인증서."
    },
    "b8py": {
      "source_hash": "de710eac609a",
      "text": "날짜가 있고 대만 일이라, 이번 금요일 겪을 수도 있어요."
    },
    "tyq4": {
      "source_hash": "e01f0913feb0",
      "text": "제때 될까요?"
    },
    "d3a6": {
      "source_hash": "fa35cb067723",
      "text": "솔직히 모르겠어요. 11월 2일 밤, 교체는 10%도 안 됐어요."
    },
    "3u58": {
      "source_hash": "91877580f70e",
      "text": "자세한 건 Mokaair 기사에, 링크는 설명란."
    },
    "ep6d": {
      "source_hash": "2a7cced1bba2",
      "text": "주제로 돌아가면, 금요일 후 미교체 사이트엔 경고가 뜰 수도."
    },
    "fep5": {
      "source_hash": "f29d846531f9",
      "text": "갈 정부 사이트는? 댓글로"
    },
    "obsw": {
      "source_hash": "503230268ccf",
      "text": "매일 핵심은 Tech Signal 구독으로. 신호 수신."
    }
  }
}
