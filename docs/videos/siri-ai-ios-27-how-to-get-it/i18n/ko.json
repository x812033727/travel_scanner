    "tags": "0daaac42014d"
  },
  "lines": {
    "w2hp": {
      "source_hash": "0ce5c424d78f",
      "text": "ChatGPT, Gemini에 왜 새 Siri일까요?"
    },
    "45ma": {
      "source_hash": "f6924cdc26bd",
      "text": "대화하는 비서가 하나 늘었을 뿐이라고요?"
    },
    "ne2s": {
      "source_hash": "9df33cfe6b72",
      "text": "데이터 차이. Apple은 개인 맥락을 이해한다고 합니다."
    },
    "qher": {
      "source_hash": "2d3f2bc3a3ce",
      "text": "Apple 지원 페이지엔 출처가 최소 5개."
    },
    "k8jp": {
      "source_hash": "a47c1f61b78e",
      "text": "메시지와 메일입니다."
    },
    "wv9b": {
      "source_hash": "a8fdc3a93cb0",
      "text": "캘린더."
    },
    "mvkv": {
      "source_hash": "921c620a24dc",
      "text": "메모와 미리 알림."
    },
    "6gqm": {
      "source_hash": "770d17e0120d",
      "text": "세 비서를 놓고 비교하면 무엇이 다를까요?"
    },
    "4edf": {
      "source_hash": "6d65474a616d",
      "text": "표 하나로 세 비서의 데이터 방식을 봅니다."
    },
    "dtqw": {
      "source_hash": "603b43e0f3ec",
      "text": "Siri AI는 시스템에서 메시지·메일을 직접 이해한답니다."
    },
    "fg87": {
      "source_hash": "0c9597e993fc",
      "text": "ChatGPT는 내가 설정에서 읽을 서비스를 연결합니다."
    },
    "swab": {
      "source_hash": "1b5ec22dcdef",
      "text": "Gemini도 사용자가 서비스를 고릅니다."
    },
    "6trj": {
      "source_hash": "f54456848b2a",
      "text": "연결 후엔 모두 대신 일을 처리하지만, 쓸 수 있는 범위는 요금제와 지역, 기기에 따라 다릅니다."
    },
    "w9na": {
      "source_hash": "36150be71b62",
      "text": "마지막 열: Siri AI는 영어뿐, 나머지는 중국어도 됩니다."
    },
    "zpue": {
      "source_hash": "3d840f29c531",
      "text": "기능은 각 회사의 설명이며, 저는 Siri AI를 써 보지 않았습니다."
    },
    "32wr": {
      "source_hash": "e861179645f3",
      "text": "제 생각엔 똑똑함보다 데이터를 얼마나 읽고 내가 정할 수 있는지가 중요합니다."
    },
    "whws": {
      "source_hash": "461b6543f9b0",
      "text": "그럼 Siri AI는 구체적으로 무엇을 할 수 있을까요?"
    },
    "2pmv": {
      "source_hash": "debe7543270d",
      "text": "Apple은 능력을 네 가지로 나눕니다."
    },
    "9s7f": {
      "source_hash": "ee5790547ce0",
      "text": "첫째, 개인 맥락입니다. 메시지·메일·캘린더에서 찾습니다."
    },
    "zu7v": {
      "source_hash": "4637530c40ff",
      "text": "둘째, 세계 지식입니다. 최신 정보는 웹에서 찾습니다."
    },
    "hs8t": {
      "source_hash": "3ea75c63e6ca",
      "text": "셋째, 화면 인식입니다. 화면 내용에 답하거나 동작합니다."
    },
    "ni9m": {
      "source_hash": "128171ed5e23",
      "text": "넷째, 앱 동작입니다. 메시지 전송, 일정 생성 등."
    },
    "rzsw": {
      "source_hash": "b4ef1f97d544",
      "text": "검색하고, 화면을 보고, 직접 움직이는 Siri입니다."
    },
    "xpfc": {
      "source_hash": "edbb4f3e6e44",
      "text": "실측 아닌 Apple 예시입니다."
    },
    "vtb4": {
      "source_hash": "d44e1dd29291",
      "text": "가족이 오면 뭘 하기로 했는지 묻습니다."
    },
    "ytij": {
      "source_hash": "f4cbfc3ff0e1",
      "text": "메시지에서 가족 레시피 굽기란 답을 찾습니다."
    },
    "e5m8": {
      "source_hash": "d9247e93f061",
      "text": "메일에서 레시피를 꺼내 재료를 미리 알림 목록에 넣습니다."
    },
    "cxd3": {
      "source_hash": "b1d8f7baff6f",
      "text": "화면 인식 예시."
    },
    "kb2a": {
      "source_hash": "aad3853a4ad7",
      "text": "팀 웹페이지를 보며 홈경기를 캘린더에 넣어 달라고 합니다."
    },
    "ej7r": {
      "source_hash": "fcdd286d6a6e",
      "text": "화면의 일정을 읽고 그 경기들을 바로 넣습니다."
    },
    "nfk4": {
      "source_hash": "b8590ad0d59b",
      "text": "독립된 Siri 앱도 새로 생겼습니다."
    },
    "upkw": {
      "source_hash": "8d16ca165275",
      "text": "iCloud로 대화를 동기화해 채팅처럼 씁니다."
    },
    "kk46": {
      "source_hash": "19f2fdd97d9a",
      "text": "폰에서 연 대화를 다른 기기에서 잇습니다."
    },
    "cmby": {
      "source_hash": "ef343d921e35",
      "text": "호출법은 세 가지입니다."
    },
    "emx3": {
      "source_hash": "495533f4fb81",
      "text": "Hey Siri·측면 버튼 길게 누름."
    },
    "5ctn": {
      "source_hash": "daf7ac0300d6",
      "text": "또 Dynamic Island 아래로 쓸기."
    },
    "2h9b": {
      "source_hash": "a8c87ef4d8de",
      "text": "세 방법 모두 같은 새 Siri로 갑니다."
    },
    "b8bk": {
      "source_hash": "f842e5fbccce",
      "text": "같은 질문도 다른 비서에게 하면 달라집니다."
    },
    "vypt": {
      "source_hash": "abd2f2c588c4",
      "text": "Siri AI는 시스템 입구, Apple은 개인 맥락을 이해한다고 합니다."
    },
    "jep2": {
      "source_hash": "022f54aa679d",
      "text": "ChatGPT, Gemini는 앱이라 연결한 서비스에서 찾습니다."
    },
    "5ac9": {
      "source_hash": "c4988bd92c4d",
      "text": "하나는 시스템, 둘은 앱 안에 있어 위치가 다릅니다."
    },
    "f9ga": {
      "source_hash": "046fb4ce19d6",
      "text": "그럼 내 폰에서 쓸 수 있을까요?"
    },
    "w293": {
      "source_hash": "dd3da0f3c7ea",
      "text": "먼저 기기입니다. Apple 목록이 있습니다."
    },
    "zvte": {
      "source_hash": "a1e84462e759",
      "text": "iPhone 15 Pro·16 이후·iPhone Air."
    },
    "rq8n": {
      "source_hash": "148a2c72220f",
      "text": "iPad와 Mac도 기준이 있고 대개 Apple 칩 신형입니다."
    },
    "mer4": {
      "source_hash": "67d1e832efdf",
      "text": "Watch는 신형."
    },
    "fedb": {
      "source_hash": "218d7afa64c5",
      "text": "Siri AI 켠 iPhone과 페어링."
    },
    "rt3s": {
      "source_hash": "7f02b890a6d4",
      "text": "Vision Pro 전부"
    },
    "n4yd": {
      "source_hash": "f0b360101be7",
      "text": "목록 밖 구형은 이번에 Siri AI가 없습니다."
    },
    "b74t": {
      "source_hash": "0a4a6efa3cad",
      "text": "이 기기 목록이 첫 번째 관문입니다."
    },
    "jedh": {
      "source_hash": "93f75b38ebfe",
      "text": "언어는 대만 사용자에게 가장 큰 고민이라고 봅니다."
    },
    "wn7k": {
      "source_hash": "183d26f6f860",
      "text": "지금은 영어뿐입니다."
    },
    "af4g": {
      "source_hash": "2e32940f4869",
      "text": "프랑스어, 일본어, 한국어, 포르투갈어, 스페인어는 10월 추가, 9월 14일 발표."
    },
    "6jei": {
      "source_hash": "83a07c0f55cf",
      "text": "13세 미만은 제외라고 Apple이 밝혔습니다."
    },
    "m823": {
      "source_hash": "f497dd4fbbe6",
      "text": "ChatGPT와 Gemini는 지금 중국어가 되어 다릅니다."
    },
    "h52v": {
      "source_hash": "bbc1a831fb28",
      "text": "지역 예외가 둘 있습니다."
    },
    "4xkv": {
      "source_hash": "9a41f1a99ba7",
      "text": "EU의 iPhone·iPad·시계는 제공 안 합니다."
    },
    "uicr": {
      "source_hash": "d93ad550a73b",
      "text": "Mac·Vision Pro 영어로"
    },
    "3ssf": {
      "source_hash": "03864ea9387b",
      "text": "Apple 계정이 중국 본토면 지금은 안 됩니다."
    },
    "gihf": {
      "source_hash": "030115bde5c1",
      "text": "Apple은 언어 외에 자격 있는 지역 계정도 요구합니다."
    },
    "rske": {
      "source_hash": "349fee3db45a",
      "text": "하지만 지원 문서에는 목록이 없고 대만이 포함되는지도 나오지 않습니다."
    },
    "38x4": {
      "source_hash": "38538dfc0020",
      "text": "대만은 Apple 사이트 기준, 추측 안 합니다."
    },
    "yn3w": {
      "source_hash": "fbb0ef8c4a9d",
      "text": "기기와 Siri 언어가 같아야 해서입니다."
    },
    "f32x": {
      "source_hash": "ba4b7b511fe1",
      "text": "지금 iPhone 전체를 영어로 바꿔야 합니다."
    },
    "a8gr": {
      "source_hash": "676e8addde21",
      "text": "영어로 바꾼 뒤 중국어 메시지 처리는 Apple이 안 밝혔습니다."
    },
    "f9ab": {
      "source_hash": "c9dfb9d4efc3",
      "text": "번체 중국어 시기도 미공개, 공식 사이트 기준입니다."
    },
    "td52": {
      "source_hash": "aaa606d91991",
      "text": "그럼 써 보려면 어떻게 신청할까요?"
    },
    "mzk3": {
      "source_hash": "6982133badfe",
      "text": "iPhone을 들고 저와 한 단계씩 켭니다."
    },
    "cv6w": {
      "source_hash": "ce7039deae7f",
      "text": "1단계, 시스템을 iOS 27로 업데이트합니다."
    },
    "r7ce": {
      "source_hash": "dbb39d98a867",
      "text": "2단계, 설정에서 Siri를 누르고 꺼져 있으면 먼저 켭니다."
    },
    "k94g": {
      "source_hash": "224771a02eed",
      "text": "3단계, Try Siri AI beta 탭."
    },
    "f2y4": {
      "source_hash": "bd066475f556",
      "text": "4단계, 음성 골라 설정을 마칩니다."
    },
    "yafh": {
      "source_hash": "82faa11e35ae",
      "text": "5단계, 개인정보 설정 검토는 다음 장에서."
    },
    "wam6": {
      "source_hash": "16dbb331ff22",
      "text": "이 5단계로 신청이 끝나고, 어려운 건 이후의 대기입니다."
    },
    "kj9e": {
      "source_hash": "e8f5d8c2bdf6",
      "text": "흔한 오해: 누른다고 바로 쓰는 건 아닙니다."
    },
    "cz4u": {
      "source_hash": "8a82fa667c87",
      "text": "대기자 명단에 오르며 대기 시간은 다릅니다."
    },
    "89ef": {
      "source_hash": "c4371e9a44e2",
      "text": "차례가 오면 자동 다운로드됩니다."
    },
    "48zx": {
      "source_hash": "13f62cdb145e",
      "text": "남이 쓴다고 내 폰에 바로 있진 않습니다."
    },
    "nhbr": {
      "source_hash": "d2f814e609f0",
      "text": "그럼 개통 전에 개인정보 설정에서 무엇을 봐야 할까요?"
    },
    "qxih": {
      "source_hash": "b69e4b82f53b",
      "text": "편리함은 데이터에서 오니, 무엇을 읽는지 봅니다."
    },
    "ar63": {
      "source_hash": "42c3aa8f9636",
      "text": "메시지, 메일, 캘린더, 메모, 미리 알림이 들어 있습니다."
    },
    "riw5": {
      "source_hash": "345be7a0274d",
      "text": "지금 화면 내용도 볼 수 있습니다."
    },
    "jamr": {
      "source_hash": "ddb99aa51f39",
      "text": "많이 읽을수록 편하니, 읽는 범위를 알아야 합니다."
    },
    "4azm": {
      "source_hash": "56112a7aadbd",
      "text": "처리는? Apple은 기기와 비공개 클라우드 컴퓨팅이랍니다."
    },
    "hu63": {
      "source_hash": "8336edea5ad5",
      "text": "처리 중 데이터는 저장 안 되고 Apple도 못 본답니다."
    },
    "paui": {
      "source_hash": "5f32632c2775",
      "text": "외부 전문가가 언제든 검증할 수 있다고 합니다."
    },
    "h83z": {
      "source_hash": "e5f61a499074",
      "text": "새 모델은 Google 및 Gemini와 함께 만들었습니다."
    },
    "4pyb": {
      "source_hash": "da5418da0a52",
      "text": "모두 Apple의 설명이며 우리가 독자적으로 검증할 수 없습니다."
    },
    "3dey": {
      "source_hash": "b130ae9378c9",
      "text": "정할 수 있는 곳은 어디일까요?"
    },
    "vh8m": {
      "source_hash": "021ee785d331",
      "text": "Siri AI 개통 때 개인정보 설정을 검토합니다."
    },
    "u8jx": {
      "source_hash": "db5f14a0c9d3",
      "text": "ChatGPT·Gemini는 연결할 계정을 고르고 언제든 끊습니다."
    },
    "d2h9": {
      "source_hash": "2ea1bad8f0de",
      "text": "제 생각에는 적게, 분명히 연결할수록 안심하고 쓸 수 있습니다."
    },
    "wyze": {
      "source_hash": "ec790afc7d78",
      "text": "두 가지 더."
    },
    "4bj2": {
      "source_hash": "b99166e51d3a",
      "text": "Apple은 서버 의존 기능에 일일 한도가 있고 Siri AI도 포함이라고 합니다."
    },
    "fa3w": {
      "source_hash": "89cef96d2119",
      "text": "나중에 유료로 사용량을 더 제공합니다."
    },
    "9gfn": {
      "source_hash": "5955248a4256",
      "text": "beta라 오류와 규칙 변경이 가능합니다."
    },
    "7i8m": {
      "source_hash": "aca045c2f0b1",
      "text": "테스트 중 기능으로 보면 기대가 맞습니다."
    },
    "9z2v": {
      "source_hash": "7211680cda73",
      "text": "그러니 개통할 때 개인정보 설정을 읽고, 다음만 누르지 마세요."
    },
    "96fq": {
      "source_hash": "ea913523103c",
      "text": "설명란 첫 줄 글에 있습니다."
    },
    "c2t9": {
      "source_hash": "ced3efb89d25",
      "text": "이걸 보고, 영어로 바꿀 만한 가치가 있을까요?"
    },
    "unw2": {
      "source_hash": "d06d22667d44",
      "text": "ChatGPT·Gemini 있는데 Siri AI도?"
    },
    "a2rk": {
      "source_hash": "df4a27cf1e7c",
      "text": "첫째, 하나는 시스템, 둘은 앱입니다."
    },
    "v485": {
      "source_hash": "27cbb2559d69",
      "text": "둘째, 지금 영어뿐이라 전체를 영어로 바꿔야 합니다."
    },
    "rape": {
      "source_hash": "52cbdb56fccc",
      "text": "셋째, 신청한 뒤 대기하다가 차례가 오면 다운로드합니다."
    },
    "7qte": {
      "source_hash": "cbcce1387665",
      "text": "제 답은, 똑똑해서가 아니라 시스템 안에 있어서입니다."
    },
    "egzt": {
      "source_hash": "f8b41f4dee82",
      "text": "중국어를 주로 쓴다면 나머지 두 비서를 지금 중국어로 쓸 수 있습니다."
    },
    "jvk4": {
      "source_hash": "707d83d26777",
      "text": "Siri AI 번체 중국어 시기는 밝힌 바 없어 공식 사이트 기준입니다."
    },
    "2zay": {
      "source_hash": "bc4bedc4a226",
      "text": "매일 쓸 능력부터 보고 지금 써 볼지 정하세요."
    },
    "n5af": {
      "source_hash": "1ec66d2a753d",
      "text": "내 데이터 찾기, 화면 속 질문, 앱 사이 동작 중 무엇인가요?"
    },
    "w3v9": {
      "source_hash": "89c5cb73af6c",
      "text": "세 비서가 평소 어떻게 역할을 나누는지는 사이트의 세 비서 일상 비교 글에서 보세요."
    }
  }
}
