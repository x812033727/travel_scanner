  },
  "lines": {
    "ek001": {
      "source_hash": "bb1ed7fe6557",
      "text": "이 이야기 아시죠. 아르키메데스가 욕조에 앉아, 넘친 물에 난제를 풀었죠."
    },
    "ek002": {
      "source_hash": "aedc8908c82d",
      "text": "기뻐서 알몸으로 거리에 뛰쳐나가 유레카, '찾았다'를 외쳤다고요."
    },
    "ek003": {
      "source_hash": "387bb98c7bc7",
      "text": "어릴 때부터 들은 장면이죠. 그런데 첫 기록은 거의 200년 뒤입니다."
    },
    "ek004": {
      "source_hash": "5bcf0460024a",
      "text": "더 묘한 건, 100여 년 뒤 기록엔 하나가 없다는 점."
    },
    "ek005": {
      "source_hash": "6dff90e7c35e",
      "text": "천여 년 뒤, 20대 초반 청년은 이 방법을 혹평합니다."
    },
    "ek006": {
      "source_hash": "59d4b1fb9c95",
      "text": "아르키메데스는 정말 알몸으로 거리에서 유레카를 외쳤을까?"
    },
    "ek007": {
      "source_hash": "610094c32366",
      "text": "이 목욕을 적은 기록을 연대순으로 펼칩니다. 고서 다섯, 계산 하나."
    },
    "ek008": {
      "source_hash": "605d86d1708e",
      "text": "현존 최초의 기록은 로마 건축가 비트루비우스."
    },
    "ek009": {
      "source_hash": "a1d9bcf79873",
      "text": "아우구스투스의 노포를 맡은 군사 기술자죠."
    },
    "ek010": {
      "source_hash": "450cd05ae865",
      "text": "『건축십서』를 아우구스투스에게 바친 건 기원전 1세기 후반."
    },
    "ek011": {
      "source_hash": "1341be2208e1",
      "text": "아르키메데스 사후 여기까지가 그 200년 가까운 시간."
    },
    "ek012": {
      "source_hash": "94d5523d89bf",
      "text": "그는 어디서 들었을까?"
    },
    "ek013": {
      "source_hash": "719d42b01fff",
      "text": "책엔 한마디도 없죠. 볼 때마다 묻고 싶습니다."
    },
    "ek014": {
      "source_hash": "62e098536a31",
      "text": "무대는 제9서 첫머리. 시라쿠사 히에론 왕은 반세기 넘게 집권."
    },
    "ek015": {
      "source_hash": "eeb104a8d907",
      "text": "즉위한 해, 신전에 황금관을 맹세했죠."
    },
    "ek016": {
      "source_hash": "145f8da6c1b9",
      "text": "금관이라지만 실은 금잎 화관. 보석 박힌 왕관은 잠시 잊으세요."
    },
    "ek017": {
      "source_hash": "d51af6c4be9f",
      "text": "이 화관을 기억하세요. 기록마다 돌아옵니다."
    },
    "ek018": {
      "source_hash": "e0b3e6c12339",
      "text": "왕은 금을 달아 장인에게 주고, 같은 무게로 화관을 맡깁니다."
    },
    "ek019": {
      "source_hash": "d450c52c2bb0",
      "text": "납품 날, 화관을 달아 보니 무게가 딱 맞았습니다."
    },
    "ek020": {
      "source_hash": "2569e57435d3",
      "text": "문제는?"
    },
    "ek021": {
      "source_hash": "6c5533d0ca5e",
      "text": "금을 빼돌리고 같은 무게의 은을 섞었다는 고발."
    },
    "ek022": {
      "source_hash": "b0e56511d4f1",
      "text": "신께 바칠 물건, 녹이지도 긁지도 못하죠."
    },
    "ek023": {
      "source_hash": "2f78b2c3dc25",
      "text": "화난 왕은 방법이 없어 아르키메데스에게 맡깁니다. 결과는?"
    },
    "ek024": {
      "source_hash": "31d8705f463c",
      "text": "이 일을 고민하던 그가 우연히 공중목욕탕에 들어갑니다."
    },
    "ek025": {
      "source_hash": "41a358a9a913",
      "text": "욕조에 앉자, 몸이 잠긴 만큼 물이 넘칩니다."
    },
    "ek026": {
      "source_hash": "75aabef4175c",
      "text": "그때 떠오른 건?"
    },
    "ek027": {
      "source_hash": "2d17584ac267",
      "text": "넘친 물에서 해법을 봅니다."
    },
    "ek028": {
      "source_hash": "69698dafb691",
      "text": "물에 넣으면 밀어낸 물이 곧 부피. 같은 무게의 금과 은은 부피가 다릅니다."
    },
    "ek029": {
      "source_hash": "006f3e927b1a",
      "text": "기뻐서 곧장 욕조를 뛰쳐나와,"
    },
    "ek030": {
      "source_hash": "ac951d3cbc28",
      "text": "알몸으로 집을 향해, 달리며 크게 외칩니다."
    },
    "ek031": {
      "source_hash": "3273d442cf49",
      "text": "유레카, 유레카! '찾았다'."
    },
    "ek032": {
      "source_hash": "f777e437d55b",
      "text": "잠깐. 원문대로면 그는 알몸으로 거리를 달렸을까요?"
    },
    "ek033": {
      "source_hash": "f9c55fb88aa7",
      "text": "원문은 '집을 향해'. 거리는 없고,"
    },
    "ek034": {
      "source_hash": "e69af1522bd4",
      "text": "공중목욕탕에서 집으로, 집 욕조가 아니죠."
    },
    "ek035": {
      "source_hash": "a26afb4d3188",
      "text": "'옷을 잊었다', '거리를 누볐다'는 후대의 덧칠."
    },
    "ek036": {
      "source_hash": "a7c04a10e4ca",
      "text": "어릴 적 그 거리 질주판, 이렇게 생겼죠."
    },
    "ek037": {
      "source_hash": "e71a3eb43224",
      "text": "알몸?"
    },
    "ek038": {
      "source_hash": "355948d3ae12",
      "text": "그 라틴어는 때로 튜닉 차림도 뜻해요"
    },
    "ek039": {
      "source_hash": "2cb08a75a438",
      "text": "하지만 욕조에서 막 나왔으니, 글자 그대로면 알몸이죠."
    },
    "ek040": {
      "source_hash": "72bebcc59b11",
      "text": "감싸진 않죠."
    },
    "ek041": {
      "source_hash": "c3790a57e530",
      "text": "증명은 어떻게?"
    },
    "ek042": {
      "source_hash": "cf5a488b26c9",
      "text": "비트루비우스는 먼저 '전해지길'을 붙입니다."
    },
    "ek043": {
      "source_hash": "a7cc3dcfc5f7",
      "text": "전해지길, 화관과 같은 무게의 금덩이·은덩이를 물 가득한 그릇에 하나씩 넣고,"
    },
    "ek044": {
      "source_hash": "ae2a4a19356a",
      "text": "로마의 계량컵으로 다시 채울 물을 한 잔씩 쟀다고 합니다."
    },
    "ek045": {
      "source_hash": "24ec9e0a4191",
      "text": "화관이 밀어낸 물이 같은 무게 금덩이보다 많아, 은이 들통났죠."
    },
    "ek046": {
      "source_hash": "41ced8d6fc82",
      "text": "그럴듯하죠? 하지만 뒤에 반박이 나옵니다."
    },
    "ek047": {
      "source_hash": "5314d64b398a",
      "text": "장인?"
    },
    "ek048": {
      "source_hash": "60e036090a97",
      "text": "원문엔 없습니다."
    },
    "ek049": {
      "source_hash": "1e16fabe49e3",
      "text": "건축 책에 왜 이 이야기가?"
    },
    "ek050": {
      "source_hash": "1a50bd84a7f3",
      "text": "제9서 첫머리는, 우습게도, 작가를 대변하는 글이거든요."
    },
    "ek051": {
      "source_hash": "455cb7aa091b",
      "text": "운동선수의 영예를 작가도, 아니 더 받아야."
    },
    "ek052": {
      "source_hash": "bbce662718bc",
      "text": "아르키메데스는 그가 든 예 하나, 앞의 예는 피타고라스."
    },
    "ek053": {
      "source_hash": "b1c08c0751f3",
      "text": "그럼 주인공 본인은? 아르키메데스는 화관을 썼을까요?"
    },
    "ek054": {
      "source_hash": "1f228085a1cb",
      "text": "적어도 전하는 그의 저작엔, 왕관도 욕조도 한마디 없습니다."
    },
    "ek055": {
      "source_hash": "1ee60904bbed",
      "text": "1897년 영국의 히스가 영문 전집을 냅니다."
    },
    "ek056": {
      "source_hash": "9a38114ec17c",
      "text": "그의 『부체론』은 라틴어역뿐."
    },
    "ek057": {
      "source_hash": "402a512579f5",
      "text": "처음부터 끝까지 '왕관'은 편자의 서론과 주석에만 나옵니다."
    },
    "ek058": {
      "source_hash": "8829d4f0e1fd",
      "text": "책 일부는 사라지고 일부는 운 좋게 남았죠. 얼마나?"
    },
    "ek059": {
      "source_hash": "73d5a4407aa3",
      "text": "『부체론』 그리스어 원문은 긁고 덧쓴 양피지에서 되찾았습니다."
    },
    "ek060": {
      "source_hash": "fcda4cae90cd",
      "text": "『부체론』의 주제가 바로 물에 잠긴 물체."
    },
    "ek061": {
      "source_hash": "f7deda6d7db1",
      "text": "물보다 무거운 것을 물속에서 달면 가벼워지고,"
    },
    "ek062": {
      "source_hash": "ff55baacf372",
      "text": "줄어든 건 밀어낸 물의 무게입니다."
    },
    "ek063": {
      "source_hash": "6afbed32253b",
      "text": "교과서에서 배운 부력이죠. 그런데 그가 말한 건 물속에서 무게 달기."
    },
    "ek064": {
      "source_hash": "13c67ab62092",
      "text": "처음의 넘친 물은 부피 비교, 이 책 원리가 아니죠."
    },
    "ek065": {
      "source_hash": "ce5cd0c669da",
      "text": "저도 멈칫했죠."
    },
    "ek066": {
      "source_hash": "0fc8d1550484",
      "text": "다른 고대인은 뭐라 썼을까요?"
    },
    "ek067": {
      "source_hash": "a251aa2d7ff5",
      "text": "100여 년 뒤 버전은 그리스 작가 플루타르코스."
    },
    "ek068": {
      "source_hash": "354d8b8854d8",
      "text": "그도 먼저 '전해지길'을 붙입니다. 이미 떠도는 이야기였던 거죠."
    },
    "ek069": {
      "source_hash": "427a3a3269cd",
      "text": "목욕하다 넘친 물로 관 재는 법을 떠올려,"
    },
    "ek070": {
      "source_hash": "59419b8f0dcf",
      "text": "뭔가에 홀린 듯 뛰어나와 '찾았다'를 외치며 걸어갔다고."
    },
    "ek071": {
      "source_hash": "dca6069e2ab2",
      "text": "식도락가를 비꼬려는 대목입니다. 식사 후 '먹었다!'고 외친 미식가는 없다고요."
    },
    "ek072": {
      "source_hash": "6325b0ec3251",
      "text": "맛집 나와서 외쳐 보셨나요?"
    },
    "ek073": {
      "source_hash": "b5132a6916a0",
      "text": "아니겠죠."
    },
    "ek074": {
      "source_hash": "e93f13e0ed08",
      "text": "처음 말한 빠진 하나는? 바로 알몸. 옷 얘기를 플루타르코스는 한마디도 안 했고,"
    },
    "ek075": {
      "source_hash": "5b1294bcdd74",
      "text": "집으로 갔단 말도 없고, '뛰다' 아닌 '걷다'."
    },
    "ek076": {
      "source_hash": "9c27b0bc1554",
      "text": "다른 책엔 소문도. 억지로 끌려가 목욕하고 기름 바르면,"
    },
    "ek077": {
      "source_hash": "2dd57a1bba77",
      "text": "기름 바른 몸에 손으로 도형을."
    },
    "ek078": {
      "source_hash": "3c867dda5909",
      "text": "그래서 잘 붙은 이야기겠죠. 제 추측입니다."
    },
    "ek079": {
      "source_hash": "0ad2df14b6ca",
      "text": "욕조는 있고 알몸은 없다. 욕조도 없는 버전은?"
    },
    "ek080": {
      "source_hash": "b0c0d05755bd",
      "text": "있습니다. 로마 제국 말기 작자 미상의 라틴 시, 같은 이야기입니다."
    },
    "ek081": {
      "source_hash": "f358adec13b7",
      "text": "시칠리아 왕, 신께 바친 금관, 은을 섞은 장인, 다 있는데,"
    },
    "ek082": {
      "source_hash": "13a37a709255",
      "text": "욕조도, '찾았다'는 외침도 없고,"
    },
    "ek083": {
      "source_hash": "5f6daec07aa1",
      "text": "아르키메데스 이름도 없이 '시라쿠사의 대가'뿐."
    },
    "ek084": {
      "source_hash": "46bb9c702965",
      "text": "시에선 저울을 씁니다. 양쪽에 같은 무게 금과 은을 올려 수평을 맞추고,"
    },
    "ek085": {
      "source_hash": "60e3b640a757",
      "text": "함께 물에 넣으면, 금 쪽이 곧장 가라앉습니다."
    },
    "ek086": {
      "source_hash": "548c3820eda3",
      "text": "같은 관을 물로 재느냐, 무게로 다느냐. 통하는 건 어느 쪽?"
    },
    "ek087": {
      "source_hash": "8186ccb0ebd6",
      "text": "물 재기는 1586년에 혹평받았고,"
    },
    "ek088": {
      "source_hash": "e3f1358f0581",
      "text": "혹평한 이는 그 청년, 이탈리아의 갈릴레오."
    },
    "ek089": {
      "source_hash": "07c08507a71f",
      "text": "친구에게만 보인 생전 미출간 짧은 글, 『작은 저울』."
    },
    "ek090": {
      "source_hash": "63c837cba53e",
      "text": "첫머리부터 이럽니다. 일부 글처럼 왕관을 물에 넣고 수위로 금은을 가린다는"
    },
    "ek091": {
      "source_hash": "d7a84dac9d23",
      "text": "솔직히 조잡하고, 정확과는 거리가 멀다."
    },
    "ek092": {
      "source_hash": "8cff46465a67",
      "text": "'일부 글'이라며 누군지는 안 밝히죠. 그럼 물 재기는 어디서 왔을까?"
    },
    "ek093": {
      "source_hash": "1c9fa28091d3",
      "text": "그의 추측: 물로 금 도둑을 밝힌 일이 퍼지고, 그 시대 한 작가가 적으며,"
    },
    "ek094": {
      "source_hash": "ebcd9c906170",
      "text": "들은 소식에 살을 붙이려 물 재기를 직접 더했다."
    },
    "ek095": {
      "source_hash": "10789f85e8a6",
      "text": "이 파일에서 제일 묘한 문장 같습니다. 물 재기 대목은 쓴 사람이 덧붙였다는 의심."
    },
    "ek096": {
      "source_hash": "1396ed3c4d98",
      "text": "다만 추측이지 증거가 아니고, 의심한 건 방법뿐, 목욕은 아닙니다."
    },
    "ek097": {
      "source_hash": "5f9d6123d076",
      "text": "친구 말고 이 의심을 인쇄한 사람은?"
    },
    "ek098": {
      "source_hash": "38107723612f",
      "text": "있습니다. 1589년, 다른 이탈리아인이 인쇄된 책에서 이 방법은 어렵다며,"
    },
    "ek099": {
      "source_hash": "70bfeb18b61b",
      "text": "자기 건 '슈퍼 유레카'."
    },
    "ek100": {
      "source_hash": "44d8fa1aad04",
      "text": "갈릴레오가 본 진짜 방법은 뭘까요?"
    },
    "ek101": {
      "source_hash": "e35897beec28",
      "text": "저울. 그 시처럼 물속에서 다는 거죠."
    },
    "ek102": {
      "source_hash": "9c8ac3d522cc",
      "text": "『부체론』 기억나죠? 갈릴레오는 이게 아르키메데스식이라며,"
    },
    "ek103": {
      "source_hash": "74b22309a9cb",
      "text": "바로 그 책이 증명한 원리니까요."
    },
    "ek104": {
      "source_hash": "0f17c938969b",
      "text": "물 재기가 조잡해도, 얼마나 차이 날까요?"
    },
    "ek105": {
      "source_hash": "7d1da9977a31",
      "text": "수학자 로레스가 계산했습니다. 가정은 화관 무게 1킬로그램."
    },
    "ek106": {
      "source_hash": "5124b0b462dd",
      "text": "출토된 그 시대 최대 금 화관은 700여 그램. 1킬로로 쳐도 무리는 아니죠."
    },
    "ek107": {
      "source_hash": "ada59ea33fb6",
      "text": "금 30%가 은, 입구 지름 20센티."
    },
    "ek108": {
      "source_hash": "2bb471a37187",
      "text": "화관과 같은 무게의 금덩이를 각각 넣으면 수면 차이는?"
    },
    "ek109": {
      "source_hash": "416ea9744c21",
      "text": "겨우 0.41밀리."
    },
    "ek110": {
      "source_hash": "e8ee8d21c616",
      "text": "물 차이는 꽤 커요. 주사위 세 개만큼."
    },
    "ek111": {
      "source_hash": "1280da2196b4",
      "text": "그런데 주사위 셋을 대야에 넣어도 수면은 그대로."
    },
    "ek112": {
      "source_hash": "84c50a865775",
      "text": "저울로 물속에서 달면?"
    },
    "ek113": {
      "source_hash": "5145313d6825",
      "text": "13그램 차이."
    },
    "ek114": {
      "source_hash": "5e264e6892c8",
      "text": "그 시대 저울로도 쉽게 잴 수 있다고 합니다."
    },
    "ek115": {
      "source_hash": "51a8aa414946",
      "text": "2006년 그는 『사이언티픽 아메리칸』에 말했죠. 이론상은 된다."
    },
    "ek116": {
      "source_hash": "83e6d68b1632",
      "text": "하지만 실제론 현실이 막아섭니다. 뭐가요?"
    },
    "ek117": {
      "source_hash": "4ea433894beb",
      "text": "방해꾼 셋을 꼽았죠. 물의 표면장력, 꺼낼 때 묻은 물, 화관 틈새의 기포."
    },
    "ek118": {
      "source_hash": "cc42e654b717",
      "text": "방법은 안 통할 듯. 욕조와 '찾았다'는?"
    },
    "ek119": {
      "source_hash": "5b7466f717e0",
      "text": "로레스는 일부 사실일 수도 있다고. 부피를 잰 건 맞으니까요."
    },
    "ek120": {
      "source_hash": "209fd5bea395",
      "text": "하지만 '찾았다'의 순간은 부력 발견 때문일지도,"
    },
    "ek121": {
      "source_hash": "aa5c6bdce982",
      "text": "욕조에서의 알몸 질주가 아니라."
    },
    "ek122": {
      "source_hash": "1523451d8545",
      "text": "다시 처음 질문. 그는 정말 알몸으로 거리에서 유레카를 외쳤나?"
    },
    "ek123": {
      "source_hash": "8b7d99872b26",
      "text": "되감아 보면, 최초의 기록은 '집을 향해', 거리가 아니었고,"
    },
    "ek124": {
      "source_hash": "d8094deb2355",
      "text": "100여 년 뒤 플루타르코스는 옷 얘기도 없고,"
    },
    "ek125": {
      "source_hash": "8466307e33dc",
      "text": "천여 년 뒤엔 물 재기마저 조잡하단 평. 그 장면, 있었을까요?"
    },
    "ek126": {
      "source_hash": "96399bb0fc6a",
      "text": "알몸으로 집에 간 장면은 그 로마 건축가의 기록뿐."
    },
    "ek127": {
      "source_hash": "b8bf8dcee657",
      "text": "있었는지는 어떤 증거도 답 못 합니다. 이 사건은 미결."
    },
    "ek128": {
      "source_hash": "e8f493634d81",
      "text": "밝힐 수 있는 건 각 기록이 쓴 것과 안 쓴 것. 답 못 하는 건 그날의 진실."
    },
    "ek129": {
      "source_hash": "64ee8f90ef8f",
      "text": "이야기는 전해질 때마다 늘거나 빠질 수 있죠. 원래 모습은?"
    },
    "ek130": {
      "source_hash": "a8a5aad4bc3b",
      "text": "한 장씩 되짚기."
    },
    "ek131": {
      "source_hash": "7472bf6f3c7a",
      "text": "어릴 적 들은 이야기, 그는 옷을 입었나요? 댓글 주세요."
    },
    "ek132": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록만 다루는 채널, 함께 파일을 열려면 구독해 주세요."
    }
  }
}
