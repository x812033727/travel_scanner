{
  "zq26a01": "이겨서 보여 줄래.",
  "zq26a02": "눈이다!",
  "zq26a03": "백설탕 양산, 달성.",
  "zq26a04": "라이싼?",
  "zq26a05": "불 지른 놈?",
  "zq26a06": "첸 가에서 쫓겨나,",
  "zq26a07": "밥 좀 주세요.",
  "zq26a08": "일하면,",
  "zq26a09": "있어도 돼.",
  "zq26a10": "줄이 거리 끝까지야!",
  "zq26a11": "매출전 장부, 쉬기가 위지의 두 배.",
  "zq26a12": "한 명도 없어?",
  "zq26a13": "도련님,",
  "zq26a14": "다 건너편에…",
  "zq26a15": "웃으라 해.",
  "zq26a16": "가서 처리해.",
  "zq26a17": "한 봉지,",
  "zq26a18": "딱 한 봉지만.",
  "zq26a19": "뭐 하는 거야?",
  "zq26a20": "처, 청소 중이야.",
  "zq26a21": "설탕에 독이 있어!",
  "zq26a22": "그럴 리가…"
}
