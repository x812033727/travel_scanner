{
  "zq26a01": "¡A ganarle!",
  "zq26a02": "¡Está nevando!",
  "zq26a03": {
    "text": "Azúcar blanca en masa: lograda.",
    "say": "Azúcar blanca en masa, lograda."
  },
  "zq26a04": "¿Lai San?",
  "zq26a05": "¿El del fuego?",
  "zq26a06": "Los Qian me echaron,",
  "zq26a07": "denme de comer.",
  "zq26a08": "Cumple",
  "zq26a09": "y te quedas.",
  "zq26a10": "¡Hasta la esquina!",
  "zq26a11": {
    "text": "Guerra comercial: Casa Xu dobla a Casa Wei.",
    "say": "Casa Xu, el doble que Casa Wei."
  },
  "zq26a12": "¿Ni uno?",
  "zq26a13": "Señor,",
  "zq26a14": "se fueron enfrente…",
  "zq26a15": "Que ría.",
  "zq26a16": "Háganlo.",
  "zq26a17": "Una bolsa,",
  "zq26a18": "solo una.",
  "zq26a19": "¿Qué haces?",
  "zq26a20": "B-barriendo.",
  "zq26a21": "¡Hay veneno!",
  "zq26a22": "No puede ser…"
}
