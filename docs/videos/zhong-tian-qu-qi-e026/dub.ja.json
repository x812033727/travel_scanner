{
  "zq26a01": "まず勝ってみせる。",
  "zq26a02": "雪が降ってる！",
  "zq26a03": "白糖量産、達成。",
  "zq26a04": "ライ・サン？",
  "zq26a05": "火つけた奴か？",
  "zq26a06": { "text": "チエン家をクビになりまして、", "say": "クビになりまして、", "emotion": "哈腰討好，不笑，語速正常" },
  "zq26a07": "食わせてくだせえ。",
  "zq26a08": { "text": "働くなら、", "say": "働くなら", "emotion": "淡淡地，語速稍快" },
  "zq26a09": "置いてやる。",
  "zq26a10": "通りの端まで！",
  "zq26a11": { "text": "商戦の売上、シュー記がウェイ記の二倍。", "say": "売上、シュー記がウェイ記の二倍。" },
  "zq26a12": "一人もいない？",
  "zq26a13": "若様、",
  "zq26a14": "皆向かいに……",
  "zq26a15": { "text": "笑わせておけ。", "say": "笑わせとけ。", "emotion": "咬著牙，低聲，短促" },
  "zq26a16": "やってこい。",
  "zq26a17": "一包み、",
  "zq26a18": "一包みだけ。",
  "zq26a19": "何してるの？",
  "zq26a20": "そ、掃除だよ。",
  "zq26a21": "砂糖に毒が！",
  "zq26a22": "まさか……"
}
