{
  "zq26a01": "Kita menang dulu.",
  "zq26a02": "Turun salju!",
  "zq26a03": {
    "text": "Gula putih massal: berhasil.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq26a04": {
    "text": "Lai San?",
    "emotion": "瞪大眼，短促"
  },
  "zq26a05": {
    "text": "Si tukang bakar?",
    "emotion": "粗聲，短促"
  },
  "zq26a06": {
    "text": "Keluarga Qian membuangku,",
    "say": "Keluarga Qian membuangku"
  },
  "zq26a07": "beri hamba makan.",
  "zq26a08": {
    "text": "Kerja,",
    "say": "Kerja",
    "emotion": "淡淡地，短促"
  },
  "zq26a09": "boleh tinggal.",
  "zq26a10": {
    "text": "Sampai ujung jalan!",
    "say": "Sampai ujung!",
    "emotion": "眉開眼笑，語速快"
  },
  "zq26a11": {
    "text": "Omzet Toko Xu dua kali lipat Toko Wei.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq26a12": {
    "text": "Satu pun nggak?",
    "emotion": "冷下臉"
  },
  "zq26a13": {
    "text": "Tuan,",
    "emotion": "縮著脖子，短促",
    "say": "Tuan"
  },
  "zq26a14": "semua ke seberang…",
  "zq26a15": "Biarkan.",
  "zq26a16": "Kerjakan.",
  "zq26a17": {
    "text": "Sebungkus,",
    "say": "Sebungkus"
  },
  "zq26a18": "satu aja.",
  "zq26a19": "Lagi ngapain?",
  "zq26a20": "Ny-nyapu kok.",
  "zq26a21": "Gulanya beracun!",
  "zq26a22": "Nggak mungkin…"
}
