{
  "zq26a01": "Thắng cho cha xem đã.",
  "zq26a02": "Tuyết rơi rồi!",
  "zq26a03": {
    "text": "Đường trắng đại trà: đạt.",
    "emotion": "平板電子音，叮一聲，語速偏快"
  },
  "zq26a04": "Lại Tam?",
  "zq26a05": "Kẻ phóng hỏa?",
  "zq26a06": {
    "text": "Tiền phủ đuổi tiểu nhân rồi,",
    "say": "Tiền phủ đuổi tiểu nhân rồi",
    "emotion": "哈腰，討好"
  },
  "zq26a07": "cho xin miếng cơm.",
  "zq26a08": {
    "text": "Chịu làm,",
    "say": "Chịu làm",
    "emotion": "淡淡地，短促"
  },
  "zq26a09": "thì ở lại.",
  "zq26a10": {
    "text": "Xếp tới cuối phố rồi!",
    "emotion": "數著長龍，興奮，語速快"
  },
  "zq26a11": "Sổ đấu thương: Hứa Ký gấp đôi Ngụy Ký.",
  "zq26a12": {
    "text": "Không có một ai?",
    "emotion": "冷下臉"
  },
  "zq26a13": {
    "text": "Công tử,",
    "say": "Công tử",
    "emotion": "縮著脖子，短促"
  },
  "zq26a14": {
    "text": "đều sang bên kia rồi…",
    "say": "đều sang bên kia rồi"
  },
  "zq26a15": "Để hắn cười.",
  "zq26a16": "Đi làm đi.",
  "zq26a17": {
    "text": "Một gói,",
    "say": "Một gói"
  },
  "zq26a18": "chỉ một gói thôi.",
  "zq26a19": "Chú làm gì thế?",
  "zq26a20": {
    "text": "Quét… quét nhà ạ.",
    "emotion": "嚇一跳，結巴"
  },
  "zq26a21": "Đường có độc!",
  "zq26a22": {
    "text": "Không thể nào…",
    "say": "Không thể nào"
  }
}
