{
  "zq15a01": "紙は後！",
  "zq15a02": "あの百枚——",
  "zq15a03": "牛は冬に全滅。",
  "zq15a04": "せーの、引け！",
  "zq15a05": "遅れりゃ",
  "zq15a06": "一年食べられない。",
  "zq15a07": "鋤が重すぎるんだ。",
  "zq15a08": "最後の一枚。",
  "zq15a09": "百枚目！",
  "zq15a10": "百枚、完了。",
  "zq15a11": {
    "text": "報酬：曲轅犂の図面。",
    "say": "報酬、曲がり鋤の図面。"
  },
  "zq15a12": "曲げれば、",
  "zq15a13": "半減。",
  "zq15a14": {
    "text": "まだ夜明け前だ、",
    "say": "未明"
  },
  "zq15a15": "兵の訓練？",
  "zq15a16": "彼らが望んだの。",
  "zq15a17": "この前は腰が抜けた。",
  "zq15a18": "ニウ！",
  "zq15a19": "叔父さん鍛冶屋？",
  "zq15a20": "曲がり？",
  "zq15a21": "こんな鋤、知らん。",
  "zq15a22": "俺が引く！",
  "zq15a23": "いい。",
  "zq15a24": "一人？",
  "zq15a25": "一人で耕すの？",
  "zq15a26": "何よ？",
  "zq15a27": "次の畑。",
  "zq15a28": {
    "text": "曲轅犂、一人で耕作可能。",
    "say": "曲がり鋤、一人で耕せる。"
  },
  "zq15a29": "母。",
  "zq15a30": "名は無い。",
  "zq15a31": "母は",
  "zq15a32": "姓は？",
  "zq15a33": "シュー家は",
  "zq15a34": "一台、一両。",
  "zq15a35": "工房を旦那に売れば、",
  "zq15a36": "五十両で、",
  "zq15a37": "橋は通す。"
}
