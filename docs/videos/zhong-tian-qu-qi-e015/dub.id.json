{
  "zq15a01": "Kertas nanti dulu.",
  "zq15a02": "Terus seratus lembarnya—",
  "zq15a03": {
    "text": "Musim dingin, sapi mati semua.",
    "say": "Sapi mati semua."
  },
  "zq15a04": {
    "text": "Satu, dua—tarik!",
    "say": "Ayo, tarik!"
  },
  "zq15a05": "Telat musim tanam,",
  "zq15a06": "setahun nggak makan.",
  "zq15a07": "Bajaknya yang payah.",
  "zq15a08": "Lembar terakhir.",
  "zq15a09": "Lembar keseratus!",
  "zq15a10": {
    "text": "Seratus lembar, selesai.",
    "say": "Seratus, selesai."
  },
  "zq15a11": {
    "text": "Hadiah: gambar bajak lengkung.",
    "say": "Hadiah: bajak lengkung."
  },
  "zq15a12": "Bengkokkan,",
  "zq15a13": "hemat setengah tenaga.",
  "zq15a14": "Subuh-subuh,",
  "zq15a15": "udah latihan?",
  "zq15a16": "Mereka mau belajar.",
  "zq15a17": "Waktu itu kakiku lemas.",
  "zq15a18": {
    "text": "Erniu,",
    "say": "Erniu!"
  },
  "zq15a19": "pamanmu pandai besi, kan?",
  "zq15a20": "Bengkok?",
  "zq15a21": "Bajak macam apa ini.",
  "zq15a22": "Aku tarik!",
  "zq15a23": "Nggak usah.",
  "zq15a24": "Sendiri?",
  "zq15a25": "Dia bajak sendirian?",
  "zq15a26": "Apa?",
  "zq15a27": "Petak berikutnya.",
  "zq15a28": "Bajak lengkung: cukup satu orang.",
  "zq15a29": "Ibuku.",
  "zq15a30": "Tanpa nama.",
  "zq15a31": "Ibumu…",
  "zq15a32": "marganya apa?",
  "zq15a33": "Barang keluarga Xu,",
  "zq15a34": "satu gerobak, satu tael.",
  "zq15a35": "Jual pabrik kertas ke tuanku,",
  "zq15a36": "lima puluh tael,",
  "zq15a37": {
    "text": "jembatan dibuka.",
    "say": "jembatan buka!"
  }
}
