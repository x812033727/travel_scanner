{
  "zq15a01": "Papel, luego.",
  "zq15a02": "Pero las cien hojas…",
  "zq15a03": "Los bueyes murieron en invierno.",
  "zq15a04": "¡Una, dos… jalen!",
  "zq15a05": "Sin arar,",
  "zq15a06": "un año sin comer.",
  "zq15a07": "El arado es muy torpe.",
  "zq15a08": "Última hoja.",
  "zq15a09": "¡La número cien!",
  "zq15a10": "Cien hojas: listas.",
  "zq15a11": {
    "text": "Recompensa: plano del arado de vara curva.",
    "say": "Recompensa: arado curvo."
  },
  "zq15a12": "Curvo aquí,",
  "zq15a13": "y cuesta la mitad.",
  "zq15a14": "De noche,",
  "zq15a15": "¿entrenas?",
  "zq15a16": "Ellos piden.",
  "zq15a17": {
    "text": "Me temblaban las piernas.",
    "say": "Yo temblaba."
  },
  "zq15a18": {
    "text": "Erniu,",
    "say": "Ey,"
  },
  "zq15a19": "¿tu tío es herrero?",
  "zq15a20": "¿Curvo?",
  "zq15a21": "Nunca vi un arado así.",
  "zq15a22": "¡Yo jalo!",
  "zq15a23": "No hace falta.",
  "zq15a24": "¿Sola?",
  "zq15a25": "¿Ara ella sola?",
  "zq15a26": "¿Qué?",
  "zq15a27": "Otro campo.",
  "zq15a28": {
    "text": "Arado de vara curva: una persona basta para arar.",
    "say": "Arado curvo: ara una sola."
  },
  "zq15a29": "Madre.",
  "zq15a30": "Sin nombre.",
  "zq15a31": {
    "text": "¿Y tu madre…",
    "say": "¿Y ella…"
  },
  "zq15a32": "cómo se apellidaba?",
  "zq15a33": "Carga de Xu:",
  "zq15a34": "un tael por carreta.",
  "zq15a35": {
    "text": "Véndale el taller a mi amo,",
    "say": "El taller, a mi amo,"
  },
  "zq15a36": "por cincuenta taeles,",
  "zq15a37": {
    "text": "y se abre el puente.",
    "say": "y hay puente."
  }
}
