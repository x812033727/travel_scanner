{
  "zq15a01": "Paper later.",
  "zq15a02": "But the hundred sheets—",
  "zq15a03": "The oxen all died this winter.",
  "zq15a04": "One, two—pull!",
  "zq15a05": "Miss planting,",
  "zq15a06": "and we starve all year.",
  "zq15a07": "It's this clumsy plow.",
  "zq15a08": "Last sheet.",
  "zq15a09": "Number one hundred!",
  "zq15a10": "One hundred sheets, complete.",
  "zq15a11": "Reward: curved-beam plow blueprint.",
  "zq15a12": "Bend it here,",
  "zq15a13": "half the effort.",
  "zq15a14": "This early,",
  "zq15a15": "and drilling?",
  "zq15a16": "They asked to learn.",
  "zq15a17": "Last time my legs went to jelly.",
  "zq15a18": "Erniu,",
  "zq15a19": "your uncle's a smith, right?",
  "zq15a20": "Curved?",
  "zq15a21": "Never seen a plow like it.",
  "zq15a22": "I'll pull!",
  "zq15a23": "No need.",
  "zq15a24": "Alone?",
  "zq15a25": "She's plowing alone?",
  "zq15a26": "Staring?",
  "zq15a27": "Next field.",
  "zq15a28": "Curved-beam plow: one person can till.",
  "zq15a29": "Mother.",
  "zq15a30": "No name on it.",
  "zq15a31": "And your mother…",
  "zq15a32": "her family name?",
  "zq15a33": "Xu family goods:",
  "zq15a34": "one tael a cart.",
  "zq15a35": "Sell the paper mill to my master—",
  "zq15a36": "fifty taels,",
  "zq15a37": "the bridge opens."
}
