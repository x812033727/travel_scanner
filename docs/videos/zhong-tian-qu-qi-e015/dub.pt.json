{
  "zq15a01": "Papel depois.",
  "zq15a02": "Mas as cem folhas—",
  "zq15a03": "Os bois morreram no inverno.",
  "zq15a04": {
    "text": "Um, dois— puxa!",
    "say": "Um, dois, vai!"
  },
  "zq15a05": "Sem plantio,",
  "zq15a06": "um ano sem comida.",
  "zq15a07": "A culpa é do arado.",
  "zq15a08": "Última folha.",
  "zq15a09": "A centésima!",
  "zq15a10": "Cem folhas: completo.",
  "zq15a11": {
    "text": "Prêmio: projeto do arado de timão curvo.",
    "say": "Prêmio: arado curvo."
  },
  "zq15a12": "Curva aqui,",
  "zq15a13": "metade do esforço.",
  "zq15a14": "Tão cedo,",
  "zq15a15": "treinando?",
  "zq15a16": "Eles pediram.",
  "zq15a17": {
    "text": "Da outra vez, eu tremi todo.",
    "say": "Eu tremi todo."
  },
  "zq15a18": {
    "text": "Erniu,",
    "say": "Ô,"
  },
  "zq15a19": "seu tio é ferreiro, né?",
  "zq15a20": {
    "text": "Curvo?",
    "say": "Torto?"
  },
  "zq15a21": "Nunca vi arado assim.",
  "zq15a22": "Eu puxo!",
  "zq15a23": "Não precisa.",
  "zq15a24": {
    "text": "Sozinha?",
    "say": "Só?"
  },
  "zq15a25": "Ela vai arar sozinha?",
  "zq15a26": {
    "text": "Que foi?",
    "say": "Quê?"
  },
  "zq15a27": "Próximo campo.",
  "zq15a28": "Arado curvo: basta uma pessoa.",
  "zq15a29": {
    "text": "Minha mãe.",
    "say": "Mãe."
  },
  "zq15a30": "Sem nome.",
  "zq15a31": {
    "text": "E sua mãe…",
    "say": "E ela,"
  },
  "zq15a32": "qual sobrenome?",
  "zq15a33": "Mercadoria dos Xu,",
  "zq15a34": "um tael por carroça.",
  "zq15a35": {
    "text": "Vende a oficina pro meu patrão,",
    "say": "Vende a oficina,"
  },
  "zq15a36": "cinquenta taéis,",
  "zq15a37": "e a ponte abre."
}
