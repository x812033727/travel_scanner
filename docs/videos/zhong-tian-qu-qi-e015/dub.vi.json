{
  "zq15a01": "Giấy để sau.",
  "zq15a02": "Còn một trăm tờ—",
  "zq15a03": "Mùa đông trâu chết hết rồi.",
  "zq15a04": "Một, hai— kéo!",
  "zq15a05": "Lỡ vụ cày xuân,",
  "zq15a06": "cả năm không có ăn.",
  "zq15a07": "Tại cái cày này vụng.",
  "zq15a08": "Tờ cuối cùng.",
  "zq15a09": "Tờ thứ một trăm!",
  "zq15a10": "Trăm tờ: hoàn thành.",
  "zq15a11": "Phần thưởng: bản vẽ cày cong.",
  "zq15a12": "Uốn cong chút,",
  "zq15a13": "đỡ nửa sức.",
  "zq15a14": "Trời chưa sáng,",
  "zq15a15": "luyện binh à?",
  "zq15a16": "Họ tự muốn học.",
  "zq15a17": "Lần trước sợ nhũn cả chân.",
  "zq15a18": {
    "text": "Nhị Ngưu,",
    "say": "Này,"
  },
  "zq15a19": "cậu đệ biết rèn sắt nhỉ?",
  "zq15a20": "Cong à?",
  "zq15a21": "Chưa thấy cày kiểu này.",
  "zq15a22": "Để ta kéo!",
  "zq15a23": "Không cần.",
  "zq15a24": "Một mình?",
  "zq15a25": "Nàng ấy cày một mình?",
  "zq15a26": "Nhìn gì?",
  "zq15a27": "Mẫu tiếp theo.",
  "zq15a28": "Cày cong: một người cày được.",
  "zq15a29": "Mẹ ta.",
  "zq15a30": "Không có tên.",
  "zq15a31": "Mẹ nàng…",
  "zq15a32": "họ gì?",
  "zq15a33": "Hàng họ Hứa,",
  "zq15a34": "mỗi xe một lượng.",
  "zq15a35": "Xưởng giấy bán cho lão gia,",
  "zq15a36": "năm mươi lượng,",
  "zq15a37": "cầu sẽ thông."
}
