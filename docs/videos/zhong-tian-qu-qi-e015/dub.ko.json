{
  "zq15a01": "종이는 나중!",
  "zq15a02": "그럼 백 장은—",
  "zq15a03": "소 다 죽었어.",
  "zq15a04": "하나, 둘— 당겨!",
  "zq15a05": "봄갈이 놓치면,",
  "zq15a06": "일 년 내내 굶어.",
  "zq15a07": "쟁기가 너무 둔해.",
  "zq15a08": "마지막 장.",
  "zq15a09": "백 장째!",
  "zq15a10": "백 장, 완료.",
  "zq15a11": "보상: 곡원 쟁기 도면.",
  "zq15a12": "휘게 하면,",
  "zq15a13": "힘이 반.",
  "zq15a14": "동트기 전에,",
  "zq15a15": "훈련 중?",
  "zq15a16": "쟤들이 배우재.",
  "zq15a17": "지난번엔 다리가 풀렸거든.",
  "zq15a18": "야,",
  "zq15a19": "외삼촌 대장장이지?",
  "zq15a20": "휘었어?",
  "zq15a21": "처음 보는 쟁기.",
  "zq15a22": "내가 끌게!",
  "zq15a23": "됐어.",
  "zq15a24": "혼자?",
  "zq15a25": "혼자 갈아?",
  "zq15a26": "뭘 봐?",
  "zq15a27": "다음 밭.",
  "zq15a28": "곡원 쟁기, 혼자 경작.",
  "zq15a29": "엄마.",
  "zq15a30": "이름도 없어.",
  "zq15a31": "그럼…",
  "zq15a32": "성이 뭐야?",
  "zq15a33": "쉬가 물건은,",
  "zq15a34": "수레당 한 냥.",
  "zq15a35": "공방을 넘기면,",
  "zq15a36": "쉰 냥에,",
  "zq15a37": "다리 열지."
}
