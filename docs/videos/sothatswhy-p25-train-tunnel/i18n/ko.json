    "thumbnail": "8be3bd7bfb31"
  },
  "lines": {
    "p001": {
      "source_hash": "ee3712f22a5d",
      "text": "소장님! 앞코가"
    },
    "p002": {
      "source_hash": "b7ba93b6aa2c",
      "text": "십오 미터나 긴데"
    },
    "p003": {
      "source_hash": "cf049b281c1a",
      "text": "바람 저항 줄이려는 거죠?"
    },
    "p004": {
      "source_hash": "64db113cf41d",
      "text": "바람 때문인 줄 알지만"
    },
    "p005": {
      "source_hash": "8d64aac773ee",
      "text": "진짜 무서운 적은 바로 터널 속에 있어."
    },
    "p006": {
      "source_hash": "dbc05700bdba",
      "text": "터널에 뭐요"
    },
    "p007": {
      "source_hash": "90183e8d7646",
      "text": "대만은 더 빠른데"
    },
    "p008": {
      "source_hash": "647003528dfd",
      "text": "왜 코가 짧죠?"
    },
    "p009": {
      "source_hash": "0ff64bac1f98",
      "text": "대만 열차는 일본 원형보다 빠른데도 짧아."
    },
    "p010": {
      "source_hash": "4150c4a09721",
      "text": "터널로 가서 답을 찾아보자"
    },
    "p011": {
      "source_hash": "f9f8f814f46d",
      "text": "시속 삼백 킬로면,"
    },
    "p012": {
      "source_hash": "d83567827741",
      "text": "맞바람이 엄청난데"
    },
    "p013": {
      "source_hash": "90f0f7fee8f0",
      "text": "다 앞쪽이죠?"
    },
    "p014": {
      "source_hash": "8aefcc347036",
      "text": "유선형 코도 저항을 줄여."
    },
    "p015": {
      "source_hash": "ae259f74b36c",
      "text": "일본 철도연구소가 계산해 보니 열차는 열 몇 칸이 길게 이어져."
    },
    "p016": {
      "source_hash": "f32cb6897bfc",
      "text": "전체 공기 저항 대부분은 긴 차체 옆면과 객차 사이 틈에 있고,"
    },
    "p017": {
      "source_hash": "9cff07cde23b",
      "text": "맨 앞코가 아니야."
    },
    "p018": {
      "source_hash": "6906d0b93d00",
      "text": "저항이 옆면에 있으면"
    },
    "p019": {
      "source_hash": "bdeba6c28ccb",
      "text": "왜 코를 늘려요"
    },
    "p020": {
      "source_hash": "883443830a8f",
      "text": "좁은 터널에 들어가면 이상한 일이 생겨."
    },
    "p021": {
      "source_hash": "ef08f4e12854",
      "text": "막 들어갔는데 몇 킬로 밖 출구에서 갑자기 뻥 소리가 나"
    },
    "p022": {
      "source_hash": "e57573a906fc",
      "text": "대포 같은 소리뿐 아니라"
    },
    "p023": {
      "source_hash": "10da8a9c88d7",
      "text": "안 들리는 저주파 진동이 근처 창문을 흔들어."
    },
    "p024": {
      "source_hash": "62cbab98ebed",
      "text": "대포처럼요?"
    },
    "p025": {
      "source_hash": "ce09eef99edf",
      "text": "소리보다 빨리 달려"
    },
    "p026": {
      "source_hash": "7041bbe758e0",
      "text": "소닉붐이 난 건가요"
    },
    "p027": {
      "source_hash": "73a224eb4ac0",
      "text": "터널 소닉붐이라 부르지만 초음속은 아니야."
    },
    "p028": {
      "source_hash": "fd7799771b5e",
      "text": "소리는 시속 천이백 킬로가 넘고 열차는 사분의 일뿐이야."
    },
    "p029": {
      "source_hash": "e3543a6848d5",
      "text": "음속으로 달리는 건 기차가 아니라"
    },
    "p030": {
      "source_hash": "67b56983024a",
      "text": "기차에 밀려 나간 공기 덩어리야!"
    },
    "p031": {
      "source_hash": "26b0fbbdead2",
      "text": "터널을 관, 기차를 펌프 피스톤이라 생각해."
    },
    "p032": {
      "source_hash": "d5923c92f37c",
      "text": "밖에선 공기가 밀려도 옆으로 피하면 되지?"
    },
    "p033": {
      "source_hash": "5ae2e203f41d",
      "text": "터널 안은 벽이라 못 피하고,"
    },
    "p034": {
      "source_hash": "f67ff0c30cec",
      "text": "앞코에 밀려 터널에 압축파가 만들어져."
    },
    "p035": {
      "source_hash": "b7756078a2cc",
      "text": "이 압축파가 음속으로 기차보다 빨리 달려."
    },
    "p036": {
      "source_hash": "0e6d4e8b43de",
      "text": "기차가 들어갈 때 압축파가 먼저 출구에서 뻥 터져."
    },
    "p037": {
      "source_hash": "438b3c72245f",
      "text": "정식 이름은 터널 미기압파,"
    },
    "p038": {
      "source_hash": "2ac39e8f653f",
      "text": "일본 별명은 터널 붐이야."
    },
    "p039": {
      "source_hash": "8c3c43cbe22e",
      "text": "옛 기차도 터널 갔고"
    },
    "p040": {
      "source_hash": "437f4090ec16",
      "text": "1975년에"
    },
    "p041": {
      "source_hash": "24c92ac8e8b8",
      "text": "왜 심해졌죠?"
    },
    "p042": {
      "source_hash": "09f00c6f3bb1",
      "text": "그해 산요선이 하카타로 갈 때,"
    },
    "p043": {
      "source_hash": "0d4aa037e1d3",
      "text": "시운전 중 긴 터널 출구에서 뻥뻥 울렸어."
    },
    "p044": {
      "source_hash": "c74ea922e793",
      "text": "찾아낸 비밀은 선로 아래 바닥에 있었어!"
    },
    "p045": {
      "source_hash": "75b7d3d82912",
      "text": "초기 선로엔 자갈이 깔려 스펀지처럼 파동을 줄여"
    },
    "p046": {
      "source_hash": "0058f476b30f",
      "text": "새 터널은 단단한 콘크리트 판을 썼어."
    },
    "p047": {
      "source_hash": "350c17ff7822",
      "text": "자갈이 없으니 긴 터널서 파동이 가팔라져 크게 터졌어"
    },
    "p048": {
      "source_hash": "58313e209fa3",
      "text": "조금만 빨라져도"
    },
    "p049": {
      "source_hash": "6b78810bddbf",
      "text": "소리도 조금 커지나요?"
    },
    "p050": {
      "source_hash": "ce4e198fe3b2",
      "text": "아니! 미기압파는 열차 속도의 세제곱에 비례해."
    },
    "p051": {
      "source_hash": "ee30af61a7ab",
      "text": "속도가 십 퍼센트 늘면 폭음은 삼십 퍼센트 넘게 커져!"
    },
    "p052": {
      "source_hash": "305592dfc2df",
      "text": "안 늦추고도"
    },
    "p053": {
      "source_hash": "65ee0aa213f8",
      "text": "들어가는 순간 파동을 어떻게 누를까?"
    },
    "p054": {
      "source_hash": "d232e0945460",
      "text": "긴 앞코는"
    },
    "p055": {
      "source_hash": "a49e8e092337",
      "text": "스펀지처럼"
    },
    "p056": {
      "source_hash": "016bcd8c957f",
      "text": "압력을 흡수하나요?"
    },
    "p057": {
      "source_hash": "82be1ffe056e",
      "text": "압력이 오르는 기울기를 바꾸는 거야."
    },
    "p058": {
      "source_hash": "2ed29a142930",
      "text": "출구 소리는 첫 순간 압력이 얼마나 가파른지에 달려."
    },
    "p059": {
      "source_hash": "55ee7a358784",
      "text": "네모난 앞머리가 터널에 가면"
    },
    "p060": {
      "source_hash": "57a009670e20",
      "text": "수면을 치듯 압력이 절벽처럼 치솟아."
    },
    "p061": {
      "source_hash": "3a3161d2b3a3",
      "text": "코를 늘리면 끝만 먼저 들어가 조금씩 굵어지지."
    },
    "p062": {
      "source_hash": "bce5f5a4060c",
      "text": "압력이 완만해져 출구 폭음이 사라져."
    },
    "p063": {
      "source_hash": "1d421f391aff",
      "text": "그럼 뾰족한 원뿔 모양으로"
    },
    "p064": {
      "source_hash": "991a49e08f4e",
      "text": "연필심처럼"
    },
    "p065": {
      "source_hash": "7ae4d61e24d7",
      "text": "제일 좋죠"
    },
    "p066": {
      "source_hash": "cff68074bd74",
      "text": "연구소가 원뿔과 타원 모형으로 실험했어."
    },
    "p067": {
      "source_hash": "56f08022cce8",
      "text": "원뿔은 아니야! 뒤로 갈수록 단면적이 빨리 커져 압력이 치솟아."
    },
    "p068": {
      "source_hash": "f7658f8cf89d",
      "text": "최고는 회전포물체야."
    },
    "p069": {
      "source_hash": "7a7471ea599f",
      "text": "끝에서 차체까지 단면적 증가율이 일정해 압력이 고르게 올라."
    },
    "p070": {
      "source_hash": "5f4ec540f7b7",
      "text": "코뿐 아니라 객차 단면도 더 가늘고 둥글게 했어."
    },
    "p071": {
      "source_hash": "5440a00b5236",
      "text": "차체 공간이 줄면 밀어내는 공기도 줄어 파동이 약해져"
    },
    "p072": {
      "source_hash": "77b0aa2e4e6d",
      "text": "터널 쪽은"
    },
    "p073": {
      "source_hash": "08fcee87b61a",
      "text": "입구서 바람 못 빼요"
    },
    "p074": {
      "source_hash": "f58fffcbf442",
      "text": "일본 터널 입구엔 완충 후드를 달았어"
    },
    "p075": {
      "source_hash": "e2360d3eebe5",
      "text": "들어갈 때 후드 옆 창으로 공기가 일부 빠져나가."
    },
    "p076": {
      "source_hash": "5d667ad55670",
      "text": "더 높은 속도에선 후드만으론 부족해서"
    },
    "p077": {
      "source_hash": "d68453d5403c",
      "text": "자연에서 힌트를 찾았어."
    },
    "p078": {
      "source_hash": "e8e5efe05570",
      "text": "일구구공년대 JR서일본이 최고속 오백계를 개발했어."
    },
    "p079": {
      "source_hash": "6a3a088b37d9",
      "text": "산요선 절반이 약 육십오 제곱미터의 좁은 터널이야"
    },
    "p080": {
      "source_hash": "841a88a0cfce",
      "text": "나카쓰 에이지에 따르면 사백 미터 밖 주민도 항의해"
    },
    "p081": {
      "source_hash": "8fddf94e94db",
      "text": "시속 삼백오십 킬로 시험을 접을 뻔했대"
    },
    "p082": {
      "source_hash": "0141ad463655",
      "text": "사백 미터 밖까지!"
    },
    "p083": {
      "source_hash": "90e9aa83e7e1",
      "text": "뭘 찾았죠"
    },
    "p084": {
      "source_hash": "18d516858033",
      "text": "조류 협회 회원이던 나카쓰는 객차가 눌린단 말에,"
    },
    "p085": {
      "source_hash": "7d43d1007a48",
      "text": "고속으로 입수해도 물보라가 작은 물총새를 봤어"
    },
    "p086": {
      "source_hash": "ced39fa35764",
      "text": "물총새 부리를 보고"
    },
    "p087": {
      "source_hash": "47fa9a0ed7a1",
      "text": "그대로 베꼈나요?"
    },
    "p088": {
      "source_hash": "7af93a5ddab9",
      "text": "아니! 물총새는 영감이고 모양은 실험으로 계산했어."
    },
    "p089": {
      "source_hash": "9e0457bc87ed",
      "text": "모형을 관에 쏴 압력파를 재고 슈퍼컴퓨터로 계산했지."
    },
    "p090": {
      "source_hash": "31a8702d3c8c",
      "text": "컴퓨터가 찾은 곡선을 물총새와 비교해"
    },
    "p091": {
      "source_hash": "046a1d1b3bf5",
      "text": "물총새 부리에서 이마까지 모양과 거의 같았어!"
    },
    "p092": {
      "source_hash": "d9c8051b226c",
      "text": "부리랑 똑같군요!"
    },
    "p093": {
      "source_hash": "4d8f97342652",
      "text": "생물학자도 측정했나요?"
    },
    "p094": {
      "source_hash": "a699d6cd5eea",
      "text": "이천십구년 물총새 일흔한 종을 비교 실험해서"
    },
    "p095": {
      "source_hash": "b9a11c02a97f",
      "text": "물총새 부리와 이마가 입수 저항을 줄인다고 밝혔어."
    },
    "p096": {
      "source_hash": "28b2b96558f7",
      "text": "폭음은 해결됐고"
    },
    "p097": {
      "source_hash": "df904fd35fca",
      "text": "지붕 전선 장치는요?"
    },
    "p098": {
      "source_hash": "cbebbd90126f",
      "text": "지붕 팬터그래프도 바람 가를 때 시끄러워"
    },
    "p099": {
      "source_hash": "277bf67e4925",
      "text": "나카쓰는 올빼미 깃털의 잔톱니를 본떠 바람 소리도 줄였대."
    },
    "p100": {
      "source_hash": "c0c1135d403c",
      "text": "일구구칠년 삼월, 신오사카에서 하카타를 십오 분 단축했어."
    },
    "p101": {
      "source_hash": "d3a641b6bdcc",
      "text": "JR서일본은 2027년 정기 운행을 마칠 거야"
    },
    "p102": {
      "source_hash": "734210a2f07f",
      "text": "그렇게 성공했는데"
    },
    "p103": {
      "source_hash": "a46be47c71ad",
      "text": "왜 나중엔"
    },
    "p104": {
      "source_hash": "85f3d523c9b9",
      "text": "안 길어졌죠"
    },
    "p105": {
      "source_hash": "1286fd2e541c",
      "text": "긴 코엔 대가가 있어. 길수록 좌석이 줄거든!"
    },
    "p106": {
      "source_hash": "b9788ebd7634",
      "text": "차 길이는 같은데 코가 길면 운전실이 밀려 객실이 작아져."
    },
    "p107": {
      "source_hash": "bc32199c10a0",
      "text": "다음 700계는 시속 285킬로로 줄였어"
    },
    "p108": {
      "source_hash": "e35bbbf02087",
      "text": "다단 회전포물체로 9.2m로 줄여 좌석을 지켰어!"
    },
    "p109": {
      "source_hash": "1045156b2db9",
      "text": "더 빨리 달리려면"
    },
    "p110": {
      "source_hash": "a2b1a134d97b",
      "text": "또 길어지나요"
    },
    "p111": {
      "source_hash": "ee4ad340ac99",
      "text": "맞아! 북쪽의 시속 320킬로 열차는 코가 다시 길어졌어."
    },
    "p112": {
      "source_hash": "33bfdc876ae9",
      "text": "360km/h 시험차는 코가 22m라 몇 줄뿐"
    },
    "p113": {
      "source_hash": "b3134d6632e2",
      "text": "철도연구소는 새로운 삼단 앞머리 모양도 개발 중이야"
    },
    "p114": {
      "source_hash": "ddab1bfbc99d",
      "text": "조용함은 같고 1m 더 줄여 좌석을 늘리려 해"
    },
    "p115": {
      "source_hash": "2c52341dfcf0",
      "text": "대만 고속철도는?"
    },
    "p116": {
      "source_hash": "4b1d9e208dd0",
      "text": "일본차 기반에"
    },
    "p117": {
      "source_hash": "a6d5350dd6f6",
      "text": "더 빠른데 코는 왜 짧죠?"
    },
    "p118": {
      "source_hash": "06cd0ff3b9f2",
      "text": "그게 핵심이야! 대만 일세대 열차는 일본 원형보다 빠른데"
    },
    "p119": {
      "source_hash": "3dca47a8bf64",
      "text": "코는 9.2에서 8미터로, 1.2미터나 줄었어!"
    },
    "p120": {
      "source_hash": "03d47086e8c9",
      "text": "1.2미터나 짧은데"
    },
    "p121": {
      "source_hash": "adaa509f7afe",
      "text": "뻥 소리 안 나요"
    },
    "p122": {
      "source_hash": "1a18431381d5",
      "text": "안 나! 비밀은 기차가 아니라 대만의 터널에 있어."
    },
    "p123": {
      "source_hash": "f4521d0a4709",
      "text": "펌프 알지? 관이 굵으면 공기가 옆으로 흘러 파동이 작아."
    },
    "p124": {
      "source_hash": "4e433abfdd21",
      "text": "일본 터널은 좁지만 대만은 단면을 90㎡ 넘게 팠어."
    },
    "p125": {
      "source_hash": "c9407828ffa3",
      "text": "일본보다 50퍼센트 가까이 크니 훨씬 넓지?"
    },
    "p126": {
      "source_hash": "aec4bb96320a",
      "text": "입구엔 30~40m, 45도 경사 후드도 지었어"
    },
    "p127": {
      "source_hash": "8f10c606f842",
      "text": "넓은 터널과 후드로 8m 코로도 소리를 잡고 좌석을 남겼어"
    },
    "p128": {
      "source_hash": "c3bfbff2ed70",
      "text": "터널이 넓군요!"
    },
    "p129": {
      "source_hash": "b4066e63dcf2",
      "text": "대만의 새 열차는"
    },
    "p130": {
      "source_hash": "f9bc83ae751f",
      "text": "어떤 모습"
    },
    "p131": {
      "source_hash": "fe034ad666e9",
      "text": "새 열차 첫 편성이 2026년 8월 와서 내년 후반 달려."
    },
    "p132": {
      "source_hash": "4d9c8eb96ec5",
      "text": "더 납작한 유선형에 양옆 능선으로 터널서 더 안정돼"
    },
    "p133": {
      "source_hash": "291624b6464f",
      "text": "단서 모였어, 궁금아"
    },
    "p134": {
      "source_hash": "5da8f046c5b8",
      "text": "긴 코와 짧은 코를 풀어 봐"
    },
    "p135": {
      "source_hash": "32290839c68c",
      "text": "좁은 터널은 펌프고,"
    },
    "p136": {
      "source_hash": "853112b8c7c8",
      "text": "압축파가 음속으로 출구서 뻥!"
    },
    "p137": {
      "source_hash": "aec722477070",
      "text": "긴 코가 압력을 완만하게 올려요!"
    },
    "p138": {
      "source_hash": "ae3a3069bf56",
      "text": "길면 좌석감소"
    },
    "p139": {
      "source_hash": "dbd9a7c04a0c",
      "text": "대만 터널은 50% 더 커서"
    },
    "p140": {
      "source_hash": "45d225a8a60c",
      "text": "8미터도 조용해요!"
    },
    "p141": {
      "source_hash": "de238215d1d4",
      "text": "다음에 승강장에서 코끝부터 창문까지 부풀어 오르는 곡선을 봐"
    },
    "p142": {
      "source_hash": "084866675035",
      "text": "터널 속 공기에게 부드럽게 인사하는 모양이야."
    },
    "p143": {
      "source_hash": "36d742bcb996",
      "text": "아하 그렇구나"
    },
    "p144": {
      "source_hash": "61e3b0839442",
      "text": "터널에 들어갈 때 귀가 먹먹해지는 기압 변화를 느껴 봤니?"
    },
    "p145": {
      "source_hash": "01835bda53a6",
      "text": "댓글로"
    },
    "p146": {
      "source_hash": "88de677d4daa",
      "text": "일상 속 왜 그런지 함께 찾고 싶다면 아하 사무소를 구독해 줘."
    }
  }
}
