    "tags": "0b9543624fbb",
    "thumbnail": "8be3bd7bfb31"
  },
  "lines": {
    "p001": {
      "source_hash": "ee3712f22a5d",
      "text": "所長！新幹線の鼻、"
    },
    "p002": {
      "source_hash": "b7ba93b6aa2c",
      "text": "十五メートルも長いの、"
    },
    "p003": {
      "source_hash": "cf049b281c1a",
      "text": "風の抵抗を減らすため？"
    },
    "p004": {
      "source_hash": "64db113cf41d",
      "text": "風よけと思われがちだけど、"
    },
    "p005": {
      "source_hash": "8d64aac773ee",
      "text": "技術者が本当に恐れる敵はトンネルの中よ。"
    },
    "p006": {
      "source_hash": "dbc05700bdba",
      "text": "トンネル？"
    },
    "p007": {
      "source_hash": "90183e8d7646",
      "text": "台湾は速いのに"
    },
    "p008": {
      "source_hash": "647003528dfd",
      "text": "なぜ短いの？"
    },
    "p009": {
      "source_hash": "0ff64bac1f98",
      "text": "台湾は日本の元の車両より速いのに鼻は短いわ。"
    },
    "p010": {
      "source_hash": "4150c4a09721",
      "text": "列車とトンネルへ入ろう！"
    },
    "p011": {
      "source_hash": "f9f8f814f46d",
      "text": "時速三百キロだと、"
    },
    "p012": {
      "source_hash": "d83567827741",
      "text": "前からすごい風だし"
    },
    "p013": {
      "source_hash": "90f0f7fee8f0",
      "text": "抵抗は先頭では？"
    },
    "p014": {
      "source_hash": "8aefcc347036",
      "text": "流線型の先頭も抵抗を減らすわ。"
    },
    "p015": {
      "source_hash": "ae259f74b36c",
      "text": "でも鉄道総研の計算では、新幹線は十数両つながった長い列車よ。"
    },
    "p016": {
      "source_hash": "f32cb6897bfc",
      "text": "列車全体の空気抵抗の大半は、実は長い車体の側面や車両の間の隙間"
    },
    "p017": {
      "source_hash": "9cff07cde23b",
      "text": "先頭だけじゃないの。"
    },
    "p018": {
      "source_hash": "6906d0b93d00",
      "text": "抵抗が側面にあるなら、"
    },
    "p019": {
      "source_hash": "bdeba6c28ccb",
      "text": "なぜ鼻を長くするの"
    },
    "p020": {
      "source_hash": "883443830a8f",
      "text": "狭いトンネルに入ると不思議なことが起きるの。"
    },
    "p021": {
      "source_hash": "ef08f4e12854",
      "text": "列車が入口に入った瞬間、数キロ先の出口で「ドン！」と鳴るのよ。"
    },
    "p022": {
      "source_hash": "e57573a906fc",
      "text": "大砲のような音だけじゃなく"
    },
    "p023": {
      "source_hash": "10da8a9c88d7",
      "text": "聞こえない低周波の振動で、近くの家の窓や戸がガタガタ鳴るの。"
    },
    "p024": {
      "source_hash": "62cbab98ebed",
      "text": "大砲みたいな音"
    },
    "p025": {
      "source_hash": "ce09eef99edf",
      "text": "音より速く走って、"
    },
    "p026": {
      "source_hash": "7041bbe758e0",
      "text": "衝撃波が出たの？"
    },
    "p027": {
      "source_hash": "73a224eb4ac0",
      "text": "音爆とも呼ぶが超音速じゃない。"
    },
    "p028": {
      "source_hash": "fd7799771b5e",
      "text": "音速は時速1200km。新幹線はその1/4よ。"
    },
    "p029": {
      "source_hash": "e3543a6848d5",
      "text": "音速でトンネルを走るのは列車じゃなく"
    },
    "p030": {
      "source_hash": "67b56983024a",
      "text": "列車に強く押し出された空気の塊なの！"
    },
    "p031": {
      "source_hash": "26b0fbbdead2",
      "text": "トンネルを細い管、列車を空気入れのピストンと見て。"
    },
    "p032": {
      "source_hash": "d5923c92f37c",
      "text": "広い場所なら、押された空気は横へ逃げるでしょ？"
    },
    "p033": {
      "source_hash": "5ae2e203f41d",
      "text": "でもトンネルは壁だらけで逃げ場がなく"
    },
    "p034": {
      "source_hash": "f67ff0c30cec",
      "text": "先頭に前へと押し込まれて、トンネル内で圧縮波になるの。"
    },
    "p035": {
      "source_hash": "b7756078a2cc",
      "text": "圧縮波は音速で走る。列車より何倍も速いわ。"
    },
    "p036": {
      "source_hash": "0e6d4e8b43de",
      "text": "圧縮波が先に出口へ届き、ドンと鳴り響くの。"
    },
    "p037": {
      "source_hash": "438b3c72245f",
      "text": "正式名は「トンネル微気圧波」、"
    },
    "p038": {
      "source_hash": "2ac39e8f653f",
      "text": "日本では「トンネルドン」とも呼ぶわ。"
    },
    "p039": {
      "source_hash": "8c3c43cbe22e",
      "text": "昔もトンネルを通るのに"
    },
    "p040": {
      "source_hash": "437f4090ec16",
      "text": "なぜ一九七五年に"
    },
    "p041": {
      "source_hash": "24c92ac8e8b8",
      "text": "急にひどくなったの"
    },
    "p042": {
      "source_hash": "09f00c6f3bb1",
      "text": "75年山陽新幹線延伸時"
    },
    "p043": {
      "source_hash": "0d4aa037e1d3",
      "text": "試運転でトンネル出口でドンと鳴った。"
    },
    "p044": {
      "source_hash": "c74ea922e793",
      "text": "調べると、秘密はレールの下の床にあったわ！"
    },
    "p045": {
      "source_hash": "75b7d3d82912",
      "text": "昔の線路は砕石が敷かれ、隙間がスポンジのように波を和らげた。"
    },
    "p046": {
      "source_hash": "0058f476b30f",
      "text": "新区間は保守を減らす硬いスラブ軌道に。"
    },
    "p047": {
      "source_hash": "350c17ff7822",
      "text": "砕石がないと波が急峻化し大音響に！"
    },
    "p048": {
      "source_hash": "58313e209fa3",
      "text": "少し速く走るだけで、"
    },
    "p049": {
      "source_hash": "6b78810bddbf",
      "text": "出口の音も少し大きくなる？"
    },
    "p050": {
      "source_hash": "ce4e198fe3b2",
      "text": "それどころか、微気圧波は速度のほぼ三乗に比例するの。"
    },
    "p051": {
      "source_hash": "ee30af61a7ab",
      "text": "速度が一割上がると、出口のドンという音は三割以上も強まるわ！"
    },
    "p052": {
      "source_hash": "305592dfc2df",
      "text": "速度を落とさずに"
    },
    "p053": {
      "source_hash": "65ee0aa213f8",
      "text": "入った瞬間にどうやってその波を抑えるか？"
    },
    "p054": {
      "source_hash": "d232e0945460",
      "text": "鼻を長くするのは"
    },
    "p055": {
      "source_hash": "a49e8e092337",
      "text": "スポンジのよう"
    },
    "p056": {
      "source_hash": "016bcd8c957f",
      "text": "圧力を吸い取るの？"
    },
    "p057": {
      "source_hash": "82be1ffe056e",
      "text": "消せない空気の圧力の「傾き」を変えるの。"
    },
    "p058": {
      "source_hash": "2ed29a142930",
      "text": "出口の音量は、突入時の圧力の急激さ次第よ。"
    },
    "p059": {
      "source_hash": "55ee7a358784",
      "text": "先頭が四角い箱だと突入時に"
    },
    "p060": {
      "source_hash": "57a009670e20",
      "text": "水面を叩くように圧力が跳ね上がるわ。"
    },
    "p061": {
      "source_hash": "3a3161d2b3a3",
      "text": "鼻を長くすれば、徐々に断面積が増えるわ。"
    },
    "p062": {
      "source_hash": "bce5f5a4060c",
      "text": "圧力が緩やかな坂になり、出口の音を防ぐの。"
    },
    "p063": {
      "source_hash": "1d421f391aff",
      "text": "じゃあ先頭を尖った円錐にして"
    },
    "p064": {
      "source_hash": "991a49e08f4e",
      "text": "鉛筆の先なら"
    },
    "p065": {
      "source_hash": "7ae4d61e24d7",
      "text": "一番いいの？"
    },
    "p066": {
      "source_hash": "cff68074bd74",
      "text": "鉄道総研が円錐や楕円模型で実験したの。"
    },
    "p067": {
      "source_hash": "56f08022cce8",
      "text": "円錐は後方で断面積が急増し圧力が跳ね上がるわ。"
    },
    "p068": {
      "source_hash": "f7658f8cf89d",
      "text": "最適は「回転放物体」。"
    },
    "p069": {
      "source_hash": "7a7471ea599f",
      "text": "断面積が均一に増え、圧力が緩やかに上がるの。"
    },
    "p070": {
      "source_hash": "5f4ec540f7b7",
      "text": "鼻を伸ばすだけでなく、車体の断面も細く丸くしたわ。"
    },
    "p071": {
      "source_hash": "5440a00b5236",
      "text": "車体が占める空間が減れば、押す空気も減って圧力波が軽くなるの。"
    },
    "p072": {
      "source_hash": "77b0aa2e4e6d",
      "text": "トンネル側は"
    },
    "p073": {
      "source_hash": "08fcee87b61a",
      "text": "入口で空気を抜けないの？"
    },
    "p074": {
      "source_hash": "f58fffcbf442",
      "text": "日本のスラブ軌道のトンネルには緩衝工があるわ。"
    },
    "p075": {
      "source_hash": "e2360d3eebe5",
      "text": "列車が入る時、フードの横の窓から空気を少し逃がすのよ。"
    },
    "p076": {
      "source_hash": "5d667ad55670",
      "text": "でもさらに速度が上がると、緩衝工だけでは足りず、"
    },
    "p077": {
      "source_hash": "d68453d5403c",
      "text": "自然界にヒントを求めたの。"
    },
    "p078": {
      "source_hash": "e8e5efe05570",
      "text": "90年代JRは500系を開発。"
    },
    "p079": {
      "source_hash": "6a3a088b37d9",
      "text": "山陽はトンネル多く断面狭い。"
    },
    "p080": {
      "source_hash": "841a88a0cfce",
      "text": "開発の仲津によると、400m先からも苦情が出て"
    },
    "p081": {
      "source_hash": "8fddf94e94db",
      "text": "時速350km試験の断念も考えたの。"
    },
    "p082": {
      "source_hash": "0141ad463655",
      "text": "四百メートル先まで！"
    },
    "p083": {
      "source_hash": "90e9aa83e7e1",
      "text": "どうしたの？"
    },
    "p084": {
      "source_hash": "18d516858033",
      "text": "野鳥好きの仲津は突入時の抵抗感を聞き、"
    },
    "p085": {
      "source_hash": "7d43d1007a48",
      "text": "水しぶきを立てず潜るカワセミを思い出した！"
    },
    "p086": {
      "source_hash": "ced39fa35764",
      "text": "じゃあカワセミのくちばし"
    },
    "p087": {
      "source_hash": "47fa9a0ed7a1",
      "text": "そのまま写したの？"
    },
    "p088": {
      "source_hash": "7af93a5ddab9",
      "text": "写したんじゃないわ。カワセミはヒントで、形は実験と計算よ。"
    },
    "p089": {
      "source_hash": "9e0457bc87ed",
      "text": "模型を細い管に撃ち込んで圧力波を測り、スパコンでも計算したの。"
    },
    "p090": {
      "source_hash": "31a8702d3c8c",
      "text": "計算した理想の曲線をカワセミと比べると"
    },
    "p091": {
      "source_hash": "046a1d1b3bf5",
      "text": "くちばしから額までの形とほぼぴったり一致したのよ！"
    },
    "p092": {
      "source_hash": "d9c8051b226c",
      "text": "計算とくちばしが同じ"
    },
    "p093": {
      "source_hash": "4d8f97342652",
      "text": "生物学者もくちばしを調べたの？"
    },
    "p094": {
      "source_hash": "a699d6cd5eea",
      "text": "2019年、71種のカワセミを比較実験し、"
    },
    "p095": {
      "source_hash": "b9a11c02a97f",
      "text": "飛び込む種の頭部が抵抗を減らすと実証したわ。"
    },
    "p096": {
      "source_hash": "28b2b96558f7",
      "text": "トンネルの音は解決！"
    },
    "p097": {
      "source_hash": "df904fd35fca",
      "text": "屋根の電気をとる装置は？"
    },
    "p098": {
      "source_hash": "cbebbd90126f",
      "text": "パンタグラフも高速走行時に騒音を出すの。"
    },
    "p099": {
      "source_hash": "277bf67e4925",
      "text": "フクロウの羽のギザギザをまね風切り音を抑制した。"
    },
    "p100": {
      "source_hash": "c0c1135d403c",
      "text": "97年3月、新大阪—博多間を15分短縮したわ。"
    },
    "p101": {
      "source_hash": "d3a641b6bdcc",
      "text": "2027年に定期営業を終える予定よ。"
    },
    "p102": {
      "source_hash": "734210a2f07f",
      "text": "長い鼻が成功したなら"
    },
    "p103": {
      "source_hash": "a46be47c71ad",
      "text": "なぜその後の車両"
    },
    "p104": {
      "source_hash": "85f3d523c9b9",
      "text": "もっと伸ばさない"
    },
    "p105": {
      "source_hash": "1286fd2e541c",
      "text": "長い鼻の代償として客席が減るのよ！"
    },
    "p106": {
      "source_hash": "b9788ebd7634",
      "text": "車両長が同じため、鼻が伸びると客室が減るの。"
    },
    "p107": {
      "source_hash": "bc32199c10a0",
      "text": "700系は285kmで鼻を短縮した。"
    },
    "p108": {
      "source_hash": "e35bbbf02087",
      "text": "鼻を9.2mに縮め座席を守った！"
    },
    "p109": {
      "source_hash": "1045156b2db9",
      "text": "もっと速く走るなら、"
    },
    "p110": {
      "source_hash": "a2b1a134d97b",
      "text": "また鼻は伸びる？"
    },
    "p111": {
      "source_hash": "ee4ad340ac99",
      "text": "320km車はまた長鼻に戻る。"
    },
    "p112": {
      "source_hash": "33bfdc876ae9",
      "text": "360km試験車は鼻22mで席僅か！"
    },
    "p113": {
      "source_hash": "b3134d6632e2",
      "text": "鉄道総研は三段式の新先頭形状も開発中で、"
    },
    "p114": {
      "source_hash": "ddab1bfbc99d",
      "text": "鼻を1m短縮し座席を増やそうとしてるわ。"
    },
    "p115": {
      "source_hash": "2c52341dfcf0",
      "text": "台湾高鉄は？"
    },
    "p116": {
      "source_hash": "4b1d9e208dd0",
      "text": "日本ベース"
    },
    "p117": {
      "source_hash": "a6d5350dd6f6",
      "text": "より速いのに短いの？"
    },
    "p118": {
      "source_hash": "06cd0ff3b9f2",
      "text": "台湾の初代は日本より速いのに鼻が短いの！"
    },
    "p119": {
      "source_hash": "3dca47a8bf64",
      "text": "鼻は9.2mから8mへ1.2m短縮されたの！"
    },
    "p120": {
      "source_hash": "03d47086e8c9",
      "text": "速いのに1.2m短くて"
    },
    "p121": {
      "source_hash": "adaa509f7afe",
      "text": "ドンって鳴らないの？"
    },
    "p122": {
      "source_hash": "1a18431381d5",
      "text": "鳴らないわ！秘密は車両ではなく、台湾のトンネルにあるの。"
    },
    "p123": {
      "source_hash": "f4521d0a4709",
      "text": "空気入れを思い出して。管が太ければ空気が横を流れ、圧力波は小さくなるわ。"
    },
    "p124": {
      "source_hash": "4e433abfdd21",
      "text": "日本のトンネルは狭いが台湾は90㎡以上よ。"
    },
    "p125": {
      "source_hash": "c9407828ffa3",
      "text": "日本の約1.5倍も広く、余裕があるのよ。"
    },
    "p126": {
      "source_hash": "aec4bb96320a",
      "text": "入口にも30〜40mの45度緩衝工があるわ。"
    },
    "p127": {
      "source_hash": "8f10c606f842",
      "text": "広いトンネルと緩衝工で8m鼻でも静粛性を保てた！"
    },
    "p128": {
      "source_hash": "c3bfbff2ed70",
      "text": "トンネルが広いから！"
    },
    "p129": {
      "source_hash": "b4066e63dcf2",
      "text": "台湾の新しい車両は、"
    },
    "p130": {
      "source_hash": "f9bc83ae751f",
      "text": "どんな顔なの"
    },
    "p131": {
      "source_hash": "fe034ad666e9",
      "text": "新型は2026年8月に到着し翌年運行予定よ。"
    },
    "p132": {
      "source_hash": "4d9c8eb96ec5",
      "text": "平たい流線型と両側エッジで安定走行するわ。"
    },
    "p133": {
      "source_hash": "291624b6464f",
      "text": "ヒントは揃ったわ、ハテナ、"
    },
    "p134": {
      "source_hash": "5da8f046c5b8",
      "text": "長い鼻と短い鼻の謎を解いてみて！"
    },
    "p135": {
      "source_hash": "32290839c68c",
      "text": "トンネルは空気入れ"
    },
    "p136": {
      "source_hash": "853112b8c7c8",
      "text": "波が音速で走りドンと鳴る！"
    },
    "p137": {
      "source_hash": "aec722477070",
      "text": "長い鼻で圧力を緩やかに！"
    },
    "p138": {
      "source_hash": "ae3a3069bf56",
      "text": "長いと席が減るし"
    },
    "p139": {
      "source_hash": "dbd9a7c04a0c",
      "text": "台湾のトンネルは日本より五割近く広い"
    },
    "p140": {
      "source_hash": "45d225a8a60c",
      "text": "鼻は8メートルで静か！"
    },
    "p141": {
      "source_hash": "de238215d1d4",
      "text": "今度ホームで列車を待つ時は、鼻先から窓へ膨らむ曲線を見てみて。"
    },
    "p142": {
      "source_hash": "084866675035",
      "text": "トンネルの空気に優しく挨拶するため、技術者が計算した形よ。"
    },
    "p143": {
      "source_hash": "36d742bcb996",
      "text": "なるほど！"
    },
    "p144": {
      "source_hash": "61e3b0839442",
      "text": "列車でトンネルに入った時、耳がツンとする気圧の変化を感じたことはある？"
    },
    "p145": {
      "source_hash": "01835bda53a6",
      "text": "教えて"
    },
    "p146": {
      "source_hash": "88de677d4daa",
      "text": "日常の「なぜ」を一緒に探すなら、なるほど事務所をチャンネル登録してね。"
    }
  }
}