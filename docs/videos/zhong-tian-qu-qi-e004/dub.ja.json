{
  "zq4a01": "人は物じゃない。",
  "zq4a02": "質にできない。",
  "zq4a03": "ピコン。アーリン、マイナス二。",
  "zq4a04": "三も上がった！",
  "zq4a05": "三って何？",
  "zq4a06": "忘れるな。",
  "zq4a07": "お、おやすみ？",
  "zq4a08": "お兄ちゃん、お米あと一杯だけ。",
  "zq4a09": {
    "text": "材料：豚の脂、草木灰、大鍋。",
    "say": "豚の脂と灰と大鍋。"
  },
  "zq4a10": "鍋ひとつ買えない……",
  "zq4a11": "お金？待ってて！",
  "zq4a12": "お姉ちゃんは？",
  "zq4a13": "二十両でしょ？",
  "zq4a14": "はした金よ。",
  "zq4a15": "これで返して！",
  "zq4a16": "金塊がいっぱい！",
  "zq4a17": "お金持ちだ！",
  "zq4a18": "君の逃げ道だろ。",
  "zq4a19": "いらない？",
  "zq4a20": "自分で稼ぐ。",
  "zq4a21": "シャオタン、プラス十。",
  "zq4a22": "おばさん、灰ちょうだい！",
  "zq4a23": "ありがとう！",
  "zq4a24": "兄貴！鍋だぞ！",
  "zq4a25": "アーニウ、さすがだ！",
  "zq4a26": "豚もないくせにって笑ってる。",
  "zq4a27": "豚の脂、足りる？",
  "zq4a28": "一人で担いだの？",
  "zq4a29": "たかが豚一頭よ。",
  "zq4a30": "朝まで煮れば完成だ。",
  "zq4a31": "これで洗えんの？",
  "zq4a32": "薪をもう少し……",
  "zq4a33": "誰だ！"
}
