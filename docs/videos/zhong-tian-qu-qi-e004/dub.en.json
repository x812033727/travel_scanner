{
  "zq4a01": "A-Ling, people aren't property.",
  "zq4a02": "Not collateral.",
  "zq4a03": "Ding. A-Ling affection: minus two.",
  "zq4a04": "Up three points!",
  "zq4a05": "Three what?",
  "zq4a06": "Keep your word.",
  "zq4a07": "G-good night?",
  "zq4a08": "Brother, we've only got one bowl of rice.",
  "zq4a09": "Materials: lard, wood ash, a big pot.",
  "zq4a10": "Can't even afford a pot…",
  "zq4a11": "Money? Hang on!",
  "zq4a12": "Where's Xiaotang going?",
  "zq4a13": "Xu Yan, twenty taels, right?",
  "zq4a14": "Pocket change.",
  "zq4a15": "Pay your debt!",
  "zq4a16": "So much gold!",
  "zq4a17": "We're rich!",
  "zq4a18": "That's your way out.",
  "zq4a19": "Not taking it?",
  "zq4a20": "I'll earn my own.",
  "zq4a21": "Tang Xiaotang affection: plus ten.",
  "zq4a22": "Auntie, can we have your ash?",
  "zq4a23": "Thank you, Auntie!",
  "zq4a24": "Yan! Got you a big pot!",
  "zq4a25": "Erniu, you're the best!",
  "zq4a26": "They're laughing—no pig, no lard.",
  "zq4a27": "Enough lard for you?",
  "zq4a28": "You carried that alone?",
  "zq4a29": "It's just one pig.",
  "zq4a30": "Boil it till dawn, and it's done.",
  "zq4a31": "It'll really wash clothes?",
  "zq4a32": "A bit more firewood…",
  "zq4a33": "Who's there?!"
}
