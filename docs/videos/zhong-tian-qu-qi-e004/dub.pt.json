{
  "zq4a01": "A-Ling, gente não é objeto.",
  "zq4a02": "Não é garantia.",
  "zq4a03": "Ding. A-Ling: menos dois.",
  "zq4a04": "Subiu três pontos!",
  "zq4a05": "Três o quê?",
  "zq4a06": "Cumpra o que disse.",
  "zq4a07": "Boa… boa noite?",
  "zq4a08": "Mano, só sobrou uma tigela de arroz.",
  "zq4a09": "Material: banha, cinza, panelão.",
  "zq4a10": "Nem uma panela eu compro…",
  "zq4a11": "Dinheiro? Peraí!",
  "zq4a12": "Aonde a Xiaotang vai?",
  "zq4a13": "Xu Yan, vinte taéis, né?",
  "zq4a14": "Trocado.",
  "zq4a15": "Paga a dívida!",
  "zq4a16": "Quanto ouro!",
  "zq4a17": "Tamos ricos!",
  "zq4a18": "Isso é sua saída.",
  "zq4a19": "Não quer?",
  "zq4a20": "Eu ganho o meu.",
  "zq4a21": "Tang Xiaotang: mais dez.",
  "zq4a22": "Tia, dá a cinza pra gente!",
  "zq4a23": "Obrigada, tia!",
  "zq4a24": "Yan! O panelão!",
  "zq4a25": "Erniu, meu irmão!",
  "zq4a26": "Tão rindo: sem porco, sem banha.",
  "zq4a27": "Banha. Serve?",
  "zq4a28": "Carregou sozinha?",
  "zq4a29": "É só um porco.",
  "zq4a30": "Até de manhã, fica pronto.",
  "zq4a31": "Lava roupa mesmo?",
  "zq4a32": "Mais um pouco de lenha…",
  "zq4a33": "Quem é?!"
}
