{
  "zq4a01": "A-Ling, manusia bukan barang.",
  "zq4a02": "Nggak bisa digadai.",
  "zq4a03": {
    "text": "Ding. Poin suka A-Ling, minus dua.",
    "say": "Ding. A-Ling, minus dua."
  },
  "zq4a04": "Naik tiga poin!",
  "zq4a05": "Tiga poin apa?",
  "zq4a06": "Ingat ucapanmu.",
  "zq4a07": "Se… selamat malam?",
  "zq4a08": "Kak, beras kita tinggal semangkuk.",
  "zq4a09": {
    "text": "Bahan: lemak babi, abu kayu, panci besar.",
    "say": "Lemak babi, abu kayu, panci besar."
  },
  "zq4a10": "Beli panci aja nggak mampu…",
  "zq4a11": "Uang? Tunggu!",
  "zq4a12": "Kak Xiaotang ke mana?",
  "zq4a13": "Xu Yan, dua puluh tael, kan?",
  "zq4a14": "Recehan.",
  "zq4a15": "Buat bayar utang!",
  "zq4a16": "Emasnya banyak!",
  "zq4a17": "Kak, kita kaya!",
  "zq4a18": "Ini jalan keluarmu.",
  "zq4a19": "Nggak mau?",
  "zq4a20": {
    "text": "Aku cari sendiri.",
    "say": "Biar aku."
  },
  "zq4a21": {
    "text": "Poin suka Tang Xiaotang, plus sepuluh.",
    "say": "Tang Xiaotang, plus sepuluh."
  },
  "zq4a22": "Bibi, minta abu kayunya, ya!",
  "zq4a23": "Makasih, Bibi!",
  "zq4a24": {
    "text": "Kak Yan! Pancinya datang!",
    "say": "Kak Yan! Panci!"
  },
  "zq4a25": "Erniu, kamu terbaik!",
  "zq4a26": {
    "text": "Mereka ngetawain, kamu nggak punya babi.",
    "say": "Diketawain, nggak ada babi."
  },
  "zq4a27": "Lemak babi, cukup?",
  "zq4a28": "Qin Shuang, kamu angkat sendiri?",
  "zq4a29": "Cuma seekor babi.",
  "zq4a30": "Rebus sampai pagi, jadi deh.",
  "zq4a31": "Beneran bisa buat nyuci?",
  "zq4a32": "Tambah kayu lagi…",
  "zq4a33": "Siapa?!"
}
