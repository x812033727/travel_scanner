{
  "zq4a01": "사람은 물건이 아냐.",
  "zq4a02": "못 넘겨.",
  "zq4a03": {"text": "딩. 아링 호감, -2.", "say": "딩. 아링 호감, 마이너스 이."},
  "zq4a04": "삼 점 올랐다!",
  "zq4a05": "무슨 삼 점?",
  "zq4a06": "잊지 마.",
  "zq4a07": "잘… 자?",
  "zq4a08": "오빠, 집에 쌀 한 그릇뿐이야.",
  "zq4a09": "재료: 돼지기름, 나뭇재, 가마솥.",
  "zq4a10": "솥 하나 살 돈도 없는데…",
  "zq4a11": "돈? 기다려!",
  "zq4a12": "언니 어디 가?",
  "zq4a13": "쉬옌, 스무 냥이랬지?",
  "zq4a14": "푼돈이야.",
  "zq4a15": "빚 갚아!",
  "zq4a16": "금이 잔뜩!",
  "zq4a17": "오빠, 부자다!",
  "zq4a18": "네 몫이야.",
  "zq4a19": "싫어?",
  "zq4a20": "내가 벌게.",
  "zq4a21": {"text": "탕샤오탕 호감, +10.", "say": "탕샤오탕 호감, 플러스 십."},
  "zq4a22": "아주머니, 재 좀 주세요!",
  "zq4a23": "고마워요!",
  "zq4a24": "형! 솥 왔다!",
  "zq4a25": "얼뉴, 역시 내 친구!",
  "zq4a26": "돼지도 없다고 다들 비웃어.",
  "zq4a27": "돼지기름, 충분해?",
  "zq4a28": "혼자 메고 왔어?",
  "zq4a29": "고작 돼지 한 마리.",
  "zq4a30": "밤새 끓이면, 끝.",
  "zq4a31": "진짜 빨래 돼?",
  "zq4a32": "장작 좀 더…",
  "zq4a33": "누구!"
}
