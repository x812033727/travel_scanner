{
  "zq4a01": "A-Ling, nadie es una cosa.",
  "zq4a02": "No se empeña.",
  "zq4a03": "Ding. A-Ling: menos dos.",
  "zq4a04": "¡Subí tres puntos!",
  "zq4a05": "¿Tres qué?",
  "zq4a06": "Cumple tu palabra.",
  "zq4a07": "¿Bu… buenas noches?",
  "zq4a08": "Hermano, solo queda un tazón de arroz.",
  "zq4a09": {
    "text": "Materiales: manteca, ceniza y una olla grande.",
    "say": "Manteca, ceniza y una olla grande."
  },
  "zq4a10": "Ni para una olla me alcanza…",
  "zq4a11": "¿Dinero? ¡Espera!",
  "zq4a12": "¿A dónde va Xiaotang?",
  "zq4a13": "Xu Yan, veinte taeles, ¿no?",
  "zq4a14": "Una miseria.",
  "zq4a15": "¡Paga tu deuda!",
  "zq4a16": "¡Cuánto oro!",
  "zq4a17": "¡Somos ricos!",
  "zq4a18": "Es tu vía de escape.",
  "zq4a19": "¿No lo quieres?",
  "zq4a20": {
    "text": "Yo lo gano.",
    "say": "Lo gano."
  },
  "zq4a21": "Tang Xiaotang: más diez.",
  "zq4a22": "Señora, ¿nos regala su ceniza?",
  "zq4a23": "¡Gracias!",
  "zq4a24": "¡Yan, la olla!",
  "zq4a25": "¡Erniu, eres el mejor!",
  "zq4a26": {
    "text": "Se ríen: sin cerdo no hay manteca.",
    "say": "Se burlan: no tienes cerdo."
  },
  "zq4a27": "¿Te alcanza esta manteca?",
  "zq4a28": "Qin Shuang, ¿lo cargaste tú sola?",
  "zq4a29": "Es solo un cerdo.",
  "zq4a30": "Hervirlo hasta el amanecer, y listo.",
  "zq4a31": "¿De veras lava ropa?",
  "zq4a32": "Un poco más de leña…",
  "zq4a33": "¡¿Quién?!"
}
