  "lines": {
    "tg1a": {
      "source_hash": "fe3cc8411fb9",
      "text": "1908년 6월 30일, 아침 7시 남짓."
    },
    "tg1b": {
      "source_hash": "591b603f1265",
      "text": "시베리아 교역소 현관에 앉은 한 남자."
    },
    "tg1c": {
      "source_hash": "58606b8bb6fa",
      "text": "하늘 저편에서 굉음이 울립니다."
    },
    "tg1d": {
      "source_hash": "bb9bdcac67d3",
      "text": "의자에서 튕겨나갑니다."
    },
    "tg1e": {
      "source_hash": "8d67ee5a05d7",
      "text": "그 소리는 훗날 퉁구스카 대폭발로 불립니다."
    },
    "tg1j": {
      "source_hash": "fa23fedf8d43",
      "text": "그날 밤부터, 시베리아에서 유럽까지 밤하늘이 며칠 밤 밝았습니다."
    },
    "tg1o": {
      "source_hash": "77556afc7898",
      "text": "이상한 점은 또 있습니다."
    },
    "tg1p": {
      "source_hash": "e862b6efc352",
      "text": "1927년, 누군가 쓰러진 나무를 따라 중심의 크레이터를 찾습니다."
    },
    "tg1q": {
      "source_hash": "eb88182d9ebd",
      "text": "늪의 둥근 구덩이 물을 빼자, 그 밑엔 무엇이?"
    },
    "tg1r": {
      "source_hash": "57e3d0876ae5",
      "text": "1946년, 그 폭발을 그린 소설."
    },
    "tg1s": {
      "source_hash": "dc8d457a3bee",
      "text": "2025년, 누군가 최다 인용된 숫자를 쫓습니다."
    },
    "tg1n": {
      "source_hash": "4143cb36023a",
      "text": "그날 아침 떨어진 건 대체 어디에?"
    },
    "tg2a": {
      "source_hash": "0574e905f222",
      "text": "밝은 밤들이 지나자, 시베리아 지방지가 이 일을 보도했습니다."
    },
    "tg2b": {
      "source_hash": "05dcae3f7b4a",
      "text": "신문이 나온 건 7월 12일, 그 아침의 12일 뒤."
    },
    "tg2c": {
      "source_hash": "b024b61ec221",
      "text": "당시 러시아의 구력으로 그 아침은 6월 17일."
    },
    "tg2d": {
      "source_hash": "ac1aa865814f",
      "text": "이르쿠츠크 관측소가 먼저,"
    },
    "tg2e": {
      "source_hash": "048a443ac854",
      "text": "당일 각지 통신원의 목격담을 모읍니다."
    },
    "tg2f": {
      "source_hash": "53f98e138b40",
      "text": "'19년간 아무도 몰랐다'는 틀립니다."
    },
    "tg2j": {
      "source_hash": "c167bb5c69a5",
      "text": "가까운 텐트는 흔들렸다는 증언도."
    },
    "tg2k": {
      "source_hash": "e20b1eeb5501",
      "text": "에벤키인은 처음엔 외부인과 말을 꺼렸고,"
    },
    "tg2l": {
      "source_hash": "9bafa23ded2b",
      "text": "신 오그디가 강림했다고 여겼습니다."
    },
    "tg2m": {
      "source_hash": "ce81bfe630c4",
      "text": "소식은 있었는데 왜 안 갔을까요?"
    },
    "tg2n": {
      "source_hash": "8dfa15e7ceec",
      "text": "13년을 기다립니다."
    },
    "tg2o": {
      "source_hash": "a21e7ea561f6",
      "text": "1921년 소련 과학원이 지질학자를 보냅니다."
    },
    "tg2p": {
      "source_hash": "5e17a028c7db",
      "text": "이름은 쿨리크, 1883년 8월 19일생입니다."
    },
    "tg2q": {
      "source_hash": "3871ecaaa959",
      "text": "철운석이 있다고 믿고,"
    },
    "tg2r": {
      "source_hash": "eb993075da38",
      "text": "닿으면 캐낼 수 있다 봤습니다."
    },
    "tg2s": {
      "source_hash": "1e1b7aad8108",
      "text": "아무도 안 간 이유 하나: 아예 들어갈 수 없는 땅."
    },
    "tg2t": {
      "source_hash": "b51f8c27f74f",
      "text": "그해와 이듬해, 그는 칸스크까지만 갔습니다."
    },
    "tg2u": {
      "source_hash": "7f5215b36638",
      "text": "현장까진 아직 600킬로"
    },
    "tg2w": {
      "source_hash": "ccb01044cadb",
      "text": "돌아와도 포기 않고,"
    },
    "tg2x": {
      "source_hash": "09fbc1bb9877",
      "text": "6년 뒤 다시 떠납니다."
    },
    "tg3a": {
      "source_hash": "26ad46820a92",
      "text": "첫머리의 1927년 여정, 마침내 도착합니다."
    },
    "tg3b": {
      "source_hash": "731454dc4ae8",
      "text": "처음 본 것은 쓰러진 나무들."
    },
    "tg3c": {
      "source_hash": "c5196b60da42",
      "text": "가지런히,"
    },
    "tg3d": {
      "source_hash": "886d9a07b62c",
      "text": "바퀴살처럼 전부 바깥을 향해 누웠습니다."
    },
    "tg3e": {
      "source_hash": "5466f7cb5085",
      "text": "그 줄을 따라 안으로 가면 중심입니다."
    },
    "tg3g": {
      "source_hash": "6dc9f96026d0",
      "text": "나중에 잰 범위는 약 2,150제곱킬로미터."
    },
    "tg3h": {
      "source_hash": "14f77e2c949a",
      "text": "게다가 원이 아니라 나비 모양이었습니다."
    },
    "tg3i": {
      "source_hash": "1bdee7d475de",
      "text": "하지만 더 이상한 게 있습니다."
    },
    "tg3j": {
      "source_hash": "3493ec732c93",
      "text": "한가운데의 나무는 아직 서 있었습니다."
    },
    "tg3k": {
      "source_hash": "800f8ace9ba6",
      "text": "가지와 잎은 뜯기고 껍질도 없습니다."
    },
    "tg3l": {
      "source_hash": "c47c9366132b",
      "text": "하나하나 서 있는 모습이 전신주 줄 같았습니다."
    },
    "tg3m": {
      "source_hash": "b7aa9c102b36",
      "text": "고사목을 그는 전신주 숲이라 불렀습니다."
    },
    "tg3n": {
      "source_hash": "91839ffa1681",
      "text": "불탄 흔적도 있었습니다."
    },
    "tg3o": {
      "source_hash": "c26da748d539",
      "text": "찾던 크레이터는 없습니다."
    },
    "tg3p": {
      "source_hash": "f598264d22ed",
      "text": "한가운데는 늪이었습니다."
    },
    "tg3q": {
      "source_hash": "956c02592534",
      "text": "중심만이 아니라, 지금껏 1만 5,000제곱킬로미터 안에 없습니다."
    },
    "tg3v": {
      "source_hash": "5a974699a0b5",
      "text": "퉁구스카 검색 시 흔한 숫자, 쓰러진 나무 8천만 그루."
    },
    "tg3w": {
      "source_hash": "ca79500e4ec3",
      "text": "이 숫자의 출처는 잠시 후에."
    },
    "tg3x": {
      "source_hash": "3e34cab6e971",
      "text": "그럼 이 숲을 쓰러뜨린 그것은 대체 어디로 갔을까요?"
    },
    "tg4a": {
      "source_hash": "df78c932f9ea",
      "text": "쿨리크의 답: 아직 땅속에 있다."
    },
    "tg4b": {
      "source_hash": "1f0d5f8e2ed1",
      "text": "늪 밑이 큰 크레이터라 여겼고,"
    },
    "tg4c": {
      "source_hash": "9999f2420e72",
      "text": "늪엔 둥근 구덩이가 여럿."
    },
    "tg4d": {
      "source_hash": "2d029e3f1e3b",
      "text": "작은 운석구덩이로 봤습니다."
    },
    "tg4e": {
      "source_hash": "c086a9374ce3",
      "text": "그중 하나가 수슬로프 구덩이."
    },
    "tg4f": {
      "source_hash": "20c5b52df7a5",
      "text": "첫머리 구덩이 물을 빼기로 합니다."
    },
    "tg4g": {
      "source_hash": "354191cbbb1f",
      "text": "사람과 장비가 모두 늪으로."
    },
    "tg4h": {
      "source_hash": "f7d221a0454a",
      "text": "물이 조금씩 빠집니다."
    },
    "tg4i": {
      "source_hash": "aa399c9908b0",
      "text": "그 구덩이 밑에서 드러난 건 철이 아니었습니다."
    },
    "tg4j": {
      "source_hash": "1e04b47254d1",
      "text": "오래된 그루터기."
    },
    "tg4l": {
      "source_hash": "cff000a6151d",
      "text": "읽기 제일 힘든 대목,"
    },
    "tg4m": {
      "source_hash": "8d7056375664",
      "text": "선 곳은 맞고 생각이 틀렸습니다."
    },
    "tg4o": {
      "source_hash": "0ff05fc19c0c",
      "text": "이후 3년, 주로 철 조각을 찾습니다."
    },
    "tg4p": {
      "source_hash": "9671d8d8f58e",
      "text": "하나도 없었고, 큰 조각은 지금도 못 찾았습니다."
    },
    "tg4q": {
      "source_hash": "f7f521c135a9",
      "text": "미세한 알갱이는 나왔지만,"
    },
    "tg4r": {
      "source_hash": "b367c9e6adf2",
      "text": "폭발과 관련됐는지는 알 수 없습니다."
    },
    "tg4s": {
      "source_hash": "be684bcf2be9",
      "text": "늪에서 멀지 않은 곳에 체코 호수도 있습니다."
    },
    "tg4t": {
      "source_hash": "715a42d907f5",
      "text": "훨씬 뒤에야 단서가 됩니다. 나중에 다시."
    },
    "tg2h": {
      "source_hash": "3233ed187174",
      "text": "지진·기압 기록도 오래 기다렸습니다."
    },
    "tg2i": {
      "source_hash": "1275593a451b",
      "text": "1925년과 1930년에야 그 아침과 연결됩니다."
    },
    "tg4u": {
      "source_hash": "e39c2a96ae8d",
      "text": "그가 팔 때, 남들은 벌써 하늘을 살폈습니다."
    },
    "tg4v": {
      "source_hash": "6eae5458b579",
      "text": "1930년, 누군가 혜성설을 제기합니다."
    },
    "tg4w": {
      "source_hash": "34516425dc5a",
      "text": "혜성설의 근거는 그 후의 밝은 밤."
    },
    "tg4ad": {
      "source_hash": "5ecb556db7a9",
      "text": "이 설에 따르면, 빛은 혜성 꼬리에서 흩어진 먼지."
    },
    "tg4x": {
      "source_hash": "7b3b66d10d05",
      "text": "지금도 남은 설."
    },
    "tg4y": {
      "source_hash": "f824919fddd5",
      "text": "최초 주장자는 두 자료가 다릅니다."
    },
    "tg4z": {
      "source_hash": "8fa6deb6d8b4",
      "text": "쿨리크는 답을 보지 못했습니다."
    },
    "tg4aa": {
      "source_hash": "17cf2bf7d524",
      "text": "1941년 전쟁이 터지자 그는 민병대에 들어갔습니다."
    },
    "tg4ab": {
      "source_hash": "328c0ec05efd",
      "text": "다치고 포로가 되어 1942년 4월 14일 숨졌습니다."
    },
    "tg4ac": {
      "source_hash": "a79f5dc04673",
      "text": "출발부터 죽음까지, 이 일에 21년을 바쳤습니다."
    },
    "tg5a": {
      "source_hash": "145c17c760ef",
      "text": "그가 죽고 4년 뒤 이야기가 바뀝니다."
    },
    "tg5b": {
      "source_hash": "a364be1ac393",
      "text": "1946년, 소련 잡지에 소설 한 편이 실립니다."
    },
    "tg5c": {
      "source_hash": "6b4534f143b5",
      "text": "첫머리의 그 소설에서, 폭발은 외계 핵추진 우주선 때문입니다."
    },
    "tg5d": {
      "source_hash": "9b13491f2331",
      "text": "히로시마 이후."
    },
    "tg5e": {
      "source_hash": "10dfc50d7498",
      "text": "기록 아닌 소설입니다."
    },
    "tg5f": {
      "source_hash": "64c7d3334ff0",
      "text": "한 연구자에 따르면,"
    },
    "tg5g": {
      "source_hash": "8afafd412b78",
      "text": "공중 폭발로 크레이터 부재를 처음 설명한 게 이 소설입니다."
    },
    "tg5h": {
      "source_hash": "299120a31b6e",
      "text": "1950년대 말엔 민간 탐사대까지 꾸려졌습니다."
    },
    "tg5i": {
      "source_hash": "78a27af8638b",
      "text": "더 기이한 건 이제부터"
    },
    "tg5j": {
      "source_hash": "f9088f3b1bdb",
      "text": "1965년, 누군가 반물질설을 냅니다."
    },
    "tg5k": {
      "source_hash": "77b8bd54e659",
      "text": "1973년엔 작은 블랙홀설이 나옵니다."
    },
    "tg5l": {
      "source_hash": "a928230f4804",
      "text": "둘 다 같은 학술지."
    },
    "tg5m": {
      "source_hash": "130217cd4f12",
      "text": "블랙홀설은 이듬해 다른 논문이 반박."
    },
    "tg5n": {
      "source_hash": "83781e384d4f",
      "text": "그 연구자는 단호히,"
    },
    "tg5o": {
      "source_hash": "46b9e49e3049",
      "text": "기술적으로 성립 안 된다고."
    },
    "tg5p": {
      "source_hash": "158ce7f36f73",
      "text": "테슬라 살인 광선설은 냉전 종식 뒤에야 나왔습니다."
    },
    "tg5q": {
      "source_hash": "65e4a525cad1",
      "text": "익숙한 이야기입니다"
    },
    "tg5r": {
      "source_hash": "e70975354ade",
      "text": "하지만 가장 많이 인용된 숫자가 더 문제입니다."
    },
    "tg6b": {
      "source_hash": "196ae13961c1",
      "text": "2025년 한 학술 논평이 출처를 쫓습니다."
    },
    "tg6c": {
      "source_hash": "ae1618ede240",
      "text": "그들은 1933년까지 거슬러 갔습니다."
    },
    "tg6d": {
      "source_hash": "e33708f6a2ff",
      "text": "그해 누가 위력을 추정,"
    },
    "tg6e": {
      "source_hash": "98ef2696039f",
      "text": "그러려면 쓰러진 숲의 면적부터."
    },
    "tg6f": {
      "source_hash": "8c2d43ffa3db",
      "text": "약 8,000제곱킬로미터로 가정했고,"
    },
    "tg6g": {
      "source_hash": "81d60efe9d73",
      "text": "거기서 그루 수를 냈습니다."
    },
    "tg6h": {
      "source_hash": "c6b70dc81403",
      "text": "첫머리의 그 추적이 찾은 것: 그 면적이 틀렸다."
    },
    "tg6i": {
      "source_hash": "1145fb0c185b",
      "text": "실제로 잰 범위는 가정의 약 4분의 1뿐입니다."
    },
    "tg6k": {
      "source_hash": "e537f62688d7",
      "text": "그러니 8천만 그루는 처음부터 과대평가."
    },
    "tg6l": {
      "source_hash": "171c9894ba2a",
      "text": "더 큰 문제는 그다음."
    },
    "tg6m": {
      "source_hash": "7b9c50ace1f8",
      "text": "숫자는 논문마다 베껴졌습니다."
    },
    "tg6p": {
      "source_hash": "f703a3930e7e",
      "text": "1934년 두 글이 인용했고,"
    },
    "tg6q": {
      "source_hash": "361435fd2c91",
      "text": "하나가 인용한 건 통신원의 말,"
    },
    "tg6r": {
      "source_hash": "eb4f2be658d9",
      "text": "저자가 아니라."
    },
    "tg6s": {
      "source_hash": "f8eb5b03cb0c",
      "text": "1982년 또 베낍니다."
    },
    "tg6t": {
      "source_hash": "a179d42e26ed",
      "text": "결국 출처가 필요 없는 사실처럼 취급됩니다."
    },
    "tg6u": {
      "source_hash": "e9f458236e30",
      "text": "90여 년이 지나도 영상과 글에 나옵니다."
    },
    "tg6v": {
      "source_hash": "c76f01cc346d",
      "text": "사실로 안 칩니다"
    },
    "tg6w": {
      "source_hash": "0fdcaa2c7718",
      "text": "기록이 받쳐 주는 건 면적뿐."
    },
    "tg6x": {
      "source_hash": "200def33c901",
      "text": "그럼 아까 나비 모양은 무엇이 만들었을까요?"
    },
    "tg7a": {
      "source_hash": "7839cc6ae4f2",
      "text": "그 모양을 만든 건 수십 미터 크기 천체입니다."
    },
    "tg7b": {
      "source_hash": "27e529ddbde6",
      "text": "첫머리 질문의 답: 대기로 돌진해 공중에서 터졌습니다."
    },
    "tg7c": {
      "source_hash": "3fcc171001b6",
      "text": "주류 추정은 고도 5에서 10킬로."
    },
    "tg7e": {
      "source_hash": "c1cae60d564d",
      "text": "2019년 시뮬레이션은 10에서 14킬로미터."
    },
    "tg7f": {
      "source_hash": "ed9468b46abc",
      "text": "충격파가 아래로, 바깥으로 밀어냅니다."
    },
    "tg7g": {
      "source_hash": "08ccfc6579a6",
      "text": "밖으로 누운 나무는 이렇게 쓰러졌습니다."
    },
    "tg7h": {
      "source_hash": "8e5a7dff9bee",
      "text": "본체는 거의 다 기화."
    },
    "tg7i": {
      "source_hash": "2a1374f4377b",
      "text": "그래서 쿨리크가 찾던 크레이터는 아예 안 생겼습니다."
    },
    "tg7k": {
      "source_hash": "5e5cc2d56f15",
      "text": "TNT로 300만 톤에서 3000만 톤까지 추산됩니다."
    },
    "tg7l": {
      "source_hash": "7cd436d32b45",
      "text": "낮게 잡는 시뮬레이션도 있고 아직 결론이 없습니다."
    },
    "tg7m": {
      "source_hash": "931bbda7016b",
      "text": "체코 호수는요?"
    },
    "tg7n": {
      "source_hash": "0759779131f1",
      "text": "2007년 한 팀: 호수 바닥이 크레이터 같다."
    },
    "tg7o": {
      "source_hash": "b66127ca1b34",
      "text": "2008년 다른 팀: 가능성 희박."
    },
    "tg7p": {
      "source_hash": "ed4baf34f16a",
      "text": "2017년 연구: 퇴적층은 폭발 이전."
    },
    "tg7q": {
      "source_hash": "2dca9417eda3",
      "text": "호수 바닥은 결론이 없고, 폭발로 숨진 사람은?"
    },
    "tg7s": {
      "source_hash": "3cf648b13a0c",
      "text": "2019년 논문: 쓰러진 숲 안팎 최소 30명"
    },
    "tg7t": {
      "source_hash": "16f7b4393813",
      "text": "그로 인해 최소 3명 사망."
    },
    "tg7u": {
      "source_hash": "e4cb18a3e0dd",
      "text": "미확인 보고 2건뿐이라는 자료도."
    },
    "tg7r": {
      "source_hash": "1b2387a714e1",
      "text": "사망 여부도 결론이 없습니다."
    },
    "tg7v": {
      "source_hash": "108c2223290f",
      "text": "석질 소행성인지 혜성 조각인지, 아직 논쟁 중입니다."
    },
    "tg7z": {
      "source_hash": "c5b9ce728cbd",
      "text": "2013년 2월 15일, 첼랴빈스크 상공."
    },
    "tg7aa": {
      "source_hash": "fae414fdbd0c",
      "text": "많은 이가 보고, 찍었습니다."
    },
    "tg7ac": {
      "source_hash": "f40cdf68c72b",
      "text": "그 아침부터 지금까지 118년."
    },
    "tg7ad": {
      "source_hash": "d6d5794b3a06",
      "text": "이 파일은 미결입니다."
    },
    "tg7ae": {
      "source_hash": "f428c8a16326",
      "text": "퉁구스카를 처음 들은 곳은?"
    },
    "tg7af": {
      "source_hash": "39b488d05f27",
      "text": "기록에 있는 것만 다룹니다. 함께 파일을 열려면 구독을."
    }
  }
}
