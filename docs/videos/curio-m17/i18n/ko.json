    "thumbnail": "2fcb8fc472e9"
  },
  "lines": {
    "l001": {
      "source_hash": "dccf6e354c79",
      "text": "땀 나는 여름엔 6월에 눈 오길 바라죠?"
    },
    "l002": {
      "source_hash": "057d18ecd265",
      "text": "1816년 6월 북동부에 사흘 폭설,"
    },
    "l003": {
      "source_hash": "762b5673d574",
      "text": "2주여 뒤 화씨 101도로 급등!"
    },
    "l004": {
      "source_hash": "aee91139ad7c",
      "text": "그달 제네바엔 폭우가 쏟아져,"
    },
    "l005": {
      "source_hash": "f4a6cf4ab2d0",
      "text": "18세 영국 소녀가 갇혀 프랑켄슈타인 착수"
    },
    "l006": {
      "source_hash": "bf6f354b51d0",
      "text": "한 해 전 인도네시아 화산이"
    },
    "l007": {
      "source_hash": "980bacc37c7d",
      "text": "굉음 속 정상이 무너졌죠."
    },
    "l008": {
      "source_hash": "a9bfcf735934",
      "text": "당시엔 아무도 화산을 몰랐거든요."
    },
    "l009": {
      "source_hash": "49bc19f8e83c",
      "text": "거의 백 년 뒤에야 둘을 이었죠."
    },
    "l010": {
      "source_hash": "abe55461dc91",
      "text": "끊긴 선을 누가 이었죠?"
    },
    "l011": {
      "source_hash": "3056e9573d3a",
      "text": "솔직히 저도 자료 보고 놀랐죠."
    },
    "l012": {
      "source_hash": "e12304c22f77",
      "text": "화산이 낳은 소설이라지만"
    },
    "l013": {
      "source_hash": "3c98931731d0",
      "text": "기후 모델과 서문을 대조하면 답이 달라요."
    },
    "l014": {
      "source_hash": "018b3b19a878",
      "text": "오늘 이 여름 없던 해에, 뭐가 화산 탓이고 뭐가 덧붙인 얘긴지 볼까요?"
    },
    "l015": {
      "source_hash": "26836ec1d716",
      "text": "1815년 4월 5일 인도네시아"
    },
    "l016": {
      "source_hash": "99059a0b6032",
      "text": "자바와 마카사르에 오후 내내 굉음이 울렸죠."
    },
    "l017": {
      "source_hash": "e4fd62abd515",
      "text": "포성 같아 군과 배를 내보냈지만,"
    },
    "l018": {
      "source_hash": "37109e07dfe6",
      "text": "바다엔 적선이 없었죠—무슨 소리였을까요?"
    },
    "l019": {
      "source_hash": "4c3be0dadb74",
      "text": "수백 킬로 밖 포성이 산인 줄 알까요?"
    },
    "l020": {
      "source_hash": "68ffd7b4b209",
      "text": "부총독 래플스가 보고를 모았죠."
    },
    "l021": {
      "source_hash": "4991a9b64de8",
      "text": "4월 10일 밤 일곱 시 숨바와섬 상가르 왕이"
    },
    "l022": {
      "source_hash": "49bac9ffaa31",
      "text": "탐보라에 솟은 세 불기둥을 봤죠."
    },
    "l023": {
      "source_hash": "2c0f8e1a4716",
      "text": "10일에서 11일 폭발은 화산지수 7등급,"
    },
    "l024": {
      "source_hash": "f632f14f2e28",
      "text": "기록상 최대 규모의 화산 분화였죠."
    },
    "l025": {
      "source_hash": "85e5ddccbec8",
      "text": "폭 6, 7킬로 깊이 1킬로 넘게 꺼졌죠."
    },
    "l026": {
      "source_hash": "b9f5a99b85d8",
      "text": "수백 킬로 밖 대낮은 어땠을까요?"
    },
    "l027": {
      "source_hash": "4f0af8491c0b",
      "text": "12일 아침 아홉 시, 자바섬 그레식에선"
    },
    "l028": {
      "source_hash": "ed51b2e3eaf2",
      "text": "대낮인데도 화산재에 가려 앞이 안 보였죠."
    },
    "l029": {
      "source_hash": "58574868d731",
      "text": "오언 필립스는 주민 만여 명이라"
    },
    "l030": {
      "source_hash": "d9da4c8d28cb",
      "text": "수천 명 즉사, 기근과 역병에 수만 사망"
    },
    "l031": {
      "source_hash": "22e899367fd0",
      "text": "5만 6천, 7만 1천, 8만 8천 등"
    },
    "l032": {
      "source_hash": "2bf5506fbbfe",
      "text": "집계가 안 돼 범위만 남았어요."
    },
    "l033": {
      "source_hash": "d28556510019",
      "text": "화산재는 며칠이면 떨어지는데,"
    },
    "l034": {
      "source_hash": "5f0509c54155",
      "text": "재가 가린 게 아녔죠"
    },
    "l035": {
      "source_hash": "c2679ccfc86e",
      "text": "상공의 범인은요?"
    },
    "l036": {
      "source_hash": "4bb93ffb2e1f",
      "text": "바로 유황이죠"
    },
    "l037": {
      "source_hash": "691117c5bd5e",
      "text": "오펜하이머는 황 6천만 톤이 솟아"
    },
    "l038": {
      "source_hash": "7a90e593d991",
      "text": "91년 피나투보의 6배죠."
    },
    "l039": {
      "source_hash": "5810334986e5",
      "text": "황이 황산염 에어로졸로 지구를 감싸,"
    },
    "l040": {
      "source_hash": "3318d2e2343c",
      "text": "얇은 베일처럼 약 3년간 햇빛을 가렸죠."
    },
    "l041": {
      "source_hash": "6b3c7d55d0a7",
      "text": "지구 0.4에서 0.7도 하강 글 보셨죠"
    },
    "l042": {
      "source_hash": "6c7de1c83d0b",
      "text": "사이언스 논문이 잘못 인용됐죠."
    },
    "l043": {
      "source_hash": "7c71a8d4b80a",
      "text": "스토더스는 북반구라 썼는데 와전됐죠."
    },
    "l044": {
      "source_hash": "4a1982450988",
      "text": "그럼 남반구도 추워졌을까요?"
    },
    "l045": {
      "source_hash": "18c60d0f12fa",
      "text": "라이블 복원상, 열대와 북반구는 0.4에서 0.8도 낮았고,"
    },
    "l046": {
      "source_hash": "7744ae39f43d",
      "text": "남반구는 뚜렷지 않죠"
    },
    "l047": {
      "source_hash": "bc2e418a5e8c",
      "text": "남북반구 에어로졸 분배는 아직 수수께끼죠."
    },
    "l048": {
      "source_hash": "e47046caf420",
      "text": "평균 1도 미만이라니 에어컨 한 칸도 안 되죠!"
    },
    "l049": {
      "source_hash": "986327719125",
      "text": "연평균 기온의 함정이죠"
    },
    "l050": {
      "source_hash": "ea9f2327f886",
      "text": "여름 한 철 찬 바람은 농작물을 직격하니까요!"
    },
    "l051": {
      "source_hash": "a09d5645a5f6",
      "text": "첫 타격지는요?"
    },
    "l052": {
      "source_hash": "64d6aa2a75f0",
      "text": "퀘벡과 뉴잉글랜드였죠."
    },
    "l053": {
      "source_hash": "36dd2b68ceb3",
      "text": "볼티모어 나일스지에 6월 6일 눈이 적혔죠."
    },
    "l054": {
      "source_hash": "d251c08eb3ec",
      "text": "퀘벡 사흘 눈, 메인엔 눈보라,"
    },
    "l055": {
      "source_hash": "20732fac7463",
      "text": "버몬트 캐벗엔 18인치 쌓였죠."
    },
    "l056": {
      "source_hash": "01183f2059f7",
      "text": "매사추세츠는 뿌리까지 얼어,"
    },
    "l057": {
      "source_hash": "7bd695b18b61",
      "text": "밭을 갈아엎고 다시 심었죠."
    },
    "l058": {
      "source_hash": "7bc7dfc956b1",
      "text": "내내 얼었을까요? 반소매 두세요"
    },
    "l059": {
      "source_hash": "287eb32bed03",
      "text": "세일럼 의사 홀리오크의 기록엔,"
    },
    "l060": {
      "source_hash": "091dbc275015",
      "text": "22일 화씨 93도"
    },
    "l061": {
      "source_hash": "4393bf89eb87",
      "text": "23일엔 화씨 101도, 섭씨 38도를 넘겼죠!"
    },
    "l062": {
      "source_hash": "15b1b0db7181",
      "text": "이틀 뒤 낮엔 59도로 뚝!"
    },
    "l063": {
      "source_hash": "d75b429fa8ad",
      "text": "냉온탕 같은 롤러코스터였죠."
    },
    "l064": {
      "source_hash": "4cac3e028042",
      "text": "나일스지는 미국 대다수가 가뭄에 시달렸다 했죠."
    },
    "l065": {
      "source_hash": "b6d8f2a4dd94",
      "text": "모종은 가뭄 끝에 서리도 맞았죠"
    },
    "l066": {
      "source_hash": "ca285e4d9531",
      "text": "여름 없던 해는 별명이고"
    },
    "l067": {
      "source_hash": "4d82f8b0ef17",
      "text": "뉴잉글랜드 농가들이 고향을 떠나게 했죠."
    },
    "l068": {
      "source_hash": "c478123d24ef",
      "text": "미국 농부가 비를 기다리던 그 여름,"
    },
    "l069": {
      "source_hash": "12ba6304cbea",
      "text": "제네바 하늘은 수도꼭지가 고장 난 듯했죠."
    },
    "l070": {
      "source_hash": "d53a879024cd",
      "text": "영국 청년들이 이 폭우를 만났죠—무슨 일이?"
    },
    "l071": {
      "source_hash": "8964fb63c948",
      "text": "제네바에 가자마자 괴이한 폭우가!"
    },
    "l072": {
      "source_hash": "1f61b198079d",
      "text": "여름비 80% 폭증, 오후 기온 3.8도 뚝!"
    },
    "l073": {
      "source_hash": "d2bd8849c31d",
      "text": "5월 말 메리 고드윈과 셸리가 호숫가에,"
    },
    "l074": {
      "source_hash": "1c8edc311c08",
      "text": "8분 거린 바이런의 디오다티였죠"
    },
    "l075": {
      "source_hash": "6c1783c01ede",
      "text": "메리는 끝없는 비에 갇혔다며 편지 썼죠"
    },
    "l076": {
      "source_hash": "1a3f6088452d",
      "text": "비 오고 폰도 없는 밤엔 뭘 할까요?"
    },
    "l077": {
      "source_hash": "732803cdb439",
      "text": "장작불 앞에 옹기종기 모여"
    },
    "l078": {
      "source_hash": "a1eb41d63c80",
      "text": "불어판 독일 괴담집을 읽었죠"
    },
    "l079": {
      "source_hash": "d96f9a21ac69",
      "text": "바이런이 각자 괴담을 쓰자고 제안했죠!"
    },
    "l080": {
      "source_hash": "3a49b9bfd21b",
      "text": "바이런, 셸리, 폴리도리, 메리 다 찬성"
    },
    "l081": {
      "source_hash": "b27e44f2f267",
      "text": "16일 일기에 적혔다는데 진짜일까요?"
    },
    "l082": {
      "source_hash": "f1872b2cbc29",
      "text": "학자 마셜은 그해 6월 일기가 유실됐다 했죠!"
    },
    "l083": {
      "source_hash": "84520ab96540",
      "text": "날짜가 남은 건 의사 폴리도리 일기죠."
    },
    "l084": {
      "source_hash": "b170fe0105a2",
      "text": "17일에 나 빼고 다 괴담을 쓰기 시작했댔죠."
    },
    "l085": {
      "source_hash": "0c90a975757a",
      "text": "18일 크리스타벨 낭송에"
    },
    "l086": {
      "source_hash": "2479a648a179",
      "text": "셸리가 비명 후 촛대 들고 뛰쳐나갔죠"
    },
    "l087": {
      "source_hash": "40a0f254efb4",
      "text": "영감이 왔을까요?"
    },
    "l088": {
      "source_hash": "edcaae2868f9",
      "text": "15년 뒤 서문엔 매일 진도를 물어도"
    },
    "l089": {
      "source_hash": "fd7fca8dc31f",
      "text": "답 못 해 창피했댔죠."
    },
    "l090": {
      "source_hash": "76f877e9ae46",
      "text": "의사 일기완 좀 다르지만"
    },
    "l091": {
      "source_hash": "5ba8b4d88562",
      "text": "반전은 어느 깊은 밤이었죠"
    },
    "l092": {
      "source_hash": "cc6b73c8f7bb",
      "text": "그날 밤 거실 대화가 머리를 깨웠죠—무슨 얘기였을까요?"
    },
    "l093": {
      "source_hash": "b27e60f02124",
      "text": "바이런과 셸리가 생명 원리를 논해"
    },
    "l094": {
      "source_hash": "75e6d9a08bdc",
      "text": "전기로 조립한 몸이 움직일지 말했죠"
    },
    "l095": {
      "source_hash": "b1e064d76942",
      "text": "자정 넘어도 잠이 안 왔고"
    },
    "l096": {
      "source_hash": "75386f8d0a03",
      "text": "창백한 학자가 조립한 거구 옆에 무릎 꿇고 있었죠"
    },
    "l097": {
      "source_hash": "416a7a79e5cc",
      "text": "눈 뜨니 덧창 틈에 달빛이 스며"
    },
    "l098": {
      "source_hash": "bdc434c4429e",
      "text": "날 겁준 건 독자도 겁줄 거라 깨달았죠!"
    },
    "l099": {
      "source_hash": "3b62d5f82a24",
      "text": "아침에 구상 끝났다 했죠."
    },
    "l100": {
      "source_hash": "d3d8578c2acb",
      "text": "제네바 호숫가에서 소설을 다 썼다고 들으셨나요?"
    },
    "l101": {
      "source_hash": "e5a81a48bb3d",
      "text": "서문엔 제네바는 시작일 뿐이래요"
    },
    "l102": {
      "source_hash": "5efe074a4532",
      "text": "귀국·결혼 뒤 이듬해 5월 안에 끝냈죠"
    },
    "l103": {
      "source_hash": "d0e76996ebe1",
      "text": "1818년 세 권 초판은 익명이었죠."
    },
    "l104": {
      "source_hash": "2f4d074ebc45",
      "text": "이 무명 책이 공상과학 시조가 됐죠"
    },
    "l105": {
      "source_hash": "aec00d42fd80",
      "text": "7월 바이런도 장시 다크니스를 썼죠—날씨 탓일까요?"
    },
    "l106": {
      "source_hash": "1c2fe3fc59a2",
      "text": "시작은 '꿈을 꿨네, 해가 꺼졌지'"
    },
    "l107": {
      "source_hash": "9497cc1e30c6",
      "text": "1901년 주석엔 문학 전거뿐 날씬 없죠"
    },
    "l108": {
      "source_hash": "97ef86786eb0",
      "text": "기후 기록이란 건 후대의 해석이죠."
    },
    "l109": {
      "source_hash": "923cec7786b6",
      "text": "별장 문인이야 빗속에 괴담을 썼지만,"
    },
    "l110": {
      "source_hash": "dfb008854119",
      "text": "밀이 썩던 유럽 농부들은 웃을 수 없었죠."
    },
    "l111": {
      "source_hash": "ad8ff2aeba84",
      "text": "최악은 그해 여름이 아니었죠,"
    },
    "l112": {
      "source_hash": "9b6b1c9c88bd",
      "text": "이듬해 서민들이 받은 청구서는요?"
    },
    "l113": {
      "source_hash": "b0e7c2924c57",
      "text": "1817년 대기근이 터졌어요!"
    },
    "l114": {
      "source_hash": "32740bf7e422",
      "text": "취리히 기념지엔 6월 곡물값이 최고였죠."
    },
    "l115": {
      "source_hash": "5c2c9d533a83",
      "text": "알자스 농부의 일기에는,"
    },
    "l116": {
      "source_hash": "63189ba8a3cd",
      "text": "감자가 6에서 18, 20프랑으로 3배 뛰었죠."
    },
    "l117": {
      "source_hash": "8b18bcbf4366",
      "text": "봄 전 곳곳의 곳간이 바닥났어요."
    },
    "l118": {
      "source_hash": "4e4e6d908a06",
      "text": "바다 건너 아일랜드는 어땠을까요"
    },
    "l119": {
      "source_hash": "dbb3ed10e0f3",
      "text": "3년 열병에 하티는 80만 감염 추산,"
    },
    "l120": {
      "source_hash": "3a46c7b58e1c",
      "text": "바커 팀은 150만 감염, 6만 5천 사망!"
    },
    "l121": {
      "source_hash": "cb8f9a98305b",
      "text": "의사도 복합 원인을 봤지만"
    },
    "l122": {
      "source_hash": "90ddc260492e",
      "text": "기이한 건 탐보라 폭발 소식이 이미 유럽에 실렸단 거죠!"
    },
    "l123": {
      "source_hash": "4b4d6eb8e897",
      "text": "당시엔 누굴 탓했을까요?"
    },
    "l124": {
      "source_hash": "37960171a54c",
      "text": "화산 몰랐단 말 기억나죠? 보덴만도 연결 기록 못 찾았죠."
    },
    "l125": {
      "source_hash": "2a9db36a43e0",
      "text": "흑점이나 북대서양 유빙을 의심하거나,"
    },
    "l126": {
      "source_hash": "7b0b150cac84",
      "text": "하늘 뜻이라 여겼죠."
    },
    "l127": {
      "source_hash": "1234def93226",
      "text": "제일 억울한 건 지붕 위 피뢰침"
    },
    "l128": {
      "source_hash": "73170214e740",
      "text": "피뢰침이 날씨 망쳐 비 온다 했죠."
    },
    "l129": {
      "source_hash": "28975c9c46e9",
      "text": "구리 침만 누명 썼고 진범은 구름 뒤에 숨어 있었죠."
    },
    "l130": {
      "source_hash": "0b60e08146dd",
      "text": "19세기 말에도 영국 왕립학회는 진실을 스쳤죠—왜 놓쳤을까요?"
    },
    "l131": {
      "source_hash": "5b016565cb51",
      "text": "1888년 그 보고서는"
    },
    "l132": {
      "source_hash": "41de9d227223",
      "text": "5년 전 크라카토아 책인데 오해받죠."
    },
    "l133": {
      "source_hash": "59da0f3f9e62",
      "text": "탐보라를 19번 적었지만,"
    },
    "l134": {
      "source_hash": "fb48ce4b17f4",
      "text": "화산과 노을, 월식뿐이죠"
    },
    "l135": {
      "source_hash": "4d05fd06fa43",
      "text": "냉하 말은 0번"
    },
    "l136": {
      "source_hash": "c5766ccf3710",
      "text": "냉하와 탐보라를 처음 명확히 이은 기록은,"
    },
    "l137": {
      "source_hash": "e0f812879cc7",
      "text": "1913년 8월 미 험프리스 논문!"
    },
    "l138": {
      "source_hash": "39ba6fd03da7",
      "text": "161쪽에 분화 뒤 냉하라 썼죠."
    },
    "l139": {
      "source_hash": "7c67572d88bb",
      "text": "끊긴 선 기억나죠? 98년 걸렸죠."
    },
    "l140": {
      "source_hash": "66dbf6e26937",
      "text": "80년대 차양 연구가 다시 뜨며,"
    },
    "l141": {
      "source_hash": "33e7be103292",
      "text": "아까 사이언스요?"
    },
    "l142": {
      "source_hash": "fa39d0f91bad",
      "text": "이 열풍에 나왔죠."
    },
    "l143": {
      "source_hash": "27007ef57714",
      "text": "1991년 다이 팀이 그린란드, 남극 대조"
    },
    "l144": {
      "source_hash": "9d4cd5ea0daf",
      "text": "만년설이 매년 먼지를 얼려 뒀죠"
    },
    "l145": {
      "source_hash": "bb306d074d0e",
      "text": "빙하에서 탐보라 황산염층이 나왔고"
    },
    "l146": {
      "source_hash": "ef8e7f192348",
      "text": "6년 전 또 다른 미지의 분화도 잡았죠."
    },
    "l147": {
      "source_hash": "4449c8556077",
      "text": "황도 나왔으니 화산이 소설 낳은 게 확실해 보이죠?"
    },
    "l148": {
      "source_hash": "a2677f44fe8c",
      "text": "완벽한 나비효과처럼 들리잖아요!"
    },
    "l149": {
      "source_hash": "26e17e24b8bc",
      "text": "끝이 아니에요"
    },
    "l150": {
      "source_hash": "490ef744efd7",
      "text": "유럽 추위와 비가 누구 몫인진 남았거든요."
    },
    "l151": {
      "source_hash": "70edc242d439",
      "text": "2019년 귀인 모델에 인과 사슬이 갈라졌죠—왜일까요?"
    },
    "l152": {
      "source_hash": "03a36192cab7",
      "text": "슈러 팀이 대기 순환과 화산을 분리해 보니"
    },
    "l153": {
      "source_hash": "cdbbecbda1b2",
      "text": "추위와 비는 별개였어요!"
    },
    "l154": {
      "source_hash": "5893e24a0e0d",
      "text": "순환은 저온의 4분의 1뿐이고,"
    },
    "l155": {
      "source_hash": "59cb69302a74",
      "text": "탐보라를 넣자 냉하 확률 최대 100배!"
    },
    "l156": {
      "source_hash": "a26d8c910a28",
      "text": "비는 반대죠, 순환만으로도 그 비가 내려"
    },
    "l157": {
      "source_hash": "5bfcc4742f3d",
      "text": "화산 더해도 1.5에서 3배뿐이죠."
    },
    "l158": {
      "source_hash": "47050078c561",
      "text": "제네바 호숫가 집 기억나시죠?"
    },
    "l159": {
      "source_hash": "808464a903ac",
      "text": "괴담 쓰게 가둔 건 바로 그 비였어요!"
    },
    "l160": {
      "source_hash": "f6ac08d6ed5d",
      "text": "두 서문과 스위스 기행문에도,"
    },
    "l161": {
      "source_hash": "40d7af14cdd4",
      "text": "화산은 0번, 산사태만 있죠—왜 와전됐을까요?"
    },
    "l162": {
      "source_hash": "d3eef4392ffa",
      "text": "원전을 안 봐서죠."
    },
    "l163": {
      "source_hash": "c4c5aa50ad71",
      "text": "2023년 의학 논문은 화산을 필리핀으로 옮겨 적었죠!"
    },
    "l164": {
      "source_hash": "a73ffe9e4a93",
      "text": "나라도 틀리니 화산 소설설도 정설처럼 굳었죠."
    },
    "l165": {
      "source_hash": "7a63f814883f",
      "text": "기록 속 진짜 경계가 더 재밌죠"
    },
    "l166": {
      "source_hash": "5127a5932407",
      "text": "화산 몫 질문 기억나시죠?"
    },
    "l167": {
      "source_hash": "b1eb2b68ad3a",
      "text": "북반구 저온과 냉하 급증은 탐보라 황 안개 몫이지만,"
    },
    "l168": {
      "source_hash": "8aada6dc11f4",
      "text": "별장의 비와 소설은 순환만으로도 가능했죠."
    },
    "l169": {
      "source_hash": "75913ce6d6b2",
      "text": "괴물은 찬비와 달빛이 낳았어요."
    },
    "l170": {
      "source_hash": "992d89c621fb",
      "text": "화산 괴담을 들었거나, 괴이한 날씨 겪으셨다면 댓글 주세요."
    },
    "l171": {
      "source_hash": "e67bccdbc3fe",
      "text": "확인된 기록만 탈탈 파헤칩니다,"
    },
    "l172": {
      "source_hash": "a46e5045872f",
      "text": "끝까지 파헤치는 게 좋다면 구독! 오늘 기록 끝!"
    }
  }
}
