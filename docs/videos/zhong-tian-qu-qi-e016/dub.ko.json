{
  "zq16a01": "안 팔아.",
  "zq16a02": "안 판다고?",
  "zq16a03": "그럼 종이가 마을에서 썩겠지.",
  "zq16a04": "다린 막혀도,",
  "zq16a05": "개울은 안 막혔지.",
  "zq16a06": "나리,",
  "zq16a07": "다린 가지세요.",
  "zq16a08": "꽉 잡아,",
  "zq16a09": "앞에 여울이야.",
  "zq16a10": "날 새기 전에 도착해?",
  "zq16a11": "소용없어,",
  "zq16a12": "책방이 안 받아.",
  "zq16a13": "아니!",
  "zq16a14": "선비한테!",
  "zq16a15": "도련님들,",
  "zq16a16": "즉석 비교해요!",
  "zq16a17": "같은 붓,",
  "zq16a18": "같은 먹.",
  "zq16a19": "안 번져.",
  "zq16a20": "줄 서요,",
  "zq16a21": "한 분당 열 장!",
  "zq16a22": "종이 입성,",
  "zq16a23": "삼백 장 판매.",
  "zq16a24": "조합 공고문은,",
  "zq16a25": "걸레로 딱이네.",
  "zq16a26": "오늘 밤…",
  "zq16a27": "저기,",
  "zq16a28": "누구 수레야?",
  "zq16a29": "위지의…",
  "zq16a30": "쑨 장궤.",
  "zq16a31": "무슨 냄새지?",
  "zq16a32": "연기다—",
  "zq16a33": "쉬 수재—",
  "zq16a34": "공방에 불났어!",
  "zq16a35": "안에 사람 있어?"
}
