{
  "zq16a01": "Nggak dijual.",
  "zq16a02": "Nggak dijual?",
  "zq16a03": "Ya udah, biar kertasnya busuk di desa.",
  "zq16a04": "Jembatan ditutup,",
  "zq16a05": "sungainya nggak.",
  "zq16a06": "Tuan San,",
  "zq16a07": "simpan jembatanmu.",
  "zq16a08": {
    "text": "Pegangan,",
    "say": "Pegang,"
  },
  "zq16a09": "di depan ada jeram.",
  "zq16a10": "Sebelum subuh bisa sampai?",
  "zq16a11": {
    "text": "Sampai pun percuma,",
    "say": "Percuma juga,"
  },
  "zq16a12": {
    "text": "toko buku nggak mau beli.",
    "say": "toko nggak mau."
  },
  "zq16a13": {
    "text": "Siapa bilang jual ke toko buku?",
    "say": "Siapa bilang ke toko?"
  },
  "zq16a14": {
    "text": "Jual ke pelajar!",
    "say": "Ke pelajar!"
  },
  "zq16a15": {
    "text": "Para tuan muda,",
    "say": "Tuan-tuan,"
  },
  "zq16a16": {
    "text": "satu lembar, bandingkan langsung!",
    "say": "adu kertasnya di sini!"
  },
  "zq16a17": {
    "text": "Kuas yang sama,",
    "say": "Kuas ini,"
  },
  "zq16a18": {
    "text": "setetes tinta yang sama.",
    "say": "tinta ini."
  },
  "zq16a19": {
    "text": "Tintanya nggak merembes.",
    "say": "Nggak merembes."
  },
  "zq16a20": "Ayo antre,",
  "zq16a21": "seorang sepuluh lembar!",
  "zq16a22": {
    "text": "Kertas masuk kota:",
    "say": "Di kota,"
  },
  "zq16a23": {
    "text": "terjual tiga ratus lembar.",
    "say": "laku tiga ratus."
  },
  "zq16a24": {
    "text": "Pengumuman serikat itu,",
    "say": "Pengumuman itu,"
  },
  "zq16a25": "pas buat lap meja.",
  "zq16a26": "Nanti malam.",
  "zq16a27": "Xiaotang,",
  "zq16a28": "kereta siapa itu?",
  "zq16a29": "Toko Wei…",
  "zq16a30": "Juragan Sun.",
  "zq16a31": "Bau apa ini?",
  "zq16a32": "Asap—",
  "zq16a33": "Sarjana Xu—",
  "zq16a34": "Pabrik kertas kebakaran!",
  "zq16a35": "Masih ada orang di dalam?"
}
