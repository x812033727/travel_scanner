{
  "zq16a01": "Não vendo.",
  "zq16a02": "Não vende?",
  "zq16a03": "Então o papel apodrece na vila.",
  "zq16a04": "Sem ponte,",
  "zq16a05": "tem o riacho.",
  "zq16a06": "Ah,",
  "zq16a07": "seu Lai, fica com a ponte.",
  "zq16a08": "Segura,",
  "zq16a09": "vem corredeira.",
  "zq16a10": "Chegamos antes do sol?",
  "zq16a11": {
    "text": "Chegar não adianta,",
    "say": "Nem adianta,"
  },
  "zq16a12": "loja não quer.",
  "zq16a13": "Quem disse loja?",
  "zq16a14": "Pros estudantes!",
  "zq16a15": "Moços,",
  "zq16a16": "Comparem na hora!",
  "zq16a17": "Um pincel,",
  "zq16a18": "uma gota de tinta.",
  "zq16a19": "Não borra.",
  "zq16a20": "Façam fila,",
  "zq16a21": "dez por pessoa!",
  "zq16a22": {
    "text": "Papel branco na cidade:",
    "say": "Na cidade:"
  },
  "zq16a23": {
    "text": "trezentas folhas vendidas.",
    "say": "trezentas vendidas."
  },
  "zq16a24": "O aviso da guilda?",
  "zq16a25": "Bom pra limpar mesa.",
  "zq16a26": "Hoje à noite…",
  "zq16a27": {
    "text": "Xiaotang,",
    "say": "Ei,"
  },
  "zq16a28": {
    "text": "De quem é aquela carruagem?",
    "say": "De quem é?"
  },
  "zq16a29": {
    "text": "É da Wei & Cia.…",
    "say": "Do Wei…"
  },
  "zq16a30": "Gerente Sun.",
  "zq16a31": "Cheiro de quê?",
  "zq16a32": "É fumaça—",
  "zq16a33": "Letrado—",
  "zq16a34": {
    "text": "A oficina pegou fogo!",
    "say": "Fogo na oficina!"
  },
  "zq16a35": "Tem alguém lá dentro?"
