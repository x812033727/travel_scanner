{
  "zq16a01": "断る。",
  "zq16a02": "売らない？",
  "zq16a03": "なら紙は村で腐るだけだ。",
  "zq16a04": "橋は封鎖、",
  "zq16a05": "川は開いてる。",
  "zq16a06": "ライさん、",
  "zq16a07": "橋はくれてやる。",
  "zq16a08": "揺れるよ、",
  "zq16a09": "瀬がある。",
  "zq16a10": "夜明けまでに着く？",
  "zq16a11": "無駄だ",
  "zq16a12": "書坊が買わない。",
  "zq16a13": "書坊は違う",
  "zq16a14": "書生に売るの！",
  "zq16a15": "皆さま、",
  "zq16a16": "紙を比べてみて！",
  "zq16a17": "この筆",
  "zq16a18": "同じ墨。",
  "zq16a19": "滲まない。",
  "zq16a20": "並んで、",
  "zq16a21": "お一人十枚！",
  "zq16a22": "紙は町へ。",
  "zq16a23": "三百、売却。",
  "zq16a24": "組合の貼り紙、",
  "zq16a25": "雑巾にいいわ。",
  "zq16a26": "今夜……",
  "zq16a27": "なあ、",
  "zq16a28": "誰の車？",
  "zq16a29": "ウェイ記の……",
  "zq16a30": "スン店主。",
  "zq16a31": "何の匂い？",
  "zq16a32": "煙だ——",
  "zq16a33": "シュー秀才——",
  "zq16a34": "工房が燃えてる！",
  "zq16a35": "中に人は？"
}
