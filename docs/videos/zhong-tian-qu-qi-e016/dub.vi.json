{
  "zq16a01": "Không bán.",
  "zq16a02": "Không bán?",
  "zq16a03": "Vậy cứ chờ giấy mục trong thôn đi.",
  "zq16a04": "Cầu bị chặn,",
  "zq16a05": "suối thì không.",
  "zq16a06": "Tam gia,",
  "zq16a07": "cầu, ngươi cứ giữ.",
  "zq16a08": "Ngồi vững,",
  "zq16a09": "phía trước có ghềnh.",
  "zq16a10": "Sáng ra có tới kịp không?",
  "zq16a11": "Tới cũng uổng,",
  "zq16a12": "thư phường chẳng nhận.",
  "zq16a13": {
    "text": "Ai nói bán cho thư phường?",
    "say": "Ai bán cho họ?"
  },
  "zq16a14": "Bán cho thư sinh!",
  "zq16a15": {
    "text": "Chư vị công tử,",
    "say": "Chư vị,"
  },
  "zq16a16": "so giấy ngay tại chỗ!",
  "zq16a17": "Cùng cây bút,",
  "zq16a18": "cùng một giọt mực.",
  "zq16a19": "Không nhòe.",
  "zq16a20": "Xếp hàng,",
  "zq16a21": "Một người mười tờ!",
  "zq16a22": "Giấy vào thành:",
  "zq16a23": "bán ba trăm tờ.",
  "zq16a24": "Tờ cáo thị của hội,",
  "zq16a25": "lau bàn vừa khéo.",
  "zq16a26": "Đêm nay…",
  "zq16a27": {
    "text": "Tiểu Đường,",
    "say": "Này,"
  },
  "zq16a28": "xe đó của ai?",
  "zq16a29": "Của Ngụy Ký…",
  "zq16a30": "Tôn chưởng quỹ.",
  "zq16a31": "Mùi gì thế?",
  "zq16a32": "Là khói—",
  "zq16a33": "Hứa tú tài—",
  "zq16a34": "Xưởng giấy cháy rồi!",
  "zq16a35": "Bên trong còn ai không?"
}
