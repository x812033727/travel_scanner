{
  "zq21a01": "비켜,",
  "zq21a02": "촌놈.",
  "zq21a03": "여긴 내 집인데,",
  "zq21a04": "어디로?",
  "zq21a05": "네가 어떻게…",
  "zq21a06": "여길 찾았어?",
  "zq21a07": "반년이나 도망쳐서,",
  "zq21a08": "이런 허름한 가게에?",
  "zq21a09": "탕완진 친필,",
  "zq21a10": "네 아버지 서명.",
  "zq21a11": "그건 너희가",
  "zq21a12": "강요한 거잖아!",
  "zq21a13": "억지?",
  "zq21a14": "혼서는 그런 거 몰라.",
  "zq21a15": "아가씨,",
  "zq21a16": "우리 본 적 있나?",
  "zq21a17": "웨이 공자,",
  "zq21a18": "날 봐.",
  "zq21a19": "배혼 명부,",
  "zq21a20": "청수현 사본.",
  "zq21a21": "린얼야,",
  "zq21a22": "이 년 전에 병사했지.",
  "zq21a23": "죽은 사람이 시집을?",
  "zq21a24": "누가 사칭했겠지.",
  "zq21a25": "혼서라고요?",
  "zq21a26": "나도 있지.",
  "zq21a27": "관아 도장,",
  "zq21a28": "더 빨라.",
  "zq21a29": "혼인은,",
  "zq21a30": "관아가 정하죠.",
  "zq21a31": "당신 건,",
  "zq21a32": "그냥 사적 약속.",
  "zq21a33": "좋게 말할 때.",
  "zq21a34": "데려가!",
  "zq21a35": "오빠!",
  "zq21a36": "또 건드려 봐,",
  "zq21a37": "어디.",
  "zq21a38": "누가 쉬기를 건드려!",
  "zq21a39": "웨이 공자,",
  "zq21a40": "문은 저쪽.",
  "zq21a41": "흠,",
  "zq21a42": "아주 좋아.",
  "zq21a43": "사흘 뒤,",
  "zq21a44": "주 관아가 체포하러 와.",
  "zq21a45": "사칭 등재,",
  "zq21a46": "법대로 유배."
}
