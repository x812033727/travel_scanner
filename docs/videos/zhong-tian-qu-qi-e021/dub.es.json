{
  "zq21a01": "Quítate,",
  "zq21a02": {
    "text": "pobretón.",
    "say": "pobretón"
  },
  "zq21a03": "Esta es mi casa,",
  "zq21a04": "¿adónde?",
  "zq21a05": "¿Cómo es que…",
  "zq21a06": "me encontraste?",
  "zq21a07": "Huiste medio año,",
  "zq21a08": "¿y te escondes en esta tienducha?",
  "zq21a09": "De puño y letra de Tang Wanjin,",
  "zq21a10": "su padre firmó.",
  "zq21a11": "¡Tu familia",
  "zq21a12": "obligó a mi padre!",
  "zq21a13": "¿Ah, sí?",
  "zq21a14": "Al contrato le da igual.",
  "zq21a15": "Señorita,",
  "zq21a16": "¿nos conocemos?",
  "zq21a17": {
    "text": "Señorito Wei,",
    "say": "Oiga,"
  },
  "zq21a18": "aquí.",
  "zq21a19": {
    "text": "El registro de matrimonios,",
    "say": "El registro,"
  },
  "zq21a20": {
    "text": "copia del condado de Qingshui.",
    "say": "copia de Qingshui."
  },
  "zq21a21": "Lin Erya,",
  "zq21a22": "murió enferma hace dos años.",
  "zq21a23": "¿Cómo se casa una muerta?",
  "zq21a24": "A menos que la suplanten.",
  "zq21a25": "¿Contrato de matrimonio, dice?",
  "zq21a26": "Yo también tengo uno.",
  "zq21a27": {
    "text": "Sellado en el registro,",
    "say": "Sello oficial,"
  },
  "zq21a28": {
    "text": "antes que el suyo.",
    "say": "y antes."
  },
  "zq21a29": "Las bodas",
  "zq21a30": "las rige la ley.",
  "zq21a31": "El suyo",
  "zq21a32": "es un trato privado.",
  "zq21a33": "Te lo buscaste.",
  "zq21a34": "¡Llévensela!",
  "zq21a35": "¡Hermano!",
  "zq21a36": "Tócala,",
  "zq21a37": "atrévete.",
  "zq21a38": "¡¿Quién toca a Casa Xu?!",
  "zq21a39": "Señorito Wei,",
  "zq21a40": "la puerta.",
  "zq21a41": "Ah,",
  "zq21a42": "muy bien.",
  "zq21a43": "En tres días,",
  "zq21a44": "la prefectura viene por la impostora.",
  "zq21a45": {
    "text": "Nombre falso en el registro:",
    "say": "Suplantación:"
  },
  "zq21a46": "destierro, por ley."
}
