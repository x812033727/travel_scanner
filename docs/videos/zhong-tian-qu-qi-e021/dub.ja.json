{
  "zq21a01": "どけ、",
  "zq21a02": "貧乏人。",
  "zq21a03": "俺の家だ",
  "zq21a04": "どけと？",
  "zq21a05": "どうして……",
  "zq21a06": "ここが？",
  "zq21a07": "半年逃げて、",
  "zq21a08": "こんなボロ店に？",
  "zq21a09": "タン・ワンジン直筆、",
  "zq21a10": "君の父の署名だ。",
  "zq21a11": "そっちが",
  "zq21a12": "父に無理やり！",
  "zq21a13": "脅し？",
  "zq21a14": "婚書には関係ない。",
  "zq21a15": "そこの娘、",
  "zq21a16": "会ったことが？",
  "zq21a17": "ウェイ殿、",
  "zq21a18": "こっち。",
  "zq21a19": "配婚名簿",
  "zq21a20": "清水県の写しだ。",
  "zq21a21": "リン・アーヤー",
  "zq21a22": "二年前に病死している。",
  "zq21a23": "死人が嫁ぐ？",
  "zq21a24": "成りすましでなければ。",
  "zq21a25": "婚書だって？",
  "zq21a26": "俺にもある。",
  "zq21a27": "県の印だ",
  "zq21a28": "先だぞ。",
  "zq21a29": "それは",
  "zq21a30": "お上が決める。",
  "zq21a31": "そっちのは、",
  "zq21a32": "ただの私約。",
  "zq21a33": "生意気な。",
  "zq21a34": "連れて行け！",
  "zq21a35": "お兄ちゃん！",
  "zq21a36": "また触れば",
  "zq21a37": "覚悟しな。",
  "zq21a38": "手を出すな！",
  "zq21a39": "ウェイ殿、",
  "zq21a40": "出口はそこ。",
  "zq21a41": "よし",
  "zq21a42": "いいだろう。",
  "zq21a43": "三日後、",
  "zq21a44": "州府が捕りに来る。",
  "zq21a45": "名義詐称、",
  "zq21a46": "律により流刑。"
}
