{
  "zq21a01": "Minggir,",
  "zq21a02": {
    "text": "dasar miskin.",
    "say": "miskin."
  },
  "zq21a03": "Ini rumahku,",
  "zq21a04": {
    "text": "minggir ke mana?",
    "say": "ke mana?"
  },
  "zq21a05": "Kok kau bisa…",
  "zq21a06": "nemu aku di sini?",
  "zq21a07": {
    "text": "Kabur setengah tahun,",
    "say": "Kabur enam bulan,"
  },
  "zq21a08": "sembunyi di toko butut begini?",
  "zq21a09": {
    "text": "Tulisan tangan Tang Wanjin,",
    "say": "Tulisan Tang Wanjin,"
  },
  "zq21a10": {
    "text": "ayahnya sendiri yang teken.",
    "say": "ayahnya teken."
  },
  "zq21a11": "Keluargamu yang",
  "zq21a12": "paksa ayahku teken!",
  "zq21a13": {
    "text": "Dipaksa?",
    "say": "Masa?"
  },
  "zq21a14": {
    "text": "Surat nikah tak peduli itu.",
    "say": "Surat tetap sah."
  },
  "zq21a15": {
    "text": "Nona ini,",
    "say": "Nona,"
  },
  "zq21a16": {
    "text": "kita pernah bertemu?",
    "say": "kita kenal?"
  },
  "zq21a17": {
    "text": "Tuan Muda Wei,",
    "say": "Wei,"
  },
  "zq21a18": {
    "text": "lihat ke sini.",
    "say": "sini."
  },
  "zq21a19": {
    "text": "Daftar perjodohan,",
    "say": "Daftar ini,"
  },
  "zq21a20": {
    "text": "salinan Kabupaten Qingshui.",
    "say": "salinan Qingshui."
  },
  "zq21a21": {
    "text": "Lin Erya,",
    "say": "Lin Erya."
  },
  "zq21a22": "meninggal karena sakit dua tahun lalu.",
  "zq21a23": {
    "text": "Orang mati kok bisa nikah?",
    "say": "Orang mati nikah?"
  },
  "zq21a24": "Kecuali ada yang pakai namanya.",
  "zq21a25": "Surat nikah, ya?",
  "zq21a26": "Aku juga punya.",
  "zq21a27": {
    "text": "Dicap kantor bupati,",
    "say": "Cap bupati,"
  },
  "zq21a28": "lebih dulu.",
  "zq21a29": {
    "text": "Jodoh atau nggak,",
    "say": "Soal jodoh,"
  },
  "zq21a30": {
    "text": "negara yang putuskan.",
    "say": "negara putuskan."
  },
  "zq21a31": "Punyamu,",
  "zq21a32": {
    "text": "cuma perjanjian pribadi keluargamu.",
    "say": "cuma perjanjian pribadi."
  },
  "zq21a33": {
    "text": "Tak tahu diuntung.",
    "say": "Lancang."
  },
  "zq21a34": "Seret mereka!",
  "zq21a35": "Kakak!",
  "zq21a36": {
    "text": "Sentuh dia sekali lagi,",
    "say": "Sentuh lagi,"
  },
  "zq21a37": "coba aja.",
  "zq21a38": {
    "text": "Siapa berani macam-macam sama Toko Xu?",
    "say": "Usik Toko Xu?!"
  },
  "zq21a39": {
    "text": "Tuan Muda Wei,",
    "say": "Tuan Wei,"
  },
  "zq21a40": "pintu di sana.",
  "zq21a41": {
    "text": "Baik,",
    "say": "Oke."
  },
  "zq21a42": {
    "text": "bagus sekali.",
    "say": "bagus."
  },
  "zq21a43": {
    "text": "Tiga hari lagi,",
    "say": "Tiga hari,"
  },
  "zq21a44": {
    "text": "pihak provinsi datang menangkap si penipu nama.",
    "say": "si penipu ditangkap."
  },
  "zq21a45": {
    "text": "Terdaftar pakai nama orang:",
    "say": "Nama palsu:"
  },
  "zq21a46": {
    "text": "diasingkan sesuai hukum.",
    "say": "wajib diasingkan."
  }
}
