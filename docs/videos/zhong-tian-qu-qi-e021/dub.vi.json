{
  "zq21a01": "Tránh.",
  "zq21a02": {
    "text": "đồ nghèo kiết xác.",
    "say": "đồ nghèo hèn."
  },
  "zq21a03": "Đây là nhà ta,",
  "zq21a04": "tránh đâu?",
  "zq21a05": "Sao ngươi…",
  "zq21a06": "tìm được tới đây?",
  "zq21a07": "Chạy trốn nửa năm,",
  "zq21a08": "lại núp ở cái hiệu rách này?",
  "zq21a09": "Bút tích Đường Vạn Kim,",
  "zq21a10": "cha nàng ký đấy.",
  "zq21a11": "Là nhà ngươi",
  "zq21a12": "ép cha ta ký!",
  "zq21a13": "Ép?",
  "zq21a14": "Hôn thư đâu có nhận.",
  "zq21a15": "Vị cô nương này,",
  "zq21a16": "ta từng gặp nhau?",
  "zq21a17": {
    "text": "Ngụy công tử,",
    "say": "Công tử,"
  },
  "zq21a18": "nhìn đây.",
  "zq21a19": "Sổ phối hôn.",
  "zq21a20": {
    "text": "bản chép của huyện Thanh Thủy.",
    "say": "bản sao Thanh Thủy."
  },
  "zq21a21": "Lâm Nhị Nha,",
  "zq21a22": "hai năm trước đã ốm chết rồi.",
  "zq21a23": "Người chết sao gả được?",
  "zq21a24": "Trừ khi có kẻ mạo danh.",
  "zq21a25": "Hôn thư phải không?",
  "zq21a26": "Ta cũng có một tờ.",
  "zq21a27": "Ấn huyện nha,",
  "zq21a28": {
    "text": "đóng sớm hơn ngươi.",
    "say": "sớm hơn."
  },
  "zq21a29": "Phối hôn hay không,",
  "zq21a30": "do quan phủ quyết.",
  "zq21a31": "Tờ của ngươi,",
  "zq21a32": "chỉ là tư ước nhà ngươi.",
  "zq21a33": "Không biết điều.",
  "zq21a34": "Người đâu!",
  "zq21a35": "Ca!",
  "zq21a36": "Đụng nó lần nữa,",
  "zq21a37": "thử xem.",
  "zq21a38": "Ai dám động Hứa Ký!",
  "zq21a39": "Ngụy công tử,",
  "zq21a40": "cửa bên kia.",
  "zq21a41": "Được,",
  "zq21a42": "được lắm.",
  "zq21a43": "Ba ngày nữa,",
  "zq21a44": "châu phủ đến bắt kẻ mạo danh.",
  "zq21a45": {
    "text": "Mạo danh vào sổ:",
    "say": "Mạo danh:"
  },
  "zq21a46": "theo luật, lưu đày."
}
