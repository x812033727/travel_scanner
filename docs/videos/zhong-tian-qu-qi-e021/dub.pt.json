{
  "zq21a01": "Sai,",
  "zq21a02": "pobretão.",
  "zq21a03": "A casa é minha,",
  "zq21a04": "pra onde?",
  "zq21a05": "Como você…",
  "zq21a06": "me achou aqui?",
  "zq21a07": "Meio ano fugindo,",
  "zq21a08": "escondida nesse muquifo?",
  "zq21a09": "Letra de Tang Wanjin,",
  "zq21a10": "o pai dela assinou.",
  "zq21a11": "Sua família",
  "zq21a12": "obrigou meu pai!",
  "zq21a13": "Ah, é?",
  "zq21a14": "O contrato não liga.",
  "zq21a15": "Senhorita,",
  "zq21a16": "já nos vimos?",
  "zq21a17": "Wei,",
  "zq21a18": "Aqui.",
  "zq21a19": "O registro,",
  "zq21a20": "cópia de Qingshui.",
  "zq21a21": "Lin Erya,",
  "zq21a22": "morreu doente há dois anos.",
  "zq21a23": "Como uma morta casa?",
  "zq21a24": "A não ser com nome falso.",
  "zq21a25": "Contrato de casamento, é?",
  "zq21a26": "Eu também tenho um.",
  "zq21a27": {
    "text": "Selado pelo cartório,",
    "say": "Do cartório,"
  },
  "zq21a28": {
    "text": "antes do seu.",
    "say": "bem antes."
  },
  "zq21a29": "Casamento,",
  "zq21a30": "é com o governo.",
  "zq21a31": "Esse seu,",
  "zq21a32": "é só acordo de família.",
  "zq21a33": "Ingrato.",
  "zq21a34": "Levem ela!",
  "zq21a35": "Mano!",
  "zq21a36": {
    "text": "Toca nela de novo,",
    "say": "Toca nela,"
  },
  "zq21a37": "pra você ver.",
  "zq21a38": {
    "text": "Quem mexe com a Loja do Xu?!",
    "say": "Quem toca na loja?!"
  },
  "zq21a39": "Senhorzinho Wei,",
  "zq21a40": "a porta, ó.",
  "zq21a41": "Bom,",
  "zq21a42": "muito bem.",
  "zq21a43": "Em três dias,",
  "zq21a44": "a província leva a impostora.",
  "zq21a45": {
    "text": "Registro com nome falso:",
    "say": "Fraude:"
  },
  "zq21a46": "pena: exílio."
}
