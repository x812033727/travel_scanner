  },
  "lines": {
    "p001": {
      "source_hash": "a7d17c6224a1",
      "text": "Bu! Aku menggambar satu halaman penuh,"
    },
    "p002": {
      "source_hash": "7c46f3a4e5c8",
      "text": "Tersapu tangan, jadi belepotan!"
    },
    "p003": {
      "source_hash": "b73f5825eca7",
      "text": "Lihat, tanganku juga hitam!"
    },
    "p004": {
      "source_hash": "e5125314c94a",
      "text": "Coba lihat. Lapisan hitam di tanganmu ini,"
    },
    "p005": {
      "source_hash": "c068330d224c",
      "text": "kebanyakan dari isi pensilmu."
    },
    "p006": {
      "source_hash": "6bb37e27f1b5",
      "text": "Kenapa isi pensil gampang lepas?"
    },
    "p007": {
      "source_hash": "0d6f73b58d2d",
      "text": "Nanti kita tahu. Ada yang aneh: lapisan hitam ini,"
    },
    "p008": {
      "source_hash": "8c3fbf2f5583",
      "text": "dan berlian berkilau sama-sama karbon."
    },
    "p009": {
      "source_hash": "901a61b18663",
      "text": "Masa? Berlian kan keras,"
    },
    "p010": {
      "source_hash": "361f4b182117",
      "text": "isi pensil gampang copot!"
    },
    "p011": {
      "source_hash": "d2734acfc242",
      "text": "Sungguh. Lebih aneh: berlian terkeras pun ada yang ditakuti."
    },
    "p012": {
      "source_hash": "f1fd31992317",
      "text": "Garis pensilmu bisa sesuatu yang berlian tak bisa."
    },
    "p013": {
      "source_hash": "d8648b36d101",
      "text": "Bedanya cuma satu hal,"
    },
    "p014": {
      "source_hash": "5e2623cb0a89",
      "text": "jawabannya ada di pensilmu sehari-hari."
    },
    "p015": {
      "source_hash": "f27f0c18981c",
      "text": "Sama karbon,"
    },
    "p016": {
      "source_hash": "a8923e670d51",
      "text": "kok bedanya jauh sekali?"
    },
    "p017": {
      "source_hash": "efa7f8dcd3a0",
      "text": "Petunjuknya ada di isi pensilmu."
    },
    "p018": {
      "source_hash": "a642f8849a1c",
      "text": "Dibongkar, isi pensil itu campuran dua hal."
    },
    "p019": {
      "source_hash": "552579ef4cf2",
      "text": "Apa saja?"
    },
    "p020": {
      "source_hash": "2a04b7f04ba4",
      "text": "Satu grafit, hitam mengilap,"
    },
    "p021": {
      "source_hash": "fcf094559c1d",
      "text": "satu lagi tanah liat, yang dipakai bikin gerabah."
    },
    "p022": {
      "source_hash": "321d3078839c",
      "text": "Tanah bisa menulis?"
    },
    "p023": {
      "source_hash": "5f8d5c239b32",
      "text": "Tanah liat tak bikin hitam. Ia merekatkan grafit"
    },
    "p024": {
      "source_hash": "8794dea77ea9",
      "text": "jadi satu batang, lebih kuat."
    },
    "p025": {
      "source_hash": "5f04f4b61634",
      "text": "Ada pensil yang lebih hitam dan lembut, kan?"
    },
    "p026": {
      "source_hash": "bb5c5c547c4d",
      "text": "Ada! Punyaku!"
    },
    "p027": {
      "source_hash": "300e52214e22",
      "text": "Kok lebih hitam?"
    },
    "p028": {
      "source_hash": "0934e09effd1",
      "text": "Grafitnya banyak."
    },
    "p029": {
      "source_hash": "ff2390d54fad",
      "text": "Tanah liat banyak: keras, pucat."
    },
    "p030": {
      "source_hash": "af22f528f621",
      "text": "Punyaku pasti banyak grafit!"
    },
    "p031": {
      "source_hash": "340294ca6e0d",
      "text": "Jadi yang hitam grafit?"
    },
    "p032": {
      "source_hash": "83e6a6e28a66",
      "text": "Ya. Yang di tanganmu, kebanyakan grafit."
    },
    "p033": {
      "source_hash": "ff0e0c694913",
      "text": "Yang di tanganku, terasa licin!"
    },
    "p034": {
      "source_hash": "68a35e5d5098",
      "text": "Ya, grafit agak licin, dan berkilau seperti logam."
    },
    "p035": {
      "source_hash": "35654ee49af7",
      "text": "Berliannya?"
    },
    "p036": {
      "source_hash": "8a135a8b073c",
      "text": "Pasti benda lain, kan?"
    },
    "p037": {
      "source_hash": "0daba76b3a6b",
      "text": "Cincin Mama,"
    },
    "p038": {
      "source_hash": "31981a53fde3",
      "text": "ada satu yang kecil!"
    },
    "p039": {
      "source_hash": "9af3143e9878",
      "text": "Punya mamamu juga sama."
    },
    "p040": {
      "source_hash": "51eb3e1e0cc3",
      "text": "seperti tadi, hampir semuanya karbon."
    },
    "p041": {
      "source_hash": "8b1b6aada0f7",
      "text": "Karbon yang lebih hebat?"
    },
    "p042": {
      "source_hash": "783e05066528",
      "text": "Karbon ya karbon. Di grafit dan berlian,"
    },
    "p043": {
      "source_hash": "424e87fe4b97",
      "text": "kalau dibandingkan satu per satu, sama persis."
    },
    "p044": {
      "source_hash": "7e6bafa8fc0a",
      "text": "Lalu bedanya di mana?"
    },
    "p045": {
      "source_hash": "b0c4b9107949",
      "text": "Tebakanku: beda cara menyusunnya."
    },
    "p046": {
      "source_hash": "73a061f42caf",
      "text": "Cara susun"
    },
    "p047": {
      "source_hash": "5ee41b1b913f",
      "text": "bikin beda jauh?"
    },
    "p048": {
      "source_hash": "adefedbbbacd",
      "text": "Bisa. Kita susun pakai sekotak balok kayu."
    },
    "p049": {
      "source_hash": "363e5d47fa82",
      "text": "Tiap bola kayu"
    },
    "p050": {
      "source_hash": "0c8e6da1b695",
      "text": "itu karbon; tongkat itu tangannya."
    },
    "p051": {
      "source_hash": "58ccb674388b",
      "text": "Aku punya!"
    },
    "p052": {
      "source_hash": "58ffa2b92df0",
      "text": "Karbon gandengan tangan!"
    },
    "p053": {
      "source_hash": "5d48fdf92f20",
      "text": "Karbon berlian"
    },
    "p054": {
      "source_hash": "80ec10b80812",
      "text": "pasti lebih rapat!"
    },
    "p055": {
      "source_hash": "6c442ceabc5d",
      "text": "Ingat, nanti kita ukur."
    },
    "p056": {
      "source_hash": "c30cae1980c7",
      "text": "Tapi beda terbesarnya: tiap karbon pegang berapa tangan."
    },
    "p057": {
      "source_hash": "d8964f9fda77",
      "text": "Tiap karbon punya empat tangan."
    },
    "p058": {
      "source_hash": "4746fc520d07",
      "text": "Di grafit, tiap bola cuma gandeng tiga,"
    },
    "p059": {
      "source_hash": "66c1e7d1041e",
      "text": "semua di satu bidang, jadi jaring datar."
    },
    "p060": {
      "source_hash": "2b1dcb95fb75",
      "text": "Cuma tiga?"
    },
    "p061": {
      "source_hash": "33fdaeae1442",
      "text": "Ada tangan kosong?"
    },
    "p062": {
      "source_hash": "2ac2326eb5dd",
      "text": "Teliti! Tangan kosong itu penting,"
    },
    "p063": {
      "source_hash": "6e2050b98d4e",
      "text": "nanti dibahas."
    },
    "p064": {
      "source_hash": "8febf20b35b8",
      "text": "Satu jaring kuat, tapi ada banyak jaring,"
    },
    "p065": {
      "source_hash": "4d5d6b39365d",
      "text": "bertumpuk berlapis-lapis."
    },
    "p066": {
      "source_hash": "3e094cae9cf3",
      "text": "Di antara lapisan,"
    },
    "p067": {
      "source_hash": "2b67ab790315",
      "text": "direkatkan pakai lem?"
    },
    "p068": {
      "source_hash": "75e5bfca9ce1",
      "text": "Tak ada tongkat, cuma tarikan lemah sekali."
    },
    "p069": {
      "source_hash": "56a5bb3d07ce",
      "text": "Dan agak jauh,"
    },
    "p070": {
      "source_hash": "1d51ec8161d2",
      "text": "lebih dua kali jarak antarbola di jaring."
    },
    "p071": {
      "source_hash": "ad603015f85b",
      "text": "Jauh,"
    },
    "p072": {
      "source_hash": "4f01b2a87e0b",
      "text": "jadinya apa?"
    },
    "p073": {
      "source_hash": "b3788daa8067",
      "text": "Ingat, nanti kita dorong."
    },
    "p074": {
      "source_hash": "9744188a79e0",
      "text": "Jaring kuat"
    },
    "p075": {
      "source_hash": "6b10689f9bd7",
      "text": "kok tumpukannya lembek?"
    },
    "p076": {
      "source_hash": "9c16b98ff962",
      "text": "Bukan jaringnya,"
    },
    "p077": {
      "source_hash": "11e834d58c6d",
      "text": "tapi di antara lapisan. Berlian lain lagi."
    },
    "p078": {
      "source_hash": "b97202fb5e26",
      "text": "Balok sama, tiap bola pakai keempat tangannya,"
    },
    "p079": {
      "source_hash": "d2bc09142bd3",
      "text": "ke empat arah berbeda."
    },
    "p080": {
      "source_hash": "d435d79db844",
      "text": "Keempat tangan terpakai?"
    },
    "p081": {
      "source_hash": "1976f63c77df",
      "text": "Tak ada yang kosong. Ingat!"
    },
    "p082": {
      "source_hash": "72c4903a557c",
      "text": "Jadi rangka panjat, tersambung semua."
    },
    "p083": {
      "source_hash": "e24199e5e384",
      "text": "Ada di taman!"
    },
    "p084": {
      "source_hash": "458c10302a1c",
      "text": "Itu kokoh!"
    },
    "p085": {
      "source_hash": "4c648f901c3e",
      "text": "Grafit: jaring"
    },
    "p086": {
      "source_hash": "73156ca3a8c8",
      "text": "berlian rangka panjat, ya?"
    },
    "p087": {
      "source_hash": "62633d118ee1",
      "text": "Ingat, ini cuma model."
    },
    "p088": {
      "source_hash": "6415a0a38f10",
      "text": "Karbon bukan bola, tangan bukan tongkat."
    },
    "p089": {
      "source_hash": "40bfefb45dff",
      "text": "Tongkat menunjukkan siapa terhubung,"
    },
    "p090": {
      "source_hash": "9f77bfaa5e17",
      "text": "seberapa kuat."
    },
    "p091": {
      "source_hash": "ea3ac2314a4f",
      "text": "Gimana tahu itu benar?"
    },
    "p092": {
      "source_hash": "3797269697cc",
      "text": "Menurutku, gunanya untuk menebak,"
    },
    "p093": {
      "source_hash": "889a021dbc97",
      "text": "lalu diukur dulu."
    },
    "p094": {
      "source_hash": "9c9573b6aad6",
      "text": "Bisa ditebak"
    },
    "p095": {
      "source_hash": "8f7bce58fb93",
      "text": "mana yang keras?"
    },
    "p096": {
      "source_hash": "6095ca4c54bf",
      "text": "Bisa. Dorong tumpukan jaring grafit."
    },
    "p097": {
      "source_hash": "2edb3931085a",
      "text": "Lapisannya jauh, tarikannya lemah,"
    },
    "p098": {
      "source_hash": "0b3d7344bc08",
      "text": "didorong pelan, lapisan atas langsung bergeser."
    },
    "p099": {
      "source_hash": "d655088cd671",
      "text": "Langsung geser!"
    },
    "p100": {
      "source_hash": "9269d1292691",
      "text": "Itulah menulis. Kertas kasar, pensil tergesek,"
    },
    "p101": {
      "source_hash": "5b1c2285ff32",
      "text": "lapisan grafit lepas, jadi garis hitam."
    },
    "p102": {
      "source_hash": "8f0c346b9cd9",
      "text": "Tanganku juga?"
    },
    "p103": {
      "source_hash": "66e5e31cddda",
      "text": "Ya, itu pertanyaanmu tadi."
    },
    "p104": {
      "source_hash": "c695cb0dedf2",
      "text": "Grafit pindah ke tangan, gambar belepotan."
    },
    "p105": {
      "source_hash": "92baac51872e",
      "text": "Tebakan lain: celah antarlapisan besar,"
    },
    "p106": {
      "source_hash": "be71d9a47047",
      "text": "seukuran, grafit mestinya lebih ringan."
    },
    "p107": {
      "source_hash": "436b9ca29f70",
      "text": "Benar lebih ringan?"
    },
    "p108": {
      "source_hash": "a07443c04458",
      "text": "Ingat tebakanmu: berlian lebih rapat?"
    },
    "p109": {
      "source_hash": "b93410f8aa19",
      "text": "Berlian sekitar satu setengah kali beratnya."
    },
    "p110": {
      "source_hash": "23cd33a1058b",
      "text": "Aku benar!"
    },
    "p111": {
      "source_hash": "91c439343758",
      "text": "Ya, rangka panjat tak punya celah besar antarlapisan."
    },
    "p112": {
      "source_hash": "b1c7ea9c248a",
      "text": "Rangka?"
    },
    "p113": {
      "source_hash": "821e550b2d91",
      "text": "Tak bergeser!"
    },
    "p114": {
      "source_hash": "f8567856c72a",
      "text": "Tiap bola terpegang ke segala arah,"
    },
    "p115": {
      "source_hash": "fd4401b287c2",
      "text": "tak ada yang bergeser."
    },
    "p116": {
      "source_hash": "d71130df1d6e",
      "text": "Untuk mengikis sedikit, harus memutus"
    },
    "p117": {
      "source_hash": "4990fc848e7a",
      "text": "banyak tangan"
    },
    "p118": {
      "source_hash": "5560f1e54ca6",
      "text": "Grafit tak perlu?"
    },
    "p119": {
      "source_hash": "2c75b8bf6c09",
      "text": "Ya, cukup lapisannya bergeser, tak satu tangan pun putus."
    },
    "p120": {
      "source_hash": "e4669b9eb13b",
      "text": "Jadi berlian susah tergores?"
    },
    "p121": {
      "source_hash": "c320e9335dce",
      "text": "Ya. Bagi ilmuwan, keras artinya susah tergores."
    },
    "p122": {
      "source_hash": "4e6f33efe4af",
      "text": "Ada urutan: yang menggores, lebih keras,"
    },
    "p123": {
      "source_hash": "ea903cb15fbe",
      "text": "satu paling lunak, sepuluh paling keras."
    },
    "p124": {
      "source_hash": "17f25ea4e22f",
      "text": "Grafit satu-dua, tergores kuku;"
    },
    "p125": {
      "source_hash": "21657eaab096",
      "text": "berlian di puncak, sepuluh."
    },
    "p126": {
      "source_hash": "5b170eb727f6",
      "text": "Hanya berlian gores berlian."
    },
    "p127": {
      "source_hash": "2af31c0656e0",
      "text": "Sekeras itu,"
    },
    "p128": {
      "source_hash": "9e915f6d6ee5",
      "text": "pasti tak pecah!"
    },
    "p129": {
      "source_hash": "0d83f3d9696c",
      "text": "Banyak yang mengira. Tapi keras dan tahan pukul itu beda."
    },
    "p130": {
      "source_hash": "de3bad058e6e",
      "text": "Bedanya apa?"
    },
    "p131": {
      "source_hash": "0212622f4f5b",
      "text": "Keras itu tadi, tak mudah tergores;"
    },
    "p132": {
      "source_hash": "9a747dee4d82",
      "text": "tahan pukul: dipukul keras, retak tidak."
    },
    "p133": {
      "source_hash": "4e65fd9ae722",
      "text": "Gelas kaca: kuku tak menggoresnya,"
    },
    "p134": {
      "source_hash": "2a00858f1da2",
      "text": "tapi jatuh, bisa pecah."
    },
    "p135": {
      "source_hash": "74e5e051db5d",
      "text": "Aku pernah memecahkan satu…"
    },
    "p136": {
      "source_hash": "850745bee5c1",
      "text": "Nah kan."
    },
    "p137": {
      "source_hash": "afd3bdbe47b8",
      "text": "Ingat? Berlian terkeras pun ada yang ditakuti."
    },
    "p138": {
      "source_hash": "87ccee0acec7",
      "text": "Ingat! Takut apa?"
    },
    "p139": {
      "source_hash": "60c418ab5e0c",
      "text": "Pukulan keras."
    },
    "p140": {
      "source_hash": "7e96d5a501bc",
      "text": "Kata lembaga ahli permata,"
    },
    "p141": {
      "source_hash": "761dfec2eafe",
      "text": "sekali pukul, berlian bisa retak atau cuil."
    },
    "p142": {
      "source_hash": "3500e6811c3a",
      "text": "Rangka panjat retak?"
    },
    "p143": {
      "source_hash": "227a1cf9b10e",
      "text": "Di beberapa arah, tangannya lebih sedikit,"
    },
    "p144": {
      "source_hash": "4c85d116fc0f",
      "text": "di arah itu, lebih mudah retak."
    },
    "p145": {
      "source_hash": "d581f606639f",
      "text": "Pemotong berlian kadang sengaja memecah di situ."
    },
    "p146": {
      "source_hash": "cfefe7cb0a9d",
      "text": "Ternyata sengaja!"
    },
    "p147": {
      "source_hash": "45a05257f946",
      "text": "Ya, pakai arah yang paling rapuh."
    },
    "p148": {
      "source_hash": "17582af86088",
      "text": "Geser atau retak,"
    },
    "p149": {
      "source_hash": "452f79174def",
      "text": "bisa tebak hal lain?"
    },
    "p150": {
      "source_hash": "c5df59e6a6fd",
      "text": "Bisa. Ingat, garis pensilmu bisa satu hal"
    },
    "p151": {
      "source_hash": "575d4be8944d",
      "text": "berlian tidak?"
    },
    "p152": {
      "source_hash": "6cd3c21a993e",
      "text": "Ingat! Apa itu?"
    },
    "p153": {
      "source_hash": "eaf84f36abed",
      "text": "Mengalirkan listrik. Pakai pensil lunak, tekan, buat"
    },
    "p154": {
      "source_hash": "c74b38c7922f",
      "text": "garis tebal hitam tak putus, ujungnya ke baterai dan lampu."
    },
    "p155": {
      "source_hash": "39f909822042",
      "text": "Tapi listrik lewat kabel,"
    },
    "p156": {
      "source_hash": "6fef8975b140",
      "text": "pensil kan bukan logam!"
    },
    "p157": {
      "source_hash": "15c119c3b0d5",
      "text": "Ada museum sains mengajarkannya,"
    },
    "p158": {
      "source_hash": "9cec535753f8",
      "text": "dan lampu kecilnya menyala."
    },
    "p159": {
      "source_hash": "e20088d21dee",
      "text": "Wah!"
    },
    "p160": {
      "source_hash": "6369b37777b6",
      "text": "Kenapa grafit bisa?"
    },
    "p161": {
      "source_hash": "792ab6fac725",
      "text": "Ingat tangan kosong di jaring?"
    },
    "p162": {
      "source_hash": "043ced547b65",
      "text": "Arus listrik: benda kecil bermuatan berlari,"
    },
    "p163": {
      "source_hash": "0cb601ba721e",
      "text": "namanya elektron."
    },
    "p164": {
      "source_hash": "657a837884fd",
      "text": "Larinya ke mana?"
    },
    "p165": {
      "source_hash": "408e65571cbe",
      "text": "Tangan kosong tiap karbon melepas elektron,"
    },
    "p166": {
      "source_hash": "ccabff228a30",
      "text": "lari di seluruh jaring."
    },
    "p167": {
      "source_hash": "41ec31f7e656",
      "text": "Garis pensilmu jalan elektron,"
    },
    "p168": {
      "source_hash": "536207648b27",
      "text": "lewat lampu, lampunya menyala."
    },
    "p169": {
      "source_hash": "35654ee49af7",
      "text": "Lalu berlian?"
    },
    "p170": {
      "source_hash": "4561160662dc",
      "text": "Tangan penuh,"
    },
    "p171": {
      "source_hash": "54490725d112",
      "text": "pasti tak menyala!"
    },
    "p172": {
      "source_hash": "82889c7e93bf",
      "text": "Benar. Tangan penuh, elektron tak bisa lari."
    },
    "p173": {
      "source_hash": "ee0c162b9242",
      "text": "Berlian biasa hampir tak menghantar listrik."
    },
    "p174": {
      "source_hash": "ff3433bf7ad5",
      "text": "Jujur, ada berlian biru langka,"
    },
    "p175": {
      "source_hash": "fedb191448f3",
      "text": "tercampur zat lain, agak menghantar."
    },
    "p176": {
      "source_hash": "4e80a69a4233",
      "text": "Ada berlian biru?"
    },
    "p177": {
      "source_hash": "04f0adbd6df0",
      "text": "Ada, tapi sangat langka. Makanya kubilang berlian biasa."
    },
    "p178": {
      "source_hash": "4a6e961a6bd0",
      "text": "Grafit arah lain,"
    },
    "p179": {
      "source_hash": "59461bd449cc",
      "text": "listrik juga lancar?"
    },
    "p180": {
      "source_hash": "3ae923f7101a",
      "text": "Di jaring, ya,"
    },
    "p181": {
      "source_hash": "fecefdacb696",
      "text": "tapi lompat ke lapisan bawah jauh lebih sulit."
    },
    "p182": {
      "source_hash": "2de9b1740126",
      "text": "Diukur, sepanjang lapisan ratusan sampai ribuan kali lebih mudah."
    },
    "p183": {
      "source_hash": "640fcab67e90",
      "text": "Jauh sekali!"
    },
    "p184": {
      "source_hash": "e431476226f0",
      "text": "Aku mau coba!"
    },
    "p185": {
      "source_hash": "97569b53079b",
      "text": "Ingat, hanya baterai kecil,"
    },
    "p186": {
      "source_hash": "157a151d5216",
      "text": "jangan pernah main stopkontak!"
    },
    "p187": {
      "source_hash": "684fb2d8222c",
      "text": "Karbon menghantar listrik?"
    },
    "p188": {
      "source_hash": "37a4d64beb54",
      "text": "Tanya: karbon susunan yang mana?"
    },
    "p189": {
      "source_hash": "7d45457270ad",
      "text": "Tahu karbon"
    },
    "p190": {
      "source_hash": "81f447cc243c",
      "text": "saja belum cukup?"
    },
    "p191": {
      "source_hash": "b65975dbbebb",
      "text": "Menurutmu? Coba, Wen."
    },
    "p192": {
      "source_hash": "dbca91e664e3",
      "text": "Aha!"
    },
    "p193": {
      "source_hash": "81da124d08d4",
      "text": "Pensilku, berlian Mama,"
    },
    "p194": {
      "source_hash": "bda0a132af97",
      "text": "karbon sama, susunan beda!"
    },
    "p195": {
      "source_hash": "2c21d6ec7a14",
      "text": "Bagus, kamu sambungkan keduanya."
    },
    "p196": {
      "source_hash": "b301719f8164",
      "text": "Itu bagian paling seru soal bahan."
    },
    "p197": {
      "source_hash": "adf4cadf1a70",
      "text": "Gambarku nanti masih belepotan?"
    },
    "p198": {
      "source_hash": "c22eb4255216",
      "text": "Masih. Tapi kamu bisa mengamati sesuatu."
    },
    "p199": {
      "source_hash": "b5965e093cab",
      "text": "Lain kali, ambil satu pensil gelap dan satu pucat,"
    },
    "p200": {
      "source_hash": "66286bb9fafd",
      "text": "warnai sedikit,"
    },
    "p201": {
      "source_hash": "30c98127bc82",
      "text": "lalu gosok jari?"
    },
    "p202": {
      "source_hash": "c3c924160cc5",
      "text": "Ya, mana yang lebih belepotan."
    },
    "p203": {
      "source_hash": "da47e3ba0ed0",
      "text": "Si gelap!"
    },
    "p204": {
      "source_hash": "12b56fc018e6",
      "text": "Katamu, yang gelap banyak grafit!"
    },
    "p205": {
      "source_hash": "a9bb0c4594b1",
      "text": "Masuk akal. Ingat? Yang pucat lebih banyak tanah liat."
    },
    "p206": {
      "source_hash": "36d742bcb996",
      "text": "Begitu!"
    },
    "p207": {
      "source_hash": "ad21646310f3",
      "text": "Pensil mana luntur?"
    },
    "p208": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar ya!"
    },
    "p209": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
