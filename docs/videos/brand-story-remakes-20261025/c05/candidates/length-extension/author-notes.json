  "role_delta": {
    "scope": "R10 shared scene_first/no_recap: replace the imagined opening with a sourced event and remove recap throughout; keep the passed R10 chronology correction.",
    "narration_changed": [
      {
        "id": "c05r002",
        "before": "想像桌邊只剩一截灰，窗外仍暗著；你得再拿一根，夜晚才剛開始。",
        "after": "一八九〇年，上山英一郎推出棒狀蚊香，把除蟲菊粉做成了能點燃的細條。",
        "spoken_unit_delta": 3
      },
      {
        "id": "c05r020",
        "before": "線香的做法給了一條路：把粉料變成細條，讓材料有可以持續燃燒的形狀。",
        "after": "開場那種細條，借用的是佛壇線香的製法。",
        "spoken_unit_delta": -13
      },
      {
        "id": "c05r021",
        "before": "到一八九〇年，直條產品上市了。這根細香，能不能完整地送到你手上？",
        "after": "可這種細香，能不能完整地送到你手上？",
        "spoken_unit_delta": -11
      },
      {
        "id": "c05r023",
        "before": "公司回顧，這種直條約二十公分長，當時往往得同時用上數根。",
        "after": "原廠留存的一款直條商品，約二十公分長；資料還說，使用時會同時用上數根。",
        "spoken_unit_delta": 6
      },
      {
        "id": "c05r092",
        "before": "原廠另一份製程解說，把混合與捏和分開：粉料先在混合機裡，混約三十分鐘。",
        "after": "我沒想到，原廠的製程解說還把混合與捏和分開：粉料先在混合機裡，混約三十分鐘。",
        "spoken_unit_delta": 3
      },
      {
        "id": "c05le010",
        "before": "科博館把現在的打型比作餅乾模。料片交到巴形的渦卷刃型下，這回還需要工人一圈圈盤嗎？",
        "after": "原廠製程裡，料片沿輸送帶進入打型機，像餅乾模那樣，切出相連的雙卷。",
        "spoken_unit_delta": -9
      },
      {
        "id": "c05rx010",
        "before": "燃燒時，有效成分會以極細微粒子的形式進入空氣，這也是原廠描述的工作方式。",
        "after": "原廠說，燃燒期間，有效成分會持續以極細微粒子的形式進入空氣。",
        "spoken_unit_delta": -6
      }
    ],
    "narration_deleted": [
      {
        "id": "c07d06",
        "text": "種得多，乾燥的位置和天氣卻得跟得上；我覺得這比有沒有種活，更像一道生產難題。",
        "spoken_units": 34,
        "reason": "刪除對乾燥位置、天氣與產量的抽象小結，讓陰乾負荷直接走向連雨備案。"
      },
      {
        "id": "c07s06",
        "text": "我看這些留下的商品，最有感的是，長夜終於有了不同的時間刻度；你要等多久，選擇開始不一樣。",
        "spoken_units": 39,
        "reason": "刪除對剛說過六小時、十二小時商品選擇的總結，不再重講長夜有不同刻度。"
      },
      {
        "id": "c05le004",
        "text": "你若站在這台機器前，送進去的不是一把乾粉。粉一倒就散，怎麼變成能被擠出去的那一塊？",
        "spoken_units": 37,
        "reason": "刪除乾粉會散、再問如何成塊的重啟；直接給加水成黏土狀的新工序。"
      },
      {
        "id": "c07m01",
        "text": "你手上的香體，有負責成形的材料，也有負責殺蟲的成分；我覺得它像一個分工很細的載具。",
        "spoken_units": 37,
        "reason": "刪除剛列過的成形材料／有效成分分工小結；第一人稱反應併入有三十分鐘工序事實的r092。"
      },
      {
        "id": "c05le023",
        "text": "接著，輸送帶把料片交給打型機，刀模打出兩個組合在一起的螺旋。",
        "spoken_units": 27,
        "reason": "將輸送帶、打型、相連雙卷合併進le010，只講一次現行打型動作。"
      },
      {
        "id": "c07m02",
        "text": "裝箱讓材料離開工廠，等你拆封時，最後一道交接，卻還在自己的手指上。",
        "spoken_units": 29,
        "reason": "刪除剛裝箱又說材料離廠的過門，直接讓雙卷分開問題接到使用章。"
      },
      {
        "id": "c05le014",
        "text": "有效成分是只放出那一下，還是會一直釋放？",
        "spoken_units": 18,
        "reason": "將持續釋放的時間尺度併入rx010，不在位置揭露後重啟一次釋放問答。"
      },
      {
        "id": "c05le015",
        "text": "原廠說，有效成分會在燃燒期間持續釋放。",
        "spoken_units": 17,
        "reason": "持續釋放事實已完整併入rx010，本句刪除。"
      }
    ],
