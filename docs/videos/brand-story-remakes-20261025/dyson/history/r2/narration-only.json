[
  {
    "id": "29pe",
    "chapter": "開場：樣品還沒完成",
    "text": "你會花約二十五萬日圓，買一台吸塵器嗎？"
  },
  {
    "id": "sthq",
    "chapter": "開場：樣品還沒完成",
    "text": "這是戴森後來回憶的日本價位；你若回到開發桌，先遇到的卻是未完成樣品。"
  },
  {
    "id": "bnk8",
    "chapter": "開場：樣品還沒完成",
    "text": "山本秀夫回憶，Apex社長得設法找工廠，把新的開發工作交給設計師。"
  },
  {
    "id": "r4bz",
    "chapter": "開場：樣品還沒完成",
    "text": "一顆一百伏特的馬達換進設計，外殼卻得重畫。"
  },
  {
    "id": "qggg",
    "chapter": "開場：樣品還沒完成",
    "text": "我好奇的是，一個滿身小孔的罩子，後來怎麼擋住入口的麻煩？"
  },
  {
    "id": "t39s",
    "chapter": "開場：樣品還沒完成",
    "text": "而有了日本的授權收入，英國那副量產模具又得向誰籌錢？"
  },
  {
    "id": "suy4",
    "chapter": "開場：樣品還沒完成",
    "text": "今天沿著戴森這筆跨國合作，追到一九九三年的自家產線。"
  },
  {
    "id": "728h",
    "chapter": "開場：樣品還沒完成",
    "text": "日本這一站，究竟替他完成了什麼？"
  },
  {
    "id": "kget",
    "chapter": "照片帶來一筆新工作",
    "text": "山本在二〇一四年的贊助訪談裡回憶，Apex社長看到粉紅吸塵器照片，便聯絡戴森。"
  },
  {
    "id": "ffyv",
    "chapter": "照片帶來一筆新工作",
    "text": "他說，照片出自美國一九八四年的設計書，書名直譯是產品設計。"
  },
  {
    "id": "qeta",
    "chapter": "照片帶來一筆新工作",
    "text": "這位原想進口的社長，必須先決定，要不要接下後續的重新開發。"
  },
  {
    "id": "mm26",
    "chapter": "照片帶來一筆新工作",
    "text": "換成你原本要進貨，我想你也會問：現在到底是買產品，還是接開發案？"
  },
  {
    "id": "hytw",
    "chapter": "照片帶來一筆新工作",
    "text": "在山本的敘述裡，合作方向就此轉成在日本重新製作，再取得銷售權。"
  },
  {
    "id": "ji9r",
    "chapter": "照片帶來一筆新工作",
    "text": "但先等等，這能說成英國全都拒絕，只有日本願意製造嗎？"
  },
  {
    "id": "hse6",
    "chapter": "照片帶來一筆新工作",
    "text": "戴森自己的回顧裡，在日本這一站之前，已有英國授權商的Cyclon。"
  },
  {
    "id": "ux6m",
    "chapter": "照片帶來一筆新工作",
    "text": "他把生產時間列在一九八三、八四年，並說只做了五百五十台。"
  },
  {
    "id": "4eb7",
    "chapter": "照片帶來一筆新工作",
    "text": "他也說，那次合作在商業上沒有成功。"
  },
  {
    "id": "xn7i",
    "chapter": "照片帶來一筆新工作",
    "text": "你若問這台英國授權的機器在哪裡做，館藏又怎麼寫？"
  },
  {
    "id": "tazj",
    "chapter": "照片帶來一筆新工作",
    "text": "館方標明它在義大利製造，為位於英國布里斯托的授權商生產。"
  },
  {
    "id": "uzk6",
    "chapter": "照片帶來一筆新工作",
    "text": "英國智慧財產局記錄的本人證詞，還留下一個更早的動作：先做木製外觀模型。"
  },
  {
    "id": "jnux",
    "chapter": "照片帶來一筆新工作",
    "text": "他說，到一九八三年八月，已做出帶透明集塵筒的氣旋原型。"
  },
  {
    "id": "j4ux",
    "chapter": "照片帶來一筆新工作",
    "text": "外觀模型、能工作的原型、授權商品，在這段路上已經是不同的物件。"
  },
  {
    "id": "bp5c",
    "chapter": "照片帶來一筆新工作",
    "text": "有了授權與成品，為什麼別的合作還是談不下去？"
  },
  {
    "id": "pirj",
    "chapter": "照片帶來一筆新工作",
    "text": "我反而覺得這比全世界都說不，更接近做產品的難處。"
  },
  {
    "id": "g7y5",
    "chapter": "照片帶來一筆新工作",
    "text": "有人答應合作，只是起點；換一個合作方，也不會自動省掉開發。"
  },
  {
    "id": "iydf",
    "chapter": "照片帶來一筆新工作",
    "text": "那麼，其他授權談判，到底是在哪裡停下來？"
  },
  {
    "id": "eku7",
    "chapter": "照片帶來一筆新工作",
    "text": "戴森在口述裡說，有些公司本來很有興趣，談判也進行了很長一段。"
  },
  {
    "id": "ddxp",
    "chapter": "照片帶來一筆新工作",
    "text": "有的談到公司內部的專利法律顧問，才被擋下。"
  },
  {
    "id": "u8q2",
    "chapter": "照片帶來一筆新工作",
    "text": "也有公司決定不增加產品線，因此停止接洽。"
  },
  {
    "id": "gttr",
    "chapter": "照片帶來一筆新工作",
    "text": "這些是他回顧的談判障礙，各家停下的地方並不相同。"
  },
  {
    "id": "dhb6",
    "chapter": "照片帶來一筆新工作",
    "text": "我想，換成你拿透明筒展示給別家做，會不會先被外觀擋住？"
  },
  {
    "id": "fg73",
    "chapter": "照片帶來一筆新工作",
    "text": "那份官方決定書裡，他還說，八十年代曾向十五家吸塵器製造商展示透明筒機器。"
  },
  {
    "id": "hz4k",
    "chapter": "照片帶來一筆新工作",
    "text": "透明筒當時不是主要爭點，但他記得，不只一家製造商表達過不喜歡。"
  },
  {
    "id": "3f9i",
    "chapter": "照片帶來一筆新工作",
    "text": "展示機器的對象、產品線的決定和專利審視，會把合作帶往不同方向。"
  },
  {
    "id": "3n7g",
    "chapter": "照片帶來一筆新工作",
    "text": "Apex接下來找誰，把眼前的樣品變成能做的東西？"
  },
  {
    "id": "upnx",
    "chapter": "照片帶來一筆新工作",
    "text": "山本說，這家公司原本擅長進口文具，沒有自家的工程師和工廠。"
  },
  {
    "id": "7vwv",
    "chapter": "照片帶來一筆新工作",
    "text": "找得到生產地點，下一個問題是：現場有沒有人做過吸塵器？"
  },
  {
    "id": "iund",
    "chapter": "照片帶來一筆新工作",
    "text": "山本的工作室履歷，也把加入Apex寫在一九八五年。"
  },
  {
    "id": "8sut",
    "chapter": "照片帶來一筆新工作",
    "text": "履歷列出的工作，是和英國團隊共同開發吸塵器。"
  },
  {
    "id": "decj",
    "chapter": "照片帶來一筆新工作",
    "text": "山本說，承接製造的原本是一間精密機械工廠，並不專門做吸塵器。"
  },
  {
    "id": "tbv9",
    "chapter": "照片帶來一筆新工作",
    "text": "而他自己在這以前，也沒有設計吸塵器的經驗。"
  },
  {
    "id": "qusf",
    "chapter": "照片帶來一筆新工作",
    "text": "你找到的是能製造零件的夥伴，還得一起摸索這台工具怎麼用得起來。"
  },
  {
    "id": "u434",
    "chapter": "照片帶來一筆新工作",
    "text": "你若先照外形開工，原設計遇到的電壓差異，會在哪個零件讓人停下來？"
  },
  {
    "id": "h3qb",
    "chapter": "照片帶來一筆新工作",
    "text": "進口公司、設計師和外部工廠，得先把各自的工作接起來。"
  },
  {
    "id": "xr9y",
    "chapter": "照片帶來一筆新工作",
    "text": "那個馬達，為什麼又會把外殼牽進來？"
  },
  {
    "id": "xjwd",
    "chapter": "裝得進去，還推得動嗎",
    "text": "山本說，他們得在日本使用的電壓條件下，找到輸出相近的馬達。"
  },
  {
    "id": "3kg3",
    "chapter": "裝得進去，還推得動嗎",
    "text": "結果找到的馬達，尺寸比原先的大了一截。"
  },
  {
    "id": "d5mc",
    "chapter": "裝得進去，還推得動嗎",
    "text": "你可以把馬達拿在手上比較，問題卻不只在那一顆零件。"
  },
  {
    "id": "ttr8",
    "chapter": "裝得進去，還推得動嗎",
    "text": "我先想到的是，這顆大馬達裝好以後，地毯上的操作會怎麼變？"
  },
  {
    "id": "hq3w",
    "chapter": "裝得進去，還推得動嗎",
    "text": "依山本多年後的估計，做出第一台日本試作品，大約花了半年。"
  },
  {
    "id": "7ex2",
    "chapter": "裝得進去，還推得動嗎",
    "text": "之後還有約一年半，都在處理陸續出現的問題。"
  },
  {
    "id": "wja9",
    "chapter": "裝得進去，還推得動嗎",
    "text": "這是他回顧時的粗略工期，不是一份逐月排好的工程日誌。"
  },
  {
    "id": "dzxx",
    "chapter": "裝得進去，還推得動嗎",
    "text": "他記得，裝起來才發現，大馬達不只是體積大，也很重。"
  },
  {
    "id": "w5x9",
    "chapter": "裝得進去，還推得動嗎",
    "text": "機器拿到地毯上操作，會吸住地毯，難以前進。"
  },
  {
    "id": "dh5b",
    "chapter": "裝得進去，還推得動嗎",
    "text": "硬往前推，還曾經把輪子推裂。"
  },
  {
    "id": "3eq3",
    "chapter": "裝得進去，還推得動嗎",
    "text": "你平常只想把地掃乾淨，我聽到這裡卻先擔心：它能不能順利移動？"
  },
  {
    "id": "fphq",
    "chapter": "裝得進去，還推得動嗎",
    "text": "山本還提到另一種狀況：雜物堵住，馬達過熱，甚至使外殼熔損。"
  },
  {
    "id": "bz76",
    "chapter": "裝得進去，還推得動嗎",
    "text": "這些是試作過程裡不同問題的回憶，不能拼成同一台的一場事故。"
  },
  {
    "id": "4zh9",
    "chapter": "裝得進去，還推得動嗎",
    "text": "沒有集塵袋，空氣經過的地方，為什麼還是會堵？"
  },
  {
    "id": "mend",
    "chapter": "裝得進去，還推得動嗎",
    "text": "要看懂下一個改件，得先把灰塵走過的路分開。"
  },
  {
    "id": "qfdn",
    "chapter": "細灰之外，還有大雜物",
    "text": "一份一九八六年核准的美國專利，就把家用雜物的問題寫進說明。"
  },
  {
    "id": "25mq",
    "chapter": "細灰之外，還有大雜物",
    "text": "它談的是戴森的氣旋設計，遇到粗雜物和細灰時，該怎麼分工。"
  },
  {
    "id": "r3q7",
    "chapter": "細灰之外，還有大雜物",
    "text": "你也許會問，有了專利，為什麼還會有那麼多樣機工作？"
  },
  {
    "id": "mrvu",
    "chapter": "細灰之外，還有大雜物",
    "text": "更早一份美國專利的首頁，已列出一九七九年的英國優先權。"
  },
  {
    "id": "nbq7",
    "chapter": "細灰之外，還有大雜物",
    "text": "那份美國申請到一九八三年獲准，摘要寫了氣旋分離和集塵室。"
  },
  {
    "id": "3h94",
    "chapter": "細灰之外，還有大雜物",
    "text": "文件把方案留下來，地毯卻會讓實際使用的問題跑出來。"
  },
  {
    "id": "dx7a",
    "chapter": "細灰之外，還有大雜物",
    "text": "而專利本身也繼續處理細節，並不是一句無袋就把所有工作做完。"
  },
  {
    "id": "m5zm",
    "chapter": "細灰之外，還有大雜物",
    "text": "你在地上吸起來的，難道每一樣都和細灰一樣小嗎？"
  },
  {
    "id": "kizz",
    "chapter": "細灰之外，還有大雜物",
    "text": "專利指出，高效率氣旋若單獨處理較大的雜物，東西可能滯留、干擾運作。"
  },
  {
    "id": "m85a",
    "chapter": "細灰之外，還有大雜物",
    "text": "我覺得這個問題很實在：家裡的地板，不會先替吸塵器把垃圾分好。"
  },
  {
    "id": "qvxx",
    "chapter": "細灰之外，還有大雜物",
    "text": "它提出的辦法，是前面先用低效率氣旋，後面再接高效率氣旋。"
  },
  {
    "id": "j4z2",
    "chapter": "細灰之外，還有大雜物",
    "text": "前段先處理較粗的雜物，細灰再交給後段。"
  },
  {
    "id": "nkjg",
    "chapter": "細灰之外，還有大雜物",
    "text": "這裡的效率是在講分離工作，並不是說前段可以隨便做。"
  },
  {
    "id": "fbwd",
    "chapter": "細灰之外，還有大雜物",
    "text": "同一份說明裡，最後的氣流仍然可以經過濾網。"
  },
  {
    "id": "vc4h",
    "chapter": "細灰之外，還有大雜物",
    "text": "所以無袋，並不是整台沒有任何濾網，更不是每條通道都不會堵。"
  },
  {
    "id": "f2i9",
    "chapter": "細灰之外，還有大雜物",
    "text": "專利說的是當時提出的方案；日本樣機的入口問題，要回到山本的工作。"
  },
  {
    "id": "pm6d",
    "chapter": "細灰之外，還有大雜物",
    "text": "外圍旋轉的氣流，要進到裡面的錐體，入口怎麼辦？"
  },
  {
    "id": "g4ww",
    "chapter": "細灰之外，還有大雜物",
    "text": "山本指著一個有小孔的部件，說那是入口的孔罩。"
  },
  {
    "id": "26p7",
    "chapter": "細灰之外，還有大雜物",
    "text": "他說，若少了它，雜物容易堵在氣流進入錐體的入口。"
  },
  {
    "id": "88z5",
    "chapter": "細灰之外，還有大雜物",
    "text": "依他的回憶，他們把這個部件加進去，再試驗孔的大小和形狀。"
  },
  {
    "id": "mdxt",
    "chapter": "細灰之外，還有大雜物",
    "text": "要讓雜物繼續在外圍轉動，空氣則能經過入口往內走。"
  },
  {
    "id": "y6p7",
    "chapter": "細灰之外，還有大雜物",
    "text": "你看得到的是一圈小孔，我更想知道的是：孔改了，通過的東西會怎麼變？"
  },
  {
    "id": "grqj",
    "chapter": "細灰之外，還有大雜物",
    "text": "山本說，他們靠這些實驗，解決了那個入口的堵塞問題。"
  },
  {
    "id": "djxd",
    "chapter": "細灰之外，還有大雜物",
    "text": "這是入口這一件工作的答案，不是輪子、重量與所有過熱情況的通用解方。"
  },
  {
    "id": "bgmb",
    "chapter": "細灰之外，還有大雜物",
    "text": "但設計的人分處兩國，這些要改的地方，怎麼送到對方手上？"
  },
  {
    "id": "qaxx",
    "chapter": "圖紙得跨過海",
    "text": "山本說，戴森人在英國時，他們就一再用傳真往返。"
  },
  {
    "id": "rvd2",
    "chapter": "圖紙得跨過海",
    "text": "那篇訪談也放了工程圖紙和傳真頁的照片。"
  },
  {
    "id": "vgrd",
    "chapter": "圖紙得跨過海",
    "text": "你可以把合作想成這些紙張接著實驗走，不只是一份合約放在抽屜裡。"
  },
  {
    "id": "3qh9",
    "chapter": "圖紙得跨過海",
    "text": "山本回憶，他和戴森一起到工廠、畫圖，也一起做實驗。"
  },
  {
    "id": "pzz7",
    "chapter": "圖紙得跨過海",
    "text": "我喜歡這裡終於看得到工作的樣子：要改的東西，得落到圖面和現物上。"
  },
  {
    "id": "p6a5",
    "chapter": "圖紙得跨過海",
    "text": "依山本對合作約定的回憶，這些圖面和問題，最後仍由誰負責完成？"
  },
  {
    "id": "65q8",
    "chapter": "圖紙得跨過海",
    "text": "戴森也負有解決問題、完成圖面的責任。"
  },
  {
    "id": "333b",
    "chapter": "圖紙得跨過海",
    "text": "圖面還得完成，發現的問題要有人接著處理，工廠才能繼續往前做。"
  },
  {
    "id": "6v32",
    "chapter": "圖紙得跨過海",
    "text": "隔著傳真還不夠，他本人有沒有到日本工作？"
  },
  {
    "id": "v4g4",
    "chapter": "圖紙得跨過海",
    "text": "山本說，為了走到能販售的階段，戴森曾數度來日本。"
  },
  {
    "id": "7q3f",
    "chapter": "圖紙得跨過海",
    "text": "每次停留的時間，依他回憶，大約是一到兩週。"
  },
  {
    "id": "34kb",
    "chapter": "圖紙得跨過海",
    "text": "戴森官網還有一張製圖照片，圖說把地點列為東京西麻布。"
  },
  {
    "id": "xw4x",
    "chapter": "圖紙得跨過海",
    "text": "圖說寫的是一九八五年，正在重新設計後來G-Force的吸頭。"
  },
  {
    "id": "uuef",
    "chapter": "圖紙得跨過海",
    "text": "照片裡能看見人坐在製圖板前工作。"
  },
  {
    "id": "u4nc",
    "chapter": "圖紙得跨過海",
    "text": "那麼，合作的開始、授權的簽訂、商品推出，是不是同一個時間點？"
  },
  {
    "id": "ebcd",
    "chapter": "圖紙得跨過海",
    "text": "先別把它們擠進同一格日曆。"
  },
  {
    "id": "swdr",
    "chapter": "圖紙得跨過海",
    "text": "戴森在後來口述裡，把與Apex達成授權協議放在一九八六年。"
  },
  {
    "id": "wbef",
    "chapter": "圖紙得跨過海",
    "text": "而官網圖說記的日本改圖工作，更早一年就已經在進行。"
  },
  {
    "id": "knep",
    "chapter": "圖紙得跨過海",
    "text": "能穩妥接起來的，是八十年代中期的合作過程，而不是一個精確簽約日。"
  },
  {
    "id": "b7xq",
    "chapter": "圖紙得跨過海",
    "text": "對你來說，最後要等的是櫃台能買到；我也想問：那部商品何時出現？"
  },
  {
    "id": "p8mt",
    "chapter": "上了櫃台，也還是小眾",
    "text": "這篇訪談把日本G-Force的發售，放在一九八六年。"
  },
  {
    "id": "m5dg",
    "chapter": "上了櫃台，也還是小眾",
    "text": "英國V&A收藏的一件，也記為一九八六年、日本製造。"
  },
  {
    "id": "wcwg",
    "chapter": "上了櫃台，也還是小眾",
    "text": "但一件館藏的生產年份，不能直接充當一份完整的首售紀錄。"
  },
  {
    "id": "yzkk",
    "chapter": "上了櫃台，也還是小眾",
    "text": "如果你再找另一家博物館，會拿到完全相同的標籤嗎？"
  },
  {
    "id": "uxpi",
    "chapter": "上了櫃台，也還是小眾",
    "text": "香港M+把它的物件日期列為一九八三年。"
  },
  {
    "id": "pu45",
    "chapter": "上了櫃台，也還是小眾",
    "text": "科學博物館群的另一件，則列一九八五到一九九〇年。"
  },
  {
    "id": "hfwd",
    "chapter": "上了櫃台，也還是小眾",
    "text": "這些是各館對所藏物件的記錄，不能挑最早的數字，就宣布那年已上市。"
  },
  {
    "id": "t4dk",
    "chapter": "上了櫃台，也還是小眾",
    "text": "日期不同之外，製造者是不是也都寫同一家？"
  },
  {
    "id": "v5nv",
    "chapter": "上了櫃台，也還是小眾",
    "text": "M+另外列出Silver Seiko，其他館則列Apex。"
  },
  {
    "id": "hpmb",
    "chapter": "上了櫃台，也還是小眾",
    "text": "我會留住這些不同欄位，免得把進口公司的名字，直接當成它有一座自家工廠。"
  },
  {
    "id": "n6ei",
    "chapter": "上了櫃台，也還是小眾",
    "text": "產品終於走到市場，接下來是不是就成了暢銷故事？"
  },
  {
    "id": "inii",
    "chapter": "上了櫃台，也還是小眾",
    "text": "戴森在二〇一七年的口述裡，稱它是小眾商品。"
  },
  {
    "id": "mrr9",
    "chapter": "上了櫃台，也還是小眾",
    "text": "他還說，Apex賣這台機器，並沒有取得很大的商業成功。"
  },
  {
    "id": "cx76",
    "chapter": "上了櫃台，也還是小眾",
    "text": "但授權合作，確實替他帶來了一些收入。"
  },
  {
    "id": "i27z",
    "chapter": "上了櫃台，也還是小眾",
    "text": "你如果站在開發者那一邊，會先看見收入終於進來。"
  },
  {
    "id": "yjkh",
    "chapter": "上了櫃台，也還是小眾",
    "text": "可是收得到授權收入，和自己備好量產模具，還是兩件工作。"
  },
  {
    "id": "ijpu",
    "chapter": "上了櫃台，也還是小眾",
    "text": "下一步回到英國，誰願意先把模具的錢借給他？"
  },
  {
    "id": "jyqr",
    "chapter": "模具之後，還有櫃台",
    "text": "戴森回憶，到了一九九三年，銀行經理麥克佩奇替他向萊斯銀行爭取貸款。"
  },
  {
    "id": "cddk",
    "chapter": "模具之後，還有櫃台",
    "text": "那筆錢要用來準備模具；他說，這才讓自己能投入生產。"
  },
  {
    "id": "iaph",
    "chapter": "模具之後，還有櫃台",
    "text": "他說銀行最後答應借一百萬美元，這是他口述時記下的金額。"
  },
  {
    "id": "fsvs",
    "chapter": "模具之後，還有櫃台",
    "text": "換成你要開始做一批產品，我也會先問：錢到位以後，現場在哪裡？"
  },
  {
    "id": "3ag8",
    "chapter": "模具之後，還有櫃台",
    "text": "戴森自傳網站的一張照片，把第一條自家直立式吸塵器產線標在一九九三年。"
  },
  {
    "id": "i6fq",
    "chapter": "模具之後，還有櫃台",
    "text": "地點是英國奇彭納姆的邦帕斯農場。"
  },
  {
    "id": "x8ph",
    "chapter": "模具之後，還有櫃台",
    "text": "照片裡，多台機器排在工作線上，旁邊有人工作，也有紙箱。"
  },
  {
    "id": "xxar",
    "chapter": "模具之後，還有櫃台",
    "text": "到這裡，設計之外已經有了模具資金，也有一個能組裝、裝箱的生產現場。"
  },
  {
    "id": "2wtj",
    "chapter": "模具之後，還有櫃台",
    "text": "有了產線和箱子，通路就一定願意把機器擺上架嗎？"
  },
  {
    "id": "3z49",
    "chapter": "模具之後，還有櫃台",
    "text": "英國智慧財產局的一份決定書，記下戴森對一九九三年的回憶。"
  },
  {
    "id": "jtzs",
    "chapter": "模具之後，還有櫃台",
    "text": "他說，不少潛在零售商不喜歡透明的集塵筒。"
  },
  {
    "id": "f8m7",
    "chapter": "模具之後，還有櫃台",
    "text": "你家吸起來的灰塵，真的要讓人直接看見嗎？我能理解這個猶豫。"
  },
  {
    "id": "kiud",
    "chapter": "模具之後，還有櫃台",
    "text": "但他認為，使用者能看見灰塵的位置、理解運作，還能直接看見清掃的效果。"
  },
  {
    "id": "pwqd",
    "chapter": "模具之後，還有櫃台",
    "text": "依這份證詞，他仍選擇保留透明的設計。"
  },
  {
    "id": "hy2v",
    "chapter": "模具之後，還有櫃台",
    "text": "在那篇口述裡，他先找到一家郵購目錄買貨，之後再有第二家。"
  },
  {
    "id": "uver",
    "chapter": "模具之後，還有櫃台",
    "text": "後來，英國百貨公司約翰路易斯開始販售，也才接到更多通路。"
  },
  {
    "id": "6xye",
    "chapter": "模具之後，還有櫃台",
    "text": "日本合作補上的是把樣品推向商品的開發；我看來，它沒有替往後的資金與通路省下工作。"
  },
  {
    "id": "sptz",
    "chapter": "模具之後，還有櫃台",
    "text": "如果換成你接下這個案子，會先守住哪一步，才敢把產品交出去？留言告訴我。"
  },
  {
    "id": "5qtc",
    "chapter": "模具之後，還有櫃台",
    "text": "想繼續看日用品怎麼跨過這些實際難關，就訂閱品牌故事。"
  }
]
