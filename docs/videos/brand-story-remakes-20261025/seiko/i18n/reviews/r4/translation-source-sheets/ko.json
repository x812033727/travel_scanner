  "chapters": [
    {
      "scene": "skr1h01",
      "todo": true,
      "source": "四十五萬的錶，先回到工作台",
      "text": ""
    },
    {
      "scene": "skr1e01",
      "todo": true,
      "source": "振子、回路與馬達，擠進三公分",
      "text": ""
    },
    {
      "scene": "skr1p01",
      "todo": true,
      "source": "送到東京，價牌卻又要換",
      "text": ""
    },
    {
      "scene": "skr1r01",
      "todo": true,
      "source": "售出的錶，回來重新調整",
      "text": ""
    },
    {
      "scene": "skr1f01",
      "todo": true,
      "source": "走到爐邊，才看見少記的事",
      "text": ""
    },
    {
      "scene": "skr1c01",
      "todo": true,
      "source": "把手焊回路，接向下一代晶片",
      "text": ""
    },
    {
      "scene": "skr1d01",
      "todo": true,
      "source": "回路變小，還得留出能修的地方",
      "text": ""
    }
  ],
