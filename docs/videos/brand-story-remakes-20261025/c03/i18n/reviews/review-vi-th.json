      "fixes": [
        {
          "id": "r319021",
          "field": "lines.r319021.text",
          "kind": "facts",
          "severity": "major",
          "problem": "The comparison phrase “cùng nửa năm trước” is not a clear year-on-year half-year comparison. Preserve H1 2026 versus H1 2025 explicitly.",
          "suggested": "Doanh số khoảng 52,2 triệu euro, tăng 2,2% so với cùng kỳ năm trước.",
          "current": "Doanh số khoảng 52,2 triệu euro, tăng 2,2% so với cùng nửa năm trước.",
          "source": "銷售約五千兩百二十萬歐元，比上年同半年增加百分之二點二。"
        },
        {
          "id": "r305031",
          "field": "lines.r305031.text",
          "kind": "meaning",
          "severity": "major",
          "problem": "發行人 in the prospectus means the issuing company; “nhà xuất bản” changes the attribution to the earlier publisher. Keep this as the company’s conception.",
          "suggested": "Theo ý tưởng của công ty, người mua nhận cuốn sổ cũng nhận luôn vai trò tác giả.",
          "current": "Theo ý tưởng của nhà xuất bản, người mua nhận cuốn sổ cũng nhận luôn vị trí tác giả.",
          "source": "在發行人的構想裡，買的人接過本子，也接過作者的位置。"
        },
        {
          "id": "r310021",
          "field": "lines.r310021.text",
          "kind": "readability",
          "severity": "minor",
          "problem": "“sản phẩm viết, du lịch và đọc” is not natural Vietnamese for products serving writing, travelling and reading. Make those purposes explicit.",
          "suggested": "Sở giao dịch Ý mô tả họ là tập đoàn kinh doanh các sản phẩm phục vụ việc viết lách, du lịch và đọc sách.",
          "current": "Sở giao dịch Ý mô tả họ là tập đoàn kinh doanh sản phẩm viết, du lịch và đọc.",
          "source": "義大利交易所把它描述為經營書寫、旅行與閱讀商品的集團。"
        },
        {
          "id": "r312051",
          "field": "lines.r312051.text",
          "kind": "readability",
          "severity": "minor",
          "problem": "“cửa hàng mạng” is an unnatural label for an online store in this Hanoi register. Use the usual term, consistently with r316011.",
          "suggested": "Mạng lưới bán buôn, cửa hàng riêng và cửa hàng trực tuyến ấy thu hút một bên mua vốn rất xa ngành giấy.",
          "current": "Mạng lưới bán buôn, cửa hàng riêng và cửa hàng mạng ấy thu hút một bên mua vốn rất xa ngành giấy.",
          "source": "這張由批發、直營和網店接成的網，吸引了一個原本離紙張很遠的買方。"
        },
        {
          "id": "r3t031",
          "field": "lines.r3t031.text",
          "kind": "readability",
          "severity": "minor",
          "problem": "“công ty sổ” is an unnatural noun construction. State that this is the company selling the notebooks.",
          "suggested": "Giá ấy dùng để mua cổ phần, không phải gửi từng ấy tiền vào tài khoản của công ty bán sổ.",
          "current": "Giá ấy dùng để mua cổ phần, không phải gửi từng ấy tiền vào tài khoản công ty sổ.",
          "source": "這個價錢是拿來買股份，不是把同額現金存進本子公司的帳戶。"
        },
        {
          "id": "r316011",
          "field": "lines.r316011.text",
          "kind": "readability",
          "severity": "minor",
          "problem": "“cửa hàng mạng” and “cải thiện mua sắm” sound translated. Use “cửa hàng trực tuyến” and preserve the shopping-experience concept and the operational-work question.",
          "suggested": "Doanh số cửa hàng trực tuyến giảm trong năm chuyển sang nền tảng mới. Đầu tư cải thiện trải nghiệm mua sắm còn cần thêm những công việc vận hành nào?",
          "current": "Doanh số cửa hàng mạng giảm trong năm đổi nền tảng. Đầu tư cải thiện mua sắm còn cần thêm việc vận hành nào?",
          "source": "網店則在遷移到新平台的那一年，銷售下降。改善購物體驗的投資，還得加上哪些營運工作？"
        },
        {
          "id": "r320041",
          "field": "lines.r320041.text",
          "kind": "readability",
          "severity": "minor",
          "problem": "The closing invitation has broken word order (“Để qua đồ dùng hằng ngày hiểu cái tên thành việc kinh doanh”). Restore a natural sentence while retaining the name-to-business idea, everyday objects, real-world challenges and subscription invitation in source cue order.",
          "suggested": "Muốn tiếp tục tìm hiểu qua đồ dùng hằng ngày xem một cái tên trở thành một hoạt động kinh doanh ra sao, và phải đối mặt với những thử thách thực tế nào, bạn hãy đăng ký kênh.",
          "current": "Để qua đồ dùng hằng ngày hiểu cái tên thành việc kinh doanh, gặp thử thách thực tế nào, mời bạn đăng ký.",
          "source": "想繼續從日用品看懂一個名字怎麼變成生意，還要面對哪些現實考驗，歡迎訂閱。"
        },
        {
          "id": "chapter:c03r-p17s01",
          "field": "chapters.c03r-p17s01",
          "kind": "metadata",
          "severity": "minor",
          "problem": "“Hàng về, còn xét lại tên tuổi” is an unnatural chapter label and obscures replenishment recovering while the brand still faces a test.",
          "suggested": "Nhập hàng hồi phục, thương hiệu vẫn chịu thử thách",
          "current": "Hàng về, còn xét lại tên tuổi",
          "source": "補貨回來了，名字仍要接受檢驗"
        }
      ],
