[
  {
    "id": "rs0001",
    "chapter": "開場｜兩個包與一張圖",
    "text": "你帶兩個包趕飛機，少拆一次，就少一次手忙腳亂。"
  },
  {
    "id": "rs0002",
    "chapter": "開場｜兩個包與一張圖",
    "text": "艾默記得，在西雅圖機場，普拉斯從包裡拿出圖紙，給舊輪箱的製作者看。"
  },
  {
    "id": "rs0005",
    "chapter": "開場｜兩個包與一張圖",
    "text": "行李箱的把手拉起來，要靠什麼留在原位？"
  },
  {
    "id": "rs0006",
    "chapter": "開場｜兩個包與一張圖",
    "text": "另一個包掛上去前，那條帶子又得先調到哪裡？"
  },
  {
    "id": "rs0007",
    "chapter": "開場｜兩個包與一張圖",
    "text": "今天我想跟你看普拉斯的輪子行李箱，追查一台外架帶來的拆裝難題。"
  },
  {
    "id": "rs0008",
    "chapter": "開場｜兩個包與一張圖",
    "text": "它究竟把旅行中的哪段麻煩，收進自己身體裡？"
  },
  {
    "id": "rs0009",
    "chapter": "一｜輪架已經能走",
    "text": "艾默先把舊輪箱攤給我們看：厚實的鋁架，托著一只帆布袋。"
  },
  {
    "id": "rs0010",
    "chapter": "一｜輪架已經能走",
    "text": "袋子綁在管狀支架上，下方有托架，上方還有一層承放位置。"
  },
  {
    "id": "rs0011",
    "chapter": "一｜輪架已經能走",
    "text": "普拉斯喜歡的，是直立時上方的小拉鍊空間，方便拿鑰匙、眼鏡和皮夾。"
  },
  {
    "id": "rs0012",
    "chapter": "一｜輪架已經能走",
    "text": "再往下的大拉鍊空間，還能放進文件包。"
  },
  {
    "id": "rs0013",
    "chapter": "一｜輪架已經能走",
    "text": "我覺得這個起點很有意思：好用的部分，他已經在用。"
  },
  {
    "id": "rs0014",
    "chapter": "一｜輪架已經能走",
    "text": "真正要改的，會不會是輪子和箱子之間的關係？"
  },
  {
    "id": "rs0015",
    "chapter": "一｜輪架已經能走",
    "text": "你如果只是想讓手上的箱子開始滾動，這件事早就有人做到了。"
  },
  {
    "id": "rs0016",
    "chapter": "一｜輪架已經能走",
    "text": "早在一九四三年，凱利就申請過一種手提行李附件的專利。"
  },
  {
    "id": "rs0017",
    "chapter": "一｜輪架已經能走",
    "text": "一九四六年核發的文件，已經畫到箱底的輪件和拉把。"
  },
  {
    "id": "rs0018",
    "chapter": "一｜輪架已經能走",
    "text": "所以這場故事的起點，並不是等人突然想到「輪子」兩個字。"
  },
  {
    "id": "rs0019",
    "chapter": "一｜輪架已經能走",
    "text": "普拉斯描述的外架，用彈力繩綁住行李；你過安檢時，要先拆哪一件？"
  },
  {
    "id": "rs0020",
    "chapter": "一｜輪架已經能走",
    "text": "照他的問題設定，到了安檢，整組要拆開，行李分別送過去。"
  },
  {
    "id": "rs0021",
    "chapter": "一｜輪架已經能走",
    "text": "通過後再把行李疊回去，重新綁好，才繼續往登機門走。"
  },
  {
    "id": "rs0022",
    "chapter": "一｜輪架已經能走",
    "text": "上飛機要收納時，又得把外架和行李分開。"
  },
  {
    "id": "rs0023",
    "chapter": "一｜輪架已經能走",
    "text": "下機以後重新裝載，還要記住那台外架，本身也是一件東西。"
  },
  {
    "id": "rs0024",
    "chapter": "一｜輪架已經能走",
    "text": "我光想到找個地方攤開繩子，就想問：能不能少顧一件東西？"
  },
  {
    "id": "rs0025",
    "chapter": "一｜輪架已經能走",
    "text": "你現在可以先看著那條繩：它綁得住兩件東西，也表示兩件東西還沒有成為一件。"
  },
  {
    "id": "rs0026",
    "chapter": "一｜輪架已經能走",
    "text": "輪架的製作者就在眼前，普拉斯會直接請他做一個新版本嗎？"
  },
  {
    "id": "rs0003",
    "chapter": "二｜圖紙等了兩週",
    "text": "還記得開場那張圖嗎？製作者穆林斯答應，把構想給夥伴達奇看。"
  },
  {
    "id": "rs0029",
    "chapter": "二｜圖紙等了兩週",
    "text": "那件工具叫傑特伊茲，普拉斯雖然喜歡它的方便，卻嫌它像臨時手做的。"
  },
  {
    "id": "rs0031",
    "chapter": "二｜圖紙等了兩週",
    "text": "我看到這裡，會跟你一樣想問：找熟悉這種工具的人，事情會比較快嗎？"
  },
  {
    "id": "rs0032",
    "chapter": "二｜圖紙等了兩週",
    "text": "隔一週，他們又在那個航廈遇見穆林斯。"
  },
  {
    "id": "rs0033",
    "chapter": "二｜圖紙等了兩週",
    "text": "回程中，艾默問普拉斯，提案有沒有得到回音。"
  },
  {
    "id": "rs0034",
    "chapter": "二｜圖紙等了兩週",
    "text": "答案是穆林斯還沒找到機會跟達奇談，不過答應很快會談。"
  },
  {
    "id": "rs0035",
    "chapter": "二｜圖紙等了兩週",
    "text": "那再等一週，這張圖終於會走進製作嗎？"
  },
  {
    "id": "rs0036",
    "chapter": "二｜圖紙等了兩週",
    "text": "又過一週，再次遇見穆林斯之後，普拉斯帶回了另一個答覆。"
  },
  {
    "id": "rs0037",
    "chapter": "二｜圖紙等了兩週",
    "text": "兩人討論過，對這個構想沒有興趣。"
  },
  {
    "id": "rs0038",
    "chapter": "二｜圖紙等了兩週",
    "text": "這份回憶裡，讓我停下來的不是一句勵志口號，是一張圖等了兩週，停在這裡。"
  },
  {
    "id": "rs0040",
    "chapter": "二｜圖紙等了兩週",
    "text": "接下來，普拉斯真的把哪一步做出來了？"
  },
  {
    "id": "rs0041",
    "chapter": "二｜圖紙等了兩週",
    "text": "艾默往下寫，普拉斯自己發展了這個概念，做成後來的產品。"
  },
  {
    "id": "rs0042",
    "chapter": "二｜圖紙等了兩週",
    "text": "回憶在這裡跨過了中間的打樣過程，沒有逐台樣品的記錄。"
  },
  {
    "id": "rs0043",
    "chapter": "二｜圖紙等了兩週",
    "text": "但他申請的專利，讓我們能打開另一扇門，看輪、箱、把手怎麼放在一起。"
  },
  {
    "id": "rs0044",
    "chapter": "二｜圖紙等了兩週",
    "text": "要把一台外架收掉，第一個問題是：輪子本身要放哪裡？"
  },
  {
    "id": "rs0045",
    "chapter": "三｜把輪子放進箱角",
    "text": "在普拉斯的專利設計裡，兩個輪子收進箱體下方。"
  },
  {
    "id": "rs0046",
    "chapter": "三｜把輪子放進箱角",
    "text": "圖八把輪組拆開來看，輪軸固定在一片支撐板上。"
  },
  {
    "id": "rs0047",
    "chapter": "三｜把輪子放進箱角",
    "text": "板上留有開口容納輪子，固定片則把輪軸留在原位。"
  },
  {
    "id": "rs0048",
    "chapter": "三｜把輪子放進箱角",
    "text": "箱體後方與底部的輪井包住輪組，外面只露出輪子的一小部分。"
  },
  {
    "id": "rs0049",
    "chapter": "三｜把輪子放進箱角",
    "text": "我喜歡這個改變的地方，是箱子不必先坐上一台車，才有輪子可以用。"
  },
  {
    "id": "rs0051",
    "chapter": "三｜把輪子放進箱角",
    "text": "不過它站著等你的時候，靠哪裡支撐？"
  },
  {
    "id": "rs0052",
    "chapter": "三｜把輪子放進箱角",
    "text": "箱底還有兩個支腳；直立不動時，它們負責支撐和平衡。"
  },
  {
    "id": "rs0053",
    "chapter": "三｜把輪子放進箱角",
    "text": "那要走了，是拖著這兩個支腳在地上磨嗎？"
  },
  {
    "id": "rs0054",
    "chapter": "三｜把輪子放進箱角",
    "text": "操作例子是先拉出把手，再把箱子向後傾，讓支腳離開地面。"
  },
  {
    "id": "rs0055",
    "chapter": "三｜把輪子放進箱角",
    "text": "接地的工作轉給輪子，使用者就能拉著它滾動。"
  },
  {
    "id": "rs0056",
    "chapter": "三｜把輪子放進箱角",
    "text": "專利以偏離垂直約三十度為例，說明這個切換動作。"
  },
  {
    "id": "rs0057",
    "chapter": "三｜把輪子放進箱角",
    "text": "停下與出發，讓同一個箱子用不同部位碰地；這是設計的使用順序。"
  },
  {
    "id": "rs0058",
    "chapter": "三｜把輪子放進箱角",
    "text": "輪子旁邊還圍著一圈凸出的保護部位，它要接住什麼？"
  },
  {
    "id": "rs0059",
    "chapter": "三｜把輪子放進箱角",
    "text": "專利把它稱作保護凸緣，用來減少箱子被拖、被推倒時，外表受損。"
  },
  {
    "id": "rs0060",
    "chapter": "三｜把輪子放進箱角",
    "text": "作者也描述，這個部位能在上路緣時保護箱子布面。"
  },
  {
    "id": "rs0061",
    "chapter": "三｜把輪子放進箱角",
    "text": "輪子找到了位置，我接著想試的，是你手上那支拉把：拉出去，怎麼留得住？"
  },
  {
    "id": "rs0062",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "把手從箱子頂部往上拉，兩支杆在箱內的套筒中滑動。"
  },
  {
    "id": "rs0063",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "杆子的下端，各連著一個導件，而且杆和導件的中心沒有完全對齊。"
  },
  {
    "id": "rs0064",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "你可以把目光放在這個小小的偏心位置，它才是接下來的關鍵。"
  },
  {
    "id": "rs0065",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "這個不對正的連接，會在拉到上方時做什麼？"
  },
  {
    "id": "rs0066",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "依專利說明，導件使杆子的下端楔住，杆和套筒、襯套之間產生摩擦。"
  },
  {
    "id": "rs0067",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "這股摩擦把拉把留在伸出的位置，讓人握著它拖行。"
  },
  {
    "id": "rs0068",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "我原本也會去找一個卡榫，這裡真正工作的，卻是杆子和導件之間的位置關係。"
  },
  {
    "id": "rs0069",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "可是你走到座位旁，要把箱子收起來，這種鎖法怎麼解開？"
  },
  {
    "id": "rs0070",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "操作是往下壓把手，施力克服原先把杆留住的摩擦。"
  },
  {
    "id": "rs0071",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "導件離開楔緊的位置，再往套筒下方移動，杆子就能跟著縮入。"
  },
  {
    "id": "rs0073",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "這只箱子，就一定放得進機艙嗎？"
  },
  {
    "id": "rs0074",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "專利有一個實施例，長二十二點五、寬十四點五、深八英吋。"
  },
  {
    "id": "rs0075",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "它把放進座下或頭頂置物處，列作設計的收納目的。"
  },
  {
    "id": "rs0076",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "我會把這組數字當成這個例子的外形，搭機時還是得對照你那班飛機的限制。"
  },
  {
    "id": "rs0077",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "到這裡，從走路到收納，主要動作都繞著同一只箱子進行。"
  },
  {
    "id": "rs0078",
    "chapter": "四｜拉把靠摩擦留住",
    "text": "可是機師出門，旁邊那個飛行包，還得留在另一隻手上嗎？"
  },
  {
    "id": "rs0079",
    "chapter": "五｜讓第二個包一起站",
    "text": "艾默寫，普拉斯又在箱頂加了一條可調帶子，帶著掛鉤。"
  },
  {
    "id": "rs0080",
    "chapter": "五｜讓第二個包一起站",
    "text": "上面可以承放飛行包，或另一只手提袋。"
  },
  {
    "id": "rs0081",
    "chapter": "五｜讓第二個包一起站",
    "text": "你可能會先把包掛上去就走；但帶子長短，還會改變什麼？"
  },
  {
    "id": "rs0082",
    "chapter": "五｜讓第二個包一起站",
    "text": "照艾默的說明，長度調好之後，主箱直立，旁邊的包會落到地上。"
  },
  {
    "id": "rs0084",
    "chapter": "五｜讓第二個包一起站",
    "text": "開始傾拉時，艾默認為附包的重量分布，反而讓組合更平衡。"
  },
  {
    "id": "rs0085",
    "chapter": "五｜讓第二個包一起站",
    "text": "我覺得這才是很日常的要求：我停下來找東西時，行李也得有辦法停下來。"
  },
  {
    "id": "rs0086",
    "chapter": "五｜讓第二個包一起站",
    "text": "這種接法，在普拉斯的專利裡，也找得到具體零件嗎？"
  },
  {
    "id": "rs0087",
    "chapter": "五｜讓第二個包一起站",
    "text": "圖七畫了一只大致呈Ｊ形的鉤，外端向上，托住額外的物件。"
  },
  {
    "id": "rs0088",
    "chapter": "五｜讓第二個包一起站",
    "text": "柔性的帶子穿過鉤上的槽，再用按扣和箱子連接。"
  },
  {
    "id": "rs0089",
    "chapter": "五｜讓第二個包一起站",
    "text": "這個掛鉤還能拆下。"
  },
  {
    "id": "rs0090",
    "chapter": "五｜讓第二個包一起站",
    "text": "艾默講的是他看到的用法，專利留下的是結構；兩邊能照見同一個需求。"
  },
  {
    "id": "rs0096",
    "chapter": "五｜讓第二個包一起站",
    "text": "箱子和附包終於能一起走，那接下來，誰會想要另一只？"
  },
  {
    "id": "rs0097",
    "chapter": "六｜別人也要一只",
    "text": "二〇〇七年，旅行媒體訪問當時的公司執行長巴利斯，他提到其他機師的反應。"
  },
  {
    "id": "rs0098",
    "chapter": "六｜別人也要一只",
    "text": "按他的說法，同事看見普拉斯用的輪箱，就請他也替自己做一只。"
  },
  {
    "id": "rs0099",
    "chapter": "六｜別人也要一只",
    "text": "我覺得這個請求很有分量：工具被帶到工作路上，旁邊的人就能看見它怎麼用。"
  },
  {
    "id": "rs0100",
    "chapter": "六｜別人也要一只",
    "text": "但你在車庫裡做得出一只，接到更多請求之後，還待得下去嗎？"
  },
  {
    "id": "rs0101",
    "chapter": "六｜別人也要一只",
    "text": "旅行寶公司的沿革，把一九八九年記作需求增長、從車庫搬到倉庫的一年。"
  },
  {
    "id": "rs0102",
    "chapter": "六｜別人也要一只",
    "text": "同年八月八日，普拉斯提出這份輪箱與行李支撐的專利申請。"
  },
  {
    "id": "rs0103",
    "chapter": "六｜別人也要一只",
    "text": "兩件事同年發生，申請專利卻不是那天才開始有箱子可用。"
  },
  {
    "id": "rs0104",
    "chapter": "六｜別人也要一只",
    "text": "那封面上的另一個日期，又在說哪件事？"
  },
  {
    "id": "rs0105",
    "chapter": "六｜別人也要一只",
    "text": "一九九一年二月二十六日，是專利核發日，距離申請已經一年多。"
  },
  {
    "id": "rs0106",
    "chapter": "六｜別人也要一只",
    "text": "公司沿革則記載，普拉斯在一九九一年退休，轉為全職經營旅行寶。"
  },
  {
    "id": "rs0107",
    "chapter": "六｜別人也要一只",
    "text": "這個故事落在八〇年代末到九〇年代初，圖紙、產品、申請與核發，各有自己的時間。"
  },
  {
    "id": "rs0108",
    "chapter": "六｜別人也要一只",
    "text": "我最想留下的，是一個拿來走路的工具，最後還得回答停下、收回、再多帶一包。"
  },
  {
    "id": "rs0109",
    "chapter": "六｜別人也要一只",
    "text": "所以回到你出發時的那個問題，普拉斯到底收進了哪一段麻煩？"
  },
  {
    "id": "rs0110",
    "chapter": "六｜別人也要一只",
    "text": "他把另外照顧輪架的麻煩收進箱體，再讓第二個包跟著主箱停放、一起走。"
  },
  {
    "id": "rs0111",
    "chapter": "六｜別人也要一只",
    "text": "如果是你，會先改行李的哪個動作：拖著走、停下來，還是收進去？留言告訴我。"
  },
  {
    "id": "rs0112",
    "chapter": "六｜別人也要一只",
    "text": "想繼續看日用品怎麼把一個小麻煩改成具體設計，訂閱一起追下去。"
  }
]
