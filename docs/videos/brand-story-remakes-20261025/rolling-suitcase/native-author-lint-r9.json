      "after_next_id": "rs0100"
    },
    {
      "id": "rs0107",
      "action": "delete_same_class_pure_recap_and_schema_required_attached_shot",
      "before": "這個故事落在八〇年代末到九〇年代初，圖紙、產品、申請與核發，各有自己的時間。",
      "reason": "把已敘圖紙、產品、申請與核發又包成時段總覽；精確日期rs0102/105/106及來源歧異界線保留。",
      "after_previous_id": "rs0106",
      "after_next_id": "rs0109"
