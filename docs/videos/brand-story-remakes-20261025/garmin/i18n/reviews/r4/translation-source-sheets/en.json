  "chapters": [
    {
      "scene": "gr1h01",
      "todo": true,
      "source": "手腕上的錶，還在等天空",
      "text": ""
    },
    {
      "scene": "gr1s01",
      "todo": true,
      "source": "先充好電，再等訊號條消失",
      "text": ""
    },
    {
      "scene": "gr1p01",
      "todo": true,
      "source": "坐標變成配速，還得讓人看懂",
      "text": ""
    },
    {
      "scene": "gr1r01",
      "todo": true,
      "source": "重設之前，先把這一跑留下來",
      "text": ""
    },
    {
      "scene": "gr1a01",
      "todo": true,
      "source": "天線沿著手腕，朝天空轉過去",
      "text": ""
    },
    {
      "scene": "gr1d01",
      "todo": true,
      "source": "記得更細，能留下的時間反而變短",
      "text": ""
    },
    {
      "scene": "gr1v01",
      "todo": true,
      "source": "二零零九年，記錄到了軟體裡",
      "text": ""
    }
  ],
