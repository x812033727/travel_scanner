  "delta_rows": [
    {
      "line_id": "c09r008",
      "before_r2": "要知道這個改變牽動什麼，得先把那枚釘子放回攀岩者的器材袋；它原本真的解決了一個麻煩。",
      "after": "想像你打開當年的器材袋，裡面一枚枚軟鐵釘，都是攀岩者為長路線準備的工具。",
      "source_verdict": "PASS",
      "written_visual_verdict": "PASS",
      "source": [
        "S4"
      ],
      "evidence": "S4 Ascending第124段支持早期軟鐵釘與長路線器材攜帶情境；新句想像明示概念，不添已發生的器材袋事件。"
    },
    {
      "line_id": "c09r026",
      "before_r2": "問題出在順手的另一面。一九六七年，",
      "after": "一九六七年，修納德與夥伴把岩釘的用法寫成文章，",
      "source_verdict": "PASS",
      "written_visual_verdict": "PASS",
      "source": [
        "S1"
      ],
      "evidence": "S1 1967年文章及Chouinard/Frost署名；新句直接開始寫作事件，不添日期/動機。"
    },
    {
      "line_id": "c09r027",
      "before_r2": "修納德與夥伴寫的器材文章，把放入、拔出岩釘當成重要技藝。",
      "after": "記錄攀岩者怎麼放入、拔出釘子。",
      "source_verdict": "PASS",
      "written_visual_verdict": "PASS",
      "source": [
        "S1"
      ],
      "evidence": "S1有放置與拔出岩釘技術；縮句保留技術內容，與026連讀沒有新主張。"
    },
    {
      "line_id": "c09r055",
      "before_r2": "其他合適的路線，先試可拆楔塊，不把所有裂縫當成一樣。",
      "after": "其他合適的路線，照剛才那個次序先試可拆楔塊，不把所有裂縫當成一樣。",
      "source_verdict": "PASS",
      "written_visual_verdict": "PASS",
      "source": [
        "S2"
      ],
      "evidence": "S2前言123–124段先考慮chocks、必要時固定釘的限定；加回呼不改條件，不成普遍安全保證。"
    },
    {
      "line_id": "c09r104",
      "before_r2": "想一起看懂熟悉品牌背後這些不太乾脆的選擇，歡迎訂閱奇聞檔案局。",
      "after": "想一起看懂熟悉品牌背後這些不太乾脆的選擇，歡迎訂閱這個頻道。",
      "source_verdict": "PASS",
      "written_visual_verdict": "PASS",
      "source": [
        "EDITORIAL"
      ],
      "evidence": "通用頻道CTA替換錯配系列名稱，非史實。"
    }
  ],
