  {
    "id": "c09r029",
    "chapter": "idea",
    "text": "它把釘子按尺寸分類，還談怎麼隨身帶著，讓人迅速找到合用的一枚，少在岩壁上手忙腳亂。",
    "source": "S1",
    "anchor": "尺寸分類與攜帶段",
    "status": "PENDING_INDEPENDENT_REVIEW",
    "parent_row": 28,
    "candidate_basis": "retained_base_text"
  },
  {
    "id": "c09le007",
    "chapter": "idea",
    "text": "尺寸還連著攜帶動作：薄片釘和較厚的釘分組掛在扣環，扣環開口的方向也得安排。",
    "source": "S1",
    "anchor": "將分類落到分組懸掛及扣環方向的具體器材動作。",
    "status": "PENDING_INDEPENDENT_REVIEW",
    "candidate_basis": "sourced_expansion_with_narrative_connection",
    "short_anchor_phrase": "one hand",
    "candidate_evidence": [
      {
        "source": "S1",
        "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S1.paragraphs.txt",
