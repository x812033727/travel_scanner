        "paragraph": "013",
        "paragraph_sha256": "baecdc63eebb4a06e84f7462c2b03a8340f7968601ec9f4b86e8a72e3570778a"
      },
      {
        "source": "S1",
        "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S1.paragraphs.txt",
        "cache_sha256": "f1c68d850f653f19cfd350c76c61a22bb3afe7d4c716b4931d3d2411514e3536",
        "paragraph": "014",
        "paragraph_sha256": "ba17c582f058462cc511bc80b800ba0c0be47a272ba25dc24a2e20e76783c18e"
      }
    ]
  },
  {
    "id": "c09le008",
    "chapter": "idea",
    "text": "文章還要人一隻手就能取下、掛回；回收一段路線的釘子時先排好，免得到末尾才停下分類。",
    "source": "S1",
    "anchor": "補單手取掛與回收時預先排序的效率取捨，限定為1967文中主張。",
    "status": "PENDING_INDEPENDENT_REVIEW",
    "candidate_basis": "sourced_expansion_with_narrative_connection",
    "short_anchor_phrase": "sorting",
    "candidate_evidence": [
      {
        "source": "S1",
        "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S1.paragraphs.txt",
