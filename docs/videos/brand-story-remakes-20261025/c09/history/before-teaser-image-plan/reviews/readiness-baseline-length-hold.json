  "original_sources": [
    {
      "source_id": "S1",
      "url": "https://publications.americanalpineclub.org/articles/12196733400/On-New-Rock-Climbing-Equipment-and-Its-Use",
      "document_layer": "1967 當事人具名器材文章；頁面 Year 為1967",
      "anchors": [
        {
          "paragraphs": [
            2,
            4
          ],
          "quote": "placing and removing 100 pitons a day",
          "supports": "一組熟練結繩攀登者的例示，非個人、平均或同一孔100次。"
        },
        {
          "paragraphs": [
            13,
            14,
            28,
            29
          ],
          "quote": "in an order according to their size",
          "supports": "尺寸分類、隨身整理及迅速選用器材；不新增現代攀登操作保證。"
        }
      ],
      "http_status_observed": 200,
      "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S1.html",
      "actual_html_bytes": 32948,
      "actual_html_sha256": "daabafd3b986b268219b00812e84fedb7a1dd4d6078a4aeb4798a17c27fed19d",
      "paragraph_text_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S1.paragraphs.txt",
      "paragraph_text_sha256": "f1c68d850f653f19cfd350c76c61a22bb3afe7d4c716b4931d3d2411514e3536",
      "retrieved_at_utc": "2026-10-25T16:27:20.852312+00:00"
    },
    {
      "source_id": "S2",
      "url": "https://www.patagonia.com/stories/sports/climbing/a-word/story-116598.html",
      "document_layer": "2022-02-10站頁全文重刊1972前言；原前言是段027–036，不能用2022導讀的概括蓋過原文例外。",
      "anchors": [
        {
          "paragraphs": [
            29
          ],
          "quote": "the cracks are degenerating into series of piton holes",
          "supports": "熱門路線成排釘孔；同段明說合金鋼硬於花崗岩及重複敲拔鬆落岩片。"
        },
        {
          "paragraphs": [
            30
          ],
          "quote": "Do not use pitons on established clean routes.",
          "supports": "原本無釘路線維持無釘，適用條件不可刪。"
        },
        {
          "paragraphs": [
            30
          ],
          "quote": "Where a piton is necessary a fixed piton should be considered and documented in local guide books.",
          "supports": "保留必要時固定岩釘及指南記錄；不是全面停售或禁止一切使用。"
        },
        {
          "paragraphs": [
            34,
            36
          ],
          "quote": "Employ restraint and good judgment in the use of Chouinard equipment.",
          "supports": "倡議節制、自我責任與攀登方式；不是主張所有岩釘已停產。"
        },
        {
          "paragraphs": [
            30
          ],
          "quote": "It was written especially for this catalog.",
          "supports": "Doug Robinson 為型錄所寫長文；同段英國磨亮足點與完整保護裂縫的例示。"
        },
        {
          "paragraphs": [
            43
          ],
          "quote": "Yvon Chouinard is the founder of Patagonia, Inc.",
          "supports": "作者簡介支持後來創辦Patagonia，不把1972器材公司改名為當時Patagonia。"
        }
      ],
      "http_status_observed": 200,
      "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S2.html",
      "actual_html_bytes": 258609,
      "actual_html_sha256": "21e79cd2c458e5c11fbd965da5a5df8bc5ff3f9ef3c740dc6a49d8648edf992c",
      "paragraph_text_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S2.paragraphs.txt",
      "paragraph_text_sha256": "50c2e079d5f8c4416c95ce12368081bf758d449084352f6e2c8a17cd7603d83a",
      "retrieved_at_utc": "2026-10-25T16:27:20.467503+00:00"
    },
    {
      "source_id": "S3",
      "url": "https://publications.americanalpineclub.org/articles/12197352200/Chouinard-Equipment",
      "document_layer": "AAJ頁面 Year為1973；同期Rowell書評，所評型錄書目列1972與72頁。",
      "anchors": [
        {
          "paragraphs": [
            1
          ],
          "quote": "1972. 72 pages",
          "supports": "1973是書評年份；72頁是所評型錄，不能把型錄初版年改成1973。"
        },
        {
          "paragraphs": [
            3
          ],
          "quote": "he was privately accused of hypocrisy",
          "supports": "記錄外部指責，不是公司承認內部財務動機；Rowell下文反駁該指責。"
        },
        {
          "paragraphs": [
            4
          ],
          "quote": "An increasing number of climbers I meet in Yosemite",
          "supports": "更多無錘攀登者是書評作者個人觀察，不作全體比例或統計。"
        },
        {
          "paragraphs": [
            5
          ],
          "quote": "their freedom as an individual in the mountains is at stake",
          "supports": "少數反對者的自由與大岩壁可行性疑慮；保持觀點歸屬。"
        }
      ],
      "http_status_observed": 200,
      "cache_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S3.html",
      "actual_html_bytes": 17730,
      "actual_html_sha256": "5e650b687a3c1d2d22905fe453b72b7fd059e3f02a7eb149e2f349553b2fd498",
      "paragraph_text_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S3.paragraphs.txt",
      "paragraph_text_sha256": "436ee77e5956f640034df4c4e85497e63b413792e0c5b6a24ad2e28b60d49af7",
      "retrieved_at_utc": "2026-10-25T16:27:20.724187+00:00"
    },
    {
      "source_id": "S4",
      "url": "https://www.newyorker.com/magazine/1977/01/31/ascending",
      "document_layer": "Bernstein《Ascending》；頁面顯示1977-01-24、雜誌路徑/issue為1977-01-31，皆僅刊載資訊，本文未確認訪問年份。",
      "anchors": [
        {
          "paragraphs": [
            28,
            31
          ],
          "quote": "These pitons were not meant to be used over and over",
          "supports": "早期軟鐵釘與1946 Salathé可重用硬鋼先例；未歸Chouinard發明。"
        },
        {
          "paragraphs": [
            33
          ],
          "quote": "In 1957, when I started my equipment business",
          "supports": "本人回憶供應不足、買煤爐鐵砧及沿岸手鍛；不是同期供貨統計。"
        },
        {
          "paragraphs": [
            35
          ],
          "quote": "I could make two pitons an hour.",
          "supports": "本人稱每小時2枚；同段本人回憶US$1.50對約US$0.30及夏售冬備貨。"
        },
        {
          "paragraphs": [
            45
          ],
          "quote": "Don’t expect speedy delivery in the months of May, June, July, August, and September.",
          "supports": "承接段044的1964當年秋天首張型錄；同段支持1966 Ventura鐵路旁設址、Frost航空工程背景與模具機械化。"
        },
        {
          "paragraphs": [
            7,
            8
          ],
          "quote": "back in 1959 and 1960",
          "supports": "英國楔塊前史、Chouinard早期使用；1970回信仍是不同時點立場。"
        },
        {
          "paragraphs": [
            8
          ],
          "quote": "Small cracks that could once take only rurps now needed large pitons",
          "supports": "原裂縫擴寬後須更大釘子；支持002假想與037，不從1967百枚例示推同孔損傷次數。"
        },
        {
          "paragraphs": [
            9
          ],
          "quote": "As an answer, in 1973 Chouinard and a Washington climber named Bruce Carson",
          "supports": "079的年份直接明寫1973；伙伴為Bruce Carson，不是藉鄰近字幕猜年，也不可新增Tom Frost為此行伙伴。"
        },
        {
          "paragraphs": [
            9
          ],
          "quote": "climbed the Nose route on El Capitan taking only chocks along—not pitons.",
          "supports": "只帶楔塊而非岩釘；不代表無繩索或無其他器材。"
        },
        {
          "paragraphs": [
            9
          ],
          "quote": "the two men completed it with no serious hitches",
          "supports": "單次該路線完成，不能替每面岩壁作安全保證。"
        },
        {
          "paragraphs": [
            51,
            53
          ],
          "quote": "A block of metal goes in, a piton comes out.",
          "supports": "店面舊釘展區/商品櫃；後方舊便攜爐閒置但壓床仍製新岩釘，木板楔塊與鮮明繩環展示。"
        },
        {
          "paragraphs": [
            55
          ],
          "quote": "It’s the clothing that subsidizes the hardware.",
          "supports": "服裝補貼器材僅為Chouinard本人說法。"
        },
        {
          "paragraphs": [
            55
          ],
          "quote": "cost thousands of dollars, and often I don’t get my money back for five to ten years",
          "supports": "模具數千美元與5–10年回本是本人估算，不是獨立財報或繼續生產的動機證明。"
        }
      ],
      "http_status_observed": 200,
