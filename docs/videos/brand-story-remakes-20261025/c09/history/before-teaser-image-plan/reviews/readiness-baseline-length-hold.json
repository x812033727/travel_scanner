      "paragraph_text_path": "/workspace/work/brand-story-20261025/c09-audit/source-cache/S4.paragraphs.txt",
      "paragraph_text_sha256": "0e8f818fbdf989ab7d94549c8ada0d562e3f7dc94f9fc9f9fa3ccb36afde9b48",
      "retrieved_at_utc": "2026-10-25T16:27:32.588432+00:00"
    },
    {
      "source_id": "S7",
      "url": "https://www.patagonia.com/stories/culture/community/patagonia-surf-stores-the-wave-riding-collective/story-18439.html",
      "document_layer": "Patagonia站頁 metadata article:published_time為2012-04-26；後來公司回顧。",
      "anchors": [
        {
          "paragraphs": [
            72
          ],
          "quote": "In 1973, the company branched out to make outdoor clothing under the Patagonia label.",
          "supports": "只支持1973戶外服裝使用Patagonia標籤；不是品牌名稱首次出現，也不挪到1972或替每件採訪所見衣服認定標籤。"
        }
      ],
