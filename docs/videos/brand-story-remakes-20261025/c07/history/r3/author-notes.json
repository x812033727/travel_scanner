    "line_changes": [
      {
        "id": "c7r20207",
        "before": "這是送修網站拿來分辨構造的線索，先讓人找到對應的維修項目。",
        "after": "鞋邊那圈線，只是讓人一眼認出它的裝飾嗎？"
      },
      {
        "id": "c7r20215",
        "before": "品牌二〇二三年的說明會裡，也有人提過這種請求。",
        "after": "品牌在二〇二三年的說明會，談到過什麼樣的舊鞋？"
      },
      {
        "id": "c7r20217",
        "before": "鞋面還好，把靴口翻開，裡面若已磨穿，要把整張外皮也換掉嗎？",
        "after": "鞋面還好，把靴口翻開，後跟內裡若已磨穿，要把外皮也換掉嗎？"
      },
      {
        "id": "c7r20218",
        "before": "若這裡已經磨穿，維修方提供的是修補，或換上新的皮內裡，不必因此把外皮整張換掉。",
        "after": "若後跟內裡已磨穿，維修方可以修補，或換上新的皮內裡。"
      },
      {
        "id": "c7r20219",
        "before": "照他們的說法，處理內裡能恢復舒適，也減少上層鞋面進一步受磨。",
        "after": "照他們的說法，處理後跟內裡能恢復舒適，也減少上層鞋面進一步受磨。"
      },
      {
        "id": "c7r20319",
        "before": "沿條車好，師傅再把靴底朝向砂帶，轉著鞋身磨修邊緣。",
        "after": "沿條車好，師傅再把靴底朝向修整工具，轉著鞋身處理邊緣。"
      },
      {
        "id": "c7r20409",
        "before": "示範中，師傅一直扶著鞋身，隨著接合的位置，轉動這隻靴子。",
        "after": "工具接觸鞋邊時，靴子的其他邊緣，要怎麼跟著送過去？"
      },
      {
        "id": "c7r20520",
        "before": "繩子穿過金屬孔，再跨到另一邊，剛才為了施工打開的鞋口，重新收回能穿的樣子。",
        "after": "繩子穿過金屬孔，再跨到另一邊，原本敞開的鞋口，重新收回能穿的樣子。"
      },
      {
        "id": "c7r20606",
        "before": "盒子一打開，對方先看接合處，覺得接得很好，外底也換好了。",
        "after": "對方在評論裡稱讚接合和外底。"
      },
      {
        "id": "c7r20607",
        "before": "接著還發現，裡面多了一組全新的鞋帶。這是評論裡特別高興的一件事。",
        "after": "評論還特別提到，維修方多添了一組全新鞋帶。"
      },
      {
        "id": "c7r20613",
        "before": "現在送修，網站預估要等多久？目前寫的是，周轉最長約三週。",
        "after": "現在送修，網站預估要等多久？"
      },
      {
        "id": "c7r20614",
        "before": "這項現行授權服務接受英國客戶，寄送也接上英國郵政，可以由包裹進出維修方。",
        "after": "目前網站預估最長約三週，這項服務只受理英國客戶。"
      },
      {
        "id": "c7r20617",
        "before": "這類修復在英國做了多少？二〇二六年報列的，是一個財年四千兩百八十七雙。",
        "after": "這類修復在英國做了多少？"
      },
      {
        "id": "c7r20618",
        "before": "這些送修紀錄裡，維修方重新接回部件，主人重新收到的，則是能繼續穿的鞋。",
        "after": "年報列出，二〇二六財年，英國修復了四千兩百八十七雙。"
      }
    ],
    "deletions": [
      {
        "id": "c7r20211",
        "text": "這是成對的換底與重做接合；鞋面如果另有補線，需要先看照片，再另外報價。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20221",
        "text": "現在的英國授權網站，讓穿著者先選修理項目，再把自己的鞋寄給維修方。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20222",
        "text": "分不清鞋款的人，可以先問維修團隊；需要的項目沒列出來，也能請他們另行報價。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20223",
        "text": "如果鞋面另有要補的縫線，就先把照片和需求交過去，讓維修方針對那項工作報價。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20224",
        "text": "你交出去的，不只是一個型號；鞋況、想換的部件，都得跟著這雙鞋進入修理。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20225",
        "text": "在那則評論裡，送修者把靴子收進舊鞋盒，自己印了預付郵寄標籤。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20226",
        "text": "對方還特別寫到，這次寄送沒有另付郵資，接著等郵差上門取件。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20227",
        "text": "網站要求放入訂單確認、姓名和地址；標籤自己印不出來，還能送嗎？",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20228",
        "text": "沒有印表機的人，也能把專屬碼帶到郵局，由皇家郵政幫忙印出郵寄標籤。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20229",
        "text": "如果是我，會先說清楚想留下的地方，再決定要委託換掉哪些部件。",
        "reason": "Remove duplicated quoting/repair-condition and logistics tutorial branch; keep one genuine posting action in opening."
      },
      {
        "id": "c7r20509",
        "text": "你看到的是在用過的皮上繼續動手，腳下的底整塊換新，鞋面則採取另一種處理。",
        "reason": "Remove redundant retained-upper/new-sole summary to keep the workshop action moving and cadence within45s."
      }
    ],
