    "line_changes": [
      {
        "id": "c7r20105",
        "before": "今天沿著一雙馬汀靴的三個接合部件，走一趟拆開、接回、送回的旅程。",
        "after": "我們就看這一雙馬汀靴，能不能把主人穿慣的鞋面留下來。"
      },
      {
        "id": "c7r20213",
        "before": "這位送修者選擇修理。評論裡說，在對方看來，這比買二手還便宜。",
        "after": "那位評論者則覺得，自己的這次修理，比另買一雙二手鞋還便宜。"
      },
      {
        "id": "c7r20619",
        "before": "回到開場想留下的上半部：新外底接上去，縫線重新車過，穿慣的鞋面又能跟著走。",
        "after": "對那位七月評論者來說，這次想留下的上半部，跟著修好的靴子一起回來了。"
      }
    ],
    "deletions": [
      {
        "id": "c7r20201",
        "text": "鞋盒離手以前，這位送修者已經在網站選過修理，也選了新的配色。",
        "reason": "Website-choice fact relocated into new opening c7r20107; no return to before posting."
      },
      {
        "id": "c7r20202",
        "text": "對方說，能挑鞋底和縫線的顏色，這件事很有趣。",
        "reason": "Colour-choice enjoyment condensed into new opening c7r20107, stated only once."
      },
      {
        "id": "c7r20212",
        "text": "這雙鞋要換的不只有顏色，還得把穿過的部件，換成能重新接合的部件。",
        "reason": "Pure preview/summary of old-versus-new components, no new action or result."
      },
      {
        "id": "c7r20214",
        "text": "四年來穿著的上半部還好，腳下的底卻幾乎磨穿，這才把一雙鞋送上兩種去留。",
        "reason": "Repeated opening four-year/upper-good/sole-worn facts, no new result."
      },
      {
        "id": "c7r20315",
        "text": "鞋底朝上，靴筒朝下，一隻手握住鞋身，另一隻手在靠近針的位置扶住邊緣。",
        "reason": "Repeated inverted-boot/supporting-hand posture already shown."
      },
      {
        "id": "c7r20321",
        "text": "現在沿條和鞋面已經連在一起，新外底仍是另一個部件。",
        "reason": "Repeated welt-attached/sole-separate state immediately before joining."
      },
      {
        "id": "c7r20604",
        "text": "星期四裝進盒子的那一雙，經過取件、收鞋和修理，重新離開了維修方。",
        "reason": "Closing flashback through Thursday packing/collection/receipt, already narrated in order."
      },
      {
        "id": "c7r20616",
        "text": "原廠在年報裡說，替舊鞋延長使用時間，也有助於加強顧客對品牌的忠誠。",
        "reason": "Annual corporate loyalty branch does not move the specific returned pair forward."
      },
      {
        "id": "c7r20617",
        "text": "這類修復在英國做了多少？",
        "reason": "Question for removed annual count branch."
      },
      {
        "id": "c7r20618",
        "text": "年報列出，二〇二六財年，英國修復了四千兩百八十七雙。",
        "reason": "Annual UK volume detour, outside the specific repair journey."
      }
    ],
    "added_lines": [
