  "lines": {
    "tm101": {
      "source_hash": "b8fec245757b",
      "text": "1637년 2월 5일, 네덜란드 알크마르에서 경매가 열렸습니다."
    },
    "tm102": {
      "source_hash": "57b81ab51e33",
      "text": "고 빙켈이 남긴 튤립, 돈은 자녀들 몫입니다."
    },
    "tm103": {
      "source_hash": "644796db13e7",
      "text": "'총독'이라는 구근 하나가 4,203길더까지 올랐습니다."
    },
    "tm104": {
      "source_hash": "ef306251547c",
      "text": "경제사학자 추정, 숙련공 연수입은 200에서 300길더."
    },
    "tm105": {
      "source_hash": "5672c12d2c17",
      "text": "더 있습니다."
    },
    "tm106": {
      "source_hash": "a7189ac66861",
      "text": "전해 한 식물학자는 구근을 7,000길더에 팔기로 했고,"
    },
    "tm107": {
      "source_hash": "dc16cf1b9586",
      "text": "꽃 상인을 비웃는 소책자는 꽃 한 송이의 쇼핑 목록을 썼고,"
    },
    "tm108": {
      "source_hash": "20d2a28d75b3",
      "text": "1841년 런던의 한 책에선, 선원이 청어와 함께 무언가를 먹었고,"
    },
    "tm109": {
      "source_hash": "90bb8d1e3c78",
      "text": "한 역사학자는 네덜란드 기록에서 튤립 파산자를 찾았습니다."
    },
    "tm110": {
      "source_hash": "c3110731f7fe",
      "text": "구근 하나에 이런 값을, 당시 네덜란드인은 정말 미쳤을까요?"
    },
    "tm201": {
      "source_hash": "7a4f5d18542c",
      "text": "그 총독, 경매표에 적힌 건 심을 때의 무게:"
    },
    "tm202": {
      "source_hash": "7a80373065b7",
      "text": "658아스. 1아스는 약 20분의 1그램입니다."
    },
    "tm203": {
      "source_hash": "39d87a095180",
      "text": "이리 작은데 왜 비쌌을까요?"
    },
    "tm204": {
      "source_hash": "971259cc022e",
      "text": "가장 비싼 건 줄무늬 튤립이었습니다."
    },
    "tm205": {
      "source_hash": "2c07695c8c45",
      "text": "줄무늬는 사실 바이러스 탓이었고,"
    },
    "tm206": {
      "source_hash": "bbdbfa02883c",
      "text": "구근이 약해져 번식이 더뎌,"
    },
    "tm207": {
      "source_hash": "ac405a9b4196",
      "text": "예쁠수록 희귀했습니다."
    },
    "tm208": {
      "source_hash": "65cf6640773c",
      "text": "문제는 그때 구근이 땅속에 있었다는 것. 9월부터 이듬해 6월까진 안 나옵니다."
    },
    "tm209": {
      "source_hash": "7a113c4dd8fa",
      "text": "그동안 산 건 계약서뿐, 6월에 캐내야 인도됐습니다."
    },
    "tm210": {
      "source_hash": "71ab5add071a",
      "text": "이런 계약은 1636년 여름부터 늘었고,"
    },
    "tm211": {
      "source_hash": "3c6a28c471e0",
      "text": "상인들은 술집에 모였고, 이를 '칼리지'라 불렀습니다."
    },
    "tm212": {
      "source_hash": "a491af07635b",
      "text": "규칙: 1길더 거래마다 매수인이 매도인에게 반 스타위버 '술값', 최대 3길더."
    },
    "tm213": {
      "source_hash": "d521b9f79aa0",
      "text": "밖에선 어떻게 봤을까요?"
    },
    "tm214": {
      "source_hash": "279db0a4a67d",
      "text": "같은 날, 하를럼의 신부가 조카에게 편지를 썼습니다."
    },
    "tm215": {
      "source_hash": "384e7fcefc5f",
      "text": "역병처럼 또 하나의 병이 나타났다, 꽃장수병이라고."
    },
    "tm216": {
      "source_hash": "cc601d8914c1",
      "text": "그해 6월, 물건은 받았을까요?"
    },
    "tm301": {
      "source_hash": "8eead8c67f17",
      "text": "아닙니다. 1637년 2월 첫 주가 지나자 값이 무너졌습니다."
    },
    "tm302": {
      "source_hash": "76b4ef7d82e5",
      "text": "매수인 다수가 지불을 거부해 구근이 남았습니다."
    },
    "tm303": {
      "source_hash": "630b74ab3b33",
      "text": "그럼 계약은 유효할까요?"
    },
    "tm304": {
      "source_hash": "4312a22065c0",
      "text": "2월 24일, 도시별 상인 대표들이 암스테르담에서 합의:"
    },
    "tm305": {
      "source_hash": "3c027d5db823",
      "text": "전년 11월 말까지 거래는 지불,"
    },
    "tm306": {
      "source_hash": "e67397d7901e",
      "text": "이후는 매수인이 10%를 내면 안 사도 됩니다."
    },
    "tm307": {
      "source_hash": "ad9a2db32d4d",
      "text": "일부, 특히 신참이 완전히 파산하지 않게 하려는 것이라 했습니다."
    },
    "tm308": {
      "source_hash": "d136736ed7c5",
      "text": "그런데 암스테르담 상인들은 불참했습니다."
    },
    "tm309": {
      "source_hash": "9b9d0707f1f9",
      "text": "정부는요?"
    },
    "tm310": {
      "source_hash": "8b57c77bb238",
      "text": "4월 27일 홀란트주 의회가 포고: 모든 튤립 계약은 일단 정지."
    },
    "tm311": {
      "source_hash": "d0ac17ec9784",
      "text": "매도인은 구근을 시가로 먼저 팔고, 차액은 나중에 정산."
    },
    "tm312": {
      "source_hash": "d42125058f3b",
      "text": "법원은 대부분 외면했습니다."
    },
    "tm313": {
      "source_hash": "1b4c1208ffd8",
      "text": "그 차액은 결국?"
    },
    "tm314": {
      "source_hash": "beb83d0fa45f",
      "text": "하를럼은 계약가 3.5%를 내면 해지 가능하게 했습니다."
    },
    "tm315": {
      "source_hash": "e94f45c23daf",
      "text": "그 식물학자는 돈을 받았을까요?"
    },
    "tm316": {
      "source_hash": "9905ad497451",
      "text": "6개월 내 하락 시 매수인은 10%만 내기로 했습니다."
    },
    "tm317": {
      "source_hash": "657af79aa839",
      "text": "결국 700길더를 공짜로 받고 구근도 지켰고,"
    },
    "tm318": {
      "source_hash": "778b52e7fe4d",
      "text": "아들 왈, 부친은 차라리 넘기길 원했다."
    },
    "tm319": {
      "source_hash": "caf49a3615e0",
      "text": "이 폭락은 뒤에 뭐가 됐을까요?"
    },
    "tm401": {
      "source_hash": "f166c46c9319",
      "text": "농담이 됐습니다. 같은 해 하를럼 인쇄소가 꽃 상인을 비웃는 대화 소책자 3권을 냈습니다."
    },
    "tm402": {
      "source_hash": "c9ea5b9733dd",
      "text": "등장인물은 둘, '참말쟁이'와 '욕심쟁이'입니다."
    },
    "tm403": {
      "source_hash": "81faa5c2d27d",
      "text": "욕심쟁이 왈, 아내 말로는 돈 벌면 시내 최고의 집을 사 이자로 산답니다."
    },
    "tm404": {
      "source_hash": "2eeb7e6fc877",
      "text": "참말쟁이의 답: 공중누각치곤 너무 크지 않나?"
    },
    "tm405": {
      "source_hash": "7d08e8cdf8cd",
      "text": "그 목록은 꽃 상인을 비웃는 다른 시집 끝에 실렸습니다."
    },
    "tm406": {
      "source_hash": "08442e71a262",
      "text": "소4, 돼지8, 양12, 치즈 1,000파운드,"
    },
    "tm407": {
      "source_hash": "1f5e33e32551",
      "text": "침대와 은잔까지 합쳐 모두 2,500길더."
    },
    "tm408": {
      "source_hash": "2687f638f1a2",
      "text": "그런데 적힌 건, 1636년 꽃 한 송이 값으로 이걸 '살 수 있다'는 것."
    },
    "tm409": {
      "source_hash": "7107be3df31a",
      "text": "500길더짜리 배를 더해 3,000길더."
    },
    "tm410": {
      "source_hash": "b715131dbecc",
      "text": "그 돈으론 최고의 구근은 못 산다는 말까지."
    },
    "tm411": {
      "source_hash": "4493a87210b6",
      "text": "'살 수 있다'가 어떻게 실제 거래로?"
    },
    "tm412": {
      "source_hash": "fc59a9cbb1e2",
      "text": "1672년, 그 식물학자의 아들 문팅도 식물 책을 냈습니다."
    },
    "tm413": {
      "source_hash": "c2356f838b1c",
      "text": "그러나 튤립 파동 때 그는 열 살쯤."
    },
    "tm414": {
      "source_hash": "32bbdd1595ce",
      "text": "귀족, 농부, 뱃사공, 굴뚝 청소부와 하녀까지 튤립을 사고팔았다고 썼습니다."
    },
    "tm415": {
      "source_hash": "3766b6d6238b",
      "text": "그 목록도 옮겨 적으며 바꿨습니다: 당시 누가 총독 하나로 이 물건들을 샀다."
    },
    "tm416": {
      "source_hash": "4e4bc3d1a688",
      "text": "꽃엔 이름이 붙고, 배는 빠졌습니다."
    },
    "tm417": {
      "source_hash": "1fc7893f0b17",
      "text": "튤립값이 집값이었다고들 합니다."
    },
    "tm418": {
      "source_hash": "f3cab79ad972",
      "text": "정말 집과 구근을 바꿨을까요?"
    },
    "tm419": {
      "source_hash": "1c3fbae56fe3",
      "text": "문팅의 책에 한 건 있습니다. 4,400길더 집이,"
    },
    "tm420": {
      "source_hash": "c98e735d1d3c",
      "text": "같은 값 구근과 교환됐습니다."
    },
    "tm421": {
      "source_hash": "d4f45e08a5d4",
      "text": "양쪽 이름은 '아무개', 날짜도 도시도 없습니다."
    },
    "tm422": {
      "source_hash": "afc730944de9",
      "text": "18세기 독일 학자 베크만의 발명사는 주로 문팅을 베꼈고,"
    },
    "tm423": {
      "source_hash": "f273aa23aca1",
      "text": "목록은 '인도하기로 함'이 됐습니다."
    },
    "tm424": {
      "source_hash": "a94e01f62847",
      "text": "그 2월 24일 협정,"
    },
    "tm425": {
      "source_hash": "e6aebe0a4d78",
      "text": "앞부분 '지불'이 그의 글에선 '무효'가 됐습니다."
    },
    "tm426": {
      "source_hash": "0834e93b73c0",
      "text": "청어 선원도 그의 책에 먼저 나옵니다:"
    },
    "tm427": {
      "source_hash": "5312d3befa38",
      "text": "구근을 양파로 알고 청어와 먹었다는데,"
    },
    "tm428": {
      "source_hash": "e846f7cac0d8",
      "text": "베크만은 이걸 광풍 뒤 '작은 광풍'에 넣었습니다."
    },
    "tm429": {
      "source_hash": "54eac0aa0c93",
      "text": "그 1841년 런던 책의 저자는 매케이, 주 출처는 베크만."
    },
    "tm430": {
      "source_hash": "c6d7e703ac0c",
      "text": "목록은 '인도됐다'가 되고, 협정의 '무효'도 그대로 옮겼습니다."
    },
    "tm431": {
      "source_hash": "84f21dea757f",
      "text": "먹은 건 3,000길더짜리 셈페르 아우구스투스, 몇 달 투옥까지."
    },
    "tm432": {
      "source_hash": "0e902477764f",
      "text": "무게별 가격표도 1635년 것이라며 실었는데,"
    },
    "tm433": {
      "source_hash": "0e67853610e9",
      "text": "정말 그해 가격일까요?"
    },
    "tm434": {
      "source_hash": "fdcebf1f013e",
      "text": "대부분 폭락한 달의 가격, 1635는 그가 붙인 겁니다."
    },
    "tm435": {
      "source_hash": "a7aa7746c4a0",
      "text": "문팅 원문: 이 바보 장사가 좀 더 갔다면 네덜란드 상업이 다 망했을 것."
    },
    "tm436": {
      "source_hash": "f156a9458961",
      "text": "매케이에 와선: 상업이 큰 타격을 입고 수년 뒤 회복."
    },
    "tm437": {
      "source_hash": "e677739e338a",
      "text": "누가 매케이를 다시 검증했을까요?"
    },
    "tm501": {
      "source_hash": "2008489730ff",
      "text": "네. 1989년 경제학자 가버가 당시 가격으로 다시 계산했습니다."
    },
    "tm502": {
      "source_hash": "80b202781fb5",
      "text": "가격 기록 대부분이 2월 5일, 그 경매 날에 멈춥니다."
    },
    "tm503": {
      "source_hash": "dde4e06c85f4",
      "text": "결론: 대부분은 뚜렷한 광기가 아니었다."
    },
    "tm504": {
      "source_hash": "9f49cfd346fb",
      "text": "희귀 구근이 비싸다 금방 내리는 건 업계의 흔한 모습;"
    },
    "tm505": {
      "source_hash": "9c66a6762038",
      "text": "마지막 한 달 일반 구근 폭등·폭락만 거품일 수 있습니다."
    },
    "tm506": {
      "source_hash": "f90c53797ed2",
      "text": "굴뚝 청소부와 하녀는?"
    },
    "tm507": {
      "source_hash": "ad51148e4e36",
      "text": "기록을 뒤진 그 역사학자, 골드가입니다. 2007년에 책을 냈습니다."
    },
    "tm508": {
      "source_hash": "9ab14856a615",
      "text": "찾은 건 약 350명,"
    },
    "tm509": {
      "source_hash": "5681e2968c08",
      "text": "다 뒤지진 못해 실제보다 적다고 합니다."
    },
    "tm510": {
      "source_hash": "2baea381c193",
      "text": "대부분 상인과 장인. 포목상이 가장 많고, 제빵사, 양조업자, 여관 주인도."
    },
    "tm511": {
      "source_hash": "936d60730002",
      "text": "파산자는요?"
    },
    "tm512": {
      "source_hash": "8858a8b9ded8",
      "text": "파산 물결은 없었습니다."
    },
    "tm513": {
      "source_hash": "84d2abf9e999",
      "text": "큰 손실자는 원래 부자라 1,000길더쯤 괜찮았답니다."
    },
    "tm514": {
      "source_hash": "e8504e493d9b",
      "text": "매케이의 타격은?"
    },
    "tm515": {
      "source_hash": "0537f314b150",
      "text": "그녀의 말: 본 바로는 경제에 실제 영향이 전혀 없었다."
    },
    "tm516": {
      "source_hash": "5d7d0c83378c",
      "text": "다만 명예와 인간관계는 다쳤다고 합니다;"
    },
    "tm517": {
      "source_hash": "74b35ab53d1f",
      "text": "금융 위기는 아니어도, 사회·문화의 위기였을지 모릅니다."
    },
    "tm518": {
      "source_hash": "e1e4c8d748da",
      "text": "왜 다들 이 얘기를 좋아할까요?"
    },
    "tm519": {
      "source_hash": "3cf78f4d1bcc",
      "text": "골드가: 사람들이 바보 같아 보여서."
    },
    "tm520": {
      "source_hash": "96f2d8ace0ee",
      "text": "그 경매, 기억하십니까? 가격표와 농담들은 1643년부터 한 권에 묶여 있습니다. 이 파일, 보관합니다."
    },
    "tm521": {
      "source_hash": "0e7d943c399d",
      "text": "튤립 파동을 처음 들은 곳은 교과서, 투자서, 인터넷?"
    },
    "tm522": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 다룹니다. 함께하려면 구독해 주세요."
    }
  }
}
