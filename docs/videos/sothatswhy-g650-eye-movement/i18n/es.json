    "tags": "f09281972305",
    "thumbnail": "a046660c5d1e"
  },
  "lines": {
    "p001": {
      "source_hash": "a4e39c59e359",
      "text": "¡Director! Miré al espejo y moví los ojos con fuerza,"
    },
    "p002": {
      "source_hash": "d943cefd9ae4",
      "text": "me mareé,"
    },
    "p003": {
      "source_hash": "44f088ad6731",
      "text": "¡pero mi reflejo nunca se vio borroso!"
    },
    "p004": {
      "source_hash": "81f2c96a3683",
      "text": "Si muevo el móvil un poco,"
    },
    "p005": {
      "source_hash": "e0c67d5febdc",
      "text": "la foto sale toda borrosa."
    },
    "p006": {
      "source_hash": "689ec34b0288",
      "text": "Los ojos van tan rápido,"
    },
    "p007": {
      "source_hash": "6476bd9de413",
      "text": "¿por qué no se borra?"
    },
    "p008": {
      "source_hash": "e57a1f99e16a",
      "text": "Por las leyes físicas,"
    },
    "p009": {
      "source_hash": "ffdcf3cd39d9",
      "text": "no solo debería borrarse,"
    },
    "p010": {
      "source_hash": "fdf1ac62632b",
      "text": "¡sino temblar al frenar!"
    },
    "p011": {
      "source_hash": "4389fa748dc5",
      "text": "La Universidad de Murcia lo grabó:"
    },
    "p012": {
      "source_hash": "645be0ef5376",
      "text": "al frenar, por inercia el cristalino"
    },
    "p013": {
      "source_hash": "4ee33720dc0e",
      "text": "¡vibra como gelatina 65 milisegundos!"
    },
    "p014": {
      "source_hash": "7b1bcb86759c",
      "text": "haciendo que la imagen"
    },
    "p015": {
      "source_hash": "76810c12112c",
      "text": "¡tiemble hasta 0,3 grados!"
    },
    "p016": {
      "source_hash": "bc3104336af0",
      "text": "Al mover los ojos,"
    },
    "p017": {
      "source_hash": "59babe48a19c",
      "text": "deberías ver una estela,"
    },
    "p018": {
      "source_hash": "3ddd0ceca2e3",
      "text": "y luego todo el mundo"
    },
    "p019": {
      "source_hash": "ce5cd8ff711f",
      "text": "temblando como gelatina."
    },
    "p020": {
      "source_hash": "a58c61173d09",
      "text": "Además parpadeas veinte veces por minuto,"
    },
    "p021": {
      "source_hash": "b293f0d152a0",
      "text": "con cien milisegundos a oscuras."
    },
    "p022": {
      "source_hash": "c1da75ef8fb2",
      "text": "Al día son muchos minutos,"
    },
    "p023": {
      "source_hash": "f710ec912658",
      "text": "en total oscuridad."
    },
    "p024": {
      "source_hash": "4b187434fdac",
      "text": "¿Minutos a oscuras?"
    },
    "p025": {
      "source_hash": "834a5f9ac3bf",
      "text": "¿Cómo no lo noté?"
    },
    "p026": {
      "source_hash": "17085770c7f8",
      "text": "Al caminar, leer o correr,"
    },
    "p027": {
      "source_hash": "f543e9c61b69",
      "text": "¡el mundo siempre se ve continuo!"
    },
    "p028": {
      "source_hash": "5e0418b01237",
      "text": "¿Adónde fue esa imagen?"
    },
    "p029": {
      "source_hash": "daa24854cc04",
      "text": "¡Hoy resolveremos este misterio!"
    },
    "p030": {
      "source_hash": "92336f3696dd",
      "text": "Los científicos midieron:"
    },
    "p031": {
      "source_hash": "12f7c50dc7d5",
      "text": "antes de que el ojo se mueva,"
    },
    "p032": {
      "source_hash": "aa8e60aed491",
      "text": "en 50 a 100 ms,"
    },
    "p033": {
      "source_hash": "b55117212185",
      "text": "¡el nervio baja la sensibilidad!"
    },
    "p034": {
      "source_hash": "9fb56174653b",
      "text": "En neurociencia,"
    },
    "p035": {
      "source_hash": "c64d55aa4ac1",
      "text": "se llama 'supresión sacádica'."
    },
    "p036": {
      "source_hash": "0416f79b1f64",
      "text": "¿Bajar sensibilidad?"
    },
    "p037": {
      "source_hash": "5e8cc8c68eb5",
      "text": "¿Como atenuar la luz del cuarto?"
    },
    "p038": {
      "source_hash": "f017aa537185",
      "text": "¿Por qué nunca notamos"
    },
    "p039": {
      "source_hash": "a04a84ed7213",
      "text": "que oscurece de golpe?"
    },
    "p040": {
      "source_hash": "d457a7a37773",
      "text": "¡El cerebro tiene truco!"
    },
    "p041": {
      "source_hash": "28fae10330d5",
      "text": "Solo atenúa el canal de brillo,"
    },
    "p042": {
      "source_hash": "7f3c11d2613c",
      "text": "¡bajándolo un ochenta por ciento!"
    },
    "p043": {
      "source_hash": "1238cc5bc869",
      "text": "Pero el canal del color"
    },
    "p044": {
      "source_hash": "d3eadbec58a1",
      "text": "se mantiene casi intacto."
    },
    "p045": {
      "source_hash": "0974165b86b3",
      "text": "Por eso no notas oscuridad."
    },
    "p046": {
      "source_hash": "d0eb5466c113",
      "text": "Antes se creía que era el cerebro."
    },
    "p047": {
      "source_hash": "b2b2b2a28fcc",
      "text": "Separando los campos visuales,"
    },
    "p048": {
      "source_hash": "8c3b1231e0cc",
      "text": "con luz en el ojo izquierdo,"
    },
    "p049": {
      "source_hash": "3775ef653350",
      "text": "¡el derecho también perdió agudeza!"
    },
    "p050": {
      "source_hash": "7f2d81f94a0f",
      "text": "Como las señales se unen en el cerebro,"
    },
    "p051": {
      "source_hash": "5c8f0eb1ff47",
      "text": "parecía que él dirigía todo."
    },
    "p052": {
      "source_hash": "3c021820232c",
      "text": "El caso parecía cerrado."
    },
    "p053": {
      "source_hash": "dabd2cd4f549",
      "text": "¿Pero fue solo el cerebro?"
    },
    "p054": {
      "source_hash": "36b88442656f",
      "text": "¡Suena muy lógico!"
    },
    "p055": {
      "source_hash": "192c4c35995d",
      "text": "¡El cerebro ordena mover y silencia!"
    },
    "p056": {
      "source_hash": "82ff034dec4e",
      "text": "En Tubinga, Alemania,"
    },
    "p057": {
      "source_hash": "369ba01b511a",
      "text": "hicieron un experimento audaz."
    },
    "p058": {
      "source_hash": "6fa4aae92d97",
      "text": "Aislaron retinas de animales,"
    },
    "p059": {
      "source_hash": "cef294c187ac",
      "text": "en una placa de laboratorio."
    },
    "p060": {
      "source_hash": "1cac4f0ee564",
      "text": "Sin cerebro, sin nervio óptico,"
    },
    "p061": {
      "source_hash": "9f483368729c",
      "text": "y sin músculos oculares."
    },
    "p062": {
      "source_hash": "0400a0a5eea6",
      "text": "Con haces de luz,"
    },
    "p063": {
      "source_hash": "3c1a75b88564",
      "text": "pasaron rayas rápidas por la retina."
    },
    "p064": {
      "source_hash": "9e30fc951ca5",
      "text": "Las neuronas de la retina,"
    },
    "p065": {
      "source_hash": "c6456a0150d0",
      "text": "¡bajaron su respuesta un ochenta por ciento!"
    },
    "p066": {
      "source_hash": "6838f8b88c45",
      "text": "El circuito ganglionar,"
    },
    "p067": {
      "source_hash": "fc9cbd148dec",
      "text": "¡detecta el movimiento rápido solo!"
    },
    "p068": {
      "source_hash": "5d8fb03047a0",
      "text": "No necesita órdenes cerebrales,"
    },
    "p069": {
      "source_hash": "dd6bd0d54a7f",
      "text": "la inhibición lateral es suficiente."
    },
    "p070": {
      "source_hash": "b0159fc5de33",
      "text": "En humanos vivos ocurre igual:"
    },
    "p071": {
      "source_hash": "8d5fe009f33d",
      "text": "ojos quietos, moviendo solo el fondo,"
    },
    "p072": {
      "source_hash": "9fdf0a1b69b3",
      "text": "la pérdida de sensibilidad"
    },
    "p073": {
      "source_hash": "7f8c211bac8f",
      "text": "¡es más fuerte que al mover los propios ojos!"
    },
    "p074": {
      "source_hash": "0398ec641e3f",
      "text": "¿Y si miramos una pared blanca,"
    },
    "p075": {
      "source_hash": "d46d01740d04",
      "text": "completamente lisa sin textura?"
    },
    "p076": {
      "source_hash": "b7cb336df32e",
      "text": "¡Diste en el punto clave!"
    },
    "p077": {
      "source_hash": "7738f6968471",
      "text": "Ante una pared uniforme sin relieve,"
    },
    "p078": {
      "source_hash": "1284b771c955",
      "text": "¡la supresión casi desaparece!"
    },
    "p079": {
      "source_hash": "4eb3adf1be7f",
      "text": "Esto prueba que la ceguera"
    },
    "p080": {
      "source_hash": "9583552f9d55",
      "text": "¡la corta la retina ante el deslizamiento!"
    },
    "p081": {
      "source_hash": "85c34dd9e192",
      "text": "El cerebro solo acorta el tiempo ciego."
    },
    "p082": {
      "source_hash": "ce9773655b03",
      "text": "¿Y la estela que queda al mover?"
    },
    "p083": {
      "source_hash": "ff6e7a0847d6",
      "text": "¿Adónde se fue?"
    },
    "p084": {
      "source_hash": "3d6d9a78e875",
      "text": "La nueva imagen clara al frenar,"
    },
    "p085": {
      "source_hash": "fb911873126f",
      "text": "¡tapa la estela anterior por completo!"
    },
    "p086": {
      "source_hash": "1a0e486fc13d",
      "text": "En psicología,"
    },
    "p087": {
      "source_hash": "312b50ca1506",
      "text": "se llama 'enmascaramiento hacia atrás'."
    },
    "p088": {
      "source_hash": "88e282a80ea0",
      "text": "Y la vibración de gelatina,"
    },
    "p089": {
      "source_hash": "64e905a9ce39",
      "text": "el cerebro aprendió a ignorarla siempre."
    },
    "p090": {
      "source_hash": "e15e86e2278e",
      "text": "¿Este mecanismo protector"
    },
    "p091": {
      "source_hash": "a0280ff53f4c",
      "text": "se puede entrenar para mejorar?"
    },
    "p092": {
      "source_hash": "227503e20d47",
      "text": "¡Realmente se puede entrenar!"
    },
    "p093": {
      "source_hash": "e21016d431ff",
      "text": "Con solo una semana de práctica,"
    },
    "p094": {
      "source_hash": "0484066f2be8",
      "text": "al momento de frenar el ojo,"
    },
    "p095": {
      "source_hash": "718c7e3473ce",
      "text": "¡quita la supresión y ve nítido!"
    },
    "p096": {
      "source_hash": "0c8958ad0907",
      "text": "Además, la estela no se desperdicia."
    },
    "p097": {
      "source_hash": "cee635b025cc",
      "text": "Si el objetivo salta de golpe,"
    },
    "p098": {
      "source_hash": "502aae134eaf",
      "text": "siguiendo la estela restante,"
    },
    "p099": {
      "source_hash": "64b8c4e3a2a0",
      "text": "¡el cerebro guía el ojo como un radar!"
    },
    "p100": {
      "source_hash": "24329afbafc0",
      "text": "No desperdicia señales,"
    },
    "p101": {
      "source_hash": "84d0d03d6247",
      "text": "solo filtra el ruido."
    },
    "p102": {
      "source_hash": "4281a9020914",
      "text": "Resuelto el movimiento, ¿y el parpadeo?"
    },
    "p103": {
      "source_hash": "73d7031b0193",
      "text": "El párpado cae,"
    },
    "p104": {
      "source_hash": "cdc0e807270e",
      "text": "quedando a oscuras cien milisegundos,"
    },
    "p105": {
      "source_hash": "59c24b0c50e8",
      "text": "¿no es un corte de señal total?"
    },
    "p106": {
      "source_hash": "1fa507e37ff3",
      "text": "¡Al revés!"
    },
    "p107": {
      "source_hash": "7324114abf3c",
      "text": "¡Esa oscuridad ayuda a ver más claro!"
    },
    "p108": {
      "source_hash": "e3a1b967329c",
      "text": "La oscuridad y luego luz dan un pulso,"
    },
    "p109": {
      "source_hash": "5dcc57442fdf",
      "text": "activando las células magnocelulares,"
    },
    "p110": {
      "source_hash": "1214981de48b",
      "text": "y para contornos difusos,"
    },
    "p111": {
      "source_hash": "3e229d18c49a",
      "text": "¡la agudeza sube mucho!"
    },
    "p112": {
      "source_hash": "4de16c5fe91c",
      "text": "Si uso gafas LCD para tapar la luz,"
    },
    "p113": {
      "source_hash": "8d0df8db6b73",
      "text": "¿da el mismo resultado?"
    },
    "p114": {
      "source_hash": "64268b36f375",
      "text": "En Singapur lo comprobaron:"
    },
    "p115": {
      "source_hash": "6bde9ff0d5d8",
      "text": "al buscar letras en ráfaga,"
    },
    "p116": {
      "source_hash": "2224d13af795",
      "text": "en los 300 ms tras parpadear,"
    },
    "p117": {
      "source_hash": "a2b37cdf68aa",
      "text": "¡el acierto subió del 75 al 86 %!"
    },
    "p118": {
      "source_hash": "a18d9d51eb1d",
      "text": "Con gafas LCD simulando el parpadeo,"
    },
    "p119": {
      "source_hash": "529ada008529",
      "text": "¡no hubo mejora alguna!"
    },
    "p120": {
      "source_hash": "1d6eac86d097",
      "text": "El parpadeo real mueve los músculos,"
    },
    "p121": {
      "source_hash": "d89b4553fa71",
      "text": "¡reiniciando la atención visual!"
    },
    "p122": {
      "source_hash": "ecd6b4990666",
      "text": "Parpadear no es flojera,"
    },
    "p123": {
      "source_hash": "0a2015b61b32",
      "text": "¡es reiniciar los ojos!"
    },
    "p124": {
      "source_hash": "4c1335a38e91",
      "text": "Y el cerebro no parpadea al azar."
    },
    "p125": {
      "source_hash": "35cede565685",
      "text": "¡Es un director de cine genial!"
    },
    "p126": {
      "source_hash": "0f9d43be74b6",
      "text": "En Tokio vieron comedias,"
    },
    "p127": {
      "source_hash": "766566b36eee",
      "text": "y más del 60 % de personas,"
    },
    "p128": {
      "source_hash": "0c2df7f7955b",
      "text": "¡cerraron los ojos al mismo tiempo!"
    },
    "p129": {
      "source_hash": "216c22d89642",
      "text": "Justo al terminar la acción del personaje."
    },
    "p130": {
      "source_hash": "90f42b81eda0",
      "text": "En Wurzburgo, a oscuras,"
    },
    "p131": {
      "source_hash": "ab22bdca21c6",
      "text": "decidiendo solo por el oído,"
    },
    "p132": {
      "source_hash": "2532babfcc71",
      "text": "aguantaron el parpadeo durante el sonido,"
    },
    "p133": {
      "source_hash": "5c31428d78c9",
      "text": "¡y parpadearon solo tras decidir!"
    },
    "p134": {
      "source_hash": "3a49707dc1b3",
      "text": "¿Y al caminar o"
    },
    "p135": {
      "source_hash": "d66696ad3a73",
      "text": "girar la cabeza?"
    },
    "p136": {
      "source_hash": "8a86a49be60e",
      "text": "En Texas analizaron 38 000 parpadeos:"
    },
    "p137": {
      "source_hash": "58e18f61deed",
      "text": "aguantan antes de girar la cabeza,"
    },
    "p138": {
      "source_hash": "5bff6b5c1b70",
      "text": "ocultando el parpadeo"
    },
    "p139": {
      "source_hash": "f6dba85207f7",
      "text": "¡en el giro más rápido!"
    },
    "p140": {
      "source_hash": "b17979efbfd2",
      "text": "El mejor ejemplo son los pilotos de F1."
    },
    "p141": {
      "source_hash": "4c1aa3b70f55",
      "text": "A 300 km/h durante 300 vueltas,"
    },
    "p142": {
      "source_hash": "1d9b8be4b1e8",
      "text": "los puntos de parpadeo,"
    },
    "p143": {
      "source_hash": "e8d0fc5d87b6",
      "text": "¡coinciden más del 80 % en rectas!"
    },
    "p144": {
      "source_hash": "0ee727f4b990",
      "text": "En curvas cerradas y frenadas fuertes,"
    },
    "p145": {
      "source_hash": "a1906ddad3d1",
      "text": "¡ningún piloto parpadea jamás!"
    },
    "p146": {
      "source_hash": "8396b87392ba",
      "text": "Al límite, el control de la mente"
    },
    "p147": {
      "source_hash": "b112d092af92",
      "text": "es exacto al milisegundo."
    },
    "p148": {
      "source_hash": "e601330badfe",
      "text": "¡Lo sé!"
    },
    "p149": {
      "source_hash": "7ee399b5d5c1",
      "text": "Al mover los ojos, la retina corta el ruido,"
    },
    "p150": {
      "source_hash": "1b2f3d9a8abf",
      "text": "la nueva imagen tapa el temblor;"
    },
    "p151": {
      "source_hash": "5789bf2b2101",
      "text": "¡al parpadear, la oscuridad reinicia el nervio!"
    },
    "p152": {
      "source_hash": "96e27b21d4e5",
      "text": "¡El cerebro elige el momento más seguro!"
    },
    "p153": {
      "source_hash": "058b1acfd1b9",
      "text": "Millones de años de evolución conjunta,"
    },
    "p154": {
      "source_hash": "2d2194f748dc",
      "text": "ese es el secreto: ¡Así Es!"
    },
    "p155": {
      "source_hash": "55edd55a3456",
      "text": "Ante el espejo,"
    },
    "p156": {
      "source_hash": "c53fd58c1c5c",
      "text": "mira de un ojo al otro."
    },
    "p157": {
      "source_hash": "75c06ef42d0c",
      "text": "Por muy rápido que mires,"
    },
    "p158": {
      "source_hash": "66285daa72d4",
      "text": "¡jamás verás tus propios ojos moverse!"
    },
    "p159": {
      "source_hash": "309c078515dc",
      "text": "Es la edición más perfecta de nuestro cuerpo."
    },
    "p160": {
      "source_hash": "7e04dc527092",
      "text": "¡Si tienes dudas curiosas, ven a la Oficina Así Es!"
    }
  }
}
