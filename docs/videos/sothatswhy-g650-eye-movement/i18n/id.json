  },
  "lines": {
    "p001": {
      "source_hash": "a4e39c59e359",
      "text": "Kepala Kantor! Tadi saya memutar bola mata di cermin,"
    },
    "p002": {
      "source_hash": "d943cefd9ae4",
      "text": "sampai pusing,"
    },
    "p003": {
      "source_hash": "44f088ad6731",
      "text": "tapi bayangan saya di cermin kok tidak pernah buram?"
    },
    "p004": {
      "source_hash": "81f2c96a3683",
      "text": "Ponsel digoyang sedikit saja,"
    },
    "p005": {
      "source_hash": "e0c67d5febdc",
      "text": "fotonya langsung kabur."
    },
    "p006": {
      "source_hash": "689ec34b0288",
      "text": "Mata bergerak begitu cepat,"
    },
    "p007": {
      "source_hash": "6476bd9de413",
      "text": "kenapa gambarnya tidak buram?"
    },
    "p008": {
      "source_hash": "e57a1f99e16a",
      "text": "Menurut hukum fisika,"
    },
    "p009": {
      "source_hash": "ffdcf3cd39d9",
      "text": "gambarnya harusnya buram,"
    },
    "p010": {
      "source_hash": "fdf1ac62632b",
      "text": "dan bergoyang saat berhenti!"
    },
    "p011": {
      "source_hash": "4389fa748dc5",
      "text": "Universitas Murcia merekamnya:"
    },
    "p012": {
      "source_hash": "645be0ef5376",
      "text": "saat berhenti mendadak, karena inersia"
    },
    "p013": {
      "source_hash": "4ee33720dc0e",
      "text": "lensa mata bergoyang 65 milidetik!"
    },
    "p014": {
      "source_hash": "7b1bcb86759c",
      "text": "membuat bayangan di retina"
    },
    "p015": {
      "source_hash": "76810c12112c",
      "text": "berguncang hingga 0,3 derajat!"
    },
    "p016": {
      "source_hash": "bc3104336af0",
      "text": "Tiap kali melirik,"
    },
    "p017": {
      "source_hash": "59babe48a19c",
      "text": "harusnya ada garis buram,"
    },
    "p018": {
      "source_hash": "3ddd0ceca2e3",
      "text": "lalu melihat seluruh dunia"
    },
    "p019": {
      "source_hash": "ce5cd8ff711f",
      "text": "bergoyang seperti jeli."
    },
    "p020": {
      "source_hash": "a58c61173d09",
      "text": "Apalagi kita berkedip 20 kali semenit,"
    },
    "p021": {
      "source_hash": "b293f0d152a0",
      "text": "gelap lebih dari 100 milidetik."
    },
    "p022": {
      "source_hash": "c1da75ef8fb2",
      "text": "Dalam sehari terakumulasi puluhan menit,"
    },
    "p023": {
      "source_hash": "f710ec912658",
      "text": "dalam gelap gulita."
    },
    "p024": {
      "source_hash": "4b187434fdac",
      "text": "Puluhan menit gelap?!"
    },
    "p025": {
      "source_hash": "834a5f9ac3bf",
      "text": "Kok saya tidak ketinggalan?"
    },
    "p026": {
      "source_hash": "17085770c7f8",
      "text": "Saat jalan, membaca, atau lari,"
    },
    "p027": {
      "source_hash": "f543e9c61b69",
      "text": "dunia selalu tampak mulus!"
    },
    "p028": {
      "source_hash": "5e0418b01237",
      "text": "Ke mana gambar itu pergi?"
    },
    "p029": {
      "source_hash": "daa24854cc04",
      "text": "Hari ini kita cari tahu jawabannya!"
    },
    "p030": {
      "source_hash": "92336f3696dd",
      "text": "Ilmuwan pernah mengukurnya:"
    },
    "p031": {
      "source_hash": "12f7c50dc7d5",
      "text": "sebelum bola mata bergerak,"
    },
    "p032": {
      "source_hash": "aa8e60aed491",
      "text": "sekitar 50 sampai 100 ms,"
    },
    "p033": {
      "source_hash": "b55117212185",
      "text": "saraf visual sudah menurunkan sensitivitas!"
    },
    "p034": {
      "source_hash": "9fb56174653b",
      "text": "Dalam ilmu saraf,"
    },
    "p035": {
      "source_hash": "c64d55aa4ac1",
      "text": "ini disebut 'penekanan sakadik'."
    },
    "p036": {
      "source_hash": "0416f79b1f64",
      "text": "Menurunkan sensitivitas?"
    },
    "p037": {
      "source_hash": "5e8cc8c68eb5",
      "text": "Seperti meredupkan lampu kamar?"
    },
    "p038": {
      "source_hash": "f017aa537185",
      "text": "Kenapa kita tidak merasa"
    },
    "p039": {
      "source_hash": "a04a84ed7213",
      "text": "gelap mendadak?"
    },
    "p040": {
      "source_hash": "d457a7a37773",
      "text": "Karena otak pilih kasih!"
    },
    "p041": {
      "source_hash": "28fae10330d5",
      "text": "Hanya jalur terang-gelap,"
    },
    "p042": {
      "source_hash": "7f3c11d2613c",
      "text": "yang ditekan hingga 80 persen!"
    },
    "p043": {
      "source_hash": "1238cc5bc869",
      "text": "Tapi jalur warna,"
    },
    "p044": {
      "source_hash": "d3eadbec58a1",
      "text": "hampir seratus persen utuh."
    },
    "p045": {
      "source_hash": "0974165b86b3",
      "text": "Jadi kamu tak sadar redup."
    },
    "p046": {
      "source_hash": "d0eb5466c113",
      "text": "Dulu dikira otak pelakunya."
    },
    "p047": {
      "source_hash": "b2b2b2a28fcc",
      "text": "Medan pandang disekat,"
    },
    "p048": {
      "source_hash": "8c3b1231e0cc",
      "text": "cahaya hanya ke mata kiri,"
    },
    "p049": {
      "source_hash": "3775ef653350",
      "text": "mata kanan ikut tumpul pandangannya!"
    },
    "p050": {
      "source_hash": "7f2d81f94a0f",
      "text": "Sinyal kedua mata bertemu di otak,"
    },
    "p051": {
      "source_hash": "5c8f0eb1ff47",
      "text": "jadi tampak otak yang mengendalikan."
    },
    "p052": {
      "source_hash": "3c021820232c",
      "text": "Kasus tampak sudah selesai."
    },
    "p053": {
      "source_hash": "dabd2cd4f549",
      "text": "Tapi benarkah otak sendirian?"
    },
    "p054": {
      "source_hash": "36b88442656f",
      "text": "Kedengarannya sangat masuk akal!"
    },
    "p055": {
      "source_hash": "192c4c35995d",
      "text": "Otak menyuruh lirik sambil membisukan!"
    },
    "p056": {
      "source_hash": "82ff034dec4e",
      "text": "Tim Universitas Tübingen Jerman,"
    },
    "p057": {
      "source_hash": "369ba01b511a",
      "text": "melakukan eksperimen berani."
    },
    "p058": {
      "source_hash": "6fa4aae92d97",
      "text": "Mereka mengambil retina hewan,"
    },
    "p059": {
      "source_hash": "cef294c187ac",
      "text": "ditaruh di cawan petri."
    },
    "p060": {
      "source_hash": "1cac4f0ee564",
      "text": "Tanpa otak, tanpa saraf optik,"
    },
    "p061": {
      "source_hash": "9f483368729c",
      "text": "tanpa otot penggerak bola mata."
    },
    "p062": {
      "source_hash": "0400a0a5eea6",
      "text": "Hanya memakai proyektor cahaya,"
    },
    "p063": {
      "source_hash": "3c1a75b88564",
      "text": "menggeser pola garis di retina."
    },
    "p064": {
      "source_hash": "9e30fc951ca5",
      "text": "Sel saraf retina sendiri,"
    },
    "p065": {
      "source_hash": "c6456a0150d0",
      "text": "responsnya langsung turun 80 persen!"
    },
    "p066": {
      "source_hash": "6838f8b88c45",
      "text": "Sirkuit ganglion retina,"
    },
    "p067": {
      "source_hash": "fc9cbd148dec",
      "text": "mampu mendeteksi geseran cepat sendiri!"
    },
    "p068": {
      "source_hash": "5d8fb03047a0",
      "text": "Tak butuh perintah otak,"
    },
    "p069": {
      "source_hash": "dd6bd0d54a7f",
      "text": "inhibisi lateral sel sudah cukup."
    },
    "p070": {
      "source_hash": "b0159fc5de33",
      "text": "Pada manusia hidup juga sama:"
    },
    "p071": {
      "source_hash": "8d5fe009f33d",
      "text": "mata diam, hanya latar yang digeser,"
    },
    "p072": {
      "source_hash": "9fdf0a1b69b3",
      "text": "penurunan ketajaman visualnya"
    },
    "p073": {
      "source_hash": "7f8c211bac8f",
      "text": "lebih kuat dibanding melirik sendiri!"
    },
    "p074": {
      "source_hash": "0398ec641e3f",
      "text": "Bagaimana jika melihat dinding putih"
    },
    "p075": {
      "source_hash": "d46d01740d04",
      "text": "yang polos tanpa tekstur sama sekali?"
    },
    "p076": {
      "source_hash": "b7cb336df32e",
      "text": "Kamu menangkap petunjuk utamanya!"
    },
    "p077": {
      "source_hash": "7738f6968471",
      "text": "Di depan dinding putih polos,"
    },
    "p078": {
      "source_hash": "1284b771c955",
      "text": "penekanan visual hampir hilang total!"
    },
    "p079": {
      "source_hash": "4eb3adf1be7f",
      "text": "Ini membuktikan yang memotong sinyal"
    },
    "p080": {
      "source_hash": "9583552f9d55",
      "text": "adalah retina sendiri saat gambar meluncur!"
    },
    "p081": {
      "source_hash": "85c34dd9e192",
      "text": "Otak hanya mempersingkat waktu butanya."
    },
    "p082": {
      "source_hash": "ce9773655b03",
      "text": "Lalu bayangan samar saat meluncur,"
    },
    "p083": {
      "source_hash": "ff6e7a0847d6",
      "text": "lari ke mana?"
    },
    "p084": {
      "source_hash": "3d6d9a78e875",
      "text": "Gambar baru yang tajam saat berhenti,"
    },
    "p085": {
      "source_hash": "fb911873126f",
      "text": "langsung menimpa bayangan sebelumnya!"
    },
    "p086": {
      "source_hash": "1a0e486fc13d",
      "text": "Dalam psikologi,"
    },
    "p087": {
      "source_hash": "312b50ca1506",
      "text": "ini disebut 'masking mundur'."
    },
    "p088": {
      "source_hash": "88e282a80ea0",
      "text": "Sedangkan goyangan jeli lensa mata,"
    },
    "p089": {
      "source_hash": "64e905a9ce39",
      "text": "otak sudah terbiasa mengabaikannya."
    },
    "p090": {
      "source_hash": "e15e86e2278e",
      "text": "Apakah mekanisme perlindungan ini"
    },
    "p091": {
      "source_hash": "a0280ff53f4c",
      "text": "bisa dilatih agar lebih hebat?"
    },
    "p092": {
      "source_hash": "227503e20d47",
      "text": "Ternyata benar-benar bisa dilatih!"
    },
    "p093": {
      "source_hash": "e21016d431ff",
      "text": "Hanya latihan satu minggu,"
    },
    "p094": {
      "source_hash": "0484066f2be8",
      "text": "saat bola mata mendarat,"
    },
    "p095": {
      "source_hash": "718c7e3473ce",
      "text": "penekanan langsung lepas seketika!"
    },
    "p096": {
      "source_hash": "0c8958ad0907",
      "text": "Hebatnya, bayangan lirik tak dibuang."
    },
    "p097": {
      "source_hash": "cee635b025cc",
      "text": "Jika target tiba-tiba melompat,"
    },
    "p098": {
      "source_hash": "502aae134eaf",
      "text": "mengikuti arah bayangan tersisa,"
    },
    "p099": {
      "source_hash": "64b8c4e3a2a0",
      "text": "otak mengarahkan mata seperti radar!"
    },
    "p100": {
      "source_hash": "24329afbafc0",
      "text": "Otak tak membuang sinyal,"
    },
    "p101": {
      "source_hash": "84d0d03d6247",
      "text": "hanya menyaring derau."
    },
    "p102": {
      "source_hash": "4281a9020914",
      "text": "Gerak mata selesai, bagaimana dengan kedipan?"
    },
    "p103": {
      "source_hash": "73d7031b0193",
      "text": "Kelopak mata menutup,"
    },
    "p104": {
      "source_hash": "cdc0e807270e",
      "text": "gelap gulita lebih dari 100 ms,"
    },
    "p105": {
      "source_hash": "59c24b0c50e8",
      "text": "bukankah ini murni pemutusan sinyal?"
    },
    "p106": {
      "source_hash": "1fa507e37ff3",
      "text": "Malah sebaliknya!"
    },
    "p107": {
      "source_hash": "7324114abf3c",
      "text": "Gelapnya kedipan justru menajamkan mata!"
    },
    "p108": {
      "source_hash": "e3a1b967329c",
      "text": "Gelap lalu terang memicu denyut kontras,"
    },
    "p109": {
      "source_hash": "5dcc57442fdf",
      "text": "merangsang sel magnoseluler retina,"
    },
    "p110": {
      "source_hash": "1214981de48b",
      "text": "membuat kontur buram"
    },
    "p111": {
      "source_hash": "3e229d18c49a",
      "text": "menjadi jauh lebih jelas!"
    },
    "p112": {
      "source_hash": "4de16c5fe91c",
      "text": "Kalau pakai kacamata LCD berkedip,"
    },
    "p113": {
      "source_hash": "8d0df8db6b73",
      "text": "efeknya sama tidak?"
    },
    "p114": {
      "source_hash": "64268b36f375",
      "text": "NTU Singapura pernah mengujinya:"
    },
    "p115": {
      "source_hash": "6bde9ff0d5d8",
      "text": "mencari target dalam deretan huruf cepat,"
    },
    "p116": {
      "source_hash": "2224d13af795",
      "text": "dalam 300 ms setelah berkedip,"
    },
    "p117": {
      "source_hash": "a2b37cdf68aa",
      "text": "akurasi melonjak dari 75% ke 86%!"
    },
    "p118": {
      "source_hash": "a18d9d51eb1d",
      "text": "Tapi dengan kacamata LCD tiruan kedip,"
    },
    "p119": {
      "source_hash": "529ada008529",
      "text": "akurasi sama sekali tidak naik!"
    },
    "p120": {
      "source_hash": "1d6eac86d097",
      "text": "Karena kedipan asli melibatkan otot,"
    },
    "p121": {
      "source_hash": "d89b4553fa71",
      "text": "menekan tombol 'refresh' perhatian visual!"
    },
    "p122": {
      "source_hash": "ecd6b4990666",
      "text": "Ternyata berkedip bukan malas,"
    },
    "p123": {
      "source_hash": "0a2015b61b32",
      "text": "tapi menyalakan ulang mata!"
    },
    "p124": {
      "source_hash": "4c1335a38e91",
      "text": "Hebatnya, otak tak sembarangan berkedip."
    },
    "p125": {
      "source_hash": "35cede565685",
      "text": "Otak adalah sutradara kelas dunia!"
    },
    "p126": {
      "source_hash": "0f9d43be74b6",
      "text": "Universitas Tokyo meneliti penonton komedi,"
    },
    "p127": {
      "source_hash": "766566b36eee",
      "text": "lebih dari 60 persen penonton,"
    },
    "p128": {
      "source_hash": "0c2df7f7955b",
      "text": "berkedip pada milidetik yang sama!"
    },
    "p129": {
      "source_hash": "216c22d89642",
      "text": "Tepat saat aksi aktor selesai."
    },
    "p130": {
      "source_hash": "90f42b81eda0",
      "text": "Universitas Würzburg menguji di ruang gelap,"
    },
    "p131": {
      "source_hash": "ab22bdca21c6",
      "text": "menilai hanya dengan telinga."
    },
    "p132": {
      "source_hash": "2532babfcc71",
      "text": "Peserta menahan kedipan selama audio berbunyi,"
    },
    "p133": {
      "source_hash": "5c31428d78c9",
      "text": "baru berkedip setelah otak selesai menilai!"
    },
    "p134": {
      "source_hash": "3a49707dc1b3",
      "text": "Lalu saat kita berjalan,"
    },
    "p135": {
      "source_hash": "d66696ad3a73",
      "text": "atau menolehkan kepala?"
    },
    "p136": {
      "source_hash": "8a86a49be60e",
      "text": "Universitas Texas menganalisis 38.000 kedipan:"
    },
    "p137": {
      "source_hash": "58e18f61deed",
      "text": "kedipan ditahan sebelum kepala menoleh,"
    },
    "p138": {
      "source_hash": "5bff6b5c1b70",
      "text": "lalu disembunyikan di ayunan tercepat"
    },
    "p139": {
      "source_hash": "f6dba85207f7",
      "text": "yang memang sudah buram!"
    },
    "p140": {
      "source_hash": "b17979efbfd2",
      "text": "Contoh terbaik adalah pebalap Formula."
    },
    "p141": {
      "source_hash": "4c1aa3b70f55",
      "text": "Kecepatan 300 km/jam selama 300 putaran,"
    },
    "p142": {
      "source_hash": "1d9b8be4b1e8",
      "text": "titik kedipan pebalap profesional,"
    },
    "p143": {
      "source_hash": "e8d0fc5d87b6",
      "text": "lebih dari 80% bertumpuk di lintasan lurus!"
    },
    "p144": {
      "source_hash": "0ee727f4b990",
      "text": "Di tikungan tajam dan titik pengereman,"
    },
    "p145": {
      "source_hash": "a1906ddad3d1",
      "text": "semua pebalap menolak berkedip!"
    },
    "p146": {
      "source_hash": "8396b87392ba",
      "text": "Di saat genting, kendali titik buta otak"
    },
    "p147": {
      "source_hash": "b112d092af92",
      "text": "akurat hingga milidetik."
    },
    "p148": {
      "source_hash": "e601330badfe",
      "text": "Paham!"
    },
    "p149": {
      "source_hash": "7ee399b5d5c1",
      "text": "Saat melirik, retina memutus derau,"
    },
    "p150": {
      "source_hash": "1b2f3d9a8abf",
      "text": "gambar baru menutupi goyangan jeli;"
    },
    "p151": {
      "source_hash": "5789bf2b2101",
      "text": "saat berkedip, gelap me-reboot saraf!"
    },
    "p152": {
      "source_hash": "96e27b21d4e5",
      "text": "Otak memilih momen paling aman!"
    },
    "p153": {
      "source_hash": "058b1acfd1b9",
      "text": "Jutaan tahun kerja sama mata dan otak,"
    },
    "p154": {
      "source_hash": "2d2194f748dc",
      "text": "inilah rahasianya—Begitu Toh!"
    },
    "p155": {
      "source_hash": "55edd55a3456",
      "text": "Di depan cermin,"
    },
    "p156": {
      "source_hash": "c53fd58c1c5c",
      "text": "coba alihkan tatapan antar mata."
    },
    "p157": {
      "source_hash": "75c06ef42d0c",
      "text": "Secepat apa pun kamu melirik,"
    },
    "p158": {
      "source_hash": "66285daa72d4",
      "text": "kamu takkan pernah melihat matamu bergerak!"
    },
    "p159": {
      "source_hash": "309c078515dc",
      "text": "Inilah teknik editing paling mulus di tubuh kita."
    },
    "p160": {
      "source_hash": "7e04dc527092",
      "text": "Punya pertanyaan unik? Datanglah ke Kantor Begitu Toh!"
    }
  }
}
