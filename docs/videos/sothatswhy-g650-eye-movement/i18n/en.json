    "tags": "f09281972305",
    "thumbnail": "a046660c5d1e"
  },
  "lines": {
    "p001": {
      "source_hash": "a4e39c59e359",
      "text": "Chief! I just rolled my eyes hard in the mirror,"
    },
    "p002": {
      "source_hash": "d943cefd9ae4",
      "text": "getting dizzy,"
    },
    "p003": {
      "source_hash": "44f088ad6731",
      "text": "but why didn't my reflection blur at all?"
    },
    "p004": {
      "source_hash": "81f2c96a3683",
      "text": "Shake a phone just slightly,"
    },
    "p005": {
      "source_hash": "e0c67d5febdc",
      "text": "and the photo gets blurry."
    },
    "p006": {
      "source_hash": "689ec34b0288",
      "text": "Our eyes dart fast,"
    },
    "p007": {
      "source_hash": "6476bd9de413",
      "text": "why doesn't vision blur?"
    },
    "p008": {
      "source_hash": "e57a1f99e16a",
      "text": "By the laws of physics,"
    },
    "p009": {
      "source_hash": "ffdcf3cd39d9",
      "text": "it should blur,"
    },
    "p010": {
      "source_hash": "fdf1ac62632b",
      "text": "and wobble too!"
    },
    "p011": {
      "source_hash": "4389fa748dc5",
      "text": "Murcia University tracked this:"
    },
    "p012": {
      "source_hash": "645be0ef5376",
      "text": "inertia makes the stopped lens"
    },
    "p013": {
      "source_hash": "4ee33720dc0e",
      "text": "wobble like jelly for sixty-five ms,"
    },
    "p014": {
      "source_hash": "7b1bcb86759c",
      "text": "making images"
    },
    "p015": {
      "source_hash": "76810c12112c",
      "text": "shake point-three degrees!"
    },
    "p016": {
      "source_hash": "bc3104336af0",
      "text": "You should see a blur,"
    },
    "p017": {
      "source_hash": "59babe48a19c",
      "text": "with each turn,"
    },
    "p018": {
      "source_hash": "3ddd0ceca2e3",
      "text": "then see the world"
    },
    "p019": {
      "source_hash": "ce5cd8ff711f",
      "text": "wobble like jelly."
    },
    "p020": {
      "source_hash": "a58c61173d09",
      "text": "Plus you blink twenty times a minute,"
    },
    "p021": {
      "source_hash": "b293f0d152a0",
      "text": "each dark over 100 ms."
    },
    "p022": {
      "source_hash": "c1da75ef8fb2",
      "text": "In a day, that adds up to minutes,"
    },
    "p023": {
      "source_hash": "f710ec912658",
      "text": "in pure darkness."
    },
    "p024": {
      "source_hash": "4b187434fdac",
      "text": "Total black?!"
    },
    "p025": {
      "source_hash": "834a5f9ac3bf",
      "text": "How did I miss it?"
    },
    "p026": {
      "source_hash": "17085770c7f8",
      "text": "Walking, reading, or running,"
    },
    "p027": {
      "source_hash": "f543e9c61b69",
      "text": "the world always stays smooth!"
    },
    "p028": {
      "source_hash": "5e0418b01237",
      "text": "Where did it go?"
    },
    "p029": {
      "source_hash": "daa24854cc04",
      "text": "Today we find the answer!"
    },
    "p030": {
      "source_hash": "92336f3696dd",
      "text": "Studies measured:"
    },
    "p031": {
      "source_hash": "12f7c50dc7d5",
      "text": "before the eye moves,"
    },
    "p032": {
      "source_hash": "aa8e60aed491",
      "text": "in 50-100 ms,"
    },
    "p033": {
      "source_hash": "b55117212185",
      "text": "nerves already dim sensitivity!"
    },
    "p034": {
      "source_hash": "9fb56174653b",
      "text": "In science,"
    },
    "p035": {
      "source_hash": "c64d55aa4ac1",
      "text": "it's suppression."
    },
    "p036": {
      "source_hash": "0416f79b1f64",
      "text": "Dim sensitivity?"
    },
    "p037": {
      "source_hash": "5e8cc8c68eb5",
      "text": "Like dimming a room's light switch?"
    },
    "p038": {
      "source_hash": "f017aa537185",
      "text": "Why never notice"
    },
    "p039": {
      "source_hash": "a04a84ed7213",
      "text": "the sudden darkness?"
    },
    "p040": {
      "source_hash": "d457a7a37773",
      "text": "The brain is biased!"
    },
    "p041": {
      "source_hash": "28fae10330d5",
      "text": "It dims the luminance channel,"
    },
    "p042": {
      "source_hash": "7f3c11d2613c",
      "text": "dropping it eighty percent!"
    },
    "p043": {
      "source_hash": "1238cc5bc869",
      "text": "Yet the color channel"
    },
    "p044": {
      "source_hash": "d3eadbec58a1",
      "text": "stays totally intact."
    },
    "p045": {
      "source_hash": "0974165b86b3",
      "text": "So you never see it dim."
    },
    "p046": {
      "source_hash": "d0eb5466c113",
      "text": "We thought the brain ran it."
    },
    "p047": {
      "source_hash": "b2b2b2a28fcc",
      "text": "Dividing visual fields with a screen,"
    },
    "p048": {
      "source_hash": "8c3b1231e0cc",
      "text": "flash left eye,"
    },
    "p049": {
      "source_hash": "3775ef653350",
      "text": "dulled vision in right eye too!"
    },
    "p050": {
      "source_hash": "7f2d81f94a0f",
      "text": "Signals meet in the brain,"
    },
    "p051": {
      "source_hash": "5c8f0eb1ff47",
      "text": "suggesting the brain commands it all."
    },
    "p052": {
      "source_hash": "3c021820232c",
      "text": "Case seemed closed."
    },
    "p053": {
      "source_hash": "dabd2cd4f549",
      "text": "Is the brain acting alone?"
    },
    "p054": {
      "source_hash": "36b88442656f",
      "text": "Sounds right!"
    },
    "p055": {
      "source_hash": "192c4c35995d",
      "text": "Brain orders eye movement and mutes input!"
    },
    "p056": {
      "source_hash": "82ff034dec4e",
      "text": "Tübingen teams"
    },
    "p057": {
      "source_hash": "369ba01b511a",
      "text": "did a bolder experiment."
    },
    "p058": {
      "source_hash": "6fa4aae92d97",
      "text": "They isolated animal retinas,"
    },
    "p059": {
      "source_hash": "cef294c187ac",
      "text": "resting in a petri dish."
    },
    "p060": {
      "source_hash": "1cac4f0ee564",
      "text": "No brain, no optic nerves,"
    },
    "p061": {
      "source_hash": "9f483368729c",
      "text": "no eye muscles moving."
    },
    "p062": {
      "source_hash": "0400a0a5eea6",
      "text": "With light beams,"
    },
    "p063": {
      "source_hash": "3c1a75b88564",
      "text": "patterns swept across the retina."
    },
    "p064": {
      "source_hash": "9e30fc951ca5",
      "text": "Retinal neurons themselves"
    },
    "p065": {
      "source_hash": "c6456a0150d0",
      "text": "dropped response by eighty percent!"
    },
    "p066": {
      "source_hash": "6838f8b88c45",
      "text": "Retinal circuits"
    },
    "p067": {
      "source_hash": "fc9cbd148dec",
      "text": "detect rapid motion alone!"
    },
    "p068": {
      "source_hash": "5d8fb03047a0",
      "text": "No brain command is needed,"
    },
    "p069": {
      "source_hash": "dd6bd0d54a7f",
      "text": "lateral inhibition is enough."
    },
    "p070": {
      "source_hash": "b0159fc5de33",
      "text": "True in living humans too:"
    },
    "p071": {
      "source_hash": "8d5fe009f33d",
      "text": "keep eyes still, sweep background only,"
    },
    "p072": {
      "source_hash": "9fdf0a1b69b3",
      "text": "sensitivity drop"
    },
    "p073": {
      "source_hash": "7f8c211bac8f",
      "text": "is stronger than during real eye movements!"
    },
    "p074": {
      "source_hash": "0398ec641e3f",
      "text": "What if eyes move against"
    },
    "p075": {
      "source_hash": "d46d01740d04",
      "text": "a blank, textureless white wall?"
    },
    "p076": {
      "source_hash": "b7cb336df32e",
      "text": "You hit the core clue!"
    },
    "p077": {
      "source_hash": "7738f6968471",
      "text": "Against uniform, patternless walls,"
    },
    "p078": {
      "source_hash": "1284b771c955",
      "text": "suppression vanishes!"
    },
    "p079": {
      "source_hash": "4eb3adf1be7f",
      "text": "Proof that what blinds us"
    },
    "p080": {
      "source_hash": "9583552f9d55",
      "text": "is the retina cutting image blur itself!"
    },
    "p081": {
      "source_hash": "85c34dd9e192",
      "text": "The brain only minimizes the blind time."
    },
    "p082": {
      "source_hash": "ce9773655b03",
      "text": "What about streaks during motion?"
    },
    "p083": {
      "source_hash": "ff6e7a0847d6",
      "text": "Where are they?"
    },
    "p084": {
      "source_hash": "3d6d9a78e875",
      "text": "The new sharp image upon landing"
    },
    "p085": {
      "source_hash": "fb911873126f",
      "text": "overwrites the motion smear!"
    },
    "p086": {
      "source_hash": "1a0e486fc13d",
      "text": "Known as"
    },
    "p087": {
      "source_hash": "312b50ca1506",
      "text": "this is 'backward masking'."
    },
    "p088": {
      "source_hash": "88e282a80ea0",
      "text": "As for lens jelly wobble,"
    },
    "p089": {
      "source_hash": "64e905a9ce39",
      "text": "the brain simply learned to ignore it."
    },
    "p090": {
      "source_hash": "e15e86e2278e",
      "text": "Can this mechanism"
    },
    "p091": {
      "source_hash": "a0280ff53f4c",
      "text": "be sharpened with practice?"
    },
    "p092": {
      "source_hash": "227503e20d47",
      "text": "It can be trained!"
    },
    "p093": {
      "source_hash": "e21016d431ff",
      "text": "With just one week of training,"
    },
    "p094": {
      "source_hash": "0484066f2be8",
      "text": "the moment eyes land,"
    },
    "p095": {
      "source_hash": "718c7e3473ce",
      "text": "suppression lifts instantly!"
    },
    "p096": {
      "source_hash": "0c8958ad0907",
      "text": "Better yet, motion smear isn't wasted."
    },
    "p097": {
      "source_hash": "cee635b025cc",
      "text": "If targets jump mid-turn,"
    },
    "p098": {
      "source_hash": "502aae134eaf",
      "text": "the brain uses smear"
    },
    "p099": {
      "source_hash": "64b8c4e3a2a0",
      "text": "to guide saccades like radar!"
    },
    "p100": {
      "source_hash": "24329afbafc0",
      "text": "No signal is wasted,"
    },
    "p101": {
      "source_hash": "84d0d03d6247",
      "text": "it just filters noise."
    },
    "p102": {
      "source_hash": "4281a9020914",
      "text": "Saccades solved, what about blinking?"
    },
    "p103": {
      "source_hash": "73d7031b0193",
      "text": "Eyelids snap shut,"
    },
    "p104": {
      "source_hash": "cdc0e807270e",
      "text": "pitch black over 100 ms."
    },
    "p105": {
      "source_hash": "59c24b0c50e8",
      "text": "Isn't that total signal loss?"
    },
    "p106": {
      "source_hash": "1fa507e37ff3",
      "text": "Opposite!"
    },
    "p107": {
      "source_hash": "7324114abf3c",
      "text": "Blinks help you see clearly!"
    },
    "p108": {
      "source_hash": "e3a1b967329c",
      "text": "Darkness then light creates a pulse,"
    },
    "p109": {
      "source_hash": "5dcc57442fdf",
      "text": "firing retinal M-cells,"
    },
    "p110": {
      "source_hash": "1214981de48b",
      "text": "boosting sensitivity"
    },
    "p111": {
      "source_hash": "3e229d18c49a",
      "text": "to coarse outlines!"
    },
    "p112": {
      "source_hash": "4de16c5fe91c",
      "text": "If shutter glasses mimic blinks,"
    },
    "p113": {
      "source_hash": "8d0df8db6b73",
      "text": "does it work the same?"
    },
    "p114": {
      "source_hash": "64268b36f375",
      "text": "NTU Singapore tested this:"
    },
    "p115": {
      "source_hash": "6bde9ff0d5d8",
      "text": "finding letter targets,"
    },
    "p116": {
      "source_hash": "2224d13af795",
      "text": "within 300 ms post-blink,"
    },
    "p117": {
      "source_hash": "a2b37cdf68aa",
      "text": "accuracy soared from 75 to 86%!"
    },
    "p118": {
      "source_hash": "a18d9d51eb1d",
      "text": "With LCD shutter glasses,"
    },
    "p119": {
      "source_hash": "529ada008529",
      "text": "accuracy showed zero gain!"
    },
    "p120": {
      "source_hash": "1d6eac86d097",
      "text": "Real blinks trigger muscle signals,"
    },
    "p121": {
      "source_hash": "d89b4553fa71",
      "text": "refreshing visual attention!"
    },
    "p122": {
      "source_hash": "ecd6b4990666",
      "text": "Blinking isn't slacking off,"
    },
    "p123": {
      "source_hash": "0a2015b61b32",
      "text": "it is rebooting vision!"
    },
    "p124": {
      "source_hash": "4c1335a38e91",
      "text": "Blinks aren't random either."
    },
    "p125": {
      "source_hash": "35cede565685",
      "text": "The brain is a master film director!"
    },
    "p126": {
      "source_hash": "0f9d43be74b6",
      "text": "Tokyo University showed comedies,"
    },
    "p127": {
      "source_hash": "766566b36eee",
      "text": "viewers synchronized over 60%,"
    },
    "p128": {
      "source_hash": "0c2df7f7955b",
      "text": "closing eyes together,"
    },
    "p129": {
      "source_hash": "216c22d89642",
      "text": "right when scene action concluded."
    },
    "p130": {
      "source_hash": "90f42b81eda0",
      "text": "Würzburg University put subjects in dark rooms,"
    },
    "p131": {
      "source_hash": "ab22bdca21c6",
      "text": "deciding by ear alone."
    },
    "p132": {
      "source_hash": "2532babfcc71",
      "text": "Subjects withheld blinks during sounds,"
    },
    "p133": {
      "source_hash": "5c31428d78c9",
      "text": "blinking only after deciding!"
    },
    "p134": {
      "source_hash": "3a49707dc1b3",
      "text": "What about walking"
    },
    "p135": {
      "source_hash": "d66696ad3a73",
      "text": "and turn our heads?"
    },
    "p136": {
      "source_hash": "8a86a49be60e",
      "text": "UT Austin analyzed blinks:"
    },
    "p137": {
      "source_hash": "58e18f61deed",
      "text": "blinks pause before turning,"
    },
    "p138": {
      "source_hash": "5bff6b5c1b70",
      "text": "tucking them into the fastest,"
    },
    "p139": {
      "source_hash": "f6dba85207f7",
      "text": "blurred sweep!"
    },
    "p140": {
      "source_hash": "b17979efbfd2",
      "text": "Formula racers prove it:"
    },
    "p141": {
      "source_hash": "4c1aa3b70f55",
      "text": "At 300 km/h over 300 laps,"
    },
    "p142": {
      "source_hash": "1d9b8be4b1e8",
      "text": "drivers' blink locations"
    },
    "p143": {
      "source_hash": "e8d0fc5d87b6",
      "text": "overlap 80% on straightaways!"
    },
    "p144": {
      "source_hash": "0ee727f4b990",
      "text": "In hard turns and braking,"
    },
    "p145": {
      "source_hash": "a1906ddad3d1",
      "text": "every driver refuses to blink!"
    },
    "p146": {
      "source_hash": "8396b87392ba",
      "text": "In life and death, brain timing"
    },
    "p147": {
      "source_hash": "b112d092af92",
      "text": "is millisecond sharp."
    },
    "p148": {
      "source_hash": "e601330badfe",
      "text": "I get it!"
    },
    "p149": {
      "source_hash": "7ee399b5d5c1",
      "text": "When rolling eyes, retina cuts noise,"
    },
    "p150": {
      "source_hash": "1b2f3d9a8abf",
      "text": "landing masks jelly wobbles;"
    },
    "p151": {
      "source_hash": "5789bf2b2101",
      "text": "when blinking, darkness reboots nerves!"
    },
    "p152": {
      "source_hash": "96e27b21d4e5",
      "text": "The brain picks safe moments to act!"
    },
    "p153": {
      "source_hash": "058b1acfd1b9",
      "text": "Millions of years of co-evolution,"
    },
    "p154": {
      "source_hash": "2d2194f748dc",
      "text": "that's it—So That's Why!"
    },
    "p155": {
      "source_hash": "55edd55a3456",
      "text": "At a mirror,"
    },
    "p156": {
      "source_hash": "c53fd58c1c5c",
      "text": "shift gaze between eyes."
    },
    "p157": {
      "source_hash": "75c06ef42d0c",
      "text": "No matter how fast you dart,"
    },
    "p158": {
      "source_hash": "66285daa72d4",
      "text": "you'll never catch your eyes moving!"
    },
    "p159": {
      "source_hash": "309c078515dc",
      "text": "Our body's most seamless editing."
    },
    "p160": {
      "source_hash": "7e04dc527092",
      "text": "For curious questions, visit So That's Why Office!"
    }
  }
}
