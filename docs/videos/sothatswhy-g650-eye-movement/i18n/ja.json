      "chief-clapboard": "9c7ba296b8e2",
      "kid-joyful-summary": "6b91fd80cf9f"
    },
    "title": "28c77afc0c00",
    "description": "fb645a08cdd6",
    "tags": "f09281972305",
    "thumbnail": "70d6ee63a0d2"
  },
  "lines": {
    "p001": {
      "source_hash": "a4e39c59e359",
      "text": "所長！鏡を見て目を強く動かしたら、"
    },
    "p002": {
      "source_hash": "d943cefd9ae4",
      "text": "目が回りましたが、"
    },
    "p003": {
      "source_hash": "44f088ad6731",
      "text": "鏡の中の自分は全然ブレていません！"
    },
    "p004": {
      "source_hash": "81f2c96a3683",
      "text": "スマホを手で揺らすと、"
    },
    "p005": {
      "source_hash": "e0c67d5febdc",
      "text": "写真はブレてしまいますよね。"
    },
    "p006": {
      "source_hash": "689ec34b0288",
      "text": "目は速く動くのに、"
    },
    "p007": {
      "source_hash": "6476bd9de413",
      "text": "なぜブレないのですか？"
    },
    "p008": {
      "source_hash": "e57a1f99e16a",
      "text": "物理法則に従えば、"
    },
    "p009": {
      "source_hash": "ffdcf3cd39d9",
      "text": "ブレるだけでなく、"
    },
    "p010": {
      "source_hash": "fdf1ac62632b",
      "text": "揺れるはずです！"
    },
    "p011": {
      "source_hash": "4389fa748dc5",
      "text": "ムルシア大の追跡によると、"
    },
    "p012": {
      "source_hash": "645be0ef5376",
      "text": "停止時に水晶体が慣性で、"
    },
    "p013": {
      "source_hash": "4ee33720dc0e",
      "text": "ゼリーのように65ミリ秒揺れ、"
    },
    "p014": {
      "source_hash": "7b1bcb86759c",
      "text": "網膜の像を、"
    },
    "p015": {
      "source_hash": "76810c12112c",
      "text": "最大0.3度も揺らします！"
    },
    "p016": {
      "source_hash": "bc3104336af0",
      "text": "動かすたびにブレが見え、"
    },
    "p017": {
      "source_hash": "59babe48a19c",
      "text": "世界が揺れるはずです。"
    },
    "p018": {
      "source_hash": "3ddd0ceca2e3",
      "text": "さらに毎分20回も瞬きし、"
    },
    "p019": {
      "source_hash": "ce5cd8ff711f",
      "text": "毎回100ミリ秒暗転します。"
    },
    "p020": {
      "source_hash": "a58c61173d09",
      "text": "1日で見れば何十分も、"
    },
    "p021": {
      "source_hash": "b293f0d152a0",
      "text": "目の前は真っ暗なのです。"
    },
    "p022": {
      "source_hash": "c1da75ef8fb2",
      "text": "何十分も真っ暗？！"
    },
    "p023": {
      "source_hash": "f710ec912658",
      "text": "全く気づきませんでした！"
    },
    "p024": {
      "source_hash": "4b187434fdac",
      "text": "歩く時も本を読む時も、"
    },
    "p025": {
      "source_hash": "834a5f9ac3bf",
      "text": "滑らかに見えます！"
    },
    "p026": {
      "source_hash": "17085770c7f8",
      "text": "その映像はどこへ？"
    },
    "p027": {
      "source_hash": "f543e9c61b69",
      "text": "今日はその謎を解明します！"
    },
    "p028": {
      "source_hash": "5e0418b01237",
      "text": "測定の結果、"
    },
    "p029": {
      "source_hash": "daa24854cc04",
      "text": "眼球が動く50〜100ミリ秒前に、"
    },
    "p030": {
      "source_hash": "92336f3696dd",
      "text": "神経の感度を下げているのです！"
    },
    "p031": {
      "source_hash": "12f7c50dc7d5",
      "text": "これを神経科学で、"
    },
    "p032": {
      "source_hash": "aa8e60aed491",
      "text": "「サッカード抑制」と言います。"
    },
    "p033": {
      "source_hash": "b55117212185",
      "text": "感度を下げる？"
    },
    "p034": {
      "source_hash": "9fb56174653b",
      "text": "科学では、"
    },
    "p035": {
      "source_hash": "c64d55aa4ac1",
      "text": "なぜ暗さを感じないのですか？"
    },
    "p036": {
      "source_hash": "0416f79b1f64",
      "text": "脳が偏っているからです！"
    },
    "p037": {
      "source_hash": "5e8cc8c68eb5",
      "text": "明暗を感じる輝度経路だけを、"
    },
    "p038": {
      "source_hash": "f017aa537185",
      "text": "8割も急激に下げますが、"
    },
    "p039": {
      "source_hash": "a04a84ed7213",
      "text": "色を感じる経路は、"
    },
    "p040": {
      "source_hash": "d457a7a37773",
      "text": "ほぼ100％保たれるからです。"
    },
    "p041": {
      "source_hash": "28fae10330d5",
      "text": "だから暗さに気づきません。"
    },
    "p042": {
      "source_hash": "7f3c11d2613c",
      "text": "かつては脳の仕業とされました。"
    },
    "p043": {
      "source_hash": "1238cc5bc869",
      "text": "視野を仕切り、"
    },
    "p044": {
      "source_hash": "d3eadbec58a1",
      "text": "左目だけに強い光を当てると、"
    },
    "p045": {
      "source_hash": "0974165b86b3",
      "text": "右目の感度も低下したのです！"
    },
    "p046": {
      "source_hash": "d0eb5466c113",
      "text": "左右の信号は脳で合流するため、"
    },
    "p047": {
      "source_hash": "b2b2b2a28fcc",
      "text": "脳が主導していると考えられました。"
    },
    "p048": {
      "source_hash": "8c3b1231e0cc",
      "text": "一件落着と思いきや、"
    },
    "p049": {
      "source_hash": "3775ef653350",
      "text": "本当に脳だけでしょうか？"
    },
    "p050": {
      "source_hash": "7f2d81f94a0f",
      "text": "筋が通っていますよね！"
    },
    "p051": {
      "source_hash": "5c8f0eb1ff47",
      "text": "脳が指示を出し、消音するなんて！"
    },
    "p052": {
      "source_hash": "3c021820232c",
      "text": "独テュービンゲン大は、"
    },
    "p053": {
      "source_hash": "dabd2cd4f549",
      "text": "大胆な実験を行いました。"
    },
    "p054": {
      "source_hash": "36b88442656f",
      "text": "動物の網膜だけを取り出し、"
    },
    "p055": {
      "source_hash": "192c4c35995d",
      "text": "培養皿に静かに置きました。"
    },
    "p056": {
      "source_hash": "82ff034dec4e",
      "text": "脳も視神経も、"
    },
    "p057": {
      "source_hash": "369ba01b511a",
      "text": "動かす筋肉もありません。"
    },
    "p058": {
      "source_hash": "6fa4aae92d97",
      "text": "投影光を使い、"
    },
    "p059": {
      "source_hash": "cef294c187ac",
      "text": "縞模様を高速で流しました。"
    },
    "p060": {
      "source_hash": "1cac4f0ee564",
      "text": "すると網膜の神経細胞の反応が、"
    },
    "p061": {
      "source_hash": "9f483368729c",
      "text": "その場で8割も低下したのです！"
    },
    "p062": {
      "source_hash": "0400a0a5eea6",
      "text": "網膜の回路自身が、"
    },
    "p063": {
      "source_hash": "3c1a75b88564",
      "text": "高速の動きを検知できるのです！"
    },
    "p064": {
      "source_hash": "9e30fc951ca5",
      "text": "脳の指令を待つ必要はなく、"
    },
    "p065": {
      "source_hash": "c6456a0150d0",
      "text": "受容器同士の側頭抑制で十分です。"
    },
    "p066": {
      "source_hash": "6838f8b88c45",
      "text": "生きた人間でも同様です："
    },
    "p067": {
      "source_hash": "fc9cbd148dec",
      "text": "目を固定し背景だけを流すと、"
    },
    "p068": {
      "source_hash": "5d8fb03047a0",
      "text": "自発的な眼球運動よりも、"
    },
    "p069": {
      "source_hash": "dd6bd0d54a7f",
      "text": "強く長く感度が下がります！"
    },
    "p070": {
      "source_hash": "b0159fc5de33",
      "text": "模様のない真っ白な壁を見たら？"
    },
    "p071": {
      "source_hash": "8d5fe009f33d",
      "text": "まさにそこが核心です！"
    },
    "p072": {
      "source_hash": "9fdf0a1b69b3",
      "text": "均一な壁の前では、"
    },
    "p073": {
      "source_hash": "7f8c211bac8f",
      "text": "サッカード抑制が消えます！"
    },
    "p074": {
      "source_hash": "0398ec641e3f",
      "text": "つまり視覚を遮断するのは、"
    },
    "p075": {
      "source_hash": "d46d01740d04",
      "text": "網膜自身の働きだったのです！"
    },
    "p076": {
      "source_hash": "b7cb336df32e",
      "text": "脳は時間を最小化するだけです。"
    },
    "p077": {
      "source_hash": "7738f6968471",
      "text": "流れた残像はどこへ？"
    },
    "p078": {
      "source_hash": "1284b771c955",
      "text": "停止後の新しい像が鮮明すぎて、"
    },
    "p079": {
      "source_hash": "4eb3adf1be7f",
      "text": "前の残像を完全に上書きします！"
    },
    "p080": {
      "source_hash": "9583552f9d55",
      "text": "心理学では、"
    },
    "p081": {
      "source_hash": "85c34dd9e192",
      "text": "これを「後方マスキング」と呼びます。"
    },
    "p082": {
      "source_hash": "ce9773655b03",
      "text": "水晶体の揺れも、"
    },
    "p083": {
      "source_hash": "ff6e7a0847d6",
      "text": "残像はどこへ？"
    },
    "p084": {
      "source_hash": "3d6d9a78e875",
      "text": "この仕組みは訓練できますか？"
    },
    "p085": {
      "source_hash": "fb911873126f",
      "text": "実は鍛えることができます！"
    },
    "p086": {
      "source_hash": "1a0e486fc13d",
      "text": "1週間の訓練で、"
    },
    "p087": {
      "source_hash": "312b50ca1506",
      "text": "眼球が止まった瞬間に、"
    },
    "p088": {
      "source_hash": "88e282a80ea0",
      "text": "抑制を解くことができます！"
    },
    "p089": {
      "source_hash": "64e905a9ce39",
      "text": "さらに流れた像も無駄にしません。"
    },
    "p090": {
      "source_hash": "e15e86e2278e",
      "text": "目標が不意に動いた場合、"
    },
    "p091": {
      "source_hash": "a0280ff53f4c",
      "text": "残像の方向を手がかりに、"
    },
    "p092": {
      "source_hash": "227503e20d47",
      "text": "レーダーのように視線を誘導します！"
    },
    "p093": {
      "source_hash": "e21016d431ff",
      "text": "脳は信号を無駄にせず、"
    },
    "p094": {
      "source_hash": "0484066f2be8",
      "text": "雑音だけを省くのです。"
    },
    "p095": {
      "source_hash": "718c7e3473ce",
      "text": "では、まばたきはどうでしょう？"
    },
    "p096": {
      "source_hash": "0c8958ad0907",
      "text": "まぶたが閉じ、"
    },
    "p097": {
      "source_hash": "cee635b025cc",
      "text": "100ミリ秒以上真っ暗になります。"
    },
    "p098": {
      "source_hash": "502aae134eaf",
      "text": "これは単なる中断では？"
    },
    "p099": {
      "source_hash": "64b8c4e3a2a0",
      "text": "正反対です！"
    },
    "p100": {
      "source_hash": "24329afbafc0",
      "text": "暗転がむしろ視力を高めます！"
    },
    "p101": {
      "source_hash": "84d0d03d6247",
      "text": "明暗のパルスが加わることで、"
    },
    "p102": {
      "source_hash": "4281a9020914",
      "text": "網膜のマクロ細胞が刺激され、"
    },
    "p103": {
      "source_hash": "73d7031b0193",
      "text": "輪郭を捉える能力が、"
    },
    "p104": {
      "source_hash": "cdc0e807270e",
      "text": "大幅に向上します！"
    },
    "p105": {
      "source_hash": "59c24b0c50e8",
      "text": "液晶メガネで暗転させたら？"
    },
    "p106": {
      "source_hash": "1fa507e37ff3",
      "text": "逆です！"
    },
    "p107": {
      "source_hash": "7324114abf3c",
      "text": "連続文字から目標を探す際、"
    },
    "p108": {
      "source_hash": "e3a1b967329c",
      "text": "瞬き直後の300ミリ秒は、"
    },
    "p109": {
      "source_hash": "5dcc57442fdf",
      "text": "正答率が75％から86％に上昇！"
    },
    "p110": {
      "source_hash": "1214981de48b",
      "text": "しかし液晶メガネでは、"
    },
    "p111": {
      "source_hash": "3e229d18c49a",
      "text": "正答率は向上しませんでした！"
    },
    "p112": {
      "source_hash": "4de16c5fe91c",
      "text": "本物の瞬きは筋肉感覚を伴い、"
    },
    "p113": {
      "source_hash": "8d0df8db6b73",
      "text": "注意力をリフレッシュするからです！"
    },
    "p114": {
      "source_hash": "64268b36f375",
      "text": "瞬きはサボりではなく、"
    },
    "p115": {
      "source_hash": "6bde9ff0d5d8",
      "text": "視覚の再起動だったのですね！"
    },
    "p116": {
      "source_hash": "2224d13af795",
      "text": "しかも脳は適当には瞬きしません。"
    },
    "p117": {
      "source_hash": "a2b37cdf68aa",
      "text": "脳は優秀な映像監督です！"
    },
    "p118": {
      "source_hash": "a18d9d51eb1d",
      "text": "東大の実験では、"
    },
    "p119": {
      "source_hash": "529ada008529",
      "text": "観客の6割以上が、"
    },
    "p120": {
      "source_hash": "1d6eac86d097",
      "text": "同じ瞬間に瞬きしました！"
    },
    "p121": {
      "source_hash": "d89b4553fa71",
      "text": "動作が終わり間ができた瞬間です。"
    },
    "p122": {
      "source_hash": "ecd6b4990666",
      "text": "ヴュルツブルク大の暗室実験でも、"
    },
    "p123": {
      "source_hash": "0a2015b61b32",
      "text": "音を聞いて判断する間、"
    },
    "p124": {
      "source_hash": "4c1335a38e91",
      "text": "被験者は瞬きを我慢し、"
    },
    "p125": {
      "source_hash": "35cede565685",
      "text": "判断後に瞬きしました！"
    },
    "p126": {
      "source_hash": "0f9d43be74b6",
      "text": "歩いたり頭を動かす時は？"
    },
    "p127": {
      "source_hash": "766566b36eee",
      "text": "テキサス大の分析では、"
    },
    "p128": {
      "source_hash": "0c2df7f7955b",
      "text": "振り向く直前に瞬きを控え、"
    },
    "p129": {
      "source_hash": "216c22d89642",
      "text": "一番速く動く瞬間に、"
    },
    "p130": {
      "source_hash": "90f42b81eda0",
      "text": "瞬きを隠していたのです！"
    },
    "p131": {
      "source_hash": "ab22bdca21c6",
      "text": "圧巻はF1ドライバーです。"
    },
    "p132": {
      "source_hash": "2532babfcc71",
      "text": "時速300kmの走行中、"
    },
    "p133": {
      "source_hash": "5c31428d78c9",
      "text": "瞬きする位置の8割以上が、"
    },
    "p134": {
      "source_hash": "3a49707dc1b3",
      "text": "直線コースに集中していました！"
    },
    "p135": {
      "source_hash": "d66696ad3a73",
      "text": "カーブや急ブレーキでは、"
    },
    "p136": {
      "source_hash": "8a86a49be60e",
      "text": "絶対に瞬きしません！"
    },
    "p137": {
      "source_hash": "58e18f61deed",
      "text": "命がけの場面で、"
    },
    "p138": {
      "source_hash": "5bff6b5c1b70",
      "text": "脳はミリ秒単位で制御しています。"
    },
    "p139": {
      "source_hash": "f6dba85207f7",
      "text": "よくわかりました！"
    },
    "p140": {
      "source_hash": "b17979efbfd2",
      "text": "目を動かす時は網膜が雑音を遮断し、"
    },
    "p141": {
      "source_hash": "4c1aa3b70f55",
      "text": "止まった像が揺れを上書きし、"
    },
    "p142": {
      "source_hash": "1d9b8be4b1e8",
      "text": "瞬きで神経を再起動します！"
    },
    "p143": {
      "source_hash": "e8d0fc5d87b6",
      "text": "脳は安全な瞬間を選んでいたのですね！"
    },
    "p144": {
      "source_hash": "0ee727f4b990",
      "text": "目と脳の何百万年の共同作業、"
    },
    "p145": {
      "source_hash": "a1906ddad3d1",
      "text": "まさに「そうだったのか」ですね！"
    },
    "p146": {
      "source_hash": "8396b87392ba",
      "text": "今度鏡の前で、"
    },
    "p147": {
      "source_hash": "b112d092af92",
      "text": "視線を左右に動かしてみてください。"
    },
    "p148": {
      "source_hash": "e601330badfe",
      "text": "わかった！"
    },
    "p149": {
      "source_hash": "7ee399b5d5c1",
      "text": "目を動かす時は網膜が遮断し、"
    },
    "p150": {
      "source_hash": "1b2f3d9a8abf",
      "text": "止まった像が揺れを上書きし、"
    },
    "p151": {
      "source_hash": "5789bf2b2101",
      "text": "瞬きで神経を再起動します！"
    },
    "p152": {
      "source_hash": "96e27b21d4e5",
      "text": "脳は安全な瞬間を狙っていたのですね！"
    },
    "p153": {
      "source_hash": "058b1acfd1b9",
      "text": "何百万年もの共同進化の結果、"
    },
    "p154": {
      "source_hash": "2d2194f748dc",
      "text": "まさに、そうだったのか！"
    },
    "p155": {
      "source_hash": "55edd55a3456",
      "text": "鏡の前で、"
    },
    "p156": {
      "source_hash": "c53fd58c1c5c",
      "text": "左右の目に視線を移してください。"
    },
    "p157": {
      "source_hash": "75c06ef42d0c",
      "text": "どんなに速く動かしても、"
    },
    "p158": {
      "source_hash": "66285daa72d4",
      "text": "動く自分の目は絶対に見えません！"
    },
    "p159": {
      "source_hash": "309c078515dc",
      "text": "これぞ体内の完璧な編集術です。"
    },
    "p160": {
      "source_hash": "7e04dc527092",
      "text": "疑問があれば、いつでもそうだったのか事務所へ！"
    }
  }
}