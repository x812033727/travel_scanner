    "8ns4": {
      "source_hash": "8135f6c4f950",
      "text": "Gemini는 웹 왼쪽 아래, 설정의 사용량 한도에서 봅니다."
    },
    "n257": {
      "source_hash": "5781d525902f",
      "text": "ChatGPT의 Codex는 사용량 대시보드를 봅니다."
    },
    "kp5n": {
      "source_hash": "1d9b97efbd75",
      "text": "결제 전 먼저 세 가지를 권합니다."
    },
    "hfgg": {
      "source_hash": "29f6ce79c6ca",
      "text": "첫째, 무료판을 2주 쓰며 막히는 곳을 봅니다."
    },
    "8n35": {
      "source_hash": "1102c91a2c4f",
      "text": "둘째, 한 달만 사 보고 오래 쓸 거면 연간 검토"
    },
    "hepu": {
      "source_hash": "2f19c2e3b928",
      "text": "셋째, 앱 내 결제와 웹 가격을 다 봅니다."
    },
    "h7wv": {
      "source_hash": "4f25880972fb",
      "text": "제 생각엔 첫째가 제일 중요합니다. 자기 벽이 먼저 보입니다."
    },
    "pqt2": {
      "source_hash": "074108fedf4e",
      "text": "어느 벽에 막히는지 정하고, 그 한 곳을 고릅니다."
    },
    "kkm9": {
      "source_hash": "d84346c1171b",
      "text": "가격은 바뀝니다. 로그인해서 보이는 것이 기준입니다. 다음 영상에서 뵙겠습니다."
    }
  }
}
