    "tags": "9d0c606699ab",
    "thumbnail": "a3b7d61299b4"
  },
  "lines": {
    "p001": {
      "source_hash": "77881511d3ae",
      "text": "所長、今カフェ！"
    },
    "p002": {
      "source_hash": "471658e9db6e",
      "text": "タブレットで無料ネット、ゲームにログイン！"
    },
    "p003": {
      "source_hash": "373de90ab3d3",
      "text": "ママがね、"
    },
    "p004": {
      "source_hash": "cddb71c91ec6",
      "text": "HTTPSでなきゃパスワードダメって"
    },
    "p005": {
      "source_hash": "f052778dc2b9",
      "text": "でもS一個でしょ？"
    },
    "p006": {
      "source_hash": "acc022b92588",
      "text": "Sひとつ、大差ない？"
    },
    "p007": {
      "source_hash": "7cca83e5d5e4",
      "text": "パスワードは結局送るんだもん！"
    },
    "p008": {
      "source_hash": "79b087605a5e",
      "text": "Sひとつで、道中のパスワードは思った以上に変わるの。"
    },
    "p009": {
      "source_hash": "e5a728d64c8b",
      "text": "でも、全然見ないこともある。"
    },
    "p010": {
      "source_hash": "2e380f9700cb",
      "text": "URL横の小さな鍵も、勘違いしてる人が多いの。"
    },
    "p011": {
      "source_hash": "7e6bafa8fc0a",
      "text": "じゃあ、何が違うの？"
    },
    "p012": {
      "source_hash": "c9b09ad251cf",
      "text": "通り道が違うの？"
    },
    "p013": {
      "source_hash": "e6bcb7926c6a",
      "text": "パスワードは、ゲーム会社へ直行でしょ？"
    },
    "p014": {
      "source_hash": "eb8e060fe97e",
      "text": "いいえ。まずカフェの無線の機械に行って、"
    },
    "p015": {
      "source_hash": "3a107da667f4",
      "text": "次にネット会社へ、ひと駅ずつ、"
    },
    "p016": {
      "source_hash": "4276ee5d9281",
      "text": "中継のコンピューターをたくさん通って、ゲーム会社へ。"
    },
    "p017": {
      "source_hash": "bcecc1a4b076",
      "text": "その機械、"
    },
    "p018": {
      "source_hash": "96a54b0f0935",
      "text": "中身が見えるの？"
    },
    "p019": {
      "source_hash": "d6c2c99f4af1",
      "text": "手紙回しで考えよう。"
    },
    "p020": {
      "source_hash": "90d221914ef0",
      "text": "教室の反対側の親友に、手紙を一通渡したいとするでしょ。"
    },
    "p021": {
      "source_hash": "ebad3769172e",
      "text": "途中で何人もの手を通るの。"
    },
    "p022": {
      "source_hash": "1c0ffac7138c",
      "text": "カフェの機械やネット会社が、そのクラスメートよ。"
    },
    "p023": {
      "source_hash": "664bc9b909d3",
      "text": "封をしてないと……"
    },
    "p024": {
      "source_hash": "df76c962fc08",
      "text": "Chromeブラウザの説明だと、私的接続のないサイトは、"
    },
    "p025": {
      "source_hash": "5e96c586be67",
      "text": "送ったものを見られたり、変えられるかも。"
    },
    "p026": {
      "source_hash": "2ca3f6efda0f",
      "text": "でもクラスの子、"
    },
    "p027": {
      "source_hash": "ccb637a9eb38",
      "text": "いい子だよ！"
    },
    "p028": {
      "source_hash": "602d9fa06022",
      "text": "ほとんどはね。でも、誰が渡すかは選べないの。"
    },
    "p029": {
      "source_hash": "9c40a1f7ef8a",
      "text": "だから、このSの裏のルールはTLSっていうの。"
    },
    "p030": {
      "source_hash": "fc89e7bacdd2",
      "text": "その仕様書いわく、途中の人がネットを完全に操れても、守りが成り立たなきゃだめ。"
    },
    "p031": {
      "source_hash": "1640142ce803",
      "text": "じゃあSは"
    },
    "p032": {
      "source_hash": "6e839b9923b3",
      "text": "なに？"
    },
    "p033": {
      "source_hash": "429b0140e7e5",
      "text": "Sは英語の「セキュア」。"
    },
    "p034": {
      "source_hash": "d83f8215dca9",
      "text": "HTTPSは、ウェブのやりとりをTLSで暗号化した版よ。"
    },
    "p035": {
      "source_hash": "7eb5223e7ddd",
      "text": "暗号化は、中身をあなたと相手にしか読めない形にすること。"
    },
    "p036": {
      "source_hash": "7d3f39f39414",
      "text": "封をすれば、"
    },
    "p037": {
      "source_hash": "ebb58a09260a",
      "text": "いいよね？"
    },
    "p038": {
      "source_hash": "67d33bed8e8c",
      "text": "封は、正しい相手に。"
    },
    "p039": {
      "source_hash": "b00c3d7b7f67",
      "text": "途中で誰かがゲーム会社のふりをして受け取ったら、"
    },
    "p040": {
      "source_hash": "22915cd739be",
      "text": "いくら封をしても、その人に渡るだけ。"
    },
    "p041": {
      "source_hash": "154f671a2090",
      "text": "それに出発前、案内所に「このURLどこ？」と聞くの。"
    },
    "p042": {
      "source_hash": "5e4726bc5efe",
      "text": "その答えも、途中の人にいじられるかもしれない。"
    },
    "p043": {
      "source_hash": "232778e9e290",
      "text": "どうすれば相手が"
    },
    "p044": {
      "source_hash": "a711d0fbfdda",
      "text": "本物のゲーム会社とわかる？"
    },
    "p045": {
      "source_hash": "525fc70e2253",
      "text": "サイトは証明書という身分証を出すの。"
    },
    "p046": {
      "source_hash": "f9bc188f8259",
      "text": "そこにはサイトの名前と、専用のはんこの図柄が印刷されてる。"
    },
    "p047": {
      "source_hash": "1df2bb822378",
      "text": "そのはんこは、サイトだけが持つの。"
    },
    "p048": {
      "source_hash": "f5b8f537fc9e",
      "text": "ブラウザはまず、証明書の名前がURL欄と同じかを見るの。"
    },
    "p049": {
      "source_hash": "4420af03cc3c",
      "text": "誰が出したの？"
    },
    "p050": {
      "source_hash": "78eab39ed2c3",
      "text": "自作すればいいよ！"
    },
    "p051": {
      "source_hash": "c0a5d81d8ce9",
      "text": "自作はブラウザが拒む。専門の発行機関へ。"
    },
    "p052": {
      "source_hash": "2368e2dfb000",
      "text": "無料の発行機関は公式サイトで確認法を説明："
    },
    "p053": {
      "source_hash": "9553e2039a47",
      "text": "たとえば、自分のサイトの決まった場所に、指定のファイルを置いてもらって、"
    },
    "p054": {
      "source_hash": "994408e4d3f4",
      "text": "別々の場所から、同時に見に来る。"
    },
    "p055": {
      "source_hash": "2a49ab220018",
      "text": "自分の机の引き出しに、指定のカードを入れる感じ。"
    },
    "p056": {
      "source_hash": "1fd819e3095a",
      "text": "それって、"
    },
    "p057": {
      "source_hash": "502d9b441fb9",
      "text": "サイトがいい人か調べるの？"
    },
    "p058": {
      "source_hash": "d56c4cda65bd",
      "text": "いいえ。見るのは、そのURLを管理できるかどうか。"
    },
    "p059": {
      "source_hash": "ef6db27e8d03",
      "text": "運営者の人柄や、中身が信用できるかじゃない。"
    },
    "p060": {
      "source_hash": "e7fb4be76387",
      "text": "あっ！友だちからリンクが来て、"
    },
    "p061": {
      "source_hash": "642f50b229cf",
      "text": "開くと無料で宝石がもらえるって！"
    },
    "p062": {
      "source_hash": "0dd33a4574e8",
      "text": "これもHTTPSだよ！"
    },
    "p063": {
      "source_hash": "47e1935228e1",
      "text": "要注意。Chromeチームいわく、"
    },
    "p064": {
      "source_hash": "7ce1ab9b0d1a",
      "text": "フィッシングサイトのほぼ全部がHTTPSよ。"
    },
    "p065": {
      "source_hash": "c3b79bd26f76",
      "text": "人のふりをして、パスワードを打たせる偽サイトよ。"
    },
    "p066": {
      "source_hash": "792801bcb5ae",
      "text": "似た名前の偽サイトでも、詐欺師は証明書をもらえるの。"
    },
    "p067": {
      "source_hash": "73f4c583a1aa",
      "text": "ブラウザは昔からURL横に鍵を描き、暗号化された接続を示してきた。"
    },
    "p068": {
      "source_hash": "b427dc9f7469",
      "text": "見たのは、"
    },
    "p069": {
      "source_hash": "01acd63f2e13",
      "text": "この鍵だよ！"
    },
    "p070": {
      "source_hash": "aff070985817",
      "text": "チームの研究では、"
    },
    "p071": {
      "source_hash": "0f080ad3d0b4",
      "text": "参加者の11パーセントしか、鍵を理解してなかった。"
    },
    "p072": {
      "source_hash": "5366fe180b45",
      "text": "2023年、鍵を別のアイコンに替えると発表。"
    },
    "p073": {
      "source_hash": "6a6bb3f747d1",
      "text": "鍵ありなら良いサイト、と思わないよう。"
    },
    "p074": {
      "source_hash": "b2e5860d3bbf",
      "text": "じゃあブラウザはなんで"
    },
    "p075": {
      "source_hash": "a86219184cc6",
      "text": "発行機関を信じるの？"
    },
    "p076": {
      "source_hash": "6f6db301b224",
      "text": "機関にも証明書があり、もう一段上のはんこが押してあるの。"
    },
    "p077": {
      "source_hash": "5e6dbdb537c8",
      "text": "一段ずつ上へつながって、いちばん上のものをルート証明書っていうの。"
    },
    "p078": {
      "source_hash": "1d7448dc983d",
      "text": "ブラウザやスマホには、ルート証明書が最初から入ってる。"
    },
    "p079": {
      "source_hash": "c3a722444709",
      "text": "校長先生を知ってれば、そのはんこで安心でしょ。"
    },
    "p080": {
      "source_hash": "47ef0092ccba",
      "text": "もし機関がうっかり、"
    },
    "p081": {
      "source_hash": "7d1a24356308",
      "text": "間違えて証明書を出したら？"
    },
    "p082": {
      "source_hash": "7f375891702a",
      "text": "今はChromeやSafariのブラウザが、"
    },
    "p083": {
      "source_hash": "c984a15b46a8",
      "text": "公開台帳への登録を求めるの。"
    },
    "p084": {
      "source_hash": "1e11b18eb865",
      "text": "台帳は足すだけで消せず、誰でも見られる。"
    },
    "p085": {
      "source_hash": "420d60731ff7",
      "text": "持ち主は通知も頼める。自分の名前の証明書が取られて、"
    },
    "p086": {
      "source_hash": "ebd851f9de48",
      "text": "台帳に載ったら、通知が届くの。"
    },
    "p087": {
      "source_hash": "18f43fe30eb0",
      "text": "合格しないと、"
    },
    "p088": {
      "source_hash": "4f01b2a87e0b",
      "text": "どうなる？"
    },
    "p089": {
      "source_hash": "1db0e6f1cb49",
      "text": "Chromeなら全画面で、「この接続ではプライバシーが保護されません」"
    },
    "p090": {
      "source_hash": "58c933233ff6",
      "text": "ヘルプには、原因はサイト、ネットワーク、または端末にあるかもとあるわ。"
    },
    "p091": {
      "source_hash": "f59e64bfe86d",
      "text": "よし、相手はOK。"
    },
    "p092": {
      "source_hash": "0f9ff212438e",
      "text": "どう封をすれば"
    },
    "p093": {
      "source_hash": "505405816696",
      "text": "友だちに開けられない？"
    },
    "p094": {
      "source_hash": "ff5cbf054b72",
      "text": "書く前に、二人だけが知ってるひみつを用意するの。"
    },
    "p095": {
      "source_hash": "25fef5981cc5",
      "text": "でも送ったものは、"
    },
    "p096": {
      "source_hash": "ace89faccd81",
      "text": "みんなに見えるよ！"
    },
    "p097": {
      "source_hash": "78f4082af2c6",
      "text": "絵の具を混ぜて考えよう。まず、みんなが知ってる色を決めて、"
    },
    "p098": {
      "source_hash": "649c4cc514c4",
      "text": "二人がそれぞれこっそり、自分だけが知ってる色を足す。"
    },
    "p099": {
      "source_hash": "5f96cc89be8b",
      "text": "混ぜたのを相手に送って、受け取った人は自分の色を足す。"
    },
    "p100": {
      "source_hash": "ac7e588dc99a",
      "text": "最後は二人とも同じ色になる。"
    },
    "p101": {
      "source_hash": "76904a9733bf",
      "text": "回す子は混ぜかけしか見てないので、作れない。"
    },
    "p102": {
      "source_hash": "25ba75df94a4",
      "text": "これはたとえで、本当は数学よ。でも仕様にははっきり書いてある。"
    },
    "p103": {
      "source_hash": "ac4de42f936e",
      "text": "最初にこれを交換し、あとのやりとりは全部封をする。"
    },
    "p104": {
      "source_hash": "1a9b7afbb8fa",
      "text": "さっきの証明書も、封をしてから送るの。"
    },
    "p105": {
      "source_hash": "37680602f5d8",
      "text": "もし誰かが全部録っておいて、"
    },
    "p106": {
      "source_hash": "9b2a79211caa",
      "text": "あとで解いたら？"
    },
    "p107": {
      "source_hash": "94031c345e76",
      "text": "今回の色は使い捨て。"
    },
    "p108": {
      "source_hash": "04a08154d826",
      "text": "仕様では、あとでサイトのはんこが盗まれても、"
    },
    "p109": {
      "source_hash": "a1838529621c",
      "text": "今回のひみつを捨ててあれば、昔の録音は解けない。"
    },
    "p110": {
      "source_hash": "44f7a967312b",
      "text": "でも証明書、"
    },
    "p111": {
      "source_hash": "df9694d39614",
      "text": "コピーできる？"
    },
    "p112": {
      "source_hash": "99a025f33a0c",
      "text": "できるわ。だから証明書だけでは足りず、その場ではんこも押すの。"
    },
    "p113": {
      "source_hash": "b5fb0c1f8f23",
      "text": "写した人は、はんこがない。"
    },
    "p114": {
      "source_hash": "3aee4a66c7fd",
      "text": "もし手紙を回す子が、"
    },
    "p115": {
      "source_hash": "30d8725a2267",
      "text": "色をすり替えたら？"
    },
    "p116": {
      "source_hash": "8c4c0a2dc71a",
      "text": "サイトのはんこは、色を含むやりとり全体に押すの。"
    },
    "p117": {
      "source_hash": "1da8d9b9c8d0",
      "text": "ブラウザは証明書の図柄で照合する。"
    },
    "p118": {
      "source_hash": "f07c6109a3cb",
      "text": "色がすり替わってたら、はんこが合わずに即切断。"
    },
    "p119": {
      "source_hash": "b919fd4e2053",
      "text": "最後に二人で答え合わせ。やりとり全体が、"
    },
    "p120": {
      "source_hash": "d822de3fff3b",
      "text": "わたしが見たのとあなたが見たのは同じ？合ったら、本物の手紙を送り始めるの。"
    },
    "p121": {
      "source_hash": "28716be7344d",
      "text": "その後の手紙は全部、二人だけが知ってる色で封をする。"
    },
    "p122": {
      "source_hash": "6d4bc44dce94",
      "text": "途中で少しでも変えられたら開けられない。仕様では、その場で切断。"
    },
    "p123": {
      "source_hash": "902a797bebcf",
      "text": "封筒には手紙の長さも書いてある。"
    },
    "p124": {
      "source_hash": "9467029bdf8e",
      "text": "この数文字も封に含まれるから、見えても変えられない。"
    },
    "p125": {
      "source_hash": "302a9c019594",
      "text": "もし誰かが私の"
    },
    "p126": {
      "source_hash": "b90e45595ae9",
      "text": "宝石注文を"
    },
    "p127": {
      "source_hash": "723fa530afa8",
      "text": "コピーして再送？"
    },
    "p128": {
      "source_hash": "fc341badc049",
      "text": "手紙には番号があって、両方ゼロから数え、一通で一つ増える。"
    },
    "p129": {
      "source_hash": "89685960cbe8",
      "text": "番号は外に書かず、封に混ぜてあるの。"
    },
    "p130": {
      "source_hash": "d55c279876db",
      "text": "古い手紙をもう一度送ったり、順番を入れ替えたりすると、"
    },
    "p131": {
      "source_hash": "6d4110cea98b",
      "text": "番号ずれで開かない。"
    },
    "p132": {
      "source_hash": "5b00d89fc08d",
      "text": "だからどの手紙も、"
    },
    "p133": {
      "source_hash": "4ac9d1178a60",
      "text": "再送できない！"
    },
    "p134": {
      "source_hash": "968f430aa1c1",
      "text": "例外が一つあって、仕様は「重要な注意」として目立たせてるの。"
    },
    "p135": {
      "source_hash": "7602cd85eca2",
      "text": "どんな例外？"
    },
    "p136": {
      "source_hash": "553543ca8b09",
      "text": "前にそのサイトにつないだことがあれば、ブラウザは前回のひみつを使って、"
    },
    "p137": {
      "source_hash": "ba453ee7c1fc",
      "text": "最初の手紙を先送りして、一往復省ける。"
    },
    "p138": {
      "source_hash": "9e1444b6c979",
      "text": "仕様いわく、この先送りの手紙は、再送されない保証はない。"
    },
    "p139": {
      "source_hash": "0f37b328983b",
      "text": "誰かが写して送り直すと、買い物などが二回起きるかもしれない。"
    },
    "p140": {
      "source_hash": "57ecfbe36697",
      "text": "それって穴じゃん！"
    },
    "p141": {
      "source_hash": "ea817db2ca96",
      "text": "そう。仕様は、サイトが自分で防ぐ方法もいくつか書いてる。"
    },
    "p142": {
      "source_hash": "1fec170346fd",
      "text": "それに最後の手紙で「これで終わり」と伝えるの。"
    },
    "p143": {
      "source_hash": "9394e984b262",
      "text": "途中で切られたら、相手が気づけるように。"
    },
    "p144": {
      "source_hash": "d7bd6d4d2756",
      "text": "封も番号もそろったら、"
    },
    "p145": {
      "source_hash": "d63276da9fb9",
      "text": "途中の人は、"
    },
    "p146": {
      "source_hash": "6331fdc77b32",
      "text": "何も見えないよね？"
    },
    "p147": {
      "source_hash": "04c977acf9f4",
      "text": "まだ少し見えるの。封筒の外の長さ、覚えてる？"
    },
    "p148": {
      "source_hash": "b8490afffed4",
      "text": "手紙の厚さや送る間隔は、途中の人にも見える。"
    },
    "p149": {
      "source_hash": "d4af98736f5f",
      "text": "厚さで、"
    },
    "p150": {
      "source_hash": "1b8095ed3cb1",
      "text": "何がわかるの？"
    },
    "p151": {
      "source_hash": "ab5abfc5e171",
      "text": "仕様の注意では、長さと時間で何をしてるか推測できることも。"
    },
    "p152": {
      "source_hash": "8526817723d4",
      "text": "特に選択肢が少ないとき。決まった動画しか置いてないサイトとかね。"
    },
    "p153": {
      "source_hash": "82683984a2e9",
      "text": "サイトは手紙に空白を詰めて、同じ厚さにできる。"
    },
    "p154": {
      "source_hash": "7f707aa2cc48",
      "text": "でも詰める量は、仕様で決まってない。"
    },
    "p155": {
      "source_hash": "ab23b3a03ce4",
      "text": "じゃあ途中の人は、"
    },
    "p156": {
      "source_hash": "223eb2eefe69",
      "text": "相手のサイトもわかるの？"
    },
    "p157": {
      "source_hash": "49e13a5d08de",
      "text": "たぶんね。接続の最初に、ブラウザがどのサイトに行きたいかを言うの。"
    },
    "p158": {
      "source_hash": "e2e05accb87c",
      "text": "その名前は、ふだんは封をされてない。"
    },
    "p159": {
      "source_hash": "e126ecac4372",
      "text": "封筒の外の宛名みたいに。"
    },
    "p160": {
      "source_hash": "41393d46b22b",
      "text": "それも封できないの？"
    },
    "p161": {
      "source_hash": "2b1f5709f5b3",
      "text": "2026年3月、まさにそれをする新しい仕様が正式に発表されたの。"
    },
    "p162": {
      "source_hash": "3bf054473b66",
      "text": "宛名も、内側の封筒に入れちゃうの。"
    },
    "p163": {
      "source_hash": "b04f1a6b3261",
      "text": "でも仕様は、それだけじゃ足りないって。"
    },
    "p164": {
      "source_hash": "8faf7b3c8147",
      "text": "最後にどのサイトの機械に届くかは、やっぱり途中から見える。"
    },
    "p165": {
      "source_hash": "7a1cffad8f55",
      "text": "多くのサイトはよく一台を共用するから、"
    },
    "p166": {
      "source_hash": "f23ed3bd09fa",
      "text": "封筒の名前が、いちばんはっきりした手がかりなの。"
    },
    "p167": {
      "source_hash": "5e678cbab737",
      "text": "出発前の「このURLどこ？」って質問、覚えてる？"
    },
    "p168": {
      "source_hash": "ab96c661fd88",
      "text": "あれも封をしてないと、名前がばれるの。"
    },
    "p169": {
      "source_hash": "91590cf4e717",
      "text": "じゃあさっきの"
    },
    "p170": {
      "source_hash": "6207e140d4ee",
      "text": "宝石のリンクは……"
    },
    "p171": {
      "source_hash": "a3419c95b4a9",
      "text": "これがいちばん大事。封は通り道しか守らない。"
    },
    "p172": {
      "source_hash": "d2a2e0600df0",
      "text": "手紙が相手に届いたら、相手は全部読めるの。"
    },
    "p173": {
      "source_hash": "ee61cf48823e",
      "text": "相手が詐欺師なら、HTTPSはパスワードを詐欺師へ届けちゃう。"
    },
    "p174": {
      "source_hash": "635e3b5108cd",
      "text": "じゃあどう見分けるの？"
    },
    "p175": {
      "source_hash": "823a5d7f35b2",
      "text": "Chromeのヘルプも注意してる。安全な接続でも、"
    },
    "p176": {
      "source_hash": "a5a00a69cb84",
      "text": "URL欄の名前が、行きたいサイトかどうかよく見てって。"
    },
    "p177": {
      "source_hash": "53edf7549339",
      "text": "見つけた！"
    },
    "p178": {
      "source_hash": "b8c39e07a2b3",
      "text": "名前に一文字多い！"
    },
    "p179": {
      "source_hash": "9d0e52451533",
      "text": "そう。封では守れないから、自分の目で見るの。"
    },
    "p180": {
      "source_hash": "c997e773f825",
      "text": "Sひとつで、道中のパスワードは何が変わった？"
    },
    "p181": {
      "source_hash": "36d742bcb996",
      "text": "なるほど！"
    },
    "p182": {
      "source_hash": "b4a835294305",
      "text": "封をした手紙みたいに、"
    },
    "p183": {
      "source_hash": "9143b223f739",
      "text": "クラスの子は回せても、読めない。"
    },
    "p184": {
      "source_hash": "616bf2174fb3",
      "text": "そのサイト名にもなりすませない！"
    },
    "p185": {
      "source_hash": "495a669350df",
      "text": "いいわね。一番すごいのは、この封を毎日使ってるのに、"
    },
    "p186": {
      "source_hash": "c0ee9b730ede",
      "text": "ちゃんと見たことないこと。"
    },
    "p187": {
      "source_hash": "b4f348522f85",
      "text": "ママに言う、"
    },
    "p188": {
      "source_hash": "b8a9ebbacfcd",
      "text": "あのリンクは偽物だって！"
    },
    "p189": {
      "source_hash": "23c35e85a11e",
      "text": "次は打つ前に、まず名前を見る！"
    },
    "p190": {
      "source_hash": "7e4f77703946",
      "text": "そっくりな名前の偽URL、届いたことある？"
    },
    "p191": {
      "source_hash": "fe508e80b52e",
      "text": "コメントしてね"
    },
    "p192": {
      "source_hash": "88de677d4daa",
      "text": "暮らしの「なぜ」を一緒に探すなら、なるほど事務所をチャンネル登録！"
    }
  }
}
