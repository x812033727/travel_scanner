    "thumbnail": "a3b7d61299b4"
  },
  "lines": {
    "p001": {
      "source_hash": "b304ba284343",
      "text": "엄마가 HTTPS 주소여야"
    },
    "p002": {
      "source_hash": "d72c9929b592",
      "text": "비번 쳐도 된대요"
    },
    "p003": {
      "source_hash": "f052778dc2b9",
      "text": "S 하나 더일 뿐이잖아요?"
    },
    "p004": {
      "source_hash": "acc022b92588",
      "text": "S 하나, 별거 없어?"
    },
    "p005": {
      "source_hash": "7cca83e5d5e4",
      "text": "비번은 어차피 보내잖아요!"
    },
    "p006": {
      "source_hash": "79b087605a5e",
      "text": "S 하나로 길 위의 비번은 생각보다 달라져."
    },
    "p007": {
      "source_hash": "e5a728d64c8b",
      "text": "근데 상관 안 하는 일도 있어."
    },
    "p008": {
      "source_hash": "2e380f9700cb",
      "text": "주소 옆 자물쇠도 많이들 잘못 알아."
    },
    "p009": {
      "source_hash": "7e6bafa8fc0a",
      "text": "뭐가 달라요?"
    },
    "p010": {
      "source_hash": "e6bcb7926c6a",
      "text": "비번이 게임 회사로 바로 가죠?"
    },
    "p011": {
      "source_hash": "eb8e060fe97e",
      "text": "아니. 먼저 카페 와이파이 기계로,"
    },
    "p012": {
      "source_hash": "3a107da667f4",
      "text": "통신사로, 한 곳씩 거쳐서"
    },
    "p013": {
      "source_hash": "4276ee5d9281",
      "text": "중계 컴퓨터 여러 대를 지나 게임 회사로 가."
    },
    "p014": {
      "source_hash": "bcecc1a4b076",
      "text": "그 기계들,"
    },
    "p015": {
      "source_hash": "96a54b0f0935",
      "text": "제 거 보여요?"
    },
    "p016": {
      "source_hash": "d6c2c99f4af1",
      "text": "수업 쪽지로 보자."
    },
    "p017": {
      "source_hash": "90d221914ef0",
      "text": "교실 저쪽 끝 친구한테 편지를 보내는 거야."
    },
    "p018": {
      "source_hash": "ebad3769172e",
      "text": "중간에 여러 친구 손을 거쳐."
    },
    "p019": {
      "source_hash": "1c0ffac7138c",
      "text": "카페 기계, 통신사가 그 친구들이야."
    },
    "p020": {
      "source_hash": "664bc9b909d3",
      "text": "안 봉하면……"
    },
    "p021": {
      "source_hash": "df76c962fc08",
      "text": "Chrome 브라우저 도움말: 비공개 연결이 아니면"
    },
    "p022": {
      "source_hash": "5e96c586be67",
      "text": "남이 보거나 바꿀 수도 있대."
    },
    "p023": {
      "source_hash": "96ad7826a4a8",
      "text": "친구들 다 착해요!"
    },
    "p024": {
      "source_hash": "602d9fa06022",
      "text": "대부분은. 근데 누가 전할지 못 골라."
    },
    "p025": {
      "source_hash": "9c40a1f7ef8a",
      "text": "그래서 이 S 뒤의 규칙, TLS는"
    },
    "p026": {
      "source_hash": "fc89e7bacdd2",
      "text": "규격에 써 있어: 길 위 사람이 망을 완전히 쥐어도 보호돼야 한다고."
    },
    "p027": {
      "source_hash": "1640142ce803",
      "text": "그 S는"
    },
    "p028": {
      "source_hash": "6e839b9923b3",
      "text": "무슨 뜻이에요?"
    },
    "p029": {
      "source_hash": "429b0140e7e5",
      "text": "S는 영어로 '안전'."
    },
    "p030": {
      "source_hash": "d83f8215dca9",
      "text": "HTTPS는 웹 주고받기를 TLS로 암호화한 버전."
    },
    "p031": {
      "source_hash": "7eb5223e7ddd",
      "text": "암호화는 나랑 상대만 알아보게 바꾸는 거죠."
    },
    "p032": {
      "source_hash": "7d3f39f39414",
      "text": "그럼 봉하면"
    },
    "p033": {
      "source_hash": "ebb58a09260a",
      "text": "되죠?"
    },
    "p034": {
      "source_hash": "67d33bed8e8c",
      "text": "맞는 사람한테 봉해야지."
    },
    "p035": {
      "source_hash": "b00c3d7b7f67",
      "text": "중간에 누가 게임 회사인 척 받으면,"
    },
    "p036": {
      "source_hash": "22915cd739be",
      "text": "잘 봉해도 그 사람한테 가."
    },
    "p037": {
      "source_hash": "154f671a2090",
      "text": "또 출발 전 태블릿이 안내소에 '주소 어디?' 묻는데,"
    },
    "p038": {
      "source_hash": "5e4726bc5efe",
      "text": "그 답도 길에서 조작될 수 있어."
    },
    "p039": {
      "source_hash": "232778e9e290",
      "text": "그럼 어떻게 알아요,"
    },
    "p040": {
      "source_hash": "a711d0fbfdda",
      "text": "진짜 게임 회사인지?"
    },
    "p041": {
      "source_hash": "525fc70e2253",
      "text": "사이트가 증명서, 인증서를 내밀어."
    },
    "p042": {
      "source_hash": "f9bc188f8259",
      "text": "사이트 이름과 전용 도장의 무늬가 찍혀 있지."
    },
    "p043": {
      "source_hash": "1df2bb822378",
      "text": "그 도장은 그 사이트만 가져."
    },
    "p044": {
      "source_hash": "f5b8f537fc9e",
      "text": "브라우저는 먼저 봐: 이름이 주소창과 같나?"
    },
    "p045": {
      "source_hash": "4420af03cc3c",
      "text": "누가 발급했죠?"
    },
    "p046": {
      "source_hash": "78eab39ed2c3",
      "text": "직접 만들면 되죠!"
    },
    "p047": {
      "source_hash": "c0a5d81d8ce9",
      "text": "직접 만든 건 안 받아. 발급 기관이 있어야 해."
    },
    "p048": {
      "source_hash": "2368e2dfb000",
      "text": "한 무료 기관은 확인법을 공식 사이트에 적었어:"
    },
    "p049": {
      "source_hash": "9553e2039a47",
      "text": "예를 들어 네 사이트 정해진 자리에 지정 파일을 두게 하고,"
    },
    "p050": {
      "source_hash": "994408e4d3f4",
      "text": "여러 곳에서 동시에 접속해 봐."
    },
    "p051": {
      "source_hash": "2a49ab220018",
      "text": "네 서랍에 지정한 카드를 넣으라는 거지."
    },
    "p052": {
      "source_hash": "1fd819e3095a",
      "text": "그럼 사이트가"
    },
    "p053": {
      "source_hash": "502d9b441fb9",
      "text": "착한지도 봐요?"
    },
    "p054": {
      "source_hash": "d56c4cda65bd",
      "text": "아니. 네가 그 주소를 관리하는지만 봐."
    },
    "p055": {
      "source_hash": "ef6db27e8d03",
      "text": "사람이 착한지, 내용을 믿을지가 아니라."
    },
    "p056": {
      "source_hash": "e028d4cf1b4a",
      "text": "아까 친구가 링크를 보냈는데,"
    },
    "p057": {
      "source_hash": "642f50b229cf",
      "text": "보석 공짜로 준대요!"
    },
    "p058": {
      "source_hash": "0dd33a4574e8",
      "text": "이것도 HTTPS예요!"
    },
    "p059": {
      "source_hash": "47e1935228e1",
      "text": "조심해. Chrome 팀이 썼어:"
    },
    "p060": {
      "source_hash": "7ce1ab9b0d1a",
      "text": "피싱 사이트 거의 다 HTTPS를 써."
    },
    "p061": {
      "source_hash": "c3b79bd26f76",
      "text": "피싱은 남인 척 비번을 받아 내는 사이트야."
    },
    "p062": {
      "source_hash": "792801bcb5ae",
      "text": "사기꾼도 비슷한 이름의 가짜로 증명서를 받아."
    },
    "p063": {
      "source_hash": "73f4c583a1aa",
      "text": "브라우저는 일찍부터 주소 옆 자물쇠로 연결 암호화를 표시했어."
    },
    "p064": {
      "source_hash": "aff070985817",
      "text": "그 팀 연구에선,"
    },
    "p065": {
      "source_hash": "0f080ad3d0b4",
      "text": "뜻을 진짜 아는 참가자가 11퍼센트뿐이었어."
    },
    "p066": {
      "source_hash": "5366fe180b45",
      "text": "2023년, 자물쇠를 바꾼다고 발표했어,"
    },
    "p067": {
      "source_hash": "6a6bb3f747d1",
      "text": "자물쇠만 보고 믿을까 봐."
    },
    "p068": {
      "source_hash": "b2e5860d3bbf",
      "text": "브라우저는 왜"
    },
    "p069": {
      "source_hash": "a86219184cc6",
      "text": "기관 믿죠?"
    },
    "p070": {
      "source_hash": "6f6db301b224",
      "text": "기관도 증명서가 있고, 윗단계 도장이 찍혔거든."
    },
    "p071": {
      "source_hash": "5e6dbdb537c8",
      "text": "한 단계씩 위로 이어지고, 맨 위 것이 루트 인증서야."
    },
    "p072": {
      "source_hash": "1d7448dc983d",
      "text": "브라우저나 휴대폰 시스템엔 루트 인증서가 내장돼 있어."
    },
    "p073": {
      "source_hash": "c3a722444709",
      "text": "교장 선생님을 알아서, 그 도장에 안심하듯."
    },
    "p074": {
      "source_hash": "33b3c33c4515",
      "text": "기관이 증명서를 잘못 주면요?"
    },
    "p075": {
      "source_hash": "7f375891702a",
      "text": "지금 Chrome, Safari 등 브라우저는"
    },
    "p076": {
      "source_hash": "c984a15b46a8",
      "text": "공개 장부에 등록하래."
    },
    "p077": {
      "source_hash": "1e11b18eb865",
      "text": "추가만 되고 삭제는 안 되고, 누구나 봐."
    },
    "p078": {
      "source_hash": "420d60731ff7",
      "text": "주인은 알림도 신청해: 누가 내 이름으로 받은 인증서가"
    },
    "p079": {
      "source_hash": "ebd851f9de48",
      "text": "장부에 오르면 알림이 와."
    },
    "p080": {
      "source_hash": "18f43fe30eb0",
      "text": "검사에 떨어지면"
    },
    "p081": {
      "source_hash": "4f01b2a87e0b",
      "text": "어떻게 돼요?"
    },
    "p082": {
      "source_hash": "1db0e6f1cb49",
      "text": "Chrome은 화면 가득 경고해: 비공개 연결이 아니라고."
    },
    "p083": {
      "source_hash": "58c933233ff6",
      "text": "도움말엔, 문제는 사이트, 네트워크, 기기일 수 있대."
    },
    "p084": {
      "source_hash": "0f9ff212438e",
      "text": "어떻게 봉해야"
    },
    "p085": {
      "source_hash": "505405816696",
      "text": "친구가 못 뜯죠?"
    },
    "p086": {
      "source_hash": "ff5cbf054b72",
      "text": "쓰기 전에 둘만 아는 비밀부터 있어야 해."
    },
    "p087": {
      "source_hash": "25fef5981cc5",
      "text": "근데 보내는 건"
    },
    "p088": {
      "source_hash": "ace89faccd81",
      "text": "다 보이잖아요!"
    },
    "p089": {
      "source_hash": "78f4082af2c6",
      "text": "물감으로 보자. 먼저 다 아는 색 하나를 정하고,"
    },
    "p090": {
      "source_hash": "649c4cc514c4",
      "text": "둘이 각자 몰래, 자기만 아는 색을 하나씩 넣어."
    },
    "p091": {
      "source_hash": "5f96cc89be8b",
      "text": "섞은 걸 보내면, 받은 쪽이 자기 색을 더 넣어."
    },
    "p092": {
      "source_hash": "ac7e588dc99a",
      "text": "결국 둘은 같은 색이 되고,"
    },
    "p093": {
      "source_hash": "76904a9733bf",
      "text": "거친 친구들은 중간 것만 봐서 못 만들어."
    },
    "p094": {
      "source_hash": "25ba75df94a4",
      "text": "비유일 뿐, 실제론 수학. 규격은 분명해:"
    },
    "p095": {
      "source_hash": "ac4de42f936e",
      "text": "첫 단계가 이 교환이고, 그 뒤는 전부 봉해서,"
    },
    "p096": {
      "source_hash": "1a9b7afbb8fa",
      "text": "아까 증명서도 봉해서 보내."
    },
    "p097": {
      "source_hash": "658689d4983b",
      "text": "만약 먼저 저장해 뒀다가"
    },
    "p098": {
      "source_hash": "fd4ae9dfedb6",
      "text": "나중에 풀면요?"
    },
    "p099": {
      "source_hash": "94031c345e76",
      "text": "이번 색은 일회용이야."
    },
    "p100": {
      "source_hash": "04a08154d826",
      "text": "규격엔, 나중에 도장을 도둑맞아도"
    },
    "p101": {
      "source_hash": "a1838529621c",
      "text": "이번 비밀을 버렸다면 옛 녹음도 못 푼대."
    },
    "p102": {
      "source_hash": "44f7a967312b",
      "text": "증명서는"
    },
    "p103": {
      "source_hash": "df9694d39614",
      "text": "복사되죠?"
    },
    "p104": {
      "source_hash": "99a025f33a0c",
      "text": "응. 그래서 증명서만으론 안 되고, 그 자리에서 도장을 찍어."
    },
    "p105": {
      "source_hash": "b5fb0c1f8f23",
      "text": "복사한 쪽은 도장이 없어."
    },
    "p106": {
      "source_hash": "f8252c903290",
      "text": "짝이 몰래"
    },
    "p107": {
      "source_hash": "b83738f32e9b",
      "text": "색 바꾸면?"
    },
    "p108": {
      "source_hash": "8c4c0a2dc71a",
      "text": "도장은 오간 내용 전체에 찍어, 색까지."
    },
    "p109": {
      "source_hash": "1da8d9b9c8d0",
      "text": "브라우저는 증명서 무늬와 대 봐."
    },
    "p110": {
      "source_hash": "f07c6109a3cb",
      "text": "색이 바뀌면 도장이 안 맞아 바로 끊어."
    },
    "p111": {
      "source_hash": "b919fd4e2053",
      "text": "끝으로 둘이 한 번 더 맞춰 봐: 오간 전체가"
    },
    "p112": {
      "source_hash": "d822de3fff3b",
      "text": "내가 본 거랑 네가 본 게 같아? 맞으면 그때 진짜 편지를 보내."
    },
    "p113": {
      "source_hash": "28716be7344d",
      "text": "이제 편지마다 너희만 아는 그 색으로 봉해."
    },
    "p114": {
      "source_hash": "6d4bc44dce94",
      "text": "조금만 고쳐도 안 열려. 규격상 이때 바로 끊어."
    },
    "p115": {
      "source_hash": "902a797bebcf",
      "text": "봉투 겉엔 길이도 적혀."
    },
    "p116": {
      "source_hash": "9467029bdf8e",
      "text": "이 글자도 봉인에 들어가, 보여도 못 고쳐."
    },
    "p117": {
      "source_hash": "302a9c019594",
      "text": "누가 제 편지"
    },
    "p118": {
      "source_hash": "b90e45595ae9",
      "text": "'보석 살래'"
    },
    "p119": {
      "source_hash": "723fa530afa8",
      "text": "베껴 또 보내면요?"
    },
    "p120": {
      "source_hash": "fc341badc049",
      "text": "편지마다 번호가 있어. 각자 0부터, 한 통에 1씩."
    },
    "p121": {
      "source_hash": "89685960cbe8",
      "text": "번호는 겉이 아니라 봉인 속에."
    },
    "p122": {
      "source_hash": "d55c279876db",
      "text": "옛 편지를 다시 보내거나 순서가 바뀌면,"
    },
    "p123": {
      "source_hash": "6d4110cea98b",
      "text": "번호 안 맞아 안 열려."
    },
    "p124": {
      "source_hash": "968f430aa1c1",
      "text": "예외가 하나 있어. 규격이 직접 '중요 알림'으로 표시했지."
    },
    "p125": {
      "source_hash": "7602cd85eca2",
      "text": "무슨 예외요?"
    },
    "p126": {
      "source_hash": "553543ca8b09",
      "text": "전에 접속한 사이트면, 브라우저가 지난번 비밀로"
    },
    "p127": {
      "source_hash": "ba453ee7c1fc",
      "text": "첫 편지를 미리 보내 왕복 한 번 절약."
    },
    "p128": {
      "source_hash": "9e1444b6c979",
      "text": "규격엔, 이 편지는 재전송 방지를 보장 못 한대."
    },
    "p129": {
      "source_hash": "0f37b328983b",
      "text": "베껴 또 보내면 구매 같은 게 두 번 될 수도."
    },
    "p130": {
      "source_hash": "8fad91e73d83",
      "text": "그래서 규격엔 사이트가 막는 법도 있어."
    },
    "p131": {
      "source_hash": "1fec170346fd",
      "text": "그리고 끝엔 마지막 편지가 '다 말했어'라고 해."
    },
    "p132": {
      "source_hash": "9394e984b262",
      "text": "중간에 잘려도 상대가 알게."
    },
    "p133": {
      "source_hash": "d63276da9fb9",
      "text": "길에선"
    },
    "p134": {
      "source_hash": "6331fdc77b32",
      "text": "아무것도 못 보죠?"
    },
    "p135": {
      "source_hash": "04c977acf9f4",
      "text": "조금은 보여. 봉투 겉 길이 기억나?"
    },
    "p136": {
      "source_hash": "b8490afffed4",
      "text": "두께, 보내는 간격은 여전히 보여."
    },
    "p137": {
      "source_hash": "d4af98736f5f",
      "text": "두께로"
    },
    "p138": {
      "source_hash": "1b8095ed3cb1",
      "text": "뭘 알아요?"
    },
    "p139": {
      "source_hash": "ab5abfc5e171",
      "text": "규격 경고: 길이와 시간으로 하는 일을 짐작할 때가 있대,"
    },
    "p140": {
      "source_hash": "8526817723d4",
      "text": "특히 선택지가 적을 때, 정해진 영상만 있는 사이트처럼."
    },
    "p141": {
      "source_hash": "82683984a2e9",
      "text": "사이트는 빈칸을 채워 두께를 맞출 수 있어."
    },
    "p142": {
      "source_hash": "7f707aa2cc48",
      "text": "얼마나 채울지는 규격에 없어."
    },
    "p143": {
      "source_hash": "ab23b3a03ce4",
      "text": "그럼 그들은"
    },
    "p144": {
      "source_hash": "223eb2eefe69",
      "text": "제 상대 사이트도 알아요?"
    },
    "p145": {
      "source_hash": "49e13a5d08de",
      "text": "아마도. 연결 처음에 브라우저가 찾는 사이트를 말하는데,"
    },
    "p146": {
      "source_hash": "e2e05accb87c",
      "text": "그 이름은 보통 안 봉해."
    },
    "p147": {
      "source_hash": "e126ecac4372",
      "text": "겉에 쓴 받는 사람처럼."
    },
    "p148": {
      "source_hash": "41393d46b22b",
      "text": "그것도 봉해요?"
    },
    "p149": {
      "source_hash": "2b1f5709f5b3",
      "text": "2026년 3월, 바로 그걸 하는 새 규격이 정식 발표됐어:"
    },
    "p150": {
      "source_hash": "3bf054473b66",
      "text": "받는 사람 이름도 안쪽 봉투에 넣는 거야."
    },
    "p151": {
      "source_hash": "b04f1a6b3261",
      "text": "근데 규격도 이걸론 부족하대."
    },
    "p152": {
      "source_hash": "8faf7b3c8147",
      "text": "어느 사이트 기계로 가는지는 길에서 보여."
    },
    "p153": {
      "source_hash": "7a1cffad8f55",
      "text": "다만 여러 사이트가 한 대를 같이 쓰곤 해서,"
    },
    "p154": {
      "source_hash": "f23ed3bd09fa",
      "text": "봉투의 이름이 가장 뚜렷한 단서야."
    },
    "p155": {
      "source_hash": "5e678cbab737",
      "text": "출발 전 '이 주소 어디?' 물은 거 기억나?"
    },
    "p156": {
      "source_hash": "ab96c661fd88",
      "text": "그게 안 봉해지면 이름이 보여."
    },
    "p157": {
      "source_hash": "32058694ec0f",
      "text": "그럼 그 보석 링크는……"
    },
    "p158": {
      "source_hash": "a3419c95b4a9",
      "text": "제일 중요한 점: 봉인은 길 위만 지켜."
    },
    "p159": {
      "source_hash": "d2a2e0600df0",
      "text": "상대 손에 닿으면, 상대는 다 읽어."
    },
    "p160": {
      "source_hash": "ee61cf48823e",
      "text": "HTTPS는 사기꾼한테도 비번을 잘 주죠."
    },
    "p161": {
      "source_hash": "635e3b5108cd",
      "text": "구별법은요?"
    },
    "p162": {
      "source_hash": "823a5d7f35b2",
      "text": "Chrome 도움말도 말해: 안전한 연결이라도"
    },
    "p163": {
      "source_hash": "a5a00a69cb84",
      "text": "주소창 이름이 가려던 사이트인지 잘 보라고."
    },
    "p164": {
      "source_hash": "b8c39e07a2b3",
      "text": "글자가 하나 더 있어요!"
    },
    "p165": {
      "source_hash": "9d0e52451533",
      "text": "맞아, 봉인 밖이니 직접 봐."
    },
    "p166": {
      "source_hash": "c997e773f825",
      "text": "S 하나로 길 위 비번 뭐가 달라?"
    },
    "p167": {
      "source_hash": "36d742bcb996",
      "text": "그래서구나!"
    },
    "p168": {
      "source_hash": "b4a835294305",
      "text": "아까 봉한 편지처럼,"
    },
    "p169": {
      "source_hash": "9143b223f739",
      "text": "친구들이 전해도 못 읽고,"
    },
    "p170": {
      "source_hash": "616bf2174fb3",
      "text": "그 이름 행세도 못 해요!"
    },
    "p171": {
      "source_hash": "495a669350df",
      "text": "잘했어. 제일 신기한 건, 이 봉인을 매일 쓰면서"
    },
    "p172": {
      "source_hash": "c0ee9b730ede",
      "text": "제대로 본 적은 없단 거야."
    },
    "p173": {
      "source_hash": "b4f348522f85",
      "text": "엄마께 말할래"
    },
    "p174": {
      "source_hash": "b8a9ebbacfcd",
      "text": "링크 가짜!"
    },
    "p175": {
      "source_hash": "23c35e85a11e",
      "text": "다음엔 비번 전에 이름부터!"
    },
    "p176": {
      "source_hash": "7e4f77703946",
      "text": "비슷하지만 가짜인 주소 받아 봤어?"
    },
    "p177": {
      "source_hash": "fe508e80b52e",
      "text": "댓글 줘."
    },
    "p178": {
      "source_hash": "88de677d4daa",
      "text": "생활 속 '왜'를 찾으려면 그래서그랬구나 사무소 구독!"
    }
  }
}
