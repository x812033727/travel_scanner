import { expect, test } from "claude-code/testing";

test("tally follows two stubbed tool events", async ($, on) => {
  on("tool.call", () => ({ result: "fixture response; no tool executed" }));
  await $.tool.call({ tool: "Read", file_path: "demo-one.txt" });
  await $.tool.call({ tool: "Read", file_path: "demo-two.txt" });
  const response = await $.command.run({ command: "tally", args: "" });
  expect(response.text).toBe("Tool calls since load: 2");
});
