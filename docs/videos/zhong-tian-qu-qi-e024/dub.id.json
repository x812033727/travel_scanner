{
  "zq24a01": "Sabun, lima koin sebatang!",
  "zq24a02": {
    "text": "Separuh pembeli kabur!",
    "say": "Separuh kabur!"
  },
  "zq24a03": "Lima koin?",
  "zq24a04": "Lemaknya aja nggak nutup.",
  "zq24a05": "Dia jual rugi,",
  "zq24a06": {
    "text": "bakar uang kediaman Perdana Menteri.",
    "say": "pakai uang Perdana Menteri."
  },
  "zq24a07": {
    "text": "Tiga puluh hari,",
    "say": "Sebulan,"
  },
  "zq24a08": {
    "text": "aku temani kau main.",
    "say": "kutemani main."
  },
  "zq24a09": {
    "text": "Kita turunin harga juga!",
    "say": "Ikut turun!"
  },
  "zq24a10": "Nggak.",
  "zq24a11": "Bawa sisa sabun lama,",
  "zq24a12": "tukar sabun baru, diskon setengah!",
  "zq24a13": "Pakai kartu kayu,",
  "zq24a14": "tiap kali diskon sepuluh persen!",
  "zq24a15": {
    "text": "Pelanggan lama kembali: tujuh puluh persen.",
    "say": "Tujuh puluh persen balik."
  },
  "zq24a16": {
    "text": "Pelanggan bisa ditahan,",
    "say": "Tapi,"
  },
  "zq24a17": "adu harga, kita tetap kalah.",
  "zq24a18": {
    "text": "Ditukar: teknik membuat gula.",
    "say": "Ditukar: teknik gula."
  },
  "zq24a19": "Gula merah paling murah.",
  "zq24a20": "Gula merah?",
  "zq24a21": "Siapa yang mau?",
  "zq24a22": "Lihat,",
  "zq24a23": "jadi putih.",
  "zq24a24": {
    "text": "Disiram air lumpur?",
    "say": "Air lumpur?"
  },
  "zq24a25": "Masih bisa dimakan?",
  "zq24a26": "Tunggu pagi.",
  "zq24a27": "Manis kayak salju!",
  "zq24a28": "Uji gula putih: berhasil.",
  "zq24a29": {
    "text": "Gula merah se-provinsi,",
    "say": "Semua gula merah,"
  },
  "zq24a30": "diborong habis semalam!",
  "zq24a31": "Tanpa gula,",
  "zq24a32": {
    "text": "kau mau rebus apa sekarang?",
    "say": "mau rebus apa?"
  }
}
