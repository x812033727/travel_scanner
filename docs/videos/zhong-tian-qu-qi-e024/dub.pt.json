{
  "zq24a01": "Sabão, cinco moedas a barra!",
  "zq24a02": {
    "text": "Metade dos clientes sumiu!",
    "say": "Sumiu metade!"
  },
  "zq24a03": "Cinco?",
  "zq24a04": "Nem paga a banha.",
  "zq24a05": "No prejuízo,",
  "zq24a06": "na conta do chanceler.",
  "zq24a07": "Trinta dias,",
  "zq24a08": "eu brinco com você.",
  "zq24a09": "Baixa também!",
  "zq24a10": "Não baixa.",
  "zq24a11": {
    "text": "Tragam os restos de sabão,",
    "say": "Tragam os restos,"
  },
  "zq24a12": "sabão novo pela metade!",
  "zq24a13": {
    "text": "Com esta plaquinha,",
    "say": "Com esta placa,"
  },
  "zq24a14": "dez por cento, sempre!",
  "zq24a15": {
    "text": "Clientes fiéis de volta: setenta por cento.",
    "say": "Voltaram: sete em dez."
  },
  "zq24a16": {
    "text": "Mesmo segurando os clientes,",
    "say": "Só que"
  },
  "zq24a17": "no preço, a gente perde.",
  "zq24a18": {
    "text": "Troca: refino de açúcar.",
    "say": "Refino de açúcar."
  },
  "zq24a19": "Mascavo bem barato.",
  "zq24a20": "Mascavo?",
  "zq24a21": "Quem quer isso?",
  "zq24a22": "Vou fazer",
  "zq24a23": "ele virar branco.",
  "zq24a24": "Com barro?",
  "zq24a25": "Dá pra comer isso?",
  "zq24a26": "Espera o dia.",
  "zq24a27": "Doce feito neve!",
  "zq24a28": {
    "text": "Teste de açúcar branco: sucesso.",
    "say": "Açúcar branco: sucesso."
  },
  "zq24a29": {
    "text": "Todo o mascavo da província,",
    "say": "O mascavo todo,"
  },
  "zq24a30": "compraram numa noite!",
  "zq24a31": "Sem açúcar,",
  "zq24a32": "quero ver o que você ferve."
}
