{
  "zq24a01": "石鹸、一個五文！",
  "zq24a02": "半分逃げた！",
  "zq24a03": "五文!?",
  "zq24a04": "油代も出ない。",
  "zq24a05": "赤字覚悟で、",
  "zq24a06": "宰相の金で潰す気だ。",
  "zq24a07": "三十日",
  "zq24a08": "遊んであげよう。",
  "zq24a09": "下げよう！",
  "zq24a10": "しない。",
  "zq24a11": "古い石鹸で、",
  "zq24a12": "新品が半額！",
  "zq24a13": "この札があれば、",
  "zq24a14": "毎回一割引！",
  "zq24a15": "常連の再来、七割。",
  "zq24a16": "客は残る、",
  "zq24a17": "値段じゃ負ける。",
  "zq24a18": "交換：製糖法。",
  "zq24a19": "一番安い黒糖。",
  "zq24a20": "黒糖？",
  "zq24a21": "誰が買うの。",
  "zq24a22": "これ",
  "zq24a23": "白くする。",
  "zq24a24": "泥水を？",
  "zq24a25": "食えんのか？",
  "zq24a26": "朝を待て。",
  "zq24a27": "雪みたいに甘い！",
  "zq24a28": "白糖試作、成功。",
  "zq24a29": {
    "text": "州じゅうの黒糖が、",
    "say": "黒糖"
  },
  "zq24a30": "一晩で消えた！",
  "zq24a31": "砂糖なしで、",
  "zq24a32": "何を煮る気かな。"
}
