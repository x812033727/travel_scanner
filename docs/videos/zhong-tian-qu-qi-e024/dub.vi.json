{
  "zq24a01": "Xà phòng, năm văn một bánh!",
  "zq24a02": "Mất nửa khách rồi!",
  "zq24a03": "Năm văn?",
  "zq24a04": "Tiền mỡ còn không đủ.",
  "zq24a05": "Hắn bán lỗ,",
  "zq24a06": "đốt tiền của phủ tể tướng.",
  "zq24a07": "Ba mươi ngày,",
  "zq24a08": "ta chơi với ngươi.",
  "zq24a09": "Ta cũng hạ giá!",
  "zq24a10": "Không hạ.",
  "zq24a11": {
    "text": "Mang mẩu xà phòng cũ tới,",
    "say": "Mẩu xà phòng cũ,"
  },
  "zq24a12": "đổi bánh mới, giảm một nửa!",
  "zq24a13": "Có thẻ gỗ này,",
  "zq24a14": "lần nào cũng giảm một phần mười!",
  "zq24a15": "Khách cũ quay lại: bảy phần.",
  "zq24a16": {
    "text": "Giữ được khách,",
    "say": "Giữ được,"
  },
  "zq24a17": "đua giá vẫn thua.",
  "zq24a18": "Đổi: cách chế đường.",
  "zq24a19": "Đường đỏ rẻ nhất.",
  "zq24a20": "Đường đỏ?",
  "zq24a21": "Ai thèm chứ.",
  "zq24a22": "Ta muốn nó",
  "zq24a23": "hóa thành trắng tinh.",
  "zq24a24": "Đổ nước bùn?",
  "zq24a25": "Thế còn ăn được à?",
  "zq24a26": "Chờ trời sáng.",
  "zq24a27": "Ngọt như tuyết!",
  "zq24a28": "Làm thử đường trắng: thành công.",
  "zq24a29": "Đường đỏ cả châu,",
  "zq24a30": "một đêm bị mua sạch!",
  "zq24a31": "Không có đường,",
  "zq24a32": "xem ngươi nấu cái gì."
}
