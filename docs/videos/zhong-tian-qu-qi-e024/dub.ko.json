{
  "zq24a01": "비누, 한 개 오 문!",
  "zq24a02": "손님 반이 갔어!",
  "zq24a03": "오 문?",
  "zq24a04": "적자야.",
  "zq24a05": "밑지면서,",
  "zq24a06": "재상 돈으로 버텨.",
  "zq24a07": "삼십 일,",
  "zq24a08": "놀아 주지.",
  "zq24a09": "우리도 내리자!",
  "zq24a10": "안 내려.",
  "zq24a11": "헌 비누 주면,",
  "zq24a12": "새 비누 반값!",
  "zq24a13": "이 패로,",
  "zq24a14": "매번 일 할 할인!",
  "zq24a15": "단골 재방문, 칠 할.",
  "zq24a16": "잡아도,",
  "zq24a17": "가격으론 져.",
  "zq24a18": "교환: 제당법.",
  "zq24a19": "제일 싼 흑설탕.",
  "zq24a20": "흑설탕?",
  "zq24a21": "그걸 누가 써.",
  "zq24a22": "자,",
  "zq24a23": "희게.",
  "zq24a24": "진흙물을 부어?",
  "zq24a25": "그걸 어떻게 먹어?",
  "zq24a26": "아침에.",
  "zq24a27": "눈처럼 달아!",
  "zq24a28": "백설탕 시험 제작, 성공.",
  "zq24a29": "주 흑설탕이,",
  "zq24a30": "하룻밤에 동났어!",
  "zq24a31": "설탕 없이,",
  "zq24a32": "뭘 졸이려나."
}
