{
  "zq24a01": "¡Jabón, a cinco cobres la pieza!",
  "zq24a02": "¡Se fue la mitad!",
  "zq24a03": "¿Cinco?",
  "zq24a04": "Ni para manteca.",
  "zq24a05": "Vende perdiendo,",
  "zq24a06": "lo paga el primer ministro.",
  "zq24a07": {
    "text": "Treinta días,",
    "say": "Un mes,"
  },
  "zq24a08": "te sigo el juego.",
  "zq24a09": "¡Bajemos precios!",
  "zq24a10": "No.",
  "zq24a11": "¡Jabón viejo,",
  "zq24a12": "por uno nuevo a mitad de precio!",
  "zq24a13": "Con la ficha,",
  "zq24a14": {
    "text": "¡diez por ciento de descuento, siempre!",
    "say": "¡diez menos, siempre!"
  },
  "zq24a15": {
    "text": "Clientes que vuelven: setenta por ciento.",
    "say": "Vuelven: setenta por ciento."
  },
  "zq24a16": "Aun así,",
  "zq24a17": "en precios perdemos.",
  "zq24a18": {
    "text": "Canje: refinado de azúcar.",
    "say": "Canje: azúcar."
  },
  "zq24a19": "Azúcar morena barata.",
  "zq24a20": {
    "text": "¿Azúcar morena?",
    "say": "¿Morena?"
  },
  "zq24a21": "¿Quién quiere eso?",
  "zq24a22": "Yo haré",
  "zq24a23": "que se vuelva blanca.",
  "zq24a24": "¿Le echas lodo?",
  "zq24a25": "¿Y así se puede comer?",
  "zq24a26": "Al alba.",
  "zq24a27": "¡Dulce como la nieve!",
  "zq24a28": "Prueba de azúcar blanca: éxito.",
  "zq24a29": {
    "text": "¡El azúcar morena de toda la prefectura",
    "say": "¡El azúcar…"
  },
  "zq24a30": "la compraron toda anoche!",
  "zq24a31": "Sin azúcar,",
  "zq24a32": "a ver qué hierves ahora."
}
