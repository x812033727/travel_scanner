{
  "zq24a01": "Soap! Five coppers a bar!",
  "zq24a02": "Half our customers are gone!",
  "zq24a03": "Five?",
  "zq24a04": "That won't cover the oil.",
  "zq24a05": "Selling at a loss,",
  "zq24a06": "burning the chancellor's money.",
  "zq24a07": "Fine.",
  "zq24a08": "I'll play along.",
  "zq24a09": "Let's cut prices too!",
  "zq24a10": "No.",
  "zq24a11": "Bring your old soap ends,",
  "zq24a12": "half off a new bar!",
  "zq24a13": "With this token,",
  "zq24a14": "ten percent off, every time!",
  "zq24a15": "Repeat customers: seventy percent.",
  "zq24a16": "Even so,",
  "zq24a17": "we lose a price war.",
  "zq24a18": "Redeemed: sugar refining.",
  "zq24a19": "The cheapest brown sugar.",
  "zq24a20": "Brown sugar?",
  "zq24a21": "Who wants that?",
  "zq24a22": "Watch it",
  "zq24a23": "turn white.",
  "zq24a24": "Pouring mud on it?",
  "zq24a25": "Can you still eat that?",
  "zq24a26": "By dawn.",
  "zq24a27": "Sweet as snow!",
  "zq24a28": "White sugar trial: success.",
  "zq24a29": "All the brown sugar around",
  "zq24a30": "bought up overnight!",
  "zq24a31": "No sugar,",
  "zq24a32": "so what'll you boil now?"
}
