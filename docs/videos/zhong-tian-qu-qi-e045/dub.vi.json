{
  "zq45a01": {
    "text": "Nàng là Tần Sương,",
    "emotion": "輕聲，快，說完就停"
  },
  "zq45a02": {
    "text": "ta chỉ nhận điều đó.",
    "emotion": "篤定",
    "say": "chỉ vậy thôi."
  },
  "zq45a03": {
    "text": "Tần Sương hảo cảm,",
    "emotion": "平板電子音，叮一聲",
    "say": "Tần Sương,"
  },
  "zq45a04": {
    "text": "cộng bốn, năm mươi hai.",
    "emotion": "平板電子音，極短促，一口氣說完，不拖音"
  },
  "zq45a05": {
    "text": "Đồ ngốc.",
    "emotion": "轉過身，紅著眼笑"
  },
  "zq45a06": {
    "text": "Ngốc mới nhận đúng người.",
    "emotion": "笑",
    "say": "Ngốc mới nhận đúng."
  },
  "zq45a07": {
    "text": "Ta nói ta là cô nữ quân hộ,",
    "emotion": "捶他一下",
    "say": "Chuyện cô nữ quân hộ,"
  },
  "zq45a08": {
    "text": "là lừa ngươi đấy.",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "Nhà tướng quân,",
    "emotion": "眨眼，極短促，一口氣說完，不拖音",
    "say": "Tướng quân,"
  },
  "zq45a10": {
    "text": "cũng là quân hộ mà.",
    "emotion": "逗她"
  },
  "zq45a11": {
    "text": "Chứa chấp con gái tội nhân,",
    "emotion": "收住笑，看著他",
    "say": "Con gái tội nhân,"
  },
  "zq45a12": {
    "text": "ngươi không sợ?",
    "emotion": "輕聲"
  },
  "zq45a13": {
    "text": "Sợ chứ.",
    "emotion": "老實，極短促，一口氣說完，不拖音"
  },
  "zq45a14": {
    "text": "Sợ nàng bỏ chạy.",
    "emotion": "聲音放軟，快，說完就停",
    "say": "Sợ nàng chạy."
  },
  "zq45a15": {
    "text": "Chuyện ta là con gái tội nhân,",
    "emotion": "收起笑，認真",
    "say": "Chuyện tội nhân,"
  },
  "zq45a16": {
    "text": "đừng để người thứ ba biết.",
    "emotion": "壓低聲音，快，說完就停",
    "say": "đừng ai biết."
  },
  "zq45a17": {
    "text": "Miệng ta kín lắm.",
    "emotion": "點頭",
    "say": "Ta kín miệng."
  },
  "zq45a18": {
    "text": "Tần Liệt Sơn…",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "Con gái tội nhân?",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "Cái này đáng tiền đây.",
    "emotion": "嘴角一勾",
    "say": "Đáng tiền đây."
  },
  "zq45a21": {
    "text": "Còn hai ngày nữa mới yết bảng?",
    "emotion": "繞著桌子走",
    "say": "Còn hai ngày?"
  },
  "zq45a22": {
    "text": "Ta không đợi nổi!",
    "emotion": "跺腳",
    "say": "Không đợi nổi!"
  },
  "zq45a23": {
    "text": "Bảng là bí mật,",
    "emotion": "淡淡地，快，說完就停"
  },
  "zq45a24": {
    "text": "ai cũng không xem được.",
    "emotion": "淡淡地",
    "say": "không ai xem được."
  },
  "zq45a25": {
    "text": "Bí mật,",
    "emotion": "眼睛一亮，極短促，一口氣說完，不拖音"
  },
  "zq45a26": {
    "text": "đều có giá.",
    "emotion": "甜甜一笑"
  },
  "zq45a27": {
    "text": "Phòng yết bảng có lính canh.",
    "emotion": "挑眉",
    "say": "Có lính canh."
  },
  "zq45a28": {
    "text": "Lính canh cửa,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq45a29": {
    "text": "vợ thư lại canh bếp.",
    "emotion": "眨眼"
  },
  "zq45a30": {
    "text": "Đường trắng?",
    "emotion": "眼睛發直"
  },
  "zq45a31": {
    "text": "Nguyên một hộp?",
    "emotion": "壓低聲音",
    "say": "Cả hộp?"
  },
  "zq45a32": {
    "text": "Xem một cái,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Xem,"
  },
  "zq45a33": {
    "text": "một cái thôi!",
    "emotion": "催",
    "say": "một cái!"
  },
  "zq45a34": {
    "text": "Huyện Thanh Thủy…",
    "emotion": "畫外，壓低聲音，快",
    "say": "Thanh Thủy…"
  },
  "zq45a35": {
    "text": "Hứa…",
    "emotion": "畫外"
  },
  "zq45a36": {
    "text": "Không có?",
    "emotion": "笑容一點一點收掉"
  },
  "zq45a37": {
    "text": "Xong chưa?",
    "emotion": "急，極短促，一口氣說完，不拖音"
  },
  "zq45a38": {
    "text": "Nhanh lên!",
    "emotion": "壓低聲音，極短促，一口氣說完，不拖音",
    "say": "Nhanh!"
  },
  "zq45a39": {
    "text": "Dùng guồng nước dẫn nước…",
    "emotion": "畫外，念出來，聲音一緊"
  },
  "zq45a40": {
    "text": "Đây là bài văn của huynh ấy.",
    "emotion": "臉色發白",
    "say": "Văn của huynh ấy."
  },
  "zq45a41": {
    "text": "Tên của huynh,",
    "emotion": "喘著氣，臉色發白"
  },
  "zq45a42": {
    "text": "không có trên bảng.",
    "emotion": "聲音發緊",
    "say": "không có."
  },
  "zq45a43": {
    "text": "Không có?",
    "emotion": "愣住",
    "say": "Không?"
  },
  "zq45a44": {
    "text": "Thủ bảng là Ngụy Tuân,",
    "emotion": "聲音發緊，快，說完就停"
  },
  "zq45a45": {
    "text": "sách luận của hắn viết về guồng nước.",
    "emotion": "聲音發抖",
    "say": "sách luận hắn viết guồng nước."
  }
}
