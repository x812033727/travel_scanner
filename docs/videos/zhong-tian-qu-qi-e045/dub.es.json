{
  "zq45a01": {
    "text": "Eres Qin Shuang,",
    "emotion": "輕聲，快，說完就停",
    "say": "Qin Shuang,"
  },
  "zq45a02": {
    "text": "es lo único que me importa.",
    "emotion": "篤定",
    "say": "con eso basta."
  },
  "zq45a03": {
    "text": "Qin Shuang, afecto:",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang:"
  },
  "zq45a04": {
    "text": "más cuatro, cincuenta y dos.",
    "emotion": "平板電子音"
  },
  "zq45a05": {
    "text": "Tonto.",
    "emotion": "轉過身，紅著眼笑"
  },
  "zq45a06": {
    "text": "Solo un tonto acierta así.",
    "emotion": "笑",
    "say": "Los tontos aciertan."
  },
  "zq45a07": {
    "text": "Dije que era huérfana de soldado,",
    "emotion": "捶他一下",
    "say": "Lo de huérfana de soldado,"
  },
  "zq45a08": {
    "text": "era mentira.",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "Casa de general,",
    "emotion": "眨眼，極短促，一口氣說完，不拖音",
    "say": "General,"
  },
  "zq45a10": {
    "text": "también cuenta como militar, ¿no?",
    "emotion": "逗她",
    "say": "también es militar."
  },
  "zq45a11": {
    "text": "Esconder a la hija de un convicto,",
    "emotion": "收住笑，看著他",
    "say": "Hija de un convicto,"
  },
  "zq45a12": {
    "text": "¿no te da miedo?",
    "emotion": "輕聲"
  },
  "zq45a13": {
    "text": "Claro que sí.",
    "emotion": "老實",
    "say": "Claro."
  },
  "zq45a14": {
    "text": "Miedo de que te escapes.",
    "emotion": "聲音放軟，快，說完就停",
    "say": "De que te vayas."
  },
  "zq45a15": {
    "text": "Lo de que soy hija de un convicto,",
    "emotion": "收起笑，認真",
    "say": "Lo de hija de convicto,"
  },
  "zq45a16": {
    "text": "que no lo sepa nadie más.",
    "emotion": "壓低聲音",
    "say": "que nadie lo sepa."
  },
  "zq45a17": {
    "text": "Soy una tumba.",
    "emotion": "點頭"
  },
  "zq45a18": {
    "text": "Qin Lieshan…",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "¿Hija de un convicto?",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "Esto vale oro.",
    "emotion": "嘴角一勾"
  },
  "zq45a21": {
    "text": "¿Faltan dos días para la lista?",
    "emotion": "繞著桌子走",
    "say": "¿Dos días más?"
  },
  "zq45a22": {
    "text": "¡No puedo esperar!",
    "emotion": "跺腳",
    "say": "¡No aguanto!"
  },
  "zq45a23": {
    "text": "La lista es secreta,",
    "emotion": "不抬頭"
  },
  "zq45a24": {
    "text": "nadie puede verla.",
    "emotion": "淡淡地",
    "say": "nadie la ve."
  },
  "zq45a25": {
    "text": "Los secretos,",
    "emotion": "眼睛一亮，極短促，一口氣說完，不拖音",
    "say": "Secretos,"
  },
  "zq45a26": {
    "text": "tienen precio.",
    "emotion": "甜甜一笑"
  },
  "zq45a27": {
    "text": "La oficina de resultados tiene guardias.",
    "emotion": "挑眉",
    "say": "Hay guardias."
  },
  "zq45a28": {
    "text": "Los soldados cuidan la puerta,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Guardias: puerta,"
  },
  "zq45a29": {
    "text": "y la mujer del escribano cuida la cocina.",
    "emotion": "眨眼",
    "say": "la del escribano, la cocina."
  },
  "zq45a30": {
    "text": "¿Azúcar blanca?",
    "emotion": "眼睛發直",
    "say": "¿Azúcar?"
  },
  "zq45a31": {
    "text": "¿Una caja entera?",
    "emotion": "壓低聲音",
    "say": "¿Toda la caja?"
  },
  "zq45a32": {
    "text": "Un vistazo,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Mira,"
  },
  "zq45a33": {
    "text": "¡solo uno!",
    "emotion": "催"
  },
  "zq45a34": {
    "text": "Condado de Qingshui…",
    "emotion": "畫外，壓低聲音念"
  },
  "zq45a35": {
    "text": "Xu…",
    "emotion": "畫外"
  },
  "zq45a36": {
    "text": "¿No está?",
    "emotion": "笑容一點一點收掉"
  },
  "zq45a37": {
    "text": "¿Ya terminaste?",
    "emotion": "在門口急",
    "say": "¿Ya?"
  },
  "zq45a38": {
    "text": "¡Rápido!",
    "emotion": "壓低聲音，極短促，一口氣說完，不拖音"
  },
  "zq45a39": {
    "text": "Llevar el agua con norias…",
    "emotion": "畫外，念出來，聲音一緊"
  },
  "zq45a40": {
    "text": "Este es su ensayo.",
    "emotion": "臉色發白"
  },
  "zq45a41": {
    "text": "Tu nombre,",
    "emotion": "喘著氣，臉色發白"
  },
  "zq45a42": {
    "text": "no está en la lista.",
    "emotion": "聲音發緊",
    "say": "no está."
  },
  "zq45a43": {
    "text": "¿No está?",
    "emotion": "愣住",
    "say": "¿No?"
  },
  "zq45a44": {
    "text": "El primero de la lista es Wei Xun,",
    "emotion": "一字一字",
    "say": "El primero es Wei Xun,"
  },
  "zq45a45": {
    "text": "y su ensayo de política es sobre norias.",
    "emotion": "聲音發抖",
    "say": "su ensayo es sobre norias."
  }
}
