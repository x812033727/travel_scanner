{
  "zq45a01": {
    "text": "君はチン・シュアンだ、",
    "emotion": "走到她身後，輕聲",
    "say": "チン・シュアン、"
  },
  "zq45a02": {
    "text": "俺にはそれだけだ。",
    "emotion": "篤定",
    "say": "それだけだ。"
  },
  "zq45a03": {
    "text": "チン・シュアン、好感度、",
    "emotion": "平板電子音，叮一聲",
    "say": "チン・シュアン、"
  },
  "zq45a04": {
    "text": "プラス四、五十二。",
    "emotion": "平板電子音，極短促，一口氣說完，不拖音"
  },
  "zq45a05": {
    "text": "バカ。",
    "emotion": "紅著眼，低聲，快，說完就停"
  },
  "zq45a06": {
    "text": "バカだから見抜けるんだ。",
    "emotion": "笑",
    "say": "バカほど見抜く。"
  },
  "zq45a07": {
    "text": "軍戸の孤児って言ったの、",
    "emotion": "捶他一下",
    "say": "軍戸の孤児ってのは、"
  },
  "zq45a08": {
    "text": "嘘だった。",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "将軍家も、",
    "emotion": "眨眼，極短促，一口氣說完，不拖音",
    "say": "将軍家、"
  },
  "zq45a10": {
    "text": "軍戸のうちだろ？",
    "emotion": "逗她",
    "say": "軍戸だろ？"
  },
  "zq45a11": {
    "text": "罪人の娘をかくまって、",
    "emotion": "收住笑，看著他",
    "say": "罪人の娘だよ、"
  },
  "zq45a12": {
    "text": "怖くないの？",
    "emotion": "輕聲"
  },
  "zq45a13": {
    "text": "怖いさ。",
    "emotion": "老實",
    "say": "怖い。"
  },
  "zq45a14": {
    "text": "君に逃げられるのが。",
    "emotion": "笑著，聲音放軟",
    "say": "逃げられるのが。"
  },
  "zq45a15": {
    "text": "罪人の娘だってことは、",
    "emotion": "收起笑，認真",
    "say": "罪人の娘のこと、"
  },
  "zq45a16": {
    "text": "三人目には知られないで。",
    "emotion": "壓低聲音",
    "say": "誰にも言わないで。"
  },
  "zq45a17": {
    "text": "口は堅い。",
    "emotion": "點頭"
  },
  "zq45a18": {
    "text": "チン・リエシャン……",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "罪人の娘？",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "こいつは金になる。",
    "emotion": "嘴角一勾",
    "say": "金になるぞ。"
  },
  "zq45a21": {
    "text": "発表まであと二日？",
    "emotion": "繞著桌子走",
    "say": "あと二日？"
  },
  "zq45a22": {
    "text": "待てない！",
    "emotion": "跺腳"
  },
  "zq45a23": {
    "text": "名簿は秘密だ、",
    "emotion": "不抬頭",
    "say": "名簿は秘密、"
  },
  "zq45a24": {
    "text": "誰も見られない。",
    "emotion": "淡淡地",
    "say": "見られない。"
  },
  "zq45a25": {
    "text": "秘密には、",
    "emotion": "眼睛一亮，極短促，一口氣說完，不拖音",
    "say": "秘密、"
  },
  "zq45a26": {
    "text": "値段がある。",
    "emotion": "甜甜一笑"
  },
  "zq45a27": {
    "text": "発表所は兵が守ってる。",
    "emotion": "挑眉",
    "say": "兵が守ってる。"
  },
  "zq45a28": {
    "text": "兵は門を、",
    "emotion": "抱起糖盒"
  },
  "zq45a29": {
    "text": "書記の女房は台所を守る。",
    "emotion": "眨眼",
    "say": "書記の女房は台所。"
  },
  "zq45a30": {
    "text": "白糖？",
    "emotion": "眼睛發直"
  },
  "zq45a31": {
    "text": "丸ごと一箱？",
    "emotion": "壓低聲音",
    "say": "一箱も？"
  },
  "zq45a32": {
    "text": "一目、",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq45a33": {
    "text": "一目だけ！",
    "emotion": "催"
  },
  "zq45a34": {
    "text": "清水県……",
    "emotion": "畫外，壓低聲音念"
  },
  "zq45a35": {
    "text": "シュー……",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "シュー、"
  },
  "zq45a36": {
    "text": "ない？",
    "emotion": "笑容一點一點收掉"
  },
  "zq45a37": {
    "text": "まだ？",
    "emotion": "在門口急"
  },
  "zq45a38": {
    "text": "早く！",
    "emotion": "壓低聲音催"
  },
  "zq45a39": {
    "text": "水車で水を引き……",
    "emotion": "畫外，念出來，聲音一緊"
  },
  "zq45a40": {
    "text": "これ、あの人の文章よ。",
    "emotion": "臉色發白"
  },
  "zq45a41": {
    "text": "あなたの名前、",
    "emotion": "喘著氣，臉色發白",
    "say": "名前が、"
  },
  "zq45a42": {
    "text": "名簿にない。",
    "emotion": "聲音發緊",
    "say": "載ってない。"
  },
  "zq45a43": {
    "text": "ない？",
    "emotion": "愣住"
  },
  "zq45a44": {
    "text": "首位はウェイ・シュン、",
    "emotion": "聲音發緊，快，說完就停"
  },
  "zq45a45": {
    "text": "彼の策論は、水車のことよ。",
    "emotion": "聲音發抖"
  }
}
