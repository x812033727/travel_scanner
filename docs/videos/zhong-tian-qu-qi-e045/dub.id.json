{
  "zq45a01": {
    "text": "Kamu Qin Shuang,",
    "emotion": "輕聲，快，說完就停"
  },
  "zq45a02": {
    "text": "cuma itu yang kuakui.",
    "emotion": "篤定",
    "say": "cuma itu."
  },
  "zq45a03": {
    "text": "Poin suka Qin Shuang,",
    "emotion": "平板電子音，極短促，一口氣說完，不拖音",
    "say": "Qin Shuang plus empat,"
  },
  "zq45a04": {
    "text": "plus empat, lima puluh dua.",
    "emotion": "平板電子音，極短促，一口氣說完，不拖音",
    "say": "lima puluh dua."
  },
  "zq45a05": {
    "text": "Bodoh.",
    "emotion": "轉過身，紅著眼笑"
  },
  "zq45a06": {
    "text": "Cuma orang bodoh yang yakin.",
    "emotion": "笑",
    "say": "Bodoh itu yakin."
  },
  "zq45a07": {
    "text": "Aku bilang aku yatim prajurit,",
    "emotion": "捶他一下",
    "say": "Soal yatim prajurit,"
  },
  "zq45a08": {
    "text": "itu bohong.",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "Keluarga jenderal,",
    "emotion": "眨眼，極短促，一口氣說完，不拖音",
    "say": "Jenderal,"
  },
  "zq45a10": {
    "text": "juga keluarga prajurit, kan?",
    "emotion": "逗她",
    "say": "prajurit juga, kan?"
  },
  "zq45a11": {
    "text": "Menyembunyikan putri pesakitan,",
    "emotion": "收住笑，看著他",
    "say": "Putri pesakitan,"
  },
  "zq45a12": {
    "text": "kamu nggak takut?",
    "emotion": "輕聲",
    "say": "nggak takut?"
  },
  "zq45a13": {
    "text": "Takut.",
    "emotion": "老實，極短促，一口氣說完，不拖音",
    "say": "Iya."
  },
  "zq45a14": {
    "text": "Takut kamu kabur.",
    "emotion": "笑著，極短促，一口氣說完，不拖音",
    "say": "Takut kau kabur."
  },
  "zq45a15": {
    "text": "Soal aku putri pesakitan,",
    "emotion": "收起笑，認真",
    "say": "Soal putri pesakitan,"
  },
  "zq45a16": {
    "text": "jangan sampai orang ketiga tahu.",
    "emotion": "壓低聲音，快，說完就停",
    "say": "rahasiakan."
  },
  "zq45a17": {
    "text": "Mulutku rapat.",
    "emotion": "點頭"
  },
  "zq45a18": {
    "text": "Qin Lieshan…",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "Putri pesakitan?",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "Ini mahal harganya.",
    "emotion": "嘴角一勾",
    "say": "Ini mahal."
  },
  "zq45a21": {
    "text": "Pengumuman masih dua hari lagi?",
    "emotion": "繞著桌子走",
    "say": "Dua hari lagi?"
  },
  "zq45a22": {
    "text": "Aku nggak sabar!",
    "emotion": "跺腳",
    "say": "Nggak sabar!"
  },
  "zq45a23": {
    "text": "Daftar itu rahasia,",
    "emotion": "淡淡地，快，說完就停",
    "say": "Itu rahasia,"
  },
  "zq45a24": {
    "text": "nggak ada yang bisa lihat.",
    "emotion": "淡淡地",
    "say": "nggak bisa dilihat."
  },
  "zq45a25": {
    "text": "Rahasia,",
    "emotion": "眼睛一亮，極短促，一口氣說完，不拖音"
  },
  "zq45a26": {
    "text": "semua ada harganya.",
    "emotion": "甜甜一笑",
    "say": "ada harganya."
  },
  "zq45a27": {
    "text": "Kantor pengumuman dijaga prajurit.",
    "emotion": "挑眉",
    "say": "Dijaga prajurit."
  },
  "zq45a28": {
    "text": "Prajurit jaga pintu,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Prajurit, pintu,"
  },
  "zq45a29": {
    "text": "istri juru tulis jaga dapur.",
    "emotion": "眨眼"
  },
  "zq45a30": {
    "text": "Gula putih?",
    "emotion": "眼睛發直",
    "say": "Gula?"
  },
  "zq45a31": {
    "text": "Satu kotak penuh?",
    "emotion": "壓低聲音",
    "say": "Sekotak penuh?"
  },
  "zq45a32": {
    "text": "Lihat sekali,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Lihat,"
  },
  "zq45a33": {
    "text": "sekali saja!",
    "emotion": "催",
    "say": "sekali aja!"
  },
  "zq45a34": {
    "text": "Kabupaten Qingshui…",
    "emotion": "畫外，壓低聲音，快",
    "say": "Qingshui…"
  },
  "zq45a35": {
    "text": "Xu…",
    "emotion": "畫外"
  },
  "zq45a36": {
    "text": "Nggak ada?",
    "emotion": "笑容一點一點收掉"
  },
  "zq45a37": {
    "text": "Sudah belum?",
    "emotion": "在門口急",
    "say": "Udah?"
  },
  "zq45a38": {
    "text": "Cepat!",
    "emotion": "壓低聲音，極短促，一口氣說完，不拖音"
  },
  "zq45a39": {
    "text": "Mengalirkan air dengan kincir air…",
    "emotion": "畫外，念出來，聲音一緊",
    "say": "Kincir air mengalirkan air…"
  },
  "zq45a40": {
    "text": "Ini esainya dia.",
    "emotion": "臉色發白"
  },
  "zq45a41": {
    "text": "Namamu,",
    "emotion": "喘著氣，臉色發白"
  },
  "zq45a42": {
    "text": "nggak ada di daftar.",
    "emotion": "聲音發緊",
    "say": "nggak ada."
  },
  "zq45a43": {
    "text": "Nggak ada?",
    "emotion": "愣住",
    "say": "Nggak?"
  },
  "zq45a44": {
    "text": "Peringkat teratas Wei Xun,",
    "emotion": "聲音發緊，快，說完就停",
    "say": "Teratas Wei Xun,"
  },
  "zq45a45": {
    "text": "esai kebijakannya tentang kincir air.",
    "emotion": "聲音發抖",
    "say": "esainya soal kincir air."
  }
}
