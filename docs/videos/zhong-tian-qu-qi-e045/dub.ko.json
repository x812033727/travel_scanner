{
  "zq45a01": {
    "text": "넌 친솽이야,",
    "emotion": "低聲，快，說完就停",
    "say": "넌 친솽,"
  },
  "zq45a02": {
    "text": "난 그것만 알아.",
    "emotion": "篤定",
    "say": "그거면 돼."
  },
  "zq45a03": {
    "text": "친솽 호감도,",
    "emotion": "平板電子音，叮一聲",
    "say": "친솽 호감,"
  },
  "zq45a04": {
    "text": "플러스 사, 오십이.",
    "emotion": "平板電子音，極短促，一口氣說完，不拖音"
  },
  "zq45a05": {
    "text": "바보.",
    "emotion": "轉過身，紅著眼笑"
  },
  "zq45a06": {
    "text": "바보라서 알아보는 거야.",
    "emotion": "笑",
    "say": "바보라 알지."
  },
  "zq45a07": {
    "text": "군관 집 고아라고 한 거,",
    "emotion": "捶他一下",
    "say": "군관 집 고아란 건,"
  },
  "zq45a08": {
    "text": "거짓말이야.",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "장군 집도,",
    "emotion": "眨眼",
    "say": "장군 집,"
  },
  "zq45a10": {
    "text": "군관 집 맞잖아.",
    "emotion": "逗她"
  },
  "zq45a11": {
    "text": "죄인의 딸을 숨겨 주고,",
    "emotion": "收住笑，看著他",
    "say": "죄인의 딸인데,"
  },
  "zq45a12": {
    "text": "안 무서워?",
    "emotion": "輕聲"
  },
  "zq45a13": {
    "text": "무섭지.",
    "emotion": "老實，極短促，一口氣說完，不拖音",
    "say": "그럼."
  },
  "zq45a14": {
    "text": "네가 도망갈까 봐.",
    "emotion": "笑著，聲音放軟",
    "say": "도망갈까 봐."
  },
  "zq45a15": {
    "text": "죄인의 딸이라는 거,",
    "emotion": "收起笑，認真",
    "say": "죄인의 딸 얘기,"
  },
  "zq45a16": {
    "text": "다른 누구에게도 알리지 마.",
    "emotion": "壓低聲音",
    "say": "비밀로 해."
  },
  "zq45a17": {
    "text": "입 무거워.",
    "emotion": "點頭"
  },
  "zq45a18": {
    "text": "친례산……",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "죄인의 딸?",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "이거 돈 되겠는데.",
    "emotion": "嘴角一勾",
    "say": "돈 되겠군."
  },
  "zq45a21": {
    "text": "발표까지 이틀이나 남았어?",
    "emotion": "繞著桌子走",
    "say": "이틀이나?"
  },
  "zq45a22": {
    "text": "못 기다려!",
    "emotion": "跺腳"
  },
  "zq45a23": {
    "text": "명단은 비밀이야,",
    "emotion": "不抬頭",
    "say": "명단은 비밀,"
  },
  "zq45a24": {
    "text": "아무도 못 봐.",
    "emotion": "淡淡地"
  },
  "zq45a25": {
    "text": "비밀도,",
    "emotion": "停下腳步，眼睛一亮"
  },
  "zq45a26": {
    "text": "다 값이 있어.",
    "emotion": "甜甜一笑"
  },
  "zq45a27": {
    "text": "방 붙이는 관청은 병사가 지켜.",
    "emotion": "挑眉",
    "say": "병사가 지켜."
  },
  "zq45a28": {
    "text": "병사는 문을,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "병사는 문,"
  },
  "zq45a29": {
    "text": "서리 부인은 부엌을 지켜.",
    "emotion": "眨眼",
    "say": "서리 부인은 부엌."
  },
  "zq45a30": {
    "text": "백설탕?",
    "emotion": "眼睛發直",
    "say": "설탕?"
  },
  "zq45a31": {
    "text": "한 상자 다?",
    "emotion": "壓低聲音"
  },
  "zq45a32": {
    "text": "한 번,",
    "emotion": "接過盒子，四下看"
  },
  "zq45a33": {
    "text": "딱 한 번만!",
    "emotion": "催",
    "say": "딱 한 번!"
  },
  "zq45a34": {
    "text": "청수현……",
    "emotion": "畫外，壓低聲音念"
  },
  "zq45a35": {
    "text": "쉬……",
    "emotion": "畫外，極短促，一口氣說完，不拖音",
    "say": "쉬,"
  },
  "zq45a36": {
    "text": "없어?",
    "emotion": "笑容一點一點收掉"
  },
  "zq45a37": {
    "text": "아직이야?",
    "emotion": "在門口急",
    "say": "아직?"
  },
  "zq45a38": {
    "text": "빨리!",
    "emotion": "壓低聲音，極短促，一口氣說完，不拖音"
  },
  "zq45a39": {
    "text": "수차로 물을 끌어……",
    "emotion": "畫外，念出來，聲音一緊"
  },
  "zq45a40": {
    "text": "이건 그 사람 글이야.",
    "emotion": "臉色發白"
  },
  "zq45a41": {
    "text": "네 이름,",
    "emotion": "喘著氣，臉色發白"
  },
  "zq45a42": {
    "text": "명단에 없어.",
    "emotion": "聲音發緊"
  },
  "zq45a43": {
    "text": "없어?",
    "emotion": "愣住"
  },
  "zq45a44": {
    "text": "방의 첫째는 웨이쉰,",
    "emotion": "聲音發緊，快，說完就停",
    "say": "일등은 웨이쉰,"
  },
  "zq45a45": {
    "text": "그 사람 책론은 수차 얘기야.",
    "emotion": "聲音發抖",
    "say": "책론이 수차 얘기야."
  }
}
