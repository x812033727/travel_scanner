{
  "zq45a01": {
    "text": "You're Qin Shuang,",
    "emotion": "走到她身後，輕聲"
  },
  "zq45a02": {
    "text": "that's all that matters to me.",
    "emotion": "篤定",
    "say": "That's all I need."
  },
  "zq45a03": {
    "text": "Qin Shuang, affection:",
    "emotion": "平板電子音，叮一聲",
    "say": "Qin Shuang:"
  },
  "zq45a04": {
    "text": "plus four, fifty-two.",
    "emotion": "平板電子音"
  },
  "zq45a05": {
    "text": "Idiot.",
    "emotion": "轉過身，紅著眼笑"
  },
  "zq45a06": {
    "text": "Only an idiot knows for sure.",
    "emotion": "笑",
    "say": "Idiots know for sure."
  },
  "zq45a07": {
    "text": "I said I was a soldier's orphan,",
    "emotion": "捶他一下",
    "say": "I said soldier's orphan,"
  },
  "zq45a08": {
    "text": "that was a lie.",
    "emotion": "低聲"
  },
  "zq45a09": {
    "text": "A general's family,",
    "emotion": "眨眼",
    "say": "A general's,"
  },
  "zq45a10": {
    "text": "still counts as military, right?",
    "emotion": "逗她",
    "say": "still military, right?"
  },
  "zq45a11": {
    "text": "Harboring a convict's daughter,",
    "emotion": "收住笑，看著他",
    "say": "Hiding a convict's girl,"
  },
  "zq45a12": {
    "text": "aren't you scared?",
    "emotion": "輕聲"
  },
  "zq45a13": {
    "text": "Sure I am.",
    "emotion": "老實",
    "say": "Sure."
  },
  "zq45a14": {
    "text": "Scared you'll run off.",
    "emotion": "笑著，聲音放軟"
  },
  "zq45a15": {
    "text": "About me being a convict's daughter,",
    "emotion": "收起笑，認真",
    "say": "The convict's daughter part,"
  },
  "zq45a16": {
    "text": "don't let a third person know.",
    "emotion": "壓低聲音",
    "say": "no one else can know."
  },
  "zq45a17": {
    "text": "My lips are sealed.",
    "emotion": "點頭"
  },
  "zq45a18": {
    "text": "Qin Lieshan…",
    "emotion": "壓低聲音，自言自語"
  },
  "zq45a19": {
    "text": "A convict's daughter?",
    "emotion": "眼睛一亮"
  },
  "zq45a20": {
    "text": "Now that's worth something.",
    "emotion": "嘴角一勾"
  },
  "zq45a21": {
    "text": "Two more days till the results?",
    "emotion": "繞著桌子走",
    "say": "Two more days?"
  },
  "zq45a22": {
    "text": "I can't wait!",
    "emotion": "跺腳"
  },
  "zq45a23": {
    "text": "The list is a secret,",
    "emotion": "不抬頭，淡淡地，快，說完就停",
    "say": "It's secret,"
  },
  "zq45a24": {
    "text": "nobody gets to see it.",
    "emotion": "淡淡地",
    "say": "no one sees it."
  },
  "zq45a25": {
    "text": "Secrets,",
    "emotion": "停下腳步，眼睛一亮"
  },
  "zq45a26": {
    "text": "all have a price.",
    "emotion": "甜甜一笑"
  },
  "zq45a27": {
    "text": "Soldiers guard the results office.",
    "emotion": "挑眉",
    "say": "Soldiers guard the office."
  },
  "zq45a28": {
    "text": "Soldiers guard the door,",
    "emotion": "抱起糖盒",
    "say": "Guards at the door,"
  },
  "zq45a29": {
    "text": "the clerk's wife guards the kitchen.",
    "emotion": "眨眼"
  },
  "zq45a30": {
    "text": "White sugar?",
    "emotion": "眼睛發直",
    "say": "Sugar?"
  },
  "zq45a31": {
    "text": "A whole box?",
    "emotion": "壓低聲音"
  },
  "zq45a32": {
    "text": "One look,",
    "emotion": "接過盒子，四下看"
  },
  "zq45a33": {
    "text": "just one!",
    "emotion": "催"
  },
  "zq45a34": {
    "text": "Qingshui County…",
    "emotion": "畫外，壓低聲音念"
  },
  "zq45a35": {
    "text": "Xu…",
    "emotion": "畫外"
  },
  "zq45a36": {
    "text": "It's not here?",
    "emotion": "笑容一點一點收掉",
    "say": "Not here?"
  },
  "zq45a37": {
    "text": "Done yet?",
    "emotion": "在門口急"
  },
  "zq45a38": {
    "text": "Hurry!",
    "emotion": "壓低聲音催"
  },
  "zq45a39": {
    "text": "Draw water with waterwheels…",
    "emotion": "畫外，念出來，聲音一緊"
  },
  "zq45a40": {
    "text": "This is his essay.",
    "emotion": "臉色發白"
  },
  "zq45a41": {
    "text": "Your name,",
    "emotion": "喘著氣，臉色發白"
  },
  "zq45a42": {
    "text": "isn't on the list.",
    "emotion": "聲音發緊",
    "say": "not on it."
  },
  "zq45a43": {
    "text": "Not there?",
    "emotion": "愣住"
  },
  "zq45a44": {
    "text": "The top of the list is Wei Xun,",
    "emotion": "一字一字",
    "say": "Wei Xun's on top,"
  },
  "zq45a45": {
    "text": "and his policy essay is about waterwheels.",
    "emotion": "聲音發抖",
    "say": "his essay's on waterwheels."
  }
}
