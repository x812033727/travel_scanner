  "lines": {
    "p001": {
      "source_hash": "a3c0c466064a",
      "text": "Bu! Tadi pagi, di plafon ruang tamuku,"
    },
    "p002": {
      "source_hash": "429f87fa0e92",
      "text": "ada cicak!"
    },
    "p003": {
      "source_hash": "75d5e18e9267",
      "text": "Menggantung,"
    },
    "p004": {
      "source_hash": "ba69729d0cc4",
      "text": "diam, tak gerak!"
    },
    "p005": {
      "source_hash": "4f036d7f1ce4",
      "text": "Diam? Berarti mungkin istirahat."
    },
    "p006": {
      "source_hash": "f382046473ef",
      "text": "Keempat kakinya menempel rata di plafon, kan?"
    },
    "p007": {
      "source_hash": "a29ed2d11756",
      "text": "Iya! Rata!"
    },
    "p008": {
      "source_hash": "f30d7b568d55",
      "text": "Itu lengket?"
    },
    "p009": {
      "source_hash": "07f91f3bfec4",
      "text": "Kalau mau jalan, kakinya lepas gimana?"
    },
    "p010": {
      "source_hash": "3b2f3174cdfb",
      "text": "Kasus kita: kaki menempel di plafon,"
    },
    "p011": {
      "source_hash": "0cca82a7f53f",
      "text": "tapi saat melangkah, kok bisa diangkat lagi?"
    },
    "p012": {
      "source_hash": "9fb86b4ff153",
      "text": "Oh!"
    },
    "p013": {
      "source_hash": "d04a434e75fb",
      "text": "Tahu! Kakinya ada lem!"
    },
    "p014": {
      "source_hash": "2a21f5d4d6e4",
      "text": "Coba pikir, seharian dia di debu,"
    },
    "p015": {
      "source_hash": "a8e7b3b18817",
      "text": "kalau berlem, kakinya sudah menggumpal?"
    },
    "p016": {
      "source_hash": "3913b3012686",
      "text": "Benar…"
    },
    "p017": {
      "source_hash": "052a028f8634",
      "text": "Jadi dia nempel di mana saja?"
    },
    "p018": {
      "source_hash": "5523260bacc3",
      "text": "Tidak juga. Ada tempat dia susah nempel, di rumahmu."
    },
    "p019": {
      "source_hash": "7f45b25f0aa5",
      "text": "Dan sebelum angkat kaki, ada gerakan kecil."
    },
    "p020": {
      "source_hash": "cfc5e61753e7",
      "text": "Tebakan lem tadi, banyak yang sama."
    },
    "p021": {
      "source_hash": "4d13d1d52c5f",
      "text": "Yuk kita periksa tebakan lemmu."
    },
    "p022": {
      "source_hash": "2f617752d79c",
      "text": "Kalau pakai lem, kakinya harus terus keluarkan lem."
    },
    "p023": {
      "source_hash": "a427b6e143d1",
      "text": "Tapi peneliti sudah melihat,"
    },
    "p024": {
      "source_hash": "bbf70ad64dc1",
      "text": "telapaknya tak punya kelenjar pengeluar."
    },
    "p025": {
      "source_hash": "20322ca0f193",
      "text": "Kelenjar itu apa?"
    },
    "p026": {
      "source_hash": "5660b2ea600e",
      "text": "Pabrik kecil pembuat keringat dan ludah."
    },
    "p027": {
      "source_hash": "cde2f6318910",
      "text": "Jarinya takut air,"
    },
    "p028": {
      "source_hash": "2b96e0986985",
      "text": "tetes air di atasnya jadi bulat."
    },
    "p029": {
      "source_hash": "ce5a741c7624",
      "text": "Jadi kakinya kering?"
    },
    "p030": {
      "source_hash": "be1aad3d6e79",
      "text": "Ya, kering. Tapi ada yang menduga, uap air"
    },
    "p031": {
      "source_hash": "592e57c4427e",
      "text": "membuat lapisan tipis, seperti kertas basah menempel di kaca."
    },
    "p032": {
      "source_hash": "112761dd4b66",
      "text": "Diuji dua permukaan:"
    },
    "p033": {
      "source_hash": "00d3511d8e86",
      "text": "satu suka air, satu tak suka air."
    },
    "p034": {
      "source_hash": "86c3495e5cdb",
      "text": "Jarinya menempel sama kuat di keduanya."
    },
    "p035": {
      "source_hash": "60114c3d2948",
      "text": "Artinya apa?"
    },
    "p036": {
      "source_hash": "b566f56db52d",
      "text": "Kalau air, yang suka air harusnya menang."
    },
    "p037": {
      "source_hash": "5ea55accaf94",
      "text": "Seri: bukan air."
    },
    "p038": {
      "source_hash": "1c66cd2d8e7f",
      "text": "Tapi studi lain bilang kelembapan"
    },
    "p039": {
      "source_hash": "5689418f3851",
      "text": "sedikit membantu."
    },
    "p040": {
      "source_hash": "f2b11f28e5a8",
      "text": "Pengisap?"
    },
    "p041": {
      "source_hash": "b3f989cd5845",
      "text": "Kayak kait di kamar mandi?"
    },
    "p042": {
      "source_hash": "a2abd70057ac",
      "text": "Bukan. Kata peneliti, cicak menempel tanpa pengisap,"
    },
    "p043": {
      "source_hash": "f66bae42948c",
      "text": "juga tanpa lem."
    },
    "p044": {
      "source_hash": "80002d01d8ca",
      "text": "Tapi, jujur saja:"
    },
    "p045": {
      "source_hash": "c8d87ee68b77",
      "text": "ada studi yang menemukan lapisan minyak sangat tipis di jejak kakinya."
    },
    "p046": {
      "source_hash": "7a6e28075ec5",
      "text": "Itu lem, dong?"
    },
    "p047": {
      "source_hash": "1c1ece338460",
      "text": "Bukan. Tipisnya tak kelihatan,"
    },
    "p048": {
      "source_hash": "764896ddc276",
      "text": "sedikit sekali, jauh beda dari lem."
    },
    "p049": {
      "source_hash": "06cbd46328e1",
      "text": "Apa minyak itu membantu, masih diteliti."
    },
    "p050": {
      "source_hash": "dfaf2faaab60",
      "text": "Jadi, bukan lem, bukan pengisap."
    },
    "p051": {
      "source_hash": "4f31b8d7cf6d",
      "text": "Anggap saja kaki cicak itu sebuah stiker tanpa lem."
    },
    "p052": {
      "source_hash": "83981ea782aa",
      "text": "Tanpa lem?"
    },
    "p053": {
      "source_hash": "44ccfacedc91",
      "text": "Lalu nempelnya pakai apa?"
    },
    "p054": {
      "source_hash": "cfde11701366",
      "text": "Kita lihat cicak besar yang paling sering diteliti,"
    },
    "p055": {
      "source_hash": "817fe7e1ac54",
      "text": "namanya tokek, bahasa Inggrisnya Tokay gecko."
    },
    "p056": {
      "source_hash": "1658dfc4fd00",
      "text": "Panjangnya kira-kira dua-tiga kali cicak di plafonmu."
    },
    "p057": {
      "source_hash": "ef762abaaa54",
      "text": "Cicak di plafonku,"
    },
    "p058": {
      "source_hash": "b5023757fd95",
      "text": "kakinya juga begitu?"
    },
    "p059": {
      "source_hash": "9cf95156c59c",
      "text": "Ingat pertanyaan itu ya."
    },
    "p060": {
      "source_hash": "7ef74f13177a",
      "text": "Sekarang, kita perbesar kaki tokek."
    },
    "p061": {
      "source_hash": "bd0803bc5a69",
      "text": "Di bawah jarinya ada barisan kulit,"
    },
    "p062": {
      "source_hash": "8a53d55ea70a",
      "text": "kayak selimut bertumpuk."
    },
    "p063": {
      "source_hash": "d4e1301d89ee",
      "text": "Tiap baris penuh bulu halus,"
    },
    "p064": {
      "source_hash": "177311d29602",
      "text": "tebalnya cuma sepersepuluh rambutmu."
    },
    "p065": {
      "source_hash": "f4a99bf1e52e",
      "text": "Lebih halus!"
    },
    "p066": {
      "source_hash": "6d5272d72586",
      "text": "Ada berapa?"
    },
    "p067": {
      "source_hash": "6e950002d9cf",
      "text": "Satu kaki, kira-kira lima ratus ribu."
    },
    "p068": {
      "source_hash": "2e6e39a3d047",
      "text": "Bulu tak lengket,"
    },
    "p069": {
      "source_hash": "dfb29fbfe759",
      "text": "rambutku tak lengket!"
    },
    "p070": {
      "source_hash": "6863fbd337e1",
      "text": "Bulu cicak beda. Tiap ujungnya bercabang jadi ratusan ujung kecil,"
    },
    "p071": {
      "source_hash": "3f75158906fd",
      "text": "di ujungnya lempeng pipih, seperti sendok kecil."
    },
    "p072": {
      "source_hash": "177f085c17aa",
      "text": "Kenapa harus sehalus itu?"
    },
    "p073": {
      "source_hash": "f220f3379167",
      "text": "Dinding tak serata dugaanmu."
    },
    "p074": {
      "source_hash": "aae2b501b49e",
      "text": "Diperbesar, dinding naik turun, kayak bukit kecil."
    },
    "p075": {
      "source_hash": "c97d41e03025",
      "text": "Jarimu cuma kena beberapa puncak,"
    },
    "p076": {
      "source_hash": "73196dfb1ad0",
      "text": "sisanya kurang sedikit lagi."
    },
    "p077": {
      "source_hash": "77a7b605e247",
      "text": "Lempeng-lempeng kecil masuk lembah,"
    },
    "p078": {
      "source_hash": "24a5588f5fca",
      "text": "hampir semua tersentuh."
    },
    "p079": {
      "source_hash": "c3ac8267d1ca",
      "text": "Makin halus, makin banyak titik yang menempel."
    },
    "p080": {
      "source_hash": "ba56bb83d682",
      "text": "Kena,"
    },
    "p081": {
      "source_hash": "9538366448d1",
      "text": "langsung lengket?"
    },
    "p082": {
      "source_hash": "3e661be07e1f",
      "text": "Dua benda apa pun, kalau dekat sekali,"
    },
    "p083": {
      "source_hash": "6f16b65bcb2f",
      "text": "akan saling tarik pelan."
    },
    "p084": {
      "source_hash": "7b3780eb6666",
      "text": "Tanganku"
    },
    "p085": {
      "source_hash": "4f6ac852df15",
      "text": "tak nempel di meja?"
    },
    "p086": {
      "source_hash": "9387658a0edb",
      "text": "Itu lemah, dan butuh sangat dekat."
    },
    "p087": {
      "source_hash": "45edbc87954b",
      "text": "Tanganmu cuma kena beberapa titik, jadi tak terasa."
    },
    "p088": {
      "source_hash": "2cf5f9507a64",
      "text": "Tarikan kecil jarak dekat ini disebut gaya van der Waals."
    },
    "p089": {
      "source_hash": "cdabe0341b8a",
      "text": "Peneliti menghitung: ujung lebih halus, lebih lengket."
    },
    "p090": {
      "source_hash": "2c7b6e444e89",
      "text": "Harus pakai bulu cicak?"
    },
    "p091": {
      "source_hash": "231d64bb0961",
      "text": "Tidak. Mereka membuat ujung kecil palsu dari dua bahan berbeda,"
    },
    "p092": {
      "source_hash": "b62de9867348",
      "text": "dan lengket. Kuncinya bentuk dan ukuran."
    },
    "p093": {
      "source_hash": "f0444d79cab1",
      "text": "Satu lempeng lemah sekali,"
    },
    "p094": {
      "source_hash": "129a7ce16779",
      "text": "tapi di kaki, banyak sekali lempeng menarik bersama."
    },
    "p095": {
      "source_hash": "642b2aecd54f",
      "text": "Banyaknya berapa?"
    },
    "p096": {
      "source_hash": "1681825ee349",
      "text": "Satu tokek, semua jari keempat kakinya,"
    },
    "p097": {
      "source_hash": "4c5132e325ce",
      "text": "kira-kira satu miliar lempeng."
    },
    "p098": {
      "source_hash": "e1ac0090eca9",
      "text": "Tarik bareng!"
    },
    "p099": {
      "source_hash": "2d250623bb6a",
      "text": "Sekuat apa?"
    },
    "p100": {
      "source_hash": "fa231641e479",
      "text": "Peneliti mengukur gaya satu bulu, lalu menghitung:"
    },
    "p101": {
      "source_hash": "958a9a6e11b6",
      "text": "kalau semua dipakai, secara teori bisa angkat 130 kilo,"
    },
    "p102": {
      "source_hash": "e59ecae56393",
      "text": "seberat dua orang dewasa."
    },
    "p103": {
      "source_hash": "52f06736cfc1",
      "text": "Tentu, biasanya cuma dipakai sedikit."
    },
    "p104": {
      "source_hash": "e5414bdd2427",
      "text": "Di percobaan, satu jari kuat menahan seluruh tokek."
    },
    "p105": {
      "source_hash": "f2a12c480b26",
      "text": "Jariku"
    },
    "p106": {
      "source_hash": "6770028b629d",
      "text": "tak kuat menahan aku!"
    },
    "p107": {
      "source_hash": "4f26bb425202",
      "text": "Ya, makanya kakinya kusebut stiker tanpa lem."
    },
    "p108": {
      "source_hash": "e7c03f6bb23b",
      "text": "Lengket,"
    },
    "p109": {
      "source_hash": "fa265ae6bf6f",
      "text": "kakinya tak bisa lepas, dong?"
    },
    "p110": {
      "source_hash": "836607fdf46c",
      "text": "Dicabut kuat-kuat?"
    },
    "p111": {
      "source_hash": "e22a0712401a",
      "text": "Tidak."
    },
    "p112": {
      "source_hash": "e19209b7f573",
      "text": "Ingat gerakan kecil tadi?"
    },
    "p113": {
      "source_hash": "439aeb6a1d30",
      "text": "Saat angkat kaki, jarinya dari ujung"
    },
    "p114": {
      "source_hash": "bb13371847e8",
      "text": "menggulung naik ke belakang."
    },
    "p115": {
      "source_hash": "7b6bf55d4bb1",
      "text": "Kayak copot stiker,"
    },
    "p116": {
      "source_hash": "739b9525540f",
      "text": "dari pinggirnya dulu?"
    },
    "p117": {
      "source_hash": "ad612dfc8bdc",
      "text": "Mirip. Tapi peneliti menemukan,"
    },
    "p118": {
      "source_hash": "8f05ceccb9ed",
      "text": "tombol pelepasnya ada di setiap bulu."
    },
    "p119": {
      "source_hash": "ad076556ded1",
      "text": "Saat menempel, bulunya rebah miring."
    },
    "p120": {
      "source_hash": "f05479de2e0c",
      "text": "Kalau sudutnya lewat sekitar 30 derajat,"
    },
    "p121": {
      "source_hash": "03e82d698c7c",
      "text": "lepas sendiri."
    },
    "p122": {
      "source_hash": "d4455f3b23a7",
      "text": "Sendiri?"
    },
    "p123": {
      "source_hash": "34b00c4223f8",
      "text": "Tanpa tenaga?"
    },
    "p124": {
      "source_hash": "d507d076a321",
      "text": "Hampir tidak. Jari digulung,"
    },
    "p125": {
      "source_hash": "7e53a8d4af0d",
      "text": "barisan bulu ikut terangkat dan lepas berurutan."
    },
    "p126": {
      "source_hash": "fe577ff82722",
      "text": "Diukur, melepas satu kaki"
    },
    "p127": {
      "source_hash": "094649446d6e",
      "text": "seperseratus detik lebih."
    },
    "p128": {
      "source_hash": "52ed75cae8cb",
      "text": "Wah!"
    },
    "p129": {
      "source_hash": "46b6afeac80b",
      "text": "Sedetik berapa langkah?"
    },
    "p130": {
      "source_hash": "9fa0947f5693",
      "text": "Ada cicak kecil memanjat,"
    },
    "p131": {
      "source_hash": "09d2b6e98119",
      "text": "tiap kaki menempel-lepas 15 kali sedetik."
    },
    "p132": {
      "source_hash": "d557be476856",
      "text": "Lalu waktu menginjak,"
    },
    "p133": {
      "source_hash": "10a86269496a",
      "text": "kok nempel lagi?"
    },
    "p134": {
      "source_hash": "d4adabe7738b",
      "text": "Dibalik saja. Jari ditempel rata,"
    },
    "p135": {
      "source_hash": "05c1e838db5c",
      "text": "lalu ditarik pelan ke arah badan."
    },
    "p136": {
      "source_hash": "69f6d58e5260",
      "text": "Tarikan ini merebahkan bulunya,"
    },
    "p137": {
      "source_hash": "dada605e4de9",
      "text": "makin kuat ditarik, makin lengket."
    },
    "p138": {
      "source_hash": "e96e169abde9",
      "text": "Kalau"
    },
    "p139": {
      "source_hash": "581a25255f14",
      "text": "cuma ditepuk?"
    },
    "p140": {
      "source_hash": "d51efd7fb466",
      "text": "Sedikit. Tak ditarik, bulu tak lengket,"
    },
    "p141": {
      "source_hash": "46f4b4786944",
      "text": "tarikannya menyalakan tombol."
    },
    "p142": {
      "source_hash": "dc04ae7af2a3",
      "text": "Tapi saat terbalik,"
    },
    "p143": {
      "source_hash": "a18c91cd5e29",
      "text": "badan terus turun,"
    },
    "p144": {
      "source_hash": "63a2ef78cb1b",
      "text": "kakinya tak terlepas?"
    },
    "p145": {
      "source_hash": "b9c17c01391e",
      "text": "Peneliti melihat, saat menggantung,"
    },
    "p146": {
      "source_hash": "f4542973644b",
      "text": "beberapa kaki menarik berlawanan arah, ke arah badannya."
    },
    "p147": {
      "source_hash": "d3e93522446f",
      "text": "Mungkin begitulah tiap bulu tetap tertarik,"
    },
    "p148": {
      "source_hash": "ad3b652f6211",
      "text": "tak copot oleh berat."
    },
    "p149": {
      "source_hash": "7f05a63695bd",
      "text": "Ingat debu yang kutanya di awal?"
    },
    "p150": {
      "source_hash": "e23c0671159e",
      "text": "Ya!"
    },
    "p151": {
      "source_hash": "b81834149d82",
      "text": "Ibu bilang menggumpal!"
    },
    "p152": {
      "source_hash": "98db4480a6d3",
      "text": "Peneliti menaburkan bubuk halus di jari tokek,"
    },
    "p153": {
      "source_hash": "aa3333bebc7b",
      "text": "lalu ditekan ke kaca bersih."
    },
    "p154": {
      "source_hash": "29d7cd85caef",
      "text": "Kakinya"
    },
    "p155": {
      "source_hash": "9465c95a535b",
      "text": "jadi tak lengket?"
    },
    "p156": {
      "source_hash": "11d41830e1fe",
      "text": "Awalnya kurang. Tapi beberapa langkah saja,"
    },
    "p157": {
      "source_hash": "f8e1ffbbefb2",
      "text": "hampir bisa bertahan."
    },
    "p158": {
      "source_hash": "43a2df773971",
      "text": "Debunya ke mana?"
    },
    "p159": {
      "source_hash": "b89e2cea474e",
      "text": "Tinggal di kaca. Dugaannya,"
    },
    "p160": {
      "source_hash": "215c0c2f7f37",
      "text": "tarikan kaca ke butir debu lebih kuat dari tarikan lempeng."
    },
    "p161": {
      "source_hash": "0f49171fab9a",
      "text": "Ada studi cicak jalan di kaca,"
    },
    "p162": {
      "source_hash": "0ea55c4a83b6",
      "text": "jari yang menggulung dan yang ditahan:"
    },
    "p163": {
      "source_hash": "94e58a924752",
      "text": "gulung: 2 kali lebih cepat,"
    },
    "p164": {
      "source_hash": "0d3f4ebe6e84",
      "text": "kira-kira empat langkah, kembali ke 80% daya cengkeram."
    },
    "p165": {
      "source_hash": "c4bf4451ffd0",
      "text": "Stiker kotor tak lengket,"
    },
    "p166": {
      "source_hash": "22ca0eab0f7c",
      "text": "cicak lebih hebat?"
    },
    "p167": {
      "source_hash": "7433567a1c87",
      "text": "Ya, di sini dia menang."
    },
    "p168": {
      "source_hash": "feb097a3e6a8",
      "text": "Debu oke, tapi di satu tempat,"
    },
    "p169": {
      "source_hash": "4f85f8c66703",
      "text": "ia tergelincir."
    },
    "p170": {
      "source_hash": "44001c0c494b",
      "text": "Tempat yang susah?"
    },
    "p171": {
      "source_hash": "f2fa2498fad8",
      "text": "Di mana, sih?"
    },
    "p172": {
      "source_hash": "b8f3d24cf5c7",
      "text": "Di dapur. Lapisan licin wajan antilengket"
    },
    "p173": {
      "source_hash": "4b503bb2f6e9",
      "text": "sering terbuat dari teflon."
    },
    "p174": {
      "source_hash": "add2ff9d95f0",
      "text": "Tokek mencengkeram teflon kering,"
    },
    "p175": {
      "source_hash": "cd5f012a39ca",
      "text": "lalu ditarik pelan, tokek pun tergelincir."
    },
    "p176": {
      "source_hash": "1dc7dd27983f",
      "text": "Sampai tergelincir!"
    },
    "p177": {
      "source_hash": "f3de6671d7c9",
      "text": "Permukaan ini istimewa:"
    },
    "p178": {
      "source_hash": "e82f6f12a19f",
      "text": "di sini gaya van der Waals sulit muncul."
    },
    "p179": {
      "source_hash": "f9e60c6933a5",
      "text": "Kalau dibasahi,"
    },
    "p180": {
      "source_hash": "192b28954c99",
      "text": "pasti makin licin!"
    },
    "p181": {
      "source_hash": "864dfb8ed542",
      "text": "Anehnya, teflon direndam air,"
    },
    "p182": {
      "source_hash": "69914647276d",
      "text": "malah berlipat lebih kuat."
    },
    "p183": {
      "source_hash": "b1395cd48349",
      "text": "Kenapa?"
    },
    "p184": {
      "source_hash": "04bca1957ab2",
      "text": "Katanya, ini soal tarikan air dan permukaan;"
    },
    "p185": {
      "source_hash": "56ac1b225447",
      "text": "bisa dihitung kasar, belum paham penuh."
    },
    "p186": {
      "source_hash": "d72bb8b94753",
      "text": "Di kaca biasa, terbalik."
    },
    "p187": {
      "source_hash": "f06b7e71e1fa",
      "text": "Basah, lebih dari separuh hilang."
    },
    "p188": {
      "source_hash": "aae1c2091aba",
      "text": "Kebalikan dari teflon!"
    },
    "p189": {
      "source_hash": "30b5f55d2254",
      "text": "Jadi saat hujan,"
    },
    "p190": {
      "source_hash": "9efe3afaf220",
      "text": "susah memanjat?"
    },
    "p191": {
      "source_hash": "e639b8e0218c",
      "text": "Mungkin. Peneliti mengingatkan,"
    },
    "p192": {
      "source_hash": "30f72a5270c9",
      "text": "bagi cicak di tempat panas lembap, air bisa jadi masalah."
    },
    "p193": {
      "source_hash": "7730156ef7fd",
      "text": "Kering,"
    },
    "p194": {
      "source_hash": "bfc9861c15bf",
      "text": "dindingnya berbutir halus?"
    },
    "p195": {
      "source_hash": "f55615f4b567",
      "text": "lebih lengket, kan?"
    },
    "p196": {
      "source_hash": "2d0c5a6a8acf",
      "text": "Belum tentu. Ingat dinding seperti bukit kecil?"
    },
    "p197": {
      "source_hash": "f37a1d63fc7d",
      "text": "Ternyata, bukit kecil yang sangat halus"
    },
    "p198": {
      "source_hash": "35e91f1df02d",
      "text": "malah terburuk, kalah dari rata dan kasar."
    },
    "p199": {
      "source_hash": "ee7613925b2d",
      "text": "Kenapa begitu, peneliti belum sepenuhnya paham."
    },
    "p200": {
      "source_hash": "08a45c80ed2d",
      "text": "Ingat soal cicak di plafonmu?"
    },
    "p201": {
      "source_hash": "c88d370a4ddf",
      "text": "Di rumah, umumnya jenis cicak yang lebih kecil."
    },
    "p202": {
      "source_hash": "050696c2c715",
      "text": "Juga punya barisan kulit."
    },
    "p203": {
      "source_hash": "91865ad91634",
      "text": "Tapi percobaan tadi kebanyakan pakai tokek."
    },
    "p204": {
      "source_hash": "bfd1a4900911",
      "text": "Jadi jenis lain"
    },
    "p205": {
      "source_hash": "42abda77886d",
      "text": "belum tentu sama?"
    },
    "p206": {
      "source_hash": "fda9d0358e79",
      "text": "Angka bisa beda."
    },
    "p207": {
      "source_hash": "59977878bfc9",
      "text": "Tak semua cicak punya barisan kulit itu."
    },
    "p208": {
      "source_hash": "151e362dcee8",
      "text": "Satu jenis tanpa barisan itu tak bisa naik kaca licin."
    },
    "p209": {
      "source_hash": "84dac165698c",
      "text": "Yang punya barisan itu,"
    },
    "p210": {
      "source_hash": "4d1fdee5375f",
      "text": "pakai jurus yang sama. Wen, bisa pecahkan kasusnya?"
    },
    "p211": {
      "source_hash": "dbca91e664e3",
      "text": "Oh"
    },
    "p212": {
      "source_hash": "49878429f338",
      "text": "Bukan lengket,"
    },
    "p213": {
      "source_hash": "58b29e7b10dd",
      "text": "tapi digulung, langsung lepas!"
    },
    "p214": {
      "source_hash": "27f61f030db2",
      "text": "Tepat, itu juga yang paling kukagumi."
    },
    "p215": {
      "source_hash": "9310e3691dd7",
      "text": "Ingat cicak yang 15 kali sedetik?"
    },
    "p216": {
      "source_hash": "a7f0cee5b09c",
      "text": "Tiap langkah, ia melepas."
    },
    "p217": {
      "source_hash": "7ce13429f019",
      "text": "Ketemu cicak,"
    },
    "p218": {
      "source_hash": "8c20dd15d265",
      "text": "lihat saja, jangan tangkap, dia kaget."
    },
    "p219": {
      "source_hash": "fb8d312308b4",
      "text": "Amati kakinya,"
    },
    "p220": {
      "source_hash": "80ec2b03e578",
      "text": "apa jarinya menggulung dulu?"
    },
    "p221": {
      "source_hash": "36d742bcb996",
      "text": "Oh, begitu!"
    },
    "p222": {
      "source_hash": "044de06fec9c",
      "text": "Cicakmu suka di mana?"
    },
    "p223": {
      "source_hash": "fe508e80b52e",
      "text": "Komentar ya!"
    },
    "p224": {
      "source_hash": "88de677d4daa",
      "text": "Yuk cari 'kenapa' sehari-hari, subscribe Kantor Oh Begitu."
    }
  }
}
