    "thumbnail": "a7a786a12930"
  },
  "lines": {
    "w001": {
      "source_hash": "2e860e9052fe",
      "text": "동네 인형뽑기가 미국선 도박기였죠."
    },
    "w002": {
      "source_hash": "ea02e47a3cc2",
      "text": "옛 업자 증언엔 FBI가 해머로 부쉈다고 해요."
    },
    "w003": {
      "source_hash": "54e8087684c2",
      "text": "1951년 법에 막혔죠."
    },
    "w004": {
      "source_hash": "2a497aa158a8",
      "text": "상식적으론 금지령에 사라졌어야 했죠."
    },
    "w005": {
      "source_hash": "30cdb3919874",
      "text": "그런데 일본선 연 4천억 엔 넘게 벌어들여요."
    },
    "w006": {
      "source_hash": "c9973ca00157",
      "text": "일본 오락실 매출 7할 가까이 차지했죠."
    },
    "w007": {
      "source_hash": "d354c3ca92b2",
      "text": "대만에선 24시간 무인매장이 넘쳐나요."
    },
    "w008": {
      "source_hash": "a401b605169f",
      "text": "매장주가 기계를 재임대까지 해요."
    },
    "w009": {
      "source_hash": "e478f40dd1bd",
      "text": "규제 속 반전 비결을 살펴볼까요?"
    },
    "w010": {
      "source_hash": "0b3d878f1493",
      "text": "처음부터 인형을 뽑았을까요?"
    },
    "w011": {
      "source_hash": "4d68a59c5557",
      "text": "원랜 집게가 아니라 미니 굴삭기였어요."
    },
    "w012": {
      "source_hash": "3e5163ff54c8",
      "text": "파나마 운하 덕에 굴삭기가 대유행했죠."
    },
    "w013": {
      "source_hash": "7a1578185d93",
      "text": "1918년 브루클린서 나왔죠."
    },
    "w014": {
      "source_hash": "939bdeaaf6c8",
      "text": "8년 뒤 시카고 전시에 목재함이 떴죠."
    },
    "w015": {
      "source_hash": "1528b435d525",
      "text": "1센트 넣고 핸들 돌려 사탕을 펐어요."
    },
    "w016": {
      "source_hash": "29c9a8edda0a",
      "text": "수동 굴삭기 열풍이 30년대 미국을 휩쓸었죠."
    },
    "w017": {
      "source_hash": "3325bb9eb6c2",
      "text": "하지만 전동 업그레이드가 화근이 됐어요."
    },
    "w018": {
      "source_hash": "8f18a0bc5089",
      "text": "1932년 전동 모터가 달렸죠."
    },
    "w019": {
      "source_hash": "f77963e845dc",
      "text": "Miami Digger가 판을 바꿨죠."
    },
    "w020": {
      "source_hash": "f50e8846ad7b",
      "text": "5센트 넣으면 겨눌 시간 몇 초죠."
    },
    "w021": {
      "source_hash": "f1797dd33100",
      "text": "시간 되면 자동 하강, 운 싸움이죠."
    },
    "w022": {
      "source_hash": "230bdb1c2e79",
      "text": "게다가 기계 안 경품도 변질되기 시작했죠."
    },
    "w023": {
      "source_hash": "4bbaa221a082",
      "text": "사탕 대신 옥수수 밑에 은화·시계를 묻었죠."
    },
    "w024": {
      "source_hash": "daaeef5c0f19",
      "text": "5센트로 명품 시계면 못 참죠."
    },
    "w025": {
      "source_hash": "91120c58bd21",
      "text": "장사는 대박, 하지만 정부가 노렸죠."
    },
    "w026": {
      "source_hash": "1fbe882e7b80",
      "text": "동전 넣고 운으로 따니 슬롯머신과 같았죠."
    },
    "w027": {
      "source_hash": "761d639e6f85",
      "text": "1951년 1월 2일 존슨법이 통과됐죠."
    },
    "w028": {
      "source_hash": "44d80a0429ca",
      "text": "운빨 동전 기계의 타주 운송이 금지됐죠."
    },
    "w029": {
      "source_hash": "dbb9e2fb8e5b",
      "text": "어기면 5천 달러 벌금, 징역 2년에 몰수였어요."
    },
    "w030": {
      "source_hash": "5c694bb70c49",
      "text": "시행되자마자 FBI가 해머로 기계를 부쉈죠."
    },
    "w031": {
      "source_hash": "39b53ff0d624",
      "text": "압수한 기계는 부숴서 불태워 버렸어요."
    },
    "w032": {
      "source_hash": "1c2769096132",
      "text": "20년 누린 기계가 하루아침에 금제품이죠."
    },
    "w033": {
      "source_hash": "ca2761d44b21",
      "text": "미국 업체들은 어떻게 살아남으려 했을까요?"
    },
    "w034": {
      "source_hash": "1c9ffa73c150",
      "text": "1956년 Chicago Coin은 출구 막았죠."
    },
    "w035": {
      "source_hash": "2c1624743930",
      "text": "점수만 내고 경품이 없으니 누가 하겠어요?"
    },
    "w036": {
      "source_hash": "d3e92fca7c21",
      "text": "동전구를 떼고 수동 통전으로 뚫었죠."
    },
    "w037": {
      "source_hash": "324410f01ba3",
      "text": "1962년 개정법이 무동전도 막았어요."
    },
    "w038": {
      "source_hash": "383811052ed5",
      "text": "그래도 법 한쪽에 좁은 틈이 남았죠."
    },
    "w039": {
      "source_hash": "d9baef5f98a2",
      "text": "동전 없이 수동, 카니발 한정이면 합법이었죠."
    },
    "w040": {
      "source_hash": "e2fa9dac20c1",
      "text": "동전 구멍 없는데 카니발서 돈을 어떻게 받죠?"
    },
    "w041": {
      "source_hash": "467a52b69a87",
      "text": "직원이 직접 10센트를 받았대요."
    },
    "w042": {
      "source_hash": "09418e814193",
      "text": "줄 당겨 레버 풀고 경품은 1달러 이하로요."
    },
    "w043": {
      "source_hash": "034d63ab2ce3",
      "text": "이 투박한 꼼수로 겨우 버텼죠."
    },
    "w044": {
      "source_hash": "1621f7e673bb",
      "text": "축제에 갇힌 수동 기계는 못 컸죠."
    },
    "w045": {
      "source_hash": "ddead55aeb04",
      "text": "20년 뒤 어떻게 핑크 옷 입고 떴을까요?"
    },
    "w046": {
      "source_hash": "75e52be3726e",
      "text": "미국서 막힌 뒤 70년대 말 일본에 갔죠."
    },
    "w047": {
      "source_hash": "c9241c45d7ee",
      "text": "삽 대신 상단 레일 집게로 인형을 짚었죠."
    },
    "w048": {
      "source_hash": "2e0b567c8058",
      "text": "오락실이 어두워 여성·아이가 꺼렸죠."
    },
    "w049": {
      "source_hash": "8c4ff118915a",
      "text": "어떻게 끌까? 1985년 반전 왔죠."
    },
    "w050": {
      "source_hash": "95ea3f80c41f",
      "text": "Sega가 1대 UFO Catcher 냈죠."
    },
    "w051": {
      "source_hash": "2d7f36eb71b1",
      "text": "정반대로 여성과 아이를 정조준했죠."
    },
    "w052": {
      "source_hash": "36c3eb11107b",
      "text": "핑크 쇼윈도 기계를 입구에 세웠어요."
    },
    "w053": {
      "source_hash": "a746131f722f",
      "text": "더 영리한 건 조작을 두 단계로 줄인 거죠."
    },
    "w054": {
      "source_hash": "a914b899eb4e",
      "text": "가로 이동 뒤 하강, 3초면 바로 해요."
    },
    "w055": {
      "source_hash": "8cd8eec5d6e3",
      "text": "오락실 이미지를 바꾸며 인형 붐이 일었죠."
    },
    "w056": {
      "source_hash": "9452fbaf8979",
      "text": "90년대 경마 열풍에 명마 인형이 불티났죠."
    },
    "w057": {
      "source_hash": "5843a1100282",
      "text": "한정 인형 뽑으려 줄이 늘어서고 매장이 꽉 찼죠."
    },
    "w058": {
      "source_hash": "c1e8aab16343",
      "text": "그런데 일본도 도박 규제가 엄청 엄격해요."
    },
    "w059": {
      "source_hash": "760fdad854bf",
      "text": "이 핑크 기계는 어떻게 규제를 제국으로 바꿨죠?"
    },
    "w060": {
      "source_hash": "4df9f1442446",
      "text": "답은 일본 풍영법 기준에 숨어 있어요."
    },
    "w061": {
      "source_hash": "a64aaba835c0",
      "text": "현금 교환은 금지, 저가 소품만 뽑게 했죠."
    },
    "w062": {
      "source_hash": "93025804258a",
      "text": "800엔이 2022년 천 엔 됐죠."
    },
    "w063": {
      "source_hash": "4595efc68717",
      "text": "이 낮은 상한선으로 어떻게 끌었을까요?"
    },
    "w064": {
      "source_hash": "e71d17796002",
      "text": "일본 업체들이 규제를 최강의 해자로 바꿨어요."
    },
    "w065": {
      "source_hash": "7ecb989660f1",
      "text": "시판품은 가격표가 있어 안 팔았죠."
    },
    "w066": {
      "source_hash": "d4dae725d724",
      "text": "오락실 전용 비매품 경품을 따로 찍어냈어요."
    },
    "w067": {
      "source_hash": "19f7c592e07b",
      "text": "도매가는 전부 법정 상한선 안에 맞췄죠."
    },
    "w068": {
      "source_hash": "b29a7b1ceb21",
      "text": "바로 가져가니 합법에 희소성도 챙겼죠."
    },
    "w069": {
      "source_hash": "9077ea466db2",
      "text": "어디서도 못 사니 비교 못 하죠."
    },
    "w112": {
      "source_hash": "10611969b11e",
      "text": "합법 원가 안에서 독점 디자인에 올인했죠."
    },
    "w113": {
      "source_hash": "665f58cd985d",
      "text": "비매품 한정이 행인을 수집가로 만들었죠."
    },
    "w114": {
      "source_hash": "9d1a2fdf5f47",
      "text": "경품 살리려 7세대 UFO Catcher는 흰색으로요."
    },
    "w115": {
      "source_hash": "536447e5ca52",
      "text": "밝은 매장과 수집 붐, 얼마나 벌죠?"
    },
    "w070": {
      "source_hash": "f3b8eb3478b9",
      "text": "앞에 말한 4천억 엔대, 답은 여기죠."
    },
    "w071": {
      "source_hash": "ec8315d0c8ae",
      "text": "일본 JAIA가 놀라운 실적을 공개했어요."
    },
    "w072": {
      "source_hash": "1d6ce65362b0",
      "text": "2024년 오락실 매출은 6,148억 엔."
    },
    "w073": {
      "source_hash": "ab93f872aefd",
      "text": "경품이 4,177억 엔, 정확히 68퍼센트예요."
    },
    "w074": {
      "source_hash": "2a9fe92e82dc",
      "text": "전국 설치만 25만 8,900대 넘죠."
    },
    "w075": {
      "source_hash": "890fe6848196",
      "text": "모바일에 밀린 오락실을 뽑기가 살린 거죠."
    },
    "w076": {
      "source_hash": "767eb14d4dad",
      "text": "그런데 대만엔 경품 대기업이 없죠."
    },
    "w077": {
      "source_hash": "e62b6487b759",
      "text": "어째서 무인매장과 기계주가 넘쳐날까요?"
    },
    "w078": {
      "source_hash": "6144ba2c2d48",
      "text": "맞아요, 대만의 세 번째 길도 법에 숨어 있어요."
    },
    "w079": {
      "source_hash": "8b2dfa5667d7",
      "text": "대만서 오락실 열려면 면허가 까다롭죠."
    },
    "w080": {
      "source_hash": "5a4227010182",
      "text": "경제부 자판기 규정이 새 길을 열었죠."
    },
    "w081": {
      "source_hash": "6c7e5a6efeaf",
      "text": "보장뽑기 심사 통과하면 오락기가 아니에요."
    },
    "w082": {
      "source_hash": "886568d79ce0",
      "text": "일정액 넣으면 무조건 뽑히고 누적액 안 사라져요."
    },
    "w083": {
      "source_hash": "f609d968ef76",
      "text": "현행 상한은 대만 990달러로 정해졌죠."
    },
    "w084": {
      "source_hash": "b70b8bbc4311",
      "text": "심사받으면 자판기라 면허가 필요 없죠."
    },
    "w085": {
      "source_hash": "2258ac5fea79",
      "text": "임대료도 비싼데 어째서 폭증했을까요?"
    },
    "w086": {
      "source_hash": "9134239d5857",
      "text": "대만은 이 규정으로 2층 임대 짰죠."
    },
    "w087": {
      "source_hash": "630dd79d7712",
      "text": "경제부 규정이 매장주와 기계주를 나눴어요."
    },
    "w088": {
      "source_hash": "209e68cce4a6",
      "text": "교환기와 CCTV만 두면 직원 필요 없죠."
    },
    "w089": {
      "source_hash": "14fb50909ddc",
      "text": "직장인도 퇴근길에 채우고 수금해요."
    },
    "w090": {
      "source_hash": "87b05ffbb378",
      "text": "매장에 매장주·기계주 정보를 붙여요."
    },
    "w091": {
      "source_hash": "165f28fd8989",
      "text": "CCTV 안내와 연락처도 규정이죠."
    },
    "w092": {
      "source_hash": "a43b1a7f2d46",
      "text": "앞에 말한 재임대 모델, 매장주가 기계 빌려줘요."
    },
    "w093": {
      "source_hash": "7a32d9115d80",
      "text": "기계주가 채우고 매장주는 월세 받아요."
    },
    "w094": {
      "source_hash": "41055a13e069",
      "text": "잠깐, 기계주가 쉽게 벌진 못해요."
    },
    "w095": {
      "source_hash": "6d7447f4b6f5",
      "text": "매장이 넘치자 불법 개조가 판쳤죠."
    },
    "w116": {
      "source_hash": "a92aca236d5a",
      "text": "칸막이·튕김망에 자석·주사위까지 달았죠."
    },
    "w117": {
      "source_hash": "47cba5b0d1ec",
      "text": "금지 경품까지 넣는데, 법은 뭘 막았을까요?"
    },
    "w096": {
      "source_hash": "0ae145bb1fc1",
      "text": "현금·복주머니·뽑기판, 현금 매입 금지죠."
    },
    "w097": {
      "source_hash": "dbb2997b94f8",
      "text": "초기화나 위반 시 불법으로 처벌받죠."
    },
    "w098": {
      "source_hash": "46593e2bdfab",
      "text": "거품 꺼지고 단속에 초보가 빠졌죠."
    },
    "w099": {
      "source_hash": "83289f8c6681",
      "text": "남은 건 불로소득 아닌 선별 소매전이에요."
    },
    "w118": {
      "source_hash": "09465c169999",
      "text": "남은 기계주는 과자·잡화 제값에 팔죠."
    },
    "w119": {
      "source_hash": "cae2f0e423f1",
      "text": "꼼수 대신 납득할 가치로 불황을 버텨냈어요."
    },
    "w100": {
      "source_hash": "ccf946a843fa",
      "text": "미국·일본·대만을 나란히 보면 패턴이 뚜렷해요."
    },
    "w101": {
      "source_hash": "92b1e643d10a",
      "text": "세 번의 백 년 변신, 무슨 논리죠?"
    },
    "w102": {
      "source_hash": "cf6f495e7d59",
      "text": "법은 장사를 죽이기만 하지 않아요."
    },
    "w103": {
      "source_hash": "5deb8ac64e39",
      "text": "어떤 종으로 진화할지도 결정하죠."
    },
    "w104": {
      "source_hash": "510a51234e7c",
      "text": "규제에 몰리면 재미가 아닌 걸 바꿨죠."
    },
    "w105": {
      "source_hash": "2ed3682ffede",
      "text": "운빨 도박을 합법 거래로 바꾼 거죠."
    },
    "w106": {
      "source_hash": "7dd59700b618",
      "text": "자동 막으면 수동, 단가는요?"
    },
    "w107": {
      "source_hash": "ea6b6a159ac2",
      "text": "독점 경품, 보장뽑기론 소매 임대로요."
    },
    "w108": {
      "source_hash": "f819cdb90ef3",
      "text": "다음에 동전 쥐고 지날 때 보장뽑기를 보세요."
    },
    "w109": {
      "source_hash": "d2b36b3e6f92",
      "text": "이 무해한 집게는 백 년 법규의 살아있는 화석이죠."
    },
    "w110": {
      "source_hash": "f4f43b0df4bb",
      "text": "얼마까지 써 봤나요? 댓글로요!"
    },
    "w111": {
      "source_hash": "1c4024276e29",
      "text": "일상 규칙, 기문파일국 구독!"
    }
  }
}
