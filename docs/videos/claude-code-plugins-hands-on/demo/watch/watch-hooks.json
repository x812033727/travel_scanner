{
  "hooks": {
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "PostToolUse": [
      { "matcher": "Agent|Task",
        "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ],
    "InstructionsLoaded": [
      { "hooks": [ { "type": "command", "command": "node",
        "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/seen.mjs"] } ] }
    ]
  }
}
