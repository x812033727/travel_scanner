{
  "zq40a01": {
    "text": "Primero, preguntas.",
    "emotion": "站到刁七和村民之間，一隻手橫出去",
    "say": "Preguntas."
  },
  "zq40a02": {
    "text": "Bandidos,",
    "emotion": "尖聲",
    "say": "Bandido,"
  },
  "zq40a03": {
    "text": "¡mátenlo y ya!",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "Cuentas, después.",
    "emotion": "很穩",
    "say": "Después."
  },
  "zq40a05": {
    "text": "Cuatrocientos no vienen porque sí.",
    "emotion": "看向刁七",
    "say": "Cuatrocientos vienen por algo."
  },
  "zq40a06": {
    "text": "Mátenme y ya.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "Hermano Xu,",
    "emotion": "大嗓門",
    "say": "¡Xu!"
  },
  "zq40a08": {
    "text": "¡quemó nuestro canal!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "Misión oculta:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "saber por qué vinieron a Liuxi.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "Al granero.",
    "emotion": "蒼老，有分量",
    "say": "Al silo."
  },
  "zq40a12": {
    "text": "Que primero pregunte el señor Xu.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "Anda.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "Que no hable.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "Cuatrocientos,",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "¿por qué Liuxi?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "Liuxi es pobre,",
    "emotion": "畫外，慢慢說",
    "say": "Es pobre,"
  },
  "zq40a18": {
    "text": "no tiene ni grano.",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "¿Valía el viaje?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "No sé.",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "Mátame, y no sé.",
    "emotion": "粗啞，威脅",
    "say": "Ni muerto sé."
  },
  "zq40a22": {
    "text": "Está esperando.",
    "emotion": "直接",
    "say": "Espera."
  },
  "zq40a23": {
    "text": "Que vengan por él.",
    "emotion": "眼神冷"
  },
  "zq40a24": {
    "text": "Pues esperemos.",
    "emotion": "笑了一下",
    "say": "Espera."
  },
  "zq40a25": {
    "text": "A ver quién viene.",
    "emotion": "設局",
    "say": "A ver quién."
  },
  "zq40a26": {
    "text": "Un bandido en el pueblo,",
    "emotion": "假好心",
    "say": "Un bandido aquí,"
  },
  "zq40a27": {
    "text": "¿quién duerme?",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "Yo duermo.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "¿De don Qian?",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "Bueno.",
    "emotion": "憨笑",
    "say": "Bueno,"
  },
  "zq40a31": {
    "text": "Lo acepto.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "¡Hermano Xu!",
    "emotion": "大吼",
    "say": "¡Xu!"
  },
  "zq40a33": {
    "text": "¡Atrapé a uno!",
    "emotion": "得意",
    "say": "¡Cacé uno!"
  },
  "zq40a34": {
    "text": "¿La conoces?",
    "emotion": "舉著鑰匙",
    "say": "¿Te suena?"
  },
  "zq40a35": {
    "text": "Regalo de don Qian.",
    "emotion": "畫外，平靜",
    "say": "De don Qian."
  },
  "zq40a36": {
    "text": "La llave del granero.",
    "emotion": "畫外",
    "say": "La del granero."
  },
  "zq40a37": {
    "text": "¿Me va a soltar?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "Don Qian te quiere callado.",
    "emotion": "冷，短促",
    "say": "Don Qian te quiere mudo."
  },
  "zq40a39": {
    "text": "Afuera,",
    "emotion": "淡淡的",
    "say": "Fuera."
  },
  "zq40a40": {
    "text": "te están esperando.",
    "emotion": "說破",
    "say": "te esperan."
  },
  "zq40a41": {
    "text": "Un peón…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "Soy un peón desechado.",
    "emotion": "明白了，苦",
    "say": "Soy un descarte."
  },
  "zq40a43": {
    "text": "Si quieres hablar,",
    "emotion": "不逼他"
  },
  "zq40a44": {
    "text": "estoy en el campo.",
    "emotion": "走出去",
    "say": "En el campo."
  },
  "zq40a45": {
    "text": "Hermano Xu,",
    "emotion": "憨笑",
    "say": "Hermano,"
  },
  "zq40a46": {
    "text": "¡esta espiga sí pesa!",
    "emotion": "大嗓門，得意",
    "say": "¡esta espiga pesa!"
  },
  "zq40a47": {
    "text": "Ni un grano se vende,",
    "emotion": "畫外，低聲",
    "say": "Ni un grano,"
  },
  "zq40a48": {
    "text": "todo es semilla.",
    "emotion": "畫外，很穩",
    "say": "es semilla."
  },
  "zq40a49": {
    "text": "¡Seis sacos por campo!",
    "emotion": "算完，尖叫",
    "say": "¡Seis sacos!"
  },
  "zq40a50": {
    "text": "¡El doble!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "Siega más rápido que Erniu.",
    "emotion": "爽快，帶笑",
    "say": "Más rápido que Erniu."
  },
  "zq40a52": {
    "text": "Es la semilla del año próximo.",
    "emotion": "笑得很開",
    "say": "Para sembrar."
  },
  "zq40a53": {
    "text": "Cosecha: rendimiento doble.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "Premio: selección de semillas.",
    "emotion": "平板電子音",
    "say": "Premio: elegir semillas."
  },
  "zq40a55": {
    "text": "Hay sequía,",
    "emotion": "牙縫裡擠出來",
    "say": "¿Sequía,"
  },
  "zq40a56": {
    "text": "¿y solo su campo está verde?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "La viga del santuario,",
    "emotion": "蒼老，大聲",
    "say": "La viga,"
  },
  "zq40a58": {
    "text": "¡el año próximo, en madera nueva!",
    "emotion": "宣布",
    "say": "¡el próximo año, madera nueva!"
  },
  "zq40a59": {
    "text": "Quien se quede,",
    "emotion": "溫和",
    "say": "Si se queda,"
  },
  "zq40a60": {
    "text": "es de Liuxi.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "Corazón del reino: dos por ciento.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "El del granero,",
    "emotion": "輕，淡",
    "say": "El preso,"
  },
  "zq40a63": {
    "text": "hoy no comió.",
    "emotion": "看向村子"
  },
  "zq40a64": {
    "text": "Llévale arroz nuevo.",
    "emotion": "點頭",
    "say": "Llévale arroz."
  },
  "zq40a65": {
    "text": "Arroz nuevo.",
    "emotion": "輕聲",
    "say": "Arroz."
  },
  "zq40a66": {
    "text": "¿De este año?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "De este año.",
    "emotion": "平靜",
    "say": "Este año."
  },
  "zq40a68": {
    "text": "Un plato por cabeza.",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "A-Ling, té.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "Alguien pagó cien taeles.",
    "emotion": "低，啞，終於開口",
    "say": "Pagaron cien taeles."
  },
  "zq40a71": {
    "text": "Para venir a Liuxi.",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "Para llevarse a esa,",
    "emotion": "抬頭，看向阿令",
    "say": "Y llevarse,"
  },
  "zq40a73": {
    "text": "mujer que no habla.",
    "emotion": "畫外，一字一字",
    "say": "a la que no habla."
  }
}
