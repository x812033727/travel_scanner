{
  "zq40a01": {
    "text": "Hỏi trước đã.",
    "emotion": "站到刁七和村民之間，一隻手橫出去"
  },
  "zq40a02": {
    "text": "Giặc cỏ,",
    "emotion": "尖聲",
    "say": "Giặc,"
  },
  "zq40a03": {
    "text": "giết đi là xong!",
    "emotion": "煽動，拖長音",
    "say": "giết đi!"
  },
  "zq40a04": {
    "text": "Rồi tính sổ.",
    "emotion": "很穩"
  },
  "zq40a05": {
    "text": "Bốn trăm người, không đến uổng công.",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "Muốn giết cứ giết.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "Hứa đại ca,",
    "emotion": "大嗓門"
  },
  "zq40a08": {
    "text": "hắn đốt đầu kênh của ta!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "Nhiệm vụ ẩn:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "hỏi xem vì sao giặc cỏ đến Liễu Khê.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "Giải về kho thóc.",
    "emotion": "蒼老，有分量"
  },
  "zq40a12": {
    "text": "Hứa tiên sinh hỏi xong hẵng hay.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "Đi.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "Không thể để hắn mở miệng.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "Bốn trăm người,",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "sao lại là Liễu Khê?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "Liễu Khê nghèo lắm,",
    "emotion": "畫外，慢慢說"
  },
  "zq40a18": {
    "text": "đến thóc cũng không có.",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "Đáng để ngươi đi một chuyến?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "Không biết.",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "Giết ta cũng không biết.",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "Hắn đang đợi.",
    "emotion": "直接",
    "say": "Đợi."
  },
  "zq40a23": {
    "text": "Đợi người đến cứu.",
    "emotion": "眼神冷"
  },
  "zq40a24": {
    "text": "Vậy thì đợi.",
    "emotion": "笑了一下",
    "say": "Cứ đợi."
  },
  "zq40a25": {
    "text": "Xem ai đến.",
    "emotion": "設局"
  },
  "zq40a26": {
    "text": "Giặc cỏ nhốt trong thôn,",
    "emotion": "假好心"
  },
  "zq40a27": {
    "text": "ai ngủ nổi?",
    "emotion": "拖長音",
    "say": "ai ngủ?"
  },
  "zq40a28": {
    "text": "Ta ngủ được.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "Của Tiền lão gia?",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "Được.",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "Nhận rồi.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "Hứa đại ca!",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "Bắt được một tên!",
    "emotion": "得意"
  },
  "zq40a34": {
    "text": "Nhận ra không?",
    "emotion": "舉著鑰匙",
    "say": "Biết không?"
  },
  "zq40a35": {
    "text": "Tiền viên ngoại tặng.",
    "emotion": "畫外，平靜",
    "say": "Tiền phủ tặng."
  },
  "zq40a36": {
    "text": "Chìa khóa kho thóc.",
    "emotion": "畫外"
  },
  "zq40a37": {
    "text": "Hắn muốn thả ta?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "Tiền viên ngoại muốn ngươi câm miệng.",
    "emotion": "冷，短促",
    "say": "Tiền viên ngoại muốn ngươi im."
  },
  "zq40a39": {
    "text": "Ngoài cửa,",
    "emotion": "淡淡的"
  },
  "zq40a40": {
    "text": "có người đợi ngươi.",
    "emotion": "說破"
  },
  "zq40a41": {
    "text": "Quân cờ bỏ…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "Ta là quân cờ bỏ.",
    "emotion": "明白了，苦",
    "say": "Ta, cờ bỏ."
  },
  "zq40a43": {
    "text": "Muốn nói thì,",
    "emotion": "不逼他"
  },
  "zq40a44": {
    "text": "ta ở ngoài ruộng.",
    "emotion": "走出去",
    "say": "ta ở ruộng."
  },
  "zq40a45": {
    "text": "Hứa đại ca,",
    "emotion": "憨笑"
  },
  "zq40a46": {
    "text": "bông này nặng lắm!",
    "emotion": "大嗓門，得意"
  },
  "zq40a47": {
    "text": "Một hạt không bán,",
    "emotion": "畫外，低聲"
  },
  "zq40a48": {
    "text": "giữ hết làm giống.",
    "emotion": "畫外，很穩",
    "say": "giữ làm giống."
  },
  "zq40a49": {
    "text": "Một mẫu sáu thạch!",
    "emotion": "算完，尖叫"
  },
  "zq40a50": {
    "text": "Gấp đôi rồi!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "Hắn gặt còn nhanh hơn Nhị Ngưu.",
    "emotion": "爽快，帶笑",
    "say": "Gặt nhanh hơn Nhị Ngưu."
  },
  "zq40a52": {
    "text": "Đây là giống năm sau.",
    "emotion": "笑得很開"
  },
  "zq40a53": {
    "text": "Kết toán mùa thu: sản lượng gấp đôi.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "Thưởng: phép chọn giống.",
    "emotion": "平板電子音"
  },
  "zq40a55": {
    "text": "Năm hạn,",
    "emotion": "牙縫裡擠出來"
  },
  "zq40a56": {
    "text": "chỉ ruộng hắn xanh?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "Xà từ đường,",
    "emotion": "蒼老，大聲"
  },
  "zq40a58": {
    "text": "năm sau trả bằng gỗ mới!",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "Người ở lại,",
    "emotion": "溫和"
  },
  "zq40a60": {
    "text": "đều là người Liễu Khê.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "Thiên hạ quy tâm, hai phần trăm.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "Kẻ trong kho thóc,",
    "emotion": "輕，淡",
    "say": "Kẻ trong kho,"
  },
  "zq40a63": {
    "text": "hôm nay chưa ăn.",
    "emotion": "看向村子"
  },
  "zq40a64": {
    "text": "Mang một bát gạo mới đi.",
    "emotion": "點頭"
  },
  "zq40a65": {
    "text": "Gạo mới.",
    "emotion": "輕聲"
  },
  "zq40a66": {
    "text": "Của năm nay?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "Của năm nay.",
    "emotion": "平靜"
  },
  "zq40a68": {
    "text": "Cả thôn mỗi người một bát.",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "A Lệnh, trà.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "Có người trả một trăm lượng.",
    "emotion": "低，啞，終於開口"
  },
  "zq40a71": {
    "text": "Bảo bọn ta đến thôn Liễu Khê.",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "Mang đi người đó,",
    "emotion": "抬頭，看向阿令",
    "say": "Mang đi,"
  },
  "zq40a73": {
    "text": "nữ nhân không nói.",
    "emotion": "畫外，一字一字"
  }
}
