{
  "zq40a01": {
    "text": "먼저 묻자.",
    "emotion": "站到刁七和村民之間，一隻手橫出去"
  },
  "zq40a02": {
    "text": "도적이오,",
    "emotion": "尖聲"
  },
  "zq40a03": {
    "text": "죽이면 그만이지!",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "따지는 건 나중에.",
    "emotion": "很穩",
    "say": "나중에."
  },
  "zq40a05": {
    "text": "사백 명, 이유가 있어.",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "죽이려면 죽여.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "쉬 형,",
    "emotion": "大嗓門",
    "say": "형!"
  },
  "zq40a08": {
    "text": "수로 입구를 태웠어!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "히든 미션:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "도적이 류시에 온 이유를 캐내라.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "곳간에 가둬라.",
    "emotion": "蒼老，有分量"
  },
  "zq40a12": {
    "text": "쉬 선생이 물은 뒤에 보세.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "걸어.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "입을 열게 하면 안 돼.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "사백 명,",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "왜 류시지?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "류시는 가난해,",
    "emotion": "畫外，慢慢說"
  },
  "zq40a18": {
    "text": "곡식도 없어.",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "올 만한 곳인가?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "몰라.",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "죽여도 몰라.",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "기다리는 거야.",
    "emotion": "直接",
    "say": "기다려."
  },
  "zq40a23": {
    "text": "구하러 올 사람을.",
    "emotion": "眼神冷",
    "say": "구해줄 사람을."
  },
  "zq40a24": {
    "text": "그럼 기다리지.",
    "emotion": "笑了一下",
    "say": "보자."
  },
  "zq40a25": {
    "text": "누가 오나.",
    "emotion": "設局"
  },
  "zq40a26": {
    "text": "도적을 가둬 두고,",
    "emotion": "假好心"
  },
  "zq40a27": {
    "text": "누가 잠을 자?",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "난 잘 자.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "첸 나리 거요?",
    "emotion": "畫外，慢慢問",
    "say": "첸 나리 거?"
  },
  "zq40a30": {
    "text": "좋소.",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "받았소.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "쉬 형!",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "하나 잡았어!",
    "emotion": "得意",
    "say": "잡았어!"
  },
  "zq40a34": {
    "text": "알아보겠어?",
    "emotion": "舉著鑰匙",
    "say": "알겠어?"
  },
  "zq40a35": {
    "text": "첸 나리 선물.",
    "emotion": "畫外，平靜"
  },
  "zq40a36": {
    "text": "곳간 열쇠야.",
    "emotion": "畫外"
  },
  "zq40a37": {
    "text": "날 풀어 주려고?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "첸 나리는 네 입을 막으려 해.",
    "emotion": "一字一字",
    "say": "네 입을 막으려는 거야."
  },
  "zq40a39": {
    "text": "문밖에,",
    "emotion": "淡淡的",
    "say": "밖에."
  },
  "zq40a40": {
    "text": "널 기다리는 자가 있어.",
    "emotion": "說破",
    "say": "널 기다려."
  },
  "zq40a41": {
    "text": "버리는 패…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "내가 버리는 패야.",
    "emotion": "明白了，苦",
    "say": "난 버린 패야."
  },
  "zq40a43": {
    "text": "말할 마음 들면,",
    "emotion": "不逼他",
    "say": "말할 거면,"
  },
  "zq40a44": {
    "text": "난 밭에 있어.",
    "emotion": "走出去",
    "say": "난 밭에."
  },
  "zq40a45": {
    "text": "쉬 형,",
    "emotion": "憨笑",
    "say": "형,"
  },
  "zq40a46": {
    "text": "이 이삭 묵직해!",
    "emotion": "大嗓門，得意"
  },
  "zq40a47": {
    "text": "한 톨도 안 팔아,",
    "emotion": "畫外，低聲",
    "say": "안 팔아,"
  },
  "zq40a48": {
    "text": "전부 씨앗이야.",
    "emotion": "畫外，很穩",
    "say": "전부 씨앗."
  },
  "zq40a49": {
    "text": "한 마지기 여섯 섬!",
    "emotion": "算完，尖叫",
    "say": "마지기 여섯 섬!"
  },
  "zq40a50": {
    "text": "두 배야!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "얼뉴보다 빨라.",
    "emotion": "爽快，帶笑"
  },
  "zq40a52": {
    "text": "내년 씨앗이야.",
    "emotion": "笑得很開",
    "say": "내년 씨."
  },
  "zq40a53": {
    "text": "추수 결산: 수확 두 배.",
    "emotion": "平板電子音，叮一聲",
    "say": "추수 결산: 두 배."
  },
  "zq40a54": {
    "text": "보상: 종자 선별법.",
    "emotion": "平板電子音",
    "say": "보상: 선별법."
  },
  "zq40a55": {
    "text": "가뭄에,",
    "emotion": "牙縫裡擠出來"
  },
  "zq40a56": {
    "text": "저놈 밭만 푸르다고?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "사당 대들보는,",
    "emotion": "蒼老，大聲"
  },
  "zq40a58": {
    "text": "내년에 새 나무로 갚네!",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "남는 이는,",
    "emotion": "溫和"
  },
  "zq40a60": {
    "text": "모두 류시 사람일세.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "천하귀심, 2%.",
    "emotion": "平板電子音，叮一聲",
    "say": "천하귀심, 이 퍼센트."
  },
  "zq40a62": {
    "text": "곳간의 그 사람,",
    "emotion": "輕，淡",
    "say": "그 사람,"
  },
  "zq40a63": {
    "text": "오늘 안 먹었어.",
    "emotion": "看向村子"
  },
  "zq40a64": {
    "text": "햅쌀 한 그릇 가져가자.",
    "emotion": "點頭",
    "say": "햅쌀 가져가자."
  },
  "zq40a65": {
    "text": "햅쌀이다.",
    "emotion": "輕聲",
    "say": "햅쌀."
  },
  "zq40a66": {
    "text": "올해 거냐?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "올해 거야.",
    "emotion": "平靜",
    "say": "올해 거."
  },
  "zq40a68": {
    "text": "온 마을 한 그릇씩.",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "아링, 차.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "누가 백 냥을 냈다.",
    "emotion": "低，啞，終於開口",
    "say": "누가 백 냥 냈다."
  },
  "zq40a71": {
    "text": "류시 마을로 가라고.",
    "emotion": "畫外，低",
    "say": "류시로 가라고."
  },
  "zq40a72": {
    "text": "데려오라고, 저,",
    "emotion": "抬頭，看向阿令",
    "say": "데려오라고,"
  },
  "zq40a73": {
    "text": "말 없는 여자를.",
    "emotion": "畫外，一字一字"
  }
}
