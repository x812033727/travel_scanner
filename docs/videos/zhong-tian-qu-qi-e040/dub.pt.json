{
  "zq40a01": {
    "text": "Primeiro, perguntas.",
    "emotion": "站到刁七和村民之間，一隻手橫出去",
    "say": "Perguntas."
  },
  "zq40a02": {
    "text": "Bandido,",
    "emotion": "尖聲"
  },
  "zq40a03": {
    "text": "é só matar!",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "Contas, depois.",
    "emotion": "很穩",
    "say": "Depois."
  },
  "zq40a05": {
    "text": "Quatrocentos não vêm à toa.",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "Mata logo.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "Irmão Xu,",
    "emotion": "大嗓門"
  },
  "zq40a08": {
    "text": "ele queimou o canal!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "Missão oculta:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "descobrir por que vieram a Liuxi.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "Pro celeiro.",
    "emotion": "蒼老，有分量"
  },
  "zq40a12": {
    "text": "Mestre Xu pergunta primeiro.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "Anda.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "Ele não pode falar.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "Quatrocentos,",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "por que Liuxi?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "Liuxi é pobre,",
    "emotion": "畫外，慢慢說",
    "say": "É pobre,"
  },
  "zq40a18": {
    "text": "nem grão tem.",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "Valeu a viagem?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "Não sei.",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "Nem morto eu sei.",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "Tá esperando.",
    "emotion": "直接",
    "say": "Espera."
  },
  "zq40a23": {
    "text": "Que venham salvar ele.",
    "emotion": "眼神冷",
    "say": "Que o salvem."
  },
  "zq40a24": {
    "text": "Então esperamos.",
    "emotion": "笑了一下",
    "say": "Calma."
  },
  "zq40a25": {
    "text": "Pra ver quem vem.",
    "emotion": "設局",
    "say": "Ver quem vem."
  },
  "zq40a26": {
    "text": "Bandido na vila,",
    "emotion": "假好心"
  },
  "zq40a27": {
    "text": "quem dorme?",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "Eu durmo.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "Do Senhor Qian?",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "Tá.",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "Aceito.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "Irmão Xu!",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "Peguei um!",
    "emotion": "得意"
  },
  "zq40a34": {
    "text": "Reconhece?",
    "emotion": "舉著鑰匙",
    "say": "Conhece?"
  },
  "zq40a35": {
    "text": "Presente do Senhor Qian.",
    "emotion": "畫外，平靜",
    "say": "Do Qian."
  },
  "zq40a36": {
    "text": "A chave do celeiro.",
    "emotion": "畫外",
    "say": "A do celeiro."
  },
  "zq40a37": {
    "text": "Ele vai me soltar?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "O Senhor Qian quer você calado.",
    "emotion": "冷，短促",
    "say": "O Qian quer você calado."
  },
  "zq40a39": {
    "text": "Lá fora,",
    "emotion": "淡淡的",
    "say": "Fora"
  },
  "zq40a40": {
    "text": "tem gente te esperando.",
    "emotion": "說破",
    "say": "te esperam."
  },
  "zq40a41": {
    "text": "Um peão…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "Sou peão descartado.",
    "emotion": "明白了，苦",
    "say": "Sou descartável."
  },
  "zq40a43": {
    "text": "Quando quiser falar,",
    "emotion": "不逼他",
    "say": "Se quer falar,"
  },
  "zq40a44": {
    "text": "tô na roça.",
    "emotion": "走出去"
  },
  "zq40a45": {
    "text": "Irmão Xu,",
    "emotion": "憨笑",
    "say": "Irmão,"
  },
  "zq40a46": {
    "text": "essa espiga pesa!",
    "emotion": "大嗓門，得意",
    "say": "pesada!"
  },
  "zq40a47": {
    "text": "Nem um grão à venda,",
    "emotion": "畫外，低聲",
    "say": "Nem um grão,"
  },
  "zq40a48": {
    "text": "tudo vira semente.",
    "emotion": "畫外，很穩",
    "say": "semente."
  },
  "zq40a49": {
    "text": "Seis sacas por campo!",
    "emotion": "算完，尖叫",
    "say": "Seis sacas!"
  },
  "zq40a50": {
    "text": "Dobrou!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "Ele corta mais que o Erniu.",
    "emotion": "爽快，帶笑",
    "say": "Mais que o Erniu."
  },
  "zq40a52": {
    "text": "É a semente do ano que vem.",
    "emotion": "笑得很開",
    "say": "Pra plantar."
  },
  "zq40a53": {
    "text": "Colheita: produção dobrada.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "Prêmio: seleção de sementes.",
    "emotion": "平板電子音",
    "say": "Prêmio: seleção."
  },
  "zq40a55": {
    "text": "Na seca,",
    "emotion": "牙縫裡擠出來"
  },
  "zq40a56": {
    "text": "só a roça dele é verde?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "A viga do santuário,",
    "emotion": "蒼老，大聲"
  },
  "zq40a58": {
    "text": "ano que vem, em madeira nova!",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "Quem ficar,",
    "emotion": "溫和"
  },
  "zq40a60": {
    "text": "é de Liuxi.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "O coração do reino: dois por cento.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "O do celeiro,",
    "emotion": "輕，淡",
    "say": "O preso,"
  },
  "zq40a63": {
    "text": "não comeu hoje.",
    "emotion": "看向村子"
  },
  "zq40a64": {
    "text": "Leva arroz novo.",
    "emotion": "點頭",
    "say": "Leva arroz."
  },
  "zq40a65": {
    "text": "Arroz novo.",
    "emotion": "輕聲",
    "say": "Arroz."
  },
  "zq40a66": {
    "text": "Desse ano?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "Desse ano.",
    "emotion": "平靜",
    "say": "Novo."
  },
  "zq40a68": {
    "text": "Uma tigela pra cada um.",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "A-Ling, chá.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "Pagaram cem taéis.",
    "emotion": "低，啞，終於開口",
    "say": "Foram cem taéis."
  },
  "zq40a71": {
    "text": "Pra virmos à Vila Liuxi.",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "Levar aquela,",
    "emotion": "抬頭，看向阿令",
    "say": "E levar,"
  },
  "zq40a73": {
    "text": "mulher que não fala.",
    "emotion": "畫外，一字一字",
    "say": "a que não fala."
  }
}
