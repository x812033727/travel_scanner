{
  "zq40a01": {
    "text": "Tanya dulu.",
    "emotion": "站到刁七和村民之間，一隻手橫出去"
  },
  "zq40a02": {
    "text": "Perampok,",
    "emotion": "尖聲"
  },
  "zq40a03": {
    "text": "bunuh saja!",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "Hitungan nanti.",
    "emotion": "很穩",
    "say": "Nanti."
  },
  "zq40a05": {
    "text": "Empat ratus orang, pasti ada sebab.",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "Bunuh saja.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "Kak Xu,",
    "emotion": "大嗓門"
  },
  "zq40a08": {
    "text": "dia bakar saluran kita!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "Misi rahasia:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "cari tahu kenapa mereka ke Liuxi.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "Bawa ke lumbung.",
    "emotion": "蒼老，有分量",
    "say": "Ke lumbung."
  },
  "zq40a12": {
    "text": "Biar Tuan Xu tanya dulu.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "Jalan.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "Jangan sampai bicara.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "Empat ratus orang,",
    "emotion": "平靜",
    "say": "Empat ratus,"
  },
  "zq40a16": {
    "text": "kenapa Liuxi?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "Liuxi miskin,",
    "emotion": "畫外，慢慢說"
  },
  "zq40a18": {
    "text": "beras pun tak ada.",
    "emotion": "畫外",
    "say": "beras tak ada."
  },
  "zq40a19": {
    "text": "Layak didatangi?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "Tak tahu.",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "Dibunuh pun tak tahu.",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "Dia menunggu.",
    "emotion": "直接",
    "say": "Tunggu."
  },
  "zq40a23": {
    "text": "Menunggu diselamatkan.",
    "emotion": "眼神冷"
  },
  "zq40a24": {
    "text": "Kita tunggu.",
    "emotion": "笑了一下",
    "say": "Tunggu,"
  },
  "zq40a25": {
    "text": "Lihat siapa datang.",
    "emotion": "設局",
    "say": "Siapa datang."
  },
  "zq40a26": {
    "text": "Perampok di desa,",
    "emotion": "假好心",
    "say": "Ada perampok,"
  },
  "zq40a27": {
    "text": "siapa bisa tidur?",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "Aku bisa.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "Dari Tuan Qian?",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "Baik.",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "Kuterima.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "Kak Xu!",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "Dapat satu!",
    "emotion": "得意",
    "say": "Dapat!"
  },
  "zq40a34": {
    "text": "Kenal ini?",
    "emotion": "舉著鑰匙",
    "say": "Kenal?"
  },
  "zq40a35": {
    "text": "Kiriman Tuan Qian.",
    "emotion": "畫外，平靜",
    "say": "Dari Tuan Qian."
  },
  "zq40a36": {
    "text": "Kunci lumbung.",
    "emotion": "畫外"
  },
  "zq40a37": {
    "text": "Dia mau lepaskan aku?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "Tuan Qian mau kau bungkam.",
    "emotion": "冷，短促"
  },
  "zq40a39": {
    "text": "Di luar,",
    "emotion": "淡淡的",
    "say": "Luar,"
  },
  "zq40a40": {
    "text": "ada yang menunggumu.",
    "emotion": "說破",
    "say": "kau ditunggu."
  },
  "zq40a41": {
    "text": "Bidak buangan…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "Aku bidak buangan.",
    "emotion": "明白了，苦"
  },
  "zq40a43": {
    "text": "Kalau mau bicara,",
    "emotion": "不逼他",
    "say": "Mau bicara,"
  },
  "zq40a44": {
    "text": "aku di sawah.",
    "emotion": "走出去",
    "say": "di sawah."
  },
  "zq40a45": {
    "text": "Kak Xu,",
    "emotion": "憨笑",
    "say": "Kak,"
  },
  "zq40a46": {
    "text": "bulirnya berat!",
    "emotion": "大嗓門，得意",
    "say": "berat!"
  },
  "zq40a47": {
    "text": "Tak dijual sebutir pun,",
    "emotion": "畫外，低聲",
    "say": "Tak dijual,"
  },
  "zq40a48": {
    "text": "semua jadi benih.",
    "emotion": "畫外，很穩",
    "say": "semua benih."
  },
  "zq40a49": {
    "text": "Enam karung per petak!",
    "emotion": "算完，尖叫",
    "say": "Enam karung!"
  },
  "zq40a50": {
    "text": "Dua kali lipat!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "Dia lebih cepat dari Erniu.",
    "emotion": "爽快，帶笑",
    "say": "Lebih cepat dari Erniu."
  },
  "zq40a52": {
    "text": "Ini benih tahun depan.",
    "emotion": "笑得很開",
    "say": "Benih tahun depan."
  },
  "zq40a53": {
    "text": "Hasil panen: dua kali lipat.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "Hadiah: teknik pilih benih.",
    "emotion": "平板電子音",
    "say": "Hadiah: pilih benih."
  },
  "zq40a55": {
    "text": "Musim kering,",
    "emotion": "牙縫裡擠出來"
  },
  "zq40a56": {
    "text": "cuma sawahnya yang hijau?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "Balok rumah leluhur,",
    "emotion": "蒼老，大聲",
    "say": "Balok,"
  },
  "zq40a58": {
    "text": "tahun depan diganti kayu baru!",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "Yang tinggal,",
    "emotion": "溫和",
    "say": "Tinggal,"
  },
  "zq40a60": {
    "text": "semua orang Liuxi.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "Rebut hati negeri: dua persen.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "Yang di lumbung,",
    "emotion": "輕，淡",
    "say": "Si tawanan,"
  },
  "zq40a63": {
    "text": "hari ini belum makan.",
    "emotion": "看向村子",
    "say": "belum makan."
  },
  "zq40a64": {
    "text": "Bawakan semangkuk beras baru.",
    "emotion": "點頭",
    "say": "Bawakan beras baru."
  },
  "zq40a65": {
    "text": "Beras baru.",
    "emotion": "輕聲"
  },
  "zq40a66": {
    "text": "Tahun ini?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "Tahun ini.",
    "emotion": "平靜"
  },
  "zq40a68": {
    "text": "Sedesa, semangkuk seorang.",
    "emotion": "包括他",
    "say": "Sedesa, semangkuk."
  },
  "zq40a69": {
    "text": "A-Ling, teh.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "Ada yang bayar seratus tael.",
    "emotion": "低，啞，終於開口",
    "say": "Upah seratus tael."
  },
  "zq40a71": {
    "text": "Suruh kami ke Desa Liuxi.",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "Bawa pergi,",
    "emotion": "抬頭，看向阿令"
  },
  "zq40a73": {
    "text": "perempuan yang tak bicara itu.",
    "emotion": "畫外，一字一字",
    "say": "perempuan bisu itu."
  }
}
