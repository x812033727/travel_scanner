{
  "zq40a01": {
    "text": "まず聞く。",
    "emotion": "站到刁七和村民之間，一隻手橫出去",
    "say": "聞くぞ。"
  },
  "zq40a02": {
    "text": "流賊だ、",
    "emotion": "尖聲",
    "say": "賊だ、"
  },
  "zq40a03": {
    "text": "殺してしまえ！",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "清算は後だ。",
    "emotion": "很穩",
    "say": "後で清算。"
  },
  "zq40a05": {
    "text": "四百人、理由がある。",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "殺せよ。",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "兄貴、",
    "emotion": "大嗓門"
  },
  "zq40a08": {
    "text": "水路の口を焼かれた！",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "隠し任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "流賊が柳渓に来た訳を問え。",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "穀倉へ戻せ。",
    "emotion": "蒼老，有分量"
  },
  "zq40a12": {
    "text": "シュー先生の後だ。",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "歩け。",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "口を割らせるな。",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "四百人、",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "なぜ柳渓だ？",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "柳渓は貧しい、",
    "emotion": "畫外，慢慢說"
  },
  "zq40a18": {
    "text": "米すらない。",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "来る価値が？",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "知らん。",
    "emotion": "吼"
  },
  "zq40a21": {
    "text": "殺されても知らん。",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "待ってる。",
    "emotion": "直接"
  },
  "zq40a23": {
    "text": "助けを待ってる。",
    "emotion": "眼神冷"
  },
  "zq40a24": {
    "text": "なら待とう。",
    "emotion": "笑了一下",
    "say": "待とう。"
  },
  "zq40a25": {
    "text": "誰が来るか。",
    "emotion": "設局"
  },
  "zq40a26": {
    "text": "流賊が村にいて、",
    "emotion": "假好心"
  },
  "zq40a27": {
    "text": "誰が眠れる？",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "私は眠れる。",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "チエン旦那の？",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "よし。",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "もらった。",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "兄貴！",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "一人捕まえた！",
    "emotion": "得意"
  },
  "zq40a34": {
    "text": "見覚えは？",
    "emotion": "舉著鑰匙"
  },
  "zq40a35": {
    "text": "チエン旦那の贈り物。",
    "emotion": "畫外，平靜",
    "say": "チエン旦那から。"
  },
  "zq40a36": {
    "text": "穀倉の鍵だ。",
    "emotion": "畫外"
  },
  "zq40a37": {
    "text": "俺を逃がす気か？",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "チエン旦那の狙いは口封じだ。",
    "emotion": "冷，短促",
    "say": "チエンは口封じだ。"
  },
  "zq40a39": {
    "text": "門の外で、",
    "emotion": "淡淡的",
    "say": "外、"
  },
  "zq40a40": {
    "text": "誰かが待ってる。",
    "emotion": "說破"
  },
  "zq40a41": {
    "text": "捨て駒……",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "俺は捨て駒か。",
    "emotion": "明白了，苦"
  },
  "zq40a43": {
    "text": "話す気になれば、",
    "emotion": "不逼他"
  },
  "zq40a44": {
    "text": "俺は田んぼだ。",
    "emotion": "走出去",
    "say": "田んぼだ。"
  },
  "zq40a45": {
    "text": "兄貴、",
    "emotion": "憨笑"
  },
  "zq40a46": {
    "text": "この穂、重いぞ！",
    "emotion": "大嗓門，得意"
  },
  "zq40a47": {
    "text": "一粒も売らない、",
    "emotion": "畫外，低聲",
    "say": "一粒も売らん、"
  },
  "zq40a48": {
    "text": "全部種だ。",
    "emotion": "畫外，很穩"
  },
  "zq40a49": {
    "text": "一畝で六石！",
    "emotion": "算完，尖叫",
    "say": "六石も！"
  },
  "zq40a50": {
    "text": "倍になった！",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "アーニウより速い。",
    "emotion": "爽快，帶笑"
  },
  "zq40a52": {
    "text": "来年の種だ。",
    "emotion": "笑得很開"
  },
  "zq40a53": {
    "text": "秋の収穫：収量倍増。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "報酬：選種法。",
    "emotion": "平板電子音"
  },
  "zq40a55": {
    "text": "日照りなのに、",
    "emotion": "牙縫裡擠出來",
    "say": "日照りで、"
  },
  "zq40a56": {
    "text": "奴の田だけ緑だと？",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "祠堂の梁は、",
    "emotion": "蒼老，大聲"
  },
  "zq40a58": {
    "text": "来年新しい木で返す！",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "残る者は、",
    "emotion": "溫和"
  },
  "zq40a60": {
    "text": "皆、柳渓の者だ。",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "天下帰心、二パーセント。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "穀倉の人、",
    "emotion": "輕，淡"
  },
  "zq40a63": {
    "text": "今日食べてない。",
    "emotion": "看向村子"
  },
  "zq40a64": {
    "text": "新米を持っていこう。",
    "emotion": "點頭",
    "say": "新米を一杯。"
  },
  "zq40a65": {
    "text": "新米だ。",
    "emotion": "輕聲"
  },
  "zq40a66": {
    "text": "今年のか？",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "今年のだ。",
    "emotion": "平靜",
    "say": "新米だ。"
  },
  "zq40a68": {
    "text": "村中、一人一杯。",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "アーリン、茶を。",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "百両出す者がいた。",
    "emotion": "低，啞，終於開口"
  },
  "zq40a71": {
    "text": "柳渓村へ行けと。",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "連れてこい、あの、",
    "emotion": "抬頭，看向阿令",
    "say": "連れてこい、"
  },
  "zq40a73": {
    "text": "口をきかぬ女を。",
    "emotion": "畫外，一字一字"
  }
}
