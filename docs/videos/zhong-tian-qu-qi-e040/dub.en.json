{
  "zq40a01": {
    "text": "Questions first.",
    "emotion": "站到刁七和村民之間，一隻手橫出去",
    "say": "Ask first."
  },
  "zq40a02": {
    "text": "Bandits,",
    "emotion": "尖聲"
  },
  "zq40a03": {
    "text": "just kill him!",
    "emotion": "煽動，拖長音"
  },
  "zq40a04": {
    "text": "Then the reckoning.",
    "emotion": "很穩",
    "say": "Then settle."
  },
  "zq40a05": {
    "text": "Four hundred men don't come for nothing.",
    "emotion": "看向刁七"
  },
  "zq40a06": {
    "text": "Kill me, then.",
    "emotion": "粗啞，不屑"
  },
  "zq40a07": {
    "text": "Brother Xu,",
    "emotion": "大嗓門"
  },
  "zq40a08": {
    "text": "he burned our canal head!",
    "emotion": "又氣又急"
  },
  "zq40a09": {
    "text": "Hidden mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a10": {
    "text": "learn why the bandits came to Liuxi.",
    "emotion": "平板電子音"
  },
  "zq40a11": {
    "text": "Back to the granary.",
    "emotion": "蒼老，有分量"
  },
  "zq40a12": {
    "text": "After Mr. Xu's done asking.",
    "emotion": "句句篤定"
  },
  "zq40a13": {
    "text": "Move.",
    "emotion": "俐落，不屑"
  },
  "zq40a14": {
    "text": "He mustn't talk.",
    "emotion": "壓低聲音，陰"
  },
  "zq40a15": {
    "text": "Four hundred men,",
    "emotion": "平靜"
  },
  "zq40a16": {
    "text": "why Liuxi?",
    "emotion": "問得很慢"
  },
  "zq40a17": {
    "text": "Liuxi's dirt poor,",
    "emotion": "畫外，慢慢說"
  },
  "zq40a18": {
    "text": "it hasn't even got grain.",
    "emotion": "畫外"
  },
  "zq40a19": {
    "text": "Worth your trip?",
    "emotion": "不急"
  },
  "zq40a20": {
    "text": "I don't know.",
    "emotion": "吼",
    "say": "Dunno!"
  },
  "zq40a21": {
    "text": "Kill me, I still don't know.",
    "emotion": "粗啞，威脅"
  },
  "zq40a22": {
    "text": "He's waiting.",
    "emotion": "直接",
    "say": "Waiting."
  },
  "zq40a23": {
    "text": "For someone to save him.",
    "emotion": "眼神冷"
  },
  "zq40a24": {
    "text": "Then we wait.",
    "emotion": "笑了一下",
    "say": "Wait."
  },
  "zq40a25": {
    "text": "See who comes.",
    "emotion": "設局"
  },
  "zq40a26": {
    "text": "A bandit locked in the village,",
    "emotion": "假好心"
  },
  "zq40a27": {
    "text": "who can sleep?",
    "emotion": "拖長音"
  },
  "zq40a28": {
    "text": "I can.",
    "emotion": "不屑，帶笑"
  },
  "zq40a29": {
    "text": "From Master Qian?",
    "emotion": "畫外，慢慢問"
  },
  "zq40a30": {
    "text": "Fine.",
    "emotion": "憨笑"
  },
  "zq40a31": {
    "text": "It's mine now.",
    "emotion": "笑容突然沒了"
  },
  "zq40a32": {
    "text": "Brother Xu!",
    "emotion": "大吼"
  },
  "zq40a33": {
    "text": "Got one!",
    "emotion": "得意"
  },
  "zq40a34": {
    "text": "Recognize this?",
    "emotion": "舉著鑰匙",
    "say": "Know this?"
  },
  "zq40a35": {
    "text": "A gift from Squire Qian.",
    "emotion": "畫外，平靜",
    "say": "From Squire Qian."
  },
  "zq40a36": {
    "text": "The granary key.",
    "emotion": "畫外"
  },
  "zq40a37": {
    "text": "He's setting me free?",
    "emotion": "粗啞，不信"
  },
  "zq40a38": {
    "text": "Squire Qian wants you silent.",
    "emotion": "一字一字"
  },
  "zq40a39": {
    "text": "Outside that door,",
    "emotion": "淡淡的",
    "say": "Outside,"
  },
  "zq40a40": {
    "text": "someone's waiting for you.",
    "emotion": "說破",
    "say": "someone waits."
  },
  "zq40a41": {
    "text": "A pawn…",
    "emotion": "笑得難聽"
  },
  "zq40a42": {
    "text": "I'm a thrown-away pawn.",
    "emotion": "明白了，苦",
    "say": "A throwaway pawn."
  },
  "zq40a43": {
    "text": "When you want to talk,",
    "emotion": "不逼他"
  },
  "zq40a44": {
    "text": "I'm in the fields.",
    "emotion": "走出去"
  },
  "zq40a45": {
    "text": "Brother Xu,",
    "emotion": "憨笑"
  },
  "zq40a46": {
    "text": "these ears are heavy!",
    "emotion": "大嗓門，得意",
    "say": "ears this heavy!"
  },
  "zq40a47": {
    "text": "Not one grain sold,",
    "emotion": "畫外，低聲",
    "say": "None sold,"
  },
  "zq40a48": {
    "text": "it's all seed.",
    "emotion": "畫外，很穩"
  },
  "zq40a49": {
    "text": "Six bushels an acre!",
    "emotion": "算完，尖叫",
    "say": "Six an acre!"
  },
  "zq40a50": {
    "text": "It's doubled!",
    "emotion": "得意"
  },
  "zq40a51": {
    "text": "He cuts faster than Erniu.",
    "emotion": "爽快，帶笑"
  },
  "zq40a52": {
    "text": "That's next year's seed.",
    "emotion": "笑得很開"
  },
  "zq40a53": {
    "text": "Harvest result: yield doubled.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a54": {
    "text": "Reward: seed selection.",
    "emotion": "平板電子音"
  },
  "zq40a55": {
    "text": "In a drought,",
    "emotion": "牙縫裡擠出來"
  },
  "zq40a56": {
    "text": "only his fields are green?",
    "emotion": "又氣又不信"
  },
  "zq40a57": {
    "text": "The ancestral hall beam,",
    "emotion": "蒼老，大聲",
    "say": "The hall beam,"
  },
  "zq40a58": {
    "text": "next year we repay in new wood!",
    "emotion": "宣布"
  },
  "zq40a59": {
    "text": "Those who stay,",
    "emotion": "溫和",
    "say": "Who stays,"
  },
  "zq40a60": {
    "text": "are all Liuxi folk.",
    "emotion": "篤定"
  },
  "zq40a61": {
    "text": "The realm's hearts: two percent.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq40a62": {
    "text": "The one in the granary,",
    "emotion": "輕，淡",
    "say": "The prisoner,"
  },
  "zq40a63": {
    "text": "hasn't eaten today.",
    "emotion": "看向村子",
    "say": "hasn't eaten."
  },
  "zq40a64": {
    "text": "Take him a bowl of new rice.",
    "emotion": "點頭"
  },
  "zq40a65": {
    "text": "New rice.",
    "emotion": "輕聲"
  },
  "zq40a66": {
    "text": "This year's?",
    "emotion": "啞"
  },
  "zq40a67": {
    "text": "This year's.",
    "emotion": "平靜"
  },
  "zq40a68": {
    "text": "One bowl each, the whole village.",
    "emotion": "包括他"
  },
  "zq40a69": {
    "text": "A-Ling, tea.",
    "emotion": "畫外，輕聲"
  },
  "zq40a70": {
    "text": "Someone paid a hundred taels.",
    "emotion": "低，啞，終於開口",
    "say": "Paid a hundred taels."
  },
  "zq40a71": {
    "text": "To send us to Liuxi.",
    "emotion": "畫外，低"
  },
  "zq40a72": {
    "text": "To take that,",
    "emotion": "抬頭，看向阿令"
  },
  "zq40a73": {
    "text": "woman who doesn't speak.",
    "emotion": "畫外，一字一字",
    "say": "woman who won't speak."
  }
}
