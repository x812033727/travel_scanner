    "thumbnail": "e212133db3f1"
  },
  "lines": {
    "t001": {
      "source_hash": "0df26256c9e7",
      "text": "두툼한 배낭여행 가이드북, 넘겨 본 적 있죠?"
    },
    "t002": {
      "source_hash": "5857f583ff89",
      "text": "BBC는 이 책을 낸 회사를 사려고 모두 약 1억 3천만 파운드를 냈습니다."
    },
    "t003": {
      "source_hash": "39415ad49f0e",
      "text": "1972년 크리스마스 다음 날, 젊은 부부가 시드니에 왔습니다. 남은 돈은 27센트."
    },
    "t004": {
      "source_hash": "181d1dcf5b32",
      "text": "1년 뒤, 부엌 식탁에서 첫 여행서를 철합니다."
    },
    "t005": {
      "source_hash": "da62ac0b31ff",
      "text": "이렇게 시작한 회사가 1억여 파운드?"
    },
    "t006": {
      "source_hash": "461752ed3598",
      "text": "창업자의 마지막 4분의 1, BBC는 훗날 얼마에 샀을까요?"
    },
    "t007": {
      "source_hash": "0eba28bf9953",
      "text": "BBC 자체 사이트도 한 결정을 내리죠."
    },
    "t008": {
      "source_hash": "0afbcbe61f65",
      "text": "이 파일에서 6년 치 장부를 하나씩 펼칩니다."
    },
    "t009": {
      "source_hash": "28a65163b7b5",
      "text": "이 1억 3천만 파운드로 결국 뭘 얻었나요?"
    },
    "t010": {
      "source_hash": "be5a4c481356",
      "text": "그보다 앞서 그해, 휠러 부부는 고물차를 사서 런던을 떠나,"
    },
    "t011": {
      "source_hash": "83fc4baecd32",
      "text": "갈 수 있는 데까지 동쪽으로 가자고요."
    },
    "t012": {
      "source_hash": "7208b771b10e",
      "text": "아프가니스탄, 인도, 태국을 거쳐 호주까지."
    },
    "t013": {
      "source_hash": "24a1ab5132a1",
      "text": "시드니에선 다들 물었죠. 어디 갔어? 어떻게?"
    },
    "t014": {
      "source_hash": "da3c45b05b13",
      "text": "그래서 답을 책으로 썼죠."
    },
    "t015": {
      "source_hash": "b31c51773e34",
      "text": "1973년, 처음 본 그 부엌 식탁에서 둘은 쓰면서 한 권씩 철했습니다."
    },
    "t016": {
      "source_hash": "c115fea730dc",
      "text": "제목은 '싼값에 아시아 횡단'이란 뜻, 100쪽도 안 됐죠."
    },
    "t017": {
      "source_hash": "fc2cc63e9878",
      "text": "손수 철한 이 작은 책, 첫 주에 몇 권 팔렸을까요?"
    },
    "t018": {
      "source_hash": "8281146eb3f5",
      "text": "1500권."
    },
    "t019": {
      "source_hash": "b7d9c8b5170b",
      "text": "처음엔 0이 하나 더 붙은 줄 알았어요."
    },
    "t020": {
      "source_hash": "b8d87c1b3521",
      "text": "1975년엔 동남아 편을 한 권 더 냈습니다."
    },
    "t021": {
      "source_hash": "499e293a1404",
      "text": "배낭족이 붙인 별명은?"
    },
    "t022": {
      "source_hash": "579b02c53298",
      "text": "별명은, '노란 성경'."
    },
    "t023": {
      "source_hash": "b10a427d271b",
      "text": "휠러는 책이 간 곳마다 사람이 따랐다고 했죠."
    },
    "t024": {
      "source_hash": "16f466744fe6",
      "text": "그 작은 책, 얼마나 커졌을까요?"
    },
    "t025": {
      "source_hash": "be020e9a9753",
      "text": "2007년엔 500종 넘게 내고 연 650만 부 넘게 팔았죠."
    },
    "t026": {
      "source_hash": "cb83e39d2f47",
      "text": "웹사이트 방문자는 한 달 430만 명."
    },
    "t027": {
      "source_hash": "a6df1dea1771",
      "text": "제 생각엔, 부엌 출판사가 이만큼 컸으니 탐낼 만도 하죠."
    },
    "t028": {
      "source_hash": "f0030265a9d8",
      "text": "그해 10월 1일, 누가 찾아옵니다."
    },
    "t029": {
      "source_hash": "08dcb080ba36",
      "text": "찾아온 건 BBC의 상업 부문. 회사의 4분의 3을 샀습니다."
    },
    "t030": {
      "source_hash": "56b29c6ca8b2",
      "text": "가격 비공개."
    },
    "t031": {
      "source_hash": "80fd1f5c7ac0",
      "text": "훗날 BBC 보도자료에 나온 값은 8810만 파운드."
    },
    "t032": {
      "source_hash": "abc279259a78",
      "text": "남은 4분의 1은 휠러 부부 몫."
    },
    "t033": {
      "source_hash": "e2a11df6bb53",
      "text": "BBC의 속셈은?"
    },
    "t034": {
      "source_hash": "6332a06994c6",
      "text": "상업 부문 최고경영자는 전략에 맞는 거래라며,"
    },
    "t035": {
      "source_hash": "1aaa7ac6559d",
      "text": "온라인 콘텐츠 브랜드 육성과 호주·미국 사업 확대라고요."
    },
    "t036": {
      "source_hash": "8d72d667ac69",
      "text": "그럴듯하죠?"
    },
    "t037": {
      "source_hash": "8016f23d466c",
      "text": "그런데 영국인이라면 첫 반응은 아마, 내 수신료는?"
    },
    "t038": {
      "source_hash": "f92282abf6af",
      "text": "BBC는 공적 자금은 안 썼다고 강조했죠."
    },
    "t039": {
      "source_hash": "4a7fc4454fd3",
      "text": "BBC 트러스트도 바로 승인 않고 조건 넷을 달고,"
    },
    "t040": {
      "source_hash": "1889770fcc48",
      "text": "거래로 BBC 프로그램과 브랜드 가치가 오른다는 증명도 요구."
    },
    "t041": {
      "source_hash": "016296ffa532",
      "text": "발표 당일, 가디언과 파이낸셜타임스가 일제히 비판."
    },
    "t042": {
      "source_hash": "09fb1b60b529",
      "text": "가디언 사설은 '서툰 상업주의'라고 했죠."
    },
    "t043": {
      "source_hash": "cb00c8bed1cd",
      "text": "공정하게 덧붙이면, 가디언도 자신이 경쟁사라고 밝혔습니다."
    },
    "t044": {
      "source_hash": "2b9bf2343e14",
      "text": "2년 뒤엔 의회가 비판에 나섭니다."
    },
    "t045": {
      "source_hash": "222d6050bc7f",
      "text": "2009년 4월, 하원 문화·미디어·스포츠 위원회가 보고서를 냈습니다."
    },
    "t046": {
      "source_hash": "85e95714e4ba",
      "text": "상업 부문의 무제한 확장 쪽으로 저울이 너무 기울었다고요."
    },
    "t047": {
      "source_hash": "2754428dcb5e",
      "text": "게다가 장부도 나빠집니다."
    },
    "t048": {
      "source_hash": "6177f3bfc8fc",
      "text": "2009년 3월 말까지 1년간, 320만 파운드 손실."
    },
    "t049": {
      "source_hash": "a03cbf4057f9",
      "text": "9월 추가 보고서, 이번엔 어떤 말을?"
    },
    "t050": {
      "source_hash": "2e38973773da",
      "text": "BBC 본업이 거의 없는 분야로 뻗은 상업 부문, 이 인수가 최악의 사례라고."
    },
    "t051": {
      "source_hash": "1c170e42000d",
      "text": "감독 기구 트러스트는 오만해 보인다고도 했죠."
    },
    "t052": {
      "source_hash": "ce9342fed82c",
      "text": "솔직히 의회에 이렇게 찍히면 저라면 쥐구멍 찾겠어요."
    },
    "t053": {
      "source_hash": "357e9141c608",
      "text": "같은 달, 런던 한 도시 잡지 창업자는 적자가 엄청나다며,"
    },
    "t054": {
      "source_hash": "44086c6b4b56",
      "text": "BBC가 수백만씩 붓는다. 왜 팔라고 강제 못 해?"
    },
    "t055": {
      "source_hash": "b398f238064b",
      "text": "그해 말, 트러스트가 정했죠. 특별한 사정 없으면 이런 인수 금지."
    },
    "t056": {
      "source_hash": "4d5b9a230701",
      "text": "당신이 BBC 임원이라면? 팔까요, 버틸까요?"
    },
    "t057": {
      "source_hash": "2f94ddaf53f4",
      "text": "그들은 버텼고, 정말 회복하는 듯했죠."
    },
    "t058": {
      "source_hash": "8f89bfd41ce4",
      "text": "2011년 2월 신문은 흑자 전환, 190만 파운드 이익이라 썼죠."
    },
    "t059": {
      "source_hash": "eda8b550e2e8",
      "text": "종이책 외 수입 비중은 9퍼센트에서 22퍼센트로 올랐습니다."
    },
    "t060": {
      "source_hash": "29081b2cdeb3",
      "text": "2011년 2월, 휠러 부부가 계약의 카드를 꺼내죠."
    },
    "t061": {
      "source_hash": "8b131cbce9bc",
      "text": "그 카드는 '풋옵션', 남은 지분을 상대에게 사게 할 권리."
    },
    "t062": {
      "source_hash": "fd80fe5f9f6d",
      "text": "처음 질문 기억나요? 마지막 4분의 1, 얼마에 샀을까요?"
    },
    "t063": {
      "source_hash": "daff8c221488",
      "text": "당초 인수가 그대로."
    },
    "t064": {
      "source_hash": "52f400a08e43",
      "text": "마지막 4분의 1에 BBC는 4217만 파운드를 냈습니다."
    },
    "t065": {
      "source_hash": "e20302a021de",
      "text": "파는 쪽이라면 인생 최고의 계약이겠죠?"
    },
    "t066": {
      "source_hash": "07d2dfc10f3f",
      "text": "훗날 공식 검토 보고서는 이 풋옵션이 잘못 설계됐다고 못박았죠."
    },
    "t067": {
      "source_hash": "246f2879485c",
      "text": "실적이 크게 밑돌았는데도 계약은 한 푼도 깎지 않았으니까요."
    },
    "t068": {
      "source_hash": "1e7125e0e648",
      "text": "당시 회장은 이 풋옵션 덕에 회사가 3년 반 동안 휠러 부부의 경험을 빌렸다고 했죠."
    },
    "t069": {
      "source_hash": "33e9d6e75045",
      "text": "둘을 합치면?"
    },
    "t070": {
      "source_hash": "b1625c68bb5a",
      "text": "처음 말한 약 1억 3천만 파운드."
    },
    "t071": {
      "source_hash": "caad6837b0ef",
      "text": "그해 5월, 호주 출판계 매체에 따르면 멜버른에서 최대 70명 감원,"
    },
    "t072": {
      "source_hash": "c2fcbc9edb61",
      "text": "웹 사업 상당 부분도 런던으로 간다고."
    },
    "t073": {
      "source_hash": "74380b6eeddd",
      "text": "휠러 부부도 손수 일군 회사를 떠났습니다."
    },
    "t074": {
      "source_hash": "93d4e82d507f",
      "text": "하지만 온라인 수익은 이 회사 혼자 힘으론 안 됐죠."
    },
    "t075": {
      "source_hash": "219c4cd81f63",
      "text": "그럼 누구에게 기댔을까요?"
    },
    "t076": {
      "source_hash": "6309dd6fe756",
      "text": "트러스트가 BBC에 시킨 그 검토는, 비상임 이사가 이끌고 외부 자문도 썼죠."
    },
    "t077": {
      "source_hash": "0eadc072771d",
      "text": "보고서는 온라인 사업이 BBC 국제 사이트와 연결해 광고를 팔 계획이었다고."
    },
    "t078": {
      "source_hash": "b8382b2843b6",
      "text": "처음에 말한 BBC 사이트, 뭘 했을까요?"
    },
    "t079": {
      "source_hash": "9cdc95330e7d",
      "text": "그 사이트가 늦어졌습니다."
    },
    "t080": {
      "source_hash": "c36a9694978e",
      "text": "그래서? 뭘 했을까요?"
    },
    "t081": {
      "source_hash": "a99795743661",
      "text": "지연 끝에 자체 여행 섹션을 만들기로."
    },
    "t082": {
      "source_hash": "c000bf588aea",
      "text": "보고서는 이 지연 탓에 광고로 제대로 벌기 힘들어졌다고."
    },
    "t083": {
      "source_hash": "cd75f1ad8877",
      "text": "큰돈 주고 여행 회사를 사서 따로 여행 섹션을? 이상하죠?"
    },
    "t084": {
      "source_hash": "376d82166893",
      "text": "커피 머신 사 놓고 매일 아래층서 커피 사는 격."
    },
    "t085": {
      "source_hash": "054289838a89",
      "text": "미국의 경우 2012년 여행서 판매가 전년보다 19퍼센트 줄었습니다."
    },
    "t086": {
      "source_hash": "90a36dbe475f",
      "text": "2010년?"
    },
    "t087": {
      "source_hash": "ee84b8e6f462",
      "text": "27퍼센트 감소."
    },
    "t088": {
      "source_hash": "5b5123beade5",
      "text": "온라인도 늦었죠. 보고서는 트립어드바이저처럼 될 수도 있었다며,"
    },
    "t089": {
      "source_hash": "ab9a73627726",
      "text": "공유 숙박 붐을 탈 수도 있었다고요."
    },
    "t090": {
      "source_hash": "cab23bbd9f66",
      "text": "지난 해외여행, 맛집은 책으로 찾았나요, 폰 리뷰로 찾았나요?"
    },
    "t091": {
      "source_hash": "8077e317ce04",
      "text": "보고서는 문제를 인수한 날까지 추적합니다. 계획은 영업이익률 30퍼센트 가정."
    },
    "t092": {
      "source_hash": "84a3a73fb106",
      "text": "너무 낙관적이었고 매수자는 거래에 휩쓸린 듯, 책 시장 하락 속도도 안 따졌다고요."
    },
    "t093": {
      "source_hash": "82f65d8bb564",
      "text": "다 BBC 탓일까요?"
    },
    "t094": {
      "source_hash": "f599acae5419",
      "text": "보고서의 외부 요인: 호주달러 깜짝 급등, 금융위기,"
    },
    "t095": {
      "source_hash": "f6120133cb3e",
      "text": "서점 유통의 구조적 압박도."
    },
    "t096": {
      "source_hash": "03317b9f5ae9",
      "text": "2013년 3월, BBC는 손을 듭니다."
    },
    "t097": {
      "source_hash": "92740ab4b702",
      "text": "3월 19일 BBC 발표, 회사를 통째로 7500만 호주달러에 판다."
    },
    "t098": {
      "source_hash": "78c5135e5345",
      "text": "파운드로 약 5150만."
    },
    "t099": {
      "source_hash": "16295a899f3b",
      "text": "그것도 일시불이 아니라 6000만 호주달러 먼저, 1500만은 1년 뒤."
    },
    "t100": {
      "source_hash": "6e73820d8fb7",
      "text": "매각 당시 사이트 방문자는 연 1억 2천만 명 넘게,"
    },
    "t101": {
      "source_hash": "a311479b61ac",
      "text": "앱 다운로드는 1100만 회가 넘었죠."
    },
    "t102": {
      "source_hash": "1e2103b51d4e",
      "text": "매수자는 미국 테네시주 내슈빌에 본사를 둔 회사,"
    },
    "t103": {
      "source_hash": "ede42064437a",
      "text": "대주주는 켄터키 출신, 저가 담배로 일어선 대지주."
    },
    "t104": {
      "source_hash": "969b6fcbf122",
      "text": "배낭족의 성경이 담배 부호 손에, 상상이나 했나요?"
    },
    "t105": {
      "source_hash": "f3ec913c5b36",
      "text": "공식 이유: BBC 자체 브랜드 중심 계획에 더는 안 맞는다."
    },
    "t106": {
      "source_hash": "6636d61b9613",
      "text": "BBC는 얼마 잃었죠?"
    },
    "t107": {
      "source_hash": "7ef74345ef8a",
      "text": "당시 AFP와 가디언은 8천만 파운드 가깝다고 썼죠."
    },
    "t108": {
      "source_hash": "b534b4b37b9f",
      "text": "계산은 간단. 처음 1억 3천만에서 방금 매각가를 뺀 것."
    },
    "t109": {
      "source_hash": "0b4e7b6b7e7c",
      "text": "하지만 판 날 한꺼번에 잃은 돈은 아닙니다."
    },
    "t110": {
      "source_hash": "a74ac55073a9",
      "text": "가디언에 따르면 BBC는 6년간 장부에서 6700만 파운드를 상각했죠."
    },
    "t111": {
      "source_hash": "16180857e697",
      "text": "장부 가치는 처음 1억 3천만에서 6300만까지 줄었습니다."
    },
    "t112": {
      "source_hash": "aa74b173dc0c",
      "text": "실제 판 날의 장부상 손실은 약 1200만뿐."
    },
    "t114": {
      "source_hash": "acbcfc55963d",
      "text": "그런데 달리 계산하면?"
    },
    "t115": {
      "source_hash": "b1f9489a313b",
      "text": "공식 검토 보고서는 보유 중 약 2000만 파운드를 더 넣었다고."
    },
    "t116": {
      "source_hash": "dac5e66bced2",
      "text": "보고서 숫자로 추산하면, 다 합친 손실은 1억 파운드에 가깝습니다."
    },
    "t117": {
      "source_hash": "f0e4d18132f3",
      "text": "트러스트도 발표 당일, 좋은 상업 투자는 아니었다고 인정."
    },
    "t118": {
      "source_hash": "bb7b4da2f7ce",
      "text": "BBC에 판 당사자는 이 거래를 어떻게 봤을까요?"
    },
    "t119": {
      "source_hash": "0fc0fc5fcddc",
      "text": "그해 9월 AP통신이 토니 휠러 인터뷰."
    },
    "t120": {
      "source_hash": "0f4db6ac7248",
      "text": "그는 말했죠. 틀림없이 완벽한 타이밍에 팔았다고."
    },
    "t121": {
      "source_hash": "0490182bcc3c",
      "text": "보고서가 짚은 호주달러 기억나요? 휠러는 호주달러가 막 뛸 때 팔았대요."
    },
    "t122": {
      "source_hash": "d57944f1f4cd",
      "text": "솔직하고, 조금 잔인한 말."
    },
    "t123": {
      "source_hash": "8104f75a7714",
      "text": "BBC가 못 본 것도 있다고 했죠. 이탈리아어 여행서에선 이게 1위라고."
    },
    "t124": {
      "source_hash": "4418e6064249",
      "text": "두 달 뒤 BBC도 입을 엽니다. 트러스트 부의장 왈,"
    },
    "t125": {
      "source_hash": "55d8df2262fc",
      "text": "인수와 운영 과정에서 실수가 있었다."
    },
    "t126": {
      "source_hash": "097a6afe32cb",
      "text": "런던에서 동쪽으로 달린 그 고물차, 기억나요?"
    },
    "t127": {
      "source_hash": "f14062060804",
      "text": "2년 뒤 발리 작가 축제에선 로이터에 더 직설적으로,"
    },
    "t128": {
      "source_hash": "60dbf0855898",
      "text": "완전한 재앙이다. 차를 사 놓고 기름도 안 넣고 액셀도 안 밟았다."
    },
    "t129": {
      "source_hash": "87914c433709",
      "text": "타서는 묻기만 했다. 뭘 하지? 그럼 천천히 가자."
    },
    "t130": {
      "source_hash": "96a6bcd5928e",
      "text": "BBC가 판 뒤엔?"
    },
    "t131": {
      "source_hash": "bf8fa19503bd",
      "text": "2020년 말 또 팔렸고, 값은 비공개."
    },
    "t132": {
      "source_hash": "13617b01945a",
      "text": "지금 정규직은 약 130명, BBC가 판 해엔 400명이었죠."
    },
    "t133": {
      "source_hash": "0daa801add56",
      "text": "책은 지금도 나오고, 33개 언어로 1억 5천만 부 넘게 찍었죠."
    },
    "t134": {
      "source_hash": "a06f76d9062e",
      "text": "서점에서 다시 보면 이 장부를 떠올려 보세요."
    },
    "t135": {
      "source_hash": "4487a44ad0b6",
      "text": "처음 질문으로, 돈은 절반도 못 건졌죠. 왜일까요?"
    },
    "t136": {
      "source_hash": "29bca2f79ff5",
      "text": "그 검토 보고서 기억나요? 답은 너무 높게 쳤고, 너무 늦게 바꿨고, 때가 나빴다."
    },
    "t137": {
      "source_hash": "745bac07ce0b",
      "text": "여행 갈 때 책 챙겨요? 폰만? 댓글로요."
    },
    "t138": {
      "source_hash": "9b008b88180e",
      "text": "이 채널은 기록에 있는 것만. 함께 파일을 열려면 구독을."
    }
  }
}
