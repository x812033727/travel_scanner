  "lines": {
    "ap101": {
      "source_hash": "1b3153a70134",
      "text": "1726년 4월 15일, 런던 켄싱턴. 한 의사가 옛 친구를 찾아갑니다."
    },
    "ap102": {
      "source_hash": "bc1bb8aec8ef",
      "text": "옛 친구는 83세, 이름은 뉴턴입니다."
    },
    "ap103": {
      "source_hash": "0e7446da888a",
      "text": "둘이 식사 후 사과나무 아래서 차를 마십니다."
    },
    "ap105": {
      "source_hash": "d06899ba2e88",
      "text": "이야기 중에 뉴턴이 말합니다. 중력을 떠올린 것도 같은 상황이었다고."
    },
    "ap106": {
      "source_hash": "50f439ff6ad8",
      "text": "그때 무슨 일이 있었을까요?"
    },
    "ap107": {
      "source_hash": "5672c12d2c17",
      "text": "더 있습니다."
    },
    "ap108": {
      "source_hash": "ddd62e158a86",
      "text": "1752년 의사가 그 오후를 적은 원고엔 세 가지가 없습니다."
    },
    "ap109": {
      "source_hash": "e451a72bf3d2",
      "text": "뉴턴도 말년에 중력을 생각한 해를 직접 적었습니다."
    },
    "ap110": {
      "source_hash": "6d700fd6384c",
      "text": "그의 사후 십여 년, 소책자 재판에 그에 관한 대목이 붙습니다."
    },
    "ap111": {
      "source_hash": "007dcc541621",
      "text": "뉴턴 생가의 사과나무는 약 200년 전 강풍에 쓰러졌습니다."
    },
    "ap112": {
      "source_hash": "ad07f8286056",
      "text": "사과는 정말 그의 머리를 쳤을까요?"
    },
    "ap201": {
      "source_hash": "96206f868dbe",
      "text": "맞았는지는 그날 함께 있던 의사 스터클리가 압니다."
    },
    "ap202": {
      "source_hash": "7c560189cd65",
      "text": "첫머리의 1752년 원고가 그가 쓴 뉴턴 회고록이고, 지금 왕립학회에 있습니다."
    },
    "ap203": {
      "source_hash": "8384b27fd987",
      "text": "뉴턴이 말한 '같은 상황'을 원고는 분명히 적습니다."
    },
    "ap204": {
      "source_hash": "2e320499010e",
      "text": "언젠가 그가 앉아 생각에 잠겼을 때, 사과가 떨어졌다."
    },
    "ap205": {
      "source_hash": "92ff448139a5",
      "text": "그는 생각했다. 왜 사과는 늘 수직으로 떨어질까? 왜 옆이나 위로는 아닐까?"
    },
    "ap206": {
      "source_hash": "6138306f043f",
      "text": "그의 답: 지구가 당긴다. 물질엔 끄는 힘이 있을 것이다."
    },
    "ap207": {
      "source_hash": "53d59482f521",
      "text": "그리고 사과도 지구를 당긴다."
    },
    "ap217": {
      "source_hash": "42018bb9ca6d",
      "text": "뉴턴 본인 말에 가장 가까운 기록입니다. 다만, 이것도 스터클리의 전언입니다."
    },
    "ap208": {
      "source_hash": "ec0f1e986cd0",
      "text": "어디서? 몇 년에? 그에게 닿았나?"
    },
    "ap209": {
      "source_hash": "e2825971f0a3",
      "text": "원고에 없는 세 가지가 이것입니다."
    },
    "ap210": {
      "source_hash": "deda846f80e7",
      "text": "장소도, 연도도 없이 '언젠가'뿐."
    },
    "ap211": {
      "source_hash": "cd7940e76de4",
      "text": "머리에 맞았다는 말도 없습니다."
    },
    "ap212": {
      "source_hash": "9e72cbb56cc3",
      "text": "원고 전체에서 사과는 여기뿐입니다."
    },
    "ap213": {
      "source_hash": "7182bd71256e",
      "text": "스터클리는 그날 바로 사과를 적었을까요?"
    },
    "ap214": {
      "source_hash": "b7f326900f27",
      "text": "아닌 듯합니다. 둘만의 식사, 기억하시죠?"
    },
    "ap218": {
      "source_hash": "1ce5f77608b3",
      "text": "이 나무 연구자가 그날 일기를 인용했습니다. 식사는 있고, 사과는 없습니다."
    },
    "ap215": {
      "source_hash": "b4f633c89aaf",
      "text": "이 원고는 184년을 기다려 1936년에야 책이 됐습니다."
    },
    "ap216": {
      "source_hash": "be2b22d26749",
      "text": "그런데 이 사과를 적은 건 스터클리뿐일까요?"
    },
    "ap301": {
      "source_hash": "48596857bcf5",
      "text": "아닙니다. 1727년 3월 뉴턴이 죽고, 그해 런던에서 이 사과를 쓴 영어 책이 나옵니다."
    },
    "ap302": {
      "source_hash": "bd044fe94c18",
      "text": "저자는 프랑스 작가 볼테르. 뉴턴 사망 때 영국에 있었습니다."
    },
    "ap303": {
      "source_hash": "ec3c32bce8c6",
      "text": "그는 썼습니다. 뉴턴이 정원을 걷다 사과가 떨어지는 걸 보고,"
    },
    "ap325": {
      "source_hash": "64407337b617",
      "text": "중력 이론의 첫 착상을 얻었다고."
    },
    "ap304": {
      "source_hash": "8d017089d2bc",
      "text": "이번엔 앉아서가 아니라 걷다가."
    },
    "ap305": {
      "source_hash": "b1386d094e5b",
      "text": "볼테르는 누구에게 들었을까요?"
    },
    "ap306": {
      "source_hash": "969ad343138e",
      "text": "그 책엔 없습니다. 십여 년 뒤 1741년, 다른 책 새 판에 한 줄을 더합니다."
    },
    "ap307": {
      "source_hash": "a9e5a0dc2c12",
      "text": "\"조카딸에게 들었다.\""
    },
    "ap331": {
      "source_hash": "e3c517cb57d6",
      "text": "어느 날 시골에서 뉴턴은 나무에서 열매가 떨어지는 걸 보고 생각에 잠겼다."
    },
    "ap332": {
      "source_hash": "6a0c1fac3fef",
      "text": "무엇이 모든 것을 거의 지구 중심 쪽으로 떨어지게 하는가?"
    },
    "ap326": {
      "source_hash": "cf3db8dc0809",
      "text": "조카딸이 살림을 맡았습니다."
    },
    "ap329": {
      "source_hash": "5fae69071ff2",
      "text": "누가 또 남겼을까요?"
    },
    "ap309": {
      "source_hash": "310ef2192372",
      "text": "조카사위 콘듀잇은 조폐국에서 뉴턴의 부관이었습니다."
    },
    "ap310": {
      "source_hash": "6367f331ee74",
      "text": "뉴턴 사후 그는 전기를 쓰려고 초고를 여럿 남겼습니다."
    },
    "ap311": {
      "source_hash": "67be45af30c6",
      "text": "초고에 따르면, 역병으로 케임브리지가 닫혀 뉴턴은 링컨셔 고향에 왔고,"
    },
    "ap327": {
      "source_hash": "f94780be6773",
      "text": "거기서 사과가 떨어지는 걸 봤습니다."
    },
    "ap312": {
      "source_hash": "a77707717560",
      "text": "몇 년일까요?"
    },
    "ap313": {
      "source_hash": "cb62f9caa473",
      "text": "1665년도, 1666년도 있습니다."
    },
    "ap314": {
      "source_hash": "7c9ea0803de3",
      "text": "어느 쪽이든, 머리에 맞았다는 말은 없습니다."
    },
    "ap315": {
      "source_hash": "00161bd2c8a1",
      "text": "뉴턴 자신은? 많은 원고 중에 직접 쓴 게 있을까요?"
    },
    "ap316": {
      "source_hash": "756e57a0471d",
      "text": "뉴턴이 말년에 직접 적은 그 해, 기억하시죠?"
    },
    "ap317": {
      "source_hash": "6be343cfd1d0",
      "text": "그는 메모에 젊을 때 해낸 일을 하나씩 적었습니다."
    },
    "ap318": {
      "source_hash": "437b46aa4e29",
      "text": "1666년에 대해 그는 씁니다. 그해 나는 중력이 달까지 뻗을지 생각하기 시작했다고."
    },
    "ap321": {
      "source_hash": "8637b204e8ed",
      "text": "메모엔 달은 있고 사과는 없습니다."
    },
    "ap322": {
      "source_hash": "37c298af8b4e",
      "text": "지금도 뉴턴이 직접 쓴 사과는 없습니다."
    },
    "ap323": {
      "source_hash": "30653c37b6c5",
      "text": "'머리에 맞았다'의 가장 이른 기록은?"
    },
    "ap401": {
      "source_hash": "0d636111f894",
      "text": "첫머리의 재판 소책자, 1740년 무렵입니다."
    },
    "ap402": {
      "source_hash": "89596e23335c",
      "text": "1739년 런던에서 낸 초판엔 뉴턴이 한 번도 안 나옵니다."
    },
    "ap403": {
      "source_hash": "bc1f49f9a521",
      "text": "재판에 더해진 말:"
    },
    "ap404": {
      "source_hash": "6bd41e542875",
      "text": "뉴턴의 인력론은 나무 밑에 앉았다가 머리에 떨어진 사과에서 왔다."
    },
    "ap405": {
      "source_hash": "228f8c0c1882",
      "text": "저자는 덧붙입니다. 단, 수학자여야 했다."
    },
    "ap406": {
      "source_hash": "e1d920486999",
      "text": "아니면 과수원 열매가 다 쏟아져도 무겁고 딱딱하다고만 느꼈을 거라고."
    },
    "ap407": {
      "source_hash": "ae7c56910811",
      "text": "근거는 누구?"
    },
    "ap408": {
      "source_hash": "9b22bb093787",
      "text": "펨버턴에 따랐다고 합니다."
    },
    "ap409": {
      "source_hash": "2e1775e95151",
      "text": "펨버턴은 『프린키피아』 3판 편집자로, 이론의 유래를 뉴턴과 얘기했습니다."
    },
    "ap410": {
      "source_hash": "7b4c14cf372f",
      "text": "펨버턴의 책에 사과가 있을까요?"
    },
    "ap411": {
      "source_hash": "7396a8ccf74f",
      "text": "1728년 펨버턴이 낸 뉴턴 학설 책 서문엔, 뉴턴이 홀로 정원에 앉아 중력을 생각했다고 합니다."
    },
    "ap412": {
      "source_hash": "e3deaeb784ce",
      "text": "정원과 중력은 있지만 사과는 없습니다. 출처에 그 얘기가 없는 겁니다."
    },
    "ap414": {
      "source_hash": "b4da4d642d9a",
      "text": "머리 버전은 이 소책자뿐일까요?"
    },
    "ap415": {
      "source_hash": "9165ece0ba00",
      "text": "아닙니다. 1760년 9월 수학자 오일러도 독일 공주에게 뉴턴을 썼습니다."
    },
    "ap416": {
      "source_hash": "3e462755e96e",
      "text": "편지에 따르면, 이 영국의 대철학자이자 대수학자는 어느 날 정원 사과나무 아래 누워 있었다."
    },
    "ap417": {
      "source_hash": "bbf2189c7ae6",
      "text": "사과가 머리에 떨어졌다."
    },
    "ap418": {
      "source_hash": "4cb1826adc36",
      "text": "이번엔 누워서."
    },
    "ap431": {
      "source_hash": "d8474a44aa99",
      "text": "달과는 무슨 관계일까요?"
    },
    "ap419": {
      "source_hash": "284c4266083e",
      "text": "그러나 달은 머리에 안 떨어졌다."
    },
    "ap420": {
      "source_hash": "b07ec1448867",
      "text": "그래서 달을 붙잡는 건 그 운동일지 모른다고 생각했다."
    },
    "ap430": {
      "source_hash": "963ba6ec962d",
      "text": "뉴턴이 그 나무 밑에 안 눕고 사과가 머리에 안 떨어졌다면 지금도 몰랐을 거라고도 씁니다."
    },
    "ap427": {
      "source_hash": "f6956fd303db",
      "text": "이 편지는 얼마나 퍼졌을까요?"
    },
    "ap421": {
      "source_hash": "154c6ab237f1",
      "text": "편지는 1768년 책이 됐고, 1795년 영역본도 사과가 머리에 떨어졌다고 씁니다."
    },
    "ap428": {
      "source_hash": "5708c8a17acc",
      "text": "다들 믿었을까요?"
    },
    "ap422": {
      "source_hash": "4858975b1ad5",
      "text": "18세기 말 파리판 편자가 주를 답니다."
    },
    "ap423": {
      "source_hash": "d3b9e022a6d3",
      "text": "사과보다 '계속 생각해서' 알았다는 뉴턴 본인 말이 더 그럴듯하다고."
    },
    "ap429": {
      "source_hash": "2defe49288fc",
      "text": "의심과 별개로, 19세기엔 머리에 맞은 얘기가 흔했습니다."
    },
    "ap424": {
      "source_hash": "271dac024247",
      "text": "뉴턴 생가의 사과나무도 '그 나무'가 됩니다."
    },
    "ap425": {
      "source_hash": "2a0eebb95d58",
      "text": "처음 지목된 건 언제일까요?"
    },
    "ap501": {
      "source_hash": "6be62c955c47",
      "text": "가장 이른 기록은 1806년 지방지입니다. 그 사과나무가 남아 있어 외지인을 안내한다고."
    },
    "ap502": {
      "source_hash": "6dbe2af84e11",
      "text": "뉴턴 사후 80년 가까이, 머리 얘기 소책자보다도 60여 년 늦습니다."
    },
    "ap503": {
      "source_hash": "7ced4a4ad109",
      "text": "뉴턴이 직접 고른 나무일까요?"
    },
    "ap504": {
      "source_hash": "3e1b1b7ed840",
      "text": "증거는 없습니다. 연구자는 뉴턴 집 정원에 사과나무가 이것 하나뿐이라 뽑혔다고 봅니다."
    },
    "ap508": {
      "source_hash": "f5c7b3818d93",
      "text": "그 강풍 기억하시죠? 쓰러진 줄기가 다시 뿌리내려 지금도 꽃 피고 열매 맺습니다."
    },
    "ap512": {
      "source_hash": "dfb909c2978d",
      "text": "그럼 처음 질문, 사과는 뉴턴의 머리를 쳤을까요?"
    },
    "ap514": {
      "source_hash": "bb4443a84079",
      "text": "사과가 영감이었는지는 기록으로 못 가립니다."
    },
    "ap515": {
      "source_hash": "76c1289acce4",
      "text": "어떤 역사가는 60년 전 일을 말하던 말년의 뉴턴이 스스로 전설을 만들었을 수 있다고 봅니다."
    },
    "ap517": {
      "source_hash": "36ff2ff08117",
      "text": "머리 건은 종결. 사과는 기록에, 머리는 후대에 붙었습니다."
    },
    "ap520": {
      "source_hash": "1484bd2a38ff",
      "text": "이 파일, 보관."
    },
    "ap518": {
      "source_hash": "279ab6bc6af0",
      "text": "어릴 때 들은 사과는 머리를 쳤나요?"
    },
    "ap519": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 말합니다. 함께 파일을 열려면 구독을."
    }
  }
}
