{
  "zq41a01": {
    "text": "Quem pagou?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "Um senhorzinho de leque",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "mandou gente.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "De leque…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "Na cidade, só vi um.",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "Ele me conhece.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "Cem taéis,",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "só viva.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "Um letrado",
    "emotion": "低聲，對自己"
  },
  "zq41a10": {
    "text": "não protege esta casa.",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "Então, vou ganhar um título.",
    "emotion": "下定決心"
  },
  "zq41a12": {
    "text": "Exame provincial,",
    "emotion": "撥著算盤，飛快"
  },
  "zq41a13": {
    "text": "dia nove do mês que vem.",
    "emotion": "算好了",
    "say": "dia nove que vem."
  },
  "zq41a14": {
    "text": "Um mês?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "Decorar todos os clássicos?",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "Ora, ora,",
    "emotion": "拖長音"
  },
  "zq41a17": {
    "text": "o que bombou três vezes.",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "E agora,",
    "emotion": "笑出聲"
  },
  "zq41a19": {
    "text": "a quarta vez?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "Senhor Qian,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "a conta se fecha no fim.",
    "emotion": "話裡帶刺"
  },
  "zq41a22": {
    "text": "Se eu passar,",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "o senhor se ajoelha.",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "Fechado!",
    "emotion": "一愣，嘴硬"
  },
  "zq41a25": {
    "text": "Vou esperar!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "Missão obrigatória: passar no exame provincial.",
    "emotion": "平板電子音，叮一聲",
    "say": "Missão: passar no exame."
  },
  "zq41a27": {
    "text": "Falha: afeição das três esposas pela metade.",
    "emotion": "平板電子音，冷冷的",
    "say": "Falha: as três pela metade."
  },
  "zq41a28": {
    "text": "Pe…",
    "emotion": "倒吸一口氣"
  },
  "zq41a29": {
    "text": "Pela metade?",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "Se eu for pra cidade,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "quem cuida de casa?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "Eu fico.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "Cuido da casa e da Xiaohe.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "A-Ling.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "Deixo a casa com você.",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "Sim.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "A-Ling: afeição cinquenta e quatro.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: cinquenta e quatro."
  },
  "zq41a38": {
    "text": "Vou com você.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "Na estrada, eu protejo.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "Eu também!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "As contas de lá são minhas.",
    "emotion": "得意"
  },
  "zq41a42": {
    "text": "Tá bom,",
    "emotion": "笑，拍板"
  },
  "zq41a43": {
    "text": "todos pra cidade.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "A cidade…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…Tá bom.",
    "emotion": "遲疑了一下才答"
  },
  "zq41a46": {
    "text": "Três tentativas,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "o que ele lia…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "Qin?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "O Xu Yan de antes…",
    "emotion": "皺眉"
  },
  "zq41a50": {
    "text": "por que esconder isto?",
    "emotion": "低聲"
  }
}
