{
  "zq41a01": {
    "text": "Siapa yang bayar?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "Tuan muda berkipas",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "yang mengirim orang.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "Berkipas…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "Di kota, aku cuma pernah lihat satu.",
    "emotion": "冷下來",
    "say": "Di kota, cuma lihat satu."
  },
  "zq41a06": {
    "text": "Dia mengenalku.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "Seratus tael,",
    "emotion": "粗啞",
    "say": "Seratus."
  },
  "zq41a08": {
    "text": "harus hidup.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "Seorang sarjana",
    "emotion": "低聲，對自己",
    "say": "Sarjana"
  },
  "zq41a10": {
    "text": "tak bisa melindungi rumah ini.",
    "emotion": "咬牙",
    "say": "tak bisa jaga rumah."
  },
  "zq41a11": {
    "text": "Maka aku raih pangkat.",
    "emotion": "下定決心",
    "say": "Kejar pangkat."
  },
  "zq41a12": {
    "text": "Ujian provinsi,",
    "emotion": "撥著算盤，飛快",
    "say": "Ujiannya,"
  },
  "zq41a13": {
    "text": "tanggal sembilan bulan depan.",
    "emotion": "算好了",
    "say": "bulan depan."
  },
  "zq41a14": {
    "text": "Sebulan?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "Hafal semua kitab klasik?",
    "emotion": "現代人的哀號",
    "say": "Hafal semua kitab?"
  },
  "zq41a16": {
    "text": "Wah,",
    "emotion": "拖長音",
    "say": "Oh,"
  },
  "zq41a17": {
    "text": "yang gagal tiga kali.",
    "emotion": "冷笑",
    "say": "tiga kali gagal."
  },
  "zq41a18": {
    "text": "Kali ini,",
    "emotion": "笑出聲",
    "say": "Nah,"
  },
  "zq41a19": {
    "text": "yang keempat?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "Tuan Qian,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "hitungan itu di akhir.",
    "emotion": "話裡帶刺",
    "say": "hitung di akhir."
  },
  "zq41a22": {
    "text": "Kali ini lulus,",
    "emotion": "笑，一字一字",
    "say": "Kalau lulus,"
  },
  "zq41a23": {
    "text": "kau yang bersujud.",
    "emotion": "很穩",
    "say": "kau bersujud."
  },
  "zq41a24": {
    "text": "Baik!",
    "emotion": "一愣，嘴硬",
    "say": "Oke!"
  },
  "zq41a25": {
    "text": "Kutunggu!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "Misi wajib: lulus ujian provinsi.",
    "emotion": "平板電子音，叮一聲",
    "say": "Misi: lulus ujian provinsi."
  },
  "zq41a27": {
    "text": "Gagal: poin suka tiga istri dipotong separuh.",
    "emotion": "平板電子音，冷冷的",
    "say": "Gagal: poin suka tiga istri separuh."
  },
  "zq41a28": {
    "text": "Se…",
    "emotion": "倒吸一口氣",
    "say": "Se—"
  },
  "zq41a29": {
    "text": "Separuh?",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "Aku ke kota besar,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "siapa jaga rumah?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "Aku tinggal.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "Jaga rumah, jaga Xiaohe.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "A-Ling.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "Rumah kuserahkan padamu.",
    "emotion": "畫外，鄭重",
    "say": "Rumah untukmu."
  },
  "zq41a36": {
    "text": "Baik.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "Poin suka A-Ling, lima puluh empat.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling, lima puluh empat."
  },
  "zq41a38": {
    "text": "Aku ikut.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "Di jalan, aku yang jaga.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "Aku juga!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "Pembukuan di sana, urusanku.",
    "emotion": "得意",
    "say": "Pembukuan, urusanku."
  },
  "zq41a42": {
    "text": "Baik,",
    "emotion": "笑，拍板",
    "say": "Ya,"
  },
  "zq41a43": {
    "text": "kita ke kota besar.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "Kota besar…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…Baik.",
    "emotion": "遲疑了一下才答",
    "say": "Oke."
  },
  "zq41a46": {
    "text": "Tiga kali ujian,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "apa saja yang dibaca…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "Qin?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "Xu Yan yang dulu…",
    "emotion": "皺眉",
    "say": "Yang dulu…"
  },
  "zq41a50": {
    "text": "kenapa sembunyikan ini?",
    "emotion": "低聲"
  }
}
