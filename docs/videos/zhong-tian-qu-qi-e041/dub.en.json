{
  "zq41a01": {
    "text": "Who paid?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "A young master with a fan",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "sent his man.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "A man with a fan…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "In town, I've seen just one.",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "He knows me.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "A hundred taels,",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "only alive.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "One Scholar,",
    "emotion": "低聲，對自己"
  },
  "zq41a10": {
    "text": "can't protect this home.",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "Then I'll earn a rank.",
    "emotion": "下定決心"
  },
  "zq41a12": {
    "text": "The provincial exam,",
    "emotion": "撥著算盤，飛快"
  },
  "zq41a13": {
    "text": "the ninth of next month.",
    "emotion": "算好了"
  },
  "zq41a14": {
    "text": "A month?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "Memorize all the classics?",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "Well, well,",
    "emotion": "拖長音"
  },
  "zq41a17": {
    "text": "the three-time failure.",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "This time,",
    "emotion": "笑出聲"
  },
  "zq41a19": {
    "text": "a fourth try?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "Squire Qian,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "we tally up at the end.",
    "emotion": "話裡帶刺"
  },
  "zq41a22": {
    "text": "Pass this time,",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "and you kowtow.",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "Fine!",
    "emotion": "一愣，嘴硬"
  },
  "zq41a25": {
    "text": "I'll be waiting!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "Mandatory mission: pass the provincial exam.",
    "emotion": "平板電子音，叮一聲",
    "say": "Mandatory mission: pass the exam."
  },
  "zq41a27": {
    "text": "Failure: all three wives' affection halved.",
    "emotion": "平板電子音，冷冷的",
    "say": "Fail: three wives' affection halved."
  },
  "zq41a28": {
    "text": "Half…",
    "emotion": "倒吸一口氣"
  },
  "zq41a29": {
    "text": "Halved?!",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "I go to the city,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "who guards home?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "I'll stay.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "The house, and Xiaohe.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "A-Ling.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "Home is in your hands.",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "All right.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "A-Ling affection: fifty-four.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq41a38": {
    "text": "I'm going with you.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "I'll guard the road.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "Me too!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "The city's accounts are mine.",
    "emotion": "得意"
  },
  "zq41a42": {
    "text": "All right,",
    "emotion": "笑，拍板"
  },
  "zq41a43": {
    "text": "we all go to the city.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "The city…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…fine.",
    "emotion": "遲疑了一下才答"
  },
  "zq41a46": {
    "text": "Three tries,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "and what did he even read…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "Qin?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "The old Xu Yan…",
    "emotion": "皺眉"
  },
  "zq41a50": {
    "text": "why hide this?",
    "emotion": "低聲"
  }
}
