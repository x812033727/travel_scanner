{
  "zq41a01": {
    "text": "¿Quién pagó?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "Un señorito con abanico",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "mandó a su gente.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "Con abanico…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "En la ciudad, solo vi a uno.",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "Me conoce.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "Cien taeles,",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "solo viva.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "Un letrado",
    "emotion": "低聲，對自己"
  },
  "zq41a10": {
    "text": "no protege esta casa.",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "Pues ganaré un rango.",
    "emotion": "下定決心"
  },
  "zq41a12": {
    "text": "Examen provincial,",
    "emotion": "撥著算盤，飛快"
  },
  "zq41a13": {
    "text": "el nueve del mes que viene.",
    "emotion": "算好了",
    "say": "el nueve que viene."
  },
  "zq41a14": {
    "text": "¿Un mes?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "¿Memorizar los clásicos?",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "Vaya,",
    "emotion": "拖長音"
  },
  "zq41a17": {
    "text": "el que reprobó tres veces.",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "Y ahora,",
    "emotion": "笑出聲"
  },
  "zq41a19": {
    "text": "¿la cuarta?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "Don Qian,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "las cuentas se hacen al final.",
    "emotion": "話裡帶刺",
    "say": "la cuenta va al final."
  },
  "zq41a22": {
    "text": "Si apruebo,",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "se me arrodilla.",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "¡Bien!",
    "emotion": "一愣，嘴硬"
  },
  "zq41a25": {
    "text": "¡Aquí espero!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "Misión obligatoria: aprobar el examen provincial.",
    "emotion": "平板電子音，叮一聲",
    "say": "Misión: aprobar el examen."
  },
  "zq41a27": {
    "text": "Fallo: el afecto de las tres esposas, a la mitad.",
    "emotion": "平板電子音，冷冷的",
    "say": "Fallo: tres esposas, a la mitad."
  },
  "zq41a28": {
    "text": "La mi…",
    "emotion": "倒吸一口氣"
  },
  "zq41a29": {
    "text": "¿La mitad?",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "Si voy a la ciudad,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "¿quién cuida la casa?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "Me quedo.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "Cuido la casa y a Xiaohe.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "A-Ling.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "Te dejo la casa.",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "Sí.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "A-Ling: afecto cincuenta y cuatro.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: cincuenta y cuatro."
  },
  "zq41a38": {
    "text": "Voy contigo.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "En el camino, te cuido.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "¡Yo también!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "Las cuentas de la ciudad, mías.",
    "emotion": "得意",
    "say": "Las cuentas de allá, mías."
  },
  "zq41a42": {
    "text": "Bien,",
    "emotion": "笑，拍板"
  },
  "zq41a43": {
    "text": "todos a la ciudad.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "La ciudad…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…Está bien.",
    "emotion": "遲疑了一下才答",
    "say": "…Bien."
  },
  "zq41a46": {
    "text": "Tres intentos,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "¿y qué leía?…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "¿Qin?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "El Xu Yan de antes…",
    "emotion": "皺眉"
  },
  "zq41a50": {
    "text": "¿por qué esconder esto?",
    "emotion": "低聲"
  }
}
