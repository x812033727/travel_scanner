{
  "zq41a01": {
    "text": "누가 돈 댔어?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "부채 부치는 공자가",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "보낸 사람이다.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "부채라면…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "읍내에선 딱 한 명 봤어.",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "날 알아봐.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "백 냥,",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "산 채로만.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "수재 하나로는,",
    "emotion": "低聲，對自己"
  },
  "zq41a10": {
    "text": "이 집을 못 지켜.",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "그럼 공명을 따야지.",
    "emotion": "下定決心"
  },
  "zq41a12": {
    "text": "주성 향시,",
    "emotion": "撥著算盤，飛快"
  },
  "zq41a13": {
    "text": "다음 달 초아흐레.",
    "emotion": "算好了"
  },
  "zq41a14": {
    "text": "한 달?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "사서오경을 다 외워?",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "어이구,",
    "emotion": "拖長音"
  },
  "zq41a17": {
    "text": "세 번 떨어진 양반.",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "이번엔,",
    "emotion": "笑出聲"
  },
  "zq41a19": {
    "text": "네 번째?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "첸 나리,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "셈은 끝에 가서 하는 거죠.",
    "emotion": "話裡帶刺"
  },
  "zq41a22": {
    "text": "이번에 붙으면,",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "절이나 하쇼.",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "좋아!",
    "emotion": "一愣，嘴硬"
  },
  "zq41a25": {
    "text": "기다리지!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "강제 미션: 향시 합격.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq41a27": {
    "text": "실패: 세 아내 호감 절반.",
    "emotion": "平板電子音，冷冷的"
  },
  "zq41a28": {
    "text": "저, 절…",
    "emotion": "倒吸一口氣"
  },
  "zq41a29": {
    "text": "절반?",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "내가 주성에 가면,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "집은 누가 지켜?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "내가 남을게.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "집도, 샤오허도 지킬게.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "아링.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "집은 너한테 맡길게.",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "응.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "아링 호감, 54.",
    "emotion": "平板電子音，叮一聲",
    "say": "아링 호감, 오십사."
  },
  "zq41a38": {
    "text": "나도 같이 가.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "길에선 내가 지켜.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "나도 갈래!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "주성 장부는 내가 맡아.",
    "emotion": "得意"
  },
  "zq41a42": {
    "text": "좋아,",
    "emotion": "笑，拍板"
  },
  "zq41a43": {
    "text": "다 같이 주성으로.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "주성…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…그래.",
    "emotion": "遲疑了一下才答"
  },
  "zq41a46": {
    "text": "세 번이나 보고,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "뭘 읽은 거야…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "친?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "원주인은…",
    "emotion": "皺眉"
  },
  "zq41a50": {
    "text": "이걸 왜 숨겼지?",
    "emotion": "低聲"
  }
}
