{
  "zq41a01": {
    "text": "誰が金を出した？",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "扇子を振る若旦那の、",
    "emotion": "粗啞，學那人搖扇子"
  },
  "zq41a03": {
    "text": "使いだ。",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "扇子の男……",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "県城で見たのは一人だけ。",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "私を知ってる。",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "百両、",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "生け捕りだけだ。",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "秀才ひとりじゃ、",
    "emotion": "低聲，對自己",
    "say": "秀才じゃ、"
  },
  "zq41a10": {
    "text": "この家は守れない。",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "なら、功名を取る。",
    "emotion": "下定決心",
    "say": "なら功名を。"
  },
  "zq41a12": {
    "text": "州城の郷試、",
    "emotion": "撥著算盤，飛快",
    "say": "郷試は、"
  },
  "zq41a13": {
    "text": "来月九日。",
    "emotion": "算好了"
  },
  "zq41a14": {
    "text": "一か月？",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "四書五経を丸暗記？",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "おやおや、",
    "emotion": "拖長音",
    "say": "おや、"
  },
  "zq41a17": {
    "text": "三度落ちた男か。",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "今度は、",
    "emotion": "笑出聲",
    "say": "また、"
  },
  "zq41a19": {
    "text": "四度目か？",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "チエン旦那、",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "勘定は最後にするものよ。",
    "emotion": "話裡帶刺"
  },
  "zq41a22": {
    "text": "今度受かったら、",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "土下座しろ。",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "いいだろう！",
    "emotion": "一愣，嘴硬",
    "say": "よし！"
  },
  "zq41a25": {
    "text": "待っとるぞ！",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "強制任務：郷試合格。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq41a27": {
    "text": "失敗：妻三人の好感度半減。",
    "emotion": "平板電子音，冷冷的",
    "say": "失敗：妻の好感度半減。"
  },
  "zq41a28": {
    "text": "は、半……",
    "emotion": "倒吸一口氣",
    "say": "は……"
  },
  "zq41a29": {
    "text": "半減？",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "州城へ行くなら、",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "家は誰が守る？",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "私が残る。",
    "emotion": "淡，但很定",
    "say": "残る。"
  },
  "zq41a33": {
    "text": "家とシャオホーを守る。",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "アーリン。",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "家を頼む。",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "うん。",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "アーリン好感度、五十四。",
    "emotion": "平板電子音，叮一聲",
    "say": "アーリン、五十四。"
  },
  "zq41a38": {
    "text": "私も行く。",
    "emotion": "爽快",
    "say": "私も。"
  },
  "zq41a39": {
    "text": "道中は私が守る。",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "私も！",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "州城の帳簿は私が。",
    "emotion": "得意",
    "say": "帳簿は私。"
  },
  "zq41a42": {
    "text": "よし、",
    "emotion": "笑，拍板",
    "say": "うん、"
  },
  "zq41a43": {
    "text": "みんなで州城へ。",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "州城……",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "……うん。",
    "emotion": "遲疑了一下才答"
  },
  "zq41a46": {
    "text": "三度も受けて、",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "何を読んでたんだ……",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "秦？",
    "emotion": "畫外，低聲唸出來",
    "say": "チン？"
  },
  "zq41a49": {
    "text": "前の俺は……",
    "emotion": "皺眉",
    "say": "前の俺…"
  },
  "zq41a50": {
    "text": "なぜこれを隠した？",
    "emotion": "低聲"
  }
}
