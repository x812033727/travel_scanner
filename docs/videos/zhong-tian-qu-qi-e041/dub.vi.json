{
  "zq41a01": {
    "text": "Ai bỏ tiền?",
    "emotion": "蹲到刁七面前，壓低聲音"
  },
  "zq41a02": {
    "text": "Một công tử phe phẩy quạt,",
    "emotion": "粗啞，學那人搖扇子",
    "say": "Công tử cầm quạt,"
  },
  "zq41a03": {
    "text": "phái người đến.",
    "emotion": "畫外，低"
  },
  "zq41a04": {
    "text": "Phe phẩy quạt…",
    "emotion": "想起什麼，慢下來"
  },
  "zq41a05": {
    "text": "Trong huyện thành, ta chỉ thấy một người.",
    "emotion": "冷下來"
  },
  "zq41a06": {
    "text": "Hắn nhận ra ta.",
    "emotion": "很輕，很冷"
  },
  "zq41a07": {
    "text": "Một trăm lượng,",
    "emotion": "粗啞"
  },
  "zq41a08": {
    "text": "chỉ cần người sống.",
    "emotion": "咧嘴，盯著阿令"
  },
  "zq41a09": {
    "text": "Một tú tài",
    "emotion": "低聲，對自己"
  },
  "zq41a10": {
    "text": "không giữ nổi cái nhà này.",
    "emotion": "咬牙"
  },
  "zq41a11": {
    "text": "Vậy thì phải có công danh.",
    "emotion": "下定決心",
    "say": "Phải có công danh."
  },
  "zq41a12": {
    "text": "Thi Hương ở châu thành,",
    "emotion": "撥著算盤，飛快"
  },
  "zq41a13": {
    "text": "mùng chín tháng sau.",
    "emotion": "算好了"
  },
  "zq41a14": {
    "text": "Một tháng?",
    "emotion": "傻眼"
  },
  "zq41a15": {
    "text": "Học thuộc Tứ thư Ngũ kinh?",
    "emotion": "現代人的哀號"
  },
  "zq41a16": {
    "text": "Ôi chà,",
    "emotion": "拖長音",
    "say": "Ôi,"
  },
  "zq41a17": {
    "text": "kẻ thi ba lần trượt.",
    "emotion": "冷笑"
  },
  "zq41a18": {
    "text": "Lần này,",
    "emotion": "笑出聲",
    "say": "Nay,"
  },
  "zq41a19": {
    "text": "thi lần thứ tư?",
    "emotion": "笑得肚子抖"
  },
  "zq41a20": {
    "text": "Tiền lão gia,",
    "emotion": "甜甜的"
  },
  "zq41a21": {
    "text": "sổ sách cuối cùng mới tính.",
    "emotion": "話裡帶刺"
  },
  "zq41a22": {
    "text": "Lần này đỗ,",
    "emotion": "笑，一字一字"
  },
  "zq41a23": {
    "text": "ông tới dập đầu.",
    "emotion": "很穩"
  },
  "zq41a24": {
    "text": "Được!",
    "emotion": "一愣，嘴硬"
  },
  "zq41a25": {
    "text": "Ta đợi đấy!",
    "emotion": "氣鼓鼓"
  },
  "zq41a26": {
    "text": "Nhiệm vụ bắt buộc: đỗ thi Hương.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq41a27": {
    "text": "Thất bại: hảo cảm ba vị thê tử giảm một nửa.",
    "emotion": "平板電子音，冷冷的",
    "say": "Thất bại: hảo cảm ba thê tử giảm nửa."
  },
  "zq41a28": {
    "text": "Giảm…",
    "emotion": "倒吸一口氣",
    "say": "Gi—"
  },
  "zq41a29": {
    "text": "Giảm một nửa?",
    "emotion": "破音"
  },
  "zq41a30": {
    "text": "Ta đi châu thành,",
    "emotion": "發愁"
  },
  "zq41a31": {
    "text": "ai giữ nhà?",
    "emotion": "看著一屋子人"
  },
  "zq41a32": {
    "text": "Ta ở lại.",
    "emotion": "淡，但很定"
  },
  "zq41a33": {
    "text": "Giữ nhà, giữ Tiểu Hòa.",
    "emotion": "主動"
  },
  "zq41a34": {
    "text": "A Lệnh.",
    "emotion": "輕聲，認真"
  },
  "zq41a35": {
    "text": "Nhà giao cho nàng.",
    "emotion": "畫外，鄭重"
  },
  "zq41a36": {
    "text": "Được.",
    "emotion": "很輕，第一次點頭"
  },
  "zq41a37": {
    "text": "A Lệnh hảo cảm, năm mươi tư.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq41a38": {
    "text": "Ta đi cùng ngươi.",
    "emotion": "爽快"
  },
  "zq41a39": {
    "text": "Dọc đường, ta bảo vệ.",
    "emotion": "拍拍刀柄"
  },
  "zq41a40": {
    "text": "Ta cũng đi!",
    "emotion": "搶著舉手"
  },
  "zq41a41": {
    "text": "Sổ sách châu thành, ta lo.",
    "emotion": "得意"
  },
  "zq41a42": {
    "text": "Được,",
    "emotion": "笑，拍板",
    "say": "Ừ,"
  },
  "zq41a43": {
    "text": "cùng vào châu thành.",
    "emotion": "笑"
  },
  "zq41a44": {
    "text": "Châu thành…",
    "emotion": "一愣"
  },
  "zq41a45": {
    "text": "…Được.",
    "emotion": "遲疑了一下才答"
  },
  "zq41a46": {
    "text": "Thi ba lần,",
    "emotion": "自言自語"
  },
  "zq41a47": {
    "text": "đã đọc những gì…",
    "emotion": "翻書"
  },
  "zq41a48": {
    "text": "Tần?",
    "emotion": "畫外，低聲唸出來"
  },
  "zq41a49": {
    "text": "Nguyên chủ…",
    "emotion": "皺眉"
  },
  "zq41a50": {
    "text": "giấu thứ này làm gì?",
    "emotion": "低聲"
  }
}
