    "thumbnail": "deec1670570d"
  },
  "lines": {
    "u101": {
      "source_hash": "944a09769ade",
      "text": "1955년 4월 12일, 네바다 상공."
    },
    "u103": {
      "source_hash": "2e964fd9cbe8",
      "text": "소형기의 4명이 시험 비행 장소를 찾습니다."
    },
    "u105": {
      "source_hash": "a30cf1d6ec1f",
      "text": "이 황무지의 지도 번호가 51구역입니다."
    },
    "u106": {
      "source_hash": "0f321c74b6ee",
      "text": "땅에 활주로 같은 직선이 있습니다."
    },
    "u107": {
      "source_hash": "29ff0d95dbff",
      "text": "아스팔트가 아닌 푸석한 흙입니다."
    },
    "u108": {
      "source_hash": "6c79bd2ddd4d",
      "text": "그 선에 내리면 뒤집힙니다."
    },
    "u114": {
      "source_hash": "2d384fcf686d",
      "text": "더 이상한 일이 있습니다."
    },
    "u115": {
      "source_hash": "d004ad9962b7",
      "text": "밤에 여객기 조종사가 상공의 불덩이를 봅니다."
    },
    "u116": {
      "source_hash": "52a38a623450",
      "text": "훗날 우주정거장에선 한 곳만 촬영 금지였습니다."
    },
    "u117": {
      "source_hash": "5bcad20cb794",
      "text": "1989년, 얼굴 가린 남자가 TV에서 격납고에 뭐가 있다고 했을까요?"
    },
    "u118": {
      "source_hash": "30b507273657",
      "text": "묘하게도 기지 직원 5명과 미망인 둘이 공군을 제소합니다."
    },
    "u113": {
      "source_hash": "69ab67363266",
      "text": "지도 번호 하나가 왜 58년이 지나서야 정식으로 인쇄됐을까요?"
    },
    "u201": {
      "source_hash": "aba11a452dcc",
      "text": "7월, 활주로를 깔고 입주합니다."
    },
    "u202": {
      "source_hash": "012b006e2353",
      "text": "설계 기술자가 이름을 짓습니다."
    },
    "u203": {
      "source_hash": "e804902c0f08",
      "text": "파라다이스 랜치. 일꾼들이 오도록."
    },
    "u204": {
      "source_hash": "15bd068ceec4",
      "text": "나중엔 그냥 '랜치'."
    },
    "u206": {
      "source_hash": "163d906062af",
      "text": "1960년대 말, 무선 호출명은 드림랜드였습니다."
    },
    "u207": {
      "source_hash": "6c09d4573d3e",
      "text": "8월 1일, 고속 활주 시험."
    },
    "u208": {
      "source_hash": "0dcda8eba983",
      "text": "저절로 떴습니다."
    },
    "u209": {
      "source_hash": "6591bb99c43f",
      "text": "조종사는 비행할 뜻이 없었답니다."
    },
    "u210": {
      "source_hash": "c288d6a991ab",
      "text": "8월 4일, 첫 계획 비행입니다."
    },
    "u211": {
      "source_hash": "d1983396c93c",
      "text": "8월 8일, 간부들 앞에서 공식 첫 비행."
    },
    "u212": {
      "source_hash": "eebd82ad4c46",
      "text": "3만 2천 피트까지 오릅니다."
    },
    "u213": {
      "source_hash": "0c187d3627b5",
      "text": "기술자의 약속은 8개월 내 비행."
    },
    "u214": {
      "source_hash": "75e53730c3af",
      "text": "해냈습니다."
    },
    "u215": {
      "source_hash": "007ead1f3013",
      "text": "10월 3일부터 캘리포니아발 정기편이 다닙니다."
    },
    "u216": {
      "source_hash": "7320058ffb8a",
      "text": "핵심 인원 월요일 도착, 금요일 복귀."
    },
    "u216b": {
      "source_hash": "b32e9c2339ac",
      "text": "취항 7주 이내."
    },
    "u217": {
      "source_hash": "1203c0c97554",
      "text": "11월 17일, 기지행 항공편이 추락합니다."
    },
    "u218": {
      "source_hash": "6bbe38008355",
      "text": "14명 전원이 숨졌습니다."
    },
    "u219": {
      "source_hash": "442e63f2911c",
      "text": "계획 최대의 참사였습니다."
    },
    "u220": {
      "source_hash": "abcd66ed8c69",
      "text": "얼마나 높이 날면 숨길 만할까요?"
    },
    "u301": {
      "source_hash": "20d3a5303410",
      "text": "7만 피트."
    },
    "u302": {
      "source_hash": "7863b0aef921",
      "text": "1953년 공군이 원한 고도입니다."
    },
    "u303": {
      "source_hash": "a92f7f45fbd7",
      "text": "U-2라는 기체, 날개가 가늘고 깁니다."
    },
    "u304": {
      "source_hash": "a91176ca7e63",
      "text": "당시 여객기는 1만~2만 피트."
    },
    "u305": {
      "source_hash": "d9a2c1ec65dd",
      "text": "폭격기는 높아야 4만 피트."
    },
    "u306": {
      "source_hash": "dfbbd5dafcfe",
      "text": "6만 피트 위는 불가능하다고 여겼습니다."
    },
    "u307": {
      "source_hash": "d31534c37740",
      "text": "그렇게 날았습니다."
    },
    "u308": {
      "source_hash": "b0fc27182521",
      "text": "관제탑에 이상한 신고가 늘어납니다."
    },
    "u309": {
      "source_hash": "43edacbcaf29",
      "text": "아까 그 여객기는 서쪽행, 이미 밤이었습니다."
    },
    "u310": {
      "source_hash": "b812e432421d",
      "text": "여객기 고도에선 해가 졌습니다."
    },
    "u311": {
      "source_hash": "ee04fc392bf6",
      "text": "4만 피트 위, 날개엔 아직 햇빛이 닿습니다."
    },
    "u312": {
      "source_hash": "80a84d05feb9",
      "text": "여객기 조종사 눈엔 그게 불덩이였습니다."
    },
    "u313": {
      "source_hash": "b3458c87e7eb",
      "text": "데이턴 공군에 편지도 보냅니다."
    },
    "u314": {
      "source_hash": "f04ff1b0818b",
      "text": "조사관은 워싱턴에 기록 대조 의뢰."
    },
    "u315": {
      "source_hash": "7dca921dc794",
      "text": "편지에 온 답장은 자연 현상이었습니다."
    },
    "u316": {
      "source_hash": "2cc4b5451c98",
      "text": "대부분 지워졌지만 이유는 못 밝혔습니다."
    },
    "u317": {
      "source_hash": "b8470ec24575",
      "text": "숨기려던 비행기 기억하십니까?"
    },
    "u318": {
      "source_hash": "0440d74f8054",
      "text": "CIA 자체 계획사의 한 문장."
    },
    "u319": {
      "source_hash": "6da434968b78",
      "text": "십여 년간 UFO 신고 절반 이상이 그것."
    },
    "u320": {
      "source_hash": "b477e36c45a1",
      "text": "쓴 건 역사가, 통계는 없습니다."
    },
    "u321": {
      "source_hash": "1647a08f72ba",
      "text": "1952년 여름에도 한 차례, 3년 앞서."
    },
    "u322": {
      "source_hash": "19350be5a7a4",
      "text": "블루북 신고는 1만 2천여 건."
    },
    "u323": {
      "source_hash": "997b77f0b706",
      "text": "종료 시 701건은 미해결이었습니다."
    },
    "u324": {
      "source_hash": "cfe214166123",
      "text": "1969년 말, 공군이 종결."
    },
    "u325": {
      "source_hash": "bedb3c7d56ad",
      "text": "결론의 한 줄: 미해결 건이 외계 비행체라는 증거는 없다."
    },
    "u326": {
      "source_hash": "121f19a47227",
      "text": "이제 그 사막엔 다른 기체가 납니다."
    },
    "u401": {
      "source_hash": "df74c92d23d3",
      "text": "1962년 4월, 새 비행기가 이곳에서 첫 비행합니다."
    },
    "u402": {
      "source_hash": "ce1d3fd8e8b6",
      "text": "A-12, 설계 속도는 음속의 3배입니다."
    },
    "u403": {
      "source_hash": "bb9f6d185ade",
      "text": "설계 고도 9만 피트, 앞의 기체보다 높고 빠릅니다."
    },
    "u404": {
      "source_hash": "88706911ba77",
      "text": "1967년 CIA 문서가 이곳을 언급합니다."
    },
    "u406": {
      "source_hash": "6d47364935a3",
      "text": "거기 인쇄된 게 바로 그 이름입니다."
    },
    "u407": {
      "source_hash": "c33792dacc84",
      "text": "후일 청구인은 의도치 않았다고 합니다."
    },
    "u408": {
      "source_hash": "1fb0b0e5b9a3",
      "text": "의도적 인정이 아니라, 지나가듯 언급."
    },
    "u409": {
      "source_hash": "3c6c794ca421",
      "text": "기묘하게도 이듬해 정부가 직접 찍습니다."
    },
    "u410": {
      "source_hash": "7731c2a35a34",
      "text": "1968년 정부 항공사진입니다."
    },
    "u411": {
      "source_hash": "421811aadc53",
      "text": "늘 공개 기록관에 있었습니다."
    },
    "u411b": {
      "source_hash": "e79f00d7753c",
      "text": "1959년 사진 한 장도 같은 곳에 있습니다."
    },
    "u412": {
      "source_hash": "ffbc545ff1e7",
      "text": "하늘에서 보면 활주로가 뚜렷합니다."
    },
    "u413": {
      "source_hash": "1cf1bc5a2d00",
      "text": "훗날 우주정거장에서도 찍힙니다."
    },
    "u414": {
      "source_hash": "946698c38bb4",
      "text": "그 촬영 금지 장소가 여기입니다."
    },
    "u415": {
      "source_hash": "9ad66a13d744",
      "text": "1974년 메모엔:"
    },
    "u416": {
      "source_hash": "f414b62b2b35",
      "text": "\"하지 말라는 분명한 지시가 있었다.\""
    },
    "u417": {
      "source_hash": "1bf8926ba597",
      "text": "이 무렵 남의 비행기도 연구합니다."
    },
    "u418": {
      "source_hash": "3f11f01e5836",
      "text": "입수한 소련 미그기입니다."
    },
    "u419": {
      "source_hash": "f8f6a3e03bfa",
      "text": "1977년, 스텔스 실증기가 첫 비행합니다."
    },
    "u420": {
      "source_hash": "7538c3f43d9e",
      "text": "위치는 알려졌고,"
    },
    "u421": {
      "source_hash": "15c4ac7b2a60",
      "text": "비밀은 이름."
    },
    "u501": {
      "source_hash": "e82b54357756",
      "text": "12년 뒤, TV에 이곳이 등장합니다."
    },
    "u502": {
      "source_hash": "e83fb9999957",
      "text": "1989년, 라스베이거스 TV의 인터뷰입니다."
    },
    "u503": {
      "source_hash": "4293ee0043a1",
      "text": "얼굴 가린 남자, 가명이었습니다."
    },
    "u504": {
      "source_hash": "ced4dbb50d77",
      "text": "그는 이곳 남쪽 S-4에서 일했다고 합니다."
    },
    "u505": {
      "source_hash": "7b253ac42ce7",
      "text": "한 격납고에 비행접시 9대."
    },
    "u506": {
      "source_hash": "576b8334c0be",
      "text": "그는 동력이 원소 115라는 물질이라고 합니다."
    },
    "u507": {
      "source_hash": "9ab802b34e93",
      "text": "그해 안에 본명이 공개됐습니다."
    },
    "u508": {
      "source_hash": "8cc903f739d9",
      "text": "뒷받침하는 문서는 하나도 없습니다."
    },
    "u509": {
      "source_hash": "159ae58a130c",
      "text": "그가 다녔다는 두 학교에 기록이 없습니다."
    },
    "u510": {
      "source_hash": "755c4777d887",
      "text": "뜻밖에도 더 오래된 이야기가 이어 붙습니다."
    },
    "u511": {
      "source_hash": "d021d4f476c6",
      "text": "1947년 7월, 로즈웰 육군 비행장의 보도자료."
    },
    "u512": {
      "source_hash": "5d72a9ae7010",
      "text": "비행접시를 회수했다는 내용입니다."
    },
    "u513": {
      "source_hash": "953b31d030c1",
      "text": "이튿날 정정: 레이더 추적용 기상 풍선."
    },
    "u514": {
      "source_hash": "9ab1eb49d63a",
      "text": "1994년 공군이 재조사합니다."
    },
    "u515": {
      "source_hash": "b9ed9b5b21a4",
      "text": "가장 유력한 출처는 기밀 풍선 계획의 잔해였습니다."
    },
    "u516": {
      "source_hash": "89cc56841911",
      "text": "로즈웰은 뉴멕시코에 있습니다."
    },
    "u517": {
      "source_hash": "b215002618de",
      "text": "이곳은 네바다, 1000km 넘는 거리."
    },
    "u518": {
      "source_hash": "7fbe921acba6",
      "text": "잔해를 옮긴 기록은 하나도 없습니다."
    },
    "u519": {
      "source_hash": "139fcc765d38",
      "text": "그런데도 두 이야기는 그때부터 붙어 다닙니다."
    },
    "u520": {
      "source_hash": "6356f682b5e0",
      "text": "정부 스스로는 뭐라 불렀을까요?"
    },
    "u601": {
      "source_hash": "16242f811102",
      "text": "1995년 9월, 대통령이 서명한 명령."
    },
    "u602": {
      "source_hash": "1f469311d2a8",
      "text": "명령 속 명칭은 '그룸 레이크 인근 공군 운영 거점'입니다."
    },
    "u603": {
      "source_hash": "3ac5bcc03001",
      "text": "유해 폐기물 정보 공개를 면제합니다."
    },
    "u604": {
      "source_hash": "ef8f099f0c2f",
      "text": "기밀이 샌다는 이유."
    },
    "u607": {
      "source_hash": "a503daa7540b",
      "text": "해마다 서명돼, 연방 관보엔 모두 9건입니다."
    },
    "u608": {
      "source_hash": "a716ca090baa",
      "text": "1996년 대통령의 의회 서한이 소송과 잇습니다."
    },
    "u609": {
      "source_hash": "319ee2510a0d",
      "text": "그 5명과 미망인 2명이 공군과 환경보호청을 제소."
    },
    "u610": {
      "source_hash": "f8bf54aa0445",
      "text": "기지가 유해 화학물질을 드럼통에 태웠다는 주장."
    },
    "u611": {
      "source_hash": "81ca3350c998",
      "text": "공군 장관은 국가기밀 특권을 내세웁니다."
    },
    "u612": {
      "source_hash": "7c2b0513ce45",
      "text": "1998년 1월, 법원은 기각했습니다."
    },
    "u613": {
      "source_hash": "8d73f29e935a",
      "text": "이유는 이 사안 자체가 국가기밀이라는 것입니다."
    },
    "u614": {
      "source_hash": "0698aa93f515",
      "text": "법원이 쓴 논리는 모자이크 이론."
    },
    "u615": {
      "source_hash": "6aabac98af5c",
      "text": "하나씩은 괜찮아도, 모으면 기밀이 샙니다."
    },
    "u616": {
      "source_hash": "65ec3da22082",
      "text": "유해 폐기물이 있는지조차 기밀입니다."
    },
    "u617": {
      "source_hash": "21929cf5c9cd",
      "text": "더 기묘하게도, 같은 해 CIA는 이 역사서의 첫 공개판을 냈습니다."
    },
    "u618": {
      "source_hash": "8112b543f8fb",
      "text": "272쪽, 이곳 관련 문장은 모두 먹칠입니다."
    },
    "u619": {
      "source_hash": "2dd20359c151",
      "text": "이 먹칠, 나중에 다시 봅니다."
    },
    "u620": {
      "source_hash": "aee01e8d4d79",
      "text": "2년 뒤, 러시아 위성사진이 공개됩니다."
    },
    "u621": {
      "source_hash": "d5c0cd3aa522",
      "text": "흑백, 해상도 2미터, 이곳이 보입니다."
    },
    "u621b": {
      "source_hash": "efad50047847",
      "text": "확인되는 마지막 명령은 2003년입니다."
    },
    "u622": {
      "source_hash": "34de49959cac",
      "text": "2005년 한 연구자가 청구합니다."
    },
    "u623": {
      "source_hash": "ab24a05dca15",
      "text": "요구는 간단합니다. 같은 책, 먹칠은 덜."
    },
    "u624": {
      "source_hash": "4d9f558b3e2a",
      "text": "기다립니다."
    },
    "u701": {
      "source_hash": "b5eca92d284f",
      "text": "2013년 6월 25일, CIA가 공개 승인."
    },
    "u702": {
      "source_hash": "c88d04322f44",
      "text": "청구에서 승인까지 8년입니다."
    },
    "u703": {
      "source_hash": "6ec0041abf2b",
      "text": "8월 15일, 기록관이 웹에 올립니다."
    },
    "u705": {
      "source_hash": "d096620efaca",
      "text": "구판에 없던 지도."
    },
    "u706": {
      "source_hash": "afe715c65e99",
      "text": "58년 기다린 그 번호가 신판에 실렸습니다."
    },
    "u707": {
      "source_hash": "5079d443011d",
      "text": "58쪽 전체가 지도입니다."
    },
    "u707b": {
      "source_hash": "aef67108aff7",
      "text": "오른쪽 아래엔 라스베이거스."
    },
    "u708": {
      "source_hash": "dd9cd3ea449d",
      "text": "조종사 이름, 암호명, 예산도 돌아왔습니다."
    },
    "u709": {
      "source_hash": "15d3d8056098",
      "text": "'CIA 마침내 존재 인정' 제목은 다소 부정확."
    },
    "u710": {
      "source_hash": "186bd02f4b90",
      "text": "그 1967년 문서는?"
    },
    "u711": {
      "source_hash": "5ae4eb24082e",
      "text": "그의 기억으론 그런 옛 문서가 최소 2건."
    },
    "u712": {
      "source_hash": "3b7f0d659b93",
      "text": "로이터의 표현은 '최초의 의도적 공식 언급'입니다."
    },
    "u713": {
      "source_hash": "7ffa10708885",
      "text": "그 먹칠, 기억하십니까?"
    },
    "u714": {
      "source_hash": "e74dc4ae16b9",
      "text": "신판에도 많고, 다른 내부사도 다 공개되진 않았습니다."
    },
    "u715": {
      "source_hash": "32acd1ff69c2",
      "text": "TV의 비행접시 9대는?"
    },
    "u716": {
      "source_hash": "42424aeb1382",
      "text": "CIA 대변인은 외계인 언급은 하나도 없다고 했습니다."
    },
    "u718": {
      "source_hash": "6709c2d5d407",
      "text": "지금 공식 설명은 훈련장의 일부입니다."
    },
    "u719": {
      "source_hash": "d6a2b5bf3ce8",
      "text": "지금 무엇을 시험하는지는 여전히 기밀입니다."
    },
    "u722": {
      "source_hash": "d6d5794b3a06",
      "text": "이 파일의 도장은 '미결'입니다."
    },
    "u723": {
      "source_hash": "5d8ecb7c1383",
      "text": "그 번호는 이제 공개 지도 위 작은 직사각형."
    },
    "u724": {
      "source_hash": "d09668c5fa01",
      "text": "이름을 처음 들은 영화는?"
    },
    "u725": {
      "source_hash": "64515e0bf5a8",
      "text": "문서에 있는 것만 말합니다. 같이 파일을 열려면 구독을."
    }
  }
}
