{
  "zq44a01": {
    "text": "J-jovem…",
    "emotion": "聲音發顫",
    "say": "Jo…"
  },
  "zq44a02": {
    "text": "Jovem general?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "Você se enganou de pessoa.",
    "emotion": "冷，壓低聲音",
    "say": "Se enganou."
  },
  "zq44a04": {
    "text": "Este humilde soldado, Du Tie,",
    "emotion": "嗓門大，一字一字",
    "say": "Sou Du Tie,"
  },
  "zq44a05": {
    "text": "saúda a jovem general!",
    "emotion": "彎腰行軍禮",
    "say": "jovem general!"
  },
  "zq44a06": {
    "text": "Quem ele chamou agora?",
    "emotion": "皺眉，轉頭",
    "say": "Chamou quem?"
  },
  "zq44a07": {
    "text": "Que general?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "É minha esposa,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "parecida, né?",
    "emotion": "對巡兵",
    "say": "Parecida?"
  },
  "zq44a10": {
    "text": "Parecida!",
    "emotion": "會過意來，大聲",
    "say": "Sim!"
  },
  "zq44a11": {
    "text": "Igualzinha!",
    "emotion": "拍腿"
  },
  "zq44a12": {
    "text": "Tio,",
    "emotion": "撿起木拐遞過去",
    "say": "Ei,"
  },
  "zq44a13": {
    "text": "Uma bebida?",
    "emotion": "笑",
    "say": "Um trago?"
  },
  "zq44a14": {
    "text": "Servi no exército dos Qin,",
    "emotion": "抹嘴，眼神遠了",
    "say": "Servi os Qin,"
  },
  "zq44a15": {
    "text": "carreguei a bandeira por vinte anos.",
    "emotion": "驕傲又沙啞",
    "say": "vinte anos de bandeira."
  },
  "zq44a16": {
    "text": "Esta perna",
    "emotion": "畫外，沉聲"
  },
  "zq44a17": {
    "text": "ficou na fronteira norte.",
    "emotion": "畫外，苦澀",
    "say": "ficou no norte."
  },
  "zq44a18": {
    "text": "Então ela…",
    "emotion": "放低聲音",
    "say": "E ela?"
  },
  "zq44a19": {
    "text": "é jovem general de quem?",
    "emotion": "試探",
    "say": "general de quem?"
  },
  "zq44a20": {
    "text": "O pai dela",
    "emotion": "低聲，說完就停",
    "say": "O pai,"
  },
  "zq44a21": {
    "text": "é o general Guardião do Norte, Qin Lieshan.",
    "emotion": "沉聲，乾脆",
    "say": "é o Guardião do Norte, Qin Lieshan."
  },
  "zq44a22": {
    "text": "A corte diz que ele",
    "emotion": "咬牙",
    "say": "A corte diz"
  },
  "zq44a23": {
    "text": "vendeu os mapas de defesa da fronteira a Shuomo.",
    "emotion": "一字一字",
    "say": "vendeu mapas de defesa a Shuomo."
  },
  "zq44a24": {
    "text": "A casa dos Qin foi confiscada,",
    "emotion": "畫外，聲音啞",
    "say": "Confiscaram tudo,"
  },
  "zq44a25": {
    "text": "todos se dispersaram.",
    "emotion": "畫外",
    "say": "fugiram."
  },
  "zq44a26": {
    "text": "Não acredito!",
    "emotion": "拍桌",
    "say": "Não!"
  },
  "zq44a27": {
    "text": "O general nunca trairia o reino!",
    "emotion": "眼眶紅",
    "say": "O general não é traidor!"
  },
  "zq44a28": {
    "text": "Perfil atualizado:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "Qin Shuang, filha do general Guardião do Norte.",
    "emotion": "平板電子音",
    "say": "Qin Shuang, filha do general."
  },
  "zq44a30": {
    "text": "Tio,",
    "emotion": "放下酒壺"
  },
  "zq44a31": {
    "text": "descubra onde está o general.",
    "emotion": "認真",
    "say": "ache o general."
  },
  "zq44a32": {
    "text": "Esta minha vida",
    "emotion": "低聲，堅定",
    "say": "Minha vida"
  },
  "zq44a33": {
    "text": "sempre foi dos Qin.",
    "emotion": "點頭",
    "say": "é dos Qin."
  },
  "zq44a34": {
    "text": "Ela…",
    "emotion": "聲音一軟",
    "say": "Ela"
  },
  "zq44a35": {
    "text": "ela está bem?",
    "emotion": "輕聲",
    "say": "feliz?"
  },
  "zq44a36": {
    "text": "Ela já sorri.",
    "emotion": "溫柔",
    "say": "Já sorri."
  },
  "zq44a37": {
    "text": "Se ela sorri, está bom,",
    "emotion": "眼含淚，聲音發顫",
    "say": "Que bom,"
  },
  "zq44a38": {
    "text": "está bom.",
    "emotion": "輕聲，乾脆",
    "say": "bom."
  },
  "zq44a39": {
    "text": "A Qin Shuang não falou nada o dia todo,",
    "emotion": "探頭進門，壓低聲音",
    "say": "A Qin tá calada,"
  },
  "zq44a40": {
    "text": "vai consolar ela.",
    "emotion": "壓低聲音，催他",
    "say": "Vai lá."
  },
  "zq44a41": {
    "text": "Eu?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "De onde veio isto?",
    "emotion": "一把抓起，聲音發緊",
    "say": "De onde é?"
  },
  "zq44a43": {
    "text": "Num velho baú de livros",
    "emotion": "小心",
    "say": "Num baú"
  },
  "zq44a44": {
    "text": "eu achei.",
    "emotion": "小心"
  },
  "zq44a45": {
    "text": "…Nada.",
    "emotion": "低頭，把情緒壓回去"
  },
  "zq44a46": {
    "text": "Aquele senhor de hoje",
    "emotion": "輕聲",
    "say": "O tio de hoje"
  },
  "zq44a47": {
    "text": "me falou da sua família.",
    "emotion": "老實說",
    "say": "falou da sua família."
  },
  "zq44a48": {
    "text": "O que mais ele disse?",
    "emotion": "不回頭，聲音很低",
    "say": "Que mais?"
  },
  "zq44a49": {
    "text": "Disse que seu pai",
    "emotion": "一字一字"
  },
  "zq44a50": {
    "text": "não é traidor.",
    "emotion": "篤定"
  },
  "zq44a51": {
    "text": "Se eu for filha de um condenado,",
    "emotion": "背著他，聲音發抖",
    "say": "Filha de um condenado…"
  },
  "zq44a52": {
    "text": "ainda me quer?",
    "emotion": "幾乎聽不見"
  }
}
