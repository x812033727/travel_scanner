{
  "zq44a01": {
    "text": "Tiểu…",
    "emotion": "聲音發緊，短促"
  },
  "zq44a02": {
    "text": "Tiểu tướng quân?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "Nhận nhầm người rồi.",
    "emotion": "冷，壓低聲音",
    "say": "Nhầm người rồi."
  },
  "zq44a04": {
    "text": "Mạt tướng Đỗ Thiết,",
    "emotion": "嗓門大，一字一字"
  },
  "zq44a05": {
    "text": "bái kiến tiểu tướng quân!",
    "emotion": "彎腰行軍禮"
  },
  "zq44a06": {
    "text": "Vừa gọi ai thế?",
    "emotion": "皺眉，轉頭",
    "say": "Gọi ai thế?"
  },
  "zq44a07": {
    "text": "Tướng quân gì?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "Nương tử nhà ta,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "giống lắm hả?",
    "emotion": "對巡兵",
    "say": "giống hả?"
  },
  "zq44a10": {
    "text": "Giống!",
    "emotion": "會過意來，大聲"
  },
  "zq44a11": {
    "text": "Giống thật!",
    "emotion": "大聲"
  },
  "zq44a12": {
    "text": "Lão bá,",
    "emotion": "撿起木拐遞過去"
  },
  "zq44a13": {
    "text": "làm một bát nhé?",
    "emotion": "笑",
    "say": "một bát?"
  },
  "zq44a14": {
    "text": "Ta ở Tần gia quân,",
    "emotion": "眼神遠了"
  },
  "zq44a15": {
    "text": "vác cờ hai mươi năm.",
    "emotion": "驕傲又沙啞"
  },
  "zq44a16": {
    "text": "Cái chân này,",
    "emotion": "畫外，沉聲"
  },
  "zq44a17": {
    "text": "để lại ở Bắc Cương rồi.",
    "emotion": "畫外，苦澀",
    "say": "bỏ lại Bắc Cương."
  },
  "zq44a18": {
    "text": "Vậy nàng ấy…",
    "emotion": "放低聲音",
    "say": "Vậy nàng…"
  },
  "zq44a19": {
    "text": "là tiểu tướng quân nhà ai?",
    "emotion": "試探"
  },
  "zq44a20": {
    "text": "Phụ thân cô ấy",
    "emotion": "低聲，快",
    "say": "Cha nàng,"
  },
  "zq44a21": {
    "text": "là Trấn Bắc tướng quân Tần Liệt Sơn.",
    "emotion": "沉聲，乾脆"
  },
  "zq44a22": {
    "text": "Triều đình nói ông ấy",
    "emotion": "咬牙",
    "say": "Triều đình bảo"
  },
  "zq44a23": {
    "text": "bán bản đồ quan phòng cho Sóc Mạc.",
    "emotion": "一字一字"
  },
  "zq44a24": {
    "text": "Tần gia bị tịch biên,",
    "emotion": "畫外，聲音啞",
    "say": "Bị tịch biên,"
  },
  "zq44a25": {
    "text": "người đều tan tác cả.",
    "emotion": "畫外",
    "say": "người tan tác cả."
  },
  "zq44a26": {
    "text": "Ta không tin!",
    "emotion": "怒，短促",
    "say": "Không!"
  },
  "zq44a27": {
    "text": "Tướng quân không bán nước!",
    "emotion": "眼眶紅"
  },
  "zq44a28": {
    "text": "Cập nhật thông tin nhân vật:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "Tần Sương, con gái Trấn Bắc tướng quân.",
    "emotion": "平板電子音"
  },
  "zq44a30": {
    "text": "Lão bá,",
    "emotion": "放下酒壺"
  },
  "zq44a31": {
    "text": "giúp ta dò la tung tích tướng quân.",
    "emotion": "認真",
    "say": "dò tin tướng quân giúp ta."
  },
  "zq44a32": {
    "text": "Cái mạng này của ta",
    "emotion": "低聲，堅定",
    "say": "Mạng ta"
  },
  "zq44a33": {
    "text": "vốn là của Tần gia.",
    "emotion": "點頭"
  },
  "zq44a34": {
    "text": "Tiểu thư…",
    "emotion": "聲音一軟",
    "say": "Tiểu thư"
  },
  "zq44a35": {
    "text": "sống có tốt không?",
    "emotion": "輕聲",
    "say": "có tốt không?"
  },
  "zq44a36": {
    "text": "Nàng biết cười rồi.",
    "emotion": "溫柔"
  },
  "zq44a37": {
    "text": "Biết cười là tốt,",
    "emotion": "眼含淚，輕聲",
    "say": "Tốt rồi,"
  },
  "zq44a38": {
    "text": "biết cười là tốt.",
    "emotion": "輕聲，乾脆",
    "say": "tốt rồi."
  },
  "zq44a39": {
    "text": "Tần tỷ tỷ cả ngày không nói gì,",
    "emotion": "探頭進門，壓低聲音",
    "say": "Tần tỷ cả ngày im lặng,"
  },
  "zq44a40": {
    "text": "huynh đi dỗ đi.",
    "emotion": "壓低聲音，催他",
    "say": "Đi dỗ đi."
  },
  "zq44a41": {
    "text": "Ta?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "Cái này ở đâu ra?",
    "emotion": "一把抓起，聲音發緊",
    "say": "Ở đâu ra?"
  },
  "zq44a43": {
    "text": "Trong rương sách cũ,",
    "emotion": "小心",
    "say": "Rương cũ,"
  },
  "zq44a44": {
    "text": "lục ra được.",
    "emotion": "小心"
  },
  "zq44a45": {
    "text": "…Không có gì.",
    "emotion": "低頭，把情緒壓回去"
  },
  "zq44a46": {
    "text": "Lão bá hôm nay",
    "emotion": "輕聲",
    "say": "Lão bá ấy"
  },
  "zq44a47": {
    "text": "kể chuyện nhà nàng.",
    "emotion": "老實說"
  },
  "zq44a48": {
    "text": "Ông ấy còn nói gì?",
    "emotion": "不回頭，聲音很低",
    "say": "Còn nói gì?"
  },
  "zq44a49": {
    "text": "Ông ấy nói cha nàng",
    "emotion": "一字一字",
    "say": "Ông nói cha nàng"
  },
  "zq44a50": {
    "text": "không bán nước.",
    "emotion": "篤定"
  },
  "zq44a51": {
    "text": "Nếu ta là con gái tội nhân,",
    "emotion": "背著他，聲音發抖"
  },
  "zq44a52": {
    "text": "ngươi còn muốn ta không?",
    "emotion": "幾乎聽不見"
  }
}
