{
  "zq44a01": {
    "text": "소, 소……",
    "emotion": "聲音發顫"
  },
  "zq44a02": {
    "text": "소장군?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "사람 잘못 봤어요.",
    "emotion": "冷，壓低聲音",
    "say": "잘못 봤어요."
  },
  "zq44a04": {
    "text": "말장 두톄,",
    "emotion": "嗓門大，一字一字"
  },
  "zq44a05": {
    "text": "소장군을 뵙습니다!",
    "emotion": "彎腰行軍禮"
  },
  "zq44a06": {
    "text": "방금 누굴 불렀지?",
    "emotion": "皺眉，轉頭",
    "say": "누굴 불렀지?"
  },
  "zq44a07": {
    "text": "무슨 장군?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "우리 집사람인데요,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "닮았죠?",
    "emotion": "對巡兵"
  },
  "zq44a10": {
    "text": "닮았어!",
    "emotion": "會過意來，大聲"
  },
  "zq44a11": {
    "text": "똑 닮았어!",
    "emotion": "拍腿"
  },
  "zq44a12": {
    "text": "어르신,",
    "emotion": "撿起木拐遞過去"
  },
  "zq44a13": {
    "text": "한잔하실래요?",
    "emotion": "笑",
    "say": "한잔?"
  },
  "zq44a14": {
    "text": "나는 진가군에서,",
    "emotion": "抹嘴，眼神遠了",
    "say": "진가군에서,"
  },
  "zq44a15": {
    "text": "이십 년 깃발을 멨지.",
    "emotion": "驕傲又沙啞"
  },
  "zq44a16": {
    "text": "이 다리는,",
    "emotion": "畫外，拍一下膝蓋"
  },
  "zq44a17": {
    "text": "북방 변경에 두고 왔지.",
    "emotion": "畫外，笑得苦"
  },
  "zq44a18": {
    "text": "그럼 저 사람은……",
    "emotion": "放低聲音",
    "say": "그분은……"
  },
  "zq44a19": {
    "text": "어느 집 소장군입니까?",
    "emotion": "試探",
    "say": "어느 집 소장군?"
  },
  "zq44a20": {
    "text": "그분 부친이,",
    "emotion": "壓低聲音",
    "say": "부친,"
  },
  "zq44a21": {
    "text": "진북장군 친례산이오.",
    "emotion": "一字一頓"
  },
  "zq44a22": {
    "text": "조정에선 그분이,",
    "emotion": "咬牙",
    "say": "조정은,"
  },
  "zq44a23": {
    "text": "삭막에 관방도를 팔았다고 했소.",
    "emotion": "一字一字"
  },
  "zq44a24": {
    "text": "진가는 가산을 몰수당하고,",
    "emotion": "畫外，聲音啞",
    "say": "다 몰수되고,"
  },
  "zq44a25": {
    "text": "다 흩어졌소.",
    "emotion": "畫外"
  },
  "zq44a26": {
    "text": "난 못 믿어!",
    "emotion": "怒，短促",
    "say": "아냐!"
  },
  "zq44a27": {
    "text": "장군은 나라를 팔 분이 아니야!",
    "emotion": "眼眶紅",
    "say": "나라 팔 분이 아니야!"
  },
  "zq44a28": {
    "text": "인물 정보 업데이트:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "친솽, 진북장군의 딸.",
    "emotion": "平板電子音"
  },
  "zq44a30": {
    "text": "어르신,",
    "emotion": "放下酒壺"
  },
  "zq44a31": {
    "text": "장군의 행방을 알아봐 주세요.",
    "emotion": "認真",
    "say": "장군을 찾아 주세요."
  },
  "zq44a32": {
    "text": "내 이 목숨은,",
    "emotion": "低聲，堅定",
    "say": "이 목숨,"
  },
  "zq44a33": {
    "text": "원래 진가의 것이오.",
    "emotion": "點頭",
    "say": "본래 진가 거요."
  },
  "zq44a34": {
    "text": "그 아이는……",
    "emotion": "輕聲，說得快",
    "say": "아씨"
  },
  "zq44a35": {
    "text": "잘 지내고 있소?",
    "emotion": "輕聲",
    "say": "잘 지내오?"
  },
  "zq44a36": {
    "text": "이제 웃어요.",
    "emotion": "輕輕一笑"
  },
  "zq44a37": {
    "text": "웃으면 됐어,",
    "emotion": "笑出眼淚"
  },
  "zq44a38": {
    "text": "웃으면 됐어.",
    "emotion": "仰頭又灌一口",
    "say": "됐어."
  },
  "zq44a39": {
    "text": "친 언니가 종일 말이 없어,",
    "emotion": "探頭進門，壓低聲音",
    "say": "언니가 종일 말이 없어,"
  },
  "zq44a40": {
    "text": "가서 달래 줘.",
    "emotion": "壓低聲音，催他",
    "say": "달래 줘."
  },
  "zq44a41": {
    "text": "나?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "이거 어디서 났어?",
    "emotion": "一把抓起，聲音發緊",
    "say": "이거 어디서?"
  },
  "zq44a43": {
    "text": "낡은 책 상자에서,",
    "emotion": "小心",
    "say": "책 상자에서,"
  },
  "zq44a44": {
    "text": "찾았어.",
    "emotion": "小心"
  },
  "zq44a45": {
    "text": "……아무것도 아니야.",
    "emotion": "低頭，把情緒壓回去",
    "say": "아무것도."
  },
  "zq44a46": {
    "text": "오늘 그 어르신이,",
    "emotion": "輕聲",
    "say": "그 노인이,"
  },
  "zq44a47": {
    "text": "네 집안 얘길 했어.",
    "emotion": "老實說",
    "say": "집안 얘길 했어."
  },
  "zq44a48": {
    "text": "또 무슨 말을 했어?",
    "emotion": "不回頭，聲音很低",
    "say": "또 뭐래?"
  },
  "zq44a49": {
    "text": "네 아버지는,",
    "emotion": "一字一字"
  },
  "zq44a50": {
    "text": "나라를 팔 분이 아니라고.",
    "emotion": "篤定",
    "say": "나라 안 팔았대."
  },
  "zq44a51": {
    "text": "내가 죄인의 딸이라면,",
    "emotion": "背著他，聲音發抖"
  },
  "zq44a52": {
    "text": "그래도 날 원해?",
    "emotion": "幾乎聽不見"
  }
}
