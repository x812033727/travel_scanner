{
  "zq44a01": {
    "text": "J-joven…",
    "emotion": "聲音發顫",
    "say": "Jo…"
  },
  "zq44a02": {
    "text": "¿Joven general?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "Se equivoca de persona.",
    "emotion": "冷，壓低聲音",
    "say": "Se equivoca."
  },
  "zq44a04": {
    "text": "Este humilde soldado, Du Tie,",
    "emotion": "嗓門大，一字一字",
    "say": "Soy Du Tie,"
  },
  "zq44a05": {
    "text": "¡saluda a la joven general!",
    "emotion": "彎腰行軍禮",
    "say": "¡joven general!"
  },
  "zq44a06": {
    "text": "¿A quién llamó así?",
    "emotion": "皺眉，轉頭",
    "say": "¿A quién?"
  },
  "zq44a07": {
    "text": "¿Qué general?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "Es mi esposa,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "se parece, ¿no?",
    "emotion": "對巡兵",
    "say": "¿Se parece?"
  },
  "zq44a10": {
    "text": "¡Se parece!",
    "emotion": "會過意來，大聲",
    "say": "¡Sí!"
  },
  "zq44a11": {
    "text": "¡Igualita!",
    "emotion": "拍腿"
  },
  "zq44a12": {
    "text": "Señor,",
    "emotion": "撿起木拐遞過去",
    "say": "Oiga,"
  },
  "zq44a13": {
    "text": "¿Un trago?",
    "emotion": "笑"
  },
  "zq44a14": {
    "text": "Serví en el ejército de los Qin,",
    "emotion": "抹嘴，眼神遠了",
    "say": "Serví a los Qin,"
  },
  "zq44a15": {
    "text": "llevé su estandarte veinte años.",
    "emotion": "驕傲又沙啞",
    "say": "fui su abanderado."
  },
  "zq44a16": {
    "text": "Esta pierna",
    "emotion": "畫外，沉聲"
  },
  "zq44a17": {
    "text": "se quedó en la frontera norte.",
    "emotion": "畫外，笑得苦",
    "say": "quedó en el norte."
  },
  "zq44a18": {
    "text": "Entonces ella…",
    "emotion": "放低聲音",
    "say": "¿Y ella?"
  },
  "zq44a19": {
    "text": "¿de quién es esa joven general?",
    "emotion": "試探",
    "say": "¿general de quién?"
  },
  "zq44a20": {
    "text": "Su padre",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Padre:"
  },
  "zq44a21": {
    "text": "es el general Guardián del Norte, Qin Lieshan.",
    "emotion": "沉聲，乾脆",
    "say": "es el Guardián del Norte, Qin Lieshan."
  },
  "zq44a22": {
    "text": "La corte dice que él",
    "emotion": "低聲，乾脆",
    "say": "La corte dice"
  },
  "zq44a23": {
    "text": "vendió los mapas de defensa de la frontera a Shuomo.",
    "emotion": "一字一字",
    "say": "vendió mapas de defensa a Shuomo."
  },
  "zq44a24": {
    "text": "A los Qin les confiscaron todo,",
    "emotion": "畫外，聲音啞",
    "say": "Los Qin cayeron,"
  },
  "zq44a25": {
    "text": "todos se dispersaron.",
    "emotion": "畫外，低聲，乾脆",
    "say": "huyeron."
  },
  "zq44a26": {
    "text": "¡No lo creo!",
    "emotion": "怒",
    "say": "¡No!"
  },
  "zq44a27": {
    "text": "¡El general jamás traicionaría al reino!",
    "emotion": "眼眶紅",
    "say": "¡El general no es traidor!"
  },
  "zq44a28": {
    "text": "Perfil actualizado:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "Qin Shuang, hija del general Guardián del Norte.",
    "emotion": "平板電子音",
    "say": "Qin Shuang, hija del general."
  },
  "zq44a30": {
    "text": "Señor,",
    "emotion": "放下酒壺",
    "say": "Oiga,"
  },
  "zq44a31": {
    "text": "averigüe dónde está el general.",
    "emotion": "認真",
    "say": "busque al general."
  },
  "zq44a32": {
    "text": "Esta vida mía",
    "emotion": "低聲，堅定",
    "say": "Mi vida"
  },
  "zq44a33": {
    "text": "siempre fue de los Qin.",
    "emotion": "點頭",
    "say": "es de los Qin."
  },
  "zq44a34": {
    "text": "Ella…",
    "emotion": "輕聲，說得快",
    "say": "Ella"
  },
  "zq44a35": {
    "text": "¿está bien?",
    "emotion": "輕聲",
    "say": "¿feliz?"
  },
  "zq44a36": {
    "text": "Ya sonríe.",
    "emotion": "溫柔"
  },
  "zq44a37": {
    "text": "Si sonríe, está bien,",
    "emotion": "眼含淚，聲音發顫",
    "say": "Qué bien,"
  },
  "zq44a38": {
    "text": "está bien.",
    "emotion": "輕聲",
    "say": "bien."
  },
  "zq44a39": {
    "text": "La hermana Qin no ha hablado en todo el día,",
    "emotion": "探頭進門，壓低聲音",
    "say": "Qin lleva el día callada,"
  },
  "zq44a40": {
    "text": "ve a consolarla.",
    "emotion": "壓低聲音，催他",
    "say": "Ve con ella."
  },
  "zq44a41": {
    "text": "¿Yo?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "¿De dónde salió esto?",
    "emotion": "一把抓起，聲音發緊",
    "say": "¿De dónde es?"
  },
  "zq44a43": {
    "text": "En un viejo baúl de libros",
    "emotion": "小心",
    "say": "En un baúl"
  },
  "zq44a44": {
    "text": "lo encontré.",
    "emotion": "小心"
  },
  "zq44a45": {
    "text": "…Nada.",
    "emotion": "低頭，把情緒壓回去"
  },
  "zq44a46": {
    "text": "Ese señor de hoy",
    "emotion": "輕聲",
    "say": "El anciano"
  },
  "zq44a47": {
    "text": "me habló de tu familia.",
    "emotion": "老實說",
    "say": "habló de tu familia."
  },
  "zq44a48": {
    "text": "¿Qué más dijo?",
    "emotion": "不回頭，聲音很低"
  },
  "zq44a49": {
    "text": "Dijo que tu padre",
    "emotion": "一字一字"
  },
  "zq44a50": {
    "text": "no es un traidor.",
    "emotion": "篤定",
    "say": "no es traidor."
  },
  "zq44a51": {
    "text": "Si soy hija de un convicto,",
    "emotion": "背著他，聲音發抖",
    "say": "Hija de un convicto…"
  },
  "zq44a52": {
    "text": "¿todavía me querrías?",
    "emotion": "幾乎聽不見",
    "say": "¿aún me quieres?"
  }
}