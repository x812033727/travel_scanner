{
  "zq44a01": {
    "text": "わ、若……",
    "emotion": "聲音發顫",
    "say": "若、"
  },
  "zq44a02": {
    "text": "若将軍？",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "人違いだ。",
    "emotion": "冷，壓低聲音",
    "say": "人違い。"
  },
  "zq44a04": {
    "text": "末将ドゥ・ティエ、",
    "emotion": "嗓門大，一字一字",
    "say": "ドゥ・ティエ、"
  },
  "zq44a05": {
    "text": "若将軍にご挨拶を！",
    "emotion": "彎腰行軍禮"
  },
  "zq44a06": {
    "text": "今、誰を呼んだ？",
    "emotion": "皺眉，轉頭",
    "say": "誰を呼んだ？"
  },
  "zq44a07": {
    "text": "何の将軍だ？",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "うちの嫁でして、",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "似てるでしょ？",
    "emotion": "對巡兵",
    "say": "似てる？"
  },
  "zq44a10": {
    "text": "似てる！",
    "emotion": "會過意來，大笑"
  },
  "zq44a11": {
    "text": "そっくりだ！",
    "emotion": "拍腿"
  },
  "zq44a12": {
    "text": "おじさん、",
    "emotion": "撿起木拐遞過去"
  },
  "zq44a13": {
    "text": "一杯どう？",
    "emotion": "笑",
    "say": "一杯？"
  },
  "zq44a14": {
    "text": "わしは秦家軍で、",
    "emotion": "抹嘴，眼神遠了",
    "say": "秦家軍で、"
  },
  "zq44a15": {
    "text": "二十年、旗を担いだ。",
    "emotion": "驕傲又沙啞",
    "say": "旗を二十年。"
  },
  "zq44a16": {
    "text": "この脚は、",
    "emotion": "畫外，拍一下膝蓋"
  },
  "zq44a17": {
    "text": "北の辺境に置いてきた。",
    "emotion": "畫外，笑得苦"
  },
  "zq44a18": {
    "text": "じゃあ彼女は……",
    "emotion": "放低聲音",
    "say": "彼女は、"
  },
  "zq44a19": {
    "text": "どこの若将軍なんです？",
    "emotion": "試探",
    "say": "どこの若将軍？"
  },
  "zq44a20": {
    "text": "あの方の父上は、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "父、"
  },
  "zq44a21": {
    "text": "鎮北将軍チン・リエシャン。",
    "emotion": "一字一頓"
  },
  "zq44a22": {
    "text": "朝廷は将軍が、",
    "emotion": "咬牙",
    "say": "朝廷は、"
  },
  "zq44a23": {
    "text": "朔漠に関防図を売ったと。",
    "emotion": "一字一字"
  },
  "zq44a24": {
    "text": "秦家は取り潰し、",
    "emotion": "畫外，聲音啞",
    "say": "取り潰し、"
  },
  "zq44a25": {
    "text": "皆散り散りに。",
    "emotion": "畫外",
    "say": "皆散った。"
  },
  "zq44a26": {
    "text": "信じるもんか！",
    "emotion": "怒",
    "say": "嘘だ！"
  },
  "zq44a27": {
    "text": "将軍が国を売るものか！",
    "emotion": "眼眶紅",
    "say": "国を売るものか！"
  },
  "zq44a28": {
    "text": "人物データ更新：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "チン・シュアン、鎮北将軍の娘。",
    "emotion": "平板電子音"
  },
  "zq44a30": {
    "text": "おじさん、",
    "emotion": "放下酒壺"
  },
  "zq44a31": {
    "text": "将軍の行方を探ってくれ。",
    "emotion": "認真",
    "say": "将軍を探してくれ。"
  },
  "zq44a32": {
    "text": "わしのこの命は、",
    "emotion": "低聲，堅定",
    "say": "この命、"
  },
  "zq44a33": {
    "text": "もとより秦家のもの。",
    "emotion": "點頭"
  },
  "zq44a34": {
    "text": "あの方は……",
    "emotion": "輕聲",
    "say": "お嬢"
  },
  "zq44a35": {
    "text": "元気でいますか？",
    "emotion": "輕聲",
    "say": "元気か？"
  },
  "zq44a36": {
    "text": "笑うようになりました。",
    "emotion": "輕輕一笑",
    "say": "よく笑います。"
  },
  "zq44a37": {
    "text": "笑えるならいい、",
    "emotion": "笑出眼淚",
    "say": "それでいい、"
  },
  "zq44a38": {
    "text": "笑えるならいい。",
    "emotion": "仰頭又灌一口",
    "say": "いいんだ。"
  },
  "zq44a39": {
    "text": "チン姉さん、一日中黙ってるの。",
    "emotion": "探頭進門，壓低聲音",
    "say": "チン姉さんが無言で、"
  },
  "zq44a40": {
    "text": "慰めてあげて。",
    "emotion": "壓低聲音，催他",
    "say": "慰めて。"
  },
  "zq44a41": {
    "text": "俺？",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "これをどこで？",
    "emotion": "一把抓起，聲音發緊"
  },
  "zq44a43": {
    "text": "古い本箱の中から、",
    "emotion": "小心",
    "say": "本箱で、"
  },
  "zq44a44": {
    "text": "見つけたんだ。",
    "emotion": "小心",
    "say": "見つけた。"
  },
  "zq44a45": {
    "text": "……何でもない。",
    "emotion": "低頭，把情緒壓回去"
  },
  "zq44a46": {
    "text": "今日のあのおじさんが、",
    "emotion": "輕聲",
    "say": "今日のおじさん、"
  },
  "zq44a47": {
    "text": "君の家のことを話してくれた。",
    "emotion": "老實說",
    "say": "家の話を聞いた。"
  },
  "zq44a48": {
    "text": "他に何て言ってた？",
    "emotion": "不回頭，聲音很低",
    "say": "他には？"
  },
  "zq44a49": {
    "text": "君の父上は、",
    "emotion": "一字一字"
  },
  "zq44a50": {
    "text": "国を売らないって。",
    "emotion": "篤定",
    "say": "国を売らないと。"
  },
  "zq44a51": {
    "text": "もし私が罪人の娘でも、",
    "emotion": "背著他，聲音很低",
    "say": "罪人の娘でも、"
  },
  "zq44a52": {
    "text": "それでも私が要る？",
    "emotion": "幾乎聽不見"
  }
}