{
  "zq44a01": {
    "text": "J-Jen…",
    "emotion": "聲音發緊，短促",
    "say": "Je-"
  },
  "zq44a02": {
    "text": "Jenderal Muda?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "Salah orang.",
    "emotion": "冷，壓低聲音"
  },
  "zq44a04": {
    "text": "Hamba Du Tie,",
    "emotion": "嗓門大，一字一字"
  },
  "zq44a05": {
    "text": "menghadap Jenderal Muda!",
    "emotion": "彎腰行軍禮",
    "say": "Jenderal Muda!"
  },
  "zq44a06": {
    "text": "Tadi panggil siapa?",
    "emotion": "皺眉，轉頭",
    "say": "Siapa?"
  },
  "zq44a07": {
    "text": "Jenderal apa?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "Ini istri saya,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "mirip, kan?",
    "emotion": "對巡兵",
    "say": "Mirip?"
  },
  "zq44a10": {
    "text": "Mirip!",
    "emotion": "會過意來，大聲"
  },
  "zq44a11": {
    "text": "Mirip sekali!",
    "emotion": "大聲",
    "say": "Persis!"
  },
  "zq44a12": {
    "text": "Pak,",
    "emotion": "撿起木拐遞過去"
  },
  "zq44a13": {
    "text": "Minum semangkuk?",
    "emotion": "笑",
    "say": "Minum?"
  },
  "zq44a14": {
    "text": "Saya di pasukan keluarga Qin,",
    "emotion": "眼神遠了",
    "say": "Prajurit Qin,"
  },
  "zq44a15": {
    "text": "dua puluh tahun memanggul panji.",
    "emotion": "驕傲又沙啞",
    "say": "panji dua puluh tahun."
  },
  "zq44a16": {
    "text": "Kaki ini",
    "emotion": "畫外，沉聲"
  },
  "zq44a17": {
    "text": "tertinggal di perbatasan utara.",
    "emotion": "畫外，苦澀",
    "say": "tertinggal di utara."
  },
  "zq44a18": {
    "text": "Jadi dia…",
    "emotion": "放低聲音",
    "say": "Dia…"
  },
  "zq44a19": {
    "text": "Jenderal Muda dari keluarga siapa?",
    "emotion": "試探",
    "say": "Jenderal siapa?"
  },
  "zq44a20": {
    "text": "Ayahnya",
    "emotion": "低聲，快，說完就停",
    "say": "Ayah"
  },
  "zq44a21": {
    "text": "Jenderal Penjaga Utara, Qin Lieshan.",
    "emotion": "沉聲，乾脆"
  },
  "zq44a22": {
    "text": "Istana bilang dia",
    "emotion": "咬牙",
    "say": "Istana bilang"
  },
  "zq44a23": {
    "text": "menjual peta pertahanan perbatasan ke Shuomo.",
    "emotion": "一字一字",
    "say": "jual peta pertahanan ke Shuomo."
  },
  "zq44a24": {
    "text": "Keluarga Qin disita,",
    "emotion": "畫外，聲音啞",
    "say": "Qin disita,"
  },
  "zq44a25": {
    "text": "semua tercerai-berai.",
    "emotion": "畫外",
    "say": "semua bubar."
  },
  "zq44a26": {
    "text": "Aku tak percaya!",
    "emotion": "拍桌",
    "say": "Bohong!"
  },
  "zq44a27": {
    "text": "Jenderal tak mungkin jual negara!",
    "emotion": "眼眶紅",
    "say": "Jenderal tak jual negara!"
  },
  "zq44a28": {
    "text": "Data tokoh diperbarui:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq44a29": {
    "text": "Qin Shuang, putri Jenderal Penjaga Utara.",
    "emotion": "平板電子音",
    "say": "Qin Shuang, putri sang Jenderal."
  },
  "zq44a30": {
    "text": "Pak,",
    "emotion": "放下酒壺"
  },
  "zq44a31": {
    "text": "tolong cari tahu di mana Jenderal.",
    "emotion": "認真",
    "say": "carikan Jenderal."
  },
  "zq44a32": {
    "text": "Nyawaku ini",
    "emotion": "低聲，堅定",
    "say": "Nyawaku"
  },
  "zq44a33": {
    "text": "memang milik keluarga Qin.",
    "emotion": "點頭",
    "say": "milik keluarga Qin."
  },
  "zq44a34": {
    "text": "Dia…",
    "emotion": "聲音一軟",
    "say": "Dia"
  },
  "zq44a35": {
    "text": "baik-baik saja?",
    "emotion": "輕聲",
    "say": "bahagia?"
  },
  "zq44a36": {
    "text": "Dia sudah bisa senyum.",
    "emotion": "溫柔",
    "say": "Sudah bisa senyum."
  },
  "zq44a37": {
    "text": "Bisa senyum, syukurlah,",
    "emotion": "眼含淚，輕聲",
    "say": "Syukur,"
  },
  "zq44a38": {
    "text": "syukurlah.",
    "emotion": "輕聲，乾脆",
    "say": "syukur."
  },
  "zq44a39": {
    "text": "Kak Qin seharian nggak bicara,",
    "emotion": "探頭進門，壓低聲音",
    "say": "Kak Qin diam seharian,"
  },
  "zq44a40": {
    "text": "hibur dia sana.",
    "emotion": "壓低聲音，催他",
    "say": "Hibur dia."
  },
  "zq44a41": {
    "text": "Aku?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "Dari mana ini?",
    "emotion": "一把抓起，聲音發緊"
  },
  "zq44a43": {
    "text": "Di peti buku lama",
    "emotion": "小心",
    "say": "Di peti buku"
  },
  "zq44a44": {
    "text": "aku temukan.",
    "emotion": "小心",
    "say": "kutemukan."
  },
  "zq44a45": {
    "text": "…Bukan apa-apa.",
    "emotion": "低頭，把情緒壓回去",
    "say": "Nggak apa."
  },
  "zq44a46": {
    "text": "Bapak tadi siang",
    "emotion": "輕聲",
    "say": "Bapak tadi"
  },
  "zq44a47": {
    "text": "cerita soal keluargamu.",
    "emotion": "老實說"
  },
  "zq44a48": {
    "text": "Dia bilang apa lagi?",
    "emotion": "不回頭，聲音很低",
    "say": "Apa lagi?"
  },
  "zq44a49": {
    "text": "Katanya ayahmu",
    "emotion": "一字一字",
    "say": "Ayahmu,"
  },
  "zq44a50": {
    "text": "tak menjual negara.",
    "emotion": "篤定",
    "say": "tak jual negara."
  },
  "zq44a51": {
    "text": "Kalau aku putri pesakitan,",
    "emotion": "背著他，聲音發抖",
    "say": "Putri pesakitan…"
  },
  "zq44a52": {
    "text": "kamu masih mau aku?",
    "emotion": "幾乎聽不見",
    "say": "masih mau aku?"
  }
}