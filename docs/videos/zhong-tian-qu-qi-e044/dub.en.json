{
  "zq44a01": {
    "text": "Y-Young…",
    "emotion": "聲音發顫"
  },
  "zq44a02": {
    "text": "Young General?",
    "emotion": "不敢相信"
  },
  "zq44a03": {
    "text": "You have the wrong person.",
    "emotion": "冷，壓低聲音",
    "say": "Wrong person."
  },
  "zq44a04": {
    "text": "This humble officer, Du Tie,",
    "emotion": "嗓門大，一字一字",
    "say": "Du Tie reporting,"
  },
  "zq44a05": {
    "text": "salutes the Young General!",
    "emotion": "彎腰行軍禮"
  },
  "zq44a06": {
    "text": "Who was he calling just now?",
    "emotion": "皺眉，轉頭",
    "say": "Calling who?"
  },
  "zq44a07": {
    "text": "What general?",
    "emotion": "疑心"
  },
  "zq44a08": {
    "text": "That's my wife,",
    "emotion": "一把攬住杜鐵，笑"
  },
  "zq44a09": {
    "text": "looks like her, huh?",
    "emotion": "對巡兵",
    "say": "Looks like her?"
  },
  "zq44a10": {
    "text": "She does!",
    "emotion": "會過意來，大笑"
  },
  "zq44a11": {
    "text": "Spitting image!",
    "emotion": "拍腿"
  },
  "zq44a12": {
    "text": "Old-timer,",
    "emotion": "撿起木拐遞過去",
    "say": "Hey,"
  },
  "zq44a13": {
    "text": "Care for a drink?",
    "emotion": "笑",
    "say": "A drink?"
  },
  "zq44a14": {
    "text": "I served in the Qin army,",
    "emotion": "抹嘴，眼神遠了",
    "say": "I served the Qins,"
  },
  "zq44a15": {
    "text": "carried its banner twenty years.",
    "emotion": "驕傲又沙啞"
  },
  "zq44a16": {
    "text": "This leg,",
    "emotion": "畫外，拍一下膝蓋"
  },
  "zq44a17": {
    "text": "I left on the northern frontier.",
    "emotion": "畫外，笑得苦"
  },
  "zq44a18": {
    "text": "So she…",
    "emotion": "放低聲音",
    "say": "So she,"
  },
  "zq44a19": {
    "text": "whose Young General is she?",
    "emotion": "試探"
  },
  "zq44a20": {
    "text": "Her father",
    "emotion": "兩碗下肚，壓低聲音",
    "say": "Her pa,"
  },
  "zq44a21": {
    "text": "is the General Guardian of the North, Qin Lieshan.",
    "emotion": "一字一頓"
  },
  "zq44a22": {
    "text": "The court says he",
    "emotion": "咬牙"
  },
  "zq44a23": {
    "text": "sold the border defense maps to Shuomo.",
    "emotion": "一字一字",
    "say": "sold defense maps to Shuomo."
  },
  "zq44a24": {
    "text": "The Qin house was seized,",
    "emotion": "畫外，聲音啞",
    "say": "Qins ruined,"
  },
  "zq44a25": {
    "text": "everyone scattered.",
    "emotion": "畫外"
  },
  "zq44a26": {
    "text": "I don't believe it!",
    "emotion": "拍桌",
    "say": "No!"
  },
  "zq44a27": {
    "text": "The General would never betray his country!",
    "emotion": "眼眶紅",
    "say": "The General's no traitor!"
  },
  "zq44a28": {
    "text": "Character profile updated:",
    "emotion": "平板電子音，叮一聲",
    "say": "Profile updated:"
  },
  "zq44a29": {
    "text": "Qin Shuang, daughter of the General Guardian of the North.",
    "emotion": "平板電子音",
    "say": "Qin Shuang, the General's daughter."
  },
  "zq44a30": {
    "text": "Old-timer,",
    "emotion": "放下酒壺",
    "say": "Pops,"
  },
  "zq44a31": {
    "text": "help me find out where the General is.",
    "emotion": "認真",
    "say": "find the General for me."
  },
  "zq44a32": {
    "text": "This life of mine",
    "emotion": "抹一把臉",
    "say": "My life"
  },
  "zq44a33": {
    "text": "always belonged to the Qins.",
    "emotion": "點頭"
  },
  "zq44a34": {
    "text": "She…",
    "emotion": "聲音一軟"
  },
  "zq44a35": {
    "text": "is she doing all right?",
    "emotion": "輕聲",
    "say": "is she well?"
  },
  "zq44a36": {
    "text": "She smiles now.",
    "emotion": "輕輕一笑"
  },
  "zq44a37": {
    "text": "If she smiles, that's good,",
    "emotion": "眼含淚，聲音發顫",
    "say": "Good,"
  },
  "zq44a38": {
    "text": "that's good.",
    "emotion": "輕聲",
    "say": "Good."
  },
  "zq44a39": {
    "text": "Sister Qin hasn't said a word all day.",
    "emotion": "探頭進門，壓低聲音",
    "say": "Sister Qin's silent all day,"
  },
  "zq44a40": {
    "text": "Go cheer her up.",
    "emotion": "壓低聲音，催他",
    "say": "Go to her."
  },
  "zq44a41": {
    "text": "Me?",
    "emotion": "指著自己"
  },
  "zq44a42": {
    "text": "Where did you get this?",
    "emotion": "一把抓起，聲音發緊",
    "say": "Where's this from?"
  },
  "zq44a43": {
    "text": "In an old book chest,",
    "emotion": "小心",
    "say": "In an old chest,"
  },
  "zq44a44": {
    "text": "I found it.",
    "emotion": "小心"
  },
  "zq44a45": {
    "text": "…It's nothing.",
    "emotion": "低頭，把情緒壓回去",
    "say": "Nothing."
  },
  "zq44a46": {
    "text": "That old man today",
    "emotion": "輕聲"
  },
  "zq44a47": {
    "text": "told me about your family.",
    "emotion": "老實說",
    "say": "spoke of your family."
  },
  "zq44a48": {
    "text": "What else did he say?",
    "emotion": "不回頭，聲音很低",
    "say": "What else?"
  },
  "zq44a49": {
    "text": "He said your father",
    "emotion": "一字一字"
  },
  "zq44a50": {
    "text": "is no traitor.",
    "emotion": "篤定"
  },
  "zq44a51": {
    "text": "If I'm a convict's daughter,",
    "emotion": "背著他，聲音發抖",
    "say": "A convict's daughter…"
  },
  "zq44a52": {
    "text": "would you still want me?",
    "emotion": "幾乎聽不見"
  }
}
