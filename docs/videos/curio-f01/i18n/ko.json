    "thumbnail": "c55cfb56705f"
  },
  "lines": {
    "2284": {
      "source_hash": "06fe66eceeac",
      "text": "그것이 왕자가 신부를 찾는 단서가 되었죠!"
    },
    "2866": {
      "source_hash": "970842a2a09a",
      "text": "그 빛바랜 초판본에서는,"
    },
    "8783": {
      "source_hash": "0d1fc9d86801",
      "text": "궁정 대귀족에게 시집보냈죠!"
    },
    "2uf0": {
      "source_hash": "629ed4e5cc22",
      "text": "신데렐라의 진짜 진실을 아시나요?"
    },
    "wv43": {
      "source_hash": "d6861297acd4",
      "text": "신데렐라요?"
    },
    "e1g4": {
      "source_hash": "12ab706aa5da",
      "text": "호박 마차와 유리구두 말인가요?"
    },
    "uep4": {
      "source_hash": "affdd8ec95d1",
      "text": "가장 초기 동화에선,"
    },
    "eeqm": {
      "source_hash": "cf1f4550c0a2",
      "text": "이 모든 게 없었다면요?"
    },
    "1mbk": {
      "source_hash": "df3aecaeae6c",
      "text": "전부 없었다고요?!"
    },
    "p8gg": {
      "source_hash": "71ad90ce78a4",
      "text": "이백여 년 전 겨울,"
    },
    "tbkz": {
      "source_hash": "7ad8472974e9",
      "text": "그림 형제가 초판을 냈죠."
    },
    "gtql": {
      "source_hash": "f92d52c3a4c6",
      "text": "무도회엔 황금 슬리퍼였죠!"
    },
    "bkw0": {
      "source_hash": "f963851694c1",
      "text": "황금 슬리퍼라구요?!"
    },
    "30af": {
      "source_hash": "3d558174b49b",
      "text": "구두를 신어보는 날,"
    },
    "5xsd": {
      "source_hash": "2630a00be874",
      "text": "딸에게 칼을 건넸습니다!"
    },
    "vjzo": {
      "source_hash": "b3b08786ec8d",
      "text": "칼을 들고 뭘 하려는 거죠?!"
    },
    "b2vg": {
      "source_hash": "01bff1e6792f",
      "text": "어머니는 차갑게:"
    },
    "gdsc": {
      "source_hash": "b4968461345a",
      "text": "참아라,"
    },
    "fvmp": {
      "source_hash": "6e2319b09e2b",
      "text": "왕비가 될 테니까!"
    },
    "o8cw": {
      "source_hash": "92f0b991c74b",
      "text": "설마 발을……"
    },
    "v0ph": {
      "source_hash": "dc8c98060ea7",
      "text": "독하게도,"
    },
    "vwnq": {
      "source_hash": "194a105177c1",
      "text": "자신의 발뒤꿈치를 잘라냈습니다!"
    },
    "0olx": {
      "source_hash": "7a38d9a5c84d",
      "text": "발뒤꿈치를 잘랐다구요?!"
    },
    "oa01": {
      "source_hash": "07380f42074b",
      "text": "오늘 문헌을 펼쳐,"
    },
    "lfu6": {
      "source_hash": "4d3b025f18de",
      "text": "200년 숨겨진 진실을 보죠!"
    },
    "ud2o": {
      "source_hash": "a9dbbf5707cd",
      "text": "이 고문헌을 펼치면,"
    },
    "bw8e": {
      "source_hash": "f2620c6274be",
      "text": "이야기의 제목은 '아셴푸텔'입니다."
    },
    "1ttl": {
      "source_hash": "1ff2fc7016ba",
      "text": "그녀는 처음부터 재 속에서 잠을 잤나요?"
    },
    "lidv": {
      "source_hash": "a3091a38ac11",
      "text": "그렇습니다. 매일 화덕 곁에 앉아 지냈죠."
    },
    "z1lt": {
      "source_hash": "8476a3207c59",
      "text": "어머니가 남긴 말:"
    },
    "e250": {
      "source_hash": "d2384f09d3cc",
      "text": "늘 신실하고 착하게 살면,"
    },
    "y6mt": {
      "source_hash": "63ddea66caa5",
      "text": "하늘에서 늘 널 지켜주마."
    },
    "alc3": {
      "source_hash": "d0ed705bc5b7",
      "text": "어머니가 떠나고,"
    },
    "t2fs": {
      "source_hash": "e99d82438b9a",
      "text": "무덤에 작은 나무를 심고,"
    },
    "svem": {
      "source_hash": "a77b44c73507",
      "text": "개암나무 아닌가요?"
    },
    "afjx": {
      "source_hash": "6e781f4b5d30",
      "text": "예리한 질문입니다!"
    },
    "rq95": {
      "source_hash": "c32afd07e7aa",
      "text": "초판 원문엔"
    },
    "sl1u": {
      "source_hash": "2165c20046fc",
      "text": "그저 '작은 나무'였죠!"
    },
    "uw9h": {
      "source_hash": "c23b46d0d6e3",
      "text": "초판에는 개암나무라는 언급이 없었군요!"
    },
    "pwk1": {
      "source_hash": "b7958afdf259",
      "text": "신데렐라는 매일 세 번 울었고,"
    },
    "i7rz": {
      "source_hash": "2658360d0fa4",
      "text": "그 눈물이 나무를 키워냈죠."
    },
    "tvaa": {
      "source_hash": "12eb5266b898",
      "text": "그때 요정 대모가 나타났나요?"
    },
    "j2o9": {
      "source_hash": "f1899af791cf",
      "text": "하지만 전혀 없었습니다!"
    },
    "nhsb": {
      "source_hash": "e8fa7368fae5",
      "text": "초판에는 요정이 없었죠!"
    },
    "r5fw": {
      "source_hash": "0ef4304d59c5",
      "text": "흰 새가 도왔죠."
    },
    "whv7": {
      "source_hash": "98d9798bd767",
      "text": "새가 드레스와 구두를 던져줬나요?"
    },
    "ddi5": {
      "source_hash": "a27eb566a99e",
      "text": "네, 나무에 소원을 빌면,"
    },
    "blk4": {
      "source_hash": "09cb22739111",
      "text": "흰 새가 원하는 것을 던져주었죠."
    },
    "1ou0": {
      "source_hash": "ae4b3cb06331",
      "text": "왕은 3일간 무도회를 열었습니다."
    },
    "h04o": {
      "source_hash": "db50bda837a2",
      "text": "재 속 콩을 줍게 괴롭혔지만,"
    },
    "yrbe": {
      "source_hash": "fd2cc6535f6a",
      "text": "혼자서 그걸 어떻게 다 골라내겠어요?"
    },
    "83d7": {
      "source_hash": "2eab56a9076c",
      "text": "비둘기들이 깨끗이 골라냈죠!"
    },
    "bm2e": {
      "source_hash": "3032f6994368",
      "text": "하지만 비웃으며 떠났죠."
    },
    "gdqx": {
      "source_hash": "f5819ed4fdd7",
      "text": "곧장 작은 나무로 달려갔군요!"
    },
    "smgk": {
      "source_hash": "bb1b7dea515e",
      "text": "새는 금실 은실 드레스와,"
    },
    "5w8s": {
      "source_hash": "524218652206",
      "text": "아름다운 황금 슬리퍼를 던져주었습니다!"
    },
    "edx1": {
      "source_hash": "967fe282a61d",
      "text": "자정이 되자 호박 마차가 사라졌나요?"
    },
    "zcbw": {
      "source_hash": "033358e3222c",
      "text": "더욱 기이한 것은: 호박 마차는 없었습니다!"
    },
    "gq4c": {
      "source_hash": "3fa9928a3337",
      "text": "초판엔 자정 종소리가 없었죠!"
    },
    "5hw7": {
      "source_hash": "96b0eba5a060",
      "text": "그럼 왜 어둠 속으로 도망쳤나요?"
    },
    "g4nw": {
      "source_hash": "52f5cdc714c6",
      "text": "신분을 숨기고 싶었을 뿐!"
    },
    "reb6": {
      "source_hash": "7f7432414776",
      "text": "셋째 날 무도회 끝에,"
    },
    "f738": {
      "source_hash": "7ef178c14f9d",
      "text": "왕자가 계단에 타르를 칠해뒀죠!"
    },
    "vm7e": {
      "source_hash": "5b4602715035",
      "text": "계단에 타르를 칠했다구요?!"
    },
    "h5ua": {
      "source_hash": "318c3d206466",
      "text": "뛰어내려가던 신데렐라의,"
    },
    "57dk": {
      "source_hash": "ee53982932b9",
      "text": "오른발 황금 슬리퍼가 달라붙었죠!"
    },
    "rm2d": {
      "source_hash": "3b9b86bfdf3b",
      "text": "왕자는 구두를 들고 왔죠."
    },
    "au8n": {
      "source_hash": "fc9c9184533e",
      "text": "첫째가 신어보았지만,"
    },
    "smoq": {
      "source_hash": "57d3a7a1cc85",
      "text": "발뒤꿈치가 너무 커서 안 들어갔죠."
    },
    "2xqj": {
      "source_hash": "ef7a161c455f",
      "text": "그때 어머니가 칼을 건넨 건가요?"
    },
    "aqo8": {
      "source_hash": "a92a0cdb7a35",
      "text": "어머니는: 조금 참아라!"
    },
    "6lp0": {
      "source_hash": "a8be0c6d7943",
      "text": "발뒤꿈치를 자르고 억지로 신었죠!"
    },
    "v380": {
      "source_hash": "fe7e48ac1851",
      "text": "세상에! 왕자는 눈치채지 못했나요?"
    },
    "k7sz": {
      "source_hash": "e1294ea8ff35",
      "text": "속은 왕자는 그녀와 떠났죠."
    },
    "j8e7": {
      "source_hash": "013e42fc6c3a",
      "text": "하지만 성문을 지날 때, 비둘기들이 외쳤죠!"
    },
    "1aqn": {
      "source_hash": "657e4f8ad1c0",
      "text": "룩 디 구! 구두 안에 피가 가득하다!"
    },
    "mw3j": {
      "source_hash": "286db650d1a5",
      "text": "왕자가 내려다보니 하얀 양말이 피로 물들었죠!"
    },
    "i694": {
      "source_hash": "a6ddd2669630",
      "text": "끔찍해요! 둘째는?"
    },
    "okhw": {
      "source_hash": "cdc5cbbb6d90",
      "text": "둘째는 칼로 발가락을 잘랐죠!"
    },
    "wa7h": {
      "source_hash": "e2883979a6a4",
      "text": "결과는 똑같았습니다: 비둘기가 다시 외쳤죠!"
    },
    "b8nf": {
      "source_hash": "e66d095ef282",
      "text": "두 번의 피비린내 나는 거짓말은 들통났죠!"
    },
    "zzww": {
      "source_hash": "edbb357827dc",
      "text": "마침내 신데렐라의 차례가 되었습니다!"
    },
    "9qv9": {
      "source_hash": "a972f8ca2961",
      "text": "신데렐라가 손을 씻고 나와,"
    },
    "gq7c": {
      "source_hash": "f6daab0596ae",
      "text": "황금 슬리퍼가 딱 맞았죠!"
    },
    "bzxv": {
      "source_hash": "edab7a67bf19",
      "text": "사악한 두 언니는 결국 어떻게 되었나요?"
    },
    "ly17": {
      "source_hash": "c17fb98bd12e",
      "text": "이상하게도 초판엔 벌이 없었죠!"
    },
    "twsn": {
      "source_hash": "177a91069d1b",
      "text": "왕자가 데려가는 것에서 끝이 났죠!"
    },
    "lisv": {
      "source_hash": "af9c7d889ab3",
      "text": "네?! 초판본에서는 언니들이 처벌받지 않았다구요?!"
    },
    "novp": {
      "source_hash": "ba5ab43c0eee",
      "text": "뜻밖이죠?"
    },
    "36vf": {
      "source_hash": "f2c53ed75a85",
      "text": "그럼 요정 대모와 호박 마차는 도대체 누가 만든 건가요?"
    },
    "a6qn": {
      "source_hash": "1717f0e02074",
      "text": "1697년의 일이죠!"
    },
    "qc3e": {
      "source_hash": "4e8c2a3a0ddd",
      "text": "파리의 작가 샤를 페로가,"
    },
    "hr84": {
      "source_hash": "d587ffbc7800",
      "text": "불후의 명작 동화집을 펴냈죠."
    },
    "wtkn": {
      "source_hash": "4befbffba4d1",
      "text": "이 프랑스 동화에선,"
    },
    "hzeu": {
      "source_hash": "efe12d563796",
      "text": "지팡이를 든 요정 대모가 등장했죠!"
    },
    "2baj": {
      "source_hash": "0f28df2edf80",
      "text": "그때 호박이 마차로 변한 거군요!"
    },
    "m0gl": {
      "source_hash": "791870f181ee",
      "text": "호박은 황금 마차로,"
    },
    "zela": {
      "source_hash": "badb45e7d924",
      "text": "생쥐는 준마, 큰 쥐는 마부!"
    },
    "wuzq": {
      "source_hash": "7ab404f94d2d",
      "text": "요정은 그녀에게 투명한 유리구두를 선물했죠!"
    },
    "jjv9": {
      "source_hash": "ea6b80ec9cb0",
      "text": "페로의 동화에서도 언니들이 발을 잘랐나요?"
    },
    "aesw": {
      "source_hash": "1a1dd4a4523d",
      "text": "전혀요! 프랑스 궁정은 우아함을 중시했죠."
    },
    "xvrt": {
      "source_hash": "b40da626d11f",
      "text": "언니들은 그냥 포기했죠."
    },
    "tdwk": {
      "source_hash": "2b6980504cbe",
      "text": "신데렐라는 언니들을 진심으로 용서하고,"
    },
    "tm3b": {
      "source_hash": "af1956241b9d",
      "text": "정말 따뜻하고 너그러운 결말이네요!"
    },
    "iobi": {
      "source_hash": "82ccad613298",
      "text": "그림 형제는 영 못마땅해했죠!"
    },
    "xpj0": {
      "source_hash": "c4a924458507",
      "text": "초판 주석에서 직설적으로 비판했죠:"
    },
    "b1of": {
      "source_hash": "7089ce35b556",
      "text": "페로의 이야기는 형편없다!"
    },
    "lemu": {
      "source_hash": "903d6c59a6a7",
      "text": "페로가 너무 무르다고 생각했군요?!"
    },
    "q9hh": {
      "source_hash": "1298ca5abf0e",
      "text": "동화는 온화해진다고 믿죠."
    },
    "pepd": {
      "source_hash": "53105af4af4c",
      "text": "하지만 그림 형제의 신데렐라는,"
    },
    "muzj": {
      "source_hash": "82ea6ce13a65",
      "text": "갈수록 더 잔혹해졌죠!"
    },
    "khon": {
      "source_hash": "c1b2dcbf855e",
      "text": "더 잔혹해졌다구요? 더 험한 장면이 추가되었나요?"
    },
    "dckz": {
      "source_hash": "da8cd6819e8d",
      "text": "수정된 2판을 냈죠."
    },
    "dbsp": {
      "source_hash": "38d3357f640c",
      "text": "아버지가 개암나무 가지를 꺾어온 장면이 추가됐죠."
    },
    "ib6y": {
      "source_hash": "3a7fe0874264",
      "text": "그 가지를 어머니 무덤에 심었죠."
    },
    "nppt": {
      "source_hash": "4caf4906cceb",
      "text": "이것이 바로 그 유명한 무덤가의 개암나무가 되었습니다!"
    },
    "n565": {
      "source_hash": "4d0871fc3452",
      "text": "발 자르는 순서도 바뀌었죠!"
    },
    "jsx9": {
      "source_hash": "bb35b1309ffd",
      "text": "첫째가 발가락을 자르고, 둘째가 뒤꿈치를 잘랐죠!"
    },
    "94w8": {
      "source_hash": "3b2d5e2f9a45",
      "text": "어머니의 대사도 더 냉혹해졌죠:"
    },
    "e2i4": {
      "source_hash": "a0ff045fedee",
      "text": "발가락을 잘라버려라!"
    },
    "h4xc": {
      "source_hash": "fe8271b04521",
      "text": "왕비가 되면 걸을 일도 없단다!"
    },
    "nxab": {
      "source_hash": "05772bfa7e12",
      "text": "다시는 걸어 다닐 일이 없다니…… 듣기만 해도 소름이 돋네요!"
    },
    "tf3v": {
      "source_hash": "6cf48b6822db",
      "text": "하지만 끝이 아니었습니다!"
    },
    "qrca": {
      "source_hash": "8e61f948dfdd",
      "text": "제2판의 결말에서,"
    },
    "ogvj": {
      "source_hash": "ff5f5986f8a4",
      "text": "잔혹한 피의 복수를 직접 써넣었습니다!"
    },
    "z6lb": {
      "source_hash": "781a2a447820",
      "text": "결혼식에 대체 뭘 추가했나요?"
    },
    "z5i2": {
      "source_hash": "8c81922b7cd4",
      "text": "결혼식 당일, 대성당은 인파로 가득 찼습니다."
    },
    "bbyt": {
      "source_hash": "093a73791e36",
      "text": "발을 잘라낸 두 언니도 찾아왔죠!"
    },
    "g2n5": {
      "source_hash": "8129f17bb7dc",
      "text": "부귀영화를 탐내며 끝까지 나타난 거군요!"
    },
    "4do0": {
      "source_hash": "2388095ecd2b",
      "text": "첫째는 오른쪽에, 둘째는 왼쪽에!"
    },
    "y1up": {
      "source_hash": "3741191c021c",
      "text": "바로 그 순간, 더욱 끔찍한 일이 벌어졌습니다!"
    },
    "oyo9": {
      "source_hash": "e1f30af0e977",
      "text": "비둘기들이 화살처럼 덮쳤죠!"
    },
    "2bpc": {
      "source_hash": "e4e129731fa1",
      "text": "언니들을 덮쳐 순식간에 눈 한쪽씩을 쪼아 파내 버렸죠!"
    },
    "7okx": {
      "source_hash": "ab98f00f7a18",
      "text": "세상에! 그 자리에서 눈을 쪼아냈다구요?!"
    },
    "h529": {
      "source_hash": "877c04407c12",
      "text": "아픔을 참고 버텼죠."
    },
    "ft1n": {
      "source_hash": "88b3d425b45d",
      "text": "교회를 나설 때, 무서운 천벌이 내렸죠!"
    },
    "rl2j": {
      "source_hash": "99c9583d9710",
      "text": "다시 덮친 비둘기,"
    },
    "2zxg": {
      "source_hash": "862e1b4babc5",
      "text": "남아 있던 다른 쪽 눈마저 모조리 쪼아내 버린 것입니다!"
    },
    "vv44": {
      "source_hash": "196d62af8fd8",
      "text": "독일 원문:"
    },
    "r4xd": {
      "source_hash": "dc8eec1b13dc",
      "text": "거짓과 악행의 대가로 평생 눈이 멀어야 했다!"
    },
    "4xql": {
      "source_hash": "3b3b2c4067a6",
      "text": "이 잔혹한 결말은 제7판까지 유지됐죠!"
    },
    "4nub": {
      "source_hash": "143269c4f8fd",
      "text": "당시 독자들도 너무 잔인하다고 하지 않았나요?"
    },
    "11te": {
      "source_hash": "205353fc6855",
      "text": "악은 벌받아야 한다! 그것이 그림 형제의 신념이었죠."
    },
    "1dnb": {
      "source_hash": "a8d41b18065f",
      "text": "소장님, 원작이 그렇게 잔혹했다면,"
    },
    "t57s": {
      "source_hash": "0b9c8383738d",
      "text": "어릴 때 본 건 왜 전혀 달랐던 거죠?"
    },
    "cl4w": {
      "source_hash": "9c4273616967",
      "text": "그건 20세기 최고의 꿈의 마술사, 월트 디즈니 덕분입니다!"
    },
    "a5nm": {
      "source_hash": "aec77120cd48",
      "text": "1950년 2월, 디즈니 신데렐라가 개봉했죠."
    },
    "eckd": {
      "source_hash": "18057a74b0a1",
      "text": "디즈니는 중요한 결정을 내렸죠:"
    },
    "iiat": {
      "source_hash": "a19ee54abec3",
      "text": "그림 형제의 피비린내 나는 복수를 완전히 버리고,"
    },
    "i980": {
      "source_hash": "2c1d80887ff5",
      "text": "250년 전 페로의 프랑스 버전을 택했습니다!"
    },
    "ztwb": {
      "source_hash": "b7008b6a6fd4",
      "text": "주문을 외우는 유쾌한 요정 대모 할머니!"
    },
    "nwih": {
      "source_hash": "d10925d4661c",
      "text": "맞습니다! 따뜻하고 낭만적인 호박 마차와 유리구두!"
    },
    "sd6v": {
      "source_hash": "631195331d79",
      "text": "디즈니는 다정함과 마법으로 역사의 잔혹함을 덮었습니다."
    },
    "ykq7": {
      "source_hash": "458351926e2b",
      "text": "유리구두가 털구두 오역이라는 소문은 어떻게 된 건가요?"
    },
    "oegz": {
      "source_hash": "698889f0e9f6",
      "text": "페로가 다람쥐 털과 유리를 착각했다는 이야기 말이죠."
    },
    "54lu": {
      "source_hash": "beaebcb2f6ca",
      "text": "하지만 1697년 원서엔 분명히 유리라고 적혀 있죠!"
    },
    "ca7l": {
      "source_hash": "51c8802cb550",
      "text": "유리구두는 오역이 아닙니다!"
    },
    "z377": {
      "source_hash": "6d7faa48ef9f",
      "text": "페로가 빚어낸 깨지기 쉬운 기적이었죠!"
    },
    "0ing": {
      "source_hash": "d567c4314dd2",
      "text": "오역 소문마저 가짜였다니! 역사 탐구는 정말 흥미진진하네요!"
    },
    "ez8v": {
      "source_hash": "48a92955b277",
      "text": "초판의 작은 묘목과 황금 슬리퍼에서,"
    },
    "hsvi": {
      "source_hash": "fc87fa994a29",
      "text": "1819년 발을 베고 눈을 쪼아낸 처벌,"
    },
    "5mzk": {
      "source_hash": "04c6b989890c",
      "text": "그리고 페로와 디즈니의 호박 마차와 유리구두로 이어졌습니다."
    },
    "5su7": {
      "source_hash": "8ea5acafa84b",
      "text": "모든 시대는 동화 속에서 자신만의 마음의 위안을 찾아왔습니다!"
    },
    "oxrk": {
      "source_hash": "6631a1f10c7a",
      "text": "이것이 200년간 신데렐라가 준 교훈이죠:"
    },
    "67lq": {
      "source_hash": "3314acc0559f",
      "text": "동화의 잔혹과 온기는 모두 시대를 비추는 거울입니다!"
    },
    "ds9n": {
      "source_hash": "467aa367f164",
      "text": "그럼 오늘 신데렐라 파일, 공식 보관합니다!"
    },
    "1gti": {
      "source_hash": "cbdc0caccb74",
      "text": "여러분에게 가장 충격적이었던 원작 동화는 무엇인가요?"
    },
    "k7zf": {
      "source_hash": "cdb71a63302d",
      "text": "댓글로 여러분의 생각을 남겨주시고, 기문파일국 좋아요와 구독도 잊지 마세요!"
    }
  }
}
