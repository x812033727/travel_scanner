    "thumbnail": "c55cfb56705f"
  },
  "lines": {
    "2284": {
      "source_hash": "06fe66eceeac",
      "text": "これが花嫁捜しの手がかりに！"
    },
    "2866": {
      "source_hash": "970842a2a09a",
      "text": "その黄ばんだ初版では、"
    },
    "8783": {
      "source_hash": "0d1fc9d86801",
      "text": "姉を宮廷の貴族に嫁がせた！"
    },
    "2uf0": {
      "source_hash": "629ed4e5cc22",
      "text": "シンデレラの真実を聞いたことがありますか？"
    },
    "wv43": {
      "source_hash": "d6861297acd4",
      "text": "シンデレラ？"
    },
    "e1g4": {
      "source_hash": "12ab706aa5da",
      "text": "カボチャとガラスの靴？"
    },
    "uep4": {
      "source_hash": "affdd8ec95d1",
      "text": "もし最初期の童話では、"
    },
    "eeqm": {
      "source_hash": "cf1f4550c0a2",
      "text": "どれも存在しないとしたら？"
    },
    "1mbk": {
      "source_hash": "df3aecaeae6c",
      "text": "存在しない？"
    },
    "p8gg": {
      "source_hash": "71ad90ce78a4",
      "text": "二百年以上前の冬、"
    },
    "tbkz": {
      "source_hash": "7ad8472974e9",
      "text": "グリムの初版が出版。"
    },
    "gtql": {
      "source_hash": "f92d52c3a4c6",
      "text": "舞踏会では金の靴だった！"
    },
    "bkw0": {
      "source_hash": "f963851694c1",
      "text": "まさかの金の靴？！"
    },
    "30af": {
      "source_hash": "3d558174b49b",
      "text": "靴の試着の日、"
    },
    "5xsd": {
      "source_hash": "2630a00be874",
      "text": "母は娘にナイフを！"
    },
    "vjzo": {
      "source_hash": "b3b08786ec8d",
      "text": "何をするの？"
    },
    "b2vg": {
      "source_hash": "01bff1e6792f",
      "text": "母は冷たく言った。"
    },
    "gdsc": {
      "source_hash": "b4968461345a",
      "text": "痛くても"
    },
    "fvmp": {
      "source_hash": "6e2319b09e2b",
      "text": "どちらかが王妃になる！"
    },
    "o8cw": {
      "source_hash": "92f0b991c74b",
      "text": "まさか足を……"
    },
    "v0ph": {
      "source_hash": "dc8c98060ea7",
      "text": "姉は迷わず"
    },
    "vwnq": {
      "source_hash": "194a105177c1",
      "text": "自分の踵を切り落としました！"
    },
    "0olx": {
      "source_hash": "7a38d9a5c84d",
      "text": "踵を切り落とした？！"
    },
    "oa01": {
      "source_hash": "07380f42074b",
      "text": "文献を紐解き、"
    },
    "lfu6": {
      "source_hash": "4d3b025f18de",
      "text": "二百年隠された真相へ！"
    },
    "ud2o": {
      "source_hash": "a9dbbf5707cd",
      "text": "この古びた書物を開くと、"
    },
    "bw8e": {
      "source_hash": "f2620c6274be",
      "text": "その名はアシェンプッテル。"
    },
    "1ttl": {
      "source_hash": "1ff2fc7016ba",
      "text": "彼女は最初から灰の中で寝ていたのですか？"
    },
    "lidv": {
      "source_hash": "a3091a38ac11",
      "text": "そう、彼女は毎日炉端に。"
    },
    "z1lt": {
      "source_hash": "8476a3207c59",
      "text": "母は臨終の際、"
    },
    "e250": {
      "source_hash": "d2384f09d3cc",
      "text": "信心深く善良でいれば、"
    },
    "y6mt": {
      "source_hash": "63ddea66caa5",
      "text": "天からずっと見守っている。"
    },
    "alc3": {
      "source_hash": "d0ed705bc5b7",
      "text": "母が亡くなった後、"
    },
    "t2fs": {
      "source_hash": "e99d82438b9a",
      "text": "墓前に木を植えた。"
    },
    "svem": {
      "source_hash": "a77b44c73507",
      "text": "ハシバミの木じゃないの？"
    },
    "afjx": {
      "source_hash": "6e781f4b5d30",
      "text": "鋭い質問ですね！"
    },
    "rq95": {
      "source_hash": "c32afd07e7aa",
      "text": "初版では、"
    },
    "sl1u": {
      "source_hash": "2165c20046fc",
      "text": "『木』とだけ"
    },
    "uw9h": {
      "source_hash": "c23b46d0d6e3",
      "text": "初版にはハシバミがないの？！"
    },
    "pwk1": {
      "source_hash": "b7958afdf259",
      "text": "毎日三度、墓で泣き、"
    },
    "i7rz": {
      "source_hash": "2658360d0fa4",
      "text": "涙で木は大樹へと育った。"
    },
    "tvaa": {
      "source_hash": "12eb5266b898",
      "text": "仙女が現れたの？"
    },
    "j2o9": {
      "source_hash": "f1899af791cf",
      "text": "実は、全く出ません！"
    },
    "nhsb": {
      "source_hash": "e8fa7368fae5",
      "text": "初版に仙女は出ません！"
    },
    "r5fw": {
      "source_hash": "0ef4304d59c5",
      "text": "白い鳥が救う。"
    },
    "whv7": {
      "source_hash": "98d9798bd767",
      "text": "鳥がドレスや靴を落としてくれたの？"
    },
    "ddi5": {
      "source_hash": "a27eb566a99e",
      "text": "木に願いを唱えれば、"
    },
    "blk4": {
      "source_hash": "09cb22739111",
      "text": "白い鳥が望みを落とした。"
    },
    "1ou0": {
      "source_hash": "ae4b3cb06331",
      "text": "三日間の舞踏会が開催。"
    },
    "h04o": {
      "source_hash": "db50bda837a2",
      "text": "灰の豆拾いを命じた"
    },
    "yrbe": {
      "source_hash": "fd2cc6535f6a",
      "text": "一人で拾い集められるわけがありません！"
    },
    "83d7": {
      "source_hash": "2eab56a9076c",
      "text": "無数の鳩が拾い集めた！"
    },
    "bm2e": {
      "source_hash": "3032f6994368",
      "text": "継母は冷笑し去った。"
    },
    "gdqx": {
      "source_hash": "f5819ed4fdd7",
      "text": "シンデレラは木へ走る！"
    },
    "smgk": {
      "source_hash": "bb1b7dea515e",
      "text": "鳥は金銀のドレスを落とし、"
    },
    "5w8s": {
      "source_hash": "524218652206",
      "text": "そして見事な金の靴も！"
    },
    "edx1": {
      "source_hash": "967fe282a61d",
      "text": "夜の12時になるとカボチャの馬車は消えたのですか？"
    },
    "zcbw": {
      "source_hash": "033358e3222c",
      "text": "奇妙なことに、カボチャはない！"
    },
    "gq4c": {
      "source_hash": "3fa9928a3337",
      "text": "初版に十二時の鐘などない！"
    },
    "5hw7": {
      "source_hash": "96b0eba5a060",
      "text": "なぜ夜に逃げたのですか？"
    },
    "g4nw": {
      "source_hash": "52f5cdc714c6",
      "text": "王子に素性を隠すためでした。"
    },
    "reb6": {
      "source_hash": "7f7432414776",
      "text": "三日目の舞踏会の終わり、"
    },
    "f738": {
      "source_hash": "7ef178c14f9d",
      "text": "階段一面に黒いタールを！"
    },
    "vm7e": {
      "source_hash": "5b4602715035",
      "text": "階段にタールを塗った？！"
    },
    "h5ua": {
      "source_hash": "318c3d206466",
      "text": "彼女が駆け下りたとき、"
    },
    "57dk": {
      "source_hash": "ee53982932b9",
      "text": "右足の金の靴が張り付いた！"
    },
    "rm2d": {
      "source_hash": "3b9b86bfdf3b",
      "text": "王子は靴を持って家へ。"
    },
    "au8n": {
      "source_hash": "fc9c9184533e",
      "text": "長女が部屋で試着、"
    },
    "smoq": {
      "source_hash": "57d3a7a1cc85",
      "text": "だが踵が大きく入らない。"
    },
    "2xqj": {
      "source_hash": "ef7a161c455f",
      "text": "そこで母がナイフを渡したの？"
    },
    "aqo8": {
      "source_hash": "a92a0cdb7a35",
      "text": "痛くても我慢しろ！"
    },
    "6lp0": {
      "source_hash": "a8be0c6d7943",
      "text": "長女は踵を切り、足を押し込んだ！"
    },
    "v380": {
      "source_hash": "fe7e48ac1851",
      "text": "なんてこと！王子は気づかなかったのですか？"
    },
    "k7sz": {
      "source_hash": "e1294ea8ff35",
      "text": "王子は騙されて彼女を馬に乗せました。"
    },
    "j8e7": {
      "source_hash": "013e42fc6c3a",
      "text": "だが城門を通る時、上の鳩が叫んだ！"
    },
    "1aqn": {
      "source_hash": "657e4f8ad1c0",
      "text": "ルック・ディ・グー！靴の中に血があるぞ！"
    },
    "mw3j": {
      "source_hash": "286db650d1a5",
      "text": "王子が見ると、白い靴下が血に染まっていた！"
    },
    "i694": {
      "source_hash": "a6ddd2669630",
      "text": "恐ろしい！次女は？"
    },
    "okhw": {
      "source_hash": "cdc5cbbb6d90",
      "text": "次女も爪先を切り落とした！"
    },
    "wa7h": {
      "source_hash": "e2883979a6a4",
      "text": "同じこと：鳩が再び叫んだ！"
    },
    "b8nf": {
      "source_hash": "e66d095ef282",
      "text": "二度の血塗られた嘘はその場で暴かれました！"
    },
    "zzww": {
      "source_hash": "edbb357827dc",
      "text": "ついにシンデレラの番がやって来ました！"
    },
    "9qv9": {
      "source_hash": "a972f8ca2961",
      "text": "彼女は手を洗い、進み出た。"
    },
    "gq7c": {
      "source_hash": "f6daab0596ae",
      "text": "金の靴はぴったりと収まった！"
    },
    "bzxv": {
      "source_hash": "edab7a67bf19",
      "text": "意地悪な二人の姉はどうなったのですか？"
    },
    "ly17": {
      "source_hash": "c17fb98bd12e",
      "text": "奇妙なことに、初版に処罰はない！"
    },
    "twsn": {
      "source_hash": "177a91069d1b",
      "text": "王子が連れ帰って話は終わる！"
    },
    "lisv": {
      "source_hash": "af9c7d889ab3",
      "text": "えっ？！姉たちに罰がないの？！"
    },
    "novp": {
      "source_hash": "ba5ab43c0eee",
      "text": "意外だろう？"
    },
    "36vf": {
      "source_hash": "f2c53ed75a85",
      "text": "では、仙女やカボチャの馬車は誰が作ったのですか？"
    },
    "a6qn": {
      "source_hash": "1717f0e02074",
      "text": "一六九七年に遡る！"
    },
    "qc3e": {
      "source_hash": "4e8c2a3a0ddd",
      "text": "パリの作家シャルル・ペローが、"
    },
    "hr84": {
      "source_hash": "d587ffbc7800",
      "text": "後世に残る童話集を出版。"
    },
    "wtkn": {
      "source_hash": "4befbffba4d1",
      "text": "彼の宮廷版の中で、"
    },
    "hzeu": {
      "source_hash": "efe12d563796",
      "text": "杖を持つ仙女が初登場した！"
    },
    "2baj": {
      "source_hash": "0f28df2edf80",
      "text": "そこでカボチャが馬車になったのですね！"
    },
    "m0gl": {
      "source_hash": "791870f181ee",
      "text": "そう！カボチャが金の馬車に、"
    },
    "zela": {
      "source_hash": "badb45e7d924",
      "text": "鼠は名馬に、大鼠は御者に！"
    },
    "wuzq": {
      "source_hash": "7ab404f94d2d",
      "text": "仙女は彼女に透き通るガラスの靴を授けました！"
    },
    "jjv9": {
      "source_hash": "ea6b80ec9cb0",
      "text": "ペロー版でも姉たちは足を切ったのですか？"
    },
    "aesw": {
      "source_hash": "1a1dd4a4523d",
      "text": "全く！フランス宮廷は優雅重視だ。"
    },
    "xvrt": {
      "source_hash": "b40da626d11f",
      "text": "姉たちは素直に諦めた。"
    },
    "tdwk": {
      "source_hash": "2b6980504cbe",
      "text": "結婚式で姉たちを許し、"
    },
    "tm3b": {
      "source_hash": "af1956241b9d",
      "text": "なんと優しく寛大な結末でしょう！"
    },
    "iobi": {
      "source_hash": "82ccad613298",
      "text": "だがグリム兄弟は酷評した！"
    },
    "xpj0": {
      "source_hash": "c4a924458507",
      "text": "初版注記でこう批判している："
    },
    "b1of": {
      "source_hash": "7089ce35b556",
      "text": "ペローの話は駄作だ！"
    },
    "lemu": {
      "source_hash": "903d6c59a6a7",
      "text": "グリム兄弟は温和すぎると批判を？！"
    },
    "q9hh": {
      "source_hash": "1298ca5abf0e",
      "text": "童話は温和になる？"
    },
    "pepd": {
      "source_hash": "53105af4af4c",
      "text": "しかしグリム兄弟のシンデレラは、"
    },
    "muzj": {
      "source_hash": "82ea6ce13a65",
      "text": "だが改訂毎に残酷になった！"
    },
    "khon": {
      "source_hash": "c1b2dcbf855e",
      "text": "残酷さを増した？より過酷な場面が追加されたのですか？"
    },
    "dckz": {
      "source_hash": "da8cd6819e8d",
      "text": "一八一九年の第二版。"
    },
    "dbsp": {
      "source_hash": "38d3357f640c",
      "text": "まず父がハシバミの枝を持ち帰る場面を追加。"
    },
    "ib6y": {
      "source_hash": "3a7fe0874264",
      "text": "彼女は枝を母の墓に植えた。"
    },
    "nppt": {
      "source_hash": "4caf4906cceb",
      "text": "これがあの有名なハシバミの木となったのです！"
    },
    "n565": {
      "source_hash": "4d0871fc3452",
      "text": "切る順序も逆に！"
    },
    "jsx9": {
      "source_hash": "bb35b1309ffd",
      "text": "長女が爪先、次女が踵を切る形に！"
    },
    "94w8": {
      "source_hash": "3b2d5e2f9a45",
      "text": "母親の台詞もさらに冷酷になりました。"
    },
    "e2i4": {
      "source_hash": "a0ff045fedee",
      "text": "爪先を切り落としなさい！"
    },
    "h4xc": {
      "source_hash": "fe8271b04521",
      "text": "王妃になれば歩く必要はない！"
    },
    "nxab": {
      "source_hash": "05772bfa7e12",
      "text": "歩く必要がないなんて……背筋が凍る！"
    },
    "tf3v": {
      "source_hash": "6cf48b6822db",
      "text": "本当の恐怖はここから！"
    },
    "qrca": {
      "source_hash": "8e61f948dfdd",
      "text": "第2版の結末において、"
    },
    "ogvj": {
      "source_hash": "ff5f5986f8a4",
      "text": "自ら凄惨な血の私刑を書き加えた！"
    },
    "z6lb": {
      "source_hash": "781a2a447820",
      "text": "式に何を追加したの？！"
    },
    "z5i2": {
      "source_hash": "8c81922b7cd4",
      "text": "式当日、教会は群衆で溢れていた。"
    },
    "bbyt": {
      "source_hash": "093a73791e36",
      "text": "足を切った姉たちも駆けつけた！"
    },
    "g2n5": {
      "source_hash": "8129f17bb7dc",
      "text": "分け前を狙う気？！"
    },
    "4do0": {
      "source_hash": "2388095ecd2b",
      "text": "長女は右を、次女は左を歩いた。"
    },
    "y1up": {
      "source_hash": "3741191c021c",
      "text": "その時、さらに奇怪な出来事が起きた！"
    },
    "oyo9": {
      "source_hash": "e1f30af0e977",
      "text": "白鳩が矢のごとく急降下！"
    },
    "2bpc": {
      "source_hash": "e4e129731fa1",
      "text": "姉たちに襲いかかり、片目を抉り取った！"
    },
    "7okx": {
      "source_hash": "ab98f00f7a18",
      "text": "片目を抉り取ったのですか？！"
    },
    "h529": {
      "source_hash": "877c04407c12",
      "text": "姉たちは激痛を耐え抜いた。"
    },
    "ft1n": {
      "source_hash": "88b3d425b45d",
      "text": "だが教会を出る時、再び天罰が下る！"
    },
    "rl2j": {
      "source_hash": "99c9583d9710",
      "text": "鳩が急襲！"
    },
    "2zxg": {
      "source_hash": "862e1b4babc5",
      "text": "もう一方の目も容赦なく抉り取った！"
    },
    "vv44": {
      "source_hash": "196d62af8fd8",
      "text": "原文は記す："
    },
    "r4xd": {
      "source_hash": "dc8eec1b13dc",
      "text": "邪悪の罰として、生涯盲目となった！"
    },
    "4xql": {
      "source_hash": "3b3b2c4067a6",
      "text": "この結末は最終第７版まで保たれた！"
    },
    "4nub": {
      "source_hash": "143269c4f8fd",
      "text": "当時の読者から残酷すぎると言われなかったのですか？"
    },
    "11te": {
      "source_hash": "205353fc6855",
      "text": "悪には報いを。それがグリム兄弟の信念だった！"
    },
    "1dnb": {
      "source_hash": "a8d41b18065f",
      "text": "所長、グリム版がそんなに恐ろしいのなら、"
    },
    "t57s": {
      "source_hash": "0b9c8383738d",
      "text": "子供の頃に見た話となぜ違うの？"
    },
    "cl4w": {
      "source_hash": "9c4273616967",
      "text": "それは二十世紀の夢の魔術師、ディズニーのおかげだ！"
    },
    "a5nm": {
      "source_hash": "aec77120cd48",
      "text": "1950年『シンデレラ』公開！"
    },
    "eckd": {
      "source_hash": "18057a74b0a1",
      "text": "制作陣が下した決断："
    },
    "iiat": {
      "source_hash": "a19ee54abec3",
      "text": "グリム兄弟の血塗られた復讐を完全に排除し、"
    },
    "i980": {
      "source_hash": "2c1d80887ff5",
      "text": "二百五十年前のペロー仏宮廷版を採用！"
    },
    "ztwb": {
      "source_hash": "b7008b6a6fd4",
      "text": "呪文を唱える明るい仙女のおばあさん！"
    },
    "nwih": {
      "source_hash": "d10925d4661c",
      "text": "夢のカボチャ馬車とガラスの靴だ！"
    },
    "sd6v": {
      "source_hash": "631195331d79",
      "text": "ディズニーは優しさと奇跡で歴史の残酷さを包み込みました。"
    },
    "ykq7": {
      "source_hash": "458351926e2b",
      "text": "ガラスの靴が毛皮の誤訳だという噂はどうなのですか？"
    },
    "oegz": {
      "source_hash": "698889f0e9f6",
      "text": "ペローが毛皮とガラスを取り違えたという俗説。"
    },
    "54lu": {
      "source_hash": "beaebcb2f6ca",
      "text": "だが一六九七年の初版には、明確にガラスとある！"
    },
    "ca7l": {
      "source_hash": "51c8802cb550",
      "text": "民俗学も立証済み：ガラスの靴は誤訳ではない！"
    },
    "z377": {
      "source_hash": "6d7faa48ef9f",
      "text": "ペローが意図した脆き奇跡だ！"
    },
    "0ing": {
      "source_hash": "d567c4314dd2",
      "text": "毛皮の誤訳説も嘘だったのですね！歴史の探求は本当に面白いです！"
    },
    "ez8v": {
      "source_hash": "48a92955b277",
      "text": "初版の小さな木と金の靴から、"
    },
    "hsvi": {
      "source_hash": "fc87fa994a29",
      "text": "足の切断や両目の天罰を経て、"
    },
    "5mzk": {
      "source_hash": "04c6b989890c",
      "text": "そしてペローとディズニーのカボチャの馬車とガラスの靴へ。"
    },
    "5su7": {
      "source_hash": "8ea5acafa84b",
      "text": "人は各時代、童話に自らの心の安らぎを求めたのですね！"
    },
    "oxrk": {
      "source_hash": "6631a1f10c7a",
      "text": "二百年のシンデレラが示す教訓："
    },
    "67lq": {
      "source_hash": "3314acc0559f",
      "text": "童話は時代を映す心の鏡だ！"
    },
    "ds9n": {
      "source_hash": "467aa367f164",
      "text": "シンデレラ事件檔案、記録完了！"
    },
    "1gti": {
      "source_hash": "cbdc0caccb74",
      "text": "あなたが一番衝撃を受けた原版童話は何ですか？"
    },
    "k7zf": {
      "source_hash": "cdb71a63302d",
      "text": "ぜひコメント欄で教えてください。高評価とチャンネル登録もお忘れなく！"
    }
  }
}
