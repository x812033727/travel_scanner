{
  "zq46a01": {
    "text": "I, Xu Yan, a student—",
    "emotion": "一邊擂鼓一邊喊",
    "say": "Student Xu Yan,"
  },
  "zq46a02": {
    "text": "my exam paper was switched!",
    "emotion": "用盡力氣",
    "say": "Paper swapped!"
  },
  "zq46a03": {
    "text": "Whoever beat the drum,",
    "emotion": "拉長音吆喝",
    "say": "Who beat the drum,"
  },
  "zq46a04": {
    "text": "come before the court!",
    "emotion": "嗓門大",
    "say": "into court!"
  },
  "zq46a05": {
    "text": "I'll fetch the headmaster.",
    "emotion": "壓低斗笠，轉身"
  },
  "zq46a06": {
    "text": "You say your paper was switched.",
    "emotion": "沉聲",
    "say": "Your paper was switched?"
  },
  "zq46a07": {
    "text": "Where's your proof?",
    "emotion": "不怒自威",
    "say": "Proof?"
  },
  "zq46a08": {
    "text": "The top paper on the list,",
    "emotion": "拱手",
    "say": "The top paper,"
  },
  "zq46a09": {
    "text": "I wrote it myself.",
    "emotion": "不卑不亢",
    "say": "I wrote it."
  },
  "zq46a10": {
    "text": "The handwriting on this paper",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "This handwriting"
  },
  "zq46a11": {
    "text": "is Wei Xun's.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "what do you say?",
    "emotion": "沉聲",
    "say": "Well?"
  },
  "zq46a14": {
    "text": "My conscience is clear.",
    "emotion": "拱手，倨傲"
  },
  "zq46a15": {
    "text": "A country Scholar",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "gone mad dreaming of being Jieyuan.",
    "emotion": "嗤笑",
    "say": "mad to be Jieyuan."
  },
  "zq46a17": {
    "text": "Slandering an examiner:",
    "emotion": "拖長音"
  },
  "zq46a18": {
    "text": "thirty strokes, and stripped of your title!",
    "emotion": "陡然拔高",
    "say": "thirty strokes, title stripped!"
  },
  "zq46a19": {
    "text": "Handwriting can be copied,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Copy a hand,"
  },
  "zq46a20": {
    "text": "but an essay can't be.",
    "emotion": "一字一字",
    "say": "not an essay."
  },
  "zq46a21": {
    "text": "Your Honor, give us paper and brush,",
    "emotion": "拱手",
    "say": "Brush and paper,"
  },
  "zq46a22": {
    "text": "and he and I will write it from memory, right here.",
    "emotion": "指向魏珣",
    "say": "he and I write it here."
  },
  "zq46a23": {
    "text": "Absurd!",
    "emotion": "甩袖"
  },
  "zq46a24": {
    "text": "Throw him out!",
    "emotion": "對衙役"
  },
  "zq46a25": {
    "text": "Whoever beats the drum,",
    "emotion": "抬手，沉聲",
    "say": "The drummer,"
  },
  "zq46a26": {
    "text": "this court will hear him.",
    "emotion": "一錘定音"
  },
  "zq46a27": {
    "text": "One stick of incense is your limit.",
    "emotion": "抽出一支香",
    "say": "One stick of incense."
  },
  "zq46a28": {
    "text": "Begin.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "Lift the water with waterwheels,",
    "emotion": "搶先開口，邊寫邊念",
    "say": "Wheels lift water,"
  },
  "zq46a30": {
    "text": "not waiting on the heavens.",
    "emotion": "得意",
    "say": "never waiting on heaven."
  },
  "zq46a31": {
    "text": "Make way,",
    "emotion": "撥開人群"
  },
  "zq46a32": {
    "text": "Headmaster Cheng is here!",
    "emotion": "揚聲",
    "say": "Headmaster Cheng's here!"
  },
  "zq46a33": {
    "text": "I stood as his guarantor,",
    "emotion": "拱手",
    "say": "I vouched,"
  },
  "zq46a34": {
    "text": "so I've come to listen.",
    "emotion": "不慌不忙",
    "say": "I'll listen."
  },
  "zq46a35": {
    "text": "Headmaster Cheng,",
    "emotion": "起身半禮",
    "say": "Headmaster,"
  },
  "zq46a36": {
    "text": "please, sit.",
    "emotion": "抬手示意",
    "say": "Please sit."
  },
  "zq46a37": {
    "text": "Word for word?",
    "emotion": "在門口，倒抽一口氣"
  },
  "zq46a38": {
    "text": "Dark circles under his eyes,",
    "emotion": "瞇眼，低聲",
    "say": "Dark under the eyes,"
  },
  "zq46a39": {
    "text": "he didn't sleep all night.",
    "emotion": "看穿",
    "say": "he was up all night."
  },
  "zq46a40": {
    "text": "Memorized it overnight,",
    "emotion": "低聲，嘴角一勾",
    "say": "Up all night,"
  },
  "zq46a41": {
    "text": "that must've been hard on you.",
    "emotion": "淡淡地",
    "say": "must've been hard."
  },
  "zq46a42": {
    "text": "Recite away.",
    "emotion": "低頭寫，不急",
    "say": "Go."
  },
  "zq46a43": {
    "text": "Let's see how far you get.",
    "emotion": "嘴角一勾"
  },
  "zq46a44": {
    "text": "Word for word.",
    "emotion": "筆往桌上一拍"
  },
  "zq46a45": {
    "text": "Slandering an examiner,",
    "emotion": "冷笑，低聲，快，說完就停",
    "say": "False charges,"
  },
  "zq46a46": {
    "text": "thirty strokes!",
    "emotion": "陡然拔高"
  },
  "zq46a47": {
    "text": "Order——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "in court——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "Xu Yan!",
    "emotion": "尖聲"
  }
}
