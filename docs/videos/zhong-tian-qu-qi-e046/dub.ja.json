{
  "zq46a01": {
    "text": "学生シュー・イェン、",
    "emotion": "一邊擂鼓一邊喊",
    "say": "シュー・イェン、"
  },
  "zq46a02": {
    "text": "答案をすり替えられた！",
    "emotion": "用盡力氣",
    "say": "すり替えだ！"
  },
  "zq46a03": {
    "text": "太鼓を打った者、",
    "emotion": "拉長音吆喝"
  },
  "zq46a04": {
    "text": "堂に上がれ！",
    "emotion": "嗓門大"
  },
  "zq46a05": {
    "text": "山長を呼んでくる。",
    "emotion": "壓低斗笠，轉身",
    "say": "山長を呼ぶ。"
  },
  "zq46a06": {
    "text": "答案をすり替えられたと申すが、",
    "emotion": "沉聲",
    "say": "すり替えだと？"
  },
  "zq46a07": {
    "text": "証拠は？",
    "emotion": "不怒自威"
  },
  "zq46a08": {
    "text": "首位の答案は、",
    "emotion": "拱手",
    "say": "首位は、"
  },
  "zq46a09": {
    "text": "学生が書いたものです。",
    "emotion": "不卑不亢",
    "say": "私の作です。"
  },
  "zq46a10": {
    "text": "答案の筆跡は、",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "筆跡は、"
  },
  "zq46a11": {
    "text": "ウェイ・シュンのものだ。",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "ウェイ・シュン、",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "そなたはどう申す？",
    "emotion": "沉聲",
    "say": "どうだ？"
  },
  "zq46a14": {
    "text": "天地に恥じることはありません。",
    "emotion": "拱手，倨傲",
    "say": "潔白です。"
  },
  "zq46a15": {
    "text": "田舎の秀才が、",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "解元欲しさに狂ったか。",
    "emotion": "嗤笑"
  },
  "zq46a17": {
    "text": "試験官を誣告すれば、",
    "emotion": "拖長音",
    "say": "誣告の罪、"
  },
  "zq46a18": {
    "text": "杖打ち三十、功名剥奪！",
    "emotion": "陡然拔高",
    "say": "棒打ち三十、資格剥奪！"
  },
  "zq46a19": {
    "text": "筆跡は写せても、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "写せる、"
  },
  "zq46a20": {
    "text": "文章は写せない。",
    "emotion": "一字一字"
  },
  "zq46a21": {
    "text": "大人、紙と筆をください、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "紙と筆、"
  },
  "zq46a22": {
    "text": "彼とこの場で書き比べます。",
    "emotion": "指向魏珣",
    "say": "彼と書き比べます。"
  },
  "zq46a23": {
    "text": "ばかな！",
    "emotion": "甩袖"
  },
  "zq46a24": {
    "text": "つまみ出せ！",
    "emotion": "對衙役"
  },
  "zq46a25": {
    "text": "太鼓を打った者の訴え、",
    "emotion": "低聲，快，說完就停",
    "say": "訴えは、"
  },
  "zq46a26": {
    "text": "本府が聞こう。",
    "emotion": "一錘定音",
    "say": "わしが聞く。"
  },
  "zq46a27": {
    "text": "線香一本が刻限だ。",
    "emotion": "低聲，快，說完就停",
    "say": "香一本、"
  },
  "zq46a28": {
    "text": "始め。",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "水車で水を引き、",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "水車で引水、"
  },
  "zq46a30": {
    "text": "天の時に頼らず。",
    "emotion": "得意",
    "say": "天に頼らず。"
  },
  "zq46a31": {
    "text": "どいて、",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "チョン山長が来たわ！",
    "emotion": "揚聲",
    "say": "チョン山長よ！"
  },
  "zq46a33": {
    "text": "保証したのはわしだ、",
    "emotion": "拱手",
    "say": "わしの保証だ、"
  },
  "zq46a34": {
    "text": "わしも聞こう。",
    "emotion": "不慌不忙"
  },
  "zq46a35": {
    "text": "チョン山長、",
    "emotion": "起身半禮"
  },
  "zq46a36": {
    "text": "どうぞお掛けを。",
    "emotion": "抬手示意",
    "say": "お掛けを。"
  },
  "zq46a37": {
    "text": "一字一句同じ？",
    "emotion": "在門口，倒抽一口氣",
    "say": "一字違わず？"
  },
  "zq46a38": {
    "text": "目の下が青い、",
    "emotion": "瞇眼，低聲"
  },
  "zq46a39": {
    "text": "一晩寝てないわ。",
    "emotion": "看穿"
  },
  "zq46a40": {
    "text": "一晩で覚えたのか、",
    "emotion": "低聲，快，說完就停",
    "say": "徹夜か、"
  },
  "zq46a41": {
    "text": "ご苦労さん。",
    "emotion": "淡淡地"
  },
  "zq46a42": {
    "text": "暗唱しな。",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ほら。"
  },
  "zq46a43": {
    "text": "どこまで覚えたか見せてもらう。",
    "emotion": "嘴角一勾",
    "say": "どこまでいけるか。"
  },
  "zq46a44": {
    "text": "一字違わず。",
    "emotion": "筆往桌上一拍"
  },
  "zq46a45": {
    "text": "試験官を誣告した罪、",
    "emotion": "冷笑，低聲，快，說完就停",
    "say": "誣告は、"
  },
  "zq46a46": {
    "text": "杖打ち三十！",
    "emotion": "陡然拔高",
    "say": "棒打ち三十！"
  },
  "zq46a47": {
    "text": "威——",
    "emotion": "衙役齊喊，拉長音",
    "say": "ウェーイ"
  },
  "zq46a48": {
    "text": "武——",
    "emotion": "棍子頓地",
    "say": "ウー"
  },
  "zq46a49": {
    "text": "シュー・イェン！",
    "emotion": "尖聲"
  }
}
