{
  "zq46a01": {
    "text": "¡Soy Xu Yan, estudiante,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "¡Xu Yan,"
  },
  "zq46a02": {
    "text": "me cambiaron el examen!",
    "emotion": "用盡力氣",
    "say": "¡Lo cambiaron!"
  },
  "zq46a03": {
    "text": "Quien tocó el tambor,",
    "emotion": "嗓門大，快，不拖音",
    "say": "¡El del tambor,"
  },
  "zq46a04": {
    "text": "¡que pase a la sala!",
    "emotion": "嗓門大",
    "say": "¡adentro!"
  },
  "zq46a05": {
    "text": "Voy por el rector.",
    "emotion": "壓低斗笠，轉身"
  },
  "zq46a06": {
    "text": "Dices que cambiaron tu examen;",
    "emotion": "沉聲",
    "say": "¿Cambiaron tu examen?"
  },
  "zq46a07": {
    "text": "¿y las pruebas?",
    "emotion": "不怒自威",
    "say": "¿Pruebas?"
  },
  "zq46a08": {
    "text": "El primero de la lista,",
    "emotion": "拱手",
    "say": "El primero,"
  },
  "zq46a09": {
    "text": "lo escribí yo.",
    "emotion": "不卑不亢"
  },
  "zq46a10": {
    "text": "La letra de este examen",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "Esta letra"
  },
  "zq46a11": {
    "text": "es de Wei Xun.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "¿qué dices tú?",
    "emotion": "沉聲",
    "say": "¿Y tú?"
  },
  "zq46a14": {
    "text": "Tengo la conciencia limpia.",
    "emotion": "拱手，倨傲",
    "say": "Conciencia limpia."
  },
  "zq46a15": {
    "text": "Un letrado de pueblo",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "enloquecido por ser el primero del examen provincial.",
    "emotion": "嗤笑",
    "say": "loco por ser el primero."
  },
  "zq46a17": {
    "text": "Calumniar a un examinador:",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a18": {
    "text": "¡treinta azotes y fuera tu título!",
    "emotion": "陡然拔高",
    "say": "¡treinta azotes, sin título!"
  },
  "zq46a19": {
    "text": "La letra se puede copiar,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Letra, sí,"
  },
  "zq46a20": {
    "text": "pero un texto no.",
    "emotion": "一字一字",
    "say": "el texto, no."
  },
  "zq46a21": {
    "text": "Señoría, denos papel y pincel,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Papel, pincel,"
  },
  "zq46a22": {
    "text": "y lo escribimos aquí, de memoria.",
    "emotion": "指向魏珣",
    "say": "y escribimos aquí."
  },
  "zq46a23": {
    "text": "¡Absurdo!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a24": {
    "text": "¡Échenlo!",
    "emotion": "對衙役"
  },
  "zq46a25": {
    "text": "A quien toca el tambor,",
    "emotion": "低聲，快，說完就停",
    "say": "Al que llama,"
  },
  "zq46a26": {
    "text": "esta prefectura lo escuchará.",
    "emotion": "一錘定音",
    "say": "lo escucharé."
  },
  "zq46a27": {
    "text": "Una varilla de incienso de plazo.",
    "emotion": "低聲，快，說完就停",
    "say": "Un incienso,"
  },
  "zq46a28": {
    "text": "Comiencen.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "Con norias se sube el agua,",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "Con norias,"
  },
  "zq46a30": {
    "text": "sin depender del cielo.",
    "emotion": "得意",
    "say": "sin el cielo."
  },
  "zq46a31": {
    "text": "Permiso,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "¡llegó el rector Cheng!",
    "emotion": "揚聲",
    "say": "¡El rector!"
  },
  "zq46a33": {
    "text": "Yo di el aval,",
    "emotion": "拱手"
  },
  "zq46a34": {
    "text": "vengo a escuchar.",
    "emotion": "低聲，快，說完就停",
    "say": "escucharé."
  },
  "zq46a35": {
    "text": "Rector Cheng,",
    "emotion": "起身半禮"
  },
  "zq46a36": {
    "text": "tome asiento.",
    "emotion": "抬手示意",
    "say": "Siéntese."
  },
  "zq46a37": {
    "text": "¿Palabra por palabra?",
    "emotion": "在門口，倒抽一口氣",
    "say": "¿Idéntico?"
  },
  "zq46a38": {
    "text": "Tiene ojeras,",
    "emotion": "瞇眼，低聲"
  },
  "zq46a39": {
    "text": "no durmió en toda la noche.",
    "emotion": "看穿",
    "say": "no durmió nada."
  },
  "zq46a40": {
    "text": "Lo memorizaste anoche,",
    "emotion": "低聲，快，說完就停",
    "say": "Te desvelaste,"
  },
  "zq46a41": {
    "text": "qué esfuerzo.",
    "emotion": "淡淡地"
  },
  "zq46a42": {
    "text": "Recita.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Va."
  },
  "zq46a43": {
    "text": "A ver hasta dónde llegas.",
    "emotion": "嘴角一勾"
  },
  "zq46a44": {
    "text": "Palabra por palabra.",
    "emotion": "筆往桌上一拍",
    "say": "Idéntico."
  },
  "zq46a45": {
    "text": "Calumniar a un examinador,",
    "emotion": "低聲，快，說完就停，不笑，不清嗓子",
    "say": "Calumnia,"
  },
  "zq46a46": {
    "text": "¡treinta azotes!",
    "emotion": "陡然拔高"
  },
  "zq46a47": {
    "text": "¡Orden——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "en la sala——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "¡Xu Yan!",
    "emotion": "尖聲"
  }
}
