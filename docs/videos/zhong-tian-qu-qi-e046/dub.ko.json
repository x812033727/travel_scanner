{
  "zq46a01": {
    "text": "학생 쉬옌,",
    "emotion": "一邊擂鼓一邊喊"
  },
  "zq46a02": {
    "text": "답안지가 바뀌었습니다!",
    "emotion": "用盡力氣",
    "say": "바꿔치기요!"
  },
  "zq46a03": {
    "text": "북을 친 자는,",
    "emotion": "拉長音吆喝"
  },
  "zq46a04": {
    "text": "당으로 들라!",
    "emotion": "嗓門大"
  },
  "zq46a05": {
    "text": "산장님 모셔 올게.",
    "emotion": "壓低斗笠，轉身"
  },
  "zq46a06": {
    "text": "답안지가 바뀌었다 했느냐,",
    "emotion": "沉聲",
    "say": "바뀌었다고?"
  },
  "zq46a07": {
    "text": "증거는?",
    "emotion": "不怒自威"
  },
  "zq46a08": {
    "text": "방 첫째 답안은,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "첫 답안,"
  },
  "zq46a09": {
    "text": "학생이 쓴 것입니다.",
    "emotion": "不卑不亢",
    "say": "제가 썼습니다."
  },
  "zq46a10": {
    "text": "답안의 필적은,",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "필적은,"
  },
  "zq46a11": {
    "text": "웨이쉰의 것이다.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "웨이쉰,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "너는 어찌 말하겠느냐?",
    "emotion": "沉聲",
    "say": "네 말은?"
  },
  "zq46a14": {
    "text": "학생은 떳떳합니다.",
    "emotion": "拱手，倨傲",
    "say": "떳떳합니다."
  },
  "zq46a15": {
    "text": "시골 수재가,",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "해원에 눈이 멀었군.",
    "emotion": "嗤笑"
  },
  "zq46a17": {
    "text": "시험관을 무고하면,",
    "emotion": "低聲，快，說完就停",
    "say": "무고하면,"
  },
  "zq46a18": {
    "text": "장 삼십에 공명 박탈이다!",
    "emotion": "陡然拔高",
    "say": "장 삼십, 공명 박탈!"
  },
  "zq46a19": {
    "text": "필적은 베껴도,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "베껴도,"
  },
  "zq46a20": {
    "text": "글은 못 베낍니다.",
    "emotion": "一字一字",
    "say": "글은 못 베껴."
  },
  "zq46a21": {
    "text": "나리, 지필을 주십시오,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "지필을,"
  },
  "zq46a22": {
    "text": "저자와 이 자리에서 외워 쓰겠습니다.",
    "emotion": "指向魏珣",
    "say": "같이 쓰겠습니다."
  },
  "zq46a23": {
    "text": "황당하군!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "황당한!"
  },
  "zq46a24": {
    "text": "쫓아내라!",
    "emotion": "對衙役"
  },
  "zq46a25": {
    "text": "북을 친 사람의 말,",
    "emotion": "低聲，快，說完就停",
    "say": "그 말은,"
  },
  "zq46a26": {
    "text": "본관이 듣겠다.",
    "emotion": "一錘定音"
  },
  "zq46a27": {
    "text": "향 한 대가 기한이다.",
    "emotion": "低聲，快，說完就停",
    "say": "향 한 대,"
  },
  "zq46a28": {
    "text": "시작.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "수차로 물을 끌어,",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "수차로 끌어,"
  },
  "zq46a30": {
    "text": "하늘에 기대지 않는다.",
    "emotion": "得意",
    "say": "하늘에 안 기댄다."
  },
  "zq46a31": {
    "text": "비켜요,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "청 산장님 오셨어요!",
    "emotion": "揚聲",
    "say": "청 산장님!"
  },
  "zq46a33": {
    "text": "보증은 노부가 섰으니,",
    "emotion": "拱手",
    "say": "내 보증,"
  },
  "zq46a34": {
    "text": "노부가 들으러 왔네.",
    "emotion": "不慌不忙",
    "say": "들으러 왔네."
  },
  "zq46a35": {
    "text": "청 산장,",
    "emotion": "起身半禮"
  },
  "zq46a36": {
    "text": "앉으시지요.",
    "emotion": "抬手示意"
  },
  "zq46a37": {
    "text": "한 자도 안 틀려?",
    "emotion": "在門口，倒抽一口氣"
  },
  "zq46a38": {
    "text": "눈 밑이 퍼레,",
    "emotion": "低聲，快，說完就停",
    "say": "눈 밑 퍼레,"
  },
  "zq46a39": {
    "text": "밤을 새웠어.",
    "emotion": "看穿"
  },
  "zq46a40": {
    "text": "밤새 외웠구나,",
    "emotion": "低聲，快，說完就停",
    "say": "밤샜구나,"
  },
  "zq46a41": {
    "text": "고생했다.",
    "emotion": "淡淡地"
  },
  "zq46a42": {
    "text": "외워 봐.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "해."
  },
  "zq46a43": {
    "text": "어디까지 외웠나 보자.",
    "emotion": "嘴角一勾",
    "say": "얼마나 외웠나."
  },
  "zq46a44": {
    "text": "한 자도 안 틀렸다.",
    "emotion": "筆往桌上一拍",
    "say": "한 자도 안 틀려."
  },
  "zq46a45": {
    "text": "시험관 무고죄,",
    "emotion": "冷笑，低聲，快，說完就停",
    "say": "무고죄,"
  },
  "zq46a46": {
    "text": "장 삼십!",
    "emotion": "陡然拔高"
  },
  "zq46a47": {
    "text": "위——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "무——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "쉬옌!",
    "emotion": "尖聲"
  }
}
