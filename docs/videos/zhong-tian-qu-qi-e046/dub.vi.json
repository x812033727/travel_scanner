{
  "zq46a01": {
    "text": "Học trò Hứa Nghiên,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Hứa Nghiên,"
  },
  "zq46a02": {
    "text": "bài thi bị tráo!",
    "emotion": "用盡力氣"
  },
  "zq46a03": {
    "text": "Kẻ đánh trống,",
    "emotion": "嗓門大，快，不拖音"
  },
  "zq46a04": {
    "text": "lên công đường!",
    "emotion": "嗓門大"
  },
  "zq46a05": {
    "text": "Ta đi mời sơn trưởng.",
    "emotion": "壓低斗笠，轉身"
  },
  "zq46a06": {
    "text": "Ngươi nói bài thi bị tráo,",
    "emotion": "沉聲",
    "say": "Bài bị tráo,"
  },
  "zq46a07": {
    "text": "chứng cứ đâu?",
    "emotion": "不怒自威"
  },
  "zq46a08": {
    "text": "Bài thủ bảng ấy,",
    "emotion": "拱手",
    "say": "Thủ bảng,"
  },
  "zq46a09": {
    "text": "là học trò viết.",
    "emotion": "不卑不亢",
    "say": "là tôi viết."
  },
  "zq46a10": {
    "text": "Nét chữ trên bài thi",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "Nét chữ này"
  },
  "zq46a11": {
    "text": "là của Ngụy Tuân.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "Ngụy Tuân,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "ngươi nói sao?",
    "emotion": "沉聲"
  },
  "zq46a14": {
    "text": "Học trò không thẹn với lòng.",
    "emotion": "拱手，倨傲",
    "say": "Tôi không thẹn."
  },
  "zq46a15": {
    "text": "Tú tài nhà quê,",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "mơ giải nguyên đến phát điên rồi.",
    "emotion": "不屑，快，說完就停，不笑",
    "say": "mơ giải nguyên phát điên."
  },
  "zq46a17": {
    "text": "Vu cáo quan chấm thi,",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a18": {
    "text": "đánh ba mươi trượng, tước công danh!",
    "emotion": "陡然拔高"
  },
  "zq46a19": {
    "text": "Nét chữ chép được,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Chữ chép được,"
  },
  "zq46a20": {
    "text": "văn chương thì không.",
    "emotion": "一字一字"
  },
  "zq46a21": {
    "text": "Xin đại nhân cho giấy bút,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Xin giấy bút,"
  },
  "zq46a22": {
    "text": "tôi và hắn chép lại tại công đường.",
    "emotion": "指向魏珣",
    "say": "tôi với hắn cùng chép."
  },
  "zq46a23": {
    "text": "Hoang đường!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a24": {
    "text": "Đuổi ra!",
    "emotion": "對衙役"
  },
  "zq46a25": {
    "text": "Người đánh trống,",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a26": {
    "text": "bản phủ muốn nghe.",
    "emotion": "一錘定音"
  },
  "zq46a27": {
    "text": "Hạn một nén nhang,",
    "emotion": "低聲，快，說完就停",
    "say": "Một nén nhang,"
  },
  "zq46a28": {
    "text": "bắt đầu.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "Dùng guồng nước dẫn nước,",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "Guồng dẫn nước,"
  },
  "zq46a30": {
    "text": "không cầu thiên thời.",
    "emotion": "得意，快，說完就停，不笑"
  },
  "zq46a31": {
    "text": "Tránh ra,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "Trình sơn trưởng đến rồi!",
    "emotion": "揚聲",
    "say": "Sơn trưởng đến!"
  },
  "zq46a33": {
    "text": "Lão phu bảo lãnh,",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a34": {
    "text": "lão phu đến nghe.",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a35": {
    "text": "Trình sơn trưởng,",
    "emotion": "起身半禮"
  },
  "zq46a36": {
    "text": "mời ngồi.",
    "emotion": "抬手示意"
  },
  "zq46a37": {
    "text": "Không sai một chữ?",
    "emotion": "在門口，倒抽一口氣"
  },
  "zq46a38": {
    "text": "Quầng mắt hắn thâm xanh,",
    "emotion": "瞇眼，低聲",
    "say": "Mắt hắn thâm,"
  },
  "zq46a39": {
    "text": "thức trắng cả đêm.",
    "emotion": "看穿"
  },
  "zq46a40": {
    "text": "Thức đêm học thuộc,",
    "emotion": "低聲，快，說完就停",
    "say": "Thức đêm,"
  },
  "zq46a41": {
    "text": "vất vả cho ngươi rồi.",
    "emotion": "淡淡地",
    "say": "vất vả rồi."
  },
  "zq46a42": {
    "text": "Thuộc đi.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Đọc."
  },
  "zq46a43": {
    "text": "Xem ngươi thuộc tới đâu.",
    "emotion": "嘴角一勾"
  },
  "zq46a44": {
    "text": "Không sai một chữ.",
    "emotion": "冷，快，說完就停"
  },
  "zq46a45": {
    "text": "Vu cáo quan chấm thi,",
    "emotion": "低聲，快，說完就停，不笑，不清嗓子",
    "say": "Vu cáo,"
  },
  "zq46a46": {
    "text": "ba mươi trượng!",
    "emotion": "陡然拔高，快，說完就停，不清嗓子"
  },
  "zq46a47": {
    "text": "Uy——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "Vũ——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "Hứa Nghiên!",
    "emotion": "尖聲"
  }
}
