{
  "zq46a01": {
    "text": "Sou o estudante Xu Yan,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Xu Yan,"
  },
  "zq46a02": {
    "text": "trocaram minha prova!",
    "emotion": "用盡力氣",
    "say": "Trocaram!"
  },
  "zq46a03": {
    "text": "Quem tocou o tambor,",
    "emotion": "嗓門大，快，不拖音",
    "say": "Quem tocou,"
  },
  "zq46a04": {
    "text": "suba ao tribunal!",
    "emotion": "嗓門大",
    "say": "Entre!"
  },
  "zq46a05": {
    "text": "Vou chamar o diretor.",
    "emotion": "壓低斗笠，轉身",
    "say": "Vou chamar o mestre."
  },
  "zq46a06": {
    "text": "Você diz que trocaram sua prova;",
    "emotion": "沉聲",
    "say": "Trocaram sua prova?"
  },
  "zq46a07": {
    "text": "cadê as provas?",
    "emotion": "不怒自威",
    "say": "Provas?"
  },
  "zq46a08": {
    "text": "A primeira da lista,",
    "emotion": "拱手",
    "say": "A primeira,"
  },
  "zq46a09": {
    "text": "fui eu que escrevi.",
    "emotion": "不卑不亢",
    "say": "fui eu."
  },
  "zq46a10": {
    "text": "A letra desta prova",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "Esta letra"
  },
  "zq46a11": {
    "text": "é de Wei Xun.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "o que você diz?",
    "emotion": "沉聲",
    "say": "E você?"
  },
  "zq46a14": {
    "text": "Estou de consciência limpa.",
    "emotion": "拱手，倨傲",
    "say": "Consciência limpa."
  },
  "zq46a15": {
    "text": "Um letrado da roça",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "enlouqueceu querendo ser o primeiro do exame provincial.",
    "emotion": "嗤笑",
    "say": "louco para ser o primeiro."
  },
  "zq46a17": {
    "text": "Caluniar um examinador:",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a18": {
    "text": "trinta varadas e perde o título!",
    "emotion": "陡然拔高",
    "say": "trinta varadas, sem título!"
  },
  "zq46a19": {
    "text": "A letra se copia,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Letra, sim,"
  },
  "zq46a20": {
    "text": "o texto, não.",
    "emotion": "一字一字"
  },
  "zq46a21": {
    "text": "Excelência, papel e pincel,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Papel, pincel,"
  },
  "zq46a22": {
    "text": "e nós dois escrevemos de memória, aqui.",
    "emotion": "指向魏珣",
    "say": "e escrevemos aqui."
  },
  "zq46a23": {
    "text": "Absurdo!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a24": {
    "text": "Ponham para fora!",
    "emotion": "對衙役",
    "say": "Fora!"
  },
  "zq46a25": {
    "text": "Quem toca o tambor,",
    "emotion": "低聲，快，說完就停",
    "say": "Quem chama,"
  },
  "zq46a26": {
    "text": "esta prefeitura vai ouvir.",
    "emotion": "一錘定音",
    "say": "eu vou ouvir."
  },
  "zq46a27": {
    "text": "Uma vareta de incenso de prazo.",
    "emotion": "低聲，快，說完就停",
    "say": "Um incenso,"
  },
  "zq46a28": {
    "text": "Comecem.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "Com rodas d’água se puxa a água,",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "Com rodas d’água,"
  },
  "zq46a30": {
    "text": "sem depender do céu.",
    "emotion": "得意，快，說完就停，不笑",
    "say": "sem o céu."
  },
  "zq46a31": {
    "text": "Licença,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "o Mestre Cheng chegou!",
    "emotion": "揚聲",
    "say": "O Mestre Cheng!"
  },
  "zq46a33": {
    "text": "Eu dei o aval,",
    "emotion": "拱手"
  },
  "zq46a34": {
    "text": "vim ouvir.",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a35": {
    "text": "Mestre Cheng,",
    "emotion": "起身半禮"
  },
  "zq46a36": {
    "text": "sente-se.",
    "emotion": "抬手示意"
  },
  "zq46a37": {
    "text": "Palavra por palavra?",
    "emotion": "在門口，倒抽一口氣",
    "say": "Idêntico?"
  },
  "zq46a38": {
    "text": "Ele está com olheiras,",
    "emotion": "瞇眼，低聲",
    "say": "Tem olheiras,"
  },
  "zq46a39": {
    "text": "não dormiu a noite toda.",
    "emotion": "看穿",
    "say": "não dormiu nada."
  },
  "zq46a40": {
    "text": "Decorou a noite toda,",
    "emotion": "低聲，快，說完就停",
    "say": "Virou a noite,"
  },
  "zq46a41": {
    "text": "que trabalheira.",
    "emotion": "淡淡地"
  },
  "zq46a42": {
    "text": "Recite.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Vai."
  },
  "zq46a43": {
    "text": "Vamos ver até onde vai.",
    "emotion": "嘴角一勾"
  },
  "zq46a44": {
    "text": "Palavra por palavra.",
    "emotion": "筆往桌上一拍",
    "say": "Idêntico."
  },
  "zq46a45": {
    "text": "Caluniar um examinador,",
    "emotion": "低聲，快，說完就停，不笑，不清嗓子",
    "say": "Calúnia,"
  },
  "zq46a46": {
    "text": "trinta varadas!",
    "emotion": "陡然拔高"
  },
  "zq46a47": {
    "text": "Ordem——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "no tribunal——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "Xu Yan!",
    "emotion": "尖聲"
  }
}
