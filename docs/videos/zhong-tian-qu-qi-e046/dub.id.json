{
  "zq46a01": {
    "text": "Murid Xu Yan,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Xu Yan,"
  },
  "zq46a02": {
    "text": "lembar ujian saya ditukar!",
    "emotion": "用盡力氣",
    "say": "Ditukar!"
  },
  "zq46a03": {
    "text": "Yang memukul genderang,",
    "emotion": "嗓門大，快，不拖音",
    "say": "Yang memukul,"
  },
  "zq46a04": {
    "text": "naik ke balai sidang!",
    "emotion": "嗓門大",
    "say": "Masuk!"
  },
  "zq46a05": {
    "text": "Aku panggil Guru Besar.",
    "emotion": "壓低斗笠，轉身",
    "say": "Kupanggil Guru."
  },
  "zq46a06": {
    "text": "Kau bilang lembar ujianmu ditukar;",
    "emotion": "沉聲",
    "say": "Ujianmu ditukar?"
  },
  "zq46a07": {
    "text": "mana buktinya?",
    "emotion": "低聲，快，說完就停",
    "say": "Bukti?"
  },
  "zq46a08": {
    "text": "Peringkat teratas itu,",
    "emotion": "拱手",
    "say": "Teratas,"
  },
  "zq46a09": {
    "text": "saya yang menulisnya.",
    "emotion": "不卑不亢",
    "say": "saya tulis."
  },
  "zq46a10": {
    "text": "Tulisan tangan di lembar ini",
    "emotion": "極短促，一口氣說完，不拖音，不清嗓子",
    "say": "Tulisan ini"
  },
  "zq46a11": {
    "text": "milik Wei Xun.",
    "emotion": "冷笑"
  },
  "zq46a12": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq46a13": {
    "text": "apa katamu?",
    "emotion": "沉聲",
    "say": "Kau?"
  },
  "zq46a14": {
    "text": "Hati saya bersih.",
    "emotion": "拱手，倨傲"
  },
  "zq46a15": {
    "text": "Sarjana dari desa",
    "emotion": "聞著香囊"
  },
  "zq46a16": {
    "text": "gila ingin jadi juara pertama ujian provinsi.",
    "emotion": "不屑，快，說完就停，不笑",
    "say": "gila ingin juara."
  },
  "zq46a17": {
    "text": "Memfitnah penguji:",
    "emotion": "低聲，快，說完就停"
  },
  "zq46a18": {
    "text": "tiga puluh pukulan, gelar dicabut!",
    "emotion": "陡然拔高",
    "say": "tiga puluh pukulan, gelar dicabut!"
  },
  "zq46a19": {
    "text": "Tulisan bisa ditiru,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Tulisan, ya,"
  },
  "zq46a20": {
    "text": "karangan tidak.",
    "emotion": "一字一字"
  },
  "zq46a21": {
    "text": "Tuan, beri kami kertas dan kuas,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Kertas, kuas,"
  },
  "zq46a22": {
    "text": "kami tulis dari ingatan di sini.",
    "emotion": "指向魏珣",
    "say": "kami tulis di sini."
  },
  "zq46a23": {
    "text": "Konyol!",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a24": {
    "text": "Usir dia!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Usir!"
  },
  "zq46a25": {
    "text": "Orang yang memukul genderang,",
    "emotion": "低聲，快，說完就停",
    "say": "Orang ini,"
  },
  "zq46a26": {
    "text": "saya mau dengar.",
    "emotion": "一錘定音"
  },
  "zq46a27": {
    "text": "Waktunya satu batang dupa.",
    "emotion": "低聲，快，說完就停",
    "say": "Satu dupa,"
  },
  "zq46a28": {
    "text": "Mulai.",
    "emotion": "沉聲"
  },
  "zq46a29": {
    "text": "Air diangkat dengan kincir,",
    "emotion": "搶先開口，快，一口氣說完",
    "say": "Pakai kincir,"
  },
  "zq46a30": {
    "text": "tanpa menunggu langit.",
    "emotion": "得意，快，說完就停，不笑",
    "say": "tanpa langit."
  },
  "zq46a31": {
    "text": "Permisi,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq46a32": {
    "text": "Guru Besar Cheng datang!",
    "emotion": "揚聲",
    "say": "Guru Cheng datang!"
  },
  "zq46a33": {
    "text": "Saya yang menjamin,",
    "emotion": "低聲，快，說完就停",
    "say": "Saya jamin,"
  },
  "zq46a34": {
    "text": "saya datang mendengar.",
    "emotion": "低聲，快，說完就停",
    "say": "saya dengar."
  },
  "zq46a35": {
    "text": "Guru Besar Cheng,",
    "emotion": "起身半禮",
    "say": "Guru Cheng,"
  },
  "zq46a36": {
    "text": "silakan duduk.",
    "emotion": "抬手示意"
  },
  "zq46a37": {
    "text": "Sama persis?",
    "emotion": "在門口，倒抽一口氣"
  },
  "zq46a38": {
    "text": "Matanya cekung kebiruan,",
    "emotion": "瞇眼，低聲",
    "say": "Matanya biru,"
  },
  "zq46a39": {
    "text": "semalaman tidak tidur.",
    "emotion": "看穿",
    "say": "tak tidur semalam."
  },
  "zq46a40": {
    "text": "Menghafal semalaman,",
    "emotion": "低聲，快，說完就停",
    "say": "Begadang,"
  },
  "zq46a41": {
    "text": "kasihan kau.",
    "emotion": "淡淡地"
  },
  "zq46a42": {
    "text": "Hafalkan.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ayo."
  },
  "zq46a43": {
    "text": "Kita lihat sampai mana.",
    "emotion": "嘴角一勾"
  },
  "zq46a44": {
    "text": "Sama persis.",
    "emotion": "冷，快，說完就停",
    "say": "Persis."
  },
  "zq46a45": {
    "text": "Memfitnah penguji,",
    "emotion": "低聲，快，說完就停，不笑，不清嗓子",
    "say": "Fitnah,"
  },
  "zq46a46": {
    "text": "tiga puluh pukulan!",
    "emotion": "陡然拔高，快，說完就停，不清嗓子"
  },
  "zq46a47": {
    "text": "Tertib——",
    "emotion": "衙役齊喊，拉長音"
  },
  "zq46a48": {
    "text": "di persidangan——",
    "emotion": "棍子頓地"
  },
  "zq46a49": {
    "text": "Xu Yan!",
    "emotion": "尖聲"
  }
}
