{
  "zq43a01": {
    "text": "Este papel,",
    "emotion": "收起甜笑，一字一字"
  },
  "zq43a02": {
    "text": "lo hizo él.",
    "emotion": "抬下巴"
  },
  "zq43a03": {
    "text": "¿Papel de Liuxi?",
    "emotion": "拿起一張對著光看"
  },
  "zq43a04": {
    "text": "Su alumno, Xu Yan,",
    "emotion": "作揖"
  },
  "zq43a05": {
    "text": "le pide su aval.",
    "emotion": "誠懇"
  },
  "zq43a06": {
    "text": "Retirar un aval justo antes del examen…",
    "emotion": "放下紙，眼神一利",
    "say": "Retirar un aval tan tarde…"
  },
  "zq43a07": {
    "text": "por algo será.",
    "emotion": "慢"
  },
  "zq43a08": {
    "text": "No se corre la tinta;",
    "emotion": "畫外，一張張攤開"
  },
  "zq43a09": {
    "text": "quien hace este papel no engaña.",
    "emotion": "畫外，篤定",
    "say": "quien lo hace no engaña."
  },
  "zq43a10": {
    "text": "Bien.",
    "emotion": "點頭"
  },
  "zq43a11": {
    "text": "Te pondré una prueba.",
    "emotion": "坐直"
  },
  "zq43a12": {
    "text": "Año de sequía, sin lluvia:",
    "emotion": "考問",
    "say": "Sequía, sin lluvia:"
  },
  "zq43a13": {
    "text": "¿cómo riegas los campos?",
    "emotion": "一句比一句利"
  },
  "zq43a14": {
    "text": "El río está abajo,",
    "emotion": "提筆"
  },
  "zq43a15": {
    "text": "los campos, arriba.",
    "emotion": "邊畫邊說"
  },
  "zq43a16": {
    "text": "Pues que el agua",
    "emotion": "畫外",
    "say": "Que el agua"
  },
  "zq43a17": {
    "text": "suba sola.",
    "emotion": "畫外，笑"
  },
  "zq43a18": {
    "text": "En Liuxi desmontamos las vigas del templo del clan",
    "emotion": "直起身",
    "say": "Liuxi usó las vigas del templo"
  },
  "zq43a19": {
    "text": "para hacer esta noria.",
    "emotion": "平靜",
    "say": "para esta noria."
  },
  "zq43a20": {
    "text": "Lo del agua en Liuxi…",
    "emotion": "眼睛睜大"
  },
  "zq43a21": {
    "text": "¿así que fuiste tú?",
    "emotion": "不敢相信",
    "say": "¿fuiste tú?"
  },
  "zq43a22": {
    "text": "Ese aval",
    "emotion": "起身",
    "say": "El aval"
  },
  "zq43a23": {
    "text": "lo doy yo.",
    "emotion": "一錘定音"
  },
  "zq43a24": {
    "text": "¿R-rector Cheng?",
    "emotion": "嚇得站起來"
  },
  "zq43a25": {
    "text": "Retiras un aval sin preguntar el motivo.",
    "emotion": "沉下臉",
    "say": "Retiras sin preguntar."
  },
  "zq43a26": {
    "text": "¿Así haces tu trabajo?",
    "emotion": "當面訓"
  },
  "zq43a27": {
    "text": "¡Me equivoqué!",
    "emotion": "連連作揖",
    "say": "¡Perdón!"
  },
  "zq43a28": {
    "text": "¡Ahora mismo lo repongo!",
    "emotion": "慌",
    "say": "¡Ya lo repongo!"
  },
  "zq43a29": {
    "text": "¿Uno del condado de Qingshui",
    "emotion": "聞著香囊，斜眼",
    "say": "¿Uno de Qingshui"
  },
  "zq43a30": {
    "text": "merece el aval del rector?",
    "emotion": "倨傲"
  },
  "zq43a31": {
    "text": "Nos vemos en el examen.",
    "emotion": "笑，不接招"
  },
  "zq43a32": {
    "text": "Esa ropa…",
    "emotion": "眼睛一瞇"
  },
  "zq43a33": {
    "text": "es gente de los Wei.",
    "emotion": "壓低聲音",
    "say": "son de los Wei."
  },
  "zq43a34": {
    "text": "Me acordaré de ti.",
    "emotion": "一手按著小金算盤"
  },
  "zq43a35": {
    "text": "Señor,",
    "emotion": "舉手"
  },
  "zq43a36": {
    "text": "aquí hay goteras.",
    "emotion": "皺眉",
    "say": "gotea."
  },
  "zq43a37": {
    "text": "La celda no se cambia,",
    "emotion": "不耐煩",
    "say": "No hay cambio,"
  },
  "zq43a38": {
    "text": "arréglatelas.",
    "emotion": "揮手"
  },
  "zq43a39": {
    "text": "Qué buena gotera.",
    "emotion": "對面號舍，輕笑",
    "say": "Qué bien."
  },
  "zq43a40": {
    "text": "Que me moje a mí,",
    "emotion": "整個人弓起來",
    "say": "Mójame a mí,"
  },
  "zq43a41": {
    "text": "pero no al examen.",
    "emotion": "咬牙，繼續寫"
  },
  "zq43a42": {
    "text": "¡Entreguen los exámenes!",
    "emotion": "畫外，吆喝",
    "say": "¡Entreguen!"
  },
  "zq43a43": {
    "text": "Examen provincial, tres sesiones:",
    "emotion": "平板電子音，叮一聲",
    "say": "Tres sesiones:"
  },
  "zq43a44": {
    "text": "todas completadas.",
    "emotion": "平板電子音"
  },
  "zq43a45": {
    "text": "Condado de Qingshui,",
    "emotion": "清一下嗓子，看著摺紙",
    "say": "Qingshui,"
  },
  "zq43a46": {
    "text": "Xu Yan.",
    "emotion": "低聲"
  },
  "zq43a47": {
    "text": "Qué buen ensayo.",
    "emotion": "冷笑，拖長音",
    "say": "Buen texto."
  },
  "zq43a48": {
    "text": "Qué lástima.",
    "emotion": "拖長音",
    "say": "Lástima."
  },
  "zq43a49": {
    "text": "Desde hoy,",
    "emotion": "對著卷子低聲",
    "say": "Ahora,"
  },
  "zq43a50": {
    "text": "te llamas Wei Xun.",
    "emotion": "一字一字"
  }
}
