{
 "zq43a01": {
  "text": "この紙、",
  "emotion": "收起甜笑，一字一字"
 },
 "zq43a02": {
  "text": "彼が作りました。",
  "emotion": "抬下巴"
 },
 "zq43a03": {
  "text": "柳渓の白紙？",
  "emotion": "拿起一張對著光看"
 },
 "zq43a04": {
  "text": "学生シュー・イェン、",
  "emotion": "作揖",
  "say": "シューです、"
 },
 "zq43a05": {
  "text": "どうか保証を。",
  "emotion": "誠懇",
  "say": "ご保証を。"
 },
 "zq43a06": {
  "text": "試験直前の取り消し、",
  "emotion": "放下紙，眼神一利",
  "say": "直前の取り消し、"
 },
 "zq43a07": {
  "text": "訳があるはずだ。",
  "emotion": "慢"
 },
 "zq43a08": {
  "text": "書いても墨がにじまない、",
  "emotion": "畫外，一張張攤開",
  "say": "墨がにじまない、"
 },
 "zq43a09": {
  "text": "作り手も人を欺きません。",
  "emotion": "畫外，篤定",
  "say": "作り手は欺きません。"
 },
 "zq43a10": {
  "text": "よし。",
  "emotion": "點頭"
 },
 "zq43a11": {
  "text": "わしが一問出そう。",
  "emotion": "坐直"
 },
 "zq43a12": {
  "text": "日照りで雨もない、",
  "emotion": "考問",
  "say": "日照りの年、"
 },
 "zq43a13": {
  "text": "田にどう水を引く？",
  "emotion": "一句比一句利"
 },
 "zq43a14": {
  "text": "川は低く、",
  "emotion": "提筆"
 },
 "zq43a15": {
  "text": "田は高い。",
  "emotion": "邊畫邊說"
 },
 "zq43a16": {
  "text": "ならば水に、",
  "emotion": "畫外"
 },
 "zq43a17": {
  "text": "自分で登らせます。",
  "emotion": "畫外，笑",
  "say": "登らせます。"
 },
 "zq43a18": {
  "text": "柳渓は祠堂の梁を外し、",
  "emotion": "直起身"
 },
 "zq43a19": {
  "text": "この水車を造りました。",
  "emotion": "平靜",
  "say": "この水車を。"
 },
 "zq43a20": {
  "text": "柳渓に水を通したのは、",
  "emotion": "眼睛睜大",
  "say": "柳渓の水は、"
 },
 "zq43a21": {
  "text": "お前だったか。",
  "emotion": "不敢相信"
 },
 "zq43a22": {
  "text": "その保証、",
  "emotion": "起身",
  "say": "保証は、"
 },
 "zq43a23": {
  "text": "わしが引き受けよう。",
  "emotion": "一錘定音",
  "say": "わしが持つ。"
 },
 "zq43a24": {
  "text": "チョ、チョン山長？",
  "emotion": "嚇得站起來"
 },
 "zq43a25": {
  "text": "訳も問わずに取り消すとは、",
  "emotion": "沉下臉",
  "say": "理由も聞かず、"
 },
 "zq43a26": {
  "text": "どういう勤めぶりだ？",
  "emotion": "當面訓"
 },
 "zq43a27": {
  "text": "申し訳ございません！",
  "emotion": "連連作揖",
  "say": "すみません！"
 },
 "zq43a28": {
  "text": "すぐ書き直します！",
  "emotion": "慌",
  "say": "すぐ直します！"
 },
 "zq43a29": {
  "text": "清水県の者が、",
  "emotion": "聞著香囊，斜眼",
  "say": "せいすい県の者が、"
 },
 "zq43a30": {
  "text": "山長に保証だと？",
  "emotion": "倨傲"
 },
 "zq43a31": {
  "text": "試験場で会おう。",
  "emotion": "笑，不接招"
 },
 "zq43a32": {
  "text": "あの服……",
  "emotion": "眼睛一瞇"
 },
 "zq43a33": {
  "text": "魏家の者ね。",
  "emotion": "壓低聲音",
  "say": "ウェイ家の者ね。"
 },
 "zq43a34": {
  "text": "顔、覚えたわよ。",
  "emotion": "一手按著小金算盤",
  "say": "覚えたわ。"
 },
 "zq43a35": {
  "text": "お役人様、",
  "emotion": "舉手",
  "say": "あの、"
 },
 "zq43a36": {
  "text": "ここ、雨漏りします。",
  "emotion": "皺眉",
  "say": "雨漏りです。"
 },
 "zq43a37": {
  "text": "号舎は替えん、",
  "emotion": "不耐煩",
  "say": "替えはせん、"
 },
 "zq43a38": {
  "text": "自分で何とかしろ。",
  "emotion": "揮手",
  "say": "自分でやれ。"
 },
 "zq43a39": {
  "text": "いい雨漏りだ。",
  "emotion": "對面號舍，輕笑",
  "say": "結構。"
 },
 "zq43a40": {
  "text": "俺が濡れるのはいい、",
  "emotion": "整個人弓起來",
  "say": "俺はいい、"
 },
 "zq43a41": {
  "text": "答案は濡らさない。",
  "emotion": "咬牙，繼續寫"
 },
 "zq43a42": {
  "text": "答案回収！",
  "emotion": "畫外，吆喝",
  "say": "回収！"
 },
 "zq43a43": {
  "text": "郷試、全三場、",
  "emotion": "平板電子音，叮一聲",
  "say": "さんじょう、"
 },
 "zq43a44": {
  "text": "すべて完了。",
  "emotion": "平板電子音"
 },
 "zq43a45": {
  "text": "清水県、",
  "emotion": "看著摺紙，低聲念出",
  "say": "セイスイ、"
 },
 "zq43a46": {
  "text": "シュー・イェン。",
  "emotion": "低聲",
  "say": "シューイェン。"
 },
 "zq43a47": {
  "text": "いい文章だ。",
  "emotion": "冷笑，拖長音",
  "say": "名文だ。"
 },
 "zq43a48": {
  "text": "惜しいな。",
  "emotion": "拖長音"
 },
 "zq43a49": {
  "text": "今日から、",
  "emotion": "對著卷子低聲",
  "say": "以後、"
 },
 "zq43a50": {
  "text": "お前の名はウェイ・シュンだ。",
  "emotion": "一字一字",
  "say": "名はウェイ・シュン。"
 }
}