{
  "zq43a01": {
    "text": "Giấy này,",
    "emotion": "收起甜笑，一字一字"
  },
  "zq43a02": {
    "text": "là huynh ấy làm.",
    "emotion": "抬下巴"
  },
  "zq43a03": {
    "text": "Giấy trắng Liễu Khê?",
    "emotion": "拿起一張對著光看"
  },
  "zq43a04": {
    "text": "Học trò Hứa Nghiên,",
    "emotion": "作揖",
    "say": "Hứa Nghiên,"
  },
  "zq43a05": {
    "text": "xin sơn trưởng bảo lãnh.",
    "emotion": "誠懇",
    "say": "xin ngài bảo lãnh."
  },
  "zq43a06": {
    "text": "Sát ngày thi mà rút bảo lãnh,",
    "emotion": "放下紙，眼神一利",
    "say": "Sắp thi mà rút,"
  },
  "zq43a07": {
    "text": "ắt có duyên cớ.",
    "emotion": "慢"
  },
  "zq43a08": {
    "text": "Viết chữ không nhòe mực,",
    "emotion": "畫外，一張張攤開"
  },
  "zq43a09": {
    "text": "người làm giấy không dối người.",
    "emotion": "畫外，篤定",
    "say": "làm giấy không dối người."
  },
  "zq43a10": {
    "text": "Tốt.",
    "emotion": "點頭"
  },
  "zq43a11": {
    "text": "Lão phu ra cho ngươi một đề.",
    "emotion": "坐直",
    "say": "Lão phu ra một đề."
  },
  "zq43a12": {
    "text": "Năm hạn không mưa,",
    "emotion": "考問"
  },
  "zq43a13": {
    "text": "ruộng lấy đâu ra nước?",
    "emotion": "一句比一句利"
  },
  "zq43a14": {
    "text": "Sông ở chỗ thấp,",
    "emotion": "提筆"
  },
  "zq43a15": {
    "text": "ruộng ở chỗ cao.",
    "emotion": "邊畫邊說"
  },
  "zq43a16": {
    "text": "Vậy thì để nước",
    "emotion": "畫外"
  },
  "zq43a17": {
    "text": "tự mình leo lên.",
    "emotion": "畫外，笑"
  },
  "zq43a18": {
    "text": "Liễu Khê dỡ xà từ đường,",
    "emotion": "直起身"
  },
  "zq43a19": {
    "text": "dựng nên guồng nước này.",
    "emotion": "平靜"
  },
  "zq43a20": {
    "text": "Liễu Khê có nước,",
    "emotion": "眼睛睜大"
  },
  "zq43a21": {
    "text": "hóa ra là ngươi.",
    "emotion": "不敢相信"
  },
  "zq43a22": {
    "text": "Bảo lãnh này,",
    "emotion": "起身"
  },
  "zq43a23": {
    "text": "lão phu nhận.",
    "emotion": "一錘定音"
  },
  "zq43a24": {
    "text": "Trình… Trình sơn trưởng?",
    "emotion": "嚇得站起來",
    "say": "Trình sơn trưởng?"
  },
  "zq43a25": {
    "text": "Rút bảo lãnh không hỏi lý do,",
    "emotion": "沉下臉",
    "say": "Rút bảo lãnh không hỏi,"
  },
  "zq43a26": {
    "text": "ngươi làm việc kiểu gì vậy?",
    "emotion": "當面訓"
  },
  "zq43a27": {
    "text": "Tiểu nhân biết lỗi!",
    "emotion": "連連作揖"
  },
  "zq43a28": {
    "text": "Bổ sung ngay đây!",
    "emotion": "慌",
    "say": "Bổ sung ngay!"
  },
  "zq43a29": {
    "text": "Kẻ từ huyện Thanh Thủy,",
    "emotion": "聞著香囊，斜眼"
  },
  "zq43a30": {
    "text": "cũng xứng để sơn trưởng bảo lãnh?",
    "emotion": "倨傲",
    "say": "cũng xứng sơn trưởng bảo lãnh?"
  },
  "zq43a31": {
    "text": "Gặp nhau ở trường thi.",
    "emotion": "笑，不接招"
  },
  "zq43a32": {
    "text": "Bộ đồ đó…",
    "emotion": "眼睛一瞇",
    "say": "Đồ đó…"
  },
  "zq43a33": {
    "text": "là người nhà họ Ngụy.",
    "emotion": "壓低聲音"
  },
  "zq43a34": {
    "text": "Ta nhớ mặt ngươi rồi.",
    "emotion": "一手按著小金算盤",
    "say": "Ta nhớ ngươi rồi."
  },
  "zq43a35": {
    "text": "Đại nhân,",
    "emotion": "舉手"
  },
  "zq43a36": {
    "text": "chỗ này dột mưa.",
    "emotion": "皺眉"
  },
  "zq43a37": {
    "text": "Hiệu xá không đổi,",
    "emotion": "不耐煩",
    "say": "Không đổi,"
  },
  "zq43a38": {
    "text": "tự nghĩ cách đi.",
    "emotion": "揮手"
  },
  "zq43a39": {
    "text": "Dột hay lắm.",
    "emotion": "對面號舍，輕笑",
    "say": "Dột hay."
  },
  "zq43a40": {
    "text": "Ướt ta thì được,",
    "emotion": "整個人弓起來"
  },
  "zq43a41": {
    "text": "ướt bài thi thì không.",
    "emotion": "咬牙，繼續寫"
  },
  "zq43a42": {
    "text": "Thu bài!",
    "emotion": "畫外，吆喝"
  },
  "zq43a43": {
    "text": "Thi Hương ba trường,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq43a44": {
    "text": "hoàn thành toàn bộ.",
    "emotion": "平板電子音"
  },
  "zq43a45": {
    "text": "Huyện Thanh Thủy,",
    "emotion": "清一下嗓子，看著摺紙"
  },
  "zq43a46": {
    "text": "Hứa Nghiên.",
    "emotion": "低聲"
  },
  "zq43a47": {
    "text": "Văn hay lắm.",
    "emotion": "冷笑，拖長音"
  },
  "zq43a48": {
    "text": "Tiếc thay.",
    "emotion": "拖長音"
  },
  "zq43a49": {
    "text": "Từ hôm nay,",
    "emotion": "對著卷子低聲"
  },
  "zq43a50": {
    "text": "ngươi tên là Ngụy Tuân.",
    "emotion": "一字一字",
    "say": "ngươi là Ngụy Tuân."
  }
}
