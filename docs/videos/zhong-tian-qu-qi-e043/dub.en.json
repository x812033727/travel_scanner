{
 "zq43a01": {
  "text": "This paper,",
  "emotion": "收起甜笑，一字一字"
 },
 "zq43a02": {
  "text": "he made it.",
  "emotion": "抬下巴"
 },
 "zq43a03": {
  "text": "Liuxi paper?",
  "emotion": "拿起一張對著光看"
 },
 "zq43a04": {
  "text": "I'm Xu Yan, your student.",
  "emotion": "作揖",
  "say": "Xu Yan here,"
 },
 "zq43a05": {
  "text": "Please stand as my guarantor.",
  "emotion": "誠懇",
  "say": "vouch for me."
 },
 "zq43a06": {
  "text": "A guarantor pulling out before the exam?",
  "emotion": "放下紙，眼神一利",
  "say": "Pulled, now?"
 },
 "zq43a07": {
  "text": "There's a reason.",
  "emotion": "慢"
 },
 "zq43a08": {
  "text": "The ink doesn't bleed,",
  "emotion": "畫外，一張張攤開"
 },
 "zq43a09": {
  "text": "and the man who made it doesn't cheat.",
  "emotion": "畫外，篤定",
  "say": "and its maker doesn't cheat."
 },
 "zq43a10": {
  "text": "Good.",
  "emotion": "點頭"
 },
 "zq43a11": {
  "text": "Then I'll test you.",
  "emotion": "坐直"
 },
 "zq43a12": {
  "text": "A drought year, no rain:",
  "emotion": "考問"
 },
 "zq43a13": {
  "text": "how do the fields get water?",
  "emotion": "一句比一句利",
  "say": "how do fields get water?"
 },
 "zq43a14": {
  "text": "The river's down low,",
  "emotion": "提筆"
 },
 "zq43a15": {
  "text": "the fields are up high.",
  "emotion": "邊畫邊說"
 },
 "zq43a16": {
  "text": "So let the water",
  "emotion": "畫外",
  "say": "Let the water"
 },
 "zq43a17": {
  "text": "climb up on its own.",
  "emotion": "畫外，笑"
 },
 "zq43a18": {
  "text": "Liuxi tore down the shrine's beams",
  "emotion": "直起身",
  "say": "Liuxi took the shrine's beams"
 },
 "zq43a19": {
  "text": "and built this waterwheel.",
  "emotion": "平靜",
  "say": "built this wheel."
 },
 "zq43a20": {
  "text": "Water in Liuxi…",
  "emotion": "眼睛睜大"
 },
 "zq43a21": {
  "text": "so it was you.",
  "emotion": "不敢相信"
 },
 "zq43a22": {
  "text": "This bond,",
  "emotion": "起身",
  "say": "Fine,"
 },
 "zq43a23": {
  "text": "I'll stand for it.",
  "emotion": "一錘定音"
 },
 "zq43a24": {
  "text": "H-Headmaster Cheng?",
  "emotion": "嚇得站起來"
 },
 "zq43a25": {
  "text": "You pull a bond without asking why?",
  "emotion": "沉下臉",
  "say": "Pulling a bond, no questions?"
 },
 "zq43a26": {
  "text": "Is that how you do your job?",
  "emotion": "當面訓",
  "say": "Is that your job?"
 },
 "zq43a27": {
  "text": "My mistake, sir!",
  "emotion": "連連作揖"
 },
 "zq43a28": {
  "text": "I'll fix it now!",
  "emotion": "慌"
 },
 "zq43a29": {
  "text": "Some nobody from Qingshui County,",
  "emotion": "聞著香囊，斜眼",
  "say": "From Qingshui County,"
 },
 "zq43a30": {
  "text": "and the headmaster vouches for him?",
  "emotion": "倨傲",
  "say": "and the headmaster vouches?"
 },
 "zq43a31": {
  "text": "See you in the exam.",
  "emotion": "笑，不接招"
 },
 "zq43a32": {
  "text": "Those clothes…",
  "emotion": "眼睛一瞇"
 },
 "zq43a33": {
  "text": "he's one of the Wei men.",
  "emotion": "壓低聲音",
  "say": "he's a Wei man."
 },
 "zq43a34": {
  "text": "I won't forget you.",
  "emotion": "一手按著小金算盤"
 },
 "zq43a35": {
  "text": "Sir,",
  "emotion": "舉手"
 },
 "zq43a36": {
  "text": "the roof's leaking.",
  "emotion": "皺眉"
 },
 "zq43a37": {
  "text": "No changing cells.",
  "emotion": "不耐煩",
  "say": "Same cell."
 },
 "zq43a38": {
  "text": "Figure it out yourself.",
  "emotion": "揮手",
  "say": "Deal with it."
 },
 "zq43a39": {
  "text": "Leak away.",
  "emotion": "對面號舍，輕笑",
  "say": "Good."
 },
 "zq43a40": {
  "text": "Soak me, fine,",
  "emotion": "整個人弓起來",
  "say": "Soak me"
 },
 "zq43a41": {
  "text": "but not the paper.",
  "emotion": "咬牙，繼續寫"
 },
 "zq43a42": {
  "text": "Papers in!",
  "emotion": "畫外，吆喝",
  "say": "Time!"
 },
 "zq43a43": {
  "text": "All three sessions of the provincial exam:",
  "emotion": "平板電子音，叮一聲",
  "say": "Provincial exam:"
 },
 "zq43a44": {
  "text": "complete.",
  "emotion": "平板電子音",
  "say": "all complete."
 },
 "zq43a45": {
  "text": "Qingshui County,",
  "emotion": "清一下嗓子，看著摺紙"
 },
 "zq43a46": {
  "text": "Xu Yan.",
  "emotion": "低聲"
 },
 "zq43a47": {
  "text": "Fine writing.",
  "emotion": "冷笑，拖長音"
 },
 "zq43a48": {
  "text": "What a shame.",
  "emotion": "拖長音"
 },
 "zq43a49": {
  "text": "From today on,",
  "emotion": "對著卷子低聲",
  "say": "Henceforth,"
 },
 "zq43a50": {
  "text": "your name is Wei Xun.",
  "emotion": "一字一字",
  "say": "you're Wei Xun."
 }
}