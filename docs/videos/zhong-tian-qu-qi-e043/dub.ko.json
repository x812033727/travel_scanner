{
  "zq43a01": {
    "text": "이 종이,",
    "emotion": "收起甜笑，一字一字"
  },
  "zq43a02": {
    "text": "이 사람이 만들었어요.",
    "emotion": "抬下巴",
    "say": "이 사람 거예요."
  },
  "zq43a03": {
    "text": "류시 백지?",
    "emotion": "拿起一張對著光看"
  },
  "zq43a04": {
    "text": "학생 쉬옌,",
    "emotion": "作揖",
    "say": "쉬옌,"
  },
  "zq43a05": {
    "text": "산장님께 보증을 청합니다.",
    "emotion": "誠懇",
    "say": "보증을 청합니다."
  },
  "zq43a06": {
    "text": "시험 직전에 보결 철회라,",
    "emotion": "放下紙，眼神一利",
    "say": "직전 철회라,"
  },
  "zq43a07": {
    "text": "필시 곡절이 있겠지.",
    "emotion": "慢",
    "say": "곡절이 있겠지."
  },
  "zq43a08": {
    "text": "글씨가 번지지 않아요,",
    "emotion": "畫外，一張張攤開",
    "say": "번지지 않아요,"
  },
  "zq43a09": {
    "text": "종이 만드는 사람은 남을 속이지 않아요.",
    "emotion": "畫外，篤定",
    "say": "만든 사람도 안 속여요."
  },
  "zq43a10": {
    "text": "좋다.",
    "emotion": "點頭",
    "say": "좋아"
  },
  "zq43a11": {
    "text": "한 문제 내 보마.",
    "emotion": "坐直"
  },
  "zq43a12": {
    "text": "가물어 비가 없으면,",
    "emotion": "考問",
    "say": "가뭄에,"
  },
  "zq43a13": {
    "text": "밭에 물을 어찌 대겠느냐?",
    "emotion": "一句比一句利",
    "say": "물은 어찌 대느냐?"
  },
  "zq43a14": {
    "text": "강은 낮은 곳에,",
    "emotion": "提筆",
    "say": "강은 낮고,"
  },
  "zq43a15": {
    "text": "밭은 높은 곳에.",
    "emotion": "邊畫邊說"
  },
  "zq43a16": {
    "text": "그럼 물이,",
    "emotion": "畫外"
  },
  "zq43a17": {
    "text": "스스로 올라오게 하면 됩니다.",
    "emotion": "畫外，笑",
    "say": "알아서 올라오게."
  },
  "zq43a18": {
    "text": "류시는 사당 대들보를 뜯어,",
    "emotion": "直起身",
    "say": "사당 대들보로,"
  },
  "zq43a19": {
    "text": "이 수차를 만들었습니다.",
    "emotion": "平靜",
    "say": "만들었죠."
  },
  "zq43a20": {
    "text": "류시에 물이 올랐다더니,",
    "emotion": "眼睛睜大",
    "say": "물이 났다더니,"
  },
  "zq43a21": {
    "text": "자네였구먼.",
    "emotion": "不敢相信"
  },
  "zq43a22": {
    "text": "이 보증,",
    "emotion": "起身",
    "say": "보증,"
  },
  "zq43a23": {
    "text": "노부가 서겠네.",
    "emotion": "一錘定音",
    "say": "내가 서지."
  },
  "zq43a24": {
    "text": "처, 청 산장님?",
    "emotion": "嚇得站起來"
  },
  "zq43a25": {
    "text": "까닭도 묻지 않고 철회해?",
    "emotion": "沉下臉",
    "say": "안 묻고 철회해?"
  },
  "zq43a26": {
    "text": "일을 이따위로 하느냐?",
    "emotion": "當面訓"
  },
  "zq43a27": {
    "text": "소인이 잘못했습니다!",
    "emotion": "連連作揖",
    "say": "잘못했습니다!"
  },
  "zq43a28": {
    "text": "당장 다시 올리겠습니다!",
    "emotion": "慌",
    "say": "고치겠습니다!"
  },
  "zq43a29": {
    "text": "청수현 촌놈이,",
    "emotion": "聞著香囊，斜眼",
    "say": "촌놈이,"
  },
  "zq43a30": {
    "text": "산장 보증을 받아?",
    "emotion": "倨傲"
  },
  "zq43a31": {
    "text": "시험장에서 보자.",
    "emotion": "笑，不接招"
  },
  "zq43a32": {
    "text": "저 옷……",
    "emotion": "眼睛一瞇"
  },
  "zq43a33": {
    "text": "웨이 가 사람이야.",
    "emotion": "壓低聲音",
    "say": "웨이 가 사람."
  },
  "zq43a34": {
    "text": "너, 기억해 둘게.",
    "emotion": "一手按著小金算盤",
    "say": "기억해 둘게."
  },
  "zq43a35": {
    "text": "나리,",
    "emotion": "舉手"
  },
  "zq43a36": {
    "text": "여기 비가 샙니다.",
    "emotion": "皺眉",
    "say": "비가 샙니다."
  },
  "zq43a37": {
    "text": "호사는 못 바꿔 준다,",
    "emotion": "不耐煩",
    "say": "못 바꿔 준다,"
  },
  "zq43a38": {
    "text": "알아서 해.",
    "emotion": "揮手"
  },
  "zq43a39": {
    "text": "잘 새는군.",
    "emotion": "對面號舍，輕笑",
    "say": "잘 새."
  },
  "zq43a40": {
    "text": "날 적시는 건 괜찮아도,",
    "emotion": "整個人弓起來",
    "say": "나는 젖어도,"
  },
  "zq43a41": {
    "text": "답안지는 안 돼.",
    "emotion": "咬牙，繼續寫"
  },
  "zq43a42": {
    "text": "답안 걷어라!",
    "emotion": "畫外，吆喝",
    "say": "걷어!"
  },
  "zq43a43": {
    "text": "향시 세 차례,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq43a44": {
    "text": "모두 완료.",
    "emotion": "平板電子音"
  },
  "zq43a45": {
    "text": "청수현,",
    "emotion": "清一下嗓子，看著摺紙"
  },
  "zq43a46": {
    "text": "쉬옌.",
    "emotion": "低聲"
  },
  "zq43a47": {
    "text": "좋은 글이로군.",
    "emotion": "冷笑，拖長音",
    "say": "명문."
  },
  "zq43a48": {
    "text": "아깝구나.",
    "emotion": "拖長音"
  },
  "zq43a49": {
    "text": "오늘부터,",
    "emotion": "對著卷子低聲"
  },
  "zq43a50": {
    "text": "네 이름은 웨이쉰이다.",
    "emotion": "一字一字",
    "say": "넌 웨이쉰이다."
  }
}
