{
  "zq43a01": {
    "text": "Este papel,",
    "emotion": "收起甜笑，一字一字"
  },
  "zq43a02": {
    "text": "foi ele quem fez.",
    "emotion": "抬下巴"
  },
  "zq43a03": {
    "text": "Papel branco de Liuxi?",
    "emotion": "拿起一張對著光看"
  },
  "zq43a04": {
    "text": "Sou o estudante Xu Yan,",
    "emotion": "作揖",
    "say": "Sou Xu Yan,"
  },
  "zq43a05": {
    "text": "peço que o senhor me avalize.",
    "emotion": "誠懇",
    "say": "peço seu aval."
  },
  "zq43a06": {
    "text": "Retirar o aval às vésperas do exame",
    "emotion": "放下紙，眼神一利",
    "say": "Aval retirado agora"
  },
  "zq43a07": {
    "text": "não é à toa.",
    "emotion": "慢"
  },
  "zq43a08": {
    "text": "A tinta não borra na escrita;",
    "emotion": "畫外，一張張攤開",
    "say": "A tinta não borra;"
  },
  "zq43a09": {
    "text": "quem faz o papel não engana ninguém.",
    "emotion": "畫外，篤定",
    "say": "quem o faz não engana."
  },
  "zq43a10": {
    "text": "Pois bem.",
    "emotion": "點頭"
  },
  "zq43a11": {
    "text": "Vou te dar uma questão.",
    "emotion": "坐直",
    "say": "Vou te testar."
  },
  "zq43a12": {
    "text": "Num ano de seca, sem chuva,",
    "emotion": "考問",
    "say": "Seca, sem chuva,"
  },
  "zq43a13": {
    "text": "como a água chega ao campo?",
    "emotion": "一句比一句利",
    "say": "como regar o campo?"
  },
  "zq43a14": {
    "text": "O rio fica embaixo,",
    "emotion": "提筆",
    "say": "O rio, embaixo,"
  },
  "zq43a15": {
    "text": "o campo fica em cima.",
    "emotion": "邊畫邊說",
    "say": "campo, em cima."
  },
  "zq43a16": {
    "text": "Então deixa a água",
    "emotion": "畫外",
    "say": "Então a água"
  },
  "zq43a17": {
    "text": "subir sozinha.",
    "emotion": "畫外，笑"
  },
  "zq43a18": {
    "text": "Liuxi desmontou as vigas do templo",
    "emotion": "直起身",
    "say": "Liuxi usou as vigas do templo"
  },
  "zq43a19": {
    "text": "e construiu esta roda d’água.",
    "emotion": "平靜",
    "say": "e fez esta roda."
  },
  "zq43a20": {
    "text": "A água chegou a Liuxi…",
    "emotion": "眼睛睜大",
    "say": "Liuxi achou água…"
  },
  "zq43a21": {
    "text": "então foi você.",
    "emotion": "不敢相信",
    "say": "foi você."
  },
  "zq43a22": {
    "text": "Este aval,",
    "emotion": "起身"
  },
  "zq43a23": {
    "text": "eu assino.",
    "emotion": "一錘定音"
  },
  "zq43a24": {
    "text": "M-Mestre Cheng?",
    "emotion": "嚇得站起來"
  },
  "zq43a25": {
    "text": "Retira um aval sem perguntar o motivo?",
    "emotion": "沉下臉",
    "say": "Sem perguntar?"
  },
  "zq43a26": {
    "text": "É assim que você trabalha?",
    "emotion": "當面訓"
  },
  "zq43a27": {
    "text": "Errei, senhor!",
    "emotion": "連連作揖",
    "say": "Errei!"
  },
  "zq43a28": {
    "text": "Já corrijo!",
    "emotion": "慌",
    "say": "Já vou!"
  },
  "zq43a29": {
    "text": "Um sujeito de Qingshui",
    "emotion": "聞著香囊，斜眼",
    "say": "Um de Qingshui"
  },
  "zq43a30": {
    "text": "com o aval do diretor?",
    "emotion": "倨傲"
  },
  "zq43a31": {
    "text": "Nos vemos no exame.",
    "emotion": "笑，不接招"
  },
  "zq43a32": {
    "text": "Aquela roupa…",
    "emotion": "眼睛一瞇"
  },
  "zq43a33": {
    "text": "é gente dos Wei.",
    "emotion": "壓低聲音"
  },
  "zq43a34": {
    "text": "Não vou esquecer você.",
    "emotion": "一手按著小金算盤",
    "say": "Não esqueço."
  },
  "zq43a35": {
    "text": "Excelência,",
    "emotion": "舉手",
    "say": "Senhor,"
  },
  "zq43a36": {
    "text": "aqui tem goteira.",
    "emotion": "皺眉",
    "say": "tem goteira."
  },
  "zq43a37": {
    "text": "Não se troca de cela,",
    "emotion": "不耐煩",
    "say": "Sem troca,"
  },
  "zq43a38": {
    "text": "dê seu jeito.",
    "emotion": "揮手",
    "say": "Se vira."
  },
  "zq43a39": {
    "text": "Que goteira boa.",
    "emotion": "對面號舍，輕笑",
    "say": "Boa."
  },
  "zq43a40": {
    "text": "Que chova em mim,",
    "emotion": "整個人弓起來",
    "say": "Em mim, pode,"
  },
  "zq43a41": {
    "text": "na prova, não.",
    "emotion": "咬牙，繼續寫"
  },
  "zq43a42": {
    "text": "Entreguem as provas!",
    "emotion": "畫外，吆喝",
    "say": "Tempo!"
  },
  "zq43a43": {
    "text": "Exame provincial, três etapas:",
    "emotion": "平板電子音，叮一聲",
    "say": "Exame provincial:"
  },
  "zq43a44": {
    "text": "todas concluídas.",
    "emotion": "平板電子音",
    "say": "concluído."
  },
  "zq43a45": {
    "text": "Condado de Qingshui,",
    "emotion": "清一下嗓子，看著摺紙",
    "say": "Qingshui,"
  },
  "zq43a46": {
    "text": "Xu Yan.",
    "emotion": "低聲"
  },
  "zq43a47": {
    "text": "Belo texto.",
    "emotion": "冷笑，拖長音",
    "say": "Ótimo."
  },
  "zq43a48": {
    "text": "Que pena.",
    "emotion": "拖長音"
  },
  "zq43a49": {
    "text": "De hoje em diante,",
    "emotion": "對著卷子低聲",
    "say": "Agora,"
  },
  "zq43a50": {
    "text": "você se chama Wei Xun.",
    "emotion": "一字一字",
    "say": "você é Wei Xun."
  }
}
