{
  "zq43a01": {
    "text": "Kertas ini,",
    "emotion": "收起甜笑，一字一字"
  },
  "zq43a02": {
    "text": "dia yang buat.",
    "emotion": "抬下巴"
  },
  "zq43a03": {
    "text": "Kertas putih Liuxi?",
    "emotion": "拿起一張對著光看",
    "say": "Kertas Liuxi?"
  },
  "zq43a04": {
    "text": "Murid Xu Yan,",
    "emotion": "作揖"
  },
  "zq43a05": {
    "text": "mohon Guru Besar menjamin saya.",
    "emotion": "誠懇",
    "say": "mohon jaminan."
  },
  "zq43a06": {
    "text": "Jaminan dicabut menjelang ujian,",
    "emotion": "放下紙，眼神一利",
    "say": "Dicabut jelang ujian,"
  },
  "zq43a07": {
    "text": "pasti ada sebabnya.",
    "emotion": "慢",
    "say": "ada sebab."
  },
  "zq43a08": {
    "text": "Tintanya nggak merembes,",
    "emotion": "畫外，一張張攤開",
    "say": "Tinta tak merembes,"
  },
  "zq43a09": {
    "text": "pembuatnya tak menipu orang.",
    "emotion": "畫外，篤定",
    "say": "pembuat tak menipu."
  },
  "zq43a10": {
    "text": "Baik.",
    "emotion": "點頭",
    "say": "Ya."
  },
  "zq43a11": {
    "text": "Saya uji kau satu soal.",
    "emotion": "坐直"
  },
  "zq43a12": {
    "text": "Kemarau tanpa hujan,",
    "emotion": "考問",
    "say": "Tak hujan,"
  },
  "zq43a13": {
    "text": "dari mana sawah dapat air?",
    "emotion": "一句比一句利",
    "say": "sawah dapat air?"
  },
  "zq43a14": {
    "text": "Sungai di bawah,",
    "emotion": "提筆"
  },
  "zq43a15": {
    "text": "sawah di atas.",
    "emotion": "邊畫邊說",
    "say": "sawah atas."
  },
  "zq43a16": {
    "text": "Maka biarkan airnya",
    "emotion": "畫外",
    "say": "Biar airnya"
  },
  "zq43a17": {
    "text": "naik sendiri.",
    "emotion": "畫外，笑",
    "say": "naik!"
  },
  "zq43a18": {
    "text": "Liuxi membongkar balok rumah abu leluhur,",
    "emotion": "直起身",
    "say": "Liuxi bongkar balok leluhur,"
  },
  "zq43a19": {
    "text": "untuk membuat kincir air ini.",
    "emotion": "平靜",
    "say": "jadi kincir ini."
  },
  "zq43a20": {
    "text": "Liuxi dapat air,",
    "emotion": "眼睛睜大",
    "say": "Liuxi,"
  },
  "zq43a21": {
    "text": "ternyata karena kau.",
    "emotion": "不敢相信",
    "say": "rupanya kau."
  },
  "zq43a22": {
    "text": "Jaminan ini,",
    "emotion": "起身",
    "say": "Ini,"
  },
  "zq43a23": {
    "text": "saya yang tanggung.",
    "emotion": "一錘定音",
    "say": "saya tanggung."
  },
  "zq43a24": {
    "text": "Gu-Guru Besar Cheng?",
    "emotion": "嚇得站起來",
    "say": "Gu-Guru Cheng?"
  },
  "zq43a25": {
    "text": "Cabut jaminan tanpa tanya alasan,",
    "emotion": "沉下臉",
    "say": "Asal cabut,"
  },
  "zq43a26": {
    "text": "begini caramu bekerja?",
    "emotion": "當面訓"
  },
  "zq43a27": {
    "text": "Hamba salah!",
    "emotion": "連連作揖"
  },
  "zq43a28": {
    "text": "Segera hamba isi lagi!",
    "emotion": "慌",
    "say": "Hamba isi!"
  },
  "zq43a29": {
    "text": "Orang Kabupaten Qingshui,",
    "emotion": "聞著香囊，斜眼",
    "say": "Orang Qingshui,"
  },
  "zq43a30": {
    "text": "pantas dijamin Guru Besar?",
    "emotion": "倨傲",
    "say": "pantas dijamin Guru?"
  },
  "zq43a31": {
    "text": "Sampai jumpa di ujian.",
    "emotion": "笑，不接招"
  },
  "zq43a32": {
    "text": "Pakaian itu…",
    "emotion": "眼睛一瞇",
    "say": "Baju itu…"
  },
  "zq43a33": {
    "text": "orang keluarga Wei.",
    "emotion": "壓低聲音",
    "say": "orang Wei."
  },
  "zq43a34": {
    "text": "Aku ingat kau.",
    "emotion": "一手按著小金算盤"
  },
  "zq43a35": {
    "text": "Tuan,",
    "emotion": "舉手"
  },
  "zq43a36": {
    "text": "di sini bocor.",
    "emotion": "皺眉",
    "say": "Bocor."
  },
  "zq43a37": {
    "text": "Bilik tak bisa ditukar,",
    "emotion": "不耐煩",
    "say": "Tak bisa tukar,"
  },
  "zq43a38": {
    "text": "urus sendiri.",
    "emotion": "揮手"
  },
  "zq43a39": {
    "text": "Bocor, bagus.",
    "emotion": "對面號舍，輕笑",
    "say": "Pas."
  },
  "zq43a40": {
    "text": "Aku boleh basah,",
    "emotion": "整個人弓起來",
    "say": "Aku basah,"
  },
  "zq43a41": {
    "text": "lembar ujian jangan.",
    "emotion": "咬牙，繼續寫"
  },
  "zq43a42": {
    "text": "Kumpulkan!",
    "emotion": "畫外，吆喝",
    "say": "Stop!"
  },
  "zq43a43": {
    "text": "Tiga tahap ujian provinsi,",
    "emotion": "平板電子音，叮一聲",
    "say": "Tiga ujian provinsi,"
  },
  "zq43a44": {
    "text": "semuanya selesai.",
    "emotion": "平板電子音"
  },
  "zq43a45": {
    "text": "Kabupaten Qingshui,",
    "emotion": "清一下嗓子，看著摺紙",
    "say": "Qingshui,"
  },
  "zq43a46": {
    "text": "Xu Yan.",
    "emotion": "低聲"
  },
  "zq43a47": {
    "text": "Karangan bagus.",
    "emotion": "冷笑，拖長音",
    "say": "Bagus."
  },
  "zq43a48": {
    "text": "Sayang sekali.",
    "emotion": "拖長音",
    "say": "Sayang."
  },
  "zq43a49": {
    "text": "Mulai hari ini,",
    "emotion": "對著卷子低聲"
  },
  "zq43a50": {
    "text": "namamu Wei Xun.",
    "emotion": "一字一字",
    "say": "kau Wei Xun."
  }
}
