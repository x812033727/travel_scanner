{
  "zq37a01": {
    "text": "On my command.",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "Four hundred!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "We're only sixty.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "Not the gate,",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "the canal head.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "Four hundred or not,",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "they take that canal.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "Village defense mission:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "no woman or child lost.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "Lime sacks,",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "one every three paces.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "Pits this shallow?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "No need.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "A stumble's enough.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "Front row, down!",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "Nobody moves till I call.",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "Xiaotang, the women and kids are yours.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "And where will you be?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "Get down.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "People die up here.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "I'm staying here,",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "with you.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "Charge!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "The grain's all ours!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "Wait.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "Throw!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "What is this!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "Every torch is out!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "Where's Brother?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "One comes in,",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "one goes down.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "Get out!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "Not one got in!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "Master Diao Qi's blade,",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "Out of my way!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "Blade,",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "down.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "Tie him up!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "Into the granary!",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "You didn't hide.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "Said I'd stay with you.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "Qin Shuang: affection forty-eight.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "Mission complete.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "Brother!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "Xiaohe?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "Xiaohe!",
    "emotion": "慌了"
  }
}
