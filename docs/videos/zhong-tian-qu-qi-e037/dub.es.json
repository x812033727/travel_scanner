{
  "zq37a01": {
    "text": "¡A mis órdenes!",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "¡Cuatrocientos!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "Somos sesenta.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "No la entrada,",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "el canal.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "Cuatrocientos,",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "pasan por ese canal.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "Misión de defensa:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "ni una mujer ni un niño menos.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "Sacos de cal,",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "uno cada tres pasos.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "¿Tan poco hondos?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "No hace falta.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "Basta un tropiezo.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "¡Fila uno, abajo!",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "Quietos hasta mi orden.",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "Xiaotang, cuida a mujeres y niños.",
    "say": "Cuida a mujeres y niños.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "¿Y tú dónde estarás?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "Tú, baja.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "Aquí muere gente.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "Me quedo aquí,",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "contigo.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "¡Al ataque!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "¡El grano es nuestro!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "Esperen.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "¡Lancen!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "¡¿Qué es esto?!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "¡Ni una antorcha!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "¿Y mi hermano?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "Si entra uno,",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "cae uno.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "¡Fuera!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "¡No entró ni uno!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "El sable de Diao Qi,",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "¡Apártense!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "El sable,",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "suéltalo.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "¡Amárrenlo!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "¡Al granero!",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "No huiste.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "Dije que contigo.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "Qin Shuang: afecto, cuarenta y ocho.",
    "say": "Afecto: cuarenta y ocho.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "Misión cumplida.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "¡Hermano!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "¿Xiaohe?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "¡Xiaohe!",
    "emotion": "慌了"
  }
}
