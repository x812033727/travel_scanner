{
  "zq37a01": {
    "text": "号令を聞け。",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "四百人！",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "こっちは六十だぞ。",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "村口じゃない、",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "水路の口を守る。",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "四百人でも、",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "あの水路を通るしかない。",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "村防衛任務：",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "女子供、一人も欠かすな。",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "石灰袋、",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "三歩ごとに一つ。",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "こんな浅い穴で？",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "深くなくていい。",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "つまずけば十分。",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "前列、しゃがめ。",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "合図まで動くな。",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "シャオタン、女子供を頼む。",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "あなたはどこに？",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "下がれ。",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "ここは死人が出る。",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "俺はここにいる、",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "一緒に。",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "突っ込め！",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "米は全部いただきだ！",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "待て。",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "投げろ！",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "なんだこれ！",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "松明が全部消えた！",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "お兄ちゃんは？",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "一人入れば、",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "一人倒れる。",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "出てけ！",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "一人も入ってない！",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "ディアオ・チーの刀だ、",
    "say": "俺様の刀だ、",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "どけ！",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "刀を、",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "置け。",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "縛れ！",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "穀倉へ！",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "逃げなかったな。",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "一緒って言ったろ。",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "チン・シュアン、好感度四十八。",
    "say": "好感度、四十八。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "任務完了。",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "お兄ちゃん！",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "シャオホー？",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "シャオホー！",
    "emotion": "慌了"
  }
}
