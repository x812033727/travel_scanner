{
  "zq37a01": {
    "text": "Às minhas ordens.",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "Quatrocentos!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "Somos só sessenta.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "Não a entrada,",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "o canal.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "Quatrocentos,",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "passam pelo canal.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "Missão de defesa:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "nenhuma mulher ou criança perdida.",
    "say": "mulheres e crianças, todas.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "Sacos de cal,",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "um a cada três passos.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "Buraco tão raso?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "Não precisa.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "Basta tropeçar.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "Fila da frente, abaixa!",
    "say": "Frente, abaixa!",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "Parados até eu mandar.",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "Xiaotang, cuide das mulheres e crianças.",
    "say": "Cuide das famílias.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "E você, fica onde?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "Desce.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "Aqui morre gente.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "Eu fico aqui,",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "com você.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "Avancem!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "O grão é todo nosso!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "Espera.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "Joguem!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "O que é isso!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "As tochas apagaram!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "Cadê o mano?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "Entra um,",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "cai um.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "Fora!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "Nenhum entrou!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "A lâmina de Diao Qi,",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "Saiam da frente!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "Lâmina,",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "no chão.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "Amarra!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "Pro celeiro!",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "Você não fugiu.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "Falei que ficava.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "Qin Shuang: afeição, quarenta e oito.",
    "say": "Afeição: quarenta e oito.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "Missão cumprida.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "Mano!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "Xiaohe?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "Xiaohe!",
    "emotion": "慌了"
  }
}
