{
  "zq37a01": {
    "text": "내 명령을 들어라.",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "사백 명!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "우린 겨우 예순인데.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "마을 어귀 말고,",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "수로를 지킨다.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "사백 명이라도,",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "저 물길로 와야 해.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "마을 수호 미션:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "여자와 아이, 전원 보호.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "석회 자루,",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "세 걸음마다 하나.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "이렇게 얕아?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "깊을 필요 없어.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "걸려 넘어지면 돼.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "앞줄, 앉아!",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "신호 전엔 꼼짝 마.",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "샤오탕, 여자와 아이 부탁해.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "그럼 넌 어디 서?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "넌 내려가.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "여긴 사람이 죽어.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "난 여기 있을게,",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "너랑.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "돌격!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "곡식은 다 우리 거다!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "기다려.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "던져!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "이게 뭐야!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "횃불이 다 꺼졌다!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "오빠는?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "하나 들어오면,",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "하나 쓰러져.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "꺼져!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "하나도 못 들어왔어!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "댜오치 나리 칼이다,",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "비켜라!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "칼,",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "내려놔.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "묶어!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "곳간에 가둬!",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "안 숨었네.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "곁에 있겠댔잖아.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "친솽 호감, 48.",
    "say": "친솽 호감, 사십팔.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "미션 완료.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "오빠!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "샤오허?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "샤오허!",
    "emotion": "慌了"
  }
}
