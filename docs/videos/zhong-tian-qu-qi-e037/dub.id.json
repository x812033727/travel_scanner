{
  "zq37a01": {
    "text": "Dengar aba-abaku.",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "Empat ratus!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "Kita cuma enam puluh.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "Bukan gerbang desa,",
    "say": "Bukan gerbang,",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "jaga saluran.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "Empat ratus pun,",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "tetap lewat saluran itu.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "Misi jaga desa:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "wanita, anak, semua selamat.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "Karung kapur,",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "tiap tiga langkah.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "Dangkal begini?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "Tak perlu dalam.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "Asal tersandung.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "Depan, jongkok!",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "Tunggu aba-abaku, diam!",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "Xiaotang, jaga wanita dan anak.",
    "say": "Jaga wanita dan anak.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "Terus kamu di mana?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "Kamu turun.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "Di sini bisa mati.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "Aku di sini,",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "temani kamu.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "Serbu!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "Berasnya milik kita!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "Tunggu.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "Lempar!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "Apa ini!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "Obornya padam semua!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "Kakak mana?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "Satu masuk,",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "satu tumbang.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "Keluar!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "Tak satu pun masuk!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "Golok Tuan Diao Qi,",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "Minggir!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "Golok,",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "letakkan.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "Ikat!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "Ke lumbung!",
    "emotion": "得意"
  },
  "zq37a40": {
    "text": "Kamu tak lari.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "Aku janji temani.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "Qin Shuang, poin suka empat puluh delapan.",
    "say": "Poin suka: empat puluh delapan.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "Misi selesai.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "Kakak!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "Xiaohe?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "Xiaohe!",
    "emotion": "慌了"
  }
}
