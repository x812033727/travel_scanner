{
  "zq37a01": {
    "text": "Nghe lệnh ta.",
    "emotion": "扯下披肩、束起馬尾，取下紅纓槍"
  },
  "zq37a02": {
    "text": "Bốn trăm người!",
    "emotion": "大嗓門，嚇到了"
  },
  "zq37a03": {
    "text": "Bọn ta mới sáu mươi.",
    "emotion": "鋤頭在手裡發抖"
  },
  "zq37a04": {
    "text": "Không giữ cổng làng,",
    "say": "Không giữ cổng làng",
    "emotion": "冷靜，看著火把"
  },
  "zq37a05": {
    "text": "giữ đầu kênh.",
    "emotion": "一個字一個字"
  },
  "zq37a06": {
    "text": "Bốn trăm người,",
    "say": "Bốn trăm người",
    "emotion": "颯爽，不屑地笑"
  },
  "zq37a07": {
    "text": "cũng phải qua con kênh đó.",
    "emotion": "長槍指向渠頭"
  },
  "zq37a08": {
    "text": "Nhiệm vụ giữ làng:",
    "say": "Nhiệm vụ giữ làng",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a09": {
    "text": "phụ nữ trẻ em không thiếu một ai.",
    "emotion": "平板電子音"
  },
  "zq37a10": {
    "text": "Bao vôi,",
    "say": "Bao vôi",
    "emotion": "畫外，低聲"
  },
  "zq37a11": {
    "text": "ba bước một bao.",
    "emotion": "畫外，交代"
  },
  "zq37a12": {
    "text": "Hố đào nông thế à?",
    "emotion": "不解，喘"
  },
  "zq37a13": {
    "text": "Không cần sâu.",
    "emotion": "笑了一下"
  },
  "zq37a14": {
    "text": "Vấp một cái là đủ.",
    "emotion": "把草鋪在坑口"
  },
  "zq37a15": {
    "text": "Hàng đầu, ngồi xuống.",
    "say": "Hàng đầu ngồi xuống.",
    "emotion": "號令，嗓門亮"
  },
  "zq37a16": {
    "text": "Ta chưa hô, không được động.",
    "say": "Ta chưa hô không được động.",
    "emotion": "一字一頓"
  },
  "zq37a17": {
    "text": "Tiểu Đường, phụ nữ trẻ em giao cho nàng.",
    "say": "Tiểu Đường, phụ nữ và trẻ em giao nàng.",
    "emotion": "按著她的肩膀"
  },
  "zq37a18": {
    "text": "Vậy huynh đứng đâu?",
    "emotion": "抓著他的袖子"
  },
  "zq37a19": {
    "text": "Ngươi xuống đi.",
    "emotion": "不看他，冷"
  },
  "zq37a20": {
    "text": "Ở đây sẽ có người chết.",
    "emotion": "聲音壓低"
  },
  "zq37a21": {
    "text": "Ta đứng đây,",
    "say": "Ta đứng đây",
    "emotion": "很穩"
  },
  "zq37a22": {
    "text": "cùng nàng.",
    "emotion": "小小的笑"
  },
  "zq37a23": {
    "text": "Xông lên!",
    "emotion": "粗啞，吼"
  },
  "zq37a24": {
    "text": "Lương thực là của ta hết!",
    "emotion": "兇狠"
  },
  "zq37a25": {
    "text": "Đợi.",
    "emotion": "極輕，不動"
  },
  "zq37a26": {
    "text": "Ném!",
    "emotion": "一聲令下"
  },
  "zq37a27": {
    "text": "Cái gì thế!",
    "emotion": "咳，眼睛睜不開"
  },
  "zq37a28": {
    "text": "Đuốc tắt sạch rồi!",
    "emotion": "憨笑，大嗓門"
  },
  "zq37a29": {
    "text": "Ca ca đâu?",
    "emotion": "奶聲，快哭了"
  },
  "zq37a30": {
    "text": "Vào một tên,",
    "say": "Vào một tên",
    "emotion": "冷得像井水"
  },
  "zq37a31": {
    "text": "ngã một tên.",
    "emotion": "短匕翻了一下"
  },
  "zq37a32": {
    "text": "Cút ra!",
    "emotion": "尖叫，整桶潑出去"
  },
  "zq37a33": {
    "text": "Không tên nào vào được!",
    "emotion": "又驚又喜"
  },
  "zq37a34": {
    "text": "Đao của Điêu Thất gia,",
    "say": "Đao của Điêu Thất gia",
    "emotion": "粗啞，報名"
  },
  "zq37a35": {
    "text": "Tránh ra cho ta!",
    "emotion": "吼"
  },
  "zq37a36": {
    "text": "Đao,",
    "say": "Đao",
    "emotion": "平靜"
  },
  "zq37a37": {
    "text": "bỏ xuống.",
    "emotion": "兩個字"
  },
  "zq37a38": {
    "text": "Trói lại!",
    "emotion": "大嗓門"
  },
  "zq37a39": {
    "text": "Nhốt vào kho thóc!",
    "emotion": "大聲，短促",
    "say": "Nhốt kho thóc!"
  },
  "zq37a40": {
    "text": "Ngươi không trốn.",
    "emotion": "看著他，聲音變了"
  },
  "zq37a41": {
    "text": "Đã nói cùng nàng mà.",
    "emotion": "咧嘴笑"
  },
  "zq37a42": {
    "text": "Tần Sương, hảo cảm, bốn mươi tám.",
    "say": "Tần Sương hảo cảm bốn mươi tám.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq37a43": {
    "text": "Nhiệm vụ hoàn thành.",
    "emotion": "平板電子音"
  },
  "zq37a44": {
    "text": "Ca ca!",
    "emotion": "奶聲，歡呼"
  },
  "zq37a45": {
    "text": "Tiểu Hòa?",
    "emotion": "笑容沒了"
  },
  "zq37a46": {
    "text": "Tiểu Hòa!",
    "emotion": "慌了"
  }
}
