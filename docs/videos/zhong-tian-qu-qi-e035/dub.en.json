{
  "zq35a01": {
    "text": "Ducks.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "Ducks?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "How many?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "Three thousand.",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "Every duck in three counties.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "Brother, they're biting the window.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "Ducks from three counties,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "we're half the silver short.",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "Put it on Xu's name,",
    "emotion": "平穩"
  },
  "zq35a10": {
    "text": "Credit.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "The whole family's credit,",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "on my judgment?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "Yes.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "Your books are never wrong.",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "Tang Xiaotang: affection forty-five.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a16": {
    "text": "On Xu's name,",
    "emotion": "下巴抬著"
  },
  "zq35a17": {
    "text": "paid in full at harvest.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "Brother, a duck's riding you!",
    "emotion": "畫外，笑到打嗝"
  },
  "zq35a19": {
    "text": "The ducks won't listen,",
    "emotion": "急"
  },
  "zq35a20": {
    "text": "the locusts are over the hill!",
    "emotion": "嚇到"
  },
  "zq35a21": {
    "text": "A-Ling?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "How does she… do that?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "Won't ask.",
    "emotion": "笑"
  },
  "zq35a24": {
    "text": "She can. Enough.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "Ducks against locusts?",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "What a joke.",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "One, two, three…",
    "emotion": "數鴨子"
  },
  "zq35a28": {
    "text": "So many duckies!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "Locust plague: stopped.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a30": {
    "text": "Liuxi's fields saved.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "Enough. Come back.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "The next village",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "is bowing to you.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "The realm's hearts:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "two percent.",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "Not just them…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "It's people's hearts?",
    "emotion": "抬頭看天"
  },
  "zq35a38": {
    "text": "Shut the gate!",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "Not enough grain!",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "The grain only lasts",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "two months.",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "Your call.",
    "emotion": "兩個字，很輕"
  },
  "zq35a43": {
    "text": "No grain,",
    "emotion": "吼"
  },
  "zq35a44": {
    "text": "the whole village starves!",
    "emotion": "尖，拖長音"
  }
}
