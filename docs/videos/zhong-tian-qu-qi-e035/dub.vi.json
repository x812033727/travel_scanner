{
  "zq35a01": {
    "text": "Vịt.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "Vịt?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "Cần bao nhiêu con?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "Ba nghìn con.",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "Vịt của cả ba huyện.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "Ca, chúng cắn cửa sổ.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "Vịt ba huyện,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "bạc thiếu một nửa.",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "Lấy danh hiệu Hứa Ký,",
    "emotion": "平穩"
  },
  "zq35a10": {
    "text": "Ghi nợ.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "Uy tín cả nhà,",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "cược vào phán đoán ta?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "Cược.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "Sổ sách của nàng chưa từng sai.",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "Tiểu Đường, hảo cảm bốn mươi lăm.",
    "emotion": "平板電子音，叮一聲",
    "say": "Tiểu Đường hảo cảm bốn mươi lăm."
  },
  "zq35a16": {
    "text": "Danh hiệu Hứa Ký,",
    "emotion": "下巴抬著"
  },
  "zq35a17": {
    "text": "mùa thu trả đủ.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "Ca, vịt cưỡi ca kìa!",
    "emotion": "畫外，笑到打嗝"
  },
  "zq35a19": {
    "text": "Vịt không chịu nghe,",
    "emotion": "急"
  },
  "zq35a20": {
    "text": "châu chấu qua núi rồi!",
    "emotion": "嚇到"
  },
  "zq35a21": {
    "text": "A Lệnh?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "Sao… nàng ấy biết?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "Không hỏi.",
    "emotion": "一口氣，短促",
    "say": "Không hỏi"
  },
  "zq35a24": {
    "text": "Biết là được.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "Vịt trị châu chấu?",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "Nực cười.",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "Một, hai, ba…",
    "emotion": "數鴨子"
  },
  "zq35a28": {
    "text": "Bao nhiêu là vịt!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "Nạn châu chấu đã chặn,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a30": {
    "text": "ruộng Liễu Khê giữ được.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "Đủ rồi, về đây.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "Người thôn bên,",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "đang bái huynh.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "Thiên hạ quy tâm:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "Hai phần trăm.",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "Không chỉ các nàng…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "Là lòng người?",
    "emotion": "抬頭看天"
  },
  "zq35a38": {
    "text": "Đóng cổng!",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "Không đủ lương!",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "Lương thực chỉ đủ",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "hai tháng.",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "Ngươi quyết.",
    "emotion": "兩個字，很輕"
  },
  "zq35a43": {
    "text": "Không đủ lương,",
    "emotion": "大聲，快",
    "say": "Hết lương,"
  },
  "zq35a44": {
    "text": "cả thôn cùng đói!",
    "emotion": "尖，拖長音"
  }
}
