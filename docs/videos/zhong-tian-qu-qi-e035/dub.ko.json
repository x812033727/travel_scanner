{
  "zq35a01": {
    "text": "오리.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "오리?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "몇 마리?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "3천 마리.",
    "emotion": "一口氣，快",
    "say": "삼천 마리."
  },
  "zq35a05": {
    "text": "세 현의 오리 전부.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "오빠, 창문 갉아.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "세 현 오리면,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "은자가 반이 모자라.",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "쉬기 이름으로,",
    "emotion": "平穩"
  },
  "zq35a10": {
    "text": "외상.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "온 집안 신용을,",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "내 판단에 걸어?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "걸어.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "네 장부는 틀린 적 없어.",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "탕샤오탕 호감, 45.",
    "emotion": "平板電子音，叮一聲",
    "say": "탕샤오탕 호감, 사십오."
  },
  "zq35a16": {
    "text": "쉬기 이름으로,",
    "emotion": "下巴抬著"
  },
  "zq35a17": {
    "text": "추수 때 다 갚아.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "오빠, 오리가 탔어!",
    "emotion": "畫外，笑著喊，快"
  },
  "zq35a19": {
    "text": "오리가 말을 안 들어,",
    "emotion": "急",
    "say": "오리가 안 들어,"
  },
  "zq35a20": {
    "text": "메뚜기가 넘어왔어!",
    "emotion": "嚇到"
  },
  "zq35a21": {
    "text": "아링?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "어떻게… 저걸?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "안 물어.",
    "emotion": "一口氣，短促",
    "say": "안 물어"
  },
  "zq35a24": {
    "text": "되면 됐어.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "오리로 메뚜기를?",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "웃기는구먼.",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "하나, 둘, 셋…",
    "emotion": "快速數數",
    "say": "하나 둘 셋…"
  },
  "zq35a28": {
    "text": "오리 엄청 많아!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "메뚜기 재해 저지,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a30": {
    "text": "류시 논, 보전.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "됐어, 돌아와.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "이웃 마을 사람들이,",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "너한테 절해.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "천하귀심,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "2%.",
    "emotion": "平板電子音",
    "say": "이 퍼센트."
  },
  "zq35a36": {
    "text": "아내들만이 아니야…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "민심인가?",
    "emotion": "抬頭看天"
  },
  "zq35a38": {
    "text": "문 닫아!",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "곡식이 모자라!",
    "emotion": "尖",
    "say": "곡식 부족!"
  },
  "zq35a40": {
    "text": "식량은,",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "두 달 치뿐이야.",
    "emotion": "畫外",
    "say": "두 달뿐."
  },
  "zq35a42": {
    "text": "네가 정해.",
    "emotion": "兩個字，很輕"
  },
  "zq35a43": {
    "text": "곡식 없으면,",
    "emotion": "大聲，快",
    "say": "쌀 없인,"
  },
  "zq35a44": {
    "text": "온 마을이 굶는다!",
    "emotion": "尖，拖長音"
  }
}
