{
  "zq35a01": {
    "text": "アヒル。",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "アヒル？",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "何羽いるの？",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "三千羽。",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "三つの県のアヒル。",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "お兄ちゃん、窓かじってる。",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "三県のアヒル、",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "銀が半分足りない。",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "シュー記の名で、",
    "emotion": "平穩"
  },
  "zq35a10": {
    "text": "ツケで。",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "家じゅうの信用を、",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "私の勘に賭けるの？",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "賭ける。",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "お前の帳簿は外れない。",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "シャオタン、好感度四十五。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a16": {
    "text": "シュー記の名で、",
    "emotion": "下巴抬著"
  },
  "zq35a17": {
    "text": "秋にまとめて返す。",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "アヒルに乗られてる！",
    "emotion": "畫外，笑到打嗝"
  },
  "zq35a19": {
    "text": "アヒルが聞かない、",
    "emotion": "急"
  },
  "zq35a20": {
    "text": "イナゴが山を越えた！",
    "emotion": "嚇到"
  },
  "zq35a21": {
    "text": "アーリン？",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "なんで……できるの？",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "聞かない。",
    "emotion": "笑"
  },
  "zq35a24": {
    "text": "できればいい。",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "アヒルで蝗退治？",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "笑わせるわ。",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "いち、に、さん……",
    "emotion": "數鴨子"
  },
  "zq35a28": {
    "text": "アヒルいっぱい！",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "蝗害、阻止。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a30": {
    "text": "柳渓の田、守られた。",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "もういい、戻って。",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "隣村の人が、",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "あなたを拝んでる。",
    "emotion": "拉他袖子",
    "say": "拝んでる。"
  },
  "zq35a34": {
    "text": "天下帰心、",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "二パーセント。",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "妻たちだけじゃ……",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "人の心か？",
    "emotion": "抬頭看天"
  },
  "zq35a38": {
    "text": "門を閉めろ！",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "米が足りん！",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "食糧は、",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "二か月分だけ。",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "決めて。",
    "emotion": "兩個字，很輕"
  },
  "zq35a43": {
    "text": "米が足りねば、",
    "emotion": "吼"
  },
  "zq35a44": {
    "text": "村中飢え死にじゃ！",
    "emotion": "尖，拖長音"
  }
}
