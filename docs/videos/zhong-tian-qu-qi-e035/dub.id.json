{
  "zq35a01": {
    "text": "Bebek.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "Bebek?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "Berapa ekor?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "Tiga ribu.",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "Bebek dari tiga kabupaten.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "Kak, jendelanya digigit.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "Bebek tiga kabupaten,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "peraknya kurang separuh.",
    "emotion": "畫外，悶",
    "say": "kurang separuh."
  },
  "zq35a09": {
    "text": "Pakai nama Toko Xu,",
    "emotion": "平穩"
  },
  "zq35a10": {
    "text": "Utang.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "Nama baik keluarga,",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "demi penilaianku?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "Ya.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "Hitunganmu tak pernah meleset.",
    "emotion": "笑",
    "say": "Kau tak pernah salah."
  },
  "zq35a15": {
    "text": "Tang Xiaotang, poin suka empat puluh lima.",
    "emotion": "平板電子音，叮一聲",
    "say": "Poin suka: empat puluh lima."
  },
  "zq35a16": {
    "text": "Atas nama Toko Xu,",
    "emotion": "下巴抬著"
  },
  "zq35a17": {
    "text": "lunas saat panen.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "Kak, bebek naik kamu!",
    "emotion": "畫外，笑到打嗝"
  },
  "zq35a19": {
    "text": "Bebeknya bandel,",
    "emotion": "急"
  },
  "zq35a20": {
    "text": "belalang lewat bukit!",
    "emotion": "嚇到"
  },
  "zq35a21": {
    "text": "A-Ling?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "Kok… dia bisa?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "Nggak tanya.",
    "emotion": "笑"
  },
  "zq35a24": {
    "text": "Bisa, itu cukup.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "Bebek… basmi belalang?",
    "emotion": "冷笑，拖長音",
    "say": "Pakai bebek?"
  },
  "zq35a26": {
    "text": "Lucu sekali.",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "Satu, dua, tiga…",
    "emotion": "數鴨子"
  },
  "zq35a28": {
    "text": "Banyak bebeknya!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "Wabah belalang dihentikan,",
    "emotion": "平板電子音，叮一聲",
    "say": "Wabah dihentikan,"
  },
  "zq35a30": {
    "text": "sawah Liuxi selamat.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "Cukup, kembali.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "Orang desa sebelah,",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "menyembahmu.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "Rebut hati negeri:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "dua persen.",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "Bukan cuma mereka…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "Hati rakyat?",
    "emotion": "抬頭看天"
  },
  "zq35a38": {
    "text": "Tutup gerbang!",
    "emotion": "大喊",
    "say": "Tutup!"
  },
  "zq35a39": {
    "text": "Beras kurang!",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "Beras cuma cukup",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "dua bulan.",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "Kau putuskan.",
    "emotion": "兩個字，很輕",
    "say": "Putuskan."
  },
  "zq35a43": {
    "text": "Beras kurang,",
    "emotion": "吼"
  },
  "zq35a44": {
    "text": "sekampung kelaparan!",
    "emotion": "尖，拖長音"
  }
}
