{
  "zq35a01": {
    "text": "Patos.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "¿Patos?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "¿Cuántos?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "Tres mil.",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "Los patos de tres condados.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "Hermano, muerden la ventana.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "Patos de tres condados,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "nos falta la mitad.",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "A nombre de Casa Xu,",
    "emotion": "平穩",
    "say": "A nombre de los Xu,"
  },
  "zq35a10": {
    "text": "Fiado.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "¿El crédito de la casa",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "a mi criterio?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "Sí.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "Tus cuentas nunca fallan.",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "Tang Xiaotang: afecto, cuarenta y cinco.",
    "emotion": "平板電子音，叮一聲",
    "say": "Xiaotang: cuarenta y cinco."
  },
  "zq35a16": {
    "text": "A nombre de Casa Xu,",
    "emotion": "下巴抬著",
    "say": "A nombre de los Xu,"
  },
  "zq35a17": {
    "text": "pago a la cosecha.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "¡Hermano, te monta un pato!",
    "emotion": "畫外，笑到打嗝",
    "say": "¡Un pato te monta!"
  },
  "zq35a19": {
    "text": "Los patos no obedecen,",
    "emotion": "急",
    "say": "No obedecen,"
  },
  "zq35a20": {
    "text": "¡Las langostas cruzaron el monte!",
    "emotion": "嚇到",
    "say": "¡Langostas encima!"
  },
  "zq35a21": {
    "text": "¿A-Ling?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "¿Cómo… sabe hacer eso?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "No pregunto.",
    "emotion": "一口氣，短促",
    "say": "No pregunto"
  },
  "zq35a24": {
    "text": "Si sabe, basta.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "¿Patos contra langostas?",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "¡Qué chiste!",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "Uno, dos, tres…",
    "emotion": "快速數數",
    "say": "Uno dos tres…"
  },
  "zq35a28": {
    "text": "¡Cuántos patitos!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "Plaga de langosta detenida,",
    "emotion": "平板電子音，叮一聲",
    "say": "Plaga detenida,"
  },
  "zq35a30": {
    "text": "campos de Liuxi a salvo.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "Basta, vuelvan.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "Los del pueblo vecino",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "te veneran.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "Corazón del reino:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "dos por ciento.",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "No solo ellas…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "¿El corazón del pueblo?",
    "emotion": "抬頭看天",
    "say": "¿Es el pueblo?"
  },
  "zq35a38": {
    "text": "¡Cierren!",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "¡No hay grano!",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "El grano solo da",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "para dos meses.",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "Tú decides.",
    "emotion": "兩個字，很輕"
  },
  "zq35a43": {
    "text": "Sin grano,",
    "emotion": "快，喊",
    "say": "Sin grano"
  },
  "zq35a44": {
    "text": "¡todos pasan hambre!",
    "emotion": "尖，拖長音"
  }
}
