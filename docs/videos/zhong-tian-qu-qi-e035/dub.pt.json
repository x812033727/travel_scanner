{
  "zq35a01": {
    "text": "Patos.",
    "emotion": "畫外，低聲，像想起什麼"
  },
  "zq35a02": {
    "text": "Patos?",
    "emotion": "算盤一推"
  },
  "zq35a03": {
    "text": "Quantos?",
    "emotion": "快，精明"
  },
  "zq35a04": {
    "text": "Três mil.",
    "emotion": "一口氣"
  },
  "zq35a05": {
    "text": "Os patos de três condados.",
    "emotion": "認真"
  },
  "zq35a06": {
    "text": "Mano, tão mordendo a janela.",
    "emotion": "奶聲奶氣，有點怕"
  },
  "zq35a07": {
    "text": "Pato de três condados,",
    "emotion": "畫外，撥算盤"
  },
  "zq35a08": {
    "text": "falta metade da prata.",
    "emotion": "畫外，悶"
  },
  "zq35a09": {
    "text": "Em nome da Loja do Xu,",
    "emotion": "平穩",
    "say": "Em nome do Xu,"
  },
  "zq35a10": {
    "text": "Fiado.",
    "emotion": "一個字"
  },
  "zq35a11": {
    "text": "O crédito da família",
    "emotion": "不敢信"
  },
  "zq35a12": {
    "text": "no meu palpite?",
    "emotion": "聲音小了"
  },
  "zq35a13": {
    "text": "Aposto.",
    "emotion": "乾脆"
  },
  "zq35a14": {
    "text": "Suas contas nunca erram.",
    "emotion": "笑"
  },
  "zq35a15": {
    "text": "Tang Xiaotang: afeição, quarenta e cinco.",
    "emotion": "平板電子音，叮一聲",
    "say": "Xiaotang: quarenta e cinco."
  },
  "zq35a16": {
    "text": "Em nome da Loja do Xu,",
    "emotion": "下巴抬著",
    "say": "Em nome do Xu,"
  },
  "zq35a17": {
    "text": "paga na colheita.",
    "emotion": "精明，快"
  },
  "zq35a18": {
    "text": "Mano, o pato te montou!",
    "emotion": "畫外，笑到打嗝"
  },
  "zq35a19": {
    "text": "Os patos não obedecem,",
    "emotion": "急",
    "say": "Não obedecem,"
  },
  "zq35a20": {
    "text": "Os gafanhotos passaram o morro!",
    "emotion": "嚇到",
    "say": "Os gafanhotos vêm aí!"
  },
  "zq35a21": {
    "text": "A-Ling?",
    "emotion": "畫外，愣住"
  },
  "zq35a22": {
    "text": "Como… ela sabe isso?",
    "emotion": "小聲，不敢信"
  },
  "zq35a23": {
    "text": "Não pergunto.",
    "emotion": "笑",
    "say": "Deixa."
  },
  "zq35a24": {
    "text": "Se sabe, basta.",
    "emotion": "站起來"
  },
  "zq35a25": {
    "text": "Pato… contra gafanhoto?",
    "emotion": "冷笑，拖長音"
  },
  "zq35a26": {
    "text": "Que piada.",
    "emotion": "油滑"
  },
  "zq35a27": {
    "text": "Um, dois, três…",
    "emotion": "數鴨子"
  },
  "zq35a28": {
    "text": "Quanto patinho!",
    "emotion": "放棄，歡呼"
  },
  "zq35a29": {
    "text": "Praga de gafanhotos contida,",
    "emotion": "平板電子音，叮一聲",
    "say": "Praga contida,"
  },
  "zq35a30": {
    "text": "campos de Liuxi salvos.",
    "emotion": "平板電子音"
  },
  "zq35a31": {
    "text": "Chega, voltem.",
    "emotion": "很輕，像在叫人"
  },
  "zq35a32": {
    "text": "O povo vizinho",
    "emotion": "小聲"
  },
  "zq35a33": {
    "text": "te venera.",
    "emotion": "拉他袖子"
  },
  "zq35a34": {
    "text": "O coração do reino:",
    "emotion": "平板電子音，叮一聲"
  },
  "zq35a35": {
    "text": "dois por cento.",
    "emotion": "平板電子音"
  },
  "zq35a36": {
    "text": "Não só elas…",
    "emotion": "喃喃"
  },
  "zq35a37": {
    "text": "O coração do povo?",
    "emotion": "抬頭看天",
    "say": "É o povo?"
  },
  "zq35a38": {
    "text": "Fechem!",
    "emotion": "大喊"
  },
  "zq35a39": {
    "text": "Falta comida!",
    "emotion": "尖"
  },
  "zq35a40": {
    "text": "A comida só dá",
    "emotion": "畫外，很小聲"
  },
  "zq35a41": {
    "text": "pra dois meses.",
    "emotion": "畫外"
  },
  "zq35a42": {
    "text": "Você decide.",
    "emotion": "兩個字，很輕",
    "say": "Decide."
  },
  "zq35a43": {
    "text": "Sem comida,",
    "emotion": "吼"
  },
  "zq35a44": {
    "text": "a vila toda passa fome!",
    "emotion": "尖，拖長音"
  }
}
