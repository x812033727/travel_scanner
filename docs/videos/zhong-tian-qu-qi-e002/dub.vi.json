{
  "zq2a01": "Ta vừa mới sống lại!",
  "zq2a02": "Nhiệm vụ thất bại, lập tức xóa sổ.",
  "zq2a03": "Ba vị cô nương…",
  "zq2a04": "Lấy ta nhé?",
  "zq2a05": "Ngươi á?",
  "zq2a06": "Bổ củi trước đã.",
  "zq2a07": "Ta chỉ cần hộ tịch.",
  "zq2a08": "Tướng công thì miễn.",
  "zq2a09": "Còn… nàng thì sao?",
  "zq2a10": "Không ai chịu cả?",
  "zq2a11": "Ca ca giỏi nhất!",
  "zq2a12": "Kẹt, kẹt rồi…",
  "zq2a13": "Thư sinh.",
  "zq2a14": "Một tay?",
  "zq2a15": "Thế mới gọi là bổ củi.",
  "zq2a16": "Ngươi còn kém xa.",
  "zq2a17": "Vết sẹo này…",
  "zq2a18": "Tiền viên ngoại đến rồi!",
  "zq2a19": "Dẫn cả gia đinh!",
  "zq2a20": "Không đưa gạo!",
  "zq2a21": "Họ muốn cướp gạo!",
  "zq2a22": "Hứa tú tài—",
  "zq2a23": "Nợ đến lúc phải trả rồi.",
  "zq2a24": "Lãi ba phân?",
  "zq2a25": "Đại Hành luật chỉ cho hai phân.",
  "zq2a26": "Thu thừa, phải trả hết.",
  "zq2a27": "Hứa Nghiên, ta gả cho huynh.",
  "zq2a28": "Thật, thật sao?",
  "zq2a29": {
    "text": "Đường Tiểu Đường: đồng ý.",
    "say": "Tiểu Đường: đồng ý."
  },
  "zq2a30": "Đừng hiểu lầm.",
  "zq2a31": "Ta đang trốn một người.",
  "zq2a32": "Còn đáng sợ hơn hắn.",
  "zq2a33": {
    "text": "Hai mươi lượng, bắt người gán nợ!",
    "say": "Không tiền? Bắt người!"
  },
  "zq2a34": "Buông ta ra!"
}
