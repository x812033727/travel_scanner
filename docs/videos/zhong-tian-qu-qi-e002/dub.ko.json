{
  "zq2a01": "나 방금 살아났다고!",
  "zq2a02": "미션 실패 시, 즉시 말살.",
  "zq2a03": "낭자,",
  "zq2a04": "시집올래?",
  "zq2a05": "네가?",
  "zq2a06": "장작부터 패.",
  "zq2a07": "난 호적만 필요해.",
  "zq2a08": "남편은 됐고.",
  "zq2a09": "그럼… 그쪽은?",
  "zq2a10": "다 싫다고?",
  "zq2a11": "오빠 최고!",
  "zq2a12": "끼, 끼었다…",
  "zq2a13": "책상물림.",
  "zq2a14": "한 손으로?",
  "zq2a15": "장작은 이렇게 패는 거야.",
  "zq2a16": "넌, 아직 멀었어.",
  "zq2a17": "이 상처는…",
  "zq2a18": "첸 나리 온다!",
  "zq2a19": "하인들 데리고!",
  "zq2a20": "쌀 못 줘!",
  "zq2a21": "쌀 뺏으려고 해!",
  "zq2a22": "쉬 수재—",
  "zq2a23": "빚 갚을 때가 됐지.",
  "zq2a24": "삼 푼 이자?",
  "zq2a25": "대형률은 두 푼까지야.",
  "zq2a26": "더 받은 건, 다 돌려줘.",
  "zq2a27": "쉬옌, 내가 시집갈게.",
  "zq2a28": "지, 진짜?",
  "zq2a29": "탕샤오탕, 동의.",
  "zq2a30": "착각 마.",
  "zq2a31": "쫓기는 중이야.",
  "zq2a32": "저자보다 무서워.",
  "zq2a33": "몸으로 갚아!",
  "zq2a34": "이거 놔!"
}
