{
  "zq2a01": "Acabei de voltar à vida!",
  "zq2a02": {
    "text": "Missão falhou. Eliminação imediata.",
    "say": "Missão falhou: eliminação."
  },
  "zq2a03": "Ei, moças!",
  "zq2a04": "Casam comigo?",
  "zq2a05": "Você?",
  "zq2a06": "Racha lenha antes.",
  "zq2a07": "Só quero os papéis.",
  "zq2a08": "Marido, dispenso.",
  "zq2a09": "E… você?",
  "zq2a10": "Nenhuma quer?",
  "zq2a11": "Meu mano é o melhor!",
  "zq2a12": "Em… emperrou…",
  "zq2a13": "Letrado.",
  "zq2a14": "Com uma mão?",
  "zq2a15": "Isso é rachar lenha.",
  "zq2a16": "Você? Tá longe disso.",
  "zq2a17": "Essa marca…",
  "zq2a18": "O Senhor Qian tá vindo!",
  "zq2a19": "Com capangas!",
  "zq2a20": "O arroz não!",
  "zq2a21": "Querem levar o arroz!",
  "zq2a22": "Letrado Xu—",
  "zq2a23": "Hora de pagar a dívida.",
  "zq2a24": "Três por cento?",
  "zq2a25": "O Código Daheng permite dois.",
  "zq2a26": "Devolve o excesso.",
  "zq2a27": {
    "text": "Xu Yan, caso com você.",
    "say": "Caso com você."
  },
  "zq2a28": "S… sério?",
  "zq2a29": "Tang Xiaotang: aceitou.",
  "zq2a30": "Nem pense.",
  "zq2a31": "Tô fugindo de alguém.",
  "zq2a32": "Pior que ele.",
  "zq2a33": "Vinte taéis? Levo ela!",
  "zq2a34": "Me solta!"
}
