{
  "zq2a01": "生き返ったのに！",
  "zq2a02": "任務失敗、即時抹殺。",
  "zq2a03": "皆さん、",
  "zq2a04": "嫁に？",
  "zq2a05": "あんたが？",
  "zq2a06": "まず薪割り。",
  "zq2a07": "戸籍だけでいい。",
  "zq2a08": "夫は不要。",
  "zq2a09": "で……君は？",
  "zq2a10": "全員お断り？",
  "zq2a11": "お兄ちゃんすごい！",
  "zq2a12": "抜けない！",
  "zq2a13": "本の虫ね。",
  "zq2a14": "片手？",
  "zq2a15": "薪割りはこうよ。",
  "zq2a16": "あんたはまだまだね。",
  "zq2a17": "その傷は……",
  "zq2a18": "チエン旦那だ！",
  "zq2a19": "手下連れてる！",
  "zq2a20": "お米はダメ！",
  "zq2a21": "お米取られちゃう！",
  "zq2a22": "シュー秀才——",
  "zq2a23": "借金、返してもらおうか。",
  "zq2a24": "利息三分？",
  "zq2a25": "大衡律は二分まで。",
  "zq2a26": "余分は全部返して。",
  "zq2a27": "シュー・イェン、嫁ぐわ。",
  "zq2a28": "ほ、本当？",
  "zq2a29": "タン・シャオタン、同意。",
  "zq2a30": "誤解しないで。",
  "zq2a31": "人から逃げてるの。",
  "zq2a32": "もっと怖い。",
  "zq2a33": "娘をもらう！",
  "zq2a34": "放して！"
}
