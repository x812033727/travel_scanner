{
  "zq2a01": "¡Acabo de revivir!",
  "zq2a02": "Fallo. Eliminación inmediata.",
  "zq2a03": "Chicas.",
  "zq2a04": "¿Me aceptan?",
  "zq2a05": "¿Tú?",
  "zq2a06": "Primero, parte leña.",
  "zq2a07": "Solo quiero los papeles.",
  "zq2a08": {
    "text": "El marido, no gracias.",
    "say": "Sin marido."
  },
  "zq2a09": "¿Y tú?",
  "zq2a10": "¿Ninguna quiere?",
  "zq2a11": "¡Mi hermano es el mejor!",
  "zq2a12": "Se a… atoró…",
  "zq2a13": "Letrados.",
  "zq2a14": {
    "text": "¿Con una mano?",
    "say": "¿Una mano?"
  },
  "zq2a15": "Así se parte leña.",
  "zq2a16": "A ti te falta mucho.",
  "zq2a17": "Esa cicatriz…",
  "zq2a18": "¡Viene don Qian!",
  "zq2a19": "¡Con sus hombres!",
  "zq2a20": "¡El arroz no!",
  "zq2a21": "¡Nos quieren quitar el arroz!",
  "zq2a22": "Letrado Xu…",
  "zq2a23": "Hora de pagar lo que debes.",
  "zq2a24": "¿Tres por ciento?",
  "zq2a25": "El Código Daheng permite dos.",
  "zq2a26": "Lo cobrado de más, se devuelve.",
  "zq2a27": "Xu Yan, me caso contigo.",
  "zq2a28": "¿En serio?",
  "zq2a29": "Tang Xiaotang: acepta.",
  "zq2a30": "No te hagas ideas.",
  "zq2a31": "Me escondo de alguien.",
  "zq2a32": "Peor que él.",
  "zq2a33": {
    "text": "¡Veinte taeles: me la llevo a ella!",
    "say": "¡Por veinte, me la llevo!"
  },
  "zq2a34": "¡Suéltame!"
}
