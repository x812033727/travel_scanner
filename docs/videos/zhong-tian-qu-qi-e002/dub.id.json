{
  "zq2a01": "Aku baru aja hidup lagi!",
  "zq2a02": "Misi gagal. Langsung dihapus.",
  "zq2a03": "Nona-nona…",
  "zq2a04": {
    "text": "Mau nikah sama aku?",
    "say": "Nikah?"
  },
  "zq2a05": "Kamu?",
  "zq2a06": "Belah kayu dulu.",
  "zq2a07": "Aku cuma butuh surat-suratnya.",
  "zq2a08": "Suami nggak usah.",
  "zq2a09": "Terus… kamu?",
  "zq2a10": "Semuanya nolak?",
  "zq2a11": "Kakak paling hebat!",
  "zq2a12": "Nyang… nyangkut…",
  "zq2a13": "Dasar kutu buku.",
  "zq2a14": "Satu tangan?",
  "zq2a15": "Begini baru belah kayu.",
  "zq2a16": "Kamu masih jauh.",
  "zq2a17": "Luka ini…",
  "zq2a18": {
    "text": "Tuan Qian datang!",
    "say": "Tuan Qian!"
  },
  "zq2a19": "Bawa anak buah!",
  "zq2a20": "Berasnya jangan!",
  "zq2a21": "Mereka mau rampas beras!",
  "zq2a22": "Sarjana Xu—",
  "zq2a23": "Sudah waktunya bayar utang.",
  "zq2a24": "Bunga tiga persen?",
  "zq2a25": "Hukum Daheng cuma izinkan dua.",
  "zq2a26": "Kelebihannya, balikin semua.",
  "zq2a27": "Xu Yan, aku mau nikah sama kamu.",
  "zq2a28": "Be… beneran?",
  "zq2a29": {
    "text": "Tang Xiaotang: setuju.",
    "say": "Xiaotang, setuju."
  },
  "zq2a30": "Jangan ge-er.",
  "zq2a31": "Aku lagi sembunyi dari orang.",
  "zq2a32": "Lebih serem dari dia.",
  "zq2a33": {
    "text": "Dua puluh tael, bayar pakai orang!",
    "say": "Bayar pakai orang!"
  },
  "zq2a34": "Lepasin!"
}
