{
  "zq53a01": {
    "text": "Sube.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "¡Espera,",
    "emotion": "慌，極短促，一口氣說完，不拖音",
    "say": "¡Para,"
  },
  "zq53a03": {
    "text": "no sé montar!",
    "emotion": "破音"
  },
  "zq53a04": {
    "text": "Agárrate.",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "¡Adelante—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "A-Ling,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a07": {
    "text": "¿dónde aprendiste a montar?",
    "emotion": "喊",
    "say": "¿dónde aprendiste?"
  },
  "zq53a08": {
    "text": "No hables,",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "te morderás la lengua.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "Misión obligatoria: rescatar a Qin Shuang.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Misión: rescatar a Qin Shuang."
  },
  "zq53a11": {
    "text": "Tiempo restante: dos días.",
    "emotion": "平板電子音"
  },
  "zq53a12": {
    "text": "¡Yan!",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "¡Llegaron los de Liuxi!",
    "emotion": "憨，快，說完就停",
    "say": "¡Ya llegó Liuxi!"
  },
  "zq53a14": {
    "text": "A-Ling cabalga muy rápido,",
    "emotion": "喘"
  },
  "zq53a15": {
    "text": "¡nos tomó dos días en mula!",
    "emotion": "抓頭"
  },
  "zq53a16": {
    "text": "Las huellas son frescas.",
    "emotion": "畫外，冷靜"
  },
  "zq53a17": {
    "text": "Van al embarcadero.",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "Cruzamos antes del anochecer.",
    "emotion": "陰沉",
    "say": "Cruzamos antes de la noche."
  },
  "zq53a19": {
    "text": "Al otro lado, esta persona no existe.",
    "emotion": "低",
    "say": "Al otro lado, ya no existe."
  },
  "zq53a20": {
    "text": "Ustedes no son de la prefectura.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "Asuntos de la prefectura,",
    "emotion": "粗重陰沉，快，說完就停",
    "say": "Asunto oficial,"
  },
  "zq53a22": {
    "text": "¡fuera, curiosos!",
    "emotion": "吼",
    "say": "¡fuera!"
  },
  "zq53a23": {
    "text": "Una docena de sables…",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "¿y cuántos somos?",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "No hay que ganar,",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "solo hacer que la lanza llegue a sus manos.",
    "emotion": "解開綁繩",
    "say": "solo darle la lanza."
  },
  "zq53a27": {
    "text": "¡Xu Yan!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "¡Qin Shuang, atrápala!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "Justo a tiempo.",
    "emotion": "咬牙，快，說完就停"
  },
  "zq53a30": {
    "text": "¡La atrapó!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "¡Prueba mi palo!",
    "emotion": "大吼，極短促，一口氣說完，不拖音",
    "say": "¡Toma!"
  },
  "zq53a32": {
    "text": "Yan,",
    "emotion": "不敢相信"
  },
  "zq53a33": {
    "text": "¡le di!",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "Ahora,",
    "emotion": "冷，快，說完就停"
  },
  "zq53a35": {
    "text": "yo te llevo preso.",
    "emotion": "一字一字",
    "say": "te llevo yo."
  },
  "zq53a36": {
    "text": "Misión obligatoria cumplida.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "¡Orden de devolución de la prefectura!",
    "emotion": "大聲",
    "say": "¡Orden de la prefectura!"
  },
  "zq53a38": {
    "text": "¿Quién se atreve a moverse?",
    "emotion": "一字一字",
    "say": "¿Quién se atreve?"
  },
  "zq53a39": {
    "text": "Sé quién es ella.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "Quién es ella,",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音"
  },
  "zq53a41": {
    "text": "lo dirá ella.",
    "emotion": "一字一字"
  },
  "zq53a42": {
    "text": "A-Ling, afecto: cincuenta y nueve.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling: cincuenta y nueve."
  },
  "zq53a43": {
    "text": "Quita la mano.",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "Déjame ir,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "y te doy la carta para tu padre.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "la carta de tu padre."
  },
  "zq53a46": {
    "text": "¿De mi padre…",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "la carta?",
    "emotion": "不敢相信，快，說完就停"
  },
  "zq53a48": {
    "text": "Qin Shuang,",
    "emotion": "很輕，極短促，一口氣說完，不拖音",
    "say": "Shuang,"
  },
  "zq53a49": {
    "text": "tú decides.",
    "emotion": "很穩"
  },
  "zq53a50": {
    "text": "¿Quieres la carta?",
    "emotion": "畫外，低聲，快，說完就停"
  },
  "zq53a51": {
    "text": "Déjame ir.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "Suéltame."
  }
}
