{
  "zq53a01": {
    "text": "乗って。",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "待って、",
    "emotion": "慌"
  },
  "zq53a03": {
    "text": "俺、馬に乗れないんだ！",
    "emotion": "破音",
    "say": "馬、乗れない！"
  },
  "zq53a04": {
    "text": "つかまって。",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "行けーっ！",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "アーリン、",
    "emotion": "顛得說不清楚"
  },
  "zq53a07": {
    "text": "どこで乗馬を習ったんだ？",
    "emotion": "喊",
    "say": "どこで習った？"
  },
  "zq53a08": {
    "text": "黙って、",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "舌を噛むわ。",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "強制任務：チン・シュアンを救出せよ。",
    "emotion": "平板電子音，叮一聲",
    "say": "強制任務：チン・シュアン救出。"
  },
  "zq53a11": {
    "text": "残り時間：二日。",
    "emotion": "平板電子音"
  },
  "zq53a12": {
    "text": "兄貴！",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "柳渓の仲間が来たぞ！",
    "emotion": "憨笑"
  },
  "zq53a14": {
    "text": "アーリンさんが速すぎて、",
    "emotion": "喘"
  },
  "zq53a15": {
    "text": "俺たちラバで二日かかった！",
    "emotion": "抓頭"
  },
  "zq53a16": {
    "text": "わだちが新しい。",
    "emotion": "畫外，冷靜"
  },
  "zq53a17": {
    "text": "渡し場へ向かった。",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "日暮れ前に渡る。",
    "emotion": "陰沉"
  },
  "zq53a19": {
    "text": "向こう岸に着けば、こいつはいなかったことになる。",
    "emotion": "低",
    "say": "渡れば、こいつは消える。"
  },
  "zq53a20": {
    "text": "お前ら、州府の者じゃない。",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "州府の御用だ、",
    "emotion": "粗重陰沉，快，說完就停",
    "say": "御用だ、"
  },
  "zq53a22": {
    "text": "関係ない奴はどけ！",
    "emotion": "吼",
    "say": "どけ！"
  },
  "zq53a23": {
    "text": "刀が十何本も……",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "こっちは何人だ？",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "勝たなくていい、",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "槍を彼女の手に届ければいい。",
    "emotion": "解開綁繩",
    "say": "槍を届ければいい。"
  },
  "zq53a27": {
    "text": "シュー・イェン！",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "チン・シュアン、受け取れ！",
    "emotion": "大喊",
    "say": "チン・シュアン、取れ！"
  },
  "zq53a29": {
    "text": "ちょうどいいわ。",
    "emotion": "笑，咬牙"
  },
  "zq53a30": {
    "text": "取った！",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "食らえ！",
    "emotion": "大吼"
  },
  "zq53a32": {
    "text": "兄貴、",
    "emotion": "不敢相信，極短促，一口氣說完，不拖音"
  },
  "zq53a33": {
    "text": "当たった！",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "今度は、",
    "emotion": "冷笑"
  },
  "zq53a35": {
    "text": "私があんたを連行する番よ。",
    "emotion": "一字一字",
    "say": "連行するわ。"
  },
  "zq53a36": {
    "text": "強制任務、完了。",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "州府の追回令だ！",
    "emotion": "大聲"
  },
  "zq53a38": {
    "text": "誰がまだ動ける？",
    "emotion": "一字一字",
    "say": "誰が動ける？"
  },
  "zq53a39": {
    "text": "俺はその女の正体を知ってるぜ。",
    "emotion": "陰笑，壓低聲音",
    "say": "女の正体は知ってる。"
  },
  "zq53a40": {
    "text": "彼女が誰かは、",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音",
    "say": "正体は、"
  },
  "zq53a41": {
    "text": "本人が言う。",
    "emotion": "一字一字"
  },
  "zq53a42": {
    "text": "アーリン、好感度、五十九。",
    "emotion": "平板電子音，叮一聲",
    "say": "アーリン、五十九。"
  },
  "zq53a43": {
    "text": "手を離せ。",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "見逃せば、",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "お前の父上への手紙をやる。",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "父上への手紙だ。"
  },
  "zq53a46": {
    "text": "父上の……",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "手紙？",
    "emotion": "不敢相信"
  },
  "zq53a48": {
    "text": "チン・シュアン、",
    "emotion": "很輕，極短促，一口氣說完，不拖音"
  },
  "zq53a49": {
    "text": "君が決めてくれ。",
    "emotion": "很穩",
    "say": "君が決めろ。"
  },
  "zq53a50": {
    "text": "手紙が欲しけりゃ、",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "手紙なら、"
  },
  "zq53a51": {
    "text": "俺を見逃せ。",
    "emotion": "畫外，一字一字"
  }
}
