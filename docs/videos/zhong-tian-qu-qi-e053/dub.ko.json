{
  "zq53a01": {
    "text": "타.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "잠깐,",
    "emotion": "慌"
  },
  "zq53a03": {
    "text": "나 말 못 타!",
    "emotion": "破音"
  },
  "zq53a04": {
    "text": "꽉 잡아.",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "달려—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "아링,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a07": {
    "text": "말은 어디서 배웠어?",
    "emotion": "喊",
    "say": "어디서 배웠어?"
  },
  "zq53a08": {
    "text": "말하지 마,",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "혀 깨물어.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "강제 미션: 친솽을 구출하라.",
    "emotion": "平板電子音，快，說完就停",
    "say": "강제 미션: 친솽 구출."
  },
  "zq53a11": {
    "text": "남은 시간: 이틀.",
    "emotion": "平板電子音"
  },
  "zq53a12": {
    "text": "형!",
    "emotion": "大嗓門"
  },
  "zq53a13": {
    "text": "류시 형제들이 왔어!",
    "emotion": "憨笑"
  },
  "zq53a14": {
    "text": "아링 아가씨가 너무 빨라서,",
    "emotion": "喘"
  },
  "zq53a15": {
    "text": "우린 노새로 이틀 걸렸어!",
    "emotion": "抓頭"
  },
  "zq53a16": {
    "text": "수레 자국이 새것이다.",
    "emotion": "畫外，冷靜",
    "say": "새 자국이야."
  },
  "zq53a17": {
    "text": "나루터로 갔어.",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "해 지기 전에 건넌다.",
    "emotion": "陰沉",
    "say": "해 지기 전 건넌다."
  },
  "zq53a19": {
    "text": "건너편에 가면, 이 사람은 없다.",
    "emotion": "低"
  },
  "zq53a20": {
    "text": "너희, 주 관아 사람 아니지.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "주 관아의 공무다,",
    "emotion": "粗重陰沉",
    "say": "관아 일이다,"
  },
  "zq53a22": {
    "text": "잡것들은 꺼져라!",
    "emotion": "吼",
    "say": "꺼져라!"
  },
  "zq53a23": {
    "text": "칼이 열 몇 자루……",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "우린 몇 명이야?",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "이길 필요 없어,",
    "emotion": "低聲，很穩",
    "say": "안 이겨도 돼,"
  },
  "zq53a26": {
    "text": "창만 그녀 손에 넘기면 돼.",
    "emotion": "解開綁繩",
    "say": "창만 건네면 돼."
  },
  "zq53a27": {
    "text": "쉬옌!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "친솽—받아!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "마침 잘 왔어.",
    "emotion": "笑，咬牙"
  },
  "zq53a30": {
    "text": "받았다!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "몽둥이 맛 좀 봐라!",
    "emotion": "大吼，極短促，一口氣說完，不拖音",
    "say": "받아라!"
  },
  "zq53a32": {
    "text": "형,",
    "emotion": "不敢相信"
  },
  "zq53a33": {
    "text": "내가 맞혔어!",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "이제,",
    "emotion": "冷笑"
  },
  "zq53a35": {
    "text": "내가 널 압송한다.",
    "emotion": "一字一字",
    "say": "널 압송한다."
  },
  "zq53a36": {
    "text": "강제 미션 완료.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "주 관아 추회령이다!",
    "emotion": "大聲",
    "say": "추회령이다!"
  },
  "zq53a38": {
    "text": "누가 감히 움직여?",
    "emotion": "一字一字",
    "say": "누가 움직여?"
  },
  "zq53a39": {
    "text": "저 여자가 누군지 알지.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "그녀가 누군지는,",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音",
    "say": "누군지,"
  },
  "zq53a41": {
    "text": "본인이 말해.",
    "emotion": "一字一字"
  },
  "zq53a42": {
    "text": "아링 호감도, 오십구.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a43": {
    "text": "손 치워.",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "날 보내 주면,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "네 아버지 앞으로 된 편지를 주지.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "아버지 편지다."
  },
  "zq53a46": {
    "text": "내 아버지의……",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "편지?",
    "emotion": "不敢相信"
  },
  "zq53a48": {
    "text": "친솽,",
    "emotion": "很輕，極短促，一口氣說完，不拖音"
  },
  "zq53a49": {
    "text": "네가 정해.",
    "emotion": "很穩"
  },
  "zq53a50": {
    "text": "편지를 원하면,",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "편지 원하면,"
  },
  "zq53a51": {
    "text": "날 보내라.",
    "emotion": "畫外，一字一字"
  }
}
