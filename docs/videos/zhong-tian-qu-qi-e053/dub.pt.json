{
  "zq53a01": {
    "text": "Sobe.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "Espera,",
    "emotion": "慌，極短促，一口氣說完，不拖音",
    "say": "Peraí,"
  },
  "zq53a03": {
    "text": "não sei montar!",
    "emotion": "破音"
  },
  "zq53a04": {
    "text": "Segura firme.",
    "emotion": "淡淡的，嘴角一動",
    "say": "Segura."
  },
  "zq53a05": {
    "text": "Vai—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "A-Ling,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a07": {
    "text": "onde aprendeu a montar?",
    "emotion": "喊",
    "say": "onde aprendeu?"
  },
  "zq53a08": {
    "text": "Não fala,",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "vai morder a língua.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "Missão obrigatória: resgatar Qin Shuang.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Missão: resgatar Qin Shuang."
  },
  "zq53a11": {
    "text": "Tempo restante: dois dias.",
    "emotion": "平板電子音，快，說完就停",
    "say": "Restam dois dias."
  },
  "zq53a12": {
    "text": "Yan!",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "Os irmãos de Liuxi chegaram!",
    "emotion": "憨，快，說完就停"
  },
  "zq53a14": {
    "text": "A-Ling cavalga rápido demais,",
    "emotion": "喘"
  },
  "zq53a15": {
    "text": "viemos de mula, foram dois dias!",
    "emotion": "抓頭",
    "say": "dois dias de mula!"
  },
  "zq53a16": {
    "text": "Os sulcos das rodas são frescos.",
    "emotion": "畫外，冷靜",
    "say": "Os sulcos são frescos."
  },
  "zq53a17": {
    "text": "Foram pro cais.",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "Atravessamos antes de escurecer.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Cruza antes da noite."
  },
  "zq53a19": {
    "text": "Do outro lado, essa pessoa não existe mais.",
    "emotion": "低",
    "say": "Do outro lado, ela some."
  },
  "zq53a20": {
    "text": "Vocês não são da prefeitura.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "Serviço da prefeitura,",
    "emotion": "粗重陰沉，快，說完就停"
  },
  "zq53a22": {
    "text": "fora, curiosos!",
    "emotion": "吼",
    "say": "fora!"
  },
  "zq53a23": {
    "text": "Uma dúzia de sabres…",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "e nós somos quantos?",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "Não precisa vencer,",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "é só pôr a lança na mão dela.",
    "emotion": "解開綁繩",
    "say": "só entregar a lança."
  },
  "zq53a27": {
    "text": "Xu Yan!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "Qin Shuang, pega!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "Chegou na hora.",
    "emotion": "咬牙，快，說完就停"
  },
  "zq53a30": {
    "text": "Pegou!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "Prova do meu bastão!",
    "emotion": "大吼，極短促，一口氣說完，不拖音",
    "say": "Toma!"
  },
  "zq53a32": {
    "text": "Yan,",
    "emotion": "不敢相信，極短促，一口氣說完，不拖音"
  },
  "zq53a33": {
    "text": "eu acertei!",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "Agora,",
    "emotion": "冷，快，說完就停"
  },
  "zq53a35": {
    "text": "quem te leva preso sou eu.",
    "emotion": "一字一字",
    "say": "eu te levo."
  },
  "zq53a36": {
    "text": "Missão obrigatória cumprida.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "Ordem de retorno da prefeitura!",
    "emotion": "大聲",
    "say": "Ordem da prefeitura!"
  },
  "zq53a38": {
    "text": "Quem ousa se mexer?",
    "emotion": "一字一字",
    "say": "Quem ousa?"
  },
  "zq53a39": {
    "text": "Eu sei quem ela é.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "Quem ela é,",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音"
  },
  "zq53a41": {
    "text": "ela mesma diz.",
    "emotion": "冷，快，說完就停",
    "say": "ela diz."
  },
  "zq53a42": {
    "text": "A-Ling, afeição: cinquenta e nove.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling: cinquenta e nove."
  },
  "zq53a43": {
    "text": "Tira a mão.",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "Me deixa ir,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "e a carta pro seu pai é sua.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "e a carta do seu pai."
  },
  "zq53a46": {
    "text": "Do meu pai…",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "a carta?",
    "emotion": "不敢相信，快，說完就停"
  },
  "zq53a48": {
    "text": "Qin Shuang,",
    "emotion": "很輕，極短促，一口氣說完，不拖音",
    "say": "Shuang,"
  },
  "zq53a49": {
    "text": "você decide.",
    "emotion": "很穩，快，說完就停",
    "say": "é com você."
  },
  "zq53a50": {
    "text": "Quer a carta?",
    "emotion": "畫外，低聲，快，說完就停"
  },
  "zq53a51": {
    "text": "Então me deixa ir.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "Me solta."
  }
}
