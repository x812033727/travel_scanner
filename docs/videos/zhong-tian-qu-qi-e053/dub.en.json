{
  "zq53a01": {
    "text": "Get on.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "Wait,",
    "emotion": "慌，極短促，一口氣說完，不拖音"
  },
  "zq53a03": {
    "text": "I can't ride a horse!",
    "emotion": "破音",
    "say": "I can't ride!"
  },
  "zq53a04": {
    "text": "Hold on.",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "Charge—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "A-Ling,",
    "emotion": "顛得說不清楚"
  },
  "zq53a07": {
    "text": "where'd you learn to ride?",
    "emotion": "喊",
    "say": "where'd you learn?"
  },
  "zq53a08": {
    "text": "Don't talk,",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "you'll bite your tongue.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "Mandatory mission: rescue Qin Shuang.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a11": {
    "text": "Time remaining: two days.",
    "emotion": "平板電子音"
  },
  "zq53a12": {
    "text": "Yan!",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "The Liuxi boys are here!",
    "emotion": "憨笑"
  },
  "zq53a14": {
    "text": "A-Ling rides too fast,",
    "emotion": "喘"
  },
  "zq53a15": {
    "text": "we rode mules for two days!",
    "emotion": "抓頭"
  },
  "zq53a16": {
    "text": "These ruts are fresh.",
    "emotion": "畫外，冷靜"
  },
  "zq53a17": {
    "text": "They're headed for the ford.",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "Cross before dark.",
    "emotion": "陰沉"
  },
  "zq53a19": {
    "text": "Once we're across, this person never existed.",
    "emotion": "低",
    "say": "Once across, she never existed."
  },
  "zq53a20": {
    "text": "You're not prefecture men.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "Prefecture business,",
    "emotion": "粗重陰沉"
  },
  "zq53a22": {
    "text": "bystanders, get lost!",
    "emotion": "吼",
    "say": "get lost!"
  },
  "zq53a23": {
    "text": "A dozen blades…",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "and how many are we?",
    "emotion": "小聲",
    "say": "how many are we?"
  },
  "zq53a25": {
    "text": "We don't need to win,",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "just get the spear into her hands.",
    "emotion": "解開綁繩",
    "say": "just get her the spear."
  },
  "zq53a27": {
    "text": "Xu Yan!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "Qin Shuang—catch!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "Just in time.",
    "emotion": "笑，咬牙"
  },
  "zq53a30": {
    "text": "She caught it!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "Have a taste of my staff!",
    "emotion": "大吼",
    "say": "Take that!"
  },
  "zq53a32": {
    "text": "Yan,",
    "emotion": "不敢相信"
  },
  "zq53a33": {
    "text": "I hit him!",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "Now,",
    "emotion": "冷笑"
  },
  "zq53a35": {
    "text": "it's my turn to take you in.",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "I'll take you."
  },
  "zq53a36": {
    "text": "Mandatory mission complete.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "A prefecture recall order!",
    "emotion": "大聲",
    "say": "Recall order!"
  },
  "zq53a38": {
    "text": "Who dares move?",
    "emotion": "一字一字"
  },
  "zq53a39": {
    "text": "I know who she is.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "Who she is,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a41": {
    "text": "is hers to say.",
    "emotion": "一字一字"
  },
  "zq53a42": {
    "text": "A-Ling, affection: fifty-nine.",
    "emotion": "平板電子音，叮一聲",
    "say": "A-Ling: fifty-nine."
  },
  "zq53a43": {
    "text": "Hands off.",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "Let me go,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "and you get the letter to your father.",
    "emotion": "畫外，拖長音",
    "say": "your father's letter."
  },
  "zq53a46": {
    "text": "My father's…",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "letter?",
    "emotion": "不敢相信"
  },
  "zq53a48": {
    "text": "Qin Shuang,",
    "emotion": "很輕"
  },
  "zq53a49": {
    "text": "your call.",
    "emotion": "很穩"
  },
  "zq53a50": {
    "text": "Want the letter?",
    "emotion": "畫外，低笑"
  },
  "zq53a51": {
    "text": "Then let me go.",
    "emotion": "畫外，一字一字"
  }
}
