{
  "zq53a01": {
    "text": "Lên đi.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "Khoan,",
    "emotion": "慌，極短促，一口氣說完，不拖音"
  },
  "zq53a03": {
    "text": "ta không biết cưỡi ngựa!",
    "emotion": "破音"
  },
  "zq53a04": {
    "text": "Bám chắc.",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "Xông lên—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "A Lệnh,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a07": {
    "text": "nàng học cưỡi ngựa ở đâu?",
    "emotion": "喊",
    "say": "học ở đâu vậy?"
  },
  "zq53a08": {
    "text": "Đừng nói,",
    "emotion": "冷"
  },
  "zq53a09": {
    "text": "kẻo cắn phải lưỡi.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "Nhiệm vụ bắt buộc: cứu Tần Sương về.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq53a11": {
    "text": "Thời gian còn lại: hai ngày.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq53a12": {
    "text": "Nghiên ca!",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "Huynh đệ Liễu Khê tới rồi!",
    "emotion": "憨，快，說完就停"
  },
  "zq53a14": {
    "text": "A Lệnh cô nương phi nhanh quá,",
    "emotion": "喘，快，說完就停"
  },
  "zq53a15": {
    "text": "bọn ta cưỡi la đuổi hai ngày!",
    "emotion": "抓頭，快，說完就停"
  },
  "zq53a16": {
    "text": "Vết bánh xe còn mới.",
    "emotion": "畫外，冷靜"
  },
  "zq53a17": {
    "text": "Đi về bến đò rồi.",
    "emotion": "很短"
  },
  "zq53a18": {
    "text": "Qua sông trước khi trời tối.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a19": {
    "text": "Sang bờ bên kia, coi như không có người này.",
    "emotion": "低聲，快，說完就停",
    "say": "Sang bờ kia, là hết người này."
  },
  "zq53a20": {
    "text": "Các ngươi không phải người châu phủ.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "Châu phủ làm việc,",
    "emotion": "粗重陰沉，快，說完就停"
  },
  "zq53a22": {
    "text": "kẻ rảnh cút đi!",
    "emotion": "吼"
  },
  "zq53a23": {
    "text": "Hơn chục thanh đao…",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "bọn mình có mấy người?",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "Không cần đánh thắng,",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "chỉ cần đưa thương tới tay nàng.",
    "emotion": "解開綁繩",
    "say": "đưa thương cho nàng là được."
  },
  "zq53a27": {
    "text": "Hứa Nghiên!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "Tần Sương—đỡ lấy!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "Tới đúng lúc lắm.",
    "emotion": "咬牙，快，說完就停"
  },
  "zq53a30": {
    "text": "Bắt được rồi!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "Xem gậy đây!",
    "emotion": "大吼，極短促，一口氣說完，不拖音"
  },
  "zq53a32": {
    "text": "Nghiên ca,",
    "emotion": "不敢相信，極短促，一口氣說完，不拖音"
  },
  "zq53a33": {
    "text": "ta đánh trúng rồi!",
    "emotion": "憨笑大喊"
  },
  "zq53a34": {
    "text": "Giờ thì,",
    "emotion": "冷，快，說完就停"
  },
  "zq53a35": {
    "text": "tới lượt ta giải ngươi.",
    "emotion": "冷，快，說完就停",
    "say": "ta giải ngươi."
  },
  "zq53a36": {
    "text": "Nhiệm vụ bắt buộc hoàn thành.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "Lệnh truy hồi của châu phủ!",
    "emotion": "大聲"
  },
  "zq53a38": {
    "text": "Ai còn dám động?",
    "emotion": "一字一字"
  },
  "zq53a39": {
    "text": "Ta biết nàng ta là ai.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "Nàng là ai,",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音"
  },
  "zq53a41": {
    "text": "để nàng tự nói.",
    "emotion": "冷，快，說完就停"
  },
  "zq53a42": {
    "text": "A Lệnh hảo cảm, năm mươi chín.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq53a43": {
    "text": "Bỏ tay ra.",
    "emotion": "冷"
  },
  "zq53a44": {
    "text": "Thả ta đi,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "thư gửi cha ngươi sẽ là của ngươi.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "thư gửi cha ngươi."
  },
  "zq53a46": {
    "text": "Cha ta…",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "thư ư?",
    "emotion": "不敢相信，快，說完就停"
  },
  "zq53a48": {
    "text": "Tần Sương,",
    "emotion": "很輕，極短促，一口氣說完，不拖音"
  },
  "zq53a49": {
    "text": "nàng quyết định.",
    "emotion": "很穩"
  },
  "zq53a50": {
    "text": "Muốn thư,",
    "emotion": "畫外，低聲，快，說完就停"
  },
  "zq53a51": {
    "text": "thì thả ta đi.",
    "emotion": "畫外，低聲，快，說完就停"
  }
}
