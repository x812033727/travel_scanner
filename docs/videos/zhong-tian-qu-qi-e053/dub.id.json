{
  "zq53a01": {
    "text": "Naik.",
    "emotion": "很短"
  },
  "zq53a02": {
    "text": "Tunggu,",
    "emotion": "慌，極短促，一口氣說完，不拖音"
  },
  "zq53a03": {
    "text": "aku nggak bisa naik kuda!",
    "emotion": "破音",
    "say": "aku nggak bisa berkuda!"
  },
  "zq53a04": {
    "text": "Pegangan.",
    "emotion": "淡淡的，嘴角一動"
  },
  "zq53a05": {
    "text": "Maju—!",
    "emotion": "抓著馬鞍大喊"
  },
  "zq53a06": {
    "text": "A-Ling,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a07": {
    "text": "kamu belajar berkuda di mana?",
    "emotion": "喊",
    "say": "belajar di mana?"
  },
  "zq53a08": {
    "text": "Jangan bicara,",
    "emotion": "冷",
    "say": "Diam,"
  },
  "zq53a09": {
    "text": "nanti lidahmu tergigit.",
    "emotion": "頭也不回"
  },
  "zq53a10": {
    "text": "Misi wajib: selamatkan Qin Shuang.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq53a11": {
    "text": "Sisa waktu: dua hari.",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq53a12": {
    "text": "Kak Yan!",
    "emotion": "大嗓門，極短促，一口氣說完，不拖音"
  },
  "zq53a13": {
    "text": "Saudara-saudara dari Liuxi datang!",
    "emotion": "憨，快，說完就停",
    "say": "Anak-anak Liuxi datang!"
  },
  "zq53a14": {
    "text": "Nona A-Ling terlalu cepat,",
    "emotion": "喘，快，說完就停",
    "say": "A-Ling ngebut banget,"
  },
  "zq53a15": {
    "text": "kami naik bagal dua hari!",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "dua hari naik bagal!"
  },
  "zq53a16": {
    "text": "Bekas rodanya masih baru.",
    "emotion": "畫外，冷靜"
  },
  "zq53a17": {
    "text": "Ke dermaga penyeberangan.",
    "emotion": "很短",
    "say": "Ke dermaga."
  },
  "zq53a18": {
    "text": "Seberangi sebelum gelap.",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq53a19": {
    "text": "Sampai seberang, orang ini lenyap.",
    "emotion": "低聲，快，說完就停",
    "say": "Di seberang, dia lenyap."
  },
  "zq53a20": {
    "text": "Kalian bukan orang prefektur.",
    "emotion": "咬牙，冷"
  },
  "zq53a21": {
    "text": "Tugas prefektur,",
    "emotion": "粗重陰沉，快，說完就停"
  },
  "zq53a22": {
    "text": "orang luar, minggir!",
    "emotion": "吼",
    "say": "minggir!"
  },
  "zq53a23": {
    "text": "Belasan golok…",
    "emotion": "吞口水"
  },
  "zq53a24": {
    "text": "kita cuma berapa?",
    "emotion": "小聲"
  },
  "zq53a25": {
    "text": "Nggak perlu menang,",
    "emotion": "低聲，很穩"
  },
  "zq53a26": {
    "text": "asal tombaknya sampai ke tangannya.",
    "emotion": "解開綁繩",
    "say": "antar tombaknya saja."
  },
  "zq53a27": {
    "text": "Xu Yan!",
    "emotion": "眼睛一亮"
  },
  "zq53a28": {
    "text": "Qin Shuang—tangkap!",
    "emotion": "大喊"
  },
  "zq53a29": {
    "text": "Pas sekali.",
    "emotion": "咬牙，快，說完就停"
  },
  "zq53a30": {
    "text": "Dapat!",
    "emotion": "大笑"
  },
  "zq53a31": {
    "text": "Rasakan!",
    "emotion": "大吼，極短促，一口氣說完，不拖音"
  },
  "zq53a32": {
    "text": "Kak Yan,",
    "emotion": "不敢相信，極短促，一口氣說完，不拖音"
  },
  "zq53a33": {
    "text": "aku berhasil memukulnya!",
    "emotion": "憨笑大喊",
    "say": "aku kena!"
  },
  "zq53a34": {
    "text": "Sekarang,",
    "emotion": "冷，快，說完就停"
  },
  "zq53a35": {
    "text": "giliran aku menggiringmu.",
    "emotion": "冷，快，說完就停",
    "say": "kugiring kau."
  },
  "zq53a36": {
    "text": "Misi wajib selesai.",
    "emotion": "平板電子音，叮一聲"
  },
  "zq53a37": {
    "text": "Surat perintah penarikan prefektur!",
    "emotion": "大聲",
    "say": "Perintah prefektur!"
  },
  "zq53a38": {
    "text": "Siapa berani bergerak?",
    "emotion": "一字一字",
    "say": "Siapa berani?"
  },
  "zq53a39": {
    "text": "Aku tahu siapa dia.",
    "emotion": "陰笑，壓低聲音"
  },
  "zq53a40": {
    "text": "Siapa dia,",
    "emotion": "打斷，冷，極短促，一口氣說完，不拖音"
  },
  "zq53a41": {
    "text": "biar dia sendiri yang bilang.",
    "emotion": "冷，快，說完就停",
    "say": "biar dia bilang."
  },
  "zq53a42": {
    "text": "Poin suka A-Ling, lima puluh sembilan.",
    "emotion": "平板電子音，快，說完就停",
    "say": "A-Ling, lima puluh sembilan."
  },
  "zq53a43": {
    "text": "Singkirkan tanganmu.",
    "emotion": "冷",
    "say": "Lepas!"
  },
  "zq53a44": {
    "text": "Lepaskan aku,",
    "emotion": "陰沉"
  },
  "zq53a45": {
    "text": "surat untuk ayahmu jadi milikmu.",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "surat untuk ayahmu."
  },
  "zq53a46": {
    "text": "Ayahku…",
    "emotion": "聲音一啞"
  },
  "zq53a47": {
    "text": "surat?",
    "emotion": "不敢相信，快，說完就停"
  },
  "zq53a48": {
    "text": "Qin Shuang,",
    "emotion": "很輕，極短促，一口氣說完，不拖音"
  },
  "zq53a49": {
    "text": "kamu yang putuskan.",
    "emotion": "很穩",
    "say": "kamu putuskan."
  },
  "zq53a50": {
    "text": "Mau suratnya?",
    "emotion": "畫外，低聲，快，說完就停"
  },
  "zq53a51": {
    "text": "Lepaskan aku.",
    "emotion": "畫外，低聲，快，說完就停"
  }
}
