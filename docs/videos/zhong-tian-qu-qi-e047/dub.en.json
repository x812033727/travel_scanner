{
  "zq47a01": {
    "text": "The waterwheel in part three,",
    "emotion": "不慌，一字一字"
  },
  "zq47a02": {
    "text": "you draw it.",
    "emotion": "盯著魏珣"
  },
  "zq47a03": {
    "text": "D-Draw…",
    "emotion": "愣住，極短促，不拖音",
    "say": "Draw…"
  },
  "zq47a04": {
    "text": "Draw what?",
    "emotion": "強撐著倨傲"
  },
  "zq47a05": {
    "text": "Ahem,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ahem."
  },
  "zq47a06": {
    "text": "Nonsense!",
    "emotion": "尖聲"
  },
  "zq47a07": {
    "text": "Beat him!",
    "emotion": "揮袖"
  },
  "zq47a08": {
    "text": "Wait.",
    "emotion": "沉聲"
  },
  "zq47a09": {
    "text": "Give them paper.",
    "emotion": "不怒自威"
  },
  "zq47a10": {
    "text": "You memorized the words,",
    "emotion": "平靜",
    "say": "You know the words,"
  },
  "zq47a11": {
    "text": "but the waterwheel?",
    "emotion": "嘴角一勾",
    "say": "And the wheel?"
  },
  "zq47a12": {
    "text": "Twelve blades,",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "angled three degrees.",
    "emotion": "篤定"
  },
  "zq47a14": {
    "text": "Correct,",
    "emotion": "篤定，短促，說完就停",
    "say": "Yes,"
  },
  "zq47a15": {
    "text": "that's the one.",
    "emotion": "篤定"
  },
  "zq47a16": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq47a17": {
    "text": "where's your waterwheel?",
    "emotion": "冷",
    "say": "your waterwheel?"
  },
  "zq47a18": {
    "text": "The blades,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Blades,"
  },
  "zq47a19": {
    "text": "why mount them backward?",
    "emotion": "考問",
    "say": "why backward?"
  },
  "zq47a20": {
    "text": "I…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "I—"
  },
  "zq47a21": {
    "text": "What I memorized…",
    "emotion": "說溜嘴",
    "say": "I memorized…"
  },
  "zq47a22": {
    "text": "Memorized?",
    "emotion": "抓住了，極短促，一口氣說完，不拖音",
    "say": "Learned?"
  },
  "zq47a23": {
    "text": "Memorized from whom?",
    "emotion": "笑，慢慢地",
    "say": "From whom?"
  },
  "zq47a24": {
    "text": "The first time, I put them in backward,",
    "emotion": "老實說"
  },
  "zq47a25": {
    "text": "and the wheel wouldn't turn.",
    "emotion": "笑了一下"
  },
  "zq47a26": {
    "text": "My little sister held up a pinwheel,",
    "emotion": "想起來，聲音軟了",
    "say": "My sister's pinwheel,"
  },
  "zq47a27": {
    "text": "and then I flipped them around.",
    "emotion": "笑",
    "say": "then I flipped them."
  },
  "zq47a28": {
    "text": "Before the exam,",
    "emotion": "低聲，快，說完就停",
    "say": "Beforehand,"
  },
  "zq47a29": {
    "text": "in my study,",
    "emotion": "一字一句"
  },
  "zq47a30": {
    "text": "he drew this very wheel.",
    "emotion": "作證",
    "say": "he drew this one."
  },
  "zq47a31": {
    "text": "Ahem,",
    "emotion": "清嗓子，急",
    "say": "Hm,"
  },
  "zq47a32": {
    "text": "A scholar reciting his texts,",
    "emotion": "硬撐"
  },
  "zq47a33": {
    "text": "what's so odd about that!",
    "emotion": "拔高"
  },
  "zq47a34": {
    "text": "My lord!",
    "emotion": "畫外，清亮，短促，說完就停",
    "say": "Sir!"
  },
  "zq47a35": {
    "text": "This humble woman has something to present!",
    "emotion": "畫外",
    "say": "I have something to present!"
  },
  "zq47a36": {
    "text": "That man from the Wei family,",
    "emotion": "甜但字字清楚",
    "say": "That Wei man,"
  },
  "zq47a37": {
    "text": "came to see Examiner Feng again.",
    "emotion": "揚眉"
  },
  "zq47a38": {
    "text": "This is the second packet,",
    "emotion": "笑得很甜"
  },
  "zq47a39": {
    "text": "I took it off his hands.",
    "emotion": "眨眼",
    "say": "I took it."
  },
  "zq47a40": {
    "text": "Five hundred taels,",
    "emotion": "聲音一沉，快，說完就停",
    "say": "Five hundred,"
  },
  "zq47a41": {
    "text": "paid in full when the results are posted.",
    "emotion": "冷",
    "say": "paid when the list's posted."
  },
  "zq47a42": {
    "text": "I know this seal,",
    "emotion": "笑意收起"
  },
  "zq47a43": {
    "text": "Wei Shaoqing's steward.",
    "emotion": "冷冷地"
  },
  "zq47a44": {
    "text": "My lord,",
    "emotion": "低聲，極短促，說完就停",
    "say": "Sir,"
  },
  "zq47a45": {
    "text": "I've been wronged…",
    "emotion": "聲音發抖"
  },
  "zq47a46": {
    "text": "Seize him!",
    "emotion": "一拍驚堂木"
  },
  "zq47a47": {
    "text": "Leave us.",
    "emotion": "低聲，揮手"
  },
  "zq47a48": {
    "text": "Accuse the Wei family,",
    "emotion": "壓低聲音，快，說完就停",
    "say": "Sue the Weis,"
  },
  "zq47a49": {
    "text": "and the case goes to the capital.",
    "emotion": "句句是盤算"
  },
  "zq47a50": {
    "text": "Three years with no verdict,",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "Three years, stalled,"
  },
  "zq47a51": {
    "text": "and your exam year is lost.",
    "emotion": "畫外，低聲，快",
    "say": "your exam year's gone."
  },
  "zq47a52": {
    "text": "Try only Examiner Feng,",
    "emotion": "往後一靠"
  },
  "zq47a53": {
    "text": "and tomorrow,",
    "emotion": "慢"
  },
  "zq47a54": {
    "text": "you're Jieyuan, first in the province.",
    "emotion": "一字一字",
    "say": "you're Jieyuan."
  },
  "zq47a55": {
    "text": "Choice: bring down the Wei clan,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq47a56": {
    "text": "or take Jieyuan first.",
    "emotion": "平板電子音"
  }
}
