{
  "zq47a01": {
    "text": "第三段の水車を、",
    "emotion": "不慌，平穩，說完就停",
    "say": "第三段の水車、"
  },
  "zq47a02": {
    "text": "描いてみろ。",
    "emotion": "盯著魏珣"
  },
  "zq47a03": {
    "text": "か、描く……",
    "emotion": "愣住",
    "say": "描く……"
  },
  "zq47a04": {
    "text": "何を描けと？",
    "emotion": "強撐著倨傲"
  },
  "zq47a05": {
    "text": "ゴホン、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "コホン。"
  },
  "zq47a06": {
    "text": "ふざけるな！",
    "emotion": "尖聲，短促",
    "say": "黙れ！"
  },
  "zq47a07": {
    "text": "打ち据えろ！",
    "emotion": "揮袖",
    "say": "打て！"
  },
  "zq47a08": {
    "text": "待て。",
    "emotion": "沉聲"
  },
  "zq47a09": {
    "text": "紙を与えよ。",
    "emotion": "不怒自威"
  },
  "zq47a10": {
    "text": "文は暗記できても、",
    "emotion": "平靜，快，說完就停",
    "say": "字は覚えても、"
  },
  "zq47a11": {
    "text": "水車は？",
    "emotion": "嘴角一勾"
  },
  "zq47a12": {
    "text": "羽根板は十二枚、",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "三分傾けて。",
    "emotion": "篤定",
    "say": "斜め三分。"
  },
  "zq47a14": {
    "text": "そうだ、",
    "emotion": "撫鬚，點頭"
  },
  "zq47a15": {
    "text": "この水車だ。",
    "emotion": "篤定"
  },
  "zq47a16": {
    "text": "ウェイ・シュン、",
    "emotion": "轉頭"
  },
  "zq47a17": {
    "text": "お前の水車は？",
    "emotion": "冷"
  },
  "zq47a18": {
    "text": "羽根板は、",
    "emotion": "探身",
    "say": "羽根、"
  },
  "zq47a19": {
    "text": "なぜ逆に付けた？",
    "emotion": "考問"
  },
  "zq47a20": {
    "text": "俺……",
    "emotion": "慌，極短促，一口氣說完",
    "say": "俺"
  },
  "zq47a21": {
    "text": "俺が覚えたのは……",
    "emotion": "說溜嘴",
    "say": "覚えたのは……"
  },
  "zq47a22": {
    "text": "覚えた？",
    "emotion": "抓住了，極短促，一口氣說完，不拖音",
    "say": "暗記？"
  },
  "zq47a23": {
    "text": "誰のを？",
    "emotion": "笑，慢慢地"
  },
  "zq47a24": {
    "text": "最初は逆に付けて、",
    "emotion": "老實說"
  },
  "zq47a25": {
    "text": "水車が回らなかった。",
    "emotion": "老實，低聲，說完就停",
    "say": "回らなかった。"
  },
  "zq47a26": {
    "text": "妹が風車で示してくれて、",
    "emotion": "想起來，聲音軟了",
    "say": "妹の風車を見て、"
  },
  "zq47a27": {
    "text": "やっと裏返した。",
    "emotion": "溫和，說完就停"
  },
  "zq47a28": {
    "text": "試験の前、",
    "emotion": "低聲，快，說完就停",
    "say": "試験前、"
  },
  "zq47a29": {
    "text": "わしの書斎で",
    "emotion": "一字一句"
  },
  "zq47a30": {
    "text": "この水車を描いた。",
    "emotion": "作證，快，說完就停",
    "say": "これを描いた。"
  },
  "zq47a31": {
    "text": "ゴホン、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ふん、"
  },
  "zq47a32": {
    "text": "書生が書を覚えたとて、",
    "emotion": "硬撐"
  },
  "zq47a33": {
    "text": "何が珍しい！",
    "emotion": "拔高"
  },
  "zq47a34": {
    "text": "閣下！",
    "emotion": "畫外，清亮"
  },
  "zq47a35": {
    "text": "献上したい物がございます！",
    "emotion": "畫外",
    "say": "献上の品が！"
  },
  "zq47a36": {
    "text": "あのウェイ家の者が、",
    "emotion": "甜但字字清楚",
    "say": "ウェイ家の者が、"
  },
  "zq47a37": {
    "text": "またフォン学正に会いに。",
    "emotion": "揚眉"
  },
  "zq47a38": {
    "text": "これが二つ目、",
    "emotion": "笑得很甜"
  },
  "zq47a39": {
    "text": "代わりに受け取りました。",
    "emotion": "眨眼",
    "say": "預かりました。"
  },
  "zq47a40": {
    "text": "五百両、",
    "emotion": "聲音一沉，快，說完就停"
  },
  "zq47a41": {
    "text": "合格発表で全額支払い。",
    "emotion": "冷",
    "say": "発表後に全額。"
  },
  "zq47a42": {
    "text": "この印、存じております、",
    "emotion": "冷，快，說完就停",
    "say": "この印は、"
  },
  "zq47a43": {
    "text": "ウェイ・シャオチンの執事です。",
    "emotion": "冷冷地",
    "say": "ウェイ・シャオチンの執事。"
  },
  "zq47a44": {
    "text": "閣下、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "閣下"
  },
  "zq47a45": {
    "text": "私は冤罪で……",
    "emotion": "聲音發抖"
  },
  "zq47a46": {
    "text": "捕らえよ！",
    "emotion": "一拍驚堂木"
  },
  "zq47a47": {
    "text": "下がれ。",
    "emotion": "低聲，揮手"
  },
  "zq47a48": {
    "text": "ウェイ家を訴えれば、",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "ウェイ家なら、"
  },
  "zq47a49": {
    "text": "この件は都へ送られる。",
    "emotion": "句句是盤算"
  },
  "zq47a50": {
    "text": "三年は片づかず、",
    "emotion": "畫外，低聲，說完就停"
  },
  "zq47a51": {
    "text": "お前の今回の受験は消える。",
    "emotion": "畫外，低聲，快",
    "say": "受験はふいだ。"
  },
  "zq47a52": {
    "text": "フォン学正だけ裁けば、",
    "emotion": "沉穩，快，說完就停",
    "say": "フォンだけ裁けば、"
  },
  "zq47a53": {
    "text": "お前は明日、",
    "emotion": "快，說完就停",
    "say": "明日、"
  },
  "zq47a54": {
    "text": "解元だ。",
    "emotion": "一字一字"
  },
  "zq47a55": {
    "text": "選択：ウェイ家を倒す、",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq47a56": {
    "text": "または先に解元を取る。",
    "emotion": "平板電子音"
  }
}
