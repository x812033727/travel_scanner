{
  "zq47a01": {
    "text": "셋째 단락의 수차,",
    "emotion": "不慌，快，說完就停",
    "say": "그 수차,"
  },
  "zq47a02": {
    "text": "네가 그려 봐.",
    "emotion": "盯著魏珣",
    "say": "그려 봐."
  },
  "zq47a03": {
    "text": "그, 그려……",
    "emotion": "愣住，極短促，不拖音",
    "say": "그려?"
  },
  "zq47a04": {
    "text": "뭘 그려?",
    "emotion": "強撐著倨傲"
  },
  "zq47a05": {
    "text": "에헴,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq47a06": {
    "text": "터무니없다!",
    "emotion": "尖聲，短促",
    "say": "헛소리!"
  },
  "zq47a07": {
    "text": "매우 쳐라!",
    "emotion": "揮袖"
  },
  "zq47a08": {
    "text": "잠깐.",
    "emotion": "沉聲"
  },
  "zq47a09": {
    "text": "종이를 줘라.",
    "emotion": "不怒自威"
  },
  "zq47a10": {
    "text": "글은 외워도,",
    "emotion": "平靜"
  },
  "zq47a11": {
    "text": "수차는?",
    "emotion": "嘴角一勾"
  },
  "zq47a12": {
    "text": "날개판 열두 장,",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "삼 푼 기울여.",
    "emotion": "篤定"
  },
  "zq47a14": {
    "text": "맞아,",
    "emotion": "篤定，短促，說完就停"
  },
  "zq47a15": {
    "text": "바로 이 수차야.",
    "emotion": "篤定，說完就停",
    "say": "바로 이거야."
  },
  "zq47a16": {
    "text": "웨이쉰,",
    "emotion": "轉頭"
  },
  "zq47a17": {
    "text": "네 수차는?",
    "emotion": "冷"
  },
  "zq47a18": {
    "text": "날개판,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq47a19": {
    "text": "왜 거꾸로 달았나?",
    "emotion": "考問"
  },
  "zq47a20": {
    "text": "나……",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq47a21": {
    "text": "내가 외운 건……",
    "emotion": "說溜嘴",
    "say": "외운 건……"
  },
  "zq47a22": {
    "text": "외운 거라고?",
    "emotion": "抓住了，極短促，一口氣說完，不拖音",
    "say": "외워?"
  },
  "zq47a23": {
    "text": "누구 걸?",
    "emotion": "笑，慢慢地"
  },
  "zq47a24": {
    "text": "처음엔 거꾸로 달아서,",
    "emotion": "老實說"
  },
  "zq47a25": {
    "text": "수차가 안 돌았죠.",
    "emotion": "笑了一下"
  },
  "zq47a26": {
    "text": "여동생이 바람개비로 보여 줘서,",
    "emotion": "想起來，聲音軟了",
    "say": "동생 바람개비 보고,"
  },
  "zq47a27": {
    "text": "그제야 뒤집었죠.",
    "emotion": "笑"
  },
  "zq47a28": {
    "text": "시험 전에,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "시험 전,"
  },
  "zq47a29": {
    "text": "내 서재에서",
    "emotion": "平穩，說完就停",
    "say": "내 서재서"
  },
  "zq47a30": {
    "text": "이 수차를 그렸소.",
    "emotion": "作證"
  },
  "zq47a31": {
    "text": "에헴,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "쳇!"
  },
  "zq47a32": {
    "text": "서생이 글을 외운 게,",
    "emotion": "硬撐"
  },
  "zq47a33": {
    "text": "뭐가 대수란 말이오!",
    "emotion": "拔高"
  },
  "zq47a34": {
    "text": "나리!",
    "emotion": "畫外，清亮"
  },
  "zq47a35": {
    "text": "바칠 물건이 있사옵니다!",
    "emotion": "畫外",
    "say": "바칠 것이 있습니다!"
  },
  "zq47a36": {
    "text": "그 웨이 가 사람이,",
    "emotion": "甜，快，一口氣說完",
    "say": "웨이 가 사람"
  },
  "zq47a37": {
    "text": "또 펑 학정을 찾아왔어요.",
    "emotion": "揚眉"
  },
  "zq47a38": {
    "text": "두 번째 꾸러미예요,",
    "emotion": "笑得很甜"
  },
  "zq47a39": {
    "text": "제가 대신 받았죠.",
    "emotion": "眨眼",
    "say": "대신 받았죠."
  },
  "zq47a40": {
    "text": "오백 냥,",
    "emotion": "聲音一沉，快，說完就停"
  },
  "zq47a41": {
    "text": "방이 붙으면 완납.",
    "emotion": "冷，快",
    "say": "방 붙으면 완납."
  },
  "zq47a42": {
    "text": "이 도장, 제가 알아요,",
    "emotion": "冷，快，說完就停",
    "say": "이 도장 알아요,"
  },
  "zq47a43": {
    "text": "웨이사오칭의 집사예요.",
    "emotion": "冷冷地",
    "say": "웨이사오칭 집사."
  },
  "zq47a44": {
    "text": "나리,",
    "emotion": "低聲，極短促，說完就停"
  },
  "zq47a45": {
    "text": "소관은 억울……",
    "emotion": "發抖，快，說完就停",
    "say": "소관 억울……"
  },
  "zq47a46": {
    "text": "잡아라!",
    "emotion": "一拍驚堂木"
  },
  "zq47a47": {
    "text": "다 물러가라.",
    "emotion": "低聲，揮手",
    "say": "물러가라."
  },
  "zq47a48": {
    "text": "웨이 가를 고발하면,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "웨이 가 치면,"
  },
  "zq47a49": {
    "text": "사건은 도성으로 가네.",
    "emotion": "句句是盤算"
  },
  "zq47a50": {
    "text": "삼 년은 안 끝나고,",
    "emotion": "畫外，低聲，快，說完就停",
    "say": "삼 년 못 끝내고,"
  },
  "zq47a51": {
    "text": "자네 이번 시험은 끝일세.",
    "emotion": "畫外，低聲，快",
    "say": "이번 시험은 끝일세."
  },
  "zq47a52": {
    "text": "펑 학정만 처벌하면,",
    "emotion": "沉穩，快，說完就停",
    "say": "펑 학정만 치면,"
  },
  "zq47a53": {
    "text": "자네는 내일,",
    "emotion": "快，說完就停",
    "say": "내일,"
  },
  "zq47a54": {
    "text": "해원일세.",
    "emotion": "一字一字"
  },
  "zq47a55": {
    "text": "선택: 웨이 가를 무너뜨린다,",
    "emotion": "平板電子音，快，說完就停",
    "say": "선택: 웨이 가 타도,"
  },
  "zq47a56": {
    "text": "혹은 먼저 해원을 얻는다.",
    "emotion": "平板電子音，快，說完就停",
    "say": "혹은 해원 먼저."
  }
}
