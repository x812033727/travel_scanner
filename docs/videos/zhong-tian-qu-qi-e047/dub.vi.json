{
  "zq47a01": {
    "text": "Guồng nước đoạn thứ ba,",
    "emotion": "不慌，快，說完就停"
  },
  "zq47a02": {
    "text": "ngươi vẽ ra đi.",
    "emotion": "盯著魏珣"
  },
  "zq47a03": {
    "text": "V-vẽ…",
    "emotion": "愣住，極短促，不拖音",
    "say": "Vẽ…"
  },
  "zq47a04": {
    "text": "Vẽ cái gì?",
    "emotion": "倨傲，快，說完就停"
  },
  "zq47a05": {
    "text": "E hèm,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "E hèm."
  },
  "zq47a06": {
    "text": "Hồ đồ!",
    "emotion": "尖聲，短促，說完就停"
  },
  "zq47a07": {
    "text": "Đánh cho ta!",
    "emotion": "揮袖"
  },
  "zq47a08": {
    "text": "Khoan đã.",
    "emotion": "沉聲"
  },
  "zq47a09": {
    "text": "Đưa giấy cho họ.",
    "emotion": "不怒自威"
  },
  "zq47a10": {
    "text": "Chữ thì thuộc được,",
    "emotion": "平靜"
  },
  "zq47a11": {
    "text": "còn guồng nước?",
    "emotion": "嘴角一勾"
  },
  "zq47a12": {
    "text": "Mười hai cánh guồng,",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "nghiêng ba phân.",
    "emotion": "篤定"
  },
  "zq47a14": {
    "text": "Đúng vậy,",
    "emotion": "篤定，短促，說完就停",
    "say": "Đúng,"
  },
  "zq47a15": {
    "text": "chính là cái này.",
    "emotion": "篤定"
  },
  "zq47a16": {
    "text": "Ngụy Tuân,",
    "emotion": "轉頭"
  },
  "zq47a17": {
    "text": "guồng nước của ngươi đâu?",
    "emotion": "冷",
    "say": "guồng của ngươi đâu?"
  },
  "zq47a18": {
    "text": "Cánh guồng,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq47a19": {
    "text": "sao lại lắp ngược?",
    "emotion": "考問"
  },
  "zq47a20": {
    "text": "Ta…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ta"
  },
  "zq47a21": {
    "text": "Ta thuộc là…",
    "emotion": "說溜嘴"
  },
  "zq47a22": {
    "text": "Thuộc?",
    "emotion": "抓住了，極短促，一口氣說完，不拖音"
  },
  "zq47a23": {
    "text": "Thuộc của ai?",
    "emotion": "笑，慢慢地"
  },
  "zq47a24": {
    "text": "Lần đầu lắp ngược,",
    "emotion": "老實說"
  },
  "zq47a25": {
    "text": "guồng không quay.",
    "emotion": "笑了一下"
  },
  "zq47a26": {
    "text": "Muội muội ta lấy chong chóng ra so,",
    "emotion": "想起來，聲音軟了",
    "say": "Muội ta lấy chong chóng so,"
  },
  "zq47a27": {
    "text": "ta mới lật lại.",
    "emotion": "溫和，說完就停"
  },
  "zq47a28": {
    "text": "Trước kỳ thi,",
    "emotion": "低聲，快，說完就停"
  },
  "zq47a29": {
    "text": "ở thư phòng lão phu",
    "emotion": "一字一句"
  },
  "zq47a30": {
    "text": "hắn đã vẽ cái này.",
    "emotion": "作證"
  },
  "zq47a31": {
    "text": "E hèm,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Hừ,"
  },
  "zq47a32": {
    "text": "Thư sinh học thuộc,",
    "emotion": "硬撐"
  },
  "zq47a33": {
    "text": "có gì lạ đâu!",
    "emotion": "拔高"
  },
  "zq47a34": {
    "text": "Đại nhân!",
    "emotion": "畫外，清亮"
  },
  "zq47a35": {
    "text": "Dân nữ có vật dâng lên!",
    "emotion": "畫外"
  },
  "zq47a36": {
    "text": "Kẻ nhà họ Ngụy đó,",
    "emotion": "甜但字字清楚"
  },
  "zq47a37": {
    "text": "lại đến tìm Phùng đại nhân.",
    "emotion": "揚眉"
  },
  "zq47a38": {
    "text": "Đây là gói thứ hai,",
    "emotion": "笑得很甜"
  },
  "zq47a39": {
    "text": "ta nhận giùm hắn.",
    "emotion": "眨眼",
    "say": "ta nhận giùm."
  },
  "zq47a40": {
    "text": "Năm trăm lượng,",
    "emotion": "聲音一沉，快，說完就停"
  },
  "zq47a41": {
    "text": "có bảng thì trả đủ.",
    "emotion": "冷"
  },
  "zq47a42": {
    "text": "Con dấu này ta nhận ra,",
    "emotion": "笑意收起"
  },
  "zq47a43": {
    "text": "là của quản gia Ngụy Thiếu Khanh.",
    "emotion": "冷冷地",
    "say": "quản gia Ngụy Thiếu Khanh."
  },
  "zq47a44": {
    "text": "Đại nhân,",
    "emotion": "極短促，一口氣說完，不拖音"
  },
  "zq47a45": {
    "text": "Hạ quan oan…",
    "emotion": "發抖，快，說完就停"
  },
  "zq47a46": {
    "text": "Bắt lấy!",
    "emotion": "一拍驚堂木"
  },
  "zq47a47": {
    "text": "Lui hết đi.",
    "emotion": "低聲，揮手"
  },
  "zq47a48": {
    "text": "Kiện đến nhà họ Ngụy,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Kiện nhà Ngụy,"
  },
  "zq47a49": {
    "text": "vụ án phải đưa lên kinh thành.",
    "emotion": "句句是盤算"
  },
  "zq47a50": {
    "text": "Ba năm không xong,",
    "emotion": "畫外，低聲，說完就停"
  },
  "zq47a51": {
    "text": "khoa này của ngươi coi như mất.",
    "emotion": "畫外，低聲，快",
    "say": "khoa này ngươi mất."
  },
  "zq47a52": {
    "text": "Chỉ xử Phùng học chính,",
    "emotion": "沉穩，快，說完就停"
  },
  "zq47a53": {
    "text": "ngươi ngày mai,",
    "emotion": "快，說完就停",
    "say": "ngày mai,"
  },
  "zq47a54": {
    "text": "chính là giải nguyên.",
    "emotion": "篤定，說完就停"
  },
  "zq47a55": {
    "text": "Lựa chọn: lật đổ nhà họ Ngụy,",
    "emotion": "平板電子音，快，說完就停"
  },
  "zq47a56": {
    "text": "hoặc lấy giải nguyên trước.",
    "emotion": "平板電子音，快，說完就停"
  }
}
