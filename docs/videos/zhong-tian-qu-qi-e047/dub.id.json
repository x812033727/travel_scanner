  },
  "zq47a41": {
    "text": "lunas saat pengumuman.",
    "emotion": "冷"
  },
  "zq47a42": {
    "text": "Aku kenal cap ini,",
    "emotion": "笑意收起"
  },
  "zq47a43": {
    "text": "milik pengurus rumah Wei Shaoqing.",
    "emotion": "冷冷地",
