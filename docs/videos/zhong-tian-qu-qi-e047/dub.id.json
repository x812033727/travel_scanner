    "text": "Dua belas bilah,",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "miring tiga derajat.",
    "emotion": "篤定",
    "say": "tiga derajat."
  },
  "zq47a14": {
    "text": "Benar,",
    "emotion": "篤定，短促，說完就停",
