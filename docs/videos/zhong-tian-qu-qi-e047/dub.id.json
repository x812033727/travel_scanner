    "text": "apa anehnya!",
    "emotion": "拔高"
  },
  "zq47a34": {
    "text": "Tuan!",
    "emotion": "畫外，清亮"
  },
  "zq47a35": {
    "text": "Hamba ingin menyerahkan sesuatu!",
    "emotion": "畫外",
    "say": "Hamba bawa sesuatu!"
