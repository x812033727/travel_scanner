  "zq47a39": {
    "text": "aku yang menerimanya untuknya.",
    "emotion": "眨眼",
    "say": "kuterima."
  },
  "zq47a40": {
    "text": "Lima ratus tael,",
    "emotion": "聲音一沉，快，說完就停",
