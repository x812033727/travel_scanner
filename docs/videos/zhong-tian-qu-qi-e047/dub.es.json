{
  "zq47a01": {
    "text": "La noria del tercer párrafo:",
    "emotion": "不慌，快，說完就停",
    "say": "La noria del tres,"
  },
  "zq47a02": {
    "text": "dibújala tú.",
    "emotion": "盯著魏珣",
    "say": "dibújala."
  },
  "zq47a03": {
    "text": "Di-dibujar…",
    "emotion": "愣住，極短促，不拖音",
    "say": "Dibu…"
  },
  "zq47a04": {
    "text": "¿Dibujar qué?",
    "emotion": "倨傲，快，說完就停"
  },
  "zq47a05": {
    "text": "Ejem,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Ejem."
  },
  "zq47a06": {
    "text": "¡Tonterías!",
    "emotion": "尖聲，短促，說完就停",
    "say": "¡Absurdo!"
  },
  "zq47a07": {
    "text": "¡Azótenlo!",
    "emotion": "揮袖"
  },
  "zq47a08": {
    "text": "Alto.",
    "emotion": "沉聲"
  },
  "zq47a09": {
    "text": "Denles papel.",
    "emotion": "不怒自威"
  },
  "zq47a10": {
    "text": "El texto, se lo aprendió,",
    "emotion": "平靜",
    "say": "El texto, sí,"
  },
  "zq47a11": {
    "text": "¿y la noria?",
    "emotion": "嘴角一勾"
  },
  "zq47a12": {
    "text": "Doce paletas,",
    "emotion": "邊畫邊說"
  },
  "zq47a13": {
    "text": "inclinadas tres grados.",
    "emotion": "篤定",
    "say": "tres grados."
  },
  "zq47a14": {
    "text": "Exacto,",
    "emotion": "篤定，短促，說完就停",
    "say": "Sí,"
  },
  "zq47a15": {
    "text": "esa es la noria.",
    "emotion": "篤定"
  },
  "zq47a16": {
    "text": "Wei Xun,",
    "emotion": "轉頭"
  },
  "zq47a17": {
    "text": "¿y tu noria?",
    "emotion": "冷"
  },
  "zq47a18": {
    "text": "Las paletas,",
    "emotion": "極短促，一口氣說完",
    "say": "Paletas,"
  },
  "zq47a19": {
    "text": "¿por qué al revés?",
    "emotion": "考問"
  },
  "zq47a20": {
    "text": "Yo…",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Yo"
  },
  "zq47a21": {
    "text": "Lo que memoricé…",
    "emotion": "說溜嘴",
    "say": "Memoricé…"
  },
  "zq47a22": {
    "text": "¿Memorizaste?",
    "emotion": "抓住了，極短促，一口氣說完，不拖音",
    "say": "¿Memoria?"
  },
  "zq47a23": {
    "text": "¿De quién?",
    "emotion": "笑，慢慢地"
  },
  "zq47a24": {
    "text": "La primera vez las puse al revés,",
    "emotion": "老實說"
  },
  "zq47a25": {
    "text": "y la noria no giró.",
    "emotion": "笑了一下"
  },
  "zq47a26": {
    "text": "Mi hermanita lo comparó con un rehilete,",
    "emotion": "想起來，聲音軟了",
    "say": "El rehilete de mi hermana,"
  },
  "zq47a27": {
    "text": "y por fin las volteé.",
    "emotion": "溫和，說完就停",
    "say": "y las volteé."
  },
  "zq47a28": {
    "text": "Antes del examen,",
    "emotion": "低聲，快，說完就停",
    "say": "Antes,"
  },
  "zq47a29": {
    "text": "en mi estudio",
    "emotion": "一字一句"
  },
  "zq47a30": {
    "text": "dibujó esta noria.",
    "emotion": "作證"
  },
  "zq47a31": {
    "text": "Ejem,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Hm,"
  },
  "zq47a32": {
    "text": "Un letrado que memoriza textos,",
    "emotion": "硬撐"
  },
  "zq47a33": {
    "text": "¡qué tiene de raro!",
    "emotion": "拔高，快，說完就停"
  },
  "zq47a34": {
    "text": "¡Señoría!",
    "emotion": "畫外，清亮",
    "say": "¡Señor!"
  },
  "zq47a35": {
    "text": "¡Esta humilde mujer trae algo que presentar!",
    "emotion": "畫外",
    "say": "¡Traigo algo!"
  },
  "zq47a36": {
    "text": "Ese hombre de los Wei",
    "emotion": "甜但字字清楚",
    "say": "El de los Wei"
  },
  "zq47a37": {
    "text": "volvió a buscar al examinador Feng.",
    "emotion": "揚眉",
    "say": "volvió a ver a Feng."
  },
  "zq47a38": {
    "text": "Este es el segundo paquete,",
    "emotion": "笑得很甜",
    "say": "Es el segundo paquete,"
  },
  "zq47a39": {
    "text": "lo recibí por él.",
    "emotion": "眨眼",
    "say": "lo recibí."
  },
  "zq47a40": {
    "text": "Quinientos taeles,",
    "emotion": "聲音一沉，快，說完就停",
    "say": "Quinientos,"
  },
  "zq47a41": {
    "text": "pagaderos al publicarse la lista.",
    "emotion": "冷",
    "say": "a pagar con la lista."
  },
  "zq47a42": {
    "text": "Conozco este sello:",
    "emotion": "笑意收起"
  },
  "zq47a43": {
    "text": "es del mayordomo de Wei Shaoqing.",
    "emotion": "冷冷地",
    "say": "mayordomo de Wei Shaoqing."
  },
  "zq47a44": {
    "text": "Señoría,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Señor,"
  },
  "zq47a45": {
    "text": "Este funcionario es inocente…",
    "emotion": "聲音發抖",
    "say": "Soy inocente…"
  },
  "zq47a46": {
    "text": "¡Arréstenlo!",
    "emotion": "一拍驚堂木"
  },
  "zq47a47": {
    "text": "Retírense.",
    "emotion": "低聲，揮手",
    "say": "Salgan."
  },
  "zq47a48": {
    "text": "Si acusas a los Wei,",
    "emotion": "極短促，一口氣說完，不拖音",
    "say": "Contra los Wei,"
  },
  "zq47a49": {
    "text": "el caso irá a la capital.",
    "emotion": "句句是盤算"
  },
  "zq47a50": {
    "text": "Tres años sin sentencia,",
    "emotion": "畫外，低聲，說完就停"
  },
  "zq47a51": {
    "text": "y pierdes este examen.",
    "emotion": "畫外，低聲，快"
  },
  "zq47a52": {
    "text": "Juzga solo al examinador Feng,",
    "emotion": "沉穩，快，說完就停",
    "say": "Juzga solo a Feng,"
  },
  "zq47a53": {
    "text": "y mañana",
    "emotion": "慢"
  },
  "zq47a54": {
    "text": "serás el primero del examen provincial.",
    "emotion": "一字一字",
    "say": "serás el primero."
  },
  "zq47a55": {
    "text": "Elección: derribar a los Wei,",
    "emotion": "平板電子音，叮一聲"
  },
  "zq47a56": {
    "text": "o ser el primero del examen provincial antes.",
    "emotion": "平板電子音",
    "say": "o quedar primero antes."
  }
}
