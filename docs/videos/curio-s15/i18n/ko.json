  "lines": {
    "dm101": {
      "source_hash": "6614758a5c40",
      "text": "1590년 여름, 오다와라성 밖. 히데요시 진영은 돌담 공사 중."
    },
    "dm102": {
      "source_hash": "98266a866c8b",
      "text": "이야기는 이렇습니다. 한참 늦은 마사무네가 드디어 옵니다."
    },
    "dm103": {
      "source_hash": "c5c42d46fd1e",
      "text": "24세, 온통 흰옷. 일본어로 시니쇼조쿠, 수의입니다."
    },
    "dm104": {
      "source_hash": "a34665d3ae95",
      "text": "머리는 선물 묶는 가는 종이끈, 미즈히키로 묶었습니다."
    },
    "dm105": {
      "source_hash": "95ba56b9c7d5",
      "text": "의자의 히데요시가 지팡이로 목을 톡."
    },
    "dm106": {
      "source_hash": "afe81b42fe67",
      "text": "\"더 늦었으면 위험했다.\""
    },
    "dm107": {
      "source_hash": "5672c12d2c17",
      "text": "이건 약과입니다."
    },
    "dm108": {
      "source_hash": "4640f1c649e0",
      "text": "그달 그가 쓴 편지들, 뭐라고 썼을까요?"
    },
    "dm109": {
      "source_hash": "f9b86901cee0",
      "text": "백여 년 뒤 다테 가문 역사서도 그날 차림을 적었습니다."
    },
    "dm110": {
      "source_hash": "44ed5787919c",
      "text": "목에 한 그 말은 누가 적었나?"
    },
    "dm111": {
      "source_hash": "b2040a5e3aee",
      "text": "그 수의는 누가 처음 써넣었을까?"
    },
    "dm112": {
      "source_hash": "989fcc718f39",
      "text": "정말 수의를 입고 히데요시를 만났을까?"
    },
    "dm201": {
      "source_hash": "5d8b9d81a6ce",
      "text": "그 편지 하나는 덴쇼 18년 6월 6일에 쓰였습니다."
    },
    "dm202": {
      "source_hash": "a7990ec8fde2",
      "text": "어제 5일 도착했고, 다들 마중 나왔다고 씁니다."
    },
    "dm203": {
      "source_hash": "ac404b9b7371",
      "text": "지금은 괜찮다고."
    },
    "dm204": {
      "source_hash": "90cd8bda466c",
      "text": "그런데 간파쿠도 자신도 아직 꺼내지 않은 말이 있다고."
    },
    "dm205": {
      "source_hash": "71a48cbe5424",
      "text": "어찌 될지 모른다."
    },
    "dm206": {
      "source_hash": "ea15cfdc9afd",
      "text": "우리 일은 위에도 알려졌고 아래서도 소문이다."
    },
    "dm207": {
      "source_hash": "c2baeb7bcccd",
      "text": "잘못되면 예측할 수 없다."
    },
    "dm208": {
      "source_hash": "46a5d5037bdd",
      "text": "다만 히데요시가 아사노 나가요시와 마에다 도시이에를 '안내역'으로 불렀으니"
    },
    "dm209": {
      "source_hash": "fdc4fd6fa2fc",
      "text": "잘 풀릴 것이다."
    },
    "dm210": {
      "source_hash": "33e20b86ecb5",
      "text": "그래서 잘 풀렸나?"
    },
    "dm211": {
      "source_hash": "4417ee00b617",
      "text": "6월 12일, 가신에게: 간파쿠가 두루 후대했고,"
    },
    "dm212": {
      "source_hash": "8bbb15efce7c",
      "text": "모든 일이 내 뜻대로 됐다."
    },
    "dm213": {
      "source_hash": "9d811c1b4cab",
      "text": "하루이틀 안에 안내를 받아 간토를 거쳐 돌아간다고."
    },
    "dm214": {
      "source_hash": "d480a6b39a08",
      "text": "히데요시는 만났나?"
    },
    "dm215": {
      "source_hash": "4161ab8a74c1",
      "text": "이틀 뒤: 9일 오전 히데요시를 만났고,"
    },
    "dm216": {
      "source_hash": "5789ec8f1238",
      "text": "10일 아침엔 다회에 불려 명물도 봤다."
    },
    "dm217": {
      "source_hash": "6354a7162594",
      "text": "귀한 칼과 와키자시 얘기를 다정히 나눴다."
    },
    "dm218": {
      "source_hash": "3066a93a55cc",
      "text": "오슈 54군, 데와 12군의 처리를 그에게 맡겼고,"
    },
    "dm219": {
      "source_hash": "db753e59a194",
      "text": "아이즈는 '당분간' 간파쿠 직할일 뿐."
    },
    "dm220": {
      "source_hash": "e60b1e43044c",
      "text": "저희가 보기엔 편지가 갈수록 가벼워집니다."
    },
    "dm221": {
      "source_hash": "1145e0a9a19b",
      "text": "걱정에서 득의로. 그사이 그는 어디 있었을까요?"
    },
    "dm301": {
      "source_hash": "dd9c2a8d8ad8",
      "text": "하코네 산속 온천 마을, 소코쿠라."
    },
    "dm302": {
      "source_hash": "054191497339",
      "text": "오자마자 그곳에 묵게 됩니다."
    },
    "dm303": {
      "source_hash": "c0bb996cfb06",
      "text": "히데요시는 4월 도착,"
    },
    "dm304": {
      "source_hash": "32c79a1536e0",
      "text": "그는 5월에야 에치고·시나노를 돌아 출발."
    },
    "dm305": {
      "source_hash": "637edbd01fc5",
      "text": "중신 다테 시게자네는 회고록에 이렇게 씁니다."
    },
    "dm306": {
      "source_hash": "ba93529766e1",
      "text": "이런 산속에 갇혀 모두 걱정했다."
    },
    "dm307": {
      "source_hash": "2249f383acd0",
      "text": "6월 7일, 사자 다섯: 세야쿠인 젠소, 아사노 나가요시 등."
    },
    "dm308": {
      "source_hash": "ec53a3b7bb9d",
      "text": "나머지 둘은 이름조차 없습니다."
    },
    "dm309": {
      "source_hash": "1ce9a459615b",
      "text": "아사노가 바로 편지 속 '안내역'."
    },
    "dm310": {
      "source_hash": "d82c36f0d2e9",
      "text": "무슨 죄목?"
    },
    "dm311": {
      "source_hash": "29b7505e85b8",
      "text": "늦게 온 것,"
    },
    "dm312": {
      "source_hash": "3d73b1fef6c7",
      "text": "그리고 먼저 인사한 아시나 가문의 아이즈를 빼앗은 것."
    },
    "dm313": {
      "source_hash": "98c850afa098",
      "text": "해명하라, 못 하면 죄를 묻겠다."
    },
    "dm314": {
      "source_hash": "43f087dde1ab",
      "text": "가신들의 걱정은?"
    },
    "dm315": {
      "source_hash": "2b57b9400f7d",
      "text": "다테 기록: 할복 명령을 두려워했다."
    },
    "dm316": {
      "source_hash": "ef1a2306ba77",
      "text": "훗날의 다테 가문 역사서는 한 가지를 더 적었습니다."
    },
    "dm317": {
      "source_hash": "e9ca4cc1f1f5",
      "text": "리큐도 왔다니 다도 얘기를 듣고 싶다고 했다고."
    },
    "dm318": {
      "source_hash": "7a979d58ecb8",
      "text": "히데요시는 어떻게 봤을까?"
    },
    "dm319": {
      "source_hash": "bd043d220e70",
      "text": "시골에 살며 이런 마음가짐이라니, 모반할 자가 아니다."
    },
    "dm320": {
      "source_hash": "43eb0cf08e3f",
      "text": "해명을 들은 히데요시: 다들 마사무네를 미워하는구나. 하지만 아이즈 일은 너무 무례했다."
    },
    "dm321": {
      "source_hash": "e56188ae0249",
      "text": "처분은 아이즈·이와세·아사카 몰수, 본령은 그대로."
    },
    "dm322": {
      "source_hash": "b3c2236d461f",
      "text": "'당분간' 기억하시죠? 아이즈는 훗날 가모 우지사토에게."
    },
    "dm323": {
      "source_hash": "98b9ec444104",
      "text": "다테 기록상 처분은 대면 전 확정."
    },
    "dm324": {
      "source_hash": "bc8ef9c2a6ea",
      "text": "그날 차림은 어땠을까?"
    },
    "dm401": {
      "source_hash": "baf65e9625d7",
      "text": "다테 가문 역사서는 1703년에야 완성됐습니다. 미즈히키는 여기 나옵니다."
    },
    "dm402": {
      "source_hash": "cd8aab38a1a1",
      "text": "그 모습이 '이상해 보였다'고 합니다."
    },
    "dm403": {
      "source_hash": "fc581072d221",
      "text": "이에야스, 도시이에 등 다이묘가 곁에."
    },
    "dm404": {
      "source_hash": "183fb6ddeeb3",
      "text": "물러나려는데 지팡이로 땅을 가리키며 이리 오라."
    },
    "dm405": {
      "source_hash": "2902cada7aea",
      "text": "가다가 허리에 찬 와키자시가 생각났습니다."
    },
    "dm406": {
      "source_hash": "365cca361acb",
      "text": "어쩌지?"
    },
    "dm407": {
      "source_hash": "8016ab9487cf",
      "text": "와키자시를 서기 와쿠 소제에게 던지고 나아갔습니다."
    },
    "dm408": {
      "source_hash": "f27ed97ec604",
      "text": "지팡이로 성을 가리켜 축성과 공략을 말하자"
    },
    "dm409": {
      "source_hash": "9fbb46a16aa7",
      "text": "마사무네도 거침없이 답했습니다."
    },
    "dm410": {
      "source_hash": "20213cd9f709",
      "text": "다이묘들의 평은?"
    },
    "dm411": {
      "source_hash": "09c1fc24acc3",
      "text": "시게자네 회고록엔, 시골 사람이 겁이 없다고 모두 칭찬했다고."
    },
    "dm412": {
      "source_hash": "cca1e89f7c66",
      "text": "그는 아이즈에;"
    },
    "dm413": {
      "source_hash": "c9523d2b5cb6",
      "text": "와쿠 소제에게 전해 들은 것."
    },
    "dm414": {
      "source_hash": "ccb0e41f5894",
      "text": "와쿠 소제는 훗날 다테 가신이 됩니다."
    },
    "dm415": {
      "source_hash": "d96c3de2d5a8",
      "text": "두 책 다 목에 닿았단 말은 없습니다."
    },
    "dm416": {
      "source_hash": "32fb06cc55ec",
      "text": "목에 떨어진 그 한 대는 어디서 왔을까?"
    },
    "dm417": {
      "source_hash": "19df1fece046",
      "text": "그 대사는 가가 무사 세키야 마사하루의 각서에 있습니다."
    },
    "dm418": {
      "source_hash": "79bdfa98af6d",
      "text": "순서도 다릅니다. 만족한 히데요시가 바로 만나죠."
    },
    "dm419": {
      "source_hash": "0b866c47295f",
      "text": "가짜 수염, 석 자 붉은 칼집 큰칼, 가는 지팡이."
    },
    "dm420": {
      "source_hash": "3520e12bb439",
      "text": "마사무네는 품에 와키자시를 숨겨 찌를 틈을 노렸습니다."
    },
    "dm421": {
      "source_hash": "ce67e5a9c195",
      "text": "그런데 지팡이가 목을 톡톡;"
    },
    "dm422": {
      "source_hash": "fb0814e305d2",
      "text": "찌를 생각은 사라지고 목이 데인 듯했다."
    },
    "dm423": {
      "source_hash": "8b3239952378",
      "text": "매사냥에 데려가 칼을 들게 하니, 이제 중용되겠다 싶었다."
    },
    "dm424": {
      "source_hash": "0a67446fdff1",
      "text": "세키야는 어디서 들었나?"
    },
    "dm425": {
      "source_hash": "9c2474a0e2b3",
      "text": "마사무네가 가가 번주 마에다 도시쓰네에게 직접 한 말인데,"
    },
    "dm426": {
      "source_hash": "03254b59de72",
      "text": "들은 사람은 옆방의 마에다 시치로베."
    },
    "dm427": {
      "source_hash": "1454c7381e34",
      "text": "세키야는 그 전언을 적었다."
    },
    "dm428": {
      "source_hash": "7c6f11967785",
      "text": "가가엔 이 판본만 전해졌을까?"
    },
    "dm429": {
      "source_hash": "eca244f11634",
      "text": "아뇨. 같은 말의 다른 이야기도,"
    },
    "dm430": {
      "source_hash": "24e109adf248",
      "text": "목을 찔린 이가 쓰다 도토미란 무사입니다."
    },
    "dm431": {
      "source_hash": "3c1aac6b4d85",
      "text": "1935년 소학교 국사 교사용 지도서엔, 히데요시가 지팡이로 목을 톡 치며"
    },
    "dm432": {
      "source_hash": "055836096e32",
      "text": "\"너 운 좋은 놈이구나\" 했다고."
    },
    "dm433": {
      "source_hash": "eb9481e4283f",
      "text": "그럼 시니쇼조쿠는 에도의 책 어디에?"
    },
    "dm501": {
      "source_hash": "1fd1a8900f0b",
      "text": "이듬해 다른 일. 덴쇼 19년, 교토로 불려가 문책당합니다."
    },
    "dm502": {
      "source_hash": "d8810ce1d3e6",
      "text": "에도 시대 『우지사토기』엔 그때 시니쇼조쿠를 입고,"
    },
    "dm503": {
      "source_hash": "0426eae37823",
      "text": "말 앞에 금박 기둥을 메게 했다고."
    },
    "dm504": {
      "source_hash": "dd6a1f730bed",
      "text": "끝엔 '그렇다더라'."
    },
    "dm505": {
      "source_hash": "c013ff8803a7",
      "text": "후대 책은 오다와라에서 뭘 입혔나?"
    },
    "dm506": {
      "source_hash": "12845601994b",
      "text": "막말 『명장언행록』엔 마사무네 본인의 말이 있습니다."
    },
    "dm507": {
      "source_hash": "cbb77b7c80d8",
      "text": "수행원 대부분을 두고 금란 갑옷 하오리 차림으로 나아갑니다."
    },
    "dm508": {
      "source_hash": "f7f99db85f6f",
      "text": "멀리서 히데요시가 \"다테 공인가, 오라\"."
    },
    "dm509": {
      "source_hash": "aaf5b90bddce",
      "text": "1922년 기도의 희곡은 더 화려:"
    },
    "dm510": {
      "source_hash": "2709c2352dd1",
      "text": "흰 생명주에 금빛·붉은 구름, 표범 가죽 하카마."
    },
    "dm511": {
      "source_hash": "11c4d49c8f1b",
      "text": "그 수의는 언제 입혀졌을까?"
    },
    "dm512": {
      "source_hash": "f95ab74444a4",
      "text": "이번에 찾은 가장 이른 예는 1934년 통속 일본사."
    },
    "dm513": {
      "source_hash": "d5c814126a9b",
      "text": "죽을 각오로 상복을 더해 왔다고 전한다."
    },
    "dm514": {
      "source_hash": "42a168b9cd1d",
      "text": "1937년 일본도 책은 더 직설적: 시니쇼조쿠."
    },
    "dm515": {
      "source_hash": "7187a743ed0b",
      "text": "1987년 대하드라마 『독안룡 마사무네』 줄거리가 바로 그 장면, 흰 옷에 미즈히키."
    },
    "dm516": {
      "source_hash": "c6c73023c54c",
      "text": "회고 기사엔 지팡이가 목을 '탁' 쳤다고."
    },
    "dm517": {
      "source_hash": "e3e23511300f",
      "text": "누가 다시 확인했나?"
    },
    "dm518": {
      "source_hash": "ae3be3b983d7",
      "text": "2022년 마이니치신문 보도: 대하드라마에 여러 번 나온 이 일화는"
    },
    "dm519": {
      "source_hash": "987514d3847c",
      "text": "도야마시 향토박물관 하기와라 다이스케는 확실한 사료가 없다고."
    },
    "dm520": {
      "source_hash": "f959cb33e2dc",
      "text": "세키야 마사하루 기억하시죠? 하기와라 책은 그의 『이쓰야노 가키모노』 이야기."
    },
    "dm521": {
      "source_hash": "21dca3e1a556",
      "text": "그 흰옷은 당시 편지에도, 다테 가문 역사서에도 없습니다. 이 파일은 보관. 누가 먼저 입혔는지는 미결."
    },
    "dm522": {
      "source_hash": "c76b968c5d80",
      "text": "이 장면, 처음 본 건 드라마·만화·게임?"
    },
    "dm523": {
      "source_hash": "adf9a2c6d2b5",
      "text": "기록에 있는 것만 말합니다. 함께 파일을 열려면 구독을."
    }
  },
  "thumbnail": {
    "tag": "역사 명장면",
    "headline": "누가 그에게\n**흰옷을?**",
    "sub": "덴쇼 18년의 오다와라"
  }
}
