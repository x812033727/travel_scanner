            }
          ]
        },
        {
          "type": "rich_paragraph",
          "inlines": [
            {
              "type": "article",
              "text": "文字生影片（Text-to-Video）是什麼：讓畫面在時間裡保持連貫",
              "kind": "life",
              "slug": "ai-term-text-to-video"
            }
          ]
        },
        {
          "type": "rich_paragraph",
          "inlines": [
