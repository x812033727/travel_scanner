        "width": 1600,
        "height": 900,
        "credit": {
          "author": "Bykim2012",
          "license": "CC0",
          "source_url": "https://commons.wikimedia.org/wiki/File:Jokbal_dish_served_on_a_metal_plate.jpg"
        }
