              "type": "link",
              "text": "백년토종삼계탕 본점",
              "url": "https://map.naver.com/p/search/%EB%B0%B1%EB%85%84%ED%86%A0%EC%A2%85%EC%82%BC%EA%B3%84%ED%83%95%20%EB%B3%B8%EC%A0%90%20%EC%84%9C%EA%B5%90%EB%8F%99"
            },
